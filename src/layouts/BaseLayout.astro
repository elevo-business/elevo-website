---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Feuert PageView fuer alle Besucher (ausser aktiv abgelehnt) — fuer
   *  LPV-optimierte Ad-Landingpages. Lead-Event bleibt consent-gated. */
  eagerPageView?: boolean;
  /** Optionale CSS-Klasse(n) auf <body> — z.B. fuer seiten-spezifische Themes/Scopes. */
  bodyClass?: string;
  /** Preload der Editorial-Display-Schrift (nur Seiten, die sie above-the-fold nutzen). */
  preloadSerif?: boolean;
}

const {
  title = 'Elevo — Dein digitaler Wachstumspartner für aufstrebende Unternehmen',
  description = 'Wir machen aufstrebende Unternehmen sichtbar und bringen planbar Anfragen: hochwertige Website, Premium-Printmedien und Ad-Funnel, die konvertieren. Komplett done-for-you — Fundament, Autorität, Skalierung.',
  canonical = 'https://elevo.solutions/',
  ogImage = 'https://elevo.solutions/og-image.jpg',
  noindex = false,
  eagerPageView = false,
  bodyClass = '',
  preloadSerif = false,
} = Astro.props;

// Meta-Pixel-ID (nicht geheim, identisch zur Dataset-ID des CAPI-Servers).
// Override zur Build-Zeit via PUBLIC_META_PIXEL_ID möglich.
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID ?? '2057474564840133';

// GA4 Measurement-ID (G-XXXXXXXXXX). Per ENV PUBLIC_GA4_ID setzen. Leer = aus.
// Nutzt denselben gtag-Loader wie Google Ads; Consent Mode v2 gilt (analytics
// erst nach "Statistik"-Einwilligung mit Cookies, vorher cookielose Pings).
const ga4Id = import.meta.env.PUBLIC_GA4_ID ?? 'G-YWCBRRJR0N';

// Microsoft Clarity (Heatmaps/Session-Recording = Statistik). Per ENV
// PUBLIC_CLARITY_ID. Laedt erst nach "Statistik"-Einwilligung (DSGVO).
const clarityId = import.meta.env.PUBLIC_CLARITY_ID ?? 'xbi2du3vxx';
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="author" content="Elevo">
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}>
  <meta name="theme-color" content="#0A0E1A">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="de_DE">
  <meta property="og:site_name" content="Elevo">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@elevosolutions">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Canonical -->
  <link rel="canonical" href={canonical}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" type="image/svg+xml" href="/apple-touch-icon-180.svg">
  <meta name="apple-mobile-web-app-title" content="Elevo">

  <title>{title}</title>

  <!-- Fonts (self-hosted, DSGVO-konform) -->
  <link rel="preload" as="font" href="/fonts/Sora-latin.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="/fonts/Outfit-latin.woff2" type="font/woff2" crossorigin>
  {preloadSerif && <link rel="preload" as="font" href="/fonts/BricolageGrotesque-latin.woff2" type="font/woff2" crossorigin />}
  {preloadSerif && <link rel="preload" as="font" href="/fonts/InstrumentSerif-latin.woff2" type="font/woff2" crossorigin />}

  <!-- No-JS-Fallback: Reveal-Inhalte sind ohne JavaScript sofort sichtbar
       (Scroll-Animationen sind reine Progressive Enhancement). -->
  <noscript><style>.reveal,.reveal-left,.reveal-right{opacity:1!important;transform:none!important}</style></noscript>

  <!-- Structured Data: LocalBusiness -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Elevo",
    "serviceType": "Digitaler Wachstumspartner für aufstrebende Unternehmen: hochwertige Website mit SEO und Conversion, Premium-Printmedien, Ad-Funnel",
    "description": "Elevo ist der digitale Wachstumspartner für aufstrebende Unternehmen: hochwertige, conversion- und SEO-optimierte Websites, Premium-Printmedien und Ad-Funnel, die planbar qualifizierte Anfragen bringen. Komplett done-for-you.",
    "slogan": "Dein digitaler Wachstumspartner",
    "url": "https://elevo.solutions",
    "email": "hey@elevo.solutions",
    "logo": "https://elevo.solutions/elevo-logo.png",
    "image": "https://elevo.solutions/og-image.jpg",
    "founder": {
      "@type": "Person",
      "name": "Mert Efe Celik",
      "jobTitle": "Gründer",
      "url": "https://elevo.solutions/ueber-uns"
    },
    "availableLanguage": "de",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ahrstraße 6",
      "postalCode": "52511",
      "addressLocality": "Geilenkirchen",
      "addressRegion": "NRW",
      "addressCountry": "DE"
    },
    "areaServed": [
      { "@type": "Country", "name": "Deutschland" },
      { "@type": "Country", "name": "Österreich" },
      { "@type": "Country", "name": "Schweiz" }
    ],
    "knowsAbout": ["Wachstumsmarketing", "Conversion-Optimierung", "Suchmaschinenoptimierung", "Webentwicklung", "Verkaufstexte und Copywriting", "Premium-Printmedien", "Magazin-Gestaltung", "Ad-Funnel", "Lead-Generierung", "Conversion-Tracking", "Markenauftritt für aufstrebende Unternehmen"],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Wachstums-System für aufstrebende Unternehmen",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Website erstellen lassen — mit SEO & Conversion",
            "description": "Professionelle Website erstellen lassen: individuell entwickelt, SEO- und conversion-optimiert, mit verkaufsstarken Werbetexten — gebaut, um bei Google gefunden zu werden und mehr Anfragen zu bringen."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Kundenmagazin & Corporate Publishing",
            "description": "Kundenmagazin erstellen lassen: hochwertige Printmedien und Direktmailings, die in der Hand bleiben und das Unternehmen als vertrauenswürdige Marke positionieren."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Google Ads & Meta Werbung — Leadgenerierung",
            "description": "Ad-Funnel auf Google Ads und Meta zur Leadgenerierung, die planbar qualifizierte Anfragen liefern — bei GreenChild 25 qualifizierte Anfragen im ersten Monat."
          }
