  <!-- Structured Data: WebSite -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Elevo",
    "alternateName": "Elevo — Digitaler Wachstumspartner",
    "url": "https://elevo.solutions",
    "inLanguage": "de-DE",
    "publisher": { "@type": "Organization", "name": "Elevo", "url": "https://elevo.solutions" }
  }
  </script>

  <!--
    Google Ads + Consent Mode v2.
    Consent-Default wird inline gesetzt (kein Netzwerk, ~0,5 KiB).
    gtag.js selbst wird strikt POST-LCP geladen:
      - frühestens nach `load`-Event (LCP fuer Text-Hero ist davor abgeschlossen)
      - dann auf erste User-Interaktion ODER Hardcap 1500 ms nach `load`
      - Consent-Grant via Cookie-Banner triggert sofortiges Laden (ueber `elevo:consent-granted` CustomEvent)
    Vorher: requestIdleCallback feuerte auf 4G bereits ~2,6 s -> kollidierte mit LCP-Fenster.
  -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'analytics_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'wait_for_update': 500
    });
    gtag('js', new Date());
    gtag('config', 'AW-18023151518');

    (function(){
      var injected = false;
      var src = 'https://www.googletagmanager.com/gtag/js?id=AW-18023151518';

      function inject(){
        if (injected) return;
        injected = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = src;
        document.head.appendChild(s);
      }

      function armPostLoad(){
        // LCP fuer den Text-Hero ist zum `load`-Zeitpunkt sicher abgeschlossen.
        // Wir warten zusaetzlich auf erste User-Interaktion ODER Hardcap 1500 ms.
        var hardcap = setTimeout(inject, 1500);

        var events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
        function onInteract(){
          events.forEach(function(e){ window.removeEventListener(e, onInteract, true); });
          clearTimeout(hardcap);
          // Kurze Idle-Pause, damit gtag-Fetch nicht mit Click-Handler-Arbeit konkurriert.
          setTimeout(inject, 200);
        }
        events.forEach(function(e){
          window.addEventListener(e, onInteract, { capture: true, passive: true });
        });
      }

      if (document.readyState === 'complete') {
        armPostLoad();
      } else {
        window.addEventListener('load', armPostLoad, { once: true });
      }

      // Consent-Grant via Cookie-Banner -> sofort laden, damit Conversion-Tracking ohne Wartezeit greift.
      window.addEventListener('elevo:consent-granted', inject, { once: true });
    })();
  </script>

  <!-- GA4 (nutzt denselben gtag-Loader + Consent Mode v2). analytics_storage ist
       per Default 'denied' -> bis zur "Statistik"-Einwilligung cookielose Pings. -->
  <script define:vars={{ ga4Id }}>
    if (ga4Id && typeof gtag === 'function') {
      gtag('config', ga4Id, { anonymize_ip: true });
    }
  </script>

  <!-- Microsoft Clarity (Statistik) — laedt erst nach "Statistik"-Einwilligung. -->
  <script define:vars={{ clarityId }}>
    (function () {
      if (!clarityId) return;
      var loaded = false;
      function loadClarity() {
        if (loaded) return; loaded = true;
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", clarityId);
      }
      function hasAnalyticsConsent() {
        try { var raw = localStorage.getItem('elevo_consent_v2'); return raw ? JSON.parse(raw).analytics === true : false; }
        catch (e) { return false; }
      }
      if (hasAnalyticsConsent()) loadClarity();
      window.addEventListener('elevo:analytics-granted', loadClarity, { once: true });
    })();
  </script>

  <!--
    Meta-Pixel + Conversions-API-Bridge.
    - fbq-Stub wird sofort definiert (kein Netzwerk), damit Lead-Events
      gepuffert werden können.
    - Das eigentliche fbevents.js wird DSGVO-konform erst nach Marketing-Consent
      geladen (Event `elevo:consent-granted`) — vorher kein Drittanbieter-Request.
    - window.elevoMeta stellt den Formularen einen Helfer bereit: erzeugt eine
      gemeinsame event_id, feuert das Browser-Lead-Event und liefert fbp/fbc für
      das server-seitige CAPI-Event (Deduplizierung über die event_id).
  -->
  <script define:vars={{ metaPixelId, eagerPageView }}>
    // Standard Meta-Pixel-Stub — OHNE automatischen Script-Load.
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[]}(window);

    var CONSENT_KEY = 'elevo_consent_v2';

    function hasMarketingConsent() {
      try {
        var raw = localStorage.getItem(CONSENT_KEY);
        if (!raw) return false;
        return JSON.parse(raw).marketing === true;
      } catch (e) { return false; }
    }

    function getCookie(name) {
      var m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
      return m ? decodeURIComponent(m.pop()) : '';
    }
    function setCookie(name, value, days) {
      var secure = location.protocol === 'https:' ? ';Secure' : '';
      document.cookie = name + '=' + encodeURIComponent(value) + ';path=/;max-age=' + (days * 86400) + ';SameSite=Lax' + secure;
    }

    var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];

    function qp(name) {
      var m = location.search.match(new RegExp('[?&]' + name + '=([^&]+)'));
      return m ? decodeURIComponent(m[1].replace(/\+/g, ' ')) : '';
    }

    // Klick-ID + UTM beim ersten Aufruf erfassen und PERSISTIEREN, damit sie den
    // gesamten Funnel ueberleben (LP -> Formular -> Calendly -> Danke). _fbc im
    // Meta-Format: fb.1.<unix_ms>.<fbclid>. Zusaetzlich eine stabile external_id
    // (_eid) fuer bessere Cross-Event-Match-Quality. Laeuft im selben Kontext,
    // in dem auch der Pixel geladen wird (Marketing-Consent bzw. eager-PageView).
    function captureAttribution() {
      var fbclid = qp('fbclid');
      if (fbclid && !getCookie('_fbc')) {
        setCookie('_fbc', 'fb.1.' + Date.now() + '.' + fbclid, 90);
      }
      var attr = {};
      try { attr = JSON.parse(getCookie('elevo_attr') || '{}'); } catch (e) { attr = {}; }
      if (fbclid && !attr.fbclid) attr.fbclid = fbclid;
      UTM_KEYS.forEach(function (k) { var v = qp(k); if (v && !attr[k]) attr[k] = v; });
      if (Object.keys(attr).length) setCookie('elevo_attr', JSON.stringify(attr), 90);
      if (!getCookie('_eid')) {
        setCookie('_eid', (window.crypto && crypto.randomUUID ? crypto.randomUUID() : 'eid-' + Date.now() + '-' + Math.random().toString(36).slice(2)), 180);
      }
    }

    function getStoredAttr() {
      try { return JSON.parse(getCookie('elevo_attr') || '{}'); } catch (e) { return {}; }
    }

    // _fbc aus Cookie oder — falls noch nicht gesetzt — aus fbclid (URL/Store).
    function getFbc() {
      var fbc = getCookie('_fbc');
      if (fbc) return fbc;
      var fbclid = qp('fbclid') || getStoredAttr().fbclid;
      if (fbclid) return 'fb.1.' + Date.now() + '.' + fbclid;
      return '';
    }

    function getUtm() {
      var attr = getStoredAttr(); var out = {};
      UTM_KEYS.forEach(function (k) { var v = qp(k) || attr[k]; if (v) out[k] = v; });
      return out;
    }

    function newEventId() {
      if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
      return 'ev-' + Date.now() + '-' + Math.random().toString(36).slice(2);
    }

    var pixelLoaded = false;
    function loadPixel() {
      if (!metaPixelId || pixelLoaded) return;
      pixelLoaded = true;
      captureAttribution();
      var t = document.createElement('script');
      t.async = true;
      t.src = 'https://connect.facebook.net/en_US/fbevents.js';
      document.head.appendChild(t);
      fbq('init', metaPixelId);
      fbq('track', 'PageView');
    }

    window.elevoMeta = {
      hasConsent: hasMarketingConsent,
      getFbp: function () { return getCookie('_fbp'); },
      getFbc: getFbc,
      getUtm: getUtm,
      getExternalId: function () { return getCookie('_eid'); },
      getAttr: getStoredAttr,
      // VOR dem Request: erzeugt event_id + sammelt alle Match-/Attributions-
      // Parameter (fbp/fbc/fbclid/UTM/external_id), die im POST an die API
      // mitgeschickt werden (server-seitiges CAPI-Event mit DERSELBEN event_id).
      // Gibt null zurueck, wenn kein Marketing-Consent vorliegt — dann kein
      // Meta-Event, weder Browser noch Server.
      leadData: function () {
        if (!hasMarketingConsent()) return null;
        return {
          metaEventId: newEventId(),
          fbp: getCookie('_fbp'),
          fbc: getFbc(),
          fbclid: getStoredAttr().fbclid || qp('fbclid') || '',
          externalId: getCookie('_eid'),
          utm: getUtm(),
          actionSource: 'website',
          eventSourceUrl: location.href,
          eventTime: Math.floor(Date.now() / 1000)
        };
      },
      // NACH Server-Erfolg: feuert das Browser-Lead-Event mit derselben
      // event_id → Meta dedupliziert Browser- und Server-Event.
      fireLead: function (eventId, customData) {
        if (!hasMarketingConsent() || !window.fbq) return;
        fbq('track', 'Lead', customData || {}, eventId ? { eventID: eventId } : undefined);
      }
    };

    // Pixel nach Consent laden. Bereits gespeicherter Consent löst über
    // den Cookie-Banner `elevo:consent-granted` aus.
    window.addEventListener('elevo:consent-granted', loadPixel);

    function hasDeclinedMarketing() {
      try {
        var raw = localStorage.getItem(CONSENT_KEY);
        if (!raw) return false;
        return JSON.parse(raw).marketing === false;
      } catch (e) { return false; }
    }

    if (hasMarketingConsent()) {
      // Voll: Pixel + PageView + (spaeter) Lead inkl. Advanced Matching/Cookies.
      loadPixel();
    } else if (eagerPageView && !hasDeclinedMarketing()) {
      // LPV-optimierte Ad-LP: PageView fuer alle feuern, die nicht aktiv
      // abgelehnt haben, damit der (neue) Pixel LPV-Signal bekommt. Das
      // Lead-Event + Advanced Matching (E-Mail/Telefon, fbp/fbc) bleiben
      // weiterhin hinter dem Opt-in (leadData()/fireLead() pruefen Consent).
      loadPixel();
    }
  </script>
</head>

<body class={bodyClass}>
  <slot />
</body>
</html>
