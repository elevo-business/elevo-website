---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = 'Elevo — Webseiten und digitale Abläufe für inhabergeführte Unternehmen',
  description = 'Wir entwickeln digitale Systeme für Unternehmen, die ihre Abläufe ernst nehmen: ein CRM, das zur Infrastruktur passt, sauber verbundene Tools und Abläufe, die von selbst laufen. Festpreis, in vier bis sechs Wochen.',
  canonical = 'https://elevo.solutions/',
  ogImage = 'https://elevo.solutions/og-image.jpg',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="author" content="Elevo">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0E1A">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="de_DE">
  <meta property="og:site_name" content="Elevo">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@elevosolutions">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Canonical -->
  <link rel="canonical" href={canonical}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" type="image/svg+xml" href="/apple-touch-icon-180.svg">
  <meta name="apple-mobile-web-app-title" content="Elevo">

  <title>{title}</title>

  <!-- Fonts (self-hosted, DSGVO-konform) -->
  <link rel="preload" as="font" href="/fonts/Sora-latin.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="/fonts/Outfit-latin.woff2" type="font/woff2" crossorigin>

  <!-- Structured Data: LocalBusiness -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Elevo",
    "serviceType": "Digitale Systeme aus einer Hand: Webentwicklung, CRM-Einrichtung und Prozessautomatisierung",
    "description": "Elevo entwickelt digitale Systeme für Unternehmen, die ihre Abläufe ernst nehmen — CRM-Systeme, eingerichtet und über echte Schnittstellen mit der bestehenden Infrastruktur verbunden, damit Daten sauber zwischen den Systemen fließen.",
    "slogan": "Digitale Systeme aus einer Hand",
    "url": "https://elevo.solutions",
    "email": "hallo@elevo.solutions",
    "logo": "https://elevo.solutions/elevo-logo.png",
    "image": "https://elevo.solutions/og-image.jpg",
    "founder": {
      "@type": "Person",
      "name": "Mert Efecelik",
      "jobTitle": "Gründer",
      "url": "https://elevo.solutions/ueber-uns"
    },
    "availableLanguage": "de",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ahrstraße 6",
      "postalCode": "52511",
      "addressLocality": "Geilenkirchen",
      "addressRegion": "NRW",
      "addressCountry": "DE"
    },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Nordrhein-Westfalen" },
      { "@type": "City", "name": "Geilenkirchen" },
      { "@type": "City", "name": "Heinsberg" },
      { "@type": "City", "name": "Aachen" },
      { "@type": "City", "name": "Düren" },
      { "@type": "City", "name": "Mönchengladbach" },
      { "@type": "City", "name": "Köln" },
      { "@type": "Country", "name": "Deutschland" },
      { "@type": "Country", "name": "Österreich" },
      { "@type": "Country", "name": "Schweiz" }
    ],
    "knowsAbout": ["Digitale Systeme", "Webentwicklung", "CRM-Einrichtung", "CRM-Integration", "Pipedrive", "HubSpot", "OnOffice", "Prozessautomatisierung", "Zapier", "Make", "Online-Terminbuchung", "Schnittstellen-Entwicklung"],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Digitale Systeme für inhabergeführte Unternehmen",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Website-Entwicklung",
            "description": "Individuell entwickelte Unternehmens-Websites — kein Baukasten, schnell auf Mobile und Desktop, direkt an CRM und Formulare angebunden."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "CRM-Einrichtung und Integration",
            "description": "Einrichtung von CRM-Systemen wie Pipedrive, HubSpot oder OnOffice und Anbindung über echte Schnittstellen an die bestehende Infrastruktur, damit Daten sauber zwischen den Systemen fließen."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Prozessautomatisierung",
            "description": "Automatisierung von Anfragen, Angeboten, Terminen und Erinnerungen über Zapier, Make oder eigene Schnittstellen — damit wiederkehrende Aufgaben von selbst laufen."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Laufende Betreuung und Weiterentwicklung",
            "description": "Wartung, Hosting, Sicherheits-Updates und kontinuierliche Verbesserung des digitalen Systems nach dem Launch."
          }
        }
      ]
    },
    "sameAs": [
      "https://linkedin.com/company/elevo-solutions",
      "https://instagram.com/elevo.solutions"
    ]
  }
  </script>

  <!--
    Google Ads + Consent Mode v2.
    Consent-Default wird inline gesetzt (kein Netzwerk, ~0,5 KiB).
    gtag.js selbst wird strikt POST-LCP geladen:
      - frühestens nach `load`-Event (LCP fuer Text-Hero ist davor abgeschlossen)
      - dann auf erste User-Interaktion ODER Hardcap 1500 ms nach `load`
      - Consent-Grant via Cookie-Banner triggert sofortiges Laden (ueber `elevo:consent-granted` CustomEvent)
    Vorher: requestIdleCallback feuerte auf 4G bereits ~2,6 s -> kollidierte mit LCP-Fenster.
  -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'analytics_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'wait_for_update': 500
    });
    gtag('js', new Date());
    gtag('config', 'AW-18023151518');

    (function(){
      var injected = false;
      var src = 'https://www.googletagmanager.com/gtag/js?id=AW-18023151518';

      function inject(){
        if (injected) return;
        injected = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = src;
        document.head.appendChild(s);
      }

      function armPostLoad(){
        // LCP fuer den Text-Hero ist zum `load`-Zeitpunkt sicher abgeschlossen.
        // Wir warten zusaetzlich auf erste User-Interaktion ODER Hardcap 1500 ms.
        var hardcap = setTimeout(inject, 1500);

        var events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
        function onInteract(){
          events.forEach(function(e){ window.removeEventListener(e, onInteract, true); });
          clearTimeout(hardcap);
          // Kurze Idle-Pause, damit gtag-Fetch nicht mit Click-Handler-Arbeit konkurriert.
          setTimeout(inject, 200);
        }
        events.forEach(function(e){
          window.addEventListener(e, onInteract, { capture: true, passive: true });
        });
      }

      if (document.readyState === 'complete') {
        armPostLoad();
      } else {
        window.addEventListener('load', armPostLoad, { once: true });
      }

      // Consent-Grant via Cookie-Banner -> sofort laden, damit Conversion-Tracking ohne Wartezeit greift.
      window.addEventListener('elevo:consent-granted', inject, { once: true });
    })();
  </script>
</head>

<body>
  <slot />
</body>
</html>
