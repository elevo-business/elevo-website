---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = 'Elevo — Webseiten und digitale Abläufe für inhabergeführte Unternehmen',
  description = 'Wir digitalisieren die Abläufe inhabergeführter Unternehmen und bauen die Automatisierung dahinter: Anfragen, Angebote und Termine laufen von selbst. Festpreis, klare Ziele.',
  canonical = 'https://elevo.solutions/',
  ogImage = 'https://elevo.solutions/og-image-1200x630.svg',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="keywords" content="Webseiten für inhabergeführte Unternehmen, Digitalisierung KMU, Webdesign DACH, Online-Terminbuchung, Anfragen automatisieren, Webseiten NRW">
  <meta name="author" content="Elevo">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0E1A">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="de_DE">
  <meta property="og:site_name" content="Elevo">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@elevosolutions">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Canonical -->
  <link rel="canonical" href={canonical}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" type="image/svg+xml" href="/apple-touch-icon-180.svg">
  <meta name="apple-mobile-web-app-title" content="Elevo">

  <title>{title}</title>

  <!-- Fonts (self-hosted, DSGVO-konform) -->
  <link rel="preload" as="font" href="/fonts/Sora-latin.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="/fonts/Outfit-latin.woff2" type="font/woff2" crossorigin>

  <!-- Structured Data: LocalBusiness -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Elevo",
    "serviceType": "Digitalisierung und Prozessautomatisierung für inhabergeführte Unternehmen",
    "description": "Elevo digitalisiert die Abläufe inhabergeführter Unternehmen und baut die Automatisierung dahinter — Anfragen, Angebote und Termine laufen von selbst.",
    "url": "https://elevo.solutions",
    "email": "hallo@elevo.solutions",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ahrstraße 6",
      "postalCode": "52511",
      "addressLocality": "Geilenkirchen",
      "addressRegion": "NRW",
      "addressCountry": "DE"
    },
    "areaServed": ["DE", "AT", "CH"],
    "knowsAbout": ["Webentwicklung", "Webdesign", "Online-Terminbuchung", "Anfragen-Automatisierung", "Kundenliste digitalisieren", "Webseiten für inhabergeführte Unternehmen"],
    "sameAs": []
  }
  </script>

  <!--
    Google Ads + Consent Mode v2.
    Consent-Default wird inline gesetzt (kein Netzwerk, ~0,5 KiB).
    gtag.js selbst wird strikt POST-LCP geladen:
      - frühestens nach `load`-Event (LCP fuer Text-Hero ist davor abgeschlossen)
      - dann auf erste User-Interaktion ODER Hardcap 1500 ms nach `load`
      - Consent-Grant via Cookie-Banner triggert sofortiges Laden (ueber `elevo:consent-granted` CustomEvent)
    Vorher: requestIdleCallback feuerte auf 4G bereits ~2,6 s -> kollidierte mit LCP-Fenster.
  -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'analytics_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'wait_for_update': 500
    });
    gtag('js', new Date());
    gtag('config', 'AW-18023151518');

    (function(){
      var injected = false;
      var src = 'https://www.googletagmanager.com/gtag/js?id=AW-18023151518';

      function inject(){
        if (injected) return;
        injected = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = src;
        document.head.appendChild(s);
      }

      function armPostLoad(){
        // LCP fuer den Text-Hero ist zum `load`-Zeitpunkt sicher abgeschlossen.
        // Wir warten zusaetzlich auf erste User-Interaktion ODER Hardcap 1500 ms.
        var hardcap = setTimeout(inject, 1500);

        var events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
        function onInteract(){
          events.forEach(function(e){ window.removeEventListener(e, onInteract, true); });
          clearTimeout(hardcap);
          // Kurze Idle-Pause, damit gtag-Fetch nicht mit Click-Handler-Arbeit konkurriert.
          setTimeout(inject, 200);
        }
        events.forEach(function(e){
          window.addEventListener(e, onInteract, { capture: true, passive: true });
        });
      }

      if (document.readyState === 'complete') {
        armPostLoad();
      } else {
        window.addEventListener('load', armPostLoad, { once: true });
      }

      // Consent-Grant via Cookie-Banner -> sofort laden, damit Conversion-Tracking ohne Wartezeit greift.
      window.addEventListener('elevo:consent-granted', inject, { once: true });
    })();
  </script>
</head>

<body>
  <slot />
</body>
</html>
