---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = 'ELEVO — Webagentur Aachen | Websites, die Kunden bringen',
  description = 'ELEVO — Webagentur Aachen. Websites, Prozessdigitalisierung und SEO & Ads für wachstumsorientierte Unternehmen in der Region. Messbare Ergebnisse, faire Preise.',
  canonical = 'https://elevo.solutions/',
  ogImage = 'https://elevo.solutions/social-preview.png',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="keywords" content="Webagentur Aachen, Webdesign Aachen, SEO Aachen, Webentwicklung Aachen, Digitalagentur NRW, Website erstellen lassen Aachen">
  <meta name="author" content="ELEVO Solutions">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#3B82F6">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="de_DE">
  <meta property="og:site_name" content="ELEVO">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@elevosolutions">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Canonical -->
  <link rel="canonical" href={canonical}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 36'%3E%3Ccircle cx='18' cy='18' r='17' fill='%230A0E1A' stroke='%234A80F0' stroke-width='1.5'/%3E%3Cpath d='M10 22L15 17L20 22L25 14' stroke='%234A80F0' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <meta name="apple-mobile-web-app-title" content="ELEVO">

  <title>{title}</title>

  <!-- Fonts (self-hosted, DSGVO-konform) -->
  <link rel="preload" as="font" href="/fonts/Sora-latin.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="/fonts/Outfit-latin.woff2" type="font/woff2" crossorigin>

  <!-- Structured Data: LocalBusiness -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "ELEVO",
    "description": "Webagentur Aachen — Websites, Prozessdigitalisierung und SEO & Ads",
    "url": "https://elevo.solutions",
    "email": "hey@elevo.solutions",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ahrstraße 6",
      "postalCode": "52511",
      "addressLocality": "Geilenkirchen",
      "addressRegion": "NRW",
      "addressCountry": "DE"
    },
    "areaServed": ["Aachen", "NRW", "DACH"],
    "priceRange": "€€€",
    "knowsAbout": ["Webdesign", "SEO", "Prozessdigitalisierung", "Google Ads"],
    "sameAs": []
  }
  </script>

  <!-- Google Ads + Consent Mode v2 -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'analytics_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'wait_for_update': 500
    });
    gtag('js', new Date());
    gtag('config', 'AW-18023151518');
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18023151518"></script>
</head>

<body>
  <slot />
</body>
</html>
