---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = 'Elevo — Vom Klick zum Klienten: das 14-Tage-System für Coaches & Berater',
  description = 'Wir verwandeln die Besucher, die du schon hast, in gebuchte Anfragen. Verkaufsstarke Website, automatische Terminbuchung und Follow-up — komplett für dich gebaut, in 14 Tagen live. Mit Anfragen-Garantie.',
  canonical = 'https://elevo.solutions/',
  ogImage = 'https://elevo.solutions/og-image.jpg',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="author" content="Elevo">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0E1A">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="de_DE">
  <meta property="og:site_name" content="Elevo">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@elevosolutions">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Canonical -->
  <link rel="canonical" href={canonical}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" type="image/svg+xml" href="/apple-touch-icon-180.svg">
  <meta name="apple-mobile-web-app-title" content="Elevo">

  <title>{title}</title>

  <!-- Fonts (self-hosted, DSGVO-konform) -->
  <link rel="preload" as="font" href="/fonts/Sora-latin.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="/fonts/Outfit-latin.woff2" type="font/woff2" crossorigin>

  <!-- Structured Data: LocalBusiness -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Elevo",
    "serviceType": "Klienten-Gewinnungs-Systeme für Coaches und Berater: Conversion-Website, Terminbuchung, Follow-up-Automatisierung",
    "description": "Elevo baut Klienten-Gewinnungs-Systeme für Coaches und Berater im DACH-Raum: eine verkaufsstarke Website mit automatischer Terminbuchung und Follow-up, die vorhandene Website-Besucher in gebuchte Anfragen verwandelt. Done-for-you, in 14 Tagen live.",
    "slogan": "Vom Klick zum Klienten",
    "url": "https://elevo.solutions",
    "email": "hallo@elevo.solutions",
    "logo": "https://elevo.solutions/elevo-logo.png",
    "image": "https://elevo.solutions/og-image.jpg",
    "founder": {
      "@type": "Person",
      "name": "Mert Efe Celik",
      "jobTitle": "Gründer",
      "url": "https://elevo.solutions/ueber-uns"
    },
    "availableLanguage": "de",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ahrstraße 6",
      "postalCode": "52511",
      "addressLocality": "Geilenkirchen",
      "addressRegion": "NRW",
      "addressCountry": "DE"
    },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Nordrhein-Westfalen" },
      { "@type": "City", "name": "Geilenkirchen" },
      { "@type": "City", "name": "Heinsberg" },
      { "@type": "City", "name": "Aachen" },
      { "@type": "City", "name": "Düren" },
      { "@type": "City", "name": "Mönchengladbach" },
      { "@type": "City", "name": "Köln" },
      { "@type": "Country", "name": "Deutschland" },
      { "@type": "Country", "name": "Österreich" },
      { "@type": "Country", "name": "Schweiz" }
    ],
    "knowsAbout": ["Klienten-Gewinnung", "Conversion-Optimierung", "Webentwicklung für Coaches", "Online-Terminbuchung", "Follow-up-Automatisierung", "Lead-Generierung", "Funnel-Aufbau", "Conversion-Tracking", "Marketing für Coaches und Berater"],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Klienten-Gewinnungs-System für Coaches und Berater",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Conversion-Website",
            "description": "Individuell entwickelte, verkaufsstarke Website mit glasklarer Strecke zum Termin — gebaut, um aus Besuchern gebuchte Anfragen zu machen."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Automatische Terminbuchung",
            "description": "Online-Terminbuchung direkt aus der Anfrage, synchron mit dem Kalender, inklusive automatischer Bestätigung und Erinnerung."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Follow-up-Automatisierung",
            "description": "Automatische Nachfass-Sequenzen per E-Mail und WhatsApp, damit keine Anfrage versickert — vollautomatisch im Hintergrund."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Tracking und Conversion-Optimierung",
            "description": "Sauberes Conversion-Tracking und 30 Tage Optimierung nach Launch, damit aus mehr Besuchern mehr Anfragen werden."
          }
        }
      ]
    },
    "sameAs": [
      "https://linkedin.com/company/elevo-solutions",
      "https://instagram.com/elevo.solutions"
    ]
  }
  </script>

  <!--
    Google Ads + Consent Mode v2.
    Consent-Default wird inline gesetzt (kein Netzwerk, ~0,5 KiB).
    gtag.js selbst wird strikt POST-LCP geladen:
      - frühestens nach `load`-Event (LCP fuer Text-Hero ist davor abgeschlossen)
      - dann auf erste User-Interaktion ODER Hardcap 1500 ms nach `load`
      - Consent-Grant via Cookie-Banner triggert sofortiges Laden (ueber `elevo:consent-granted` CustomEvent)
    Vorher: requestIdleCallback feuerte auf 4G bereits ~2,6 s -> kollidierte mit LCP-Fenster.
  -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'analytics_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'wait_for_update': 500
    });
    gtag('js', new Date());
    gtag('config', 'AW-18023151518');

    (function(){
      var injected = false;
      var src = 'https://www.googletagmanager.com/gtag/js?id=AW-18023151518';

      function inject(){
        if (injected) return;
        injected = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = src;
        document.head.appendChild(s);
      }

      function armPostLoad(){
        // LCP fuer den Text-Hero ist zum `load`-Zeitpunkt sicher abgeschlossen.
        // Wir warten zusaetzlich auf erste User-Interaktion ODER Hardcap 1500 ms.
        var hardcap = setTimeout(inject, 1500);

        var events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
        function onInteract(){
          events.forEach(function(e){ window.removeEventListener(e, onInteract, true); });
          clearTimeout(hardcap);
          // Kurze Idle-Pause, damit gtag-Fetch nicht mit Click-Handler-Arbeit konkurriert.
          setTimeout(inject, 200);
        }
        events.forEach(function(e){
          window.addEventListener(e, onInteract, { capture: true, passive: true });
        });
      }

      if (document.readyState === 'complete') {
        armPostLoad();
      } else {
        window.addEventListener('load', armPostLoad, { once: true });
      }

      // Consent-Grant via Cookie-Banner -> sofort laden, damit Conversion-Tracking ohne Wartezeit greift.
      window.addEventListener('elevo:consent-granted', inject, { once: true });
    })();
  </script>

  <!--
    Meta-Pixel (Conversions-API-Gegenstück). Das 'Lead'-Event wird zusätzlich
    serverseitig über api.elevo.solutions/api/contact gemeldet; beide nutzen
    dieselbe event_id → Meta dedupliziert. Pixel-ID muss mit META_PIXEL_ID in
    api/contact.php (bzw. der Coolify-Env-Var) übereinstimmen.
    fbevents.js wird post-LCP geladen; PageView wird über die fbq-Queue gepuffert.
  -->
  <script is:inline>
    // 👉 HIER die Meta-Pixel-ID (= Dataset-ID aus dem Events Manager) eintragen:
    var META_PIXEL_ID = '';

    if (META_PIXEL_ID) {
      (function (f, b, e, v) {
        if (f.fbq) return;
        var n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
        f.__fbInject = function () {
          if (f.__fbInjected) return; f.__fbInjected = true;
          var t = b.createElement(e); t.async = true; t.src = v;
          var s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
        };
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

      fbq('init', META_PIXEL_ID);
      fbq('track', 'PageView');

      // fbevents.js erst post-LCP nachladen (Performance), Hardcap 1500 ms nach `load`.
      var fbArm = function () { setTimeout(window.__fbInject, 1500); };
      if (document.readyState === 'complete') fbArm();
      else window.addEventListener('load', fbArm, { once: true });
    }
  </script>
</head>

<body>
  <slot />
</body>
</html>
