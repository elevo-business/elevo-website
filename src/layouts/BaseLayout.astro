---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = 'Elevo — Digitale Werkstatt für den deutschen Mittelstand',
  description = 'Elevo baut Webseiten, die wie 10.000 Euro wirken — und Anfragen bringen, statt nur gut auszusehen. Premium-Webseiten, Performance- & SEO-Rettung, Conversion-Sites für den deutschen Mittelstand.',
  canonical = 'https://elevo.solutions/',
  ogImage = 'https://elevo.solutions/og-image-1200x630.svg',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="keywords" content="Digital Boutique, Webdesign DACH, SEO, Webentwicklung, Digitalagentur NRW, Website erstellen lassen, Prozessdigitalisierung KMU">
  <meta name="author" content="Elevo">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0D1B2A">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="de_DE">
  <meta property="og:site_name" content="Elevo">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@elevosolutions">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Canonical -->
  <link rel="canonical" href={canonical}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" type="image/svg+xml" href="/apple-touch-icon-180.svg">
  <meta name="apple-mobile-web-app-title" content="Elevo">

  <title>{title}</title>

  <!-- Fonts (self-hosted, DSGVO-konform) -->
  <link rel="preload" as="font" href="/fonts/Sora-latin.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="/fonts/Outfit-latin.woff2" type="font/woff2" crossorigin>

  <!-- Structured Data: LocalBusiness -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Elevo",
    "description": "Elevo — Digitale Werkstatt für den deutschen Mittelstand. Premium-Webseiten, Performance- & SEO-Rettung, Conversion-Sites.",
    "url": "https://elevo.solutions",
    "email": "hallo@elevo.solutions",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ahrstraße 6",
      "postalCode": "52511",
      "addressLocality": "Geilenkirchen",
      "addressRegion": "NRW",
      "addressCountry": "DE"
    },
    "areaServed": ["Aachen", "NRW", "DACH", "DE"],
    "knowsAbout": ["Webdesign", "SEO", "Prozessdigitalisierung", "Conversion-Webseiten"],
    "sameAs": []
  }
  </script>

  <!--
    Google Ads Conversion-Tracking + Consent Mode v2.
    Consent-Default wird inline gesetzt (kein Netzwerk, ~0,5 KiB).
    gtag.js wird ausschliesslich nach aktiver Einwilligung ueber das Cookie-Banner
    geladen (CustomEvent `elevo:consent-granted`). Kein Pre-Consent-Loading,
    keine Hardcap-Auto-Injection — Art. 6 Abs. 1 lit. a DSGVO + § 25 TTDSG.
  -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'analytics_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'wait_for_update': 500
    });
    gtag('js', new Date());
    gtag('config', 'AW-18023151518');

    (function(){
      var injected = false;
      function inject(){
        if (injected) return;
        injected = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=AW-18023151518';
        document.head.appendChild(s);
      }
      window.addEventListener('elevo:consent-granted', inject, { once: true });
    })();
  </script>
</head>

<body>
  <slot />
</body>
</html>
