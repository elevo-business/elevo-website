---
import kb from '../../config/kanzlei-berlin.json';
import Bold from './Bold.astro';
import CheckIcon from './CheckIcon.astro';

const { eyebrow, defaultVariant, headlines, subline, trust } = kb.hero;
const initial = headlines[defaultVariant as keyof typeof headlines] ?? headlines.a;
---

<header class="pt-5 text-center sm:pt-8">
  {eyebrow && <p class="text-[15px] font-semibold text-muted sm:text-base">{eyebrow}</p>}
  <h1 class="mt-2 text-[1.75rem] leading-[1.15] font-extrabold tracking-[-0.025em] text-balance text-ink sm:text-[2.6rem]" data-headline>
    {initial}
  </h1>
  <script is:inline define:vars={{ headlines, defaultVariant }}>
    // Headline-Test passend zur Anzeige: ?h=a|b|c, sonst gemerkte Variante, sonst Standard – direkt nach der H1, damit nichts springt.
    (function () {
      var v = defaultVariant;
      try {
        var p = (new URLSearchParams(location.search).get('h') || '').toLowerCase();
        var s = sessionStorage.getItem('lp_headline');
        if (headlines[p]) { v = p; sessionStorage.setItem('lp_headline', p); }
        else if (headlines[s]) v = s;
      } catch (e) {}
      var h = document.querySelector('[data-headline]');
      if (h && headlines[v]) h.textContent = headlines[v];
    })();
  </script>
  {subline && <p class="mx-auto mt-2.5 max-w-[600px] text-[15px] leading-snug text-pretty sm:text-lg">{subline}</p>}
  <ul class="mx-auto mt-4 grid max-w-[600px] gap-1 rounded-2xl border-2 border-accent bg-accent-soft px-3.5 py-2.5 text-left sm:mt-5 sm:gap-1.5 sm:py-3 sm:px-5">
    {
      trust.map((line) => (
        <li class="flex gap-2.5 text-[14.5px] leading-snug sm:text-[17px]">
          <CheckIcon class="mt-0.5 size-5 text-ink" />
          <span><Bold text={line} /></span>
        </li>
      ))
    }
  </ul>
</header>
