---
import kb from '../../config/kanzlei-berlin.json';
import CtaButton from './CtaButton.astro';

const { headline, items, processHeadline, process, button } = kb.guarantee;
---

<section class="mt-16" aria-labelledby="garantie-titel">
  <h2 id="garantie-titel" class="text-center text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{headline}</h2>
  <div class="mt-8 grid gap-5 sm:grid-cols-2">
    {
      items.map((item, i) => (
        <div class="rounded-2xl border-2 border-ink bg-white p-5 sm:p-6">
          <div class="flex items-center gap-3">
            {i === 0 ? (
              <svg class="size-8 shrink-0 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" />
              </svg>
            ) : (
              <svg class="size-8 shrink-0 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z" />
                <path d="m8.8 12 2.2 2.2 4.2-4.4" />
              </svg>
            )}
            <h3 class="text-xl leading-tight font-bold text-ink">{item.title}</h3>
          </div>
          <p class="mt-3">{item.text}</p>
        </div>
      ))
    }
  </div>

  {
    process?.length > 0 && (
      <div class="mt-10">
        <h3 class="text-xl font-bold text-ink">{processHeadline}</h3>
        <ol class="mt-4 space-y-3">
          {process.map((step, i) => (
            <li class="flex gap-3">
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-ink text-sm font-bold text-white" aria-hidden="true">{i + 1}</span>
              <span class="pt-0.5">{step}</span>
            </li>
          ))}
        </ol>
      </div>
    )
  }

  <div class="mx-auto mt-8 max-w-sm">
    <CtaButton label={button} />
  </div>
</section>
