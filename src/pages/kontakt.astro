---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LeadQuiz from '../components/LeadQuiz.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
import '../styles/ev-system.css';
---

<BaseLayout
  title="Leads anfragen — Elevo"
  description="Fordern Sie aktuelle, exklusive Leads mit Ersatz-Garantie an. Ein paar kurze Fragen, dann Ihre Kontaktdaten — wir melden uns kurzfristig."
  canonical="https://elevo.solutions/kontakt"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <SiteHeader />

  <main id="main">
    <section class="ev-page-hero" aria-labelledby="kontakt-hero-heading">
      <div class="container">
        <p class="ev-eyebrow">Leads anfragen</p>
        <h1 id="kontakt-hero-heading" class="ev-hero-h1">
          Reden wir über<br>
          <span class="ev-accent">Ihre freien Kapazitäten.</span>
        </h1>
        <p class="ev-hero-sub">
          Aktuelle, exklusive Leads mit kostenloser Ersatz-Garantie. Kein Retainer, kein Setup —
          Sie zahlen nur pro qualifiziertem Lead.
        </p>
      </div>
    </section>

    <section class="ev-section ev-section-alt" aria-label="Kontaktformular">
      <div class="container">
        <div class="kontakt-grid">
          <div>
            <p class="ev-eyebrow">Kontakt aufnehmen</p>
            <h2 class="ev-h2">Direkt. Persönlich. Konkret.</h2>
            <p class="ev-section-sub" style="margin-left:0;">Kein Ticketsystem, kein Callcenter. Sie sprechen direkt mit den Menschen, die Ihre Leads liefern.</p>
            <ul class="kontakt-list" role="list">
              <li>
                <span class="kontakt-label">E-Mail</span>
                <a href="mailto:hey@elevo.solutions">hey@elevo.solutions</a>
              </li>
              <li>
                <span class="kontakt-label">Für wen</span>
                <span>Fulfillment-Center &amp; 3PL-/Logistikdienstleister</span>
              </li>
              <li>
                <span class="kontakt-label">Modell</span>
                <span>Pay-per-Lead, exklusiv, mit Ersatz-Garantie</span>
              </li>
            </ul>
          </div>
          <LeadQuiz />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <CookieBanner />
</BaseLayout>

<style>
  .kontakt-list { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 18px; }
  .kontakt-list li { display: flex; flex-direction: column; gap: 4px; }
  .kontakt-label { font-family: var(--font-heading); font-weight: 700; font-size: 0.76rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  .kontakt-list a { color: var(--accent); font-weight: 600; }
  .kontakt-list span:not(.kontakt-label) { color: var(--text-primary); font-weight: 500; }

  .kontakt-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }

  @media (max-width: 900px) {
    .kontakt-grid { grid-template-columns: 1fr; }
  }
</style>
