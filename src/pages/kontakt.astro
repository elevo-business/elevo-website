---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/global.css';
import '../styles/ev-system.css';
---

<BaseLayout
  title="Kontakt — Elevo"
  description="Kostenloses Erstgespräch vereinbaren. 30 Minuten, kein Verkaufsdruck. Schreiben Sie uns — wir antworten innerhalb von 24 Stunden. Elevo aus Geilenkirchen, für den Raum Aachen."
  canonical="https://elevo.solutions/kontakt"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <main id="main">
    <!-- ===== HERO ===== -->
    <section class="ev-page-hero" aria-labelledby="kontakt-hero-heading">
      <div class="container">
        <p class="ev-eyebrow">Kontakt</p>
        <h1 id="kontakt-hero-heading" class="ev-hero-h1">
          Lassen Sie uns über<br>
          <span class="ev-accent">Ihr System sprechen.</span>
        </h1>
        <p class="ev-hero-sub">
          Kostenloses Erstgespräch — 30 Minuten, kein Verkaufsdruck. Wir schauen uns Ihre
          Abläufe an und sagen Ihnen ehrlich, wo der größte Hebel liegt.
        </p>
      </div>
    </section>

    <!-- ===== KONTAKT ===== -->
    <section id="kontakt" class="ev-section ev-section-alt" aria-labelledby="kontakt-heading">
      <div class="container">
        <div class="ev-kontakt-grid">
          <div>
            <p class="ev-eyebrow">Kontakt aufnehmen</p>
            <h2 id="kontakt-heading" class="ev-h2">Direkt. Persönlich. Konkret.</h2>
            <p class="ev-section-sub">Kein Ticketsystem, kein Callcenter. Sie sprechen direkt mit den Menschen, die Ihr Projekt umsetzen.</p>
            <ul class="ev-kontakt-list" role="list">
              <li>
                <span class="ev-kontakt-label">E-Mail</span>
                <a href="mailto:hallo@elevo.solutions">hallo@elevo.solutions</a>
              </li>
              <li>
                <span class="ev-kontakt-label">Standort</span>
                <span>Ahrstraße 6, 52511 Geilenkirchen · NRW</span>
              </li>
              <li>
                <span class="ev-kontakt-label">Antwort</span>
                <span>Innerhalb von 24 Stunden</span>
              </li>
            </ul>
          </div>
          <div class="ev-kontakt-form">
            <ContactForm />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
