---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import Hero from '../components/Hero.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Kontakt — ELEVO Digital Boutique"
  description="Kostenloses Erstgespräch vereinbaren. 30 Minuten, kein Verkaufsdruck. Schreib uns oder ruf an — wir antworten innerhalb von 24 Stunden."
  canonical="https://elevo.solutions/kontakt"
>
  <a href="#hero" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <Hero
    badge="Kontakt"
    title='<span class="line">Lassen Sie uns über</span><span class="line accent">Ihr Projekt sprechen.</span>'
    subtitle="Kostenloses Erstgespräch — 30 Minuten, kein Verkaufsdruck. Wir analysieren gemeinsam, ob und wie wir Ihnen helfen können."
  />

  <!-- Kontakt -->
  <section id="kontakt" class="section" aria-labelledby="kontakt-heading" style="background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-dark) 100%);">
    <div class="container">
      <div class="kontakt-grid">
        <div class="kontakt-info reveal-left">
          <div class="section-label">Kontakt aufnehmen</div>
          <h2 id="kontakt-heading">Direkt.<br>Persönlich. Konkret.</h2>
          <p>Kein Ticketsystem, kein Callcenter. Sie sprechen direkt mit den Menschen, die Ihr Projekt umsetzen.</p>

          <div class="kontakt-details">
            <div class="kontakt-detail">
              <div class="kontakt-detail-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div>
              <div>
                <div class="kontakt-detail-label">E-Mail</div>
                <div class="kontakt-detail-val"><a href="mailto:hey@elevo.solutions">hey@elevo.solutions</a></div>
              </div>
            </div>
            <div class="kontakt-detail">
              <div class="kontakt-detail-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
              <div>
                <div class="kontakt-detail-label">Standort</div>
                <div class="kontakt-detail-val">Ahrstraße 6, 52511 Geilenkirchen · NRW</div>
              </div>
            </div>
            <div class="kontakt-detail">
              <div class="kontakt-detail-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
              <div>
                <div class="kontakt-detail-label">Antwortzeit</div>
                <div class="kontakt-detail-val">Innerhalb von 24 Stunden</div>
              </div>
            </div>
          </div>
        </div>

        <div class="reveal-right">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
