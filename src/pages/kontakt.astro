---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/global.css';
import '../styles/ev-system.css';
import '../styles/rx-theme.css';
---

<BaseLayout
  title="Wachstumsgespräch sichern — Elevo"
  description="Sichere dir dein kostenloses Wachstumsgespräch. Wir zeigen dir deinen größten Hebel und welche Stufe dich am schnellsten weiterbringt — unverbindlich, kein Verkaufsdruck. Antwort innerhalb von 24 Stunden. Für aufstrebende Unternehmen im DACH-Raum."
  canonical="https://elevo.solutions/kontakt"
  bodyClass="rx"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <main id="main">
    <!-- ===== HERO ===== -->
    <section class="ev-page-hero" aria-labelledby="kontakt-hero-heading">
      <div class="container">
        <p class="ev-eyebrow">Wachstumsgespräch</p>
        <h1 id="kontakt-hero-heading" class="ev-hero-h1">
          Lass uns über<br>
          <span class="ev-accent">dein Wachstum reden.</span>
        </h1>
        <p class="ev-hero-sub">
          Kostenloses Wachstumsgespräch, ganz unverbindlich. Wir schauen uns deinen Auftritt an und
          sagen dir ehrlich, wo dein größter Hebel liegt — und welche Stufe dich am schnellsten weiterbringt.
        </p>
      </div>
    </section>

    <!-- ===== KONTAKT ===== -->
    <section id="kontakt" class="ev-section ev-section-alt" aria-labelledby="kontakt-heading">
      <div class="container">
        <div class="ev-kontakt-grid">
          <div>
            <p class="ev-eyebrow">Kontakt aufnehmen</p>
            <h2 id="kontakt-heading" class="ev-h2">Direkt. Persönlich. Konkret.</h2>
            <p class="ev-section-sub">Kein Ticketsystem, kein Callcenter. Du sprichst direkt mit den Menschen, die dein Wachstum bauen.</p>
            <ul class="ev-kontakt-list" role="list">
              <li>
                <span class="ev-kontakt-label">E-Mail</span>
                <a href="mailto:hallo@elevo.solutions">hallo@elevo.solutions</a>
              </li>
              <li>
                <span class="ev-kontakt-label">Für wen</span>
                <span>Aufstrebende Unternehmen im DACH-Raum</span>
              </li>
              <li>
                <span class="ev-kontakt-label">Antwort</span>
                <span>Innerhalb von 24 Stunden</span>
              </li>
            </ul>
          </div>
          <div class="ev-kontakt-form">
            <ContactForm />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
