---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/ev-system.css';

// Pipedrive Scheduler: Buchungs-Link hier oder via ENV (PUBLIC_PIPEDRIVE_SCHEDULER_URL).
// Erzeugt beim Buchen automatisch einen Google-Meet-Link und legt Activity/Lead in
// Pipedrive an. Leichte Qualifizierung (Name, E-Mail, "Was machst du?") als Scheduler-Frage.
const SCHEDULER_URL = import.meta.env.PUBLIC_PIPEDRIVE_SCHEDULER_URL ?? '';

// Google-Profil-Link (für "Auf Google ansehen").
const GOOGLE_PROFILE_URL = import.meta.env.PUBLIC_GOOGLE_PROFILE_URL ?? '';

// ⚠️ PLATZHALTER — durch ECHTE Google-Rezensionen ersetzen (Text, Name, Sterne, Datum).
// Keine erfundenen Bewertungen live schalten.
const reviews = [
  { name: 'Sandra K.', initial: 'S', rating: 5, date: 'vor 2 Wochen', text: 'Mert hat unsere Seite in zwei Wochen umgebaut. Die ersten Anfragen kamen schneller als erwartet, Kommunikation top, alles aus einer Hand.' },
  { name: 'Tobias M.', initial: 'T', rating: 5, date: 'vor 1 Monat', text: 'Endlich eine Seite, die nicht nur schön ist, sondern Anfragen bringt. Sehr professionell und schnell umgesetzt.' },
  { name: 'Yasemin A.', initial: 'Y', rating: 5, date: 'vor 1 Monat', text: 'Ehrliche Beratung ohne Verkaufsdruck. Klare Empfehlung für Coaches, die mehr aus ihrer Reichweite holen wollen.' },
];
const avgRating = (reviews.reduce((s, r) => s + r.rating, 0) / reviews.length).toFixed(1).replace('.', ',');
---

<BaseLayout
  title="Kostenloser Funnel-Check für Coaches & Berater — Elevo"
  description="In 20 Minuten zeigen wir dir an deiner eigenen Seite, wo Anfragen verloren gehen — und wie aus deiner Reichweite gebuchte Erstgespräche werden. Kostenlos, kein Pitch."
  canonical="https://elevo.solutions/funnel-check"
  noindex={true}
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <header class="lp-header">
    <div class="container lp-header-inner">
      <Logo size="md" />
      <a href="#termin" class="ev-btn ev-btn-primary lp-header-cta">Termin sichern</a>
    </div>
  </header>

  <main id="main">

    <!-- ===== HERO ===== -->
    <section class="ev-hero lp-hero" aria-labelledby="lp-hero-heading">
      <div class="container">
        <div class="ev-hero-grid">
          <div class="ev-hero-copy">
            <p class="ev-eyebrow">Kostenloser Funnel-Check für Coaches &amp; Berater</p>
            <h1 id="lp-hero-heading" class="ev-hero-h1">
              Du hast die Reichweite.<br>
              Hol dir die <span class="ev-accent">Anfragen.</span>
            </h1>
            <p class="ev-hero-sub">
              In 20 Minuten zeigen wir dir an deiner eigenen Seite, wo Anfragen verloren gehen —
              und wie aus deiner Reichweite planbar gebuchte Erstgespräche werden.
            </p>
            <div class="ev-hero-ctas">
              <a href="#termin" class="ev-btn ev-btn-primary">
                Kostenlosen Termin sichern
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
            <p class="ev-hero-trust">Kostenlos · ~20 Minuten · kein Pitch</p>
          </div>

          <aside class="lp-getcard" aria-label="Das bekommst du im Funnel-Check">
            <p class="lp-getcard-title">Das nimmst du mit:</p>
            <ul class="lp-getcard-list" role="list">
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Wo auf deiner Seite Anfragen verloren gehen</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Ein konkreter Plan, was du ändern musst</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Ehrlich: ob das 14-Tage-System zu dir passt</li>
            </ul>
            <a href="#termin" class="ev-btn ev-btn-ghost lp-getcard-cta">Termin wählen →</a>
            <p class="lp-getcard-note">Garantie aufs System: keine Anfrage in 30 Tagen? Kostet dich nichts.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ===== PROBLEM (Pains) ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-problem-heading">
      <div class="container">
        <p class="ev-eyebrow">Kommt dir bekannt vor?</p>
        <h2 id="lp-problem-heading" class="ev-h2">Reichweite ist da. Die Anfragen fehlen.</h2>
        <div class="lp-pains">
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Monate ohne neue Klienten</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Reichweite ohne Umsatz</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Ad-Budget, das verpufft</div>
        </div>
        <p class="ev-section-sub" style="margin-top:28px;">
          Das liegt selten an deinem Angebot. Es liegt an der Strecke dahinter — dem Weg vom
          Besucher zum gebuchten Termin. Wie teuer dich das wird, rechne kurz nach:
        </p>
      </div>
    </section>

    <!-- ===== RECHNER ===== -->
    <section class="ev-section" aria-labelledby="lp-calc-heading">
      <div class="container">
        <p class="ev-eyebrow">Rechne nach</p>
        <h2 id="lp-calc-heading" class="ev-h2">Wie viele Anfragen kostet dich deine Conversion?</h2>
        <p class="ev-section-sub">Stell deine Zahlen ein. Der Rechner zeigt, wie viele Anfragen jedes Jahr durch niedrige Conversion und ineffiziente Abläufe verloren gehen — bei gleicher Reichweite.</p>

        <div class="ev-calc">
          <div class="ev-calc-inputs">
            <div class="ev-calc-field">
              <div class="ev-calc-field-head"><label for="calc-visitors">Besucher pro Monat</label><output id="calc-visitors-out" class="ev-calc-val">2.500</output></div>
              <input type="range" id="calc-visitors" class="ev-range" min="200" max="20000" step="100" value="2500">
            </div>
            <div class="ev-calc-field">
              <div class="ev-calc-field-head"><label for="calc-rate">Aktuelle Anfrage-Rate</label><output id="calc-rate-out" class="ev-calc-val">1,5&nbsp;%</output></div>
              <input type="range" id="calc-rate" class="ev-range" min="0.5" max="6" step="0.5" value="1.5">
            </div>
            <div class="ev-calc-field">
              <div class="ev-calc-field-head"><label for="calc-close">Abschlussquote im Erstgespräch</label><output id="calc-close-out" class="ev-calc-val">30&nbsp;%</output></div>
              <input type="range" id="calc-close" class="ev-range" min="10" max="80" step="5" value="30">
            </div>
          </div>
          <div class="ev-calc-result">
            <p class="ev-calc-result-label">Anfragen, die du pro Jahr verschenkst</p>
            <p class="ev-calc-result-num" id="calc-lost">270</p>
            <div class="ev-calc-result-rows">
              <div class="ev-calc-stat"><strong id="calc-extra-clients">81</strong><span>zusätzliche Klienten / Jahr</span></div>
              <div class="ev-calc-stat"><strong id="calc-extra-month">23</strong><span>Mehr-Anfragen / Monat</span></div>
            </div>
            <a href="#termin" class="ev-btn ev-btn-primary ev-btn-block">Deine Zahlen im Funnel-Check besprechen</a>
            <p class="ev-calc-note">Überschlägige Rechnung auf Basis einer 2–3-fach besseren Conversion durch eine optimierte Strecke. Deine echten Werte schauen wir uns im Funnel-Check an.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== MECHANISMUS ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-mech-heading">
      <div class="container">
        <p class="ev-eyebrow">Der Mechanismus</p>
        <h2 id="lp-mech-heading" class="ev-h2">Vom Klick zum Klienten — automatisch.</h2>
        <div class="ev-flow-wrap" style="border-top:none; padding-top:0; margin-top:24px;">
          <div class="ev-flow" role="img" aria-label="Besucher landet auf der Seite, folgt einer klaren Strecke, bucht einen Termin, Follow-up läuft automatisch.">
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></span><span class="ev-flow-label">Besucher landet auf deiner Seite</span></div>
            <div class="ev-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg></span><span class="ev-flow-label">Klare Strecke führt zum Angebot</span></div>
            <div class="ev-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg></span><span class="ev-flow-label">Termin direkt gebucht</span></div>
            <div class="ev-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg></span><span class="ev-flow-label">Follow-up läuft, während du coachst</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SOCIAL PROOF: Case ===== -->
    <section class="ev-section" aria-labelledby="lp-proof-heading">
      <div class="container">
        <p class="ev-eyebrow">Echtes Ergebnis</p>
        <h2 id="lp-proof-heading" class="ev-h2">3 Wochen von null auf live. 5 Anfragen in Woche 1.</h2>
        <p class="ev-section-sub">GreenChild hatte Reichweite, aber keine Strecke. Nach dem Relaunch kamen in der ersten Woche fünf qualifizierte Anfragen — vorher null. Sieh selbst, live im Fenster.</p>
        <div class="ev-ref-grid" style="grid-template-columns:1fr; max-width:680px;">
          <article class="ev-ref-card">
            <div class="ev-ref-frame">
              <div class="ev-ref-bar" aria-hidden="true"><i></i><i></i><i></i><em>greenchild.eu</em></div>
              <div class="ev-ref-embed">
                <iframe src="https://greenchild-preview.elevo.solutions/de/" title="GreenChild" loading="lazy" tabindex="-1" referrerpolicy="no-referrer"></iframe>
                <a class="ev-ref-overlay" href="https://greenchild-preview.elevo.solutions/de/" target="_blank" rel="noopener" aria-label="GreenChild live öffnen">
                  <span class="ev-ref-open"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>Live öffnen</span>
                </a>
              </div>
            </div>
            <div class="ev-ref-meta">
              <span class="ev-ref-metric">5</span>
              <div class="ev-ref-text"><h3>GreenChild</h3><p>qualifizierte Anfragen in Woche 1 · vorher null</p></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== SOCIAL PROOF: Google-Bewertungen ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-reviews-heading">
      <div class="container">
        <div class="lp-reviews-head">
          <span class="lp-g" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="34" height="34"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06L5.84 9.9C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
          </span>
          <div>
            <p class="ev-eyebrow" style="margin-bottom:8px;">Google Bewertungen</p>
            <div class="lp-rating">
              <span class="lp-rating-num">{avgRating}</span>
              <span class="lp-stars" aria-hidden="true">★★★★★</span>
              <span class="lp-rating-count">· {reviews.length} Rezensionen</span>
            </div>
          </div>
        </div>

        <div class="lp-reviews">
          {reviews.map((r) => (
            <article class="lp-review">
              <div class="lp-review-top">
                <span class="lp-avatar">{r.initial}</span>
                <div class="lp-review-who"><strong>{r.name}</strong><span>{r.date}</span></div>
                <svg class="lp-review-g" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06L5.84 9.9C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
              </div>
              <div class="lp-review-stars" aria-label={`${r.rating} von 5 Sternen`}>★★★★★</div>
              <p class="lp-review-text">{r.text}</p>
            </article>
          ))}
        </div>
        {GOOGLE_PROFILE_URL && (
          <p style="text-align:center; margin-top:28px;">
            <a class="ev-btn ev-btn-ghost" href={GOOGLE_PROFILE_URL} target="_blank" rel="noopener">Alle Bewertungen auf Google ansehen →</a>
          </p>
        )}
      </div>
    </section>

    <!-- ===== GARANTIE ===== -->
    <section class="ev-section" aria-labelledby="lp-gar-heading">
      <div class="container">
        <div class="ev-guarantee">
          <div class="ev-guarantee-ico" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="ev-guarantee-body">
            <p class="ev-eyebrow">Unser Risiko, nicht deins</p>
            <h2 id="lp-gar-heading" class="ev-h2">Keine Anfrage? Kostet dich nichts.</h2>
            <p>In 14 Tagen ist dein System live — zum Festpreis, der vorher feststeht. Bekommst du in den 30 Tagen nach Launch keine qualifizierte Anfrage über die Seite, arbeiten wir kostenlos weiter, bis du sie hast.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== TERMIN / BUCHUNG (bewusst nicht ganz unten) ===== -->
    <section id="termin" class="ev-section ev-section-alt" aria-labelledby="lp-termin-heading">
      <div class="container">
        <div class="lp-termin">
          <p class="ev-eyebrow">Dein nächster Schritt</p>
          <h2 id="lp-termin-heading" class="ev-h2">Sichere dir deinen Funnel-Check.</h2>
          <p class="ev-section-sub" style="margin-left:auto;margin-right:auto;text-align:center;">
            Wähl dir einen Termin. Du bekommst sofort eine Bestätigung mit Google-Meet-Link.
            Kostenlos, ~20 Minuten, kein Verkaufsdruck.
          </p>

          {SCHEDULER_URL ? (
            <div class="lp-scheduler">
              <iframe src={SCHEDULER_URL} title="Funnel-Check Termin buchen" loading="lazy" referrerpolicy="no-referrer"></iframe>
            </div>
          ) : (
            <div class="lp-scheduler-fallback">
              <p><strong>Buchungs-Kalender wird hier eingebettet.</strong></p>
              <p>Setze deinen Pipedrive-Scheduler-Link als <code>PUBLIC_PIPEDRIVE_SCHEDULER_URL</code> — dann erscheint hier der Kalender mit automatischem Google-Meet-Link und Pipedrive-Sync.</p>
              <a class="ev-btn ev-btn-primary" href="mailto:hallo@elevo.solutions?subject=Funnel-Check%20Termin">Termin per E-Mail anfragen</a>
            </div>
          )}

          <ul class="lp-termin-trust" role="list">
            <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Automatischer Google-Meet-Link</li>
            <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Kostenlos &amp; unverbindlich</li>
            <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>~20 Minuten, kein Pitch</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== ÜBER MERT ===== -->
    <section class="ev-section" aria-labelledby="lp-mert-heading">
      <div class="container">
        <div class="ev-vision">
          <figure class="ev-vision-portrait">
            <picture>
              <source type="image/webp" srcset="/team/mert-800.webp 1x, /team/mert-1600.webp 2x">
              <img src="/team/mert-1200.jpg" alt="Mert Efe Celik, Gründer von Elevo" width="280" height="350" loading="lazy" decoding="async">
            </picture>
            <figcaption><strong>Mert Efe Celik</strong><span>Gründer · Elevo</span></figcaption>
          </figure>
          <div class="ev-vision-body">
            <p class="ev-eyebrow">Wer dich berät</p>
            <h2 id="lp-mert-heading" class="ev-h2">Kein Verkaufsgespräch. Ein ehrlicher Blick auf deine Strecke.</h2>
            <div class="ev-vision-text">
              <p>Im Funnel-Check schauen wir gemeinsam auf deine Seite und deine Reichweite. Du bekommst konkrete Stellen, an denen Anfragen verloren gehen — und einen Plan. Ob wir danach zusammenarbeiten, entscheidest du in Ruhe.</p>
              <p class="ev-vision-close">Wir verkaufen keine Websites. Wir verkaufen Anfragen.</p>
            </div>
            <div class="ev-vision-ctas">
              <a href="#termin" class="ev-btn ev-btn-primary">Termin sichern →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />

  <script>
    // ----- Anfragen-Rechner -----
    const visEl = document.getElementById('calc-visitors') as HTMLInputElement;
    const rateEl = document.getElementById('calc-rate') as HTMLInputElement;
    const closeEl = document.getElementById('calc-close') as HTMLInputElement;
    const visOut = document.getElementById('calc-visitors-out');
    const rateOut = document.getElementById('calc-rate-out');
    const closeOut = document.getElementById('calc-close-out');
    const lostOut = document.getElementById('calc-lost');
    const extraClientsOut = document.getElementById('calc-extra-clients');
    const extraMonthOut = document.getElementById('calc-extra-month');
    const de = new Intl.NumberFormat('de-DE');
    const UPLIFT_FACTOR = 2.5;

    function paintRange(el: HTMLInputElement) {
      const pct = ((+el.value - +el.min) / (+el.max - +el.min)) * 100;
      el.style.background = `linear-gradient(90deg, var(--accent) 0%, var(--accent) ${pct}%, rgba(255,255,255,0.12) ${pct}%, rgba(255,255,255,0.12) 100%)`;
    }
    function updateCalc() {
      if (!visEl || !rateEl || !closeEl) return;
      const visitors = +visEl.value, rate = +rateEl.value, close = +closeEl.value;
      const extraRate = rate * (UPLIFT_FACTOR - 1);
      const extraPerMonth = visitors * extraRate / 100;
      const extraPerYear = extraPerMonth * 12;
      const extraClients = extraPerYear * close / 100;
      if (visOut) visOut.textContent = de.format(visitors);
      if (rateOut) rateOut.innerHTML = rate.toLocaleString('de-DE') + '&nbsp;%';
      if (closeOut) closeOut.innerHTML = close + '&nbsp;%';
      if (lostOut) lostOut.textContent = de.format(Math.round(extraPerYear));
      if (extraClientsOut) extraClientsOut.textContent = de.format(Math.round(extraClients));
      if (extraMonthOut) extraMonthOut.textContent = de.format(Math.round(extraPerMonth));
      [visEl, rateEl, closeEl].forEach(paintRange);
    }
    if (visEl && rateEl && closeEl) {
      [visEl, rateEl, closeEl].forEach((el) => el.addEventListener('input', updateCalc));
      updateCalc();
    }
  </script>
</BaseLayout>

<style>
  .lp-header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(8, 11, 20, 0.85);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
