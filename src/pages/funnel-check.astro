---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/ev-system.css';

// Pipedrive Scheduler: Buchungs-Link hier oder via ENV (PUBLIC_PIPEDRIVE_SCHEDULER_URL) setzen.
// Der Scheduler erzeugt beim Buchen automatisch einen Google-Meet-Link und legt die
// Activity/den Lead direkt in Pipedrive an. Qualifizierung (leicht, 3 Felder: Name,
// E-Mail, „Was machst du?") wird als Frage im Scheduler konfiguriert.
const SCHEDULER_URL = import.meta.env.PUBLIC_PIPEDRIVE_SCHEDULER_URL ?? '';
---

<BaseLayout
  title="Kostenloser Funnel-Check für Coaches & Berater — Elevo"
  description="In 20 Minuten zeigen wir dir an deiner eigenen Seite, wo Anfragen verloren gehen — und wie aus deiner Reichweite gebuchte Erstgespräche werden. Kostenlos, kein Pitch."
  canonical="https://elevo.solutions/funnel-check"
  noindex={true}
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <!-- Minimaler, ablenkungsfreier Header (eine Aktion) -->
  <header class="lp-header">
    <div class="container lp-header-inner">
      <Logo size="md" />
      <a href="#termin" class="ev-btn ev-btn-primary lp-header-cta">Termin sichern</a>
    </div>
  </header>

  <main id="main">

    <!-- ===== HERO (Message-Match zur Ad) ===== -->
    <section class="ev-hero lp-hero" aria-labelledby="lp-hero-heading">
      <div class="container">
        <div class="ev-hero-grid">
          <div class="ev-hero-copy">
            <p class="ev-eyebrow">Kostenloser Funnel-Check für Coaches &amp; Berater</p>
            <h1 id="lp-hero-heading" class="ev-hero-h1">
              Du hast die Reichweite.<br>
              Hol dir die <span class="ev-accent">Anfragen.</span>
            </h1>
            <p class="ev-hero-sub">
              In 20 Minuten zeigen wir dir an deiner eigenen Seite, wo Anfragen verloren gehen —
              und wie aus deiner Reichweite planbar gebuchte Erstgespräche werden.
            </p>
            <div class="ev-hero-ctas">
              <a href="#termin" class="ev-btn ev-btn-primary">
                Kostenlosen Termin sichern
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
            <p class="ev-hero-trust">Kostenlos · ~20 Minuten · kein Pitch</p>
          </div>

          <aside class="lp-getcard" aria-label="Das bekommst du im Funnel-Check">
            <p class="lp-getcard-title">Das nimmst du mit:</p>
            <ul class="lp-getcard-list" role="list">
              <li>
                <span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
                Wo auf deiner Seite Anfragen verloren gehen
              </li>
              <li>
                <span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
                Ein konkreter Plan, was du ändern musst
              </li>
              <li>
                <span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
                Ehrlich: ob das 14-Tage-System zu dir passt
              </li>
            </ul>
            <a href="#termin" class="ev-btn ev-btn-ghost lp-getcard-cta">Termin wählen →</a>
            <p class="lp-getcard-note">Garantie aufs System: keine Anfrage in 30 Tagen? Kostet dich nichts.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ===== PROBLEM (Pains – Message-Match zur Ad) ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-problem-heading">
      <div class="container">
        <p class="ev-eyebrow">Kommt dir bekannt vor?</p>
        <h2 id="lp-problem-heading" class="ev-h2">Reichweite ist da. Die Anfragen fehlen.</h2>
        <div class="lp-pains">
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Monate ohne neue Klienten</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Reichweite ohne Umsatz</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Ad-Budget, das verpufft</div>
        </div>
        <p class="ev-section-sub" style="margin-top:28px;">
          Das liegt selten an deinem Angebot. Es liegt an der Strecke dahinter — dem Weg vom
          Besucher zum gebuchten Termin. Genau die schauen wir uns im Funnel-Check an.
        </p>
      </div>
    </section>

    <!-- ===== MECHANISMUS: Vom Klick zum Klienten ===== -->
    <section class="ev-section" aria-labelledby="lp-mech-heading">
      <div class="container">
        <p class="ev-eyebrow">Der Mechanismus</p>
        <h2 id="lp-mech-heading" class="ev-h2">Vom Klick zum Klienten — automatisch.</h2>
        <div class="ev-flow-wrap" style="border-top:none; padding-top:0; margin-top:24px;">
          <div class="ev-flow" role="img" aria-label="Besucher landet auf der Seite, folgt einer klaren Strecke, bucht einen Termin, Follow-up läuft automatisch.">
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></span><span class="ev-flow-label">Besucher landet auf deiner Seite</span></div>
            <div class="ev-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg></span><span class="ev-flow-label">Klare Strecke führt zum Angebot</span></div>
            <div class="ev-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg></span><span class="ev-flow-label">Termin direkt gebucht</span></div>
            <div class="ev-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg></span><span class="ev-flow-label">Follow-up läuft, während du coachst</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SOCIAL PROOF (gehört auf die LP) ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-proof-heading">
      <div class="container">
        <p class="ev-eyebrow">Echtes Ergebnis</p>
        <h2 id="lp-proof-heading" class="ev-h2">3 Wochen von null auf live. 5 Anfragen in Woche 1.</h2>
        <p class="ev-section-sub">GreenChild hatte Reichweite, aber keine Strecke. Nach dem Relaunch kamen in der ersten Woche fünf qualifizierte Anfragen — vorher null. Sieh selbst, live im Fenster.</p>
        <div class="ev-ref-grid" style="grid-template-columns:1fr; max-width:680px;">
          <article class="ev-ref-card">
            <div class="ev-ref-frame">
              <div class="ev-ref-bar" aria-hidden="true"><i></i><i></i><i></i><em>greenchild.eu</em></div>
              <div class="ev-ref-embed">
                <iframe src="https://greenchild-preview.elevo.solutions/de/" title="GreenChild" loading="lazy" tabindex="-1" referrerpolicy="no-referrer"></iframe>
                <a class="ev-ref-overlay" href="https://greenchild-preview.elevo.solutions/de/" target="_blank" rel="noopener" aria-label="GreenChild live öffnen">
                  <span class="ev-ref-open"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>Live öffnen</span>
                </a>
              </div>
            </div>
            <div class="ev-ref-meta">
              <span class="ev-ref-metric">5</span>
              <div class="ev-ref-text"><h3>GreenChild</h3><p>qualifizierte Anfragen in Woche 1 · vorher null</p></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== GARANTIE (Message-Match zur Ad) ===== -->
    <section class="ev-section" aria-labelledby="lp-gar-heading">
      <div class="container">
        <div class="ev-guarantee">
          <div class="ev-guarantee-ico" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="ev-guarantee-body">
            <p class="ev-eyebrow">Unser Risiko, nicht deins</p>
            <h2 id="lp-gar-heading" class="ev-h2">Keine Anfrage? Kostet dich nichts.</h2>
            <p>In 14 Tagen ist dein System live — zum Festpreis, der vorher feststeht. Bekommst du in den 30 Tagen nach Launch keine qualifizierte Anfrage über die Seite, arbeiten wir kostenlos weiter, bis du sie hast.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== ÜBER MERT ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-mert-heading">
      <div class="container">
        <div class="ev-vision">
          <figure class="ev-vision-portrait">
            <picture>
              <source type="image/webp" srcset="/team/mert-800.webp 1x, /team/mert-1600.webp 2x">
              <img src="/team/mert-1200.jpg" alt="Mert Efe Celik, Gründer von Elevo" width="280" height="350" loading="lazy" decoding="async">
            </picture>
            <figcaption><strong>Mert Efe Celik</strong><span>Gründer · Elevo</span></figcaption>
          </figure>
          <div class="ev-vision-body">
            <p class="ev-eyebrow">Wer dich berät</p>
            <h2 id="lp-mert-heading" class="ev-h2">Kein Verkaufsgespräch. Ein ehrlicher Blick auf deine Strecke.</h2>
            <div class="ev-vision-text">
              <p>Im Funnel-Check schauen wir gemeinsam auf deine Seite und deine Reichweite. Du bekommst konkrete Stellen, an denen Anfragen verloren gehen — und einen Plan. Ob wir danach zusammenarbeiten, entscheidest du in Ruhe.</p>
              <p class="ev-vision-close">Wir verkaufen keine Websites. Wir verkaufen Anfragen.</p>
            </div>
            <div class="ev-vision-ctas">
              <a href="#termin" class="ev-btn ev-btn-primary">Termin sichern →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== TERMIN / BUCHUNG ===== -->
    <section id="termin" class="ev-section" aria-labelledby="lp-termin-heading">
      <div class="container">
        <div class="lp-termin">
          <p class="ev-eyebrow">Dein nächster Schritt</p>
          <h2 id="lp-termin-heading" class="ev-h2">Sichere dir deinen Funnel-Check.</h2>
          <p class="ev-section-sub" style="margin-left:auto;margin-right:auto;text-align:center;">
            Wähl dir einen Termin. Du bekommst sofort eine Bestätigung mit Google-Meet-Link.
            Kostenlos, ~20 Minuten, kein Verkaufsdruck.
          </p>

          {SCHEDULER_URL ? (
            <div class="lp-scheduler">
              <iframe
                src={SCHEDULER_URL}
                title="Funnel-Check Termin buchen"
                loading="lazy"
                referrerpolicy="no-referrer"
              ></iframe>
            </div>
          ) : (
            <div class="lp-scheduler-fallback">
              <p><strong>Buchungs-Kalender wird hier eingebettet.</strong></p>
              <p>Setze deinen Pipedrive-Scheduler-Link als <code>PUBLIC_PIPEDRIVE_SCHEDULER_URL</code> (Environment-Variable) — dann erscheint hier der Kalender mit automatischem Google-Meet-Link und Pipedrive-Sync.</p>
              <a class="ev-btn ev-btn-primary" href="mailto:hallo@elevo.solutions?subject=Funnel-Check%20Termin">Termin per E-Mail anfragen</a>
            </div>
          )}

          <ul class="lp-termin-trust" role="list">
            <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Automatischer Google-Meet-Link</li>
            <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Kostenlos &amp; unverbindlich</li>
            <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>~20 Minuten, kein Pitch</li>
          </ul>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* Minimaler LP-Header */
  .lp-header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(8, 11, 20, 0.85);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .lp-header-inner {
    display: flex; align-items: center; justify-content: space-between;
    padding-top: 14px; padding-bottom: 14px;
  }
  .lp-header-cta { padding: 11px 22px; font-size: 0.92rem; }
  .lp-hero { padding-top: clamp(56px, 8vw, 96px); }

  /* "Das nimmst du mit"-Karte (Hero rechts) */
  .lp-getcard {
    background: linear-gradient(180deg, rgba(59,130,246,0.10), transparent 60%), var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 32px 30px;
    align-self: center;
  }
  .lp-getcard-title {
    font-family: var(--font-heading); font-weight: 800; color: var(--text-primary);
    font-size: 1.15rem; margin: 0 0 18px;
  }
  .lp-getcard-list { list-style: none; margin: 0 0 26px; padding: 0; display: grid; gap: 16px; }
  .lp-getcard-list li {
    display: flex; gap: 12px; align-items: flex-start;
    color: var(--text-secondary); font-size: 1rem; line-height: 1.45;
  }
  .lp-check {
    flex-shrink: 0; width: 24px; height: 24px; border-radius: 7px;
    background: rgba(59,130,246,0.14); color: var(--accent);
    display: inline-flex; align-items: center; justify-content: center; margin-top: 1px;
  }
  .lp-check svg { width: 13px; height: 13px; }
  .lp-getcard-cta { width: 100%; justify-content: center; }
  .lp-getcard-note { font-size: 0.82rem; color: var(--text-muted); margin: 16px 0 0; line-height: 1.45; }

  /* Pains */
  .lp-pains { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 8px; }
  .lp-pain {
    display: flex; align-items: center; gap: 12px;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px 22px;
    color: var(--text-primary); font-family: var(--font-heading); font-weight: 600; font-size: 1.05rem;
  }
  .lp-x { color: var(--danger); font-weight: 800; font-size: 1.2rem; }

  /* Termin / Scheduler */
  .lp-termin { max-width: 820px; margin: 0 auto; text-align: center; }
  .lp-termin .ev-h2 { margin-left: auto; margin-right: auto; }
  .lp-scheduler {
    margin: 32px 0 8px; border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-card);
  }
  .lp-scheduler iframe { width: 100%; min-height: 720px; border: 0; display: block; }
  .lp-scheduler-fallback {
    margin: 32px 0 8px; padding: 40px 30px; text-align: center;
    border: 1px dashed var(--border-strong); border-radius: var(--radius-lg);
    background: var(--bg-card);
  }
  .lp-scheduler-fallback p { color: var(--text-secondary); margin: 0 0 12px; line-height: 1.6; }
  .lp-scheduler-fallback code { color: var(--accent); font-family: ui-monospace, Menlo, monospace; font-size: 0.85em; }
  .lp-scheduler-fallback .ev-btn { margin-top: 12px; }

  .lp-termin-trust {
    list-style: none; padding: 0; margin: 26px 0 0;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 28px;
  }
  .lp-termin-trust li { display: flex; align-items: center; gap: 10px; color: var(--text-secondary); font-size: 0.95rem; }

  @media (max-width: 760px) {
    .lp-pains { grid-template-columns: 1fr; }
    .lp-header-cta { padding: 10px 18px; font-size: 0.86rem; }
  }
</style>
