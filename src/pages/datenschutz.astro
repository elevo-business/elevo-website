---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DatenschutzContent from '../components/legal/DatenschutzContent.astro';
import '../styles/global.css';
import '../styles/rx-theme.css';
---

<BaseLayout
  title="Datenschutzerklärung — Elevo"
  description="Datenschutzerklärung von Elevo (rechtlich: ELEVO Solutions) gemäß DSGVO."
  canonical="https://elevo.solutions/datenschutz"
  bodyClass="rx"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <SiteHeader />

  <main id="main" class="legal-page">
    <div class="container">
      <DatenschutzContent />
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .legal-page {
    padding: 64px 0 96px;
    min-height: 100vh;
  }
</style>
