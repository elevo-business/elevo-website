---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Referenzen — ELEVO Digital Boutique"
  description="Echte Ergebnisse für echte Kunden. +3× Reservierungen, +62% Buchungen, Platz 1 bei Google. Unsere Referenzprojekte."
  canonical="https://elevo.solutions/referenzen"
>
  <a href="#hero" class="skip-link">Zum Hauptinhalt springen</a>

  <!-- iFrame Modal -->
  <div id="ref-modal" class="ref-modal" role="dialog" aria-modal="true" aria-label="Website-Vorschau">
    <div class="ref-modal-backdrop"></div>
    <div class="ref-modal-window">
      <div class="ref-modal-bar">
        <div class="ref-modal-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="ref-modal-url-wrap">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="ref-modal-url" id="ref-modal-url"></span>
        </div>
        <div class="ref-modal-actions">
          <a class="ref-modal-open" id="ref-modal-open-btn" href="#" target="_blank" rel="noopener" aria-label="In neuem Tab öffnen">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
          <button class="ref-modal-close" id="ref-modal-close" aria-label="Schließen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>
      <div class="ref-modal-frame-wrap">
        <iframe
          id="ref-modal-frame"
          src=""
          title=""
          class="ref-modal-iframe"
          allow="fullscreen"
        ></iframe>
      </div>
    </div>
  </div>

  <Header />

  <Hero
    badge="Referenzen"
    title='<span class="line">Messbare Ergebnisse.</span><span class="line accent">Echte Kunden.</span>'
    subtitle="Keine Versprechen — echte Zahlen aus abgeschlossenen Projekten. Was wir für unsere Kunden erreicht haben."
    ctaText="Projekt besprechen"
    ctaHref="/kontakt"
    secondaryCtaText="Unsere Leistungen"
    secondaryCtaHref="/leistungen"
  />

  <!-- Trusted By -->
  <section id="trusted" aria-label="Unsere Kunden">
    <div class="container">
      <p class="trusted-label">Vertrauen uns bereits</p>
      <div class="trusted-track" role="list" aria-label="Referenzkunden">
        <span class="trusted-item" role="listitem">Greenchild</span>
        <span class="trusted-item" role="listitem">Akropolis Geilenkirchen</span>
        <span class="trusted-item" role="listitem">ZUMA Lounge</span>
        <span class="trusted-item" role="listitem">IT-Vertrieb GmbH</span>
      </div>
    </div>
  </section>

  <!-- Referenzen Showcase -->
  <section id="results" class="section" aria-labelledby="results-heading">
    <div class="container">
      <header class="section-header">
        <div class="section-label reveal">Unsere Arbeit</div>
        <h2 id="results-heading" class="reveal reveal-delay-1">Von 0 auf Wachstum.<br>Projekt für Projekt.</h2>
        <p class="reveal reveal-delay-2">Jedes Projekt hat eine Geschichte — hier sind die Zahlen dahinter.</p>
      </header>

      <ul class="ref-cards-grid" role="list">

        <!-- Akropolis Geilenkirchen -->
        <li class="ref-card reveal" aria-labelledby="ref-card-ak-heading">
          <div class="ref-card-top">
            <div class="ref-card-logo-wrap">
              <img src="/client-logos/akropolis.jpg" alt="Akropolis Geilenkirchen Logo" class="ref-card-logo" loading="lazy" decoding="async" width="110" height="36">
            </div>
            <span class="case-tag">Restaurant · Geilenkirchen</span>
          </div>
          <h3 id="ref-card-ak-heading" class="ref-card-title">Akropolis Geilenkirchen</h3>
          <p class="ref-card-desc">Griechisches Restaurant in Geilenkirchen. Nach Website-Relaunch: Platz 1 in der lokalen Google-Suche und dreifach mehr Tischreservierungen durch das Web.</p>
          <div class="ref-card-metric green">
            <span class="ref-card-metric-val">+3×</span>
            <span class="ref-card-metric-label">mehr Tischreservierungen nach Relaunch</span>
          </div>
          <div class="ref-card-services">Webdesign · Lokales SEO · Platz 1 Google</div>
          <button
            class="ref-card-link ref-modal-trigger"
            data-url="https://akropolis-geilenkirchen.com"
            data-label="Akropolis Geilenkirchen"
            data-display-url="akropolis-geilenkirchen.com"
            aria-label="Akropolis Geilenkirchen Website im Modal ansehen"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Website live ansehen
          </button>
        </li>

        <!-- ZUMA Lounge -->
        <li class="ref-card reveal" aria-labelledby="ref-card-zuma-heading">
          <div class="ref-card-top">
            <div class="ref-card-logo-wrap">
              <img src="/client-logos/zuma.svg" alt="ZUMA Lounge Logo" class="ref-card-logo" loading="lazy" decoding="async" width="110" height="36">
            </div>
            <span class="case-tag">Hospitality &amp; Events</span>
          </div>
          <h3 id="ref-card-zuma-heading" class="ref-card-title">ZUMA Lounge</h3>
          <p class="ref-card-desc">62 % mehr Buchungen durch eine optimierte Kontaktseite, Google-Werbekampagnen und verbesserte Nutzerführung — in nur 3 Monaten messbar.</p>
          <div class="ref-card-metric green">
            <span class="ref-card-metric-val">+62%</span>
            <span class="ref-card-metric-label">mehr Buchungen in 3 Monaten</span>
          </div>
          <div class="ref-card-services">Kontaktseite · Google Ads · Optimierung</div>
          <div class="ref-card-domain">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            zuma-lounge.de
          </div>
        </li>

        <!-- Greenchild -->
        <li class="ref-card reveal" aria-labelledby="ref-card-gc-heading">
          <div class="ref-card-top">
            <div class="ref-card-logo-wrap">
              <img src="/client-logos/greenchild.png" alt="Greenchild Logo" class="ref-card-logo" loading="lazy" decoding="async" width="110" height="36">
            </div>
            <span class="case-tag">Landwirtschaft &amp; Nachhaltigkeit</span>
          </div>
          <h3 id="ref-card-gc-heading" class="ref-card-title">Greenchild</h3>
          <p class="ref-card-desc">Von 0 auf Launch in 3 Wochen: vollständige Web-Plattform mit Konfigurator, DE/EN-Lokalisierung und digitalen Onboarding-Flows.</p>
          <div class="ref-card-metric">
            <span class="ref-card-metric-val">0→1</span>
            <span class="ref-card-metric-label">Von 0 auf Launch in 3 Wochen</span>
          </div>
          <div class="ref-card-services">Web-Plattform · DE/EN · Konfigurator</div>
          <button
            class="ref-card-link ref-modal-trigger"
            data-url="https://greenchild-preview.elevo.solutions/de/"
            data-label="Greenchild"
            data-display-url="greenchild-preview.elevo.solutions"
            aria-label="Greenchild Website im Modal ansehen"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Website live ansehen
          </button>
        </li>

        <!-- IT-Vertrieb GmbH -->
        <li class="ref-card reveal" aria-labelledby="ref-card-itv-heading">
          <div class="ref-card-top">
            <div class="ref-card-logo-wrap">
              <img src="/client-logos/it-vertrieb.svg" alt="IT-Vertrieb GmbH Logo" class="ref-card-logo" loading="lazy" decoding="async" width="110" height="36">
            </div>
            <span class="case-tag">Prozessdigitalisierung</span>
          </div>
          <h3 id="ref-card-itv-heading" class="ref-card-title">IT-Vertrieb GmbH</h3>
          <p class="ref-card-desc">12 Stunden manuelle Arbeit pro Woche automatisiert. Kundendaten, Angebotserstellung und Auftragsverfolgung — vollständig digital, ohne manuelle Eingriffe.</p>
          <div class="ref-card-metric">
            <span class="ref-card-metric-val">12h</span>
            <span class="ref-card-metric-label">manuelle Arbeit pro Woche automatisiert</span>
          </div>
          <div class="ref-card-services">Automatisierung · Kundenverwaltung · Auftragsverfolgung</div>
          <div class="ref-card-domain">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            it-vertrieb-gmbh.de
          </div>
        </li>

      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" aria-labelledby="cta-ref-heading" style="background: linear-gradient(180deg, var(--bg-dark) 0%, var(--bg-deep) 100%);">
    <div class="container">
      <div class="section-header">
        <div class="section-label reveal">Ihr Projekt</div>
        <h2 id="cta-ref-heading" class="reveal reveal-delay-1">Das nächste Ergebnis<br>könnte Ihres sein.</h2>
        <p class="reveal reveal-delay-2">Kostenloses Erstgespräch — unverbindlich, konkret und auf den Punkt.</p>
        <div class="hero-ctas reveal reveal-delay-3" style="margin-top: 32px;">
          <a href="/kontakt" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.6a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 5.61 5.61l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Jetzt Gespräch vereinbaren
          </a>
          <a href="/leistungen" class="btn-secondary">
            Unsere Leistungen
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    const modal = document.getElementById('ref-modal') as HTMLElement;
    const frame = document.getElementById('ref-modal-frame') as HTMLIFrameElement;
    const urlDisplay = document.getElementById('ref-modal-url') as HTMLElement;
    const openBtn = document.getElementById('ref-modal-open-btn') as HTMLAnchorElement;
    const closeBtn = document.getElementById('ref-modal-close') as HTMLButtonElement;
    const backdrop = modal?.querySelector('.ref-modal-backdrop') as HTMLElement;

    let lastFocus: HTMLElement | null = null;

    function openModal(url: string, label: string, displayUrl: string) {
      lastFocus = document.activeElement as HTMLElement;
      frame.src = url;
      frame.title = label;
      urlDisplay.textContent = displayUrl;
      openBtn.href = url;
      modal.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => { modal.classList.add('is-open'); });
      closeBtn.focus();
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.addEventListener('transitionend', () => {
        modal.classList.remove('is-visible');
        frame.src = '';
        document.body.style.overflow = '';
        lastFocus?.focus();
      }, { once: true });
    }

    document.querySelectorAll<HTMLElement>('.ref-modal-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.dataset.url!;
        const label = btn.dataset.label!;
        const displayUrl = btn.dataset.displayUrl || url;
        openModal(url, label, displayUrl);
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-visible')) closeModal();
    });
  </script>

  <style>
    /* Modal Trigger Button */
    .ref-modal-trigger {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 16px;
      padding: 10px 18px;
      background: transparent;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      color: var(--accent);
      font-family: var(--font-body);
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: background var(--transition), border-color var(--transition), color var(--transition);
      width: 100%;
      justify-content: center;
    }
    .ref-modal-trigger:hover {
      background: var(--accent-glow);
      border-color: var(--accent);
      color: var(--text-primary);
    }

    /* Modal Overlay */
    .ref-modal {
      position: fixed;
      inset: 0;
      z-index: 9000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      pointer-events: none;
    }
    .ref-modal.is-visible {
      display: flex;
      pointer-events: auto;
    }
    .ref-modal.is-open .ref-modal-backdrop {
      opacity: 1;
    }
    .ref-modal.is-open .ref-modal-window {
      opacity: 1;
      transform: scale(1) translateY(0);
    }

    /* Backdrop */
    .ref-modal-backdrop {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: rgba(5, 7, 14, 0.88);
      backdrop-filter: blur(6px);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    /* Modal Window */
    .ref-modal-window {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 1200px;
      height: min(85vh, 800px);
      background: var(--bg-card);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-lg);
      box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6), var(--shadow-blue);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      opacity: 0;
      transform: scale(0.96) translateY(16px);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    /* Modal Browser Bar */
    .ref-modal-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 16px;
      background: var(--bg-dark);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }
    .ref-modal-dots {
      display: flex;
      gap: 6px;
      flex-shrink: 0;
    }
    .ref-modal-dots span {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--text-muted);
      opacity: 0.5;
    }
    .ref-modal-dots span:nth-child(1) { background: var(--danger); opacity: 0.8; }
    .ref-modal-dots span:nth-child(2) { background: var(--orange); opacity: 0.8; }
    .ref-modal-dots span:nth-child(3) { background: var(--green); opacity: 0.8; }

    .ref-modal-url-wrap {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 6px;
      background: rgba(255,255,255,0.05);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 5px 10px;
      min-width: 0;
    }
    .ref-modal-url-wrap svg { flex-shrink: 0; color: var(--green); }
    .ref-modal-url {
      font-size: 0.78rem;
      color: var(--text-secondary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .ref-modal-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }
    .ref-modal-open, .ref-modal-close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text-secondary);
      cursor: pointer;
      transition: background var(--transition), color var(--transition), border-color var(--transition);
      text-decoration: none;
    }
    .ref-modal-open:hover { background: var(--accent-glow); color: var(--accent); border-color: var(--accent); }
    .ref-modal-close:hover { background: rgba(239,68,68,0.15); color: var(--danger); border-color: rgba(239,68,68,0.4); }

    /* iFrame */
    .ref-modal-frame-wrap {
      flex: 1;
      overflow: hidden;
      position: relative;
    }
    .ref-modal-iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }

    @media (max-width: 640px) {
      .ref-modal { padding: 8px; }
      .ref-modal-window { height: 90vh; border-radius: var(--radius); }
      .ref-modal-bar { padding: 8px 12px; }
      .ref-modal-dots { display: none; }
    }
  </style>
</BaseLayout>
