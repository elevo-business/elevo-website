---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Referenzen — ELEVO Digital Boutique"
  description="Echte Ergebnisse für echte Kunden. +3× Reservierungen, +62% Buchungen, Platz 1 bei Google. Unsere Referenzprojekte."
  canonical="https://elevo.solutions/referenzen"
>
  <a href="#hero" class="skip-link">Zum Hauptinhalt springen</a>

  <!-- iFrame Modal -->
  <div id="ref-modal" class="ref-modal" role="dialog" aria-modal="true" aria-label="Website-Vorschau">
    <div class="ref-modal-backdrop"></div>
    <div class="ref-modal-window">
      <div class="ref-modal-bar">
        <div class="ref-modal-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="ref-modal-url-wrap">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="ref-modal-url" id="ref-modal-url"></span>
        </div>
        <div class="ref-modal-actions">
          <a class="ref-modal-open" id="ref-modal-open-btn" href="#" target="_blank" rel="noopener" aria-label="In neuem Tab öffnen">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
          <button class="ref-modal-close" id="ref-modal-close" aria-label="Schließen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>
      <div class="ref-modal-frame-wrap">
        <iframe
          id="ref-modal-frame"
          src=""
          title=""
          class="ref-modal-iframe"
          allow="fullscreen"
        ></iframe>
      </div>
    </div>
  </div>

  <Header />

  <Hero
    badge="Referenzen"
    title='<span class="line">Messbare Ergebnisse.</span><span class="line accent">Echte Kunden.</span>'
    subtitle="Keine Versprechen — echte Zahlen aus abgeschlossenen Projekten. Was wir für unsere Kunden erreicht haben."
    ctaText="Projekt besprechen"
    ctaHref="/kontakt"
    secondaryCtaText="Unsere Leistungen"
    secondaryCtaHref="/leistungen"
  />

  <!-- Trusted By -->
  <section id="trusted" aria-label="Unsere Kunden">
    <div class="container">
      <p class="trusted-label">Vertrauen uns bereits</p>
      <div class="trusted-track" role="list" aria-label="Referenzkunden">
        <span class="trusted-item" role="listitem">Greenchild</span>
        <span class="trusted-item" role="listitem">Akropolis Geilenkirchen</span>
        <span class="trusted-item" role="listitem">ZUMA Lounge</span>
        <span class="trusted-item" role="listitem">IT-Vertrieb GmbH</span>
      </div>
    </div>
  </section>

  <!-- Referenzen -->
  <section id="results" class="section" aria-labelledby="results-heading">
    <div class="container">
      <header class="section-header">
        <div class="section-label reveal">Unsere Arbeit</div>
        <h2 id="results-heading" class="reveal reveal-delay-1">Von 0 auf Wachstum.<br>Projekt für Projekt.</h2>
        <p class="reveal reveal-delay-2">Jedes Projekt hat eine Geschichte — hier sind die Zahlen dahinter.</p>
      </header>

      <div class="case-list" role="list">
        <article class="case-item reveal" role="listitem">
          <div class="case-num" aria-hidden="true">01</div>
          <div class="case-body">
            <span class="case-tag">Landwirtschaft &amp; Nachhaltigkeit</span>
            <h3 class="case-name">Greenchild</h3>
            <p class="case-desc">Landwirtschaftsunternehmen mit Fokus auf Nachhaltigkeit. Von 0 auf Launch in 3 Wochen: vollständige Web-Plattform mit integriertem Konfigurator, DE/EN Lokalisierung und digitalen Onboarding-Flows.</p>
            <div class="case-services">Web-Plattform · DE/EN · Konfigurator</div>
          </div>
          <div class="case-side">
            <div class="case-metric">0→1</div>
            <div class="case-quote-block">
              <div class="case-quote-stars" aria-label="5 von 5 Sternen">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <p class="case-quote-text">„Von 0 auf Launch in 3 Wochen — schneller als wir es für möglich gehalten hätten."</p>
              <span class="case-quote-author">— Greenchild, Geschäftsführung</span>
            </div>
            <button class="case-cta ref-modal-trigger" data-url="https://greenchild-preview.elevo.solutions/de/" data-label="Greenchild" data-display-url="greenchild-preview.elevo.solutions" aria-label="Greenchild Website im Modal ansehen">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><circle cx="7" cy="6" r="1" fill="currentColor" stroke="none"/><circle cx="10" cy="6" r="1" fill="currentColor" stroke="none"/></svg>
              Website live ansehen
            </button>
          </div>
        </article>

        <article class="case-item reveal reveal-delay-1" role="listitem">
          <div class="case-num" aria-hidden="true">02</div>
          <div class="case-body">
            <span class="case-tag">Restaurant · Geilenkirchen</span>
            <h3 class="case-name">Akropolis Geilenkirchen</h3>
            <p class="case-desc">Griechisches Restaurant in Geilenkirchen. Nach Website-Relaunch mit lokaler SEO-Strategie: deutlich mehr Tischreservierungen und Top-Platzierung in der lokalen Google-Suche.</p>
            <div class="case-services">Webdesign · Lokale SEO · #1 Google</div>
          </div>
          <div class="case-side">
            <div class="case-metric green">+3×</div>
            <div class="case-quote-block">
              <div class="case-quote-stars" aria-label="5 von 5 Sternen">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <p class="case-quote-text">„Platz 1 bei Google, dreifach mehr Reservierungen — das sind echte Ergebnisse."</p>
              <span class="case-quote-author">— Akropolis Geilenkirchen, Inhaber</span>
            </div>
            <button class="case-cta ref-modal-trigger" data-url="https://akropolis-geilenkirchen.com" data-label="Akropolis Geilenkirchen" data-display-url="akropolis-geilenkirchen.com" aria-label="Akropolis Geilenkirchen Website im Modal ansehen">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><circle cx="7" cy="6" r="1" fill="currentColor" stroke="none"/><circle cx="10" cy="6" r="1" fill="currentColor" stroke="none"/></svg>
              Website live ansehen
            </button>
          </div>
        </article>

        <article class="case-item reveal reveal-delay-2" role="listitem">
          <div class="case-num" aria-hidden="true">03</div>
          <div class="case-body">
            <span class="case-tag">Hospitality &amp; Events</span>
            <h3 class="case-name">ZUMA Lounge</h3>
            <p class="case-desc">62 % mehr Buchungen durch Conversion-optimierte Landingpage, gezielte Google-Ads-Kampagnen und datengetriebene UX-Optimierung über 3 Monate.</p>
            <div class="case-services">Landingpage · Google Ads · CRO</div>
          </div>
          <div class="case-side">
            <div class="case-metric green">+62%</div>
            <div class="case-quote-block">
              <div class="case-quote-stars" aria-label="5 von 5 Sternen">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <p class="case-quote-text">„+62 % Buchungen in 3 Monaten — die Kombination aus Landing Page und Ads hat uns überzeugt."</p>
              <span class="case-quote-author">— ZUMA Lounge, Management</span>
            </div>
          </div>
        </article>

        <article class="case-item reveal reveal-delay-3" role="listitem">
          <div class="case-num" aria-hidden="true">04</div>
          <div class="case-body">
            <span class="case-tag">Prozessdigitalisierung</span>
            <h3 class="case-name">IT-Vertrieb GmbH</h3>
            <p class="case-desc">12 Stunden manuelle Arbeit pro Woche automatisiert. CRM-Integration, automatisierte Angebotserstellung und Pipeline-Tracking — vollständig ohne manuellen Aufwand.</p>
            <div class="case-services">Automatisierung · CRM-Integration · Pipeline-Tracking</div>
          </div>
          <div class="case-side">
            <div class="case-metric">12h</div>
            <div class="case-quote-block">
              <div class="case-quote-stars" aria-label="5 von 5 Sternen">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <p class="case-quote-text">„12 Stunden manuelle Arbeit — wöchentlich. Diese Zeit haben wir jetzt für unser Kerngeschäft."</p>
              <span class="case-quote-author">— IT-Vertrieb GmbH, Vertriebsleitung</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Live Website Viewer -->
  <section id="live-viewer" class="section" aria-labelledby="viewer-heading">
    <div class="container">
      <header class="section-header">
        <div class="section-label reveal">Live-Einblick</div>
        <h2 id="viewer-heading" class="reveal reveal-delay-1">Unsere Projekte.<br>Live erleben.</h2>
        <p class="reveal reveal-delay-2">Wählen Sie eine Referenz und scrollen Sie direkt durch die echte Website — ohne den Browser zu verlassen.</p>
      </header>

      <div class="viewer-tabs reveal" role="tablist" aria-label="Referenz-Websites">
        <button class="viewer-tab active" role="tab" aria-selected="true" aria-controls="viewer-frame" data-url="https://greenchild-preview.elevo.solutions/de/" data-label="Greenchild">
          <span class="viewer-tab-tag">Landwirtschaft</span>
          <span class="viewer-tab-name">Greenchild</span>
        </button>
        <button class="viewer-tab" role="tab" aria-selected="false" aria-controls="viewer-frame" data-url="https://akropolis-geilenkirchen.com" data-label="Akropolis Geilenkirchen">
          <span class="viewer-tab-tag">Restaurant</span>
          <span class="viewer-tab-name">Akropolis Geilenkirchen</span>
        </button>
        <button class="viewer-tab" role="tab" aria-selected="false" aria-controls="viewer-frame" data-url="https://immobilien-preview.elevo.solutions" data-label="Immobilien Müller">
          <span class="viewer-tab-tag">Immobilien · Preview</span>
          <span class="viewer-tab-name">Immobilien Müller</span>
        </button>
      </div>

      <div class="viewer-browser reveal reveal-delay-1">
        <div class="viewer-bar">
          <div class="viewer-dots">
            <span></span><span></span><span></span>
          </div>
          <div class="viewer-url-wrap">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span class="viewer-url-text" id="viewer-url-text">greenchild-preview.elevo.solutions</span>
          </div>
          <a class="viewer-open-btn" id="viewer-open-btn" href="https://greenchild-preview.elevo.solutions/de/" target="_blank" rel="noopener" aria-label="Website in neuem Tab öffnen">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
        <div class="viewer-frame-wrap">
          <iframe
            id="viewer-frame"
            src="https://greenchild-preview.elevo.solutions/de/"
            title="Greenchild Website"
            loading="lazy"
            class="viewer-iframe"
          ></iframe>
        </div>
      </div>
    </div>

    <script>
      const tabs = document.querySelectorAll('.viewer-tab');
      const frame = document.getElementById('viewer-frame') as HTMLIFrameElement;
      const urlText = document.getElementById('viewer-url-text')!;
      const openBtn = document.getElementById('viewer-open-btn') as HTMLAnchorElement;

      const urlLabels: Record<string, string> = {
        'https://greenchild-preview.elevo.solutions/de/': 'greenchild-preview.elevo.solutions',
        'https://akropolis-geilenkirchen.com': 'akropolis-geilenkirchen.com',
        'https://immobilien-preview.elevo.solutions': 'immobilien-preview.elevo.solutions',
      };

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          const url = (tab as HTMLElement).dataset.url!;
          const label = (tab as HTMLElement).dataset.label!;
          frame.src = url;
          frame.title = label;
          urlText.textContent = urlLabels[url] || url;
          openBtn.href = url;
        });
      });
    </script>
  </section>

  <!-- CTA -->
  <section class="section" aria-labelledby="cta-ref-heading" style="background: linear-gradient(180deg, var(--bg-dark) 0%, var(--bg-deep) 100%);">
    <div class="container">
      <div class="section-header">
        <div class="section-label reveal">Ihr Projekt</div>
        <h2 id="cta-ref-heading" class="reveal reveal-delay-1">Das nächste Ergebnis<br>könnte Ihres sein.</h2>
        <p class="reveal reveal-delay-2">Kostenloses Erstgespräch — unverbindlich, konkret und auf den Punkt.</p>
        <div class="hero-ctas reveal reveal-delay-3" style="margin-top: 32px;">
          <a href="/kontakt" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.6a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 5.61 5.61l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Jetzt Gespräch vereinbaren
          </a>
          <a href="/leistungen" class="btn-secondary">
            Unsere Leistungen
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    const modal = document.getElementById('ref-modal') as HTMLElement;
    const frame = document.getElementById('ref-modal-frame') as HTMLIFrameElement;
    const urlDisplay = document.getElementById('ref-modal-url') as HTMLElement;
    const openBtn = document.getElementById('ref-modal-open-btn') as HTMLAnchorElement;
    const closeBtn = document.getElementById('ref-modal-close') as HTMLButtonElement;
    const backdrop = modal?.querySelector('.ref-modal-backdrop') as HTMLElement;

    let lastFocus: HTMLElement | null = null;

    function openModal(url: string, label: string, displayUrl: string) {
      lastFocus = document.activeElement as HTMLElement;
      frame.src = url;
      frame.title = label;
      urlDisplay.textContent = displayUrl;
      openBtn.href = url;
      modal.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => { modal.classList.add('is-open'); });
      closeBtn.focus();
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.addEventListener('transitionend', () => {
        modal.classList.remove('is-visible');
        frame.src = '';
        document.body.style.overflow = '';
        lastFocus?.focus();
      }, { once: true });
    }

    document.querySelectorAll<HTMLElement>('.ref-modal-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.dataset.url!;
        const label = btn.dataset.label!;
        const displayUrl = btn.dataset.displayUrl || url;
        openModal(url, label, displayUrl);
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-visible')) closeModal();
    });
  </script>

  <style>
    /* Modal Trigger Button */
    .ref-modal-trigger {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 16px;
      padding: 10px 18px;
      background: transparent;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      color: var(--accent);
      font-family: var(--font-body);
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: background var(--transition), border-color var(--transition), color var(--transition);
      width: 100%;
      justify-content: center;
    }
    .ref-modal-trigger:hover {
      background: var(--accent-glow);
      border-color: var(--accent);
      color: #fff;
    }

    /* Modal Overlay */
    .ref-modal {
      position: fixed;
      inset: 0;
      z-index: 9000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      pointer-events: none;
    }
    .ref-modal.is-visible {
      display: flex;
      pointer-events: auto;
    }
    .ref-modal.is-open .ref-modal-backdrop {
      opacity: 1;
    }
    .ref-modal.is-open .ref-modal-window {
      opacity: 1;
      transform: scale(1) translateY(0);
    }

    /* Backdrop */
    .ref-modal-backdrop {
      position: absolute;
      inset: 0;
