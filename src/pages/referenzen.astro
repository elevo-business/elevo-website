---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/ev-system.css';
import '../styles/rx-theme.css';

const cases = [
  {
    name: 'Akropolis Geilenkirchen',
    url: 'https://akropolis-geilenkirchen.com',
    description: 'Lokale Marke mit Reichweite, aber zu wenig Buchungen — Conversion-Website mit klarem Reservierungspfad, der aus Besuchern echte Reservierungen macht. Ergebnis: dreifach mehr Reservierungen über die Seite.',
    industry: 'Lokale Marke',
    location: 'Geilenkirchen',
  },
  {
    name: 'Greenchild',
    url: 'https://greenchild-preview.elevo.solutions/de/',
    description: 'In 3 Wochen von null auf live — ein Klienten-Gewinnungs-System, das direkt in Woche 1 fünf warme, qualifizierte Anfragen brachte (vorher null). Aus Besuchern wurden gebuchte Anfragen.',
    industry: 'Klienten-Gewinnungs-System',
  },
  {
    name: 'BrandsMarketingLab',
    url: 'https://elevo-business.github.io/bml/index.html',
    description: 'Conversion-Website für eine Marketing-Agentur — klare Positionierung und eine durchgehende Strecke, die Besucher in gebuchte Anfragen verwandelt. Live unter elevo-business.github.io/bml.',
    industry: 'Marketing-Agentur',
  },
];

const casesSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Referenzen — Elevo',
  url: 'https://elevo.solutions/referenzen',
  description: 'Echte Klienten-Gewinnungs-Systeme mit messbaren Ergebnissen — aus Besuchern werden gebuchte Anfragen.',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: cases.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Article',
        headline: c.name,
        about: { '@type': 'Organization', name: c.name, url: c.url },
        description: c.description,
        publisher: { '@type': 'Organization', name: 'Elevo', url: 'https://elevo.solutions' },
        url: 'https://elevo.solutions/referenzen',
      },
    })),
  },
};
---

<BaseLayout
  title="Ergebnisse — Elevo"
  description="Vom Klick zum Klienten: echte Klienten-Gewinnungs-Systeme, die du live öffnen kannst — fünf warme Anfragen in Woche 1, dreifach mehr Reservierungen, in 14 Tagen live. Wir verwandeln die Besucher, die du schon hast, in gebuchte Anfragen."
  canonical="https://elevo.solutions/referenzen"
  bodyClass="rx"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <!-- iFrame Modal -->
  <div id="ref-modal" class="ref-modal" role="dialog" aria-modal="true" aria-label="Website-Vorschau">
    <div class="ref-modal-backdrop"></div>
    <div class="ref-modal-window">
      <div class="ref-modal-bar">
        <div class="ref-modal-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="ref-modal-url-wrap">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="ref-modal-url" id="ref-modal-url"></span>
        </div>
        <div class="ref-modal-actions">
          <a class="ref-modal-open" id="ref-modal-open-btn" href="#" target="_blank" rel="noopener" aria-label="In neuem Tab öffnen">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
          <button class="ref-modal-close" id="ref-modal-close" aria-label="Schließen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>
      <div class="ref-modal-frame-wrap">
        <iframe
          id="ref-modal-frame"
          src=""
          title=""
          class="ref-modal-iframe"
          allow="fullscreen"
        ></iframe>
      </div>
    </div>
  </div>

  <Header />

  <main id="main">
    <!-- ===== HERO ===== -->
    <section class="ev-page-hero" aria-labelledby="ref-hero-heading">
      <div class="container">
        <p class="ev-eyebrow">Ergebnisse</p>
        <h1 id="ref-hero-heading" class="ev-hero-h1">
          Aus Besuchern werden Klienten.<br>
          <span class="ev-accent">Live nachprüfbar.</span>
        </h1>
        <p class="ev-hero-sub">
          Keine Versprechen, keine gestellten Screenshots — echte Klienten-Gewinnungs-Systeme,
          die aus deinen Besuchern gebuchte Anfragen machen. Öffne sie direkt im Fenster und klick dich rein.
        </p>
        <div class="ev-hero-ctas">
          <a href="/kontakt" class="ev-btn ev-btn-primary">
            Funnel-Check sichern
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/leistungen" class="ev-btn ev-btn-ghost">Unsere Leistungen</a>
        </div>
      </div>
    </section>

    <!-- ===== LIVE-SHOWCASE (iFrames) ===== -->
    <section id="live" class="ev-section ev-section-alt" aria-labelledby="live-heading">
      <div class="container">
        <p class="ev-eyebrow">Echte Systeme</p>
        <h2 id="live-heading" class="ev-h2">Sieh selbst — live, nicht als Bild.</h2>
        <p class="ev-section-sub">Drei Systeme direkt im Fenster. Klick dich rein und öffne die echte Seite.</p>

        <div class="ev-ref-grid">
          <article class="ev-ref-card">
            <div class="ev-ref-frame">
              <div class="ev-ref-bar" aria-hidden="true"><i></i><i></i><i></i><em>akropolis-geilenkirchen.com</em></div>
              <div class="ev-ref-embed">
                <iframe src="https://akropolis-geilenkirchen.com" title="Akropolis Geilenkirchen" loading="lazy" tabindex="-1" referrerpolicy="no-referrer"></iframe>
                <button class="ev-ref-overlay ref-modal-trigger" type="button"
                  data-url="https://akropolis-geilenkirchen.com"
                  data-label="Akropolis Geilenkirchen" data-display-url="akropolis-geilenkirchen.com"
                  aria-label="Akropolis Geilenkirchen live öffnen">
                  <span class="ev-ref-open"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>Live öffnen</span>
                </button>
              </div>
            </div>
            <div class="ev-ref-meta">
              <span class="ev-ref-metric">+3×</span>
              <div class="ev-ref-text">
                <h3>Akropolis Geilenkirchen</h3>
                <p>mehr Reservierungen · Lokale Marke</p>
              </div>
            </div>
          </article>

          <article class="ev-ref-card">
            <div class="ev-ref-frame">
              <div class="ev-ref-bar" aria-hidden="true"><i></i><i></i><i></i><em>greenchild.eu</em></div>
              <div class="ev-ref-embed">
                <iframe src="https://greenchild-preview.elevo.solutions/de/" title="GreenChild" loading="lazy" tabindex="-1" referrerpolicy="no-referrer"></iframe>
                <button class="ev-ref-overlay ref-modal-trigger" type="button"
                  data-url="https://greenchild-preview.elevo.solutions/de/"
                  data-label="GreenChild" data-display-url="greenchild.eu">
                  <span class="ev-ref-open"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>Live öffnen</span>
                </button>
              </div>
            </div>
            <div class="ev-ref-meta">
              <span class="ev-ref-metric">5</span>
              <div class="ev-ref-text">
                <h3>GreenChild</h3>
                <p>warme Anfragen in Woche 1 · Klienten-System</p>
              </div>
            </div>
          </article>

          <article class="ev-ref-card">
            <div class="ev-ref-frame">
              <div class="ev-ref-bar" aria-hidden="true"><i></i><i></i><i></i><em>elevo-business.github.io/bml</em></div>
              <div class="ev-ref-embed">
                <iframe src="https://elevo-business.github.io/bml/index.html" title="BrandsMarketingLab" loading="lazy" tabindex="-1" referrerpolicy="no-referrer"></iframe>
                <button class="ev-ref-overlay ref-modal-trigger" type="button"
                  data-url="https://elevo-business.github.io/bml/index.html"
                  data-label="BrandsMarketingLab" data-display-url="elevo-business.github.io/bml">
                  <span class="ev-ref-open"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>Live öffnen</span>
                </button>
              </div>
            </div>
            <div class="ev-ref-meta">
              <span class="ev-ref-metric">Live</span>
              <div class="ev-ref-text">
                <h3>BrandsMarketingLab</h3>
                <p>Conversion-Website · Marketing-Agentur</p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== DEEP DIVE ===== -->
    <section id="results" class="ev-section" aria-labelledby="results-heading">
      <div class="container">
        <p class="ev-eyebrow">Im Detail</p>
        <h2 id="results-heading" class="ev-h2">Was hinter den Systemen steckt.</h2>
        <p class="ev-section-sub">Jedes System hat eine Geschichte — hier sind Ausgangslage, Umsetzung und Ergebnis.</p>

        <ul class="ref-cards-grid" role="list">

          <!-- Akropolis Geilenkirchen -->
          <li class="ref-card reveal" aria-labelledby="ref-card-ak-heading">
            <div class="ref-card-top">
              <div class="ref-card-logo-wrap">
                <img src="/client-logos/akropolis.jpg" alt="Akropolis Geilenkirchen Logo" class="ref-card-logo" loading="lazy" decoding="async" width="110" height="36">
              </div>
              <span class="case-tag">Lokale Marke · Geilenkirchen</span>
            </div>
            <h3 id="ref-card-ak-heading" class="ref-card-title">Akropolis Geilenkirchen</h3>
            <p class="ref-card-desc">Lokale Marke mit Reichweite, aber zu wenig Buchungen. Nach dem Conversion-Relaunch: dreifach mehr Reservierungen über die Seite.</p>
            <dl class="ref-card-details">
              <div class="ref-detail">
                <dt>Ausgangslage</dt>
                <dd>Reichweite war da, aber die Besucher buchten nicht — kein klarer Pfad zur Reservierung, alles schwer bedienbar auf dem Handy.</dd>
              </div>
              <div class="ref-detail">
                <dt>Was wir gebaut haben</dt>
                <dd>Eine verkaufsstarke Conversion-Website: schnell, mobil-optimiert, mit einem prominenten Reservierungs-Pfad in jeder Section, der aus Besuchern echte Buchungen macht.</dd>
              </div>
              <div class="ref-detail">
                <dt>System</dt>
                <dd>Conversion-Website · Mobile-First · automatische Reservierungsstrecke · Tracking</dd>
              </div>
            </dl>
            <div class="ref-card-metric green">
              <span class="ref-card-metric-val">+3×</span>
              <span class="ref-card-metric-label">mehr Reservierungen nach dem Relaunch</span>
            </div>
            <div class="ref-card-services">Conversion-Website · Mobile-First · Reservierungsstrecke</div>
            <button
              class="ref-card-link ref-modal-trigger"
              data-url="https://akropolis-geilenkirchen.com"
              data-label="Akropolis Geilenkirchen"
              data-display-url="akropolis-geilenkirchen.com"
              aria-label="Akropolis Geilenkirchen Website im Modal ansehen"
