---
import KaLayout from '../../kanzlei-anleitung/layouts/KaLayout.astro';
import ka from '../../config/kanzlei-anleitung.json';
import Logo from '../../kanzlei-anleitung/components/Logo.astro';
import VslFacade from '../../neukundensystem/components/VslFacade.astro';
import GespraechForm from '../../kanzlei-anleitung/components/GespraechForm.astro';
import { telHref } from '../../neukundensystem/lib/text';

const { thankYou } = ka;
const [before, after] = thankYou.headline.split('{{vorname}}');
const phoneHref = telHref(thankYou.phoneInternational || thankYou.phone);
---

<KaLayout title={ka.seo.thankYouTitle} description={thankYou.headlineNoName} consentOnPendingLead>
  <main id="inhalt" class="mx-auto max-w-[720px] px-4">
    <div class="flex justify-center pt-4"><Logo /></div>

    <div class="mt-8 flex justify-center">
      <span class="inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 text-sm font-semibold text-ink">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        {thankYou.badge}
      </span>
    </div>

    <h1 class="mt-4 text-center text-[1.75rem] leading-[1.2] font-extrabold tracking-tight text-balance text-ink sm:text-4xl" data-thanks-headline>
      {thankYou.headlineNoName}
    </h1>
    <template data-thanks-template data-before={before} data-after={after}></template>
    <p class="mt-3 text-center text-pretty">{thankYou.subline}</p>

    <section class="mt-8" aria-label="Video-Anleitung">
      <VslFacade video={thankYou.video} />
    </section>

    <GespraechForm />

    <p class="mt-10 text-center">
      {thankYou.phoneLine}
      {phoneHref ? <a href={phoneHref} class="font-bold whitespace-nowrap text-ink underline underline-offset-2">{thankYou.phone}</a> : thankYou.phone}
    </p>
  </main>
</KaLayout>

<script>
  import { tracking } from '../../config/kanzlei-anleitung.json';
  import { getLeadVorname } from '../../neukundensystem/lib/lead';
  import { trackLeadIfAllowed } from '../../neukundensystem/lib/pixel';
  import { CONSENT_EVENT } from '../../neukundensystem/lib/consent';

  // Vorname aus sessionStorage – als Text gesetzt, nie als HTML
  const headline = document.querySelector<HTMLElement>('[data-thanks-headline]');
  const template = document.querySelector<HTMLElement>('[data-thanks-template]');
  const vorname = getLeadVorname().slice(0, 60);
  if (headline && template && vorname) {
    headline.textContent = `${template.dataset.before ?? ''}${vorname}${template.dataset.after ?? ''}`;
  }

  // Lead nur nach erfolgreichem Versand (≤ 30 Min.) + Einwilligung
  trackLeadIfAllowed(tracking.metaPixelId, 'kanzlei-anleitung');
  window.addEventListener(CONSENT_EVENT, (event) => {
    if ((event as CustomEvent<boolean>).detail === true) trackLeadIfAllowed(tracking.metaPixelId, 'kanzlei-anleitung');
  });
</script>
