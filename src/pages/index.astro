---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
import '../styles/ev-system.css';

// Kontakt-Mailto mit vorbelegtem Betreff (Soft-CTA "Erstgespräch", kein Preisanker).
const MAILTO =
  'mailto:hallo@elevo.solutions?subject=' +
  encodeURIComponent('Kostenloses Erstgespräch — Neukunden für unser Fulfillment-Center');

const pains = [
  'Ihre Auslastung schwankt — mal platzt das Lager, mal stehen Flächen und Personal ungenutzt.',
  'Ein, zwei Großkunden tragen den Umsatz. Springt einer ab, wird es sofort eng.',
  'Kaltakquise frisst Zeit und Nerven — und die Entscheider bei Marken und Händlern sind kaum zu erreichen.',
  'Agenturen liefern Klicks und Reichweite. Was fehlt, sind echte Anfragen von Versendern mit Volumen.',
  'Empfehlungen sind wertvoll — aber nicht planbar. Wachstum lässt sich darauf nicht aufbauen.',
  'Miete, Regale, WMS und Team laufen weiter. Jeder Tag Leerstand geht direkt von Ihrer Marge ab.',
];

// FAQ-Inhalte synchron mit sichtbarem Markup halten (speist zusätzlich JSON-LD).
const faqEntries = [
  { q: 'Was ist ein „qualifizierter" Lead?', a: 'Ein Entscheider mit konkretem Fulfillment-Bedarf, der zu Ihren Kriterien passt — Volumen, Region und Warenart — und einem Gespräch zugestimmt hat. Keine anonymen Klicks, keine kalten Adressen.' },
  { q: 'Muss ich einen langen Vertrag unterschreiben?', a: 'Nein. Sie zahlen pro Lead. Kein Retainer, kein Setup, keine Mindestlaufzeit über Jahre. Sie steuern selbst, wie viele Leads Sie abnehmen möchten.' },
  { q: 'Wie schnell kommen die ersten Termine?', a: 'In der Regel innerhalb der ersten Wochen nach dem Start. Den allerersten qualifizierten Termin bekommen Sie kostenlos — Sie gehen also in keine Vorleistung.' },
  { q: 'Woher kommen die Leads?', a: 'Aus gezielter Ansprache und Qualifizierung von Marken, Onlinehändlern und Versendern, die aktuell einen Fulfillment-Partner suchen oder wechseln wollen — passend zu Ihrer Kapazität.' },
  { q: 'Für wen lohnt sich das?', a: 'Für Fulfillment-Center und 3PL-Dienstleister mit freien Kapazitäten, die planbar wachsen und die Abhängigkeit von wenigen Großkunden reduzieren wollen.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title="Neukundengewinnung für Fulfillment-Center — Elevo"
  description="Planbar neue Versender gewinnen — ohne Kaltakquise. Sie zahlen pro qualifiziertem Lead, der erste Termin ist kostenlos. Über 200 qualifizierte Leads in den letzten 2 Monaten."
  canonical="https://elevo.solutions/"
>
  <a href="#kontakt" class="skip-link">Zum Hauptinhalt springen</a>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <header class="ff-header">
    <div class="container ff-header-inner">
      <Logo size="md" />
      <a href="#kontakt" class="ev-btn ev-btn-primary ff-header-cta">Kostenloses Erstgespräch</a>
    </div>
  </header>

  <main id="main">

    <!-- ===== HERO ===== -->
    <section class="ev-hero ff-hero" aria-labelledby="ff-hero-heading">
      <div class="container">
        <div class="ev-hero-grid">
          <div class="ev-hero-copy">
            <p class="ev-eyebrow">Lead-Generierung für Fulfillment-Center &amp; 3PL</p>
            <h1 id="ff-hero-heading" class="ev-hero-h1">
              Planbar neue Versender gewinnen.<br>
              Sie zahlen erst, <span class="ev-accent">wenn der Lead da ist.</span>
            </h1>
            <p class="ev-hero-sub">
              Volle Regale statt leerer Flächen: Wir bringen Ihnen qualifizierte Anfragen von Marken
              und Onlinehändlern, die einen Fulfillment-Partner suchen — vorqualifiziert nach Ihren
              Kriterien. Keine Kaltakquise, kein Streuverlust, kein langer Vertrag.
            </p>
            <div class="ev-hero-ctas">
              <a href="#kontakt" class="ev-btn ev-btn-primary">
                Kostenloses Erstgespräch sichern
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="#so-gehts" class="ev-btn ev-btn-ghost">So funktioniert&rsquo;s</a>
            </div>
            <p class="ev-hero-trust">Pay-per-Lead · kein Retainer · erster qualifizierter Termin gratis</p>
          </div>

          <aside class="ff-offer" aria-label="Ihr Angebot">
            <p class="ff-offer-badge">Ihr Angebot</p>
            <p class="ff-offer-title">Sie zahlen nur pro qualifiziertem Lead.</p>
            <ul class="ff-offer-list" role="list">
              <li><span class="ff-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Kein Setup, kein Retainer, keine Jahresbindung</li>
              <li><span class="ff-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Nur Entscheider mit echtem Fulfillment-Bedarf — keine anonymen Klicks</li>
              <li><span class="ff-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Ihr erster qualifizierter Termin ist <strong>kostenlos</strong></li>
            </ul>
            <a href="#kontakt" class="ev-btn ev-btn-primary ff-offer-cta">Ersten Termin gratis sichern →</a>
            <p class="ff-offer-note">Wir arbeiten mit einer begrenzten Zahl an Fulfillment-Partnern pro Region — für saubere Qualität statt Masse.</p>
          </aside>
        </div>

        <figure class="ff-herovisual">
          <img src="/fulfillment/hero-warehouse.jpg" alt="Blick in eine Lagerhalle mit vollen Hochregalen — Fulfillment-Center im Betrieb" width="1280" height="900" loading="eager" decoding="async" fetchpriority="high">
        </figure>
      </div>
    </section>

    <!-- ===== PROOF ===== -->
    <section class="ev-section ev-section--tight" aria-label="Ergebnisse">
      <div class="container">
        <div class="ev-statband">
          <div class="ev-stat">
            <span class="ev-stat-num is-accent">200+</span>
            <span class="ev-stat-label">qualifizierte Leads generiert</span>
          </div>
          <div class="ev-stat">
            <span class="ev-stat-num">2</span>
            <span class="ev-stat-label">Monate — nachweisbar, nicht geschätzt</span>
          </div>
          <div class="ev-stat">
            <span class="ev-stat-num">1.</span>
            <span class="ev-stat-label">Termin gratis, dann Pay-per-Lead</span>
          </div>
          <div class="ev-stat">
            <span class="ev-stat-num">0</span>
            <span class="ev-stat-label">Retainer &amp; Setup-Gebühr</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== PROBLEM ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="ff-pain-heading">
      <div class="container">
        <p class="ev-eyebrow">Kennen Sie das?</p>
        <h2 id="ff-pain-heading" class="ev-h2">Ihre Fläche ist da. Die passenden Kunden fehlen.</h2>
        <div class="ff-pains">
          {pains.map((p) => (
            <div class="ff-pain"><span class="ff-x" aria-hidden="true">✕</span>{p}</div>
          ))}
        </div>
        <figure class="ff-photoband">
          <img src="/fulfillment/packing-team.jpg" alt="Zwei Mitarbeiter tragen Pakete durch einen Regalgang im Fulfillment-Center" width="1200" height="800" loading="lazy" decoding="async">
        </figure>
      </div>
    </section>

    <!-- ===== WARUM PLANBARE NEUKUNDEN ===== -->
    <section class="ev-section" aria-labelledby="ff-why-heading">
      <div class="container">
        <div class="ff-why">
          <div class="ff-why-copy">
            <p class="ev-eyebrow">Warum das über Wachstum oder Stillstand entscheidet</p>
            <h2 id="ff-why-heading" class="ev-h2">Ein Fulfillment-Center lebt von Auslastung.</h2>
            <p class="ev-section-sub" style="margin-left:0;">
              Ihre Kosten sind zum großen Teil fix: Die Fläche, die Technik und das Team sind da —
              ob die Regale voll sind oder nicht. Jedes Prozent Leerstand geht direkt von Ihrer Marge ab.
            </p>
            <p class="ev-section-sub" style="margin-left:0;">
              Deshalb ist die entscheidende Frage nicht, <em>ob</em> Sie neue Versender gewinnen — sondern
              ob Sie es <strong>planbar</strong> tun. Eine gefüllte Pipeline ist der Unterschied zwischen
              gesundem Wachstum und der Abhängigkeit von den zwei Kunden, die Sie gerade tragen. Genau
              diese Planbarkeit bauen wir für Sie — mit Anfragen, die zu Ihrer Fläche, Ihrer Region und
              Ihrer Warenart passen.
            </p>
          </div>
          <figure class="ff-band">
            <img src="/fulfillment/warehouse-aisle.jpg" alt="Symmetrischer Regalgang in einem Fulfillment-Lager mit palettierter Ware" width="1600" height="560" loading="lazy" decoding="async">
          </figure>
        </div>
      </div>
    </section>

    <!-- ===== SO GEHT'S (3 Schritte) ===== -->
    <section id="so-gehts" class="ev-section ev-section-alt" aria-labelledby="ff-steps-heading">
      <div class="container">
        <p class="ev-eyebrow">So arbeiten wir</p>
        <h2 id="ff-steps-heading" class="ev-h2">In drei Schritten zu vollen Regalen.</h2>
        <div class="prozess-steps" role="list" style="margin-top:48px;">
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">01</div>
            <h3 class="step-title">Wir bauen Ihre Pipeline</h3>
            <p class="step-desc">Zielgruppe: Marken, Onlinehändler und Versender mit dem Volumen, das zu Ihrer Fläche passt. Ansprache, Qualifizierung und Terminierung übernehmen wir komplett.</p>
          </div>
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">02</div>
            <h3 class="step-title">Sie bekommen qualifizierte Leads</h3>
            <p class="step-desc">Kein „hat mal geklickt", sondern Entscheider mit konkretem Fulfillment-Bedarf — vorqualifiziert nach Ihren Kriterien: Volumen, Region, Warenart, Zeitpunkt.</p>
          </div>
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">03</div>
            <h3 class="step-title">Sie zahlen pro Lead</h3>
            <p class="step-desc">Kein Retainer, kein Setup, keine lange Vertragsbindung. Sie zahlen nur für das, was ankommt. Und der erste qualifizierte Termin geht auf uns.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== ANGEBOT (Risk Reversal) ===== -->
    <section class="ev-section" aria-labelledby="ff-guarantee-heading">
      <div class="container">
        <div class="ev-guarantee">
          <div class="ev-guarantee-ico" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="ev-guarantee-body">
            <p class="ev-eyebrow">Testen Sie uns ohne Risiko</p>
            <h2 id="ff-guarantee-heading" class="ev-h2">Der erste qualifizierte Termin ist kostenlos.</h2>
            <p>
              Sie müssen uns nicht glauben — Sie können es sehen. Ihren ersten qualifizierten Termin mit
              einem passenden Versender bekommen Sie gratis. Überzeugt Sie das Ergebnis, skalieren wir
              gemeinsam: Sie zahlen pro Lead, wir liefern planbar nach. Kein Retainer, keine Jahresbindung,
              kein Risiko auf Ihrer Seite.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== WARUM ELEVO ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="ff-diff-heading">
      <div class="container">
        <p class="ev-eyebrow">Warum Elevo</p>
        <h2 id="ff-diff-heading" class="ev-h2">Fokus statt Gießkanne.</h2>
        <div class="ev-grid-3" style="margin-top:40px;">
          <div class="ff-diff">
            <h3>Spezialisiert auf Fulfillment</h3>
            <p>Wir gewinnen Neukunden für Fulfillment-Center und 3PL — nicht für alle Branchen gleichzeitig. Wir kennen die Entscheider und ihre Sprache.</p>
          </div>
          <div class="ff-diff">
            <h3>Qualität vor Menge</h3>
            <p>Vorqualifizierte Entscheider mit echtem Bedarf statt Karteileichen. Jeder Lead passt zu Ihren Kriterien — sonst zählt er nicht.</p>
          </div>
          <div class="ff-diff">
            <h3>Nachweisbare Ergebnisse</h3>
            <p>Über 200 qualifizierte Leads in den letzten zwei Monaten. Kein Versprechen auf Folien — Zahlen, die wir belegen.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== ANSPRECHPARTNER ===== -->
    <section class="ev-section" aria-labelledby="ff-people-heading">
      <div class="container">
        <p class="ev-eyebrow">Ihre Ansprechpartner</p>
        <h2 id="ff-people-heading" class="ev-h2">Kein anonymes Callcenter. Menschen, die liefern.</h2>
        <p class="ev-section-sub" style="margin-left:0;">Sie haben einen direkten Draht — kein Ticketsystem, keine Warteschleife.</p>

        <div class="ff-people">
          <article class="ff-person">
            <div class="ff-person-photo">
              <picture>
                <source type="image/webp" srcset="/team/mert-800.webp 1x, /team/mert-1600.webp 2x">
                <img src="/team/mert-1200.jpg" alt="Mert Efe Celik, Gründer von Elevo" width="240" height="300" loading="lazy" decoding="async">
              </picture>
            </div>
            <div class="ff-person-info">
              <h3 class="ff-person-name">Mert Efe Celik</h3>
              <span class="ff-person-role">Gründer &amp; Strategie</span>
              <p class="ff-person-bio">Verantwortlich für Strategie und Zielgruppe: Wer sind die richtigen Versender für Ihre Fläche — und wie erreichen wir sie planbar.</p>
            </div>
          </article>

          <article class="ff-person">
            <div class="ff-person-photo">
              <div class="ff-person-placeholder" aria-hidden="true">
                <span class="ff-person-initials">BK</span>
                <span class="ff-person-soon">Bild folgt<br>in Kürze</span>
              </div>
            </div>
            <div class="ff-person-info">
              <h3 class="ff-person-name">Bünyamin Korkmaz</h3>
              <span class="ff-person-role">Gründer &amp; Neukundengewinnung</span>
              <p class="ff-person-bio">Ihr direkter Ansprechpartner — betreut Sie von der ersten Anfrage bis zum qualifizierten Termin, nah dran an den Leads und an Ihren Zielen.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="ff-faq-heading">
      <div class="container">
        <p class="ev-eyebrow">Häufige Fragen</p>
        <h2 id="ff-faq-heading" class="ev-h2" style="margin-bottom:32px;">Kurz beantwortet.</h2>
        <div class="ff-faq">
          {faqEntries.map(({ q, a }) => (
            <details class="ff-faq-item">
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== FINAL CTA / KONTAKT ===== -->
    <section id="kontakt" class="ev-section" aria-labelledby="ff-final-heading">
      <div class="container">
        <div class="ev-final">
          <p class="ev-eyebrow">Kostenlos &amp; unverbindlich</p>
          <h2 id="ff-final-heading" class="ev-h2">Reden wir über Ihre freien Kapazitäten.</h2>
          <p class="ev-final-sub">
            15 Minuten genügen: Wir schauen uns Ihre Fläche und Ihre Wunschkunden an und zeigen Ihnen,
            wie viele passende Versender wir für Sie erreichen können. Ihren ersten qualifizierten Termin
            bekommen Sie kostenlos.
          </p>
          <a href={MAILTO} class="ev-btn ev-btn-primary ev-btn-xl">Kostenloses Erstgespräch sichern</a>
          <p class="ev-final-trust">
            Oder direkt per E-Mail: <a href={MAILTO} class="ff-mail">hallo@elevo.solutions</a> · Pay-per-Lead · erster Termin gratis
          </p>
        </div>
      </div>
    </section>

  </main>

  <footer class="ff-footer" role="contentinfo">
    <div class="container ff-footer-inner">
      <Logo size="sm" />
      <p class="ff-footer-tag">Planbare Neukundengewinnung für Fulfillment-Center &amp; 3PL-Dienstleister.</p>
      <nav class="ff-footer-links" aria-label="Rechtliches">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
        <a href={MAILTO}>Kontakt</a>
      </nav>
      <p class="ff-footer-copy">© {new Date().getFullYear()} Elevo · ELEVO Solutions</p>
    </div>
  </footer>

  <CookieBanner />
</BaseLayout>

<style>
  /* ===== Header ===== */
  .ff-header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(250, 247, 240, 0.85);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .ff-header-inner { display: flex; align-items: center; justify-content: space-between; padding-top: 14px; padding-bottom: 14px; }
  .ff-header-cta { padding: 11px 22px; font-size: 0.92rem; }

  .ff-hero { padding-top: clamp(56px, 8vw, 96px); }

  /* ===== Angebots-Karte (Hero) ===== */
  .ff-offer {
    background: linear-gradient(180deg, rgba(59,130,246,0.10), transparent 60%), var(--bg-card);
    border: 1px solid var(--border-strong); border-radius: var(--radius-lg); padding: 32px 30px; align-self: center;
  }
  .ff-offer-badge {
    display: inline-block; background: rgba(59,130,246,0.14); color: var(--accent);
    font-family: var(--font-heading); font-weight: 700; font-size: 0.72rem; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 5px 12px; border-radius: 100px; margin: 0 0 16px;
  }
  .ff-offer-title { font-family: var(--font-heading); font-weight: 800; color: var(--text-primary); font-size: 1.35rem; line-height: 1.25; margin: 0 0 20px; }
  .ff-offer-list { list-style: none; margin: 0 0 26px; padding: 0; display: grid; gap: 16px; }
  .ff-offer-list li { display: flex; gap: 12px; align-items: flex-start; color: var(--text-secondary); font-size: 1rem; line-height: 1.45; }
  .ff-offer-list strong { color: var(--text-primary); }
  .ff-check { flex-shrink: 0; width: 24px; height: 24px; border-radius: 7px; background: rgba(59,130,246,0.14); color: var(--accent); display: inline-flex; align-items: center; justify-content: center; margin-top: 1px; }
  .ff-check svg { width: 13px; height: 13px; }
  .ff-offer-cta { width: 100%; justify-content: center; }
  .ff-offer-note { font-size: 0.82rem; color: var(--text-muted); margin: 16px 0 0; line-height: 1.45; }

  /* ===== Hero-Visual ===== */
  .ff-herovisual { margin: 48px auto 0; max-width: 1040px; }
  .ff-herovisual img {
    width: 100%; display: block; border-radius: var(--radius-lg);
    aspect-ratio: 16 / 9; object-fit: cover;
    border: 1px solid var(--border); box-shadow: var(--shadow);
  }

  /* ===== Foto-Band (Problem-Sektion) ===== */
  .ff-photoband { margin: 40px 0 0; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); }
  .ff-photoband img { width: 100%; display: block; aspect-ratio: 3 / 1; object-fit: cover; }

  /* ===== Pain-Grid ===== */
  .ff-pains { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 36px; }
  .ff-pain {
    display: flex; align-items: flex-start; gap: 12px;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 22px 22px; color: var(--text-primary);
    font-family: var(--font-heading); font-weight: 600; font-size: 1rem; line-height: 1.45;
  }
  .ff-x { color: var(--danger); font-weight: 800; font-size: 1.2rem; flex-shrink: 0; line-height: 1.35; }

  /* ===== Warum-Block mit Band-Visual ===== */
  .ff-why { display: grid; grid-template-columns: 1fr; gap: 40px; }
  .ff-why-copy .ev-section-sub { margin-top: 16px; text-align: left; }
  .ff-band { margin: 0; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); }
  .ff-band img { width: 100%; height: auto; display: block; }

  /* ===== Differenzierung ===== */
  .ff-diff { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 28px 26px; }
  .ff-diff h3 { font-family: var(--font-heading); font-weight: 700; font-size: 1.15rem; color: var(--text-primary); margin: 0 0 10px; }
  .ff-diff p { color: var(--text-secondary); font-size: 0.96rem; line-height: 1.6; margin: 0; }

  /* ===== Ansprechpartner ===== */
  .ff-people { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 40px; }
  .ff-person {
    display: flex; gap: 22px; align-items: center;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 26px 26px;
  }
  .ff-person-photo { flex-shrink: 0; }
  .ff-person-photo img {
    width: 120px; height: 150px; object-fit: cover; border-radius: var(--radius);
    display: block; border: 1px solid var(--border);
  }
  .ff-person-placeholder {
    width: 120px; height: 150px; border-radius: var(--radius);
    background: rgba(59,130,246,0.06); border: 1px dashed var(--border-strong);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center;
  }
  .ff-person-initials { font-family: var(--font-heading); font-weight: 800; font-size: 1.9rem; color: var(--accent); letter-spacing: 0.02em; }
  .ff-person-soon { font-size: 0.66rem; color: var(--text-muted); line-height: 1.3; letter-spacing: 0.03em; }
  .ff-person-name { font-family: var(--font-heading); font-weight: 700; font-size: 1.2rem; color: var(--text-primary); margin: 0 0 8px; }
  .ff-person-role {
    display: inline-block; background: rgba(59,130,246,0.1); color: var(--accent);
