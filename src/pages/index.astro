  <div class="ev-mcta" id="ev-mcta" aria-hidden="true">
    <a href="mailto:hallo@elevo.solutions" class="ev-mcta-btn ev-mcta-ghost" aria-label="E-Mail schreiben">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
    </a>
    <a href="#kontakt" class="ev-mcta-btn ev-mcta-primary">Funnel-Check sichern</a>
  </div>

  <script>
    // ----- Reveal-on-Scroll -----
    const revealEls = Array.from(document.querySelectorAll('.reveal, .reveal-left, .reveal-right'));
    if (revealEls.length && 'IntersectionObserver' in window) {
      const ro = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            ro.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      revealEls.forEach((el) => ro.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('visible'));
    }

    // ----- Count-up Kennzahlen -----
    const fmtDE = (n: number) => Math.round(n).toLocaleString('de-DE');
    const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
    if (counters.length && 'IntersectionObserver' in window) {
      const co = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = parseFloat(el.dataset.count || '0');
          const suffix = el.dataset.suffix || '';
          const prefix = el.dataset.prefix || '';
          const dur = 1400;
          const start = performance.now();
          const tick = (now: number) => {
            const p = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = prefix + fmtDE(target * eased) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          co.unobserve(el);
        });
      }, { threshold: 0.5 });
      counters.forEach((el) => co.observe(el));
    } else {
      counters.forEach((el) => {
        el.textContent = (el.dataset.prefix || '') + fmtDE(parseFloat(el.dataset.count || '0')) + (el.dataset.suffix || '');
      });
    }

    // ----- Marquee: Track verdoppeln fuer nahtlose Schleife -----
    const mqTrack = document.getElementById('ev-marquee-track');
    if (mqTrack) mqTrack.innerHTML += mqTrack.innerHTML;

    // ----- Sticky Mobile-CTA -----
    const mcta = document.getElementById('ev-mcta');
    const kontakt = document.getElementById('kontakt');
    if (mcta) {
      let kontaktVisible = false;
      if ('IntersectionObserver' in window && kontakt) {
        new IntersectionObserver((es) => { kontaktVisible = es[0].isIntersecting; updateMcta(); }, { threshold: 0.12 }).observe(kontakt);
      }
      const updateMcta = () => {
        const pastHero = window.scrollY > window.innerHeight * 0.6;
        const show = pastHero && !kontaktVisible;
        mcta.classList.toggle('is-visible', show);
        mcta.setAttribute('aria-hidden', show ? 'false' : 'true');
      };
      window.addEventListener('scroll', updateMcta, { passive: true });
      window.addEventListener('resize', updateMcta, { passive: true });
      updateMcta();
    }

    // ----- Live-Vorschau Modal -----
    const modal = document.getElementById('ref-modal') as HTMLElement;
    const frame = document.getElementById('ref-modal-frame') as HTMLIFrameElement;
    const urlDisplay = document.getElementById('ref-modal-url') as HTMLElement;
    const openBtn = document.getElementById('ref-modal-open-btn') as HTMLAnchorElement;
    const closeBtn = document.getElementById('ref-modal-close') as HTMLButtonElement;
    const backdrop = modal?.querySelector('.ref-modal-backdrop') as HTMLElement;

    let lastFocus: HTMLElement | null = null;

    function openModal(url: string, label: string, displayUrl: string) {
      lastFocus = document.activeElement as HTMLElement;
      frame.src = url;
      frame.title = label;
      urlDisplay.textContent = displayUrl;
      openBtn.href = url;
      modal.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => { modal.classList.add('is-open'); });
      closeBtn.focus();
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.addEventListener('transitionend', () => {
        modal.classList.remove('is-visible');
        frame.src = '';
        document.body.style.overflow = '';
        lastFocus?.focus();
      }, { once: true });
    }

    document.querySelectorAll<HTMLElement>('.ref-modal-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.dataset.url!;
        const label = btn.dataset.label!;
        const displayUrl = btn.dataset.displayUrl || url;
        openModal(url, label, displayUrl);
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-visible')) closeModal();
    });

    // ----- Anfragen-Rechner -----
    const visEl = document.getElementById('calc-visitors') as HTMLInputElement;
    const rateEl = document.getElementById('calc-rate') as HTMLInputElement;
    const closeEl = document.getElementById('calc-close') as HTMLInputElement;
    const visOut = document.getElementById('calc-visitors-out')!;
    const rateOut = document.getElementById('calc-rate-out')!;
    const closeOut = document.getElementById('calc-close-out')!;
    const lostOut = document.getElementById('calc-lost')!;
    const extraClientsOut = document.getElementById('calc-extra-clients')!;
    const extraMonthOut = document.getElementById('calc-extra-month')!;

    const de = new Intl.NumberFormat('de-DE');

    function paintRange(el: HTMLInputElement) {
      const pct = ((+el.value - +el.min) / (+el.max - +el.min)) * 100;
      el.style.background =
        `linear-gradient(90deg, var(--accent) 0%, var(--accent) ${pct}%, rgba(255,255,255,0.12) ${pct}%, rgba(255,255,255,0.12) 100%)`;
    }

    // Optimierte Strecke schafft erfahrungsgemaess das 2,5-fache der Anfrage-Rate.
    const UPLIFT_FACTOR = 2.5;

    function updateCalc() {
      const visitors = +visEl.value;
      const rate = +rateEl.value;          // %
      const close = +closeEl.value;         // %
      const extraRate = rate * (UPLIFT_FACTOR - 1); // zusaetzliche Prozentpunkte
      const extraPerMonth = visitors * extraRate / 100;
      const extraPerYear = extraPerMonth * 12;
      const extraClients = extraPerYear * close / 100;

      visOut.textContent = de.format(visitors);
      rateOut.innerHTML = rate.toLocaleString('de-DE') + '&nbsp;%';
      closeOut.innerHTML = close + '&nbsp;%';
      lostOut.textContent = de.format(Math.round(extraPerYear));
      extraClientsOut.textContent = de.format(Math.round(extraClients));
      extraMonthOut.textContent = de.format(Math.round(extraPerMonth));

      [visEl, rateEl, closeEl].forEach(paintRange);
    }

    if (visEl && rateEl && closeEl) {
      [visEl, rateEl, closeEl].forEach(el => el.addEventListener('input', updateCalc));
      updateCalc();
    }
  </script>
</BaseLayout>
