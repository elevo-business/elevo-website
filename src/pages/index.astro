---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';
import '../styles/global.css';
import '../styles/ev-system.css';

// FAQ-Inhalte fuer JSON-LD synchron mit FAQ.astro halten.
// Diese Liste speist nur das Structured-Data-Markup (kein sichtbarer Output).
const faqEntries = [
  { q: 'Für wen ist das 14-Tage-System gedacht?', a: 'Für Coaches, Berater, Trainer und Experten im DACH-Raum, die ein hochpreisiges Angebot verkaufen und schon Aufmerksamkeit haben — Website-Besucher, Follower, laufende Ads — diese aber zu selten in gebuchte Anfragen verwandeln. Wenn du jeden Monat Reichweite produzierst, aber zu wenig daraus Erstgespräche werden, bist du genau richtig.' },
  { q: 'Ich habe noch kaum Website-Besucher — bin ich der richtige Kunde?', a: 'Ehrlich: noch nicht ganz. Wir verwandeln vorhandene Aufmerksamkeit in Anfragen. Wenn deine Seite quasi null Traffic hat, fehlt der Rohstoff, mit dem das System arbeitet. Dann reden wir zuerst über Reichweite. Hast du dagegen schon Besucher, Follower oder laufende Ads, die zu wenig konvertieren, holen wir genau da das Maximum raus.' },
  { q: 'Was genau bekomme ich?', a: 'Ein komplettes Klienten-Gewinnungs-System, done-for-you: eine verkaufsstarke Website mit glasklarer Strecke zum Termin, automatische Terminbuchung direkt aus der Anfrage, automatisches Follow-up (E-Mail/WhatsApp), damit kein Lead versickert, und ein sauberes Tracking, damit du siehst, was wirkt. Copy, Design, Technik und Automatisierung machen wir — du lieferst nur die Infos.' },
  { q: 'Wie schnell sehe ich erste Anfragen?', a: 'In 14 Tagen ist dein System live. Erste Anfragen kommen oft schon in den ersten Tagen nach Launch — bei GreenChild waren es fünf qualifizierte Anfragen in Woche 1, vorher null. Wie schnell es bei dir greift, hängt von deiner Reichweite und deinem Angebot ab. Genau das schauen wir uns vorher im Funnel-Check an.' },
  { q: 'Muss ich technisch fit sein oder selbst etwas bauen?', a: 'Nein. Das ist komplett done-for-you. Du musst nichts installieren, einrichten oder pflegen. Du gibst uns die Infos zu deinem Angebot, wir bauen Website, Copy, Terminbuchung, Follow-up und Tracking — und übergeben dir ein System, das von selbst läuft. Auf Wunsch kümmern wir uns danach weiter darum.' },
  { q: 'Und wenn es nicht funktioniert?', a: 'Dann ist es unser Risiko, nicht deins. In 14 Tagen bist du live. Bekommst du in den 30 Tagen nach Launch keine qualifizierte Anfrage über die Seite, arbeiten wir kostenlos weiter, bis du sie hast. Den Preis halten wir vorher als Festpreis schriftlich fest — keine offenen Stundenzettel, keine Nachforderungen.' },
  { q: 'Was kostet das?', a: 'Der Preis hängt vom Umfang ab und steht als Festpreis fest, bevor wir starten. Wir hängen keine Preisschilder an die Wand, weil jedes System anders ist. Im kostenlosen Funnel-Check schauen wir uns deine Strecke an, zeigen dir, wo Anfragen verloren gehen, und machen dir anschließend ein konkretes Angebot inklusive Liefertermin.' },
  { q: 'Ihr habt bisher auch andere Branchen gemacht — könnt ihr Coaches?', a: 'Ja. Das Prinzip ist immer dasselbe: aus Besuchern werden gebuchte Anfragen. GreenChild ging in drei Wochen von null auf live und brachte in Woche 1 fünf warme Anfragen. Für Coaches und Berater ist die Strecke sogar klarer, weil dein Verkauf über das Erstgespräch läuft — und genau darauf optimieren wir alles.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title="Vom Klick zum Klienten — das 14-Tage-System für Coaches & Berater | Elevo"
  description="Wir verwandeln die Besucher, die du schon hast, in gebuchte Anfragen. Verkaufsstarke Website, automatische Terminbuchung und Follow-up — komplett für dich gebaut, in 14 Tagen live. Mit Garantie."
  canonical="https://elevo.solutions/"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <!-- Live-Vorschau Modal -->
  <div id="ref-modal" class="ref-modal" role="dialog" aria-modal="true" aria-label="Website-Vorschau">
    <div class="ref-modal-backdrop"></div>
    <div class="ref-modal-window">
      <div class="ref-modal-bar">
        <div class="ref-modal-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="ref-modal-url-wrap">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="ref-modal-url" id="ref-modal-url"></span>
        </div>
        <div class="ref-modal-actions">
          <a class="ref-modal-open" id="ref-modal-open-btn" href="#" target="_blank" rel="noopener" aria-label="In neuem Tab öffnen">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
          <button class="ref-modal-close" id="ref-modal-close" aria-label="Schließen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>
      <div class="ref-modal-frame-wrap">
        <iframe id="ref-modal-frame" src="" title="" class="ref-modal-iframe" allow="fullscreen"></iframe>
      </div>
    </div>
  </div>

  <main id="main">

    <!-- ===== HERO ===== -->
    <section id="hero" class="ev-hero" aria-labelledby="hero-heading">
      <div class="container">
        <div class="ev-hero-grid">
          <div class="ev-hero-copy">
            <p class="ev-eyebrow reveal">Klienten-Gewinnung für Coaches &amp; Berater</p>
            <h1 id="hero-heading" class="ev-hero-h1 reveal reveal-delay-1">
              Vom Klick<br>
              <span class="ev-accent">zum Klienten.</span>
            </h1>
            <p class="ev-hero-sub reveal reveal-delay-2">
              Du hast Reichweite — Besucher, Follower, vielleicht laufende Ads. Wir verwandeln sie in
              gebuchte Anfragen. Verkaufsstarke Website, automatische Terminbuchung und Follow-up,
              komplett für dich gebaut. In 14 Tagen live.
            </p>
            <div class="ev-hero-ctas reveal reveal-delay-3">
              <a href="#kontakt" class="ev-btn ev-btn-primary">
                Kostenlosen Funnel-Check sichern
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="#referenzen" class="ev-btn ev-btn-ghost">Ergebnisse ansehen</a>
            </div>
            <p class="ev-hero-trust reveal reveal-delay-4">Done-for-you · in 14 Tagen live · Anfragen-Garantie</p>
          </div>

          <div class="ev-hero-visual reveal reveal-delay-2" aria-hidden="true">
            <div class="ev-hv-browser">
              <div class="ev-hv-bar">
                <span class="ev-hv-dot ev-hv-dot--r"></span>
                <span class="ev-hv-dot ev-hv-dot--y"></span>
                <span class="ev-hv-dot ev-hv-dot--g"></span>
                <span class="ev-hv-url">deine-anfragen.elevo</span>
              </div>
              <div class="ev-hv-screen">
                <div class="ev-hv-row">
                  <span class="ev-hv-kpi"><b>38</b><i>Besucher heute</i></span>
                  <span class="ev-hv-kpi"><b>6</b><i>Anfragen</i></span>
                  <span class="ev-hv-kpi"><b>4</b><i>Termine</i></span>
                </div>
                <div class="ev-hv-chart">
                  <svg viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true">
                    <polyline points="0,52 28,46 56,40 84,32 112,26 140,18 168,12 200,6" fill="none" stroke="currentColor" stroke-width="2.5"/>
                    <polyline points="0,52 28,46 56,40 84,32 112,26 140,18 168,12 200,6 200,60 0,60" fill="currentColor" opacity="0.12" stroke="none"/>
                  </svg>
                </div>
                <div class="ev-hv-list">
                  <span class="ev-hv-li"><i></i><em class="ev-hv-tag ev-hv-tag--new">Neue Anfrage</em></span>
                  <span class="ev-hv-li"><i></i><em class="ev-hv-tag">Termin gebucht</em></span>
                  <span class="ev-hv-li"><i></i><em class="ev-hv-tag ev-hv-tag--won">Klient gewonnen</em></span>
                </div>
              </div>
            </div>
            <div class="ev-hv-badge ev-hv-badge--1">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              Neue Anfrage
            </div>
            <div class="ev-hv-badge ev-hv-badge--2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
              Termin gebucht
            </div>
          </div>
        </div>

        <!-- Animierte Kennzahlen -->
        <div class="ev-statband reveal" role="list" aria-label="Kennzahlen">
          <div class="ev-stat" role="listitem">
            <div class="ev-stat-num"><span data-count="14" data-suffix=" Tage"></span></div>
            <div class="ev-stat-label">bis dein System live ist</div>
          </div>
          <div class="ev-stat" role="listitem">
            <div class="ev-stat-num is-accent"><span data-count="5" data-suffix=" Anfragen"></span></div>
            <div class="ev-stat-label">in Woche 1 — GreenChild</div>
          </div>
          <div class="ev-stat" role="listitem">
            <div class="ev-stat-num"><span data-count="30" data-suffix=" Tage"></span></div>
            <div class="ev-stat-label">Anfragen-Garantie nach Launch</div>
          </div>
          <div class="ev-stat" role="listitem">
            <div class="ev-stat-num"><span data-count="3" data-suffix=" Plätze"></span></div>
            <div class="ev-stat-label">pro Monat — bewusst limitiert</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== TRUST-MARQUEE ===== -->
    <div class="ev-marquee" aria-hidden="true">
      <div class="ev-marquee-track" id="ev-marquee-track">
        <span class="ev-marquee-item">Business-Coaches</span>
        <span class="ev-marquee-item">Karriere-Coaches</span>
        <span class="ev-marquee-item">Berater &amp; Consultants</span>
        <span class="ev-marquee-item">Trainer</span>
        <span class="ev-marquee-item">Online-Kurse</span>
        <span class="ev-marquee-item">Health-Coaches</span>
        <span class="ev-marquee-item">Mentoren</span>
        <span class="ev-marquee-item">Experten mit High-Ticket-Angebot</span>
      </div>
    </div>

    <!-- ===== PROBLEM ===== -->
    <section id="problem" class="ev-section" aria-labelledby="problem-heading">
      <div class="container">
        <p class="ev-eyebrow reveal">Das Problem</p>
        <h2 id="problem-heading" class="ev-h2 reveal reveal-delay-1">Du hast Aufmerksamkeit. Aber zu wenig Anfragen.</h2>
        <p class="ev-section-sub reveal reveal-delay-2">Die meisten Coaches verbrennen ihre Reichweite an drei Stellen — jeder verlorene Besucher ist ein verlorenes Erstgespräch.</p>
        <div class="ev-grid-3">
          <article class="ev-diag-card reveal">
            <div class="ev-diag-icon" aria-hidden="true">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </div>
            <h3>Besucher springen wieder ab</h3>
            <p>Deine Seite sieht aus wie ein Baukasten und führt nirgendwo hin. Kein klarer Pfad zum Termin — also klickt man weg.</p>
          </article>
          <article class="ev-diag-card reveal reveal-delay-1">
            <div class="ev-diag-icon" aria-hidden="true">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M12 22v-4M5 12H2M22 12h-3"/><circle cx="12" cy="12" r="4"/><path d="m4.9 4.9 2.1 2.1M17 17l2.1 2.1"/></svg>
            </div>
            <h3>Anfragen versickern</h3>
            <p>Du bist im Coaching, antwortest zu spät, das Nachfassen vergisst sich. Der Interessent hat sich längst woanders gebucht.</p>
          </article>
          <article class="ev-diag-card reveal reveal-delay-2">
            <div class="ev-diag-icon" aria-hidden="true">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3>Termin-Pingpong per Mail</h3>
            <p>„Wann passt es dir?“ — fünf Mails hin und her. Reibung, die Interessenten kostet, statt direkt einen Termin zu buchen.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== MECHANISMUS: VOM KLICK ZUM KLIENTEN ===== -->
    <section id="mechanismus" class="ev-section ev-section-alt" aria-labelledby="mechanismus-heading">
      <div class="container">
        <p class="ev-eyebrow reveal">Der Mechanismus</p>
        <h2 id="mechanismus-heading" class="ev-h2 reveal reveal-delay-1">Vom Klick zum Klienten — automatisch.</h2>
        <div class="ev-system-lead reveal reveal-delay-2">
          <p>Wir sind keine Webdesigner. Wir bauen <strong>Klienten-Gewinnungs-Systeme</strong>: aus den Besuchern, die du schon hast, werden gebuchte Anfragen — ohne dass du mehr Werbung schalten oder selbst nachfassen musst.</p>
        </div>

        <div class="ev-flow-wrap reveal">
          <p class="ev-flow-caption">So wird aus einem Besucher ein gebuchtes Erstgespräch — ohne dass du etwas anfasst:</p>
          <div class="ev-flow" role="img" aria-label="Ablauf: Besucher kommt auf die Seite, folgt einer klaren Strecke, bucht direkt einen Termin, Follow-up läuft automatisch.">
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </span>
              <span class="ev-flow-label">Besucher landet auf deiner Seite</span>
            </div>
            <div class="ev-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </div>
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg>
              </span>
              <span class="ev-flow-label">Klare Strecke führt zum Angebot</span>
            </div>
            <div class="ev-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </div>
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
              </span>
              <span class="ev-flow-label">Termin direkt gebucht</span>
            </div>
            <div class="ev-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </div>
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>
              </span>
              <span class="ev-flow-label">Follow-up läuft, während du coachst</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== DAS SYSTEM (4 BAUSTEINE) ===== -->
    <section id="system" class="ev-section" aria-labelledby="system-heading">
      <div class="container">
        <p class="ev-eyebrow reveal">Das System</p>
        <h2 id="system-heading" class="ev-h2 reveal reveal-delay-1">Alles, was aus einem Klick einen Klienten macht.</h2>
        <p class="ev-section-sub reveal reveal-delay-2">Vier Bausteine, die ineinandergreifen. Komplett für dich gebaut — du lieferst nur die Infos zu deinem Angebot.</p>

        <div class="ev-stack">
          <article class="ev-stack-card reveal">
            <div class="ev-stack-head">
              <span class="ev-stack-no">01</span>
              <span class="ev-stack-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></span>
            </div>
            <h3>Verkaufsstarke Website</h3>
            <p>Kein Baukasten. Eine individuell gebaute Seite mit glasklarer Strecke zum Termin — gebaut, um aus Besuchern Anfragen zu machen, nicht nur, um schön auszusehen.</p>
            <ul class="ev-stack-feats">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Conversion-Copy, die dein Angebot verkauft</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Ein klarer Pfad: vom Scroll zum Termin-CTA</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Blitzschnell auf Handy und Desktop</li>
            </ul>
          </article>

          <article class="ev-stack-card reveal reveal-delay-1">
            <div class="ev-stack-head">
              <span class="ev-stack-no">02</span>
              <span class="ev-stack-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg></span>
            </div>
            <h3>Automatische Terminbuchung</h3>
            <p>Interessenten buchen direkt aus der Anfrage einen Termin in deinem Kalender. Kein Mail-Pingpong, keine Reibung — und kein verlorener Lead, weil du gerade im Coaching warst.</p>
            <ul class="ev-stack-feats">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Online-Buchung direkt aus der Seite</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Synchron mit deinem Kalender</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Automatische Bestätigung &amp; Erinnerung</li>
            </ul>
          </article>

          <article class="ev-stack-card reveal reveal-delay-2">
            <div class="ev-stack-head">
              <span class="ev-stack-no">03</span>
              <span class="ev-stack-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
            </div>
            <h3>Follow-up-Automatisierung</h3>
            <p>Nicht jeder bucht sofort. Automatische Nachfass-Sequenzen per E-Mail und WhatsApp holen Interessenten zurück — höflich, hartnäckig und vollautomatisch, während du lieferst.</p>
            <ul class="ev-stack-feats">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Jede Anfrage landet sauber an einem Ort</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Automatische Nurture-Sequenz</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Kein Lead geht mehr verloren</li>
            </ul>
          </article>

          <article class="ev-stack-card reveal reveal-delay-3">
            <div class="ev-stack-head">
              <span class="ev-stack-no">04</span>
              <span class="ev-stack-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg></span>
            </div>
