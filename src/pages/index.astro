              <line x1="38" y1="6" x2="38" y2="14"/>
              <rect x="11" y="30" width="8" height="12" rx="2" fill="currentColor" stroke="none"/>
              <rect x="24" y="26" width="8" height="16" rx="2" fill="currentColor" stroke="none"/>
              <rect x="37" y="22" width="8" height="20" rx="2" fill="currentColor" stroke="none"/>
