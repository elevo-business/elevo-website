---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';
import '../styles/global.css';
import '../styles/ev-system.css';
import '../styles/rx-theme.css';

// FAQ-Inhalte fuer JSON-LD synchron mit FAQ.astro halten.
// Diese Liste speist nur das Structured-Data-Markup (kein sichtbarer Output).
const faqEntries = [
  { q: 'Für wen ist Elevo gedacht?', a: 'Für aufstrebende Unternehmen im DACH-Raum mit einem guten Angebot, die wachsen wollen — und merken, dass ihr Auftritt da noch nicht mithält. Du hast Substanz, aber online wirkt es austauschbar, Anfragen kommen eher zufällig als planbar. Genau da setzen wir an: hochwertiger Auftritt, klare Positionierung, planbare Anfragen.' },
  { q: 'Müssen wir gleich alle drei Stufen buchen?', a: 'Nein. Wachstum passiert in Stufen, nicht alles auf einmal. Wir starten dort, wo dein größter Hebel liegt — meist beim Fundament, einer hochwertigen Website. Darauf bauen Autorität (Premium-Printmedien) und Skalierung (Ad-Funnel) auf. Du gehst die nächste Stufe erst, wenn die vorherige trägt. Wo du gerade stehst, klären wir im Wachstumsgespräch.' },
  { q: 'Was genau bekomme ich?', a: 'Je nach Stufe: eine hochwertige Website mit SEO, Conversion-Aufbau und verkaufsstarken Werbetexten (Fundament), Premium-Printmedien wie ein Kundenmagazin, das in Erinnerung bleibt (Autorität), und einen Ad-Funnel, der planbar qualifizierte Anfragen bringt (Skalierung). Strategie, Copy, Design, Technik und Werbung machen wir — du lieferst nur die Infos.' },
  { q: 'Wie schnell sehe ich Ergebnisse?', a: 'Wir arbeiten done-for-you mit festem Liefertermin — kein Monatelang-Warten. Wie schnell Anfragen kommen, hängt von der Stufe ab: Beim Ad-Funnel von GreenChild waren es 25 qualifizierte Leads im ersten Monat. Was bei dir realistisch ist, sagen wir dir ehrlich vorab im Wachstumsgespräch.' },
  { q: 'Müssen wir technisch fit sein oder selbst etwas bauen?', a: 'Nein. Das ist komplett done-for-you. Du musst nichts installieren, gestalten oder texten. Du gibst uns die Infos zu deinem Unternehmen, wir liefern Website, Werbetexte, Printmedien und Funnel — fertig aufgesetzt. Auf Wunsch betreuen und optimieren wir danach weiter, damit dein Wachstum nicht stehenbleibt.' },
  { q: 'Und wenn es nicht funktioniert?', a: 'Dann ist es unser Risiko, nicht deins. Der Preis steht vorher als Festpreis schriftlich fest, der Liefertermin ebenso — keine offenen Stundenzettel, keine Nachforderungen. Liefert eine Stufe nicht, was wir vorher zugesagt haben, arbeiten wir nach, bis es sitzt.' },
  { q: 'Was kostet das?', a: 'Der Preis hängt von der Stufe und vom Umfang ab und steht als Festpreis fest, bevor wir starten. Wir hängen keine Preisschilder an die Wand, weil jedes Unternehmen anders wächst. Im kostenlosen Wachstumsgespräch schauen wir uns deine Ausgangslage an und machen dir anschließend ein konkretes Angebot inklusive Liefertermin.' },
  { q: 'Ihr habt verschiedene Branchen gemacht — passt das zu uns?', a: 'Ja. Das Prinzip bleibt gleich, egal ob Edelholz, Bürotechnik oder Gastronomie: sichtbar werden, hochwertig wirken, planbar Anfragen gewinnen. GreenChild (Website, Magazin, Ad-Funnel mit 25 qualifizierten Leads im 1. Monat), HEKO Voice (Premium-Magazin) und Akropolis (rund 3× mehr Reservierungen) sind drei sehr unterschiedliche Beispiele für denselben Mechanismus.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title="Dein digitaler Wachstumspartner für aufstrebende Unternehmen | Elevo"
  description="Sichtbar wachsen, planbar Anfragen: hochwertige Website mit SEO & Conversion, Premium-Printmedien und Ad-Funnel, die konvertieren. Komplett done-for-you — Fundament, Autorität, Skalierung. Mit Garantie."
  canonical="https://elevo.solutions/"
  bodyClass="rx"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <!-- Live-Vorschau Modal -->
  <div id="ref-modal" class="ref-modal" role="dialog" aria-modal="true" aria-label="Website-Vorschau">
    <div class="ref-modal-backdrop"></div>
    <div class="ref-modal-window">
      <div class="ref-modal-bar">
        <div class="ref-modal-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="ref-modal-url-wrap">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="ref-modal-url" id="ref-modal-url"></span>
        </div>
        <div class="ref-modal-actions">
          <a class="ref-modal-open" id="ref-modal-open-btn" href="#" target="_blank" rel="noopener" aria-label="In neuem Tab öffnen">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
          <button class="ref-modal-close" id="ref-modal-close" aria-label="Schließen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>
      <div class="ref-modal-frame-wrap">
        <iframe id="ref-modal-frame" src="" title="" class="ref-modal-iframe" allow="fullscreen"></iframe>
      </div>
    </div>
  </div>

  <main id="main">

    <!-- ===== HERO ===== -->
    <section id="hero" class="ev-hero" aria-labelledby="hero-heading">
      <div class="container">
        <div class="ev-hero-grid">
          <div class="ev-hero-copy">
            <p class="ev-eyebrow reveal">Dein digitaler Wachstumspartner</p>
            <h1 id="hero-heading" class="ev-hero-h1 reveal reveal-delay-1">
              Sichtbar wachsen.<br>
              <span class="ev-accent">Planbar Anfragen.</span>
            </h1>
            <p class="ev-hero-sub reveal reveal-delay-2">
              Du hast ein gutes Angebot — aber online wirkt es austauschbar und Anfragen kommen
              zufällig. Wir machen aufstrebende Unternehmen sichtbar: hochwertige Website, Premium-Printmedien
              und Ad-Funnel, die konvertieren. Komplett für dich gebaut.
            </p>
            <div class="ev-hero-ctas reveal reveal-delay-3">
              <a href="#kontakt" class="ev-btn ev-btn-primary">
                Kostenloses Wachstumsgespräch sichern
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="#referenzen" class="ev-btn ev-btn-ghost">Ergebnisse ansehen</a>
            </div>
            <p class="ev-hero-trust reveal reveal-delay-4">Done-for-you · Festpreis vorab · Wachstums-Garantie</p>
          </div>

          <div class="ev-hero-visual reveal reveal-delay-2" aria-hidden="true">
            <div class="ev-hv-browser">
              <div class="ev-hv-bar">
                <span class="ev-hv-dot ev-hv-dot--r"></span>
                <span class="ev-hv-dot ev-hv-dot--y"></span>
                <span class="ev-hv-dot ev-hv-dot--g"></span>
                <span class="ev-hv-url">dein-wachstum.elevo</span>
              </div>
              <div class="ev-hv-screen">
                <div class="ev-hv-row">
                  <span class="ev-hv-kpi"><b>38</b><i>Besucher heute</i></span>
                  <span class="ev-hv-kpi"><b>6</b><i>Anfragen</i></span>
                  <span class="ev-hv-kpi"><b>4</b><i>Termine</i></span>
                </div>
                <div class="ev-hv-chart">
                  <svg viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true">
                    <polyline points="0,52 28,46 56,40 84,32 112,26 140,18 168,12 200,6" fill="none" stroke="currentColor" stroke-width="2.5"/>
                    <polyline points="0,52 28,46 56,40 84,32 112,26 140,18 168,12 200,6 200,60 0,60" fill="currentColor" opacity="0.12" stroke="none"/>
                  </svg>
                </div>
                <div class="ev-hv-list">
                  <span class="ev-hv-li"><i></i><em class="ev-hv-tag ev-hv-tag--new">Neue Anfrage</em></span>
                  <span class="ev-hv-li"><i></i><em class="ev-hv-tag">Termin gebucht</em></span>
                  <span class="ev-hv-li"><i></i><em class="ev-hv-tag ev-hv-tag--won">Kunde gewonnen</em></span>
                </div>
              </div>
            </div>
            <div class="ev-hv-badge ev-hv-badge--1">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              Neue Anfrage
            </div>
            <div class="ev-hv-badge ev-hv-badge--2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
              Termin gebucht
            </div>
          </div>
        </div>

        <!-- Animierte Kennzahlen -->
        <div class="ev-statband reveal" role="list" aria-label="Kennzahlen">
          <div class="ev-stat" role="listitem">
            <div class="ev-stat-num is-accent"><span data-count="25" data-suffix=" Leads"></span></div>
            <div class="ev-stat-label">qualifiziert · GreenChild, 1. Monat</div>
          </div>
          <div class="ev-stat" role="listitem">
            <div class="ev-stat-num"><span data-count="3" data-suffix=" Live-Sites"></span></div>
            <div class="ev-stat-label">Referenzen zum Anfassen</div>
          </div>
          <div class="ev-stat" role="listitem">
            <div class="ev-stat-num"><span data-count="3" data-suffix=" Stufen"></span></div>
            <div class="ev-stat-label">Fundament · Autorität · Skalierung</div>
          </div>
          <div class="ev-stat" role="listitem">
            <div class="ev-stat-num"><span data-count="3" data-suffix=" Plätze"></span></div>
            <div class="ev-stat-label">pro Monat — bewusst limitiert</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== TRUST-MARQUEE ===== -->
    <div class="ev-marquee" aria-hidden="true">
      <div class="ev-marquee-track" id="ev-marquee-track">
        <span class="ev-marquee-item">Dienstleister</span>
        <span class="ev-marquee-item">Hersteller &amp; Manufakturen</span>
        <span class="ev-marquee-item">Lokale Marken</span>
        <span class="ev-marquee-item">Gastronomie</span>
        <span class="ev-marquee-item">Beratung &amp; Kanzleien</span>
        <span class="ev-marquee-item">Handwerk mit Anspruch</span>
        <span class="ev-marquee-item">Immobilien</span>
        <span class="ev-marquee-item">Aufstrebende Unternehmen</span>
      </div>
    </div>

    <!-- ===== PROBLEM ===== -->
    <section id="problem" class="ev-section" aria-labelledby="problem-heading">
      <div class="container">
        <p class="ev-eyebrow reveal">Das Problem</p>
        <h2 id="problem-heading" class="ev-h2 reveal reveal-delay-1">Gutes Angebot. Trotzdem zu wenig Anfragen.</h2>
        <p class="ev-section-sub reveal reveal-delay-2">Die meisten aufstrebenden Unternehmen bremsen ihr Wachstum an drei Stellen — und merken nicht, wie viel dadurch liegen bleibt.</p>
        <div class="ev-grid-3">
          <article class="ev-diag-card reveal">
            <div class="ev-diag-icon" aria-hidden="true">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </div>
            <h3>Der Auftritt wirkt austauschbar</h3>
            <p>Deine Website sieht aus wie aus dem Baukasten — und untergräbt genau das Premium-Angebot, das du eigentlich hast. Besucher klicken weg, statt anzufragen.</p>
          </article>
          <article class="ev-diag-card reveal reveal-delay-1">
            <div class="ev-diag-icon" aria-hidden="true">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M12 22v-4M5 12H2M22 12h-3"/><circle cx="12" cy="12" r="4"/><path d="m4.9 4.9 2.1 2.1M17 17l2.1 2.1"/></svg>
            </div>
            <h3>Anfragen kommen zufällig</h3>
            <p>Mal ist viel los, mal Funkstille. Empfehlungen halten dich am Leben, aber planbar ist anders — und Wachstum lässt sich so nicht steuern.</p>
          </article>
          <article class="ev-diag-card reveal reveal-delay-2">
            <div class="ev-diag-icon" aria-hidden="true">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3>Niemand baut Vertrauen auf</h3>
            <p>Wer dich nicht kennt, vergleicht nur über den Preis. Es fehlt der hochwertige Eindruck, der dich vom Wettbewerb abhebt und Vertrauen schafft, bevor das erste Gespräch läuft.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== MECHANISMUS: WACHSTUM IN STUFEN ===== -->
    <section id="mechanismus" class="ev-section ev-section-alt" aria-labelledby="mechanismus-heading">
      <div class="container">
        <p class="ev-eyebrow reveal">Der Mechanismus</p>
        <h2 id="mechanismus-heading" class="ev-h2 reveal reveal-delay-1">Wachstum in Stufen — nicht alles auf einmal.</h2>
        <div class="ev-system-lead reveal reveal-delay-2">
          <p>Wir sind keine Webdesigner. Wir sind dein <strong>digitaler Wachstumspartner</strong>: Wir bauen erst das Fundament, dann die Autorität, dann die Skalierung — jede Stufe baut auf der vorherigen auf, damit dein Wachstum stabil bleibt statt zu verpuffen.</p>
        </div>

        <div class="ev-flow-wrap reveal">
          <p class="ev-flow-caption">So wächst dein Unternehmen — Stufe für Stufe, mit uns als Partner:</p>
          <div class="ev-flow" role="img" aria-label="Wachstums-Treppe: Fundament (hochwertige Website), Autorität (Premium-Printmedien), Skalierung (Ad-Funnel), Ergebnis (planbares Wachstum).">
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </span>
              <span class="ev-flow-label">Fundament: hochwertige Website</span>
            </div>
            <div class="ev-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </div>
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              </span>
              <span class="ev-flow-label">Autorität: Premium-Printmedien</span>
            </div>
            <div class="ev-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </div>
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
              </span>
              <span class="ev-flow-label">Skalierung: Ad-Funnel, der konvertiert</span>
            </div>
            <div class="ev-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </div>
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              </span>
              <span class="ev-flow-label">Ergebnis: planbar mehr Anfragen</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== DAS SYSTEM (4 BAUSTEINE) ===== -->
    <section id="system" class="ev-section" aria-labelledby="system-heading">
      <div class="container">
        <p class="ev-eyebrow reveal">So wachsen wir — in 3 Stufen</p>
        <h2 id="system-heading" class="ev-h2 reveal reveal-delay-1">Erst sichtbar. Dann vertraut. Dann skaliert.</h2>
        <p class="ev-section-sub reveal reveal-delay-2">Drei Stufen, die aufeinander aufbauen. Wir steigen dort ein, wo dein größter Hebel liegt — und gehen mit dir die nächste Stufe, wenn die vorherige trägt.</p>

        <div class="ev-stack">
          <article class="ev-stack-card reveal">
            <div class="ev-stack-head">
              <span class="ev-stack-no">01</span>
              <span class="ev-stack-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></span>
            </div>
            <h3>Fundament — Hochwertige Website</h3>
            <p>Kein Baukasten. Eine individuell gebaute Website, die dein Angebot so hochwertig zeigt, wie es ist — gefunden bei Google, klar aufgebaut, mit Werbetexten, die verkaufen. Aus Besuchern werden Anfragen.</p>
            <ul class="ev-stack-feats">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>SEO, damit dich die richtigen Leute finden</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Verkaufsstarke Werbetexte &amp; klare Strecke zur Anfrage</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Premium-Design, blitzschnell auf Handy &amp; Desktop</li>
            </ul>
          </article>

          <article class="ev-stack-card reveal reveal-delay-1">
            <div class="ev-stack-head">
              <span class="ev-stack-no">02</span>
              <span class="ev-stack-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
            </div>
            <h3>Autorität — Premium-Printmedien</h3>
            <p>Etwas, das in der Hand bleibt. Hochwertige Magazine und Printmedien, die dich vom Anbieter zur Marke machen — ein Eindruck, den kein Wettbewerber so schnell kopiert. Für GreenChild und HEKO Voice haben wir genau das gebaut.</p>
            <ul class="ev-stack-feats">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Kundenmagazine, die Vertrauen aufbauen</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Hochwertige Direktmailings statt Wegwerf-Flyer</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Redaktion, Design &amp; Druckvorlage — komplett von uns</li>
            </ul>
          </article>

          <article class="ev-stack-card reveal reveal-delay-2">
            <div class="ev-stack-head">
              <span class="ev-stack-no">03</span>
              <span class="ev-stack-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg></span>
            </div>
            <h3>Skalierung — Ad-Funnel, der konvertiert</h3>
            <p>Wenn das Fundament steht, drehen wir auf. Werbe-Funnel auf Meta &amp; Google, die planbar qualifizierte Anfragen liefern — sauber getrackt, laufend optimiert. Bei GreenChild waren es 25 qualifizierte Leads im ersten Monat.</p>
            <ul class="ev-stack-feats">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Anzeigen &amp; Funnel, die zum Angebot passen</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Planbar qualifizierte Anfragen statt Zufall</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>Sauberes Tracking — Entscheidungen auf Zahlen</li>
            </ul>
          </article>
        </div>

