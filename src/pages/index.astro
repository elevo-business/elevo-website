---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';
import '../styles/global.css';
import '../styles/ev-system.css';
import '../styles/elevo-mag.css';

const faqEntries = [
  { q: 'Was kostet eine professionelle Website?', a: 'Sie kostet so viel, wie das Ergebnis wert ist, das sie liefern soll. Der Preis hängt an Strategie, Umfang und Handwerk — nicht an einer Schablone. Eine Visitenkarten-Seite ist günstig; eine, die planbar Anfragen bringt, ist eine Investition mit Rendite. Den Festpreis nennen wir vorab im Wachstumsgespräch.' },
  { q: 'Wie bekomme ich mehr Anfragen über meine Website?', a: 'Selten über mehr Besucher — meist über eine Seite, die verkauft. Drei Dinge entscheiden: in fünf Sekunden klar, was du tust; sichtbarer Beweis, dass du es kannst; und genau ein leichter nächster Schritt. Werbung lohnt erst, wenn die Seite Besucher zuverlässig in Anfragen verwandelt.' },
  { q: 'Lohnt sich ein gedrucktes Kundenmagazin überhaupt noch?', a: 'Gerade weil fast alle nur noch digital werben, wirkt hochwertiger Print stärker denn je. Eine E-Mail ist in Sekunden gelöscht, ein gutes Magazin liegt wochenlang auf dem Schreibtisch und baut Vertrauen auf, bevor das erste Gespräch beginnt. Für GreenChild und HEKO Voice haben wir genau das gebaut.' },
  { q: 'Sollte ich zuerst in eine Website oder in Werbung investieren?', a: 'Zuerst in die Seite. Werbung verstärkt nur, was schon da ist — steht da eine Visitenkarte, verstärkt sie deinen Misserfolg, bloß teurer. Erst wenn die Seite aus Besuchern Anfragen macht, wird bezahlte Reichweite zum Hebel statt zum Fass ohne Boden.' },
  { q: 'Müssen wir gleich alles auf einmal machen?', a: 'Nein. Website, Printmedien und Werbung sind drei Handwerke, kein Pflicht-Paket. Wir starten dort, wo bei dir der größte Hebel liegt, und erweitern erst, wenn es sich lohnt. Was das bei dir ist, sagen wir dir ehrlich vorab — ohne dir etwas aufzuschwatzen.' },
  { q: 'Und wenn es nicht funktioniert?', a: 'Dann ist es unser Risiko, nicht deins. Der Preis steht vorher als Festpreis fest, der Liefertermin ebenso. Liefert eine Arbeit nicht, was wir zugesagt haben, arbeiten wir nach — bis es sitzt. Keine Nachforderung, kein Kleingedrucktes.' },
  { q: 'Für wen arbeitet Elevo — und für wen nicht?', a: 'Für aufstrebende Unternehmen im DACH-Raum mit einem guten Angebot, das online noch nicht so wirkt, wie es ist. Weniger passend sind wir, wenn nur die billigste Umsetzung ohne Ergebnis-Anspruch gesucht wird — dann gibt es schnellere Baukästen.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqEntries.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };

const proof = [
  { metric: '25', name: 'GreenChild', note: 'Qualifizierte Anfragen im ersten Monat — Website, Magazin und Werbung griffen ineinander.', url: 'https://greenchild-preview.elevo.solutions/de/' },
  { metric: '3×', name: 'Akropolis', note: 'Mehr Reservierungen. Gleiche Küche, gleiche Stadt — eine Seite, die endlich ihren Job machte.', url: 'https://akropolis-geilenkirchen.com' },
  { metric: 'Live', name: 'BrandsMarketingLab', note: 'Eine Conversion-Website für eine Agentur, die selbst Marken baut. Die Messlatte lag hoch.', url: 'https://elevo-business.github.io/bml/index.html' },
];
---

<BaseLayout
  title="Elevo — Dein digitaler Wachstumspartner für planbares Wachstum"
  description="Elevo ist dein digitaler Wachstumspartner: hochwertige Website, Premium-Printmedien und Werbung, die zusammen planbar Anfragen und Kunden bringen. Für aufstrebende Unternehmen im DACH-Raum, die wachsen wollen — nicht nur online existieren."
  canonical="https://elevo.solutions/"
  bodyClass="mag"
  preloadSerif={true}
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>
  <Header />

  <main id="main">
    <!-- ============ MASTHEAD + HERO ============ -->
    <section id="hero" class="mag-hero" aria-labelledby="hero-h">
      <div class="mag-wrap">
        <div class="mag-masthead">
          <div class="mag-masthead-row">
            <span class="c">Elevo</span>
            <span class="hide-sm">Digitaler Wachstumspartner</span>
            <span>Geilenkirchen · DACH</span>
          </div>
        </div>
        <div style="padding-top:clamp(40px,7vh,90px);">
          <h1 id="hero-h" class="reveal">Andere bauen Websites.<br>Wir bauen dein <span class="ser">Wachstum</span>.</h1>
        </div>
        <div class="mag-hero-foot">
          <div class="reveal">
            <p class="mag-hero-dek">Elevo ist dein <b>digitaler Wachstumspartner</b>. Website, Print und Werbung greifen bei uns ineinander und bringen planbar Anfragen — denn du verlierst keine Kunden an bessere Anbieter, nur an sichtbarere.</p>
            <div class="mag-hero-ctas">
              <a href="#kontakt" class="mag-btn">Kostenloses Wachstumsgespräch
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
              <a href="#machen" class="mag-textlink">Was wir machen</a>
            </div>
          </div>
          <div class="mag-hero-aside reveal">
            <span class="big">Zuletzt gebaut</span>
            GreenChild — 25 qualifizierte Anfragen im 1. Monat.<br>
            Akropolis — rund 3× mehr Reservierungen.<br>
            HEKO Voice — ein Magazin, das niemand wegwirft.
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROBLEM ============ -->
    <section id="problem" class="mag-section" aria-labelledby="problem-h">
      <div class="mag-wrap">
        <div class="mag-split">
          <div class="reveal">
            <p class="mag-label">Warum gutes Wachstum ausbleibt</p>
            <h2 id="problem-h" class="mag-h2">Nicht das schwächere Angebot verliert. Das <i>unsichtbare</i>.</h2>
          </div>
          <div class="mag-body reveal">
            <p>Du kennst den Moment: Ein Wettbewerber — fachlich schwächer, das weißt du genau — zieht an dir vorbei. Mehr Anfragen, bessere Kunden, höhere Preise. Nicht, weil er mehr kann. Sondern weil er online mehr danach aussieht.</p>
            <p>Online entscheidet sich in zwei, drei Sekunden, ob du teuer wirkst oder beliebig. Und meistens entscheidet es sich gegen die, die es am wenigsten verdient haben. An drei Stellen passiert das:</p>
          </div>
        </div>
        <div class="reveal" style="margin-top:18px;">
          <div class="mag-list-item"><span class="n">01</span><div><h3>Dein Auftritt verrät dein Niveau nicht</h3><p>Die Seite sieht aus wie tausend andere. Wer in zwei Sekunden Premium erwartet und Baukasten findet, ist wieder weg — und merkt sich nichts.</p></div></div>
          <div class="mag-list-item"><span class="n">02</span><div><h3>Anfragen kommen nach Wetterlage</h3><p>Mal Hochbetrieb, mal Funkstille. Empfehlungen tragen dich, aber du kannst nicht steuern, wann der nächste gute Kunde anklopft. Planen lässt sich so nichts.</p></div></div>
          <div class="mag-list-item"><span class="n">03</span><div><h3>Fremde haben keinen Grund, dir zu vertrauen</h3><p>Wer dich nicht kennt, vergleicht über den Preis. Es fehlt das, was Vertrauen schafft, bevor das erste Wort fällt — und genau daran scheitern die guten Angebote.</p></div></div>
        </div>
      </div>
    </section>

    <!-- ============ DREI HANDWERKE (kein Ladder) ============ -->
    <section id="machen" class="mag-section" aria-labelledby="machen-h" style="background:var(--panel);">
      <div class="mag-wrap">
        <div class="mag-tri-head">
          <div class="reveal">
            <p class="mag-label">Wie wir dich wachsen lassen</p>
            <h2 id="machen-h" class="mag-h2">Drei Handwerke. Ein Ziel: dass du <i>wächst</i>.</h2>
          </div>
          <p class="mag-body reveal">Andere verkaufen dir ein Gewerk und verschwinden. Als dein Wachstumspartner verbinden wir drei — und richten alle auf dieselbe Frage aus: Wird daraus eine Anfrage, ein Kunde, Umsatz? Du musst nicht alles auf einmal nehmen. Du startest dort, wo dein Wachstum am meisten Hebel hat.</p>
        </div>
        <div class="mag-tri reveal">
          <div class="mag-craft">
            <div class="verb">Gefunden<br>werden.</div>
            <span class="what">Website · SEO · Copy</span>
            <p>Eine Website, die dein Angebot so hochwertig zeigt, wie es ist — bei Google auffindbar, in Sekunden geladen, mit Texten, die nicht beschreiben, sondern verkaufen.</p>
            <ul><li>Auffindbar statt versteckt</li><li>Texte, die anfragen lassen</li><li>Schnell auf jedem Gerät</li></ul>
          </div>
          <div class="mag-craft">
            <div class="verb">Erinnert<br>werden.</div>
            <span class="what">Printmedien · Magazine</span>
            <p>Etwas, das in der Hand bleibt. Hochwertige Magazine, die den Schreibtisch überleben und aus einem Anbieter eine Marke machen — wie für GreenChild und HEKO Voice.</p>
            <ul><li>Kundenmagazine mit Tiefe</li><li>Direktmailings statt Wegwerf-Flyer</li><li>Redaktion bis Druckvorlage</li></ul>
          </div>
          <div class="mag-craft">
            <div class="verb">Nachgefragt<br>werden.</div>
            <span class="what">Werbung · Funnel</span>
            <p>Wenn der Auftritt trägt, holen wir gezielt die Richtigen: Werbe-Funnel auf Meta &amp; Google, die planbar qualifizierte Anfragen bringen — sauber gemessen, nicht geraten.</p>
            <ul><li>Anzeigen, die zum Angebot passen</li><li>Planbare Anfragen statt Zufall</li><li>Zahlen statt Bauchgefühl</li></ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PULL-QUOTE ============ -->
    <section class="mag-quote">
      <div class="mag-wrap reveal">
        <blockquote>Es gibt keine <b>unbekannten</b> Marktführer.</blockquote>
        <cite>— Warum es Elevo gibt</cite>
      </div>
    </section>

    <!-- ============ BEWEISE ============ -->
    <section id="referenzen" class="mag-section" aria-labelledby="ref-h">
      <div class="mag-wrap">
        <div class="mag-split">
          <div class="reveal">
            <p class="mag-label">Beweise</p>
            <h2 id="ref-h" class="mag-h2">Zahlen, die man <i>anklicken</i> kann.</h2>
          </div>
          <div class="mag-body reveal"><p>Keine Mockups, keine gestellten Screenshots. Drei echte Projekte — öffne sie im Tab und klick dich rein. Was zählt, steht links: das Ergebnis.</p></div>
        </div>
        <div style="margin-top:30px;">
          {proof.map((r) => (
            <a class="mag-proof-row reveal" href={r.url} target="_blank" rel="noopener" aria-label={`${r.name} live öffnen`}>
              <span class="mag-proof-metric">{r.metric}</span>
              <span class="mag-proof-mid"><h3>{r.name}</h3><p>{r.note}</p></span>
              <span class="mag-proof-go">Live öffnen <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ PRINTMEDIEN ============ -->
    <section id="print" class="mag-section" aria-labelledby="print-h" style="background:var(--panel);">
      <div class="mag-wrap">
        <div class="mag-split">
          <div class="reveal">
            <p class="mag-label">Drucksachen, die bleiben</p>
            <h2 id="print-h" class="mag-h2">Was digital fehlt, schafft <i>Papier</i>.</h2>
          </div>
          <div class="mag-body reveal"><p>Eine E-Mail ist in drei Sekunden gelöscht. Ein hochwertiges Magazin liegt wochenlang auf dem Schreibtisch — und arbeitet für dich, während du längst aus dem Termin raus bist. Zwei Stücke, die wir gebaut haben (Ansprechpartner-Daten für die Vorschau anonymisiert):</p></div>
        </div>
        <div class="mag-print reveal" style="margin-top:44px;">
          <figure>
            <a class="cover" href="/magazine/greenchild-info-magazin.pdf" target="_blank" rel="noopener" aria-label="GreenChild Info-Magazin als PDF öffnen">
              <picture><source type="image/webp" srcset="/magazine/greenchild-info-cover.webp"><img src="/magazine/greenchild-info-cover.jpg" alt="Titelseite des GreenChild Info-Magazins über Edelholz als Sachwert" width="380" height="534" loading="lazy" decoding="async"></picture>
            </a>
            <figcaption><span class="t">GreenChild — Info-Magazin</span><span class="d">15 Seiten, die ein erklärungsbedürftiges Investment vom Setzling bis zur Wertentwicklung durcherzählen.</span><span class="a"><a class="mag-textlink" href="/magazine/greenchild-info-magazin.pdf" target="_blank" rel="noopener">Ansehen</a><a class="mag-textlink" href="/magazine/greenchild-info-magazin.pdf" download>Download</a></span></figcaption>
          </figure>
          <figure>
            <a class="cover" href="/magazine/heko-voice-magazin.pdf" target="_blank" rel="noopener" aria-label="HEKO Voice Magazin als PDF öffnen">
              <picture><source type="image/webp" srcset="/magazine/heko-voice-cover.webp"><img src="/magazine/heko-voice-cover.jpg" alt="Titelseite des HEKO Voice Magazins über moderne Telefonie" width="380" height="534" loading="lazy" decoding="async"></picture>
            </a>
            <figcaption><span class="t">HEKO Voice — Magazin</span><span class="d">Ein Direktmailing, das nicht nach Werbung aussieht, sondern nach einer Marke, die man ernst nimmt.</span><span class="a"><a class="mag-textlink" href="/magazine/heko-voice-magazin.pdf" target="_blank" rel="noopener">Ansehen</a><a class="mag-textlink" href="/magazine/heko-voice-magazin.pdf" download>Download</a></span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ GARANTIE ============ -->
    <section id="garantie" class="mag-section" aria-labelledby="gar-h">
      <div class="mag-wrap">
        <div class="mag-guarantee reveal">
          <p class="big" id="gar-h">Unser Risiko.<br><i>Nicht deins.</i></p>
          <div class="mag-body"><p>Jede Arbeit kommt zum Festpreis, der vorher schriftlich feststeht — mit festem Liefertermin, ohne offene Stundenzettel. Und liefert sie nicht, was wir zugesagt haben, arbeiten wir nach, bis es sitzt. Keine Nachforderung, kein Kleingedrucktes.</p></div>
        </div>
      </div>
    </section>

    <hr class="mag-rule mag-wrap" />

    <!-- ============ FAQ ============ -->
    <FAQ />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <div class="mag-wrap" style="text-align:center;padding-bottom:clamp(40px,6vh,72px);margin-top:-10px;">
      <a class="mag-textlink" href="/faq">Alle Fragen &amp; ehrliche Antworten →</a>
    </div>

    <!-- ============ CTA ============ -->
    <section id="final-cta" class="mag-section" style="background:var(--panel);" aria-labelledby="cta-h">
      <div class="mag-wrap mag-cta reveal">
        <span class="scar"><span class="dot"></span>Nur 3 Projekte pro Monat</span>
        <h2 id="cta-h">Lass uns dein <i>Wachstum</i> bauen.</h2>
        <p class="sub">Kostenlos und unverbindlich. Wir schauen uns dein Geschäft an und sagen dir ehrlich, wo dein größter Wachstums-Hebel liegt — Klartext, kein Pitch.</p>
        <a href="#kontakt" class="mag-btn">Wachstumsgespräch sichern
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <p class="trust">Antwort innerhalb von 24 Stunden · kein Verkaufsdruck · DSGVO-konform</p>
      </div>
    </section>

    <!-- ============ KONTAKT ============ -->
    <section id="kontakt" class="mag-section" aria-labelledby="kontakt-h">
      <div class="mag-wrap">
        <div class="mag-kontakt">
          <div class="reveal">
            <p class="mag-label">Kontakt</p>
            <h2 id="kontakt-h" class="mag-h2">Schreib uns. Wir<br>antworten <i>persönlich</i>.</h2>
            <ul class="mag-kontakt-list">
              <li><span class="k">E-Mail</span><a href="mailto:hallo@elevo.solutions">hallo@elevo.solutions</a></li>
              <li><span class="k">Für wen</span><span>Aufstrebende Unternehmen, DACH</span></li>
              <li><span class="k">Antwort</span><span>Innerhalb von 24 Stunden</span></li>
            </ul>
          </div>
          <div class="reveal"><ContactForm /></div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    document.body.classList.add('js');
    const rev = Array.from(document.querySelectorAll('.reveal'));
    if (rev.length && 'IntersectionObserver' in window) {
      const o = new IntersectionObserver((es) => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); o.unobserve(e.target); } }), { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
      rev.forEach(el => o.observe(el));
    } else { rev.forEach(el => el.classList.add('visible')); }
  </script>
</BaseLayout>
