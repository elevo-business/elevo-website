---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Elevo — Webseiten, die wie 10.000 Euro wirken"
  canonical="https://elevo.solutions/"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <main id="main">

    <!-- ===== HERO ===== -->
    <section id="hero" class="ev-hero" aria-labelledby="hero-heading">
      <div class="container">
        <p class="ev-eyebrow">Digitale Werkstatt · Deutschland · Sie-Form</p>
        <h1 id="hero-heading" class="ev-hero-h1">
          Webseiten, die wie <span class="ev-accent">10.000&nbsp;Euro</span> wirken —<br>
          und Anfragen bringen, statt nur gut auszusehen.
        </h1>
        <p class="ev-hero-sub">
          Wir bauen für den deutschen Mittelstand Webseiten, die in Tempo, Vertrauen und
          Sichtbarkeit auf dem Niveau spielen, das Sie von Ihrem besten Wettbewerber kennen —
          und liefern Performance, die Google misst.
        </p>
        <div class="ev-hero-ctas">
          <a href="#kontakt" class="ev-btn ev-btn-primary">
            Strategie-Gespräch anfragen
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#kompetenz" class="ev-btn ev-btn-ghost">Live-Beispiele ansehen</a>
        </div>
        <p class="ev-hero-trust">Unverbindlich · 30 Minuten · auf Deutsch · ohne Verkaufsdruck</p>

        <ul class="ev-trustbar" role="list">
          <li>Live-Beispiele unten</li>
          <li>Lighthouse&nbsp;&gt;&nbsp;90 auf Mobile</li>
          <li>Festpreis vor Start</li>
          <li>Sitz in Deutschland</li>
        </ul>
      </div>
    </section>

    <!-- ===== PROBLEM ===== -->
    <section id="problem" class="ev-section ev-section-alt" aria-labelledby="problem-heading">
      <div class="container">
        <p class="ev-eyebrow">Diagnose</p>
        <h2 id="problem-heading" class="ev-h2">Drei Gründe, warum gute Unternehmen unter ihrem Wert wirken.</h2>
        <div class="ev-grid-3">
          <article class="ev-diag-card">
            <div class="ev-diag-num">01</div>
            <h3>Die Webseite passt nicht zum Unternehmen.</h3>
            <p>Sie verkaufen seit Jahren erfolgreich — aber Ihre Webseite sieht aus wie 2014. Vor jedem Erstgespräch googelt Ihr Gegenüber Sie. Was dort steht, kostet Sie Abschlüsse, die Sie nie messen.</p>
          </article>
          <article class="ev-diag-card">
            <div class="ev-diag-num">02</div>
            <h3>Es kommt kaum jemand.</h3>
            <p>Optisch passt die Seite. Aber Google liefert kaum Besucher, mobile Nutzer brechen ab, das Anfrage-Formular füllt niemand mehr aus — und Sie wissen nicht, ob es am Text, am Tempo oder am Aufbau liegt.</p>
          </article>
          <article class="ev-diag-card">
            <div class="ev-diag-num">03</div>
            <h3>Outreach läuft, die Seite überzeugt nicht.</h3>
            <p>Sie sprechen Interessenten gezielt an. Aber was sie auf Ihrer Webseite sehen, passt nicht zu dem, was Sie vorher versprochen haben. Termine entstehen erst, wenn Sie selbst nachfassen.</p>
          </article>
        </div>
        <p class="ev-pullquote">
          Solange die digitale Wahrnehmung unter der Realität liegt, gewinnen Wettbewerber Gespräche,
          die Ihnen gehört hätten.
        </p>
      </div>
    </section>

    <!-- ===== LÖSUNG / MECHANISMUS ===== -->
    <section id="loesung" class="ev-section" aria-labelledby="loesung-heading">
      <div class="container">
        <p class="ev-eyebrow">Mechanismus</p>
        <h2 id="loesung-heading" class="ev-h2">Wie wir Webseiten auf das <span class="ev-accent">10.000-Euro-Niveau</span> bringen.</h2>
        <div class="ev-grid-3">
          <article class="ev-mech-card">
            <div class="ev-mech-glyph" aria-hidden="true">
              <svg width="34" height="34" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 36 L32 16 L52 36"/><path d="M16 50 L32 34 L48 50" opacity="0.4"/></svg>
            </div>
            <h3>Marke vor Pixel.</h3>
            <p>Wir klären erst Position, Versprechen und Bildwelt — dann gehen wir auf den Bildschirm. Keine Template-Patchwork-Lösung. Eine eigene Sprache, mit der Ihr Unternehmen wieder Stolz erzeugt.</p>
          </article>
          <article class="ev-mech-card">
            <div class="ev-mech-glyph" aria-hidden="true">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <h3>Performance, die Google misst.</h3>
            <p>Jede Seite verlässt unser Haus mit einem Lighthouse-Mobile-Wert ≥ 90. Schnelle Ladezeit, sauberes technisches SEO, mobile-first gebaut — sonst arbeiten wir auf unsere Kosten nach.</p>
          </article>
          <article class="ev-mech-card">
            <div class="ev-mech-glyph" aria-hidden="true">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h3>Festpreis, fester Termin, fester Standard.</h3>
            <p>Vor dem ersten Pixel: Preis fix, Liefer-Termin schriftlich, Standard verbindlich. Auf deutsch, mit deutschem Verständnis für Qualität und Verbindlichkeit.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== OFFERS (Hormozi Value-Stacks, NO PRICES) ===== -->
    <section id="offers" class="ev-section ev-section-alt" aria-labelledby="offers-heading">
      <div class="container">
        <p class="ev-eyebrow">Angebote</p>
        <h2 id="offers-heading" class="ev-h2">Drei Wege, mit Elevo zu arbeiten.</h2>
        <p class="ev-section-sub">Keine Pakete von der Stange. Jede Lösung ist ein eigenständiges Versprechen — mit klarem Mechanismus, vollem Bonus-Stack und einer Garantie, die belastbar ist.</p>

        <div class="ev-offers-grid">
          <!-- Offer 1 -->
          <article class="ev-offer">
            <p class="ev-offer-tag">Offer 01 · Neubau</p>
            <h3 class="ev-offer-title">Premium-Website</h3>
            <p class="ev-offer-pitch">Die Webseite, mit der Ihr Unternehmen wieder Stolz erzeugt.</p>

            <div class="ev-offer-block">
              <div class="ev-offer-label">Für wen</div>
              <p>Sie verkaufen erfolgreich, aber Ihre Webseite sieht aus wie 2014. Empfänger Ihrer Angebote googeln Sie vorab — und Sie wissen: Was sie sehen, kostet Sie Abschlüsse.</p>
            </div>
            <div class="ev-offer-block">
              <div class="ev-offer-label">Mechanismus</div>
              <p>Eigene Marken-Sprache, eigene Bildwelt, eigene Struktur. Vom Markenbild bis zur Ladezeit neu gebaut — kein Template, kein Baukasten, kein Patchwork.</p>
            </div>
            <div class="ev-offer-block">
              <div class="ev-offer-label">Ergebnis</div>
              <ul class="ev-offer-list">
                <li>Eine Webseite, bei der Sie wollen, dass jeder Interessent sie öffnet.</li>
                <li>Warme Anfragen — Vertrauen ist schon vor dem Erstgespräch da.</li>
                <li>Eine Marke, die fünf Jahre mitwächst, statt in zwei Jahren ersetzt zu werden.</li>
              </ul>
            </div>
            <div class="ev-offer-block">
              <div class="ev-offer-label">Bonus-Stack — alles inklusive</div>
              <ul class="ev-offer-bonus">
                <li>Marken-Workshop (Position, Versprechen, Bildsprache)</li>
                <li>Vollständige SEO-Grundausstattung (Struktur, Meta, Sitemap, Schema)</li>
                <li>DSGVO-konformes Setup (Impressum, Datenschutz, Cookie-Banner)</li>
                <li>Iterationsrunde nach Launch (Texte, Bilder, Feinschliff)</li>
                <li>Übergabe-Termin für Ihr Team — Sie pflegen selbst</li>
              </ul>
            </div>
            <div class="ev-offer-risk">
              <strong>Risk Reversal:</strong>
              Festpreis vor Start. Liefer-Termin schriftlich. Lighthouse-Mobile ≥ 90 vor Übergabe —
              sonst arbeiten wir auf unsere Kosten nach.
            </div>
            <a href="#kontakt" class="ev-btn ev-btn-primary ev-btn-block">Premium-Website besprechen →</a>
          </article>

          <!-- Offer 2 -->
          <article class="ev-offer">
            <p class="ev-offer-tag">Offer 02 · Bestand</p>
            <h3 class="ev-offer-title">Performance- &amp; SEO-Rettung</h3>
            <p class="ev-offer-pitch">Wenn die Webseite steht, aber niemand kommt.</p>

            <div class="ev-offer-block">
              <div class="ev-offer-label">Für wen</div>
              <p>Sie haben vor zwei oder drei Jahren in eine ordentliche Webseite investiert. Optisch passt sie — aber Google liefert kaum Besucher, mobile Nutzer brechen ab, niemand füllt das Formular.</p>
            </div>
            <div class="ev-offer-block">
              <div class="ev-offer-label">Mechanismus</div>
              <p>Vier-Achsen-Diagnose: Performance, technisches SEO, Inhalts-Hierarchie, Conversion-Pfad. Ein Befund-Report, dann fokussierte Eingriffe genau an den Stellen mit dem grössten Hebel — kein Komplett-Umbau, wenn er nicht nötig ist.</p>
            </div>
            <div class="ev-offer-block">
              <div class="ev-offer-label">Ergebnis</div>
              <ul class="ev-offer-list">
                <li>Messbar schnellere Ladezeit auf Mobile und Desktop.</li>
                <li>Sichtbare Verbesserung der Google-Position bei Ihren Kernbegriffen.</li>
                <li>Mehr Anfragen über die bestehende Seite — ohne Re-Design.</li>
              </ul>
            </div>
            <div class="ev-offer-block">
              <div class="ev-offer-label">Bonus-Stack — alles inklusive</div>
              <ul class="ev-offer-bonus">
                <li>Vollständiger Performance- &amp; SEO-Befund mit Prio-Liste</li>
                <li>Vorher/Nachher-Messung (Lighthouse, Pagespeed, Core Web Vitals)</li>
                <li>Conversion-Audit der drei wichtigsten Seiten</li>
                <li>60-Minuten-Übergabe mit Ihrem Marketing oder IT</li>
                <li>14 Tage Iterations-Fenster nach Übergabe</li>
              </ul>
            </div>
            <div class="ev-offer-risk">
              <strong>Risk Reversal:</strong>
              Wir definieren vor Start einen Lighthouse-Zielwert. Erreichen wir ihn auf Mobile nicht,
              arbeiten wir nach — auf unsere Kosten.
            </div>
            <a href="#kontakt" class="ev-btn ev-btn-primary ev-btn-block">Performance-Audit anfragen →</a>
          </article>

          <!-- Offer 3 -->
          <article class="ev-offer">
            <p class="ev-offer-tag">Offer 03 · Outreach</p>
            <h3 class="ev-offer-title">Conversion-Site</h3>
            <p class="ev-offer-pitch">Die Webseite, die für Sie verkauft, während Sie liefern.</p>

            <div class="ev-offer-block">
              <div class="ev-offer-label">Für wen</div>
              <p>Sie sprechen Interessenten gezielt an — per E-Mail, Empfehlung, im Gespräch. Was sie dann auf Ihrer Webseite sehen, überzeugt nicht. Termine entstehen erst, wenn Sie selbst nochmal nachfassen.</p>
            </div>
            <div class="ev-offer-block">
              <div class="ev-offer-label">Mechanismus</div>
              <p>Eine eigenständige Verkaufs-Webseite, exakt auf einen Anlass zugeschnitten: Outreach-Kampagne, Branche, ein konkretes Angebot. Eine Seite, ein klares Versprechen, ein Termin-Pfad. Personalisierte Preview-Varianten möglich — live umgesetzt für Zahnarzt-Praxen und einen Wellness-Markenträger.</p>
            </div>
            <div class="ev-offer-block">
              <div class="ev-offer-label">Ergebnis</div>
              <ul class="ev-offer-list">
                <li>Empfänger Ihrer Outreach-Mail klicken — und sehen sofort, dass es um sie geht.</li>
                <li>Termine kommen direkt rein, ohne dass Sie nachfassen.</li>
                <li>Sie skalieren Ansprache, ohne Ihre Hauptseite zu kannibalisieren.</li>
              </ul>
            </div>
            <div class="ev-offer-block">
              <div class="ev-offer-label">Bonus-Stack — alles inklusive</div>
              <ul class="ev-offer-bonus">
                <li>Strategie-Workshop zu Zielgruppe und Versprechen</li>
                <li>Vorlage für die Outreach-Mail, die zur Seite führt</li>
                <li><em>Termin-Pfad im Kalender Ihres Vertriebs — optional / auf Wunsch</em></li>
                <li>Branding-Anpassung pro Empfänger-Segment möglich</li>
                <li>Performance-Setup auf Elevo-Standard</li>
              </ul>
            </div>
            <div class="ev-offer-risk">
              <strong>Risk Reversal &middot; Konversions-Garantie:</strong>
              Festpreis vor Start. Lighthouse-Mobile ≥ 90 bei Übergabe. Zusätzlich: vereinbartes
              Konversions-Ziel (z.B. Anzahl gebuchter Erstgespräche in den ersten 30 Tagen nach Launch) —
              wird es nicht erreicht, arbeiten wir auf unsere Kosten am Conversion-Pfad nach.
            </div>
            <a href="#kontakt" class="ev-btn ev-btn-primary ev-btn-block">Conversion-Site besprechen →</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== KOMPETENZ / PROOF ===== -->
    <section id="kompetenz" class="ev-section" aria-labelledby="kompetenz-heading">
      <div class="container">
        <p class="ev-eyebrow">Sichtbare Web-Arbeit</p>
        <h2 id="kompetenz-heading" class="ev-h2">Was wir bauen, geht online —<br>und steht online.</h2>
        <p class="ev-section-sub">Jeder Eintrag verlinkt auf eine Live-Seite oder eine öffentlich erreichbare Preview. Kein Mock-up, kein Konzept-Bild — sondern Web-Arbeit, die Sie selbst öffnen können.</p>

        <ul class="ev-outcomes" role="list">
          <li><strong>Vier</strong> sichtbare Web-Arbeiten live im Netz</li>
          <li>Lighthouse-Mobile-Median <strong>93</strong> auf der jüngsten Auslieferung</li>
          <li>Volle <strong>100</strong> Punkte in A11y, Best Practices, SEO (jüngste Auslieferung)</li>
          <li>DSGVO-konformes Setup standardmässig</li>
        </ul>

        <div class="ev-proof-grid">
          <article class="ev-proof-card">
            <p class="ev-proof-tag">Markenwebseite · Sales-Magazin</p>
            <h3>GreenChild</h3>
            <p>Markenwebseite, digitales Sales-Magazin, Anfrage-Pfad zum Termingespräch — inklusive interaktivem Kreislauf-Diagramm und Sachwert-Rechner in der Erlebniswelt-Sektion. Seit Jahren produktiv im Einsatz, regulierte Branche mit hohen Compliance-Anforderungen.</p>
            <a href="https://greenchild.eu" target="_blank" rel="noopener noreferrer" class="ev-proof-link">
              greenchild.eu
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>

          <article class="ev-proof-card">
            <p class="ev-proof-tag">Outreach-Preview · Wellness</p>
            <h3>Thermae 2000</h3>
            <p>Vollständige Preview-Webseite — neun Sections, eigene Bildsprache, kompletter Brand-Transfer. <strong>Lighthouse Mobile 93 / Desktop 98</strong>, je 100 Punkte in A11y, Best Practices und SEO. Unser sichtbarster Performance-Beleg.</p>
            <a href="https://thermae-preview.elevo.solutions" target="_blank" rel="noopener noreferrer" class="ev-proof-link">
              thermae-preview.elevo.solutions
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>

          <article class="ev-proof-card">
            <p class="ev-proof-tag">Personalisierte Conversion-Sites</p>
            <h3>Zahnarzt-Preview-Serie</h3>
            <p>Mehr als zehn personalisierte Preview-Webseiten für Zahnarztpraxen — jede mit dem echten Logo, echten Praxis-Bildern und der Farbwelt der jeweiligen Praxis. Auswahl: Apollonia Praxisklinik, Zahnärzte Kö55, Zahnarztpraxen im Stadttor. Mit klarer Buchungs-Strecke zum Erstgespräch.</p>
            <a href="/previews/apollo-zahnarzt/" target="_blank" rel="noopener noreferrer" class="ev-proof-link">
              Apollonia Praxisklinik ansehen
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>

          <article class="ev-proof-card">
            <p class="ev-proof-tag">Marken-Übersetzung Traditionsmarke</p>
            <h3>Weihenstephan-Preview</h3>
            <p>Eigenständige Test-Webseite für ein deutsches Traditionsunternehmen aus dem Getränke-Segment — eigene Bildsprache, eigener Setzkasten, komplette Mobile-Optimierung. Wie man eine etablierte Marke ins heutige Web übersetzt, ohne ihre Geschichte zu verraten.</p>
            <a href="https://weihenstephan-preview.elevo.solutions" target="_blank" rel="noopener noreferrer" class="ev-proof-link">
              weihenstephan-preview.elevo.solutions
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== FOUNDER-VISION ===== -->
    <section id="warum" class="ev-section ev-section-alt" aria-labelledby="vision-heading">
      <div class="container">
        <div class="ev-vision">
          <div class="ev-vision-mark" aria-hidden="true">
            <svg width="120" height="120" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 36 L32 16 L52 36"/>
              <path d="M16 50 L32 34 L48 50" opacity="0.4"/>
            </svg>
            <span class="ev-vision-wordmark">Elevo</span>
          </div>
          <div class="ev-vision-body">
            <p class="ev-eyebrow">Warum es Elevo gibt</p>
            <h2 id="vision-heading" class="ev-h2">Der deutsche Mittelstand ist nicht digitalisiert, weil die Schritte zu gross gedacht werden.</h2>
            <div class="ev-vision-text">
              <p>Es heisst: erst die ganze Firma digitalisieren, dann die Prozesse, dann die Vertriebskanäle. Und während alle auf den richtigen Moment warten, wirken die meisten Webseiten weiter wie vor zehn Jahren. Mit dem Ergebnis, dass selbst gute Unternehmen unter ihrem Wert wahrgenommen werden.</p>
              <p>Elevo ist gegründet mit einer einfachen Überzeugung: <strong>Die Webseite ist der schnellste, sichtbarste Hebel</strong>, um die digitale Wahrnehmung Ihres Unternehmens auf das Niveau zu heben, das Sie in Wirklichkeit längst haben. Wenn dieser Hebel sitzt, folgen die nächsten Schritte fast von allein — bessere Anfragen, bessere Gespräche, bessere Abschlüsse.</p>
              <p>Wir bauen Webseiten, mit denen wir selbst arbeiten würden, wenn wir an Ihrer Stelle wären. Auf deutsch, mit deutschem Verständnis für Qualität und Verbindlichkeit, und mit einer Vorstellung von Handwerk, die wir nicht abkürzen.</p>
              <p class="ev-vision-close">Wenn das auch Ihre Vorstellung ist — sprechen wir uns einmal.</p>
            </div>
            <a href="#kontakt" class="ev-btn ev-btn-primary">Strategie-Gespräch anfragen →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== FINAL CTA ===== -->
    <section id="final-cta" class="ev-section" aria-labelledby="finalcta-heading">
      <div class="container">
        <div class="ev-final">
          <p class="ev-eyebrow">Ihr nächster Schritt</p>
          <h2 id="finalcta-heading" class="ev-h2">Ein Strategie-Gespräch.</h2>
          <p class="ev-final-sub">
            30 Minuten. Auf Deutsch. Ohne Verkaufsdruck. Wir hören zu, schauen uns Ihre Seite an,
            sagen Ihnen ehrlich, ob wir der richtige Partner sind — und wenn nicht, sagen wir Ihnen, wer es ist.
          </p>
          <a href="#kontakt" class="ev-btn ev-btn-primary ev-btn-xl">Strategie-Gespräch anfragen</a>
          <p class="ev-final-trust">Antwort innerhalb von 24 Stunden · Sitz in Deutschland · DSGVO-konform</p>
        </div>
      </div>
    </section>

    <!-- ===== KONTAKT ===== -->
    <section id="kontakt" class="ev-section ev-section-alt" aria-labelledby="kontakt-heading">
      <div class="container">
        <div class="ev-kontakt-grid">
          <div>
            <p class="ev-eyebrow">Kontakt</p>
            <h2 id="kontakt-heading" class="ev-h2">Lassen Sie uns über Ihr Projekt sprechen.</h2>
            <p class="ev-section-sub">Kostenloses Erstgespräch, 30 Minuten, ohne Verkaufsdruck. Gerne per E-Mail oder über das Formular.</p>
            <ul class="ev-kontakt-list" role="list">
              <li>
                <span class="ev-kontakt-label">E-Mail</span>
                <a href="mailto:hallo@elevo.solutions">hallo@elevo.solutions</a>
              </li>
              <li>
                <span class="ev-kontakt-label">Standort</span>
                <span>Ahrstraße 6, 52511 Geilenkirchen · NRW</span>
              </li>
              <li>
                <span class="ev-kontakt-label">Antwort</span>
                <span>Innerhalb von 24 Stunden</span>
              </li>
            </ul>
          </div>
          <div class="ev-kontakt-form">
            <ContactForm />
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  /* === Elevo Hormozi Page — scoped to .ev-* classes === */

  .ev-section,
  .ev-hero {
    padding: clamp(64px, 9vw, 128px) 0;
    background: var(--bg-dark);
  }
  .ev-section-alt {
    background: var(--bg-alt);
  }

  .ev-eyebrow {
    color: var(--accent);
