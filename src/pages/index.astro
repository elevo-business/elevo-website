---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Elevo — Digitalisierung & Prozessautomatisierung für inhabergeführte Unternehmen"
  description="Wir digitalisieren die Abläufe inhabergeführter Unternehmen und bauen die Automatisierung dahinter: Anfragen, Angebote und Termine laufen von selbst. Festpreis, klare Ziele, in 4–6 Wochen einsatzbereit."
  canonical="https://elevo.solutions/"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <main id="main">

    <!-- ===== HERO ===== -->
    <section id="hero" class="ev-hero" aria-labelledby="hero-heading">
      <div class="container">
        <p class="ev-eyebrow">Digitalisierung · Prozessautomatisierung · Deutschland</p>
        <h1 id="hero-heading" class="ev-hero-h1">
          Ihr Betrieb läuft.<br>
          <span class="ev-accent">Auch ohne dass Sie jeden Handgriff selbst machen.</span>
        </h1>
        <p class="ev-hero-sub">
          Wir digitalisieren Ihre Abläufe und bauen die Automatisierung dahinter — Anfragen,
          Angebote und Termine laufen von selbst. Festpreis, klare Ziele, in 4–6 Wochen einsatzbereit.
        </p>
        <div class="ev-hero-ctas">
          <a href="#kontakt" class="ev-btn ev-btn-primary">
            Erstgespräch anfragen
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#angebot" class="ev-btn ev-btn-ghost">So funktioniert's</a>
        </div>
        <p class="ev-hero-trust">Festpreis vor Start · Ziele schriftlich · auf Deutsch</p>

        <ul class="ev-trustbar" role="list">
          <li>Für inhabergeführte Unternehmen</li>
          <li>In 4–6 Wochen einsatzbereit</li>
          <li>Festpreis vor Start</li>
          <li>Sitz in Deutschland</li>
        </ul>
      </div>
    </section>

    <!-- ===== BEWEIS-LEISTE ===== -->
    <section id="beweis" class="ev-section ev-section-alt ev-section--tight" aria-labelledby="beweis-heading">
      <div class="container">
        <h2 id="beweis-heading" class="ev-sr-only">Ergebnisse aus echten Projekten</h2>
        <ul class="ev-proofbar" role="list">
          <li class="ev-proofbar-item">
            <span class="ev-proofbar-num">+3×</span>
            <span class="ev-proofbar-label">mehr Reservierungen — Akropolis</span>
          </li>
          <li class="ev-proofbar-item">
            <span class="ev-proofbar-num">+62 %</span>
            <span class="ev-proofbar-label">mehr Buchungen — ZUMA</span>
          </li>
          <li class="ev-proofbar-item">
            <span class="ev-proofbar-num">3 Wochen</span>
            <span class="ev-proofbar-label">von null bis fertig — Greenchild</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- ===== PROBLEM ===== -->
    <section id="problem" class="ev-section" aria-labelledby="problem-heading">
      <div class="container">
        <p class="ev-eyebrow">Das Problem</p>
        <h2 id="problem-heading" class="ev-h2">Führen Sie Ihr Unternehmen — oder verwalten Sie es?</h2>
        <p class="ev-section-sub">Drei Dinge hören wir in fast jedem Erstgespräch:</p>
        <div class="ev-grid-3">
          <article class="ev-diag-card">
            <div class="ev-diag-icon" aria-hidden="true">
              <!-- Lucide: inbox -->
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
            </div>
            <h3>Anfragen versanden.</h3>
            <p>Eine Mail hier, ein Anruf da, ein Zettel auf dem Tisch. Am Ende fällt jemand durchs Raster.</p>
          </article>
          <article class="ev-diag-card">
            <div class="ev-diag-icon" aria-hidden="true">
              <!-- Lucide: clock -->
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3>Angebote kosten Stunden.</h3>
            <p>Jedes Mal von Hand zusammengesucht, statt in Minuten raus zu sein.</p>
          </article>
          <article class="ev-diag-card">
            <div class="ev-diag-icon" aria-hidden="true">
              <!-- Lucide: user-cog -->
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="7" r="4"/><path d="M10.3 15H7a4 4 0 0 0-4 4v2"/><circle cx="19" cy="16" r="3"/><path d="M19 11v1M19 21v1M22.5 13.5l-.9.5M16.4 17l-.9.5M22.5 18.5l-.9-.5M16.4 16l-.9-.5"/></svg>
            </div>
            <h3>Alles hängt an Ihnen.</h3>
            <p>Ohne Sie steht der Laden. Urlaub? Schwierig.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== ANGEBOT: DER DIGITALE BETRIEB ===== -->
    <section id="angebot" class="ev-section ev-section-alt" aria-labelledby="angebot-heading">
      <div class="container">
        <p class="ev-eyebrow">Das Angebot</p>

        <div class="ev-system">
          <div class="ev-system-copy">
            <h2 id="angebot-heading" class="ev-h2">Der Digitale Betrieb</h2>
            <p class="ev-offer-pitch">Ein System, das aus Anfragen planbar Aufträge macht — und Ihnen den Verwaltungs-Kram vom Tisch nimmt.</p>
            <span class="ev-offer-kpi">Komplett aufgebaut in 4–6 Wochen</span>

            <div class="ev-offer-label">Was wir aufbauen</div>
            <ul class="ev-offer-bonus" role="list">
              <li>Wir schauen uns Ihre Abläufe an — wo Zeit verloren geht und Anfragen versanden</li>
              <li>Wir zeichnen den Weg von der Anfrage bis zum fertigen Auftrag auf</li>
              <li>Anfragen, Angebote, Termine und Nachfassen laufen ab dann von selbst</li>
              <li>Alle Kundendaten an einem Ort — Schluss mit Excel und Zetteln</li>
              <li>Ihre Webseite als sichtbare Front des Systems</li>
              <li>Ihr Team wird geschult und bekommt eine einfache Anleitung</li>
              <li>30 Tage Feinschliff nach dem Start — wir justieren nach, bis es sitzt</li>
              <li>Datenschutz von Anfang an mitgedacht</li>
            </ul>

            <a href="#kontakt" class="ev-btn ev-btn-primary">
              Erstgespräch anfragen
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>

          <div class="ev-system-visual" aria-hidden="true">
            <div class="ev-dash">
              <div class="ev-dash-bar">
                <span class="ev-dash-dot ev-dash-dot--r"></span>
                <span class="ev-dash-dot ev-dash-dot--y"></span>
                <span class="ev-dash-dot ev-dash-dot--g"></span>
                <span class="ev-dash-url">übersicht.elevo</span>
              </div>
              <div class="ev-dash-body">
                <div class="ev-dash-side">
                  <span class="ev-dash-side-line ev-dash-side-line--on"></span>
                  <span class="ev-dash-side-line"></span>
                  <span class="ev-dash-side-line"></span>
                  <span class="ev-dash-side-line"></span>
                </div>
                <div class="ev-dash-main">
                  <div class="ev-dash-kpis">
                    <div class="ev-dash-kpi"><span>Anfragen</span><strong>24</strong></div>
                    <div class="ev-dash-kpi"><span>Termine</span><strong>11</strong></div>
                    <div class="ev-dash-kpi"><span>Aufträge</span><strong>9</strong></div>
                  </div>
                  <div class="ev-dash-rows">
                    <div class="ev-dash-row"><span class="ev-dash-rowbar"></span><span class="ev-dash-status ev-dash-status--new">Neu</span></div>
                    <div class="ev-dash-row"><span class="ev-dash-rowbar"></span><span class="ev-dash-status">Angebot raus</span></div>
                    <div class="ev-dash-row"><span class="ev-dash-rowbar"></span><span class="ev-dash-status">Termin</span></div>
                    <div class="ev-dash-row"><span class="ev-dash-rowbar"></span><span class="ev-dash-status ev-dash-status--won">Gewonnen</span></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Automations-Flow -->
        <div class="ev-flow-wrap">
          <p class="ev-flow-caption">So läuft eine Anfrage durch Ihr System — ohne dass jemand etwas anfasst:</p>
          <div class="ev-flow" role="img" aria-label="Ablauf: Anfrage kommt rein, landet automatisch im System, Angebot raus in Minuten, Termin und Erinnerung von selbst.">
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </span>
              <span class="ev-flow-label">Anfrage kommt rein</span>
            </div>
            <div class="ev-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </div>
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/></svg>
              </span>
              <span class="ev-flow-label">Landet automatisch im System</span>
            </div>
            <div class="ev-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </div>
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
              </span>
              <span class="ev-flow-label">Angebot raus in Minuten</span>
            </div>
            <div class="ev-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </div>
            <div class="ev-flow-node">
              <span class="ev-flow-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
              </span>
              <span class="ev-flow-label">Termin &amp; Erinnerung von selbst</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== ABLAUF ===== -->
    <section id="prozess" class="ev-section" aria-labelledby="prozess-heading">
      <div class="container">
        <p class="ev-eyebrow">So arbeiten wir</p>
        <h2 id="prozess-heading" class="ev-h2">Vom ersten Gespräch bis es läuft.</h2>
        <div class="prozess-steps">
          <div class="prozess-step">
            <div class="step-num">01</div>
            <h3 class="step-title">Erstgespräch</h3>
            <p class="step-desc">30 Minuten. Wir hören zu und schauen uns Ihre Abläufe an. Kostenlos.</p>
          </div>
          <div class="prozess-step">
            <div class="step-num">02</div>
            <h3 class="step-title">Plan</h3>
            <p class="step-desc">Wir zeigen Ihnen, wo am meisten Zeit verloren geht — und was zuerst kommt.</p>
          </div>
          <div class="prozess-step">
            <div class="step-num">03</div>
            <h3 class="step-title">Aufbau</h3>
            <p class="step-desc">Wir bauen Ihr System. Sie sehen jede Woche, wie weit wir sind.</p>
          </div>
          <div class="prozess-step">
            <div class="step-num">04</div>
            <h3 class="step-title">Übergabe</h3>
            <p class="step-desc">Ihr Team wird geschult. Danach läuft es — wir justieren 30 Tage nach.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== VORHER / NACHHER ===== -->
    <section id="vorher-nachher" class="ev-section ev-section-alt" aria-labelledby="ba-heading">
      <div class="container">
        <p class="ev-eyebrow">Der Unterschied</p>
        <h2 id="ba-heading" class="ev-h2">So fühlt sich der Alltag danach an.</h2>
        <div class="ev-ba">
          <div class="ev-ba-col ev-ba-col--before">
            <p class="ev-ba-head">Vorher</p>
            <ul role="list">
              <li>Anfragen in fünf verschiedenen Postfächern</li>
              <li>Jedes Angebot dauert Stunden</li>
              <li>Termine telefonisch hin und her</li>
              <li>Nachfassen ständig vergessen</li>
            </ul>
          </div>
          <div class="ev-ba-col ev-ba-col--after">
            <p class="ev-ba-head">Nachher</p>
            <ul role="list">
              <li>Jede Anfrage landet automatisch an einem Ort</li>
              <li>Angebot in Minuten draußen</li>
              <li>Kunde bucht selbst — Sie sehen alles</li>
              <li>Das System erinnert von allein</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== KOMPETENZ / PROOF ===== -->
    <section id="kompetenz" class="ev-section" aria-labelledby="kompetenz-heading">
      <div class="container">
        <p class="ev-eyebrow">Sichtbare Arbeit</p>
        <h2 id="kompetenz-heading" class="ev-h2">Was wir bauen, läuft —<br>und ist öffentlich zu sehen.</h2>
        <p class="ev-section-sub">Jeder Eintrag verlinkt auf eine Live-Seite oder eine öffentlich erreichbare Vorschau. Kein Mock-up, kein Konzept-Bild — sondern Arbeit, die Sie selbst öffnen können.</p>

        <ul class="ev-outcomes" role="list">
          <li><strong>Vier</strong> sichtbare Arbeiten live im Netz</li>
          <li>Schnell auf jedem Handy</li>
          <li>Top-Bewertung bei Zugänglichkeit und Google-Bereitschaft</li>
          <li>Datenschutz-konformes Setup standardmäßig</li>
        </ul>

        <div class="ev-proof-grid">
          <article class="ev-proof-card">
            <p class="ev-proof-tag">Markenwebseite · Sales-Magazin</p>
            <h3>GreenChild</h3>
            <p>Markenwebseite, digitales Magazin, klarer Weg zum Termingespräch — inklusive interaktivem Kreislauf-Diagramm und Rechner. Seit Jahren im Einsatz, in einer Branche mit hohen Anforderungen.</p>
            <a href="https://greenchild.eu" target="_blank" rel="noopener noreferrer" class="ev-proof-link">
              greenchild.eu
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>

          <article class="ev-proof-card">
            <p class="ev-proof-tag">Vorschau-Seite · Wellness</p>
            <h3>Thermae 2000</h3>
            <p>Vollständige Vorschau-Webseite — neun Abschnitte, eigene Bildsprache, kompletter Marken-Transfer. Schnell auf jedem Handy, mit Top-Bewertung bei Zugänglichkeit und Google-Bereitschaft.</p>
            <a href="https://thermae-preview.elevo.solutions" target="_blank" rel="noopener noreferrer" class="ev-proof-link">
              thermae-preview.elevo.solutions
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>

          <article class="ev-proof-card">
            <p class="ev-proof-tag">Personalisierte Vorschauen · Praxen</p>
            <h3>Zahnarzt-Vorschau-Serie</h3>
            <p>Mehr als zehn personalisierte Vorschau-Webseiten für Zahnarztpraxen — jede mit echtem Logo, echten Bildern und der Farbwelt der Praxis. Mit klarem Weg zum Termin.</p>
            <a href="/previews/apollo-zahnarzt/" target="_blank" rel="noopener noreferrer" class="ev-proof-link">
              Apollonia Praxisklinik ansehen
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>

          <article class="ev-proof-card">
            <p class="ev-proof-tag">Marken-Übersetzung Traditionsmarke</p>
            <h3>Weihenstephan-Preview</h3>
            <p>Eigenständige Test-Webseite für ein deutsches Traditionsunternehmen aus dem Getränke-Segment — eigene Bildsprache, eigener Aufbau, komplett auf dem Handy optimiert.</p>
            <a href="https://weihenstephan-preview.elevo.solutions" target="_blank" rel="noopener noreferrer" class="ev-proof-link">
              weihenstephan-preview.elevo.solutions
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== GARANTIE ===== -->
    <section id="garantie" class="ev-section ev-section-alt" aria-labelledby="garantie-heading">
      <div class="container">
        <div class="ev-guarantee">
          <div class="ev-guarantee-ico" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="ev-guarantee-body">
            <p class="ev-eyebrow">Unser Versprechen</p>
            <h2 id="garantie-heading" class="ev-h2">Unser Risiko, nicht Ihres.</h2>
            <p>Festpreis vor Start — Sie wissen vorher, was es kostet. Die Ziele legen wir gemeinsam schriftlich fest. Werden sie nicht erreicht, arbeiten wir auf unsere Kosten nach, bis sie es sind.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== WEBSEITE (ZWEITRANGIG) ===== -->
    <section id="webseite" class="ev-section" aria-labelledby="webseite-heading">
      <div class="container">
        <div class="ev-secondary">
          <div>
            <p class="ev-eyebrow">Auch möglich</p>
            <h2 id="webseite-heading" class="ev-h2">Erstmal nur eine Webseite?</h2>
            <p class="ev-secondary-text">
              Auch die bauen wir — als Fundament Ihres digitalen Betriebs: eigenes Design, schnell,
              bei Google gefunden. Ehrlich gesagt bringt eine Webseite allein selten den Hebel,
              den echte Automatisierung bringt. Aber sie ist ein guter erster Schritt.
            </p>
            <a href="/leistungen" class="ev-btn ev-btn-ghost">Mehr zu unseren Leistungen</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== WARUM ELEVO ===== -->
    <section id="warum" class="ev-section ev-section-alt" aria-labelledby="vision-heading">
      <div class="container">
        <div class="ev-vision">
          <div class="ev-vision-mark" aria-hidden="true">
            <svg width="120" height="120" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 36 L32 16 L52 36"/>
              <path d="M16 50 L32 34 L48 50" opacity="0.4"/>
            </svg>
            <span class="ev-vision-wordmark">Elevo</span>
          </div>
          <div class="ev-vision-body">
            <p class="ev-eyebrow">Warum es Elevo gibt</p>
            <h2 id="vision-heading" class="ev-h2">Die meisten Betriebe verlieren jeden Tag Zeit an Abläufe, die längst von selbst laufen könnten.</h2>
            <div class="ev-vision-text">
              <p>Eine schöne Webseite kann heute fast jeder bauen. Der echte Unterschied liegt woanders: in den Abläufen dahinter. Genau dort gehen jeden Tag Stunden verloren — beim Sortieren von Anfragen, beim Schreiben von Angeboten, beim Hinterhertelefonieren.</p>
              <p>Wir digitalisieren genau diese Abläufe. <strong>Nicht mit einem riesigen Projekt</strong>, das ein Jahr dauert, sondern Schritt für Schritt — mit dem, was Ihnen sofort am meisten Zeit zurückgibt.</p>
              <p>Wir bauen das, was wir an Ihrer Stelle bauen würden — mit Anspruch an Qualität, klaren Zusagen und Arbeit, die hält.</p>
