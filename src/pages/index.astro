---
// Startseite elevo.solutions: Mandantengewinnung für Kanzleien mit 2 bis 10 Mitarbeitenden.
// Ganz oben das Angebot in einem Satz, danach Alltag → Ursache → Methode → Ergebnisse → Angebot → Anfrage → Fragen.
// Texte: src/config/startseite.json, Doku: STARTSEITE.md
import SsLayout from '../startseite/layouts/SsLayout.astro';
import ss from '../config/startseite.json';
import Header from '../startseite/components/Header.astro';
import Hero from '../startseite/components/Hero.astro';
import Alltag from '../startseite/components/Alltag.astro';
import Ursache from '../startseite/components/Ursache.astro';
import Methode from '../startseite/components/Methode.astro';
import Ergebnisse from '../startseite/components/Ergebnisse.astro';
import Offer from '../startseite/components/Offer.astro';
import Anfrage from '../startseite/components/Anfrage.astro';
import Faq from '../startseite/components/Faq.astro';
import FinalCta from '../startseite/components/FinalCta.astro';
import StickyCta from '../startseite/components/StickyCta.astro';
---

<SsLayout title={ss.seo.title} description={ss.seo.description} stickyCta consentAutoOpen={false}>
  <Header />
  <main id="inhalt">
    <Hero />
    <Alltag />
    <Ursache />
    <Methode />
    <Ergebnisse />
    <Offer />
    <Anfrage />
    <Faq />
    <FinalCta />
  </main>
  <StickyCta />
</SsLayout>
