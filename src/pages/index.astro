---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LeadQuiz from '../components/LeadQuiz.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
import '../styles/ev-system.css';

const faqEntries = [
  { q: 'Was heißt „exklusiv" bei einem Lead?', a: 'Jeder Lead wird nur einmal verkauft — nie gleichzeitig an mehrere Abnehmer in derselben Region. Kein Wettrennen um denselben Kontakt.' },
  { q: 'Was ist die Ersatz-Garantie?', a: 'Hat ein Lead falsche Kontaktdaten oder gar kein echtes Interesse, ersetzen wir ihn kostenlos. Sie zahlen nur für Leads, die wirklich zählen.' },
  { q: 'Muss ich einen langen Vertrag unterschreiben?', a: 'Nein. Sie zahlen pro Lead — kein Retainer, kein Setup, keine Mindestlaufzeit über Jahre. Sie steuern selbst, wie viele Leads Sie abnehmen.' },
  { q: 'Woher kommen die Leads?', a: 'Aus gezielter Ansprache und mehrstufiger Qualifizierung von Unternehmen, die aktiv einen Anbieter wie Sie suchen oder wechseln wollen — passend zu Ihren Kriterien.' },
  { q: 'Für welche Branchen ist das gedacht?', a: 'Schwerpunkt sind Fulfillment-Center und 3PL-/Logistikdienstleister mit freien Kapazitäten. Auf Anfrage prüfen wir auch andere B2B-Branchen mit vergleichbarem Bedarf.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title="Aktuelle, exklusive Leads für Ihr Wachstum — Elevo"
  description="Elevo liefert aktuelle, exklusive und geprüfte Leads — planbar, mit Ersatz-Garantie. Sie zahlen nur pro qualifiziertem Lead. Schwerpunkt: Fulfillment-Center & 3PL."
  canonical="https://elevo.solutions/"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <SiteHeader />

  <main id="main">

    <!-- ===== HERO ===== -->
    <section class="ev-hero" aria-labelledby="hero-heading">
      <div class="container">
        <div class="ev-hero-grid">
          <div class="ev-hero-copy">
            <p class="ev-eyebrow">Lead-Generierung für Unternehmen mit freien Kapazitäten</p>
            <h1 id="hero-heading" class="ev-hero-h1">
              Aktuelle, exklusive Leads.<br>
              Mit <span class="ev-accent">Ersatz-Garantie.</span>
            </h1>
            <p class="ev-hero-sub">
              Wir liefern Ihnen vorqualifizierte Anfragen von Unternehmen, die aktiv einen Anbieter
              wie Sie suchen — jeder Lead exklusiv für Sie, kein Streuverlust. Schwerpunkt aktuell:
              Fulfillment-Center und 3PL-Dienstleister.
            </p>
            <div class="ev-hero-ctas">
              <a href="#kontakt" class="ev-btn ev-btn-primary">
                Leads anfragen
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="#modell" class="ev-btn ev-btn-ghost">Wie das Modell funktioniert</a>
            </div>
            <p class="ev-hero-trust">Pay-per-Lead · exklusiv · kostenloser Ersatz bei Fehltreffern</p>
          </div>

          <aside class="offer-card" aria-label="Das Modell in Kürze">
            <p class="offer-badge">Das Modell in Kürze</p>
            <ul class="offer-list" role="list">
              <li><span class="offer-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Sie zahlen nur pro qualifiziertem Lead — kein Retainer, kein Setup</li>
              <li><span class="offer-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Jeder Lead ist <strong>exklusiv</strong> — nie doppelt verkauft</li>
              <li><span class="offer-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Falsche Daten oder kein Interesse: <strong>kostenloser Ersatz</strong></li>
            </ul>
            <a href="#kontakt" class="ev-btn ev-btn-primary offer-cta">Passende Leads anfragen →</a>
          </aside>
        </div>
      </div>
    </section>

    <!-- ===== MODELL ===== -->
    <section id="modell" class="ev-section ev-section-alt" aria-labelledby="modell-heading">
      <div class="container">
        <p class="ev-eyebrow">Das Modell</p>
        <h2 id="modell-heading" class="ev-h2">Einfach, planbar, ohne Risiko auf Ihrer Seite.</h2>
        <p class="ev-section-sub" style="margin-left:0;">Keine Preisliste hier — im Gespräch legen wir gemeinsam fest, was für Ihre Kapazität und Region passt. Das Prinzip bleibt immer gleich:</p>
        <div class="ev-grid-3" style="margin-top:36px;">
          <div class="model-card">
            <h3>Pay-per-Lead</h3>
            <p>Kein Retainer, kein Setup, keine Mindestabnahme. Sie zahlen ausschließlich für Leads, die Sie tatsächlich erhalten.</p>
          </div>
          <div class="model-card">
            <h3>Exklusiv</h3>
            <p>Jeder Lead wird nur einmal verkauft — nie gleichzeitig an mehrere Abnehmer in derselben Region.</p>
          </div>
          <div class="model-card">
            <h3>Ersatz-Garantie</h3>
            <p>Falsche Kontaktdaten oder kein echtes Interesse: Wir ersetzen den Lead ohne Zusatzkosten.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SO LÄUFT'S ===== -->
    <section class="ev-section" aria-labelledby="steps-heading">
      <div class="container">
        <p class="ev-eyebrow">So arbeiten wir</p>
        <h2 id="steps-heading" class="ev-h2">In drei Schritten zu planbaren Anfragen.</h2>
        <div class="prozess-steps" role="list" style="margin-top:48px;">
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">01</div>
            <h3 class="step-title">Wir klären Ihre Kriterien</h3>
            <p class="step-desc">Volumen, Region, Warenart, Kapazität — kurzes Gespräch, damit jeder Lead wirklich zu Ihnen passt.</p>
          </div>
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">02</div>
            <h3 class="step-title">Wir qualifizieren &amp; liefern</h3>
            <p class="step-desc">Gezielte Ansprache, mehrstufige Qualifizierung — Sie bekommen Entscheider mit echtem, aktuellem Bedarf, nicht anonyme Klicks.</p>
          </div>
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">03</div>
            <h3 class="step-title">Sie zahlen pro Lead</h3>
            <p class="step-desc">Nur für das, was ankommt — exklusiv für Sie, mit kostenlosem Ersatz bei Fehltreffern.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== FÜR WEN ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="fuerwen-heading">
      <div class="container">
        <p class="ev-eyebrow">Für wen</p>
        <h2 id="fuerwen-heading" class="ev-h2">Aktueller Schwerpunkt.</h2>
        <div class="vertical-grid" style="margin-top:36px;">
          <a href="/leads-fulfillmentcenter" class="vertical-card">
            <h3>Fulfillment-Center</h3>
            <p>Freie Lagerflächen und Kapazität, die planbar mit passenden Versendern gefüllt werden sollen.</p>
            <span class="vertical-link">Mehr erfahren →</span>
          </a>
          <a href="/leads-3pl-logistik" class="vertical-card">
            <h3>3PL &amp; Logistikdienstleister</h3>
            <p>Kontraktlogistiker, die planbar neue Vertragspartner statt Zufallsanfragen wollen.</p>
            <span class="vertical-link">Mehr erfahren →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ===== GARANTIE ===== -->
    <section class="ev-section" aria-labelledby="guarantee-heading">
      <div class="container">
        <div class="ev-guarantee">
          <div class="ev-guarantee-ico" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="ev-guarantee-body">
            <p class="ev-eyebrow">Ohne Risiko testen</p>
            <h2 id="guarantee-heading" class="ev-h2">Aktuell, exklusiv, mit Garantie.</h2>
            <p>
              Jeder Lead ist aktuell — keine monatealten Adresslisten — und exklusiv nur für Sie.
              Passt ein Lead nicht (falsche Daten, kein echtes Interesse), ersetzen wir ihn kostenlos.
              Kein Retainer, keine Jahresbindung, kein Risiko auf Ihrer Seite.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="faq-heading">
      <div class="container">
        <p class="ev-eyebrow">Häufige Fragen</p>
        <h2 id="faq-heading" class="ev-h2" style="margin-bottom:32px;">Kurz beantwortet.</h2>
        <div class="faq-list">
          {faqEntries.map(({ q, a }) => (
            <details class="faq-item">
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== QUIZ / KONTAKT ===== -->
    <section id="kontakt" class="ev-section" aria-labelledby="kontakt-heading">
      <div class="container">
        <div class="kontakt-grid">
          <div class="kontakt-intro">
            <p class="ev-eyebrow">In 2 Minuten</p>
            <h2 id="kontakt-heading" class="ev-h2">Passende Leads anfragen.</h2>
            <p class="ev-section-sub" style="margin-left:0;">
              Ein paar kurze Fragen zu Ihrer Situation, dann Ihre Kontaktdaten — wir melden uns mit
              einer Einschätzung, wie viele passende Leads wir für Sie liefern können.
            </p>
            <p class="kontakt-direct">Oder direkt per E-Mail: <a href="mailto:hey@elevo.solutions">hey@elevo.solutions</a></p>
          </div>
          <LeadQuiz />
        </div>
      </div>
    </section>

  </main>

  <SiteFooter />

  <CookieBanner />
</BaseLayout>

<style>
  .offer-card {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 32px 30px;
    align-self: center;
    box-shadow: var(--shadow);
  }
  .offer-badge {
    display: inline-block; background: var(--bg-card-hover); color: var(--accent);
    font-family: var(--font-heading); font-weight: 700; font-size: 0.72rem; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 5px 12px; border-radius: 100px; margin: 0 0 18px;
  }
  .offer-list { list-style: none; margin: 0 0 26px; padding: 0; display: grid; gap: 16px; }
  .offer-list li { display: flex; gap: 12px; align-items: flex-start; color: var(--text-secondary); font-size: 1rem; line-height: 1.45; }
  .offer-list strong { color: var(--text-primary); }
  .offer-check { flex-shrink: 0; width: 24px; height: 24px; border-radius: 7px; background: var(--bg-card-hover); color: var(--accent); display: inline-flex; align-items: center; justify-content: center; margin-top: 1px; }
  .offer-check svg { width: 13px; height: 13px; }
  .offer-cta { width: 100%; justify-content: center; }

  .model-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 28px 26px; }
  .model-card h3 { font-family: var(--font-heading); font-weight: 700; font-size: 1.15rem; color: var(--text-primary); margin: 0 0 10px; }
  .model-card p { color: var(--text-secondary); font-size: 0.96rem; line-height: 1.6; margin: 0; }

  .vertical-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .vertical-card {
    display: block; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg);
    padding: 28px 26px; text-decoration: none; transition: border-color var(--transition), box-shadow var(--transition);
  }
  .vertical-card:hover { border-color: var(--border-strong); box-shadow: var(--shadow-blue); }
  .vertical-card h3 { font-family: var(--font-heading); font-weight: 700; font-size: 1.2rem; color: var(--text-primary); margin: 0 0 10px; }
  .vertical-card p { color: var(--text-secondary); font-size: 0.96rem; line-height: 1.6; margin: 0 0 14px; }
  .vertical-link { color: var(--accent); font-family: var(--font-heading); font-weight: 600; font-size: 0.92rem; }

  .faq-list { display: grid; gap: 14px; max-width: 820px; }
  .faq-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: border-color var(--transition); }
  .faq-item[open] { border-color: var(--border-strong); }
  .faq-item summary {
    cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px 22px; font-family: var(--font-heading); font-weight: 600; font-size: 1.02rem; color: var(--text-primary);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.4rem; color: var(--accent); line-height: 1; flex-shrink: 0; transition: transform var(--transition); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { margin: 0; padding: 0 22px 20px; color: var(--text-secondary); line-height: 1.65; font-size: 0.98rem; }

  .kontakt-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .kontakt-direct { margin-top: 24px; font-size: 0.94rem; color: var(--text-secondary); }
  .kontakt-direct a { color: var(--accent); }

  @media (max-width: 1024px) {
    .vertical-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 900px) {
    .kontakt-grid { grid-template-columns: 1fr; }
  }
</style>
