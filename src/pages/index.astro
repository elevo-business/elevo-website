              <line x1="22" y1="10" x2="22" y2="7"/>
              <line x1="22" y1="34" x2="22" y2="37"/>
              <line x1="10" y1="22" x2="7" y2="22"/>
              <line x1="34" y1="22" x2="37" y2="22"/>
              <circle cx="40" cy="40" r="7"/>
              <circle cx="40" cy="40" r="2.5" fill="currentColor" stroke="none"/>
              <line x1="40" y1="31" x2="40" y2="28"/>
              <line x1="40" y1="49" x2="40" y2="52"/>
