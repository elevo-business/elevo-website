  <script>
    // ----- Live-Vorschau Modal -----
    const modal = document.getElementById('ref-modal') as HTMLElement;
    const frame = document.getElementById('ref-modal-frame') as HTMLIFrameElement;
    const urlDisplay = document.getElementById('ref-modal-url') as HTMLElement;
    const openBtn = document.getElementById('ref-modal-open-btn') as HTMLAnchorElement;
    const closeBtn = document.getElementById('ref-modal-close') as HTMLButtonElement;
    const backdrop = modal?.querySelector('.ref-modal-backdrop') as HTMLElement;

    let lastFocus: HTMLElement | null = null;

    function openModal(url: string, label: string, displayUrl: string) {
      lastFocus = document.activeElement as HTMLElement;
      frame.src = url;
      frame.title = label;
      urlDisplay.textContent = displayUrl;
      openBtn.href = url;
      modal.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => { modal.classList.add('is-open'); });
      closeBtn.focus();
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.addEventListener('transitionend', () => {
        modal.classList.remove('is-visible');
        frame.src = '';
        document.body.style.overflow = '';
        lastFocus?.focus();
      }, { once: true });
    }

    document.querySelectorAll<HTMLElement>('.ref-modal-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.dataset.url!;
        const label = btn.dataset.label!;
        const displayUrl = btn.dataset.displayUrl || url;
        openModal(url, label, displayUrl);
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-visible')) closeModal();
    });

    // ----- Opportunitätskosten-Rechner -----
    const WEEKS_PER_YEAR = 52;
    const AUTOMATION_SAVING = 0.8;      // ~80 % der manuellen Zeit fällt weg
    const HOURS_PER_EXTRA_ORDER = 8;    // konservativ: 8 zurückgewonnene Std. = 1 zusätzlicher Auftrag

    const minEl = document.getElementById('calc-min') as HTMLInputElement;
    const offEl = document.getElementById('calc-offers') as HTMLInputElement;
    const valEl = document.getElementById('calc-value') as HTMLInputElement;
    const minOut = document.getElementById('calc-min-out')!;
    const offOut = document.getElementById('calc-offers-out')!;
    const valOut = document.getElementById('calc-value-out')!;
    const hoursOut = document.getElementById('calc-hours')!;
    const extraOut = document.getElementById('calc-extra')!;
    const revOut = document.getElementById('calc-revenue')!;

    const de = new Intl.NumberFormat('de-DE');

    function paintRange(el: HTMLInputElement) {
      const pct = ((+el.value - +el.min) / (+el.max - +el.min)) * 100;
      el.style.background =
        `linear-gradient(90deg, var(--accent) 0%, var(--accent) ${pct}%, rgba(255,255,255,0.12) ${pct}%, rgba(255,255,255,0.12) 100%)`;
    }

    function updateCalc() {
      const min = +minEl.value, offers = +offEl.value, val = +valEl.value;
      const offersPerYear = offers * WEEKS_PER_YEAR;
      const hoursPerYear = offersPerYear * min / 60;
      const savedHours = hoursPerYear * AUTOMATION_SAVING;
      const extraOrders = Math.round(savedHours / HOURS_PER_EXTRA_ORDER);
      const revenue = extraOrders * val;

      minOut.innerHTML = min + '&nbsp;Min';
      offOut.textContent = String(offers);
      valOut.innerHTML = de.format(val) + '&nbsp;€';
      hoursOut.textContent = de.format(Math.round(hoursPerYear));
      extraOut.textContent = de.format(extraOrders);
      revOut.innerHTML = de.format(revenue) + '&nbsp;€';

      [minEl, offEl, valEl].forEach(paintRange);
    }

    if (minEl && offEl && valEl) {
      [minEl, offEl, valEl].forEach(el => el.addEventListener('input', updateCalc));
      updateCalc();
    }
  </script>
