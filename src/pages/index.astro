---
// Startseite elevo.solutions: die Marketing-Thesis für Familienrecht-Kanzleien als Seite erzählt.
// Reihenfolge = Thesis: Problem → Hypothese → Antithese → Diagnose → Mechanismus → Beweise → Angebot → Formular.
// Texte: src/config/startseite.json, Doku: STARTSEITE.md
import SsLayout from '../startseite/layouts/SsLayout.astro';
import ss from '../config/startseite.json';
import Header from '../startseite/components/Header.astro';
import Hero from '../startseite/components/Hero.astro';
import Hypothesis from '../startseite/components/Hypothesis.astro';
import Antithesis from '../startseite/components/Antithesis.astro';
import Diagnosis from '../startseite/components/Diagnosis.astro';
import Mechanism from '../startseite/components/Mechanism.astro';
import Proof from '../startseite/components/Proof.astro';
import Offer from '../startseite/components/Offer.astro';
import QuizForm from '../startseite/components/QuizForm.astro';
import Fit from '../startseite/components/Fit.astro';
import Faq from '../startseite/components/Faq.astro';
import StickyCta from '../startseite/components/StickyCta.astro';
---

<SsLayout title={ss.seo.title} description={ss.seo.description} stickyCta>
  <Header />
  <main id="inhalt">
    <Hero />
    <Hypothesis />
    <Antithesis />
    <Diagnosis />
    <Mechanism />
    <Proof />
    <Offer />
    <div class="px-4"><QuizForm /></div>
    <Fit />
    <Faq />
  </main>
  <StickyCta />
</SsLayout>
