---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const MAILTO =
  'mailto:hey@elevo.solutions?subject=' +
  encodeURIComponent('Erstgespräch — Leads für unser Fulfillment-Center');

// FAQ-Inhalte synchron mit sichtbarem Markup halten (speist zusätzlich JSON-LD).
const faqEntries = [
  { q: 'Was heißt „exklusiv“ bei einem Lead?', a: 'Jeder Lead wird nur einmal verkauft — nie gleichzeitig an mehrere Anbieter in derselben Region. Kein Wettrennen um denselben Kontakt, kein Preiskampf um die Anfrage.' },
  { q: 'Was ist die Ersatz-Garantie?', a: 'Hat ein Lead falsche Kontaktdaten oder gar kein echtes Interesse, ersetzen wir ihn kostenlos. Sie zahlen nur für Leads, die wirklich zählen.' },
  { q: 'Muss ich einen langen Vertrag unterschreiben?', a: 'Nein. Sie zahlen pro Lead — kein Retainer, kein Setup, keine Mindestlaufzeit. Sie steuern selbst, wie viele Leads Sie abnehmen.' },
  { q: 'Woher kommen die Leads?', a: 'Aus gezielter Ansprache und mehrstufiger Qualifizierung von Unternehmen, die aktiv einen Fulfillment-Partner suchen oder wechseln wollen — passend zu Ihren Kriterien wie Volumen, Region und Warenart.' },
  { q: 'Wie schnell kommen die ersten Leads?', a: 'In der Regel innerhalb der ersten Wochen nach dem Start. Wir beginnen mit einem kurzen Gespräch zu Ihren Kriterien und skalieren dann Schritt für Schritt.' },
  { q: 'Für welche Branchen ist das gedacht?', a: 'Schwerpunkt sind Fulfillment-Center und 3PL-/Logistikdienstleister mit freien Kapazitäten. Auf Anfrage prüfen wir auch andere B2B-Branchen mit vergleichbarem Bedarf.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const tickerItems = [
  'Pay-per-Lead',
  'Exklusiv pro Region',
  'Ersatz-Garantie',
  'Kein Retainer',
  'Entscheider statt Klicks',
  'DACH-weit',
];

const chevron = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>';
---

<BaseLayout
  title="Leadgenerierung für Fulfillment & 3PL — Elevo"
  description="Exklusive, vorqualifizierte Leads für Fulfillment-Center und 3PL-Dienstleister: Pay-per-Lead, kein Retainer, Ersatz-Garantie bei Fehltreffern. Über 200 qualifizierte Leads in 2 Monaten."
  canonical="https://elevo.solutions/"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <Header />

  <main id="main">

    <!-- ===== HERO ===== -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="hero-eyebrow">Lead-Generierung · Fulfillment &amp; 3PL</p>
          <h1 id="hero-heading" class="hero-h1">
            <span class="hero-line"><span class="hero-line-inner">Neue Versender.</span></span>
            <span class="hero-line hero-line--offset"><span class="hero-line-inner hero-line-delay"><em>Planbar</em> geliefert.</span></span>
          </h1>
          <p class="hero-sub">
            Wir liefern Ihnen vorqualifizierte Anfragen von Marken und Onlinehändlern, die aktiv
            einen Fulfillment-Partner wie Sie suchen — jeder Lead exklusiv für Sie, ohne Streuverlust.
          </p>
          <div class="hero-ctas">
            <a href="/kontakt" class="btn btn-primary">
              Erstgespräch vereinbaren
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="#modell" class="btn btn-ghost">Das Modell ansehen</a>
          </div>
          <p class="hero-trust">Pay-per-Lead · Exklusiv pro Region · Ersatz-Garantie</p>
        </div>

        <div class="hero-visual" role="img" aria-label="Schematische Darstellung: Aus vielen Anfragen von Marken und Versendern wird durch Qualifizierung ein exklusiver Lead für Ihren Vertrieb.">
          <svg viewBox="0 0 460 560" fill="none" aria-hidden="true" class="pipeline">
            <text x="230" y="26" text-anchor="middle" class="pl-label">Marken &amp; Versender</text>

            <!-- Quell-Punkte -->
            <circle cx="50" cy="72" r="5" class="pl-dot" />
            <circle cx="140" cy="72" r="5" class="pl-dot" />
            <circle cx="230" cy="72" r="5" class="pl-dot" />
            <circle cx="320" cy="72" r="5" class="pl-dot" />
            <circle cx="410" cy="72" r="5" class="pl-dot" />

            <!-- Zulaufende Linien -->
            <path d="M50 84 C50 170 200 200 224 244" class="pl-line" />
            <path d="M140 84 C140 160 210 195 226 242" class="pl-line" />
            <path d="M230 84 L230 240" class="pl-line" />
            <path d="M320 84 C320 160 250 195 234 242" class="pl-line" />
            <path d="M410 84 C410 170 260 200 236 244" class="pl-line" />

            <!-- Qualifizierungs-Filter -->
            <rect x="206" y="246" width="48" height="48" rx="8" transform="rotate(45 230 270)" class="pl-filter" />
            <text x="230" y="346" text-anchor="middle" class="pl-label">Qualifizierung</text>

            <!-- Abfluss -->
            <path d="M230 300 C230 370 230 400 230 448" class="pl-line pl-line--active" />
            <circle r="4.5" class="pl-travel">
              <animateMotion dur="2.8s" repeatCount="indefinite" path="M230 300 C230 370 230 400 230 448" />
            </circle>

            <!-- Ergebnis-Node -->
            <circle cx="230" cy="472" r="10" class="pl-result-ring" />
            <circle cx="230" cy="472" r="10" class="pl-result-ring pl-result-ring--late" />
            <circle cx="230" cy="472" r="7" class="pl-result" />
            <text x="230" y="512" text-anchor="middle" class="pl-label pl-label--accent">1 exklusiver Lead</text>
            <text x="230" y="540" text-anchor="middle" class="pl-label">Ihr Vertrieb</text>
          </svg>
        </div>
      </div>

      <!-- Stat-Band -->
      <div class="container">
        <dl class="statband">
          <div class="stat">
            <dt class="stat-label">qualifizierte Leads in 2 Monaten</dt>
            <dd class="stat-num">200<span class="stat-plus">+</span></dd>
          </div>
          <div class="stat">
            <dt class="stat-label">wird jeder Lead verkauft</dt>
            <dd class="stat-num">1<span class="stat-plus">×</span></dd>
          </div>
          <div class="stat">
            <dt class="stat-label">Ersatz bei Fehltreffern</dt>
            <dd class="stat-num">100<span class="stat-plus">%</span></dd>
          </div>
          <div class="stat">
            <dt class="stat-label">Retainer &amp; Setup</dt>
            <dd class="stat-num">0</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- ===== TICKER ===== -->
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[...tickerItems, ...tickerItems].map((item) => (
          <span class="ticker-item"><Fragment set:html={chevron} />{item}</span>
        ))}
      </div>
    </div>

    <!-- ===== MANIFEST / WARUM ===== -->
    <section class="section section--line" aria-labelledby="warum-heading">
      <div class="container manifest">
        <p class="kicker"><span class="kicker-num">—</span> Warum Elevo</p>
        <h2 id="warum-heading" class="manifest-statement reveal">
          Auslastung ist kein Zufall.<br>
          <span class="muted">Sie ist ein System.</span>
        </h2>
        <div class="manifest-grid">
          <p class="lead reveal-late">
            Fläche, Technik und Team laufen weiter — ob die Regale voll sind oder nicht.
            Jedes Prozent Leerstand geht direkt von Ihrer Marge ab. Die entscheidende Frage
            ist deshalb nicht, <em>ob</em> Sie neue Versender gewinnen, sondern ob Sie es
            <strong> planbar</strong> tun.
          </p>
          <figure class="manifest-figure reveal-late">
            <img src="/fulfillment/warehouse-aisle.jpg" alt="Symmetrischer Regalgang in einem Fulfillment-Lager mit palettierter Ware" width="1600" height="560" loading="lazy" decoding="async">
          </figure>
        </div>
      </div>
    </section>

    <!-- ===== 01 DAS MODELL ===== -->
    <section id="modell" class="section section--alt section--line" aria-labelledby="modell-heading">
      <div class="container">
        <p class="kicker"><span class="kicker-num">01</span> Das Modell</p>
        <h2 id="modell-heading" class="h2 reveal">Einfach, planbar —<br>ohne Risiko auf Ihrer Seite.</h2>
        <p class="lead reveal-late" style="margin-top: 22px;">
          Keine Preisliste, kein Kleingedrucktes: Im Gespräch legen wir gemeinsam fest, was zu
          Ihrer Kapazität und Region passt. Das Prinzip bleibt immer gleich.
        </p>

        <div class="rows" role="list">
          <article class="row reveal" role="listitem">
            <span class="row-num" aria-hidden="true">01</span>
            <div class="row-body">
              <h3 class="h3">Pay-per-Lead</h3>
              <p>Kein Retainer, kein Setup, keine Mindestabnahme. Sie zahlen ausschließlich für Leads, die tatsächlich bei Ihnen ankommen — nichts sonst.</p>
            </div>
            <span class="row-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></span>
          </article>

          <article class="row reveal" role="listitem">
            <span class="row-num" aria-hidden="true">02</span>
            <div class="row-body">
              <h3 class="h3">Exklusiv</h3>
              <p>Jeder Lead wird nur einmal verkauft — nie gleichzeitig an mehrere Anbieter in derselben Region. Kein Wettrennen um denselben Kontakt.</p>
            </div>
            <span class="row-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></span>
          </article>

          <article class="row reveal" role="listitem">
            <span class="row-num" aria-hidden="true">03</span>
            <div class="row-body">
              <h3 class="h3">Ersatz-Garantie</h3>
              <p>Falsche Kontaktdaten oder kein echtes Interesse: Wir ersetzen den Lead ohne Zusatzkosten. Sie zahlen nur für Leads, die wirklich zählen.</p>
            </div>
            <span class="row-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></span>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== 02 ABLAUF ===== -->
    <section id="ablauf" class="section section--line" aria-labelledby="ablauf-heading">
      <div class="container">
        <p class="kicker"><span class="kicker-num">02</span> So arbeiten wir</p>
        <h2 id="ablauf-heading" class="h2 reveal">In drei Schritten<br>zu vollen Regalen.</h2>

        <div class="steps">
          <article class="step reveal">
            <span class="step-num" aria-hidden="true">01</span>
            <h3 class="h3">Wir klären Ihre Kriterien</h3>
            <p>Volumen, Region, Warenart, Kapazität — ein kurzes Gespräch, damit jeder Lead wirklich zu Ihnen passt.</p>
          </article>
          <article class="step reveal">
            <span class="step-num" aria-hidden="true">02</span>
            <h3 class="h3">Wir qualifizieren &amp; liefern</h3>
            <p>Gezielte Ansprache, mehrstufige Qualifizierung. Sie bekommen Entscheider mit echtem, aktuellem Bedarf — keine anonymen Klicks.</p>
          </article>
          <article class="step reveal">
            <span class="step-num" aria-hidden="true">03</span>
            <h3 class="h3">Sie zahlen pro Lead</h3>
            <p>Nur für das, was ankommt — exklusiv für Sie und mit kostenlosem Ersatz bei Fehltreffern.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== 03 FÜR WEN ===== -->
    <section class="section section--alt section--line" aria-labelledby="fuerven-heading">
      <div class="container">
        <p class="kicker"><span class="kicker-num">03</span> Für wen</p>
        <h2 id="fuerven-heading" class="h2 reveal">Gebaut für Fulfillment.<br><span class="muted">Nichts sonst.</span></h2>

        <div class="fit-grid">
          <div class="fit-col reveal">
            <p class="fit-title fit-title--yes">Passt zu Ihnen, wenn …</p>
            <ul role="list">
              <li>Sie ein Fulfillment-Center mit freier Lagerfläche betreiben</li>
              <li>Sie 3PL- oder Kontraktlogistik-Dienstleister sind</li>
              <li>Sie planbar wachsen statt auf Empfehlungen zu warten</li>
              <li>Sie die Abhängigkeit von wenigen Großkunden senken wollen</li>
            </ul>
          </div>
          <div class="fit-col reveal-late">
            <p class="fit-title fit-title--no">Weniger geeignet, wenn …</p>
            <ul role="list">
              <li>Sie aktuell keine freien Kapazitäten haben</li>
              <li>Sie ausschließlich über Eigenakquise wachsen wollen</li>
              <li>Sie außerhalb von B2B-Logistik arbeiten — andere Branchen prüfen wir auf Anfrage</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== 04 ANSPRECHPARTNER ===== -->
    <section class="section section--line" aria-labelledby="people-heading">
      <div class="container">
        <p class="kicker"><span class="kicker-num">04</span> Ansprechpartner</p>
        <h2 id="people-heading" class="h2 reveal">Kein Callcenter.<br>Menschen, die liefern.</h2>
        <p class="lead reveal-late" style="margin-top: 22px;">Sie haben einen direkten Draht — kein Ticketsystem, keine Warteschleife.</p>

        <div class="people">
          <article class="person reveal">
            <picture>
              <source type="image/webp" srcset="/team/mert-800.webp 1x, /team/mert-1600.webp 2x">
              <img src="/team/mert-1200.jpg" alt="Porträt von Mert Efe Celik, Gründer von Elevo" width="480" height="600" loading="lazy" decoding="async">
            </picture>
            <div class="person-info">
              <h3>Mert Efe Celik</h3>
              <p class="person-role">Gründer · Strategie</p>
              <p class="person-bio">Verantwortlich für Strategie und Zielgruppe: Wer sind die richtigen Versender für Ihre Fläche — und wie erreichen wir sie planbar.</p>
            </div>
          </article>

          <article class="person reveal-late">
            <div class="person-placeholder" aria-hidden="true"><span>BK</span></div>
            <div class="person-info">
              <h3>Bünyamin Korkmaz</h3>
              <p class="person-role">Gründer · Neukundengewinnung</p>
              <p class="person-bio">Ihr direkter Ansprechpartner — von der ersten Anfrage bis zum gelieferten Lead, nah dran an Ihren Kriterien und Zielen.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== 05 FAQ ===== -->
    <section id="faq" class="section section--alt section--line" aria-labelledby="faq-heading">
      <div class="container">
        <p class="kicker"><span class="kicker-num">05</span> Häufige Fragen</p>
        <h2 id="faq-heading" class="h2 reveal">Kurz beantwortet.</h2>
        <div class="faq reveal-late" style="margin-top: 40px;">
          {faqEntries.map(({ q, a }) => (
            <details class="faq-item">
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== FINAL CTA ===== -->
    <section class="section section--line final" aria-labelledby="final-heading">
      <div class="container final-inner">
        <p class="kicker" style="justify-content:center;"><span class="kicker-num">→</span> Kostenlos &amp; unverbindlich</p>
        <h2 id="final-heading" class="h-display reveal">
          Reden wir über Ihre<br><span class="accent">freien Kapazitäten.</span>
        </h2>
        <p class="lead reveal-late" style="margin: 26px auto 0; text-align: center;">
          In einem kurzen Gespräch klären wir Volumen, Region und Warenart — und wie viele
          passende Leads wir für Sie liefern können.
        </p>
        <div class="final-ctas reveal-late">
          <a href="/kontakt" class="btn btn-primary btn-xl">
            Erstgespräch vereinbaren
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <p class="final-note">Oder direkt per E-Mail: <a href={MAILTO} class="u-link">hey@elevo.solutions</a></p>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* ================= HERO ================= */
  .hero {
    padding-top: clamp(56px, 8vw, 104px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 32px;
    align-items: center;
  }
  .hero-copy { grid-column: 1 / 8; }
  .hero-visual { grid-column: 8 / 13; }

  .hero-eyebrow {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 26px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .hero-eyebrow::before {
    content: '';
    width: 34px;
    height: 1px;
    background: var(--accent);
  }

  .hero-h1 {
    font-size: clamp(2.9rem, 7.2vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .hero-line { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .hero-line--offset { padding-left: clamp(36px, 6vw, 110px); }
  .hero-line-inner { display: inline-block; }
  .hero-h1 em { font-style: normal; color: var(--accent); }

  @media (prefers-reduced-motion: no-preference) {
    .hero-line-inner {
      animation: hero-rise 0.9s cubic-bezier(0.22, 0.9, 0.28, 1) both;
    }
    .hero-line-delay { animation-delay: 0.12s; }
  }
  @keyframes hero-rise {
    from { transform: translateY(112%); }
    to { transform: translateY(0); }
  }

  .hero-sub {
    margin: 30px 0 36px;
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
    line-height: 1.65;
    max-width: 54ch;
  }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-trust {
    margin-top: 24px;
    font-size: 0.88rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* Pipeline-Visual */
  .pipeline { width: 100%; height: auto; display: block; }
  .pl-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--text-muted);
  }
  .pl-label--accent { fill: var(--accent); }
  .pl-dot { fill: var(--text-muted); opacity: 0.55; }
  .pl-line {
    stroke: var(--border);
    stroke-width: 1.5;
    stroke-dasharray: 4 8;
    animation: pl-dash 1.4s linear infinite;
  }
  .pl-line--active { stroke: var(--accent); stroke-width: 2; }
  .pl-filter {
    fill: var(--bg-card);
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .pl-travel { fill: var(--accent); }
  .pl-result { fill: var(--accent); }
  .pl-result-ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: pl-pulse 2.6s ease-out infinite;
  }
  .pl-result-ring--late { animation-delay: 1.3s; }

  @keyframes pl-dash { to { stroke-dashoffset: -12; } }
  @keyframes pl-pulse {
    from { transform: scale(1); opacity: 0.7; }
    to { transform: scale(3.2); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pl-line, .pl-result-ring { animation: none; }
    .pl-travel { display: none; }
  }

  /* Stat-Band */
  .statband {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: clamp(56px, 7vw, 88px) 0 0;
    padding: 34px 0;
    border-top: 1px solid var(--border-soft);
  }
  .stat { display: grid; gap: 8px; align-content: start; }
  .stat + .stat { border-left: 1px solid var(--border-soft); padding-left: 32px; }
  .stat-num {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    order: -1;
  }
  .stat-plus { color: var(--accent); }
  .stat-label {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.45;
    max-width: 20ch;
  }

  /* ================= MANIFEST ================= */
  .manifest-statement {
    font-size: clamp(2.2rem, 5.4vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .manifest-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(36px, 5vw, 72px);
    align-items: end;
    margin-top: clamp(40px, 5vw, 64px);
  }
  .manifest-grid .lead em { font-style: normal; color: var(--text-primary); }
  .manifest-grid .lead strong { color: var(--accent); font-weight: 600; }
  .manifest-figure {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
  }
  .manifest-figure img {
    display: block;
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    filter: saturate(0.5) brightness(0.75) contrast(1.05);
  }
  .manifest-figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(61, 214, 192, 0.14), rgba(8, 17, 27, 0.55) 70%);
    mix-blend-mode: screen;
    pointer-events: none;
  }

