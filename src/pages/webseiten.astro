  <script>
    // Live-Showroom: Tabs, Desktop/Handy-Umschalter, iframes erst bei Bedarf laden
    // und die Desktop-Ansicht (1440 px) maßstabsgetreu in den Rahmen skalieren.
    const show = document.querySelector<HTMLElement>('[data-showroom]');
    if (show) {
      const tabs = Array.from(show.querySelectorAll<HTMLButtonElement>('.ws-tab'));
      const panels = Array.from(show.querySelectorAll<HTMLElement>('.ws-panel'));
      const toggles = Array.from(show.querySelectorAll<HTMLButtonElement>('.ws-vt'));
      const DESK_W = 1440;

      const load = (panel: HTMLElement) => {
        panel.querySelectorAll<HTMLIFrameElement>('iframe[data-src]').forEach((f) => {
          if (f.getAttribute('src')) return;
          f.addEventListener('load', () => f.parentElement?.classList.add('is-loaded'), { once: true });
          f.src = f.dataset.src!;
        });
      };

      const fit = (host: HTMLElement) => {
        const s = host.clientWidth / DESK_W;
        if (s > 0) host.style.setProperty('--s', String(s));
      };
      const ro = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target as HTMLElement)));
      show.querySelectorAll<HTMLElement>('[data-scale-host]').forEach((h) => ro.observe(h));

      const activate = (tab: HTMLButtonElement, focus = false) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
        });
        panels.forEach((p) => {
          const on = p.dataset.panel === tab.dataset.tab;
          p.hidden = !on;
          if (on) {
            load(p);
            p.querySelectorAll<HTMLElement>('[data-scale-host]').forEach(fit);
          }
        });
        if (focus) tab.focus();
      };

      tabs.forEach((t, i) => {
        t.addEventListener('click', () => activate(t));
        t.addEventListener('keydown', (e) => {
          const k = e.key;
          let n = -1;
          if (k === 'ArrowRight' || k === 'ArrowDown') n = (i + 1) % tabs.length;
          if (k === 'ArrowLeft' || k === 'ArrowUp') n = (i - 1 + tabs.length) % tabs.length;
          if (k === 'Home') n = 0;
          if (k === 'End') n = tabs.length - 1;
          if (n > -1) { e.preventDefault(); activate(tabs[n], true); }
        });
      });

      toggles.forEach((b) => b.addEventListener('click', () => {
        toggles.forEach((x) => {
          const on = x === b;
          x.classList.toggle('is-on', on);
          x.setAttribute('aria-pressed', String(on));
        });
        show.dataset.view = b.dataset.view;
      }));

      // Erst laden, wenn der Showroom in die Nähe des Viewports kommt.
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          const first = panels.find((p) => !p.hidden);
          if (first) load(first);
          io.disconnect();
        }
      }, { rootMargin: '400px 0px' });
      io.observe(show);
    }
  </script>

