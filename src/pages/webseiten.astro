      .ws-form { animation: ws-form var(--ws-cycle) var(--ws-ease) infinite; }
      .ws-form-prog i { animation: ws-prog var(--ws-cycle) var(--ws-ease) infinite; }
      .ws-field i { animation: ws-type var(--ws-cycle) steps(12, end) infinite; }
      .ws-field + .ws-field i { animation-name: ws-type2; }
      .ws-form-ok { animation: ws-ok var(--ws-cycle) var(--ws-ease) infinite; }
      .ws-toast { animation: ws-toast var(--ws-cycle) var(--ws-ease) infinite; }
    }
    /* Ohne Animation: Endzustand zeigen */
    @media (prefers-reduced-motion: reduce) {
      .ws-l { background: var(--ws-ink); }
      .ws-l-sm, .ws-l-sm2 { background: var(--text-muted); }
      .ws-toast { opacity: 1; transform: none; }
    }

    @keyframes ws-build {
      0%, 3% { background: var(--ws-line); transform: scaleX(0.35); opacity: 0.6; }
      14%, 92% { background: var(--ws-ink); transform: scaleX(1); opacity: 1; }
      100% { background: var(--ws-line); transform: scaleX(0.35); opacity: 0.6; }
    }
    @keyframes ws-build-img {
      0%, 6% { opacity: 0.25; filter: grayscale(1); }
      18%, 92% { opacity: 1; filter: grayscale(0); }
      100% { opacity: 0.25; filter: grayscale(1); }
    }
    @keyframes ws-cta {
      0%, 14% { opacity: 0; transform: translateY(4px); }
      20%, 37% { opacity: 1; transform: none; }
      39% { opacity: 1; transform: scale(0.93); }
      42%, 92% { opacity: 1; transform: none; }
      100% { opacity: 0; }
    }
    /* Cursor A fährt von rechts unten zum Button und klickt */
    @keyframes ws-cursor-a {
      0%, 18% { opacity: 0; transform: translate(260px, 120px); }
      22% { opacity: 1; transform: translate(260px, 120px); }
      36% { opacity: 1; transform: translate(0, 0); }
      38% { transform: scale(0.84); }
      41% { opacity: 1; transform: translate(0, 0); }
      45%, 100% { opacity: 0; transform: translate(6px, 4px); }
    }
    @keyframes ws-ripple-a {
      0%, 37% { opacity: 0; transform: scale(0.3); }
      38% { opacity: 0.9; transform: scale(0.3); }
      46%, 100% { opacity: 0; transform: scale(1.7); }
    }
    /* Cursor B füllt das Formular aus und klickt auf Senden */
    @keyframes ws-cursor-b {
      0%, 50% { opacity: 0; transform: translate(-40px, -70px); }
      54% { opacity: 1; transform: translate(-40px, -70px); }
      64% { opacity: 1; transform: translate(0, 0); }
      66% { transform: scale(0.84); }
      68% { opacity: 1; transform: translate(0, 0); }
      70%, 100% { opacity: 0; }
    }
    @keyframes ws-ripple-b {
      0%, 65% { opacity: 0; transform: scale(0.3); }
      66% { opacity: 0.9; transform: scale(0.3); }
      73%, 100% { opacity: 0; transform: scale(1.7); }
    }
    @keyframes ws-form {
      0%, 40% { opacity: 0; transform: translate(-50%, -40%) scale(0.96); }
      45%, 86% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
      92%, 100% { opacity: 0; transform: translate(-50%, -54%) scale(0.98); }
    }
    @keyframes ws-prog {
      0%, 44% { width: 33%; }
      50% { width: 66%; }
      62%, 100% { width: 100%; }
    }
    @keyframes ws-type {
      0%, 46% { width: 0; }
      53%, 100% { width: 70%; }
    }
    @keyframes ws-type2 {
      0%, 54% { width: 0; }
      61%, 100% { width: 48%; }
    }
    @keyframes ws-ok {
      0%, 67% { opacity: 0; }
      70%, 100% { opacity: 1; }
    }
    @keyframes ws-toast {
      0%, 71% { opacity: 0; transform: translateY(14px) scale(0.98); }
      75%, 95% { opacity: 1; transform: none; }
      100% { opacity: 0; transform: translateY(-6px); }
    }

    /* ---------------------------------------------------------- RECHNUNG */
    .ws-split { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
    .ws-prose p { color: var(--text-secondary); font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.75; margin: 0 0 18px; max-width: 58ch; }
    .ws-prose em { font-style: normal; color: var(--ws-ink); font-weight: 500; }

    .ws-paths { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .ws-path {
      position: relative;
      padding: 22px 20px 22px 52px;
      border-radius: var(--radius);
      border: 1px solid var(--ws-line);
      background: var(--bg-card);
    }
    .ws-path-new { border-color: var(--border-strong); box-shadow: var(--shadow-blue); }
    .ws-path-label {
      font-family: var(--font-heading);
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--text-muted);
      margin: 0 0 16px -32px;
    }
    .ws-path-new .ws-path-label { color: var(--accent); }
    .ws-path ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; height: calc(100% - 34px); justify-content: space-between; min-height: 260px; }
    .ws-path li { position: relative; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.4; padding: 4px 0; }
    .ws-path li::before {
      content: '';
      position: absolute; left: -38px; top: 50%;
      width: 12px; height: 12px; margin-top: -6px;
      border-radius: 50%;
      background: var(--bg-card);
      border: 2px solid var(--text-muted);
      z-index: 1;
    }
    .ws-path-new li::before { border-color: var(--accent); }
    .ws-path li.ws-lost { color: var(--ws-warn); font-weight: 500; }
    .ws-path li.ws-lost::before { border-color: var(--ws-warn); background: var(--ws-warn); }
    .ws-path li.ws-won { color: var(--ws-ink); font-weight: 600; }
    .ws-path li.ws-won::before { background: var(--ws-ok); border-color: var(--ws-ok); box-shadow: 0 0 0 5px rgba(22, 163, 74, 0.15); }
    .ws-path-line {
      position: absolute;
      left: 14px; top: 56px; bottom: 26px;
      width: 24px; height: calc(100% - 82px);
      overflow: visible;
    }
    .ws-path-line path {
      fill: none;
      stroke-width: 2;
      vector-effect: non-scaling-stroke;
      stroke-linecap: round;
      stroke-dasharray: 600;
      stroke-dashoffset: 600;
      transition: stroke-dashoffset 1.8s var(--ws-ease) 0.3s;
    }
    .ws-path-old .ws-path-line path { stroke: var(--text-muted); stroke-dasharray: 4 6; stroke-dashoffset: 0; opacity: 0; transition: opacity 1s ease 0.4s; }
    .ws-path-new .ws-path-line path { stroke: var(--accent); stroke-width: 2.5; }
    .ws-paths.visible .ws-path-line path { stroke-dashoffset: 0; }
    .ws-paths.visible .ws-path-old .ws-path-line path { opacity: 0.8; }

    /* ---------------------------------------------------------- MEHRWERTE */
    .ws-values { display: grid; grid-template-columns: 1fr; gap: 20px; }
    .ws-value {
      padding: 22px 22px 26px;
      border: 1px solid var(--ws-line);
      border-radius: var(--radius-lg);
      background: var(--bg-card);
      transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
    }
    .ws-value:hover { border-color: var(--border-strong); box-shadow: var(--shadow); }
    .ws-value h3 {
      font-family: var(--font-heading);
      font-size: 1.12rem; font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.3;
      color: var(--ws-ink);
      margin: 22px 0 10px;
    }
    .ws-value p { font-size: 0.95rem; line-height: 1.65; color: var(--text-secondary); margin: 0; }

    .ws-vis {
      position: relative;
      height: 150px;
      border-radius: var(--radius);
      background:
        linear-gradient(to right, rgba(10,12,16,0.035) 1px, transparent 1px) 0 0 / 20px 20px,
        linear-gradient(to bottom, rgba(10,12,16,0.035) 1px, transparent 1px) 0 0 / 20px 20px,
        var(--bg-alt);
      border: 1px solid var(--ws-line);
      display: grid; place-items: center;
      overflow: hidden;
    }

    /* Formular-Vis */
    .ws-mini-card { width: 74%; padding: 14px; border-radius: 12px; background: var(--bg-card); border: 1px solid var(--ws-line); box-shadow: var(--shadow-sm); }
    .ws-mini-steps { display: flex; gap: 4px; margin-bottom: 12px; }
    .ws-mini-steps i { flex: 1; height: 4px; border-radius: 2px; background: var(--ws-line); transition: background 0.5s var(--ws-ease) 0.1s; }
    .ws-mini-steps i.on { background: var(--accent); }
    .ws-mini-q { display: block; width: 66%; height: 8px; border-radius: 4px; background: var(--ws-ink); margin-bottom: 12px; }
    .ws-mini-opts { display: flex; flex-wrap: wrap; gap: 6px; }
    .ws-mini-opts span { font-size: 0.68rem; padding: 4px 9px; border-radius: 999px; border: 1px solid var(--ws-line); color: var(--text-secondary); transition: all var(--transition); }
    .ws-mini-opts span.sel { border-color: var(--accent); background: var(--ws-soft); color: var(--accent); font-weight: 500; }
    .ws-value:hover .ws-mini-steps i:last-child { background: var(--accent); }

    /* Uhr-Vis */
    .ws-vis-clock { grid-template-columns: auto 1fr; gap: 18px; padding: 0 20px; justify-items: start; }
    .ws-clock { position: relative; width: 74px; height: 74px; border-radius: 50%; background: var(--bg-card); border: 2px solid var(--ws-ink); }
    .ws-clock::after { content: ''; position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; margin: -3px; border-radius: 50%; background: var(--accent); }
    .ws-clock i { position: absolute; left: 50%; bottom: 50%; width: 2px; margin-left: -1px; background: var(--ws-ink); border-radius: 2px; transform-origin: bottom center; }
    .ws-clock .h { height: 20px; transform: rotate(-60deg); }
    .ws-clock .m { height: 28px; transform: rotate(150deg); background: var(--accent); }
    @media (prefers-reduced-motion: no-preference) {
      .ws-clock .m { animation: ws-spin 12s linear infinite; }
      .ws-clock .h { animation: ws-spin 144s linear infinite; }
    }
    @keyframes ws-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .ws-notes { display: flex; flex-direction: column; gap: 6px; width: 100%; }
    .ws-notes span {
      display: block;
      font-size: 0.7rem; color: var(--text-secondary);
      padding: 6px 9px;
      border-radius: 8px;
      background: var(--bg-card);
      border: 1px solid var(--ws-line);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      transition: transform var(--transition), border-color var(--transition);
    }
    .ws-notes b { font-weight: 600; color: var(--accent); margin-right: 4px; font-variant-numeric: tabular-nums; }
    .ws-value:hover .ws-notes span:last-child { border-color: var(--border-strong); transform: translateX(4px); }

    /* Briefing-Vis */
    .ws-brief { width: 76%; padding: 10px 14px; border-radius: 12px; background: var(--bg-card); border: 1px solid var(--ws-line); box-shadow: var(--shadow-sm); }
    .ws-brief p { display: flex; justify-content: space-between; gap: 10px; margin: 0; padding: 5px 0; font-size: 0.72rem; border-bottom: 1px dashed var(--ws-line); }
    .ws-brief p:last-child { border-bottom: 0; }
    .ws-brief span { color: var(--text-muted); }
    .ws-brief b { color: var(--ws-ink); font-weight: 600; }

    /* Vertrauen-Vis */
    .ws-vis-trust { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 8px; padding: 0 26px; }
    .ws-stars { display: flex; gap: 3px; margin-bottom: 4px; }
    .ws-stars i {
      width: 16px; height: 16px;
      background: #F5B300;
      clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
      transition: transform 0.35s var(--ws-ease);
    }
    .ws-value:hover .ws-stars i { transform: scale(1.15); }
    .ws-value:hover .ws-stars i:nth-child(2) { transition-delay: 0.04s; }
    .ws-value:hover .ws-stars i:nth-child(3) { transition-delay: 0.08s; }
    .ws-value:hover .ws-stars i:nth-child(4) { transition-delay: 0.12s; }
    .ws-value:hover .ws-stars i:nth-child(5) { transition-delay: 0.16s; }
    .ws-quote-l { display: block; width: 88%; height: 7px; border-radius: 4px; background: var(--text-muted); opacity: 0.5; }
    .ws-quote-l.short { width: 60%; }
    .ws-avatars { display: flex; align-items: center; margin-top: 8px; }
    .ws-avatars i { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--bg-alt); margin-right: -8px; background: linear-gradient(135deg, #CBD5E1, #94A3B8); }
    .ws-avatars i:nth-child(2) { background: linear-gradient(135deg, #BFDBFE, #60A5FA); }
    .ws-avatars i:nth-child(3) { background: linear-gradient(135deg, #FDE68A, #F59E0B); }
    .ws-avatars em { font-style: normal; font-size: 0.7rem; font-weight: 600; color: var(--text-secondary); margin-left: 16px; }

    /* Handy-Vis */
    .ws-phone-mini {
      position: relative;
      width: 82px; height: 160px;
      margin-top: 34px;
      padding: 14px 9px;
      border-radius: 16px;
      border: 2px solid var(--ws-ink);
      background: var(--bg-card);
      display: flex; flex-direction: column; gap: 6px;
    }
    .ws-pm-l { height: 6px; width: 90%; border-radius: 3px; background: var(--ws-ink); }
    .ws-pm-l.s { width: 60%; background: var(--text-muted); opacity: 0.6; }
    .ws-pm-img { height: 34px; border-radius: 6px; background: linear-gradient(160deg, #DCE6FB, #7FA2EE); margin-top: 2px; }
    .ws-pm-btn { position: absolute; left: 9px; right: 9px; top: 82px; height: 16px; border-radius: 999px; background: var(--accent); }
    .ws-thumb-zone {
      position: absolute;
      left: -22px; right: -30px; top: 56px;
      height: 110px;
      border-radius: 50% 50% 0 0;
      background: radial-gradient(ellipse at 70% 100%, rgba(37, 99, 235, 0.22), transparent 70%);
      transition: opacity var(--transition);
      opacity: 0.7;
    }
    .ws-value:hover .ws-thumb-zone { opacity: 1; }

    /* Such-Vis */
    .ws-serp { width: 80%; display: flex; flex-direction: column; gap: 8px; }
    .ws-serp-bar {
      display: flex; align-items: center; gap: 7px;
      padding: 6px 12px;
      border-radius: 999px;
      background: var(--bg-card);
      border: 1px solid var(--ws-line);
      font-size: 0.72rem; color: var(--text-secondary);
      box-shadow: var(--shadow-sm);
      margin-bottom: 2px;
    }
    .ws-serp-hit { padding: 6px 10px; border-radius: 8px; display: flex; flex-direction: column; gap: 4px; }
    .ws-serp-hit .t { height: 6px; width: 54%; border-radius: 3px; background: var(--text-muted); opacity: 0.45; }
    .ws-serp-hit .d { height: 4px; width: 84%; border-radius: 3px; background: var(--text-muted); opacity: 0.25; }
    .ws-serp-hit.you { background: var(--bg-card); border: 1px solid var(--border-strong); transition: transform var(--transition); }
    .ws-serp-hit.you .t { background: var(--accent); opacity: 1; }
    .ws-value:hover .ws-serp-hit.you { transform: translateX(4px); }

    /* ---------------------------------------------------------- SHOWROOM */
    .ws-show { display: grid; grid-template-columns: 1fr; gap: 18px; }
    .ws-tabs {
      display: flex; gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 2px;
      margin: 0 -2px;
    }
    .ws-tabs::-webkit-scrollbar { display: none; }
    .ws-tab {
      flex: 1 0 auto;
      display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
      padding: 12px 18px;
      border-radius: 12px;
      border: 1px solid var(--ws-line);
      background: var(--bg-card);
      text-align: left;
      transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
    }
    .ws-tab:hover { border-color: var(--border-strong); }
    .ws-tab[aria-selected="true"] { border-color: var(--accent); box-shadow: 0 0 0 3px var(--ws-soft); }
    .ws-tab-name { font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; color: var(--ws-ink); }
    .ws-tab-sector { font-size: 0.76rem; color: var(--text-muted); white-space: nowrap; }

    .ws-view-toggle {
      justify-self: start;
      display: none;
      padding: 4px;
      gap: 4px;
      border-radius: 999px;
      background: var(--bg-card);
      border: 1px solid var(--ws-line);
    }
    .ws-vt {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 7px 14px;
      border-radius: 999px;
      font-size: 0.82rem; font-weight: 500;
      color: var(--text-secondary);
      transition: background var(--transition), color var(--transition);
    }
    .ws-vt.is-on { background: var(--ws-ink); color: #fff; }

    .ws-panel { display: grid; grid-template-columns: 1fr; gap: 28px; }
    .ws-panel[hidden] { display: none; }
    .ws-devices { position: relative; }

    .ws-desk {
      display: none;
      border-radius: 14px;
      border: 1px solid var(--border-strong);
      background: var(--bg-card);
      box-shadow: var(--shadow-lg);
      overflow: hidden;
    }
    .ws-desk-bar {
      display: flex; align-items: center; gap: 12px;
      padding: 10px 14px;
      background: var(--bg-alt);
      border-bottom: 1px solid var(--ws-line);
    }
    .ws-desk-url {
      flex: 1;
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      max-width: 340px; margin: 0 auto;
      padding: 5px 14px;
      border-radius: 999px;
      background: var(--bg-card);
      border: 1px solid var(--ws-line);
      font-size: 0.78rem; color: var(--text-secondary);
    }
    .ws-desk-url svg { color: var(--ws-ok); }
    .ws-desk-open {
      width: 30px; height: 30px;
      display: grid; place-items: center;
      border-radius: 8px;
      color: var(--text-secondary);
      border: 1px solid var(--ws-line);
      transition: color var(--transition), border-color var(--transition);
    }
    .ws-desk-open:hover { color: var(--accent); border-color: var(--accent); }
    .ws-desk-view {
      --s: 0.6;
      position: relative;
      height: clamp(420px, 52vw, 640px);
      overflow: hidden;
      background: var(--bg-alt);
    }
    .ws-desk-view iframe {
      position: absolute; left: 0; top: 0;
      width: 1440px;
      height: calc(100% / var(--s));
      border: 0;
      transform: scale(var(--s));
      transform-origin: 0 0;
      background: #fff;
    }

    .ws-mob {
      position: relative;
      width: min(100%, 360px);
      margin: 0 auto;
      padding: 12px;
      border-radius: 44px;
      background: #0A0C10;
      box-shadow: var(--shadow-lg), inset 0 0 0 2px #2A2F38;
    }
    .ws-mob-notch {
      position: absolute; left: 50%; top: 20px;
      width: 92px; height: 24px; margin-left: -46px;
      border-radius: 999px;
      background: #0A0C10;
      z-index: 2;
    }
    .ws-mob-view {
      position: relative;
      height: min(680px, 72vh);
      border-radius: 32px;
      overflow: hidden;
      background: var(--bg-alt);
    }
    .ws-mob-view iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #fff; }

    .ws-loading {
      position: absolute; inset: 0;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
      font-size: 0.82rem; color: var(--text-muted);
      background: var(--bg-alt);
      pointer-events: none;
      transition: opacity 0.4s ease;
    }
    .ws-loading i {
      width: 120px; height: 3px;
      border-radius: 3px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent) 0 0 / 50% 100% no-repeat, var(--ws-line);
    }
    @media (prefers-reduced-motion: no-preference) {
      .ws-loading i { animation: ws-load 1.2s ease-in-out infinite; }
    }
    @keyframes ws-load { from { background-position: -100% 0, 0 0; } to { background-position: 200% 0, 0 0; } }
    .is-loaded > .ws-loading { opacity: 0; }

    .ws-case {
      align-self: start;
      padding: 26px 24px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--ws-line);
      background: var(--bg-card);
    }
    .ws-case-head h3 { font-family: var(--font-heading); font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; color: var(--ws-ink); margin: 12px 0 2px; }
    .ws-case-sector { margin: 0; font-size: 0.9rem; color: var(--text-muted); }
    .ws-badge {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.04em;
      background: var(--bg-alt);
      color: var(--text-secondary);
      border: 1px solid var(--ws-line);
    }
    .ws-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--text-muted); }
    .ws-badge.is-live { color: var(--ws-ok); border-color: rgba(22, 163, 74, 0.3); background: rgba(22, 163, 74, 0.06); }
    .ws-badge.is-live::before { background: var(--ws-ok); }
    .ws-case-task { margin: 20px 0 18px; padding: 14px 16px; border-radius: 12px; background: var(--bg-alt); font-size: 0.95rem; line-height: 1.6; color: var(--ws-ink); }
    .ws-case-task span { display: block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }
    .ws-case-points { display: flex; flex-direction: column; gap: 10px; margin: 0 0 22px; }
    .ws-case-points li { position: relative; padding-left: 22px; font-size: 0.93rem; line-height: 1.55; color: var(--text-secondary); }
    .ws-case-points li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 10px; height: 2px; background: var(--accent); }
    .ws-case-link { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 0.92rem; color: var(--accent); }
    .ws-case-link:hover { text-decoration: underline; text-underline-offset: 3px; }

    /* ---------------------------------------------------------- ANATOMIE */
    .ws-anatomy { display: grid; grid-template-columns: 1fr; gap: 36px; align-items: start; }
    .ws-wire {
      border-radius: 14px;
      border: 1px solid var(--ws-line);
      background: var(--bg-card);
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .ws-wire-bar { padding: 10px 14px; background: var(--bg-alt); border-bottom: 1px solid var(--ws-line); }
    .ws-wire-body { padding: 18px; display: flex; flex-direction: column; gap: 12px; }
    .ws-zone {
      position: relative;
      display: flex; flex-direction: column; gap: 8px;
      padding: 16px 16px 16px 46px;
      border-radius: 10px;
      border: 1.5px dashed var(--ws-line);
      transition: border-color var(--transition), background var(--transition);
    }
    .ws-zone i { display: block; height: 8px; border-radius: 4px; background: var(--ws-line); }
    .ws-zone .w70 { width: 70%; height: 12px; background: var(--ws-ink); opacity: 0.85; }
    .ws-zone .w60 { width: 60%; }
    .ws-zone .w45 { width: 45%; }
    .ws-zone .w30 { width: 30%; }
    .ws-zone .btn { height: 20px; border-radius: 999px; background: var(--accent); opacity: 0.85; }
    .ws-zone-row { flex-direction: row; gap: 10px; }
    .ws-zone-row b { flex: 1; height: 22px; border-radius: 6px; background: var(--bg-alt); border: 1px solid var(--ws-line); }
    .ws-zone-cols { flex-direction: row; gap: 10px; }
    .ws-zone-cols u { flex: 1; height: 46px; border-radius: 8px; background: var(--bg-alt); border: 1px solid var(--ws-line); }
    .ws-pin {
      position: absolute; left: 12px; top: 50%;
      width: 24px; height: 24px; margin-top: -12px;
      display: grid; place-items: center;
      border-radius: 50%;
      background: var(--bg-card);
      border: 1.5px solid var(--ws-ink);
      font-family: var(--font-heading); font-size: 0.72rem; font-weight: 700;
      color: var(--ws-ink);
      transition: background var(--transition), color var(--transition), border-color var(--transition);
    }

    .ws-anat-list { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; list-style: none; }
    .ws-anat {
      display: flex; gap: 16px;
      padding: 16px 18px;
      border-radius: var(--radius);
      border: 1px solid transparent;
      cursor: default;
      transition: background var(--transition), border-color var(--transition);
      outline: none;
    }
    .ws-anat:hover, .ws-anat:focus-visible { background: var(--bg-card); border-color: var(--border-strong); }
    .ws-anat-n {
      flex-shrink: 0;
      width: 30px; height: 30px;
      display: grid; place-items: center;
      border-radius: 50%;
      border: 1.5px solid var(--ws-line);
      font-family: var(--font-heading); font-weight: 700; font-size: 0.82rem;
      color: var(--text-secondary);
      transition: all var(--transition);
    }
    .ws-anat:hover .ws-anat-n, .ws-anat:focus-visible .ws-anat-n { background: var(--accent); border-color: var(--accent); color: #fff; }
    .ws-anat h3 { font-family: var(--font-heading); font-size: 1.02rem; font-weight: 700; color: var(--ws-ink); margin: 3px 0 6px; line-height: 1.35; }
    .ws-anat p { margin: 0; font-size: 0.93rem; line-height: 1.6; color: var(--text-secondary); }

    /* Hover in der Liste hebt die passende Zone im Wireframe hervor */
    .ws-anatomy:has(.ws-anat[data-k="1"]:is(:hover, :focus-visible)) .ws-zone[data-k="1"],
    .ws-anatomy:has(.ws-anat[data-k="2"]:is(:hover, :focus-visible)) .ws-zone[data-k="2"],
    .ws-anatomy:has(.ws-anat[data-k="3"]:is(:hover, :focus-visible)) .ws-zone[data-k="3"],
    .ws-anatomy:has(.ws-anat[data-k="4"]:is(:hover, :focus-visible)) .ws-zone[data-k="4"],
    .ws-anatomy:has(.ws-anat[data-k="5"]:is(:hover, :focus-visible)) .ws-zone[data-k="5"] {
      border-color: var(--accent);
      border-style: solid;
      background: var(--ws-soft);
    }
    .ws-anatomy:has(.ws-anat[data-k="1"]:is(:hover, :focus-visible)) .ws-zone[data-k="1"] .ws-pin,
    .ws-anatomy:has(.ws-anat[data-k="2"]:is(:hover, :focus-visible)) .ws-zone[data-k="2"] .ws-pin,
    .ws-anatomy:has(.ws-anat[data-k="3"]:is(:hover, :focus-visible)) .ws-zone[data-k="3"] .ws-pin,
    .ws-anatomy:has(.ws-anat[data-k="4"]:is(:hover, :focus-visible)) .ws-zone[data-k="4"] .ws-pin,
    .ws-anatomy:has(.ws-anat[data-k="5"]:is(:hover, :focus-visible)) .ws-zone[data-k="5"] .ws-pin {
      background: var(--accent); border-color: var(--accent); color: #fff;
    }

    /* ---------------------------------------------------------- ABLAUF */
    .ws-process {
      position: relative;
      display: grid; grid-template-columns: 1fr; gap: 16px;
      list-style: none; margin: 0; padding: 0;
    }
    .ws-process li {
      position: relative;
      padding: 24px 22px;
      border-radius: var(--radius-lg);
      background: var(--bg-card);
      border: 1px solid var(--ws-line);
    }
    .ws-proc-ico {
      width: 44px; height: 44px;
      display: grid; place-items: center;
      border-radius: 12px;
      background: var(--bg-alt);
      border: 1px solid var(--ws-line);
      color: var(--ws-ink);
      margin-bottom: 18px;
      position: relative; z-index: 1;
    }
    .ws-proc-live { background: rgba(22, 163, 74, 0.08); border-color: rgba(22, 163, 74, 0.3); }
    .ws-proc-n { display: block; font-family: var(--font-heading); font-size: 0.75rem; font-weight: 700; color: var(--accent); letter-spacing: 0.1em; margin-bottom: 6px; }
    .ws-process h3 { font-family: var(--font-heading); font-size: 1.08rem; font-weight: 700; color: var(--ws-ink); margin: 0 0 8px; }
    .ws-process p { margin: 0; font-size: 0.93rem; line-height: 1.6; color: var(--text-secondary); }

    /* ---------------------------------------------------------- FAQ */
    .ws-faq-wrap { display: grid; grid-template-columns: 1fr; gap: 24px; }
    .ws-faq { border-top: 1px solid var(--ws-line); }
    .ws-faq-item { border-bottom: 1px solid var(--ws-line); }
    .ws-faq-item summary {
      list-style: none;
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
      padding: 22px 0;
      cursor: pointer;
      font-family: var(--font-heading);
      font-size: 1.05rem; font-weight: 600;
      color: var(--ws-ink);
    }
    .ws-faq-item summary::-webkit-details-marker { display: none; }
    .ws-faq-plus { position: relative; flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--ws-line); transition: transform var(--transition), background var(--transition), border-color var(--transition); }
    .ws-faq-plus::before, .ws-faq-plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; margin: -0.75px 0 0 -5px; background: var(--ws-ink); transition: transform var(--transition); }
    .ws-faq-plus::after { transform: rotate(90deg); }
    .ws-faq-item[open] .ws-faq-plus { background: var(--ws-ink); border-color: var(--ws-ink); }
    .ws-faq-item[open] .ws-faq-plus::before, .ws-faq-item[open] .ws-faq-plus::after { background: #fff; }
    .ws-faq-item[open] .ws-faq-plus::after { transform: rotate(0deg); }
    .ws-faq-item p { margin: 0 0 24px; max-width: 64ch; font-size: 0.98rem; line-height: 1.7; color: var(--text-secondary); }

    .ws-final .ev-final-sub { max-width: 58ch; margin-left: auto; margin-right: auto; }

    /* ---------------------------------------------------------- BREAKPOINTS */
    @media (max-width: 767px) {
      .ws-paths { grid-template-columns: 1fr; }
      .ws-path ol { min-height: 0; gap: 14px; }
      .ws-path-new ol { min-height: 0; }
      .ws-tag-time { left: 4px; }
      .ws-toast { right: 4px; }
    }

    @media (min-width: 768px) {
      .ws-values { grid-template-columns: repeat(2, 1fr); }
      .ws-process { grid-template-columns: repeat(2, 1fr); }
      .ws-view-toggle { display: inline-flex; }
      .ws-tab { flex: 1 1 0; }

      /* Desktop/Handy-Umschalter (Tablet) */
      .ws-show:not([data-view="mobile"]) .ws-desk { display: block; }
      .ws-show:not([data-view="mobile"]) .ws-mob { display: none; }
    }

    @media (min-width: 1024px) {
      .ws-hero-grid { grid-template-columns: 1.12fr 0.88fr; gap: 56px; }
      .ws-stage { margin-right: 0; }
      .ws-split { grid-template-columns: 1fr 1fr; gap: 72px; }
      .ws-values { grid-template-columns: repeat(3, 1fr); }
      .ws-anatomy { grid-template-columns: 0.95fr 1.05fr; gap: 56px; }
      .ws-wire { position: sticky; top: 110px; }
      .ws-process { grid-template-columns: repeat(4, 1fr); gap: 20px; }
      .ws-process::before {
        content: '';
        position: absolute;
        left: 44px; right: 44px; top: 46px;
        height: 2px;
        background: linear-gradient(90deg, var(--accent) 0 var(--ws-prog, 0%), var(--ws-line) var(--ws-prog, 0%));
        transition: --ws-prog 1.6s var(--ws-ease) 0.3s;
      }
      .ws-process.visible { --ws-prog: 100%; }
      .ws-faq-wrap { grid-template-columns: 0.8fr 1.2fr; gap: 64px; }

      .ws-panel { grid-template-columns: minmax(0, 1fr) 320px; align-items: start; }
      .ws-show:not([data-view="mobile"]) .ws-desk { display: block; }
      /* Auf großen Bildschirmen: Desktop-Rahmen mit Handy davor, wie im Studio */
      .ws-show:not([data-view="mobile"]) .ws-devices { padding-right: 70px; padding-bottom: 40px; }
      .ws-show:not([data-view="mobile"]) .ws-mob {
        display: block;
        position: absolute;
        right: 0; bottom: 0;
        width: 210px;
        padding: 8px;
        border-radius: 32px;
      }
      .ws-show:not([data-view="mobile"]) .ws-mob-notch { top: 14px; width: 60px; height: 16px; margin-left: -30px; }
      .ws-show:not([data-view="mobile"]) .ws-mob-view { height: 420px; border-radius: 25px; }
    }
  </style>

  <style is:global>
    /* Registrierte Property, damit der Fortschrittsbalken im Ablauf animiert. */
    @property --ws-prog { syntax: '<percentage>'; inherits: true; initial-value: 0%; }
  </style>
</BaseLayout>
