---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/ev-system.css';
import '../styles/rx-theme.css';

// Referenzprojekte für den Live-Showroom. `src` wird im iframe geladen,
// `domain` steht in der Adresszeile. Die Seiten müssen das Einbetten von
// elevo.solutions erlauben (frame-ancestors), sonst bleibt das Fenster leer;
// der Link „In neuem Tab öffnen" funktioniert in jedem Fall.
const projects = [
  {
    id: 'greenchild',
    name: 'Greenchild',
    domain: 'greenchild.eu',
    src: 'https://greenchild-preview.elevo.solutions/de/',
    sector: 'Sachwert-Investment',
    status: 'Live',
    task: 'Ein erklärungsbedürftiges Investment so zeigen, dass aus Neugier ein Beratungsgespräch wird.',
    points: [
      'Fünf qualifizierte Anfragen in der ersten Woche, vorher keine',
      'Anfrageformular mit Telefon-Bestätigung: keine Fake-Kontakte im Vertrieb',
      'Dreisprachig und mit eigenen Landingpages für jede Kampagne',
    ],
  },
  {
    id: 'amelner',
    name: 'Amelner',
    domain: 'amelner.de',
    src: 'https://amelner.de/',
    sector: 'Likör-Manufaktur seit 1901',
    status: 'Live',
    task: 'Über hundert Jahre Familiengeschichte erzählen, ohne dass die Bestellung darunter verschwindet.',
    points: [
      'Bestellung und Händleranfrage sind von jeder Seite aus einen Klick entfernt',
      'Herkunft, Rezeptur und Chronik als Geschichte, die man zu Ende liest',
      'Eigene Seite für Händler, damit Großanfragen nicht im Postfach landen',
    ],
  },
  {
    id: 'dina',
    name: 'Dina Römgens',
    domain: 'dina-roemgens.com',
    src: 'https://dinaroemgens-preview.elevo.solutions/',
    sector: 'Burnout-Coaching',
    status: 'Live',
    task: 'Menschen in der Erschöpfung abholen, die zu müde sind, um sich durch lange Texte zu arbeiten.',
    points: [
      'Symptom-Check als leiser Einstieg, bevor jemand zum Telefon greifen muss',
      'Ruhige Gestaltung, die Vertrauen schafft statt Druck',
      'Mehr Klienten bei gleicher Anzahl an Anfragen',
    ],
  },
  {
    id: 'sina',
    name: 'Sina Bachmann',
    domain: 'sinabachmann.de',
    src: 'https://sinabachmann-preview.elevo.solutions/',
    sector: 'Coaching für Frauen in Führung',
    status: 'Relaunch',
    task: 'Den vertrauten Auftritt behalten und dahinter eine Seite bauen, die Gespräche verlässlich anstößt.',
    points: [
      'Antreiber-Check, der Besucherinnen ins Gespräch bringt, bevor sie gehen',
      'Klare Wege für Einzelcoaching, Unternehmen und Academy',
      'Bestehendes Design übernommen, Technik und Struktur komplett neu',
    ],
  },
];

const faqs = [
  {
    q: 'Was kostet eine Website bei euch?',
    a: 'Das hängt davon ab, was die Seite leisten soll: eine Seite für ein Angebot ist ein anderes Projekt als ein mehrsprachiger Auftritt mit Shop-Anbindung. Im Strategie-Gespräch klären wir den Umfang, danach bekommst du einen Festpreis. Was vereinbart ist, ändert sich nicht mehr.',
  },
  {
    q: 'Muss ich die Texte selbst schreiben?',
    a: 'Nein. Wir schreiben die Texte mit dir zusammen. Du lieferst das Wissen über dein Angebot und deine Kunden, wir machen daraus Sätze, die gelesen werden und zur Anfrage führen. Texte sind bei uns kein Füllmaterial, sondern der Teil der Seite, der verkauft.',
  },
  {
    q: 'Ich habe schon eine Website. Lohnt sich ein Neubau?',
    a: 'Nicht immer. Manchmal reicht es, den Weg zur Anfrage neu zu bauen und das Erscheinungsbild zu behalten, so wie bei Sina Bachmann. Im Gespräch sehen wir uns deine bestehende Seite an und sagen dir ehrlich, was sich lohnt und was nicht.',
  },
  {
    q: 'Wie lange dauert es, bis die Seite online ist?',
    a: 'In der Regel zwei bis drei Wochen ab dem Moment, in dem alle Inhalte da sind. Den Termin legen wir vor dem Start fest. Hosting und laufende Pflege übernehmen wir auf Wunsch, damit du dich nicht um Technik kümmern musst.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Webseiten, die Anfragen bringen',
  serviceType: 'Webdesign und Website-Entwicklung',
  url: 'https://elevo.solutions/webseiten',
  areaServed: ['DE', 'AT', 'CH'],
  provider: {
    '@type': 'LocalBusiness',
    name: 'ELEVO Solutions',
    url: 'https://elevo.solutions',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Ahrstraße 6',
      postalCode: '52511',
      addressLocality: 'Geilenkirchen',
      addressCountry: 'DE',
    },
  },
  description:
    'Individuell gebaute Websites mit Texten, die verkaufen, und einem Anfrageweg ohne Hürden. Damit aus Besuchern Anfragen werden.',
};
---

<BaseLayout
  title="Webseiten, die Anfragen bringen — Elevo"
  description="Wir bauen Websites, auf denen eine Anfrage leichter ist, als es zu lassen: individuell gestaltet, mit Texten, die verkaufen, schnell auf dem Handy. Sieh dir unsere Kundenprojekte live an."
  canonical="https://elevo.solutions/webseiten"
  bodyClass="rx"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <main id="main" class="ws">

    <!-- ===================================================== HERO -->
    <section class="ws-hero" aria-labelledby="ws-hero-heading">
      <div class="ws-grid-bg" aria-hidden="true"></div>
      <div class="container ws-hero-grid">
        <div class="ws-hero-copy">
          <p class="ev-eyebrow">Webseiten</p>
          <h1 id="ws-hero-heading" class="ev-hero-h1">
            Schöne Websites gibt es viele.<br>
            <span class="ev-accent">Unsere bringen Anfragen.</span>
          </h1>
          <p class="ev-hero-sub">
            Wer auf deiner Seite landet, entscheidet in Sekunden, ob er bleibt. Und er geht, sobald eine Anfrage
            nach Arbeit aussieht. Wir bauen Websites, die ihm diese Arbeit abnehmen: klar in der Aussage, schnell
            auf dem Handy und mit einem Weg zur Anfrage, den niemand suchen muss.
          </p>
          <div class="ev-hero-ctas">
            <a href="/kontakt" class="ev-btn ev-btn-primary">
              Strategie-Gespräch vereinbaren
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="#live" class="ev-btn ev-btn-ghost">Projekte live ansehen</a>
          </div>
          <ul class="ws-hero-facts" aria-label="Was jede Website mitbringt">
            <li>Individuell gebaut, kein Baukasten</li>
            <li>Texte inklusive</li>
            <li>DSGVO-konform gehostet</li>
          </ul>
        </div>

        <!-- Illustration: Seite baut sich auf, Besucher klickt, Anfrage kommt an -->
        <div class="ws-stage" aria-hidden="true">
          <div class="ws-browser">
            <div class="ws-browser-bar">
              <span class="ws-dots"><i></i><i></i><i></i></span>
              <span class="ws-url"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>deine-firma.de</span>
            </div>
            <div class="ws-page">
              <div class="ws-p-nav"><b></b><span></span><span></span><span></span><em></em></div>
              <div class="ws-p-hero">
                <div class="ws-p-text">
                  <span class="ws-l ws-l-xl"></span>
                  <span class="ws-l ws-l-lg"></span>
                  <span class="ws-l ws-l-sm"></span>
                  <span class="ws-l ws-l-sm2"></span>
                  <span class="ws-p-cta">Anfrage stellen<span class="ws-ripple"></span><svg class="ws-cursor ws-cursor-a" viewBox="0 0 24 24" width="22" height="22"><path d="M4 2l15 9.5-6.6 1.4L9 20z" fill="#0A0C10" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/></svg></span>
                </div>
                <div class="ws-p-img"></div>
              </div>
              <div class="ws-p-cards"><span></span><span></span><span></span></div>

              <div class="ws-form">
                <p class="ws-form-step">Schritt 3 von 3</p>
                <div class="ws-form-prog"><i></i></div>
                <span class="ws-field"><i></i></span>
                <span class="ws-field"><i></i></span>
                <span class="ws-form-send">Anfrage senden<span class="ws-ripple ws-ripple-b"></span><svg class="ws-cursor ws-cursor-b" viewBox="0 0 24 24" width="22" height="22"><path d="M4 2l15 9.5-6.6 1.4L9 20z" fill="#0A0C10" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/></svg></span>
                <span class="ws-form-ok"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
              </div>
            </div>
                      </div>

          <div class="ws-toast">
            <span class="ws-toast-ico"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z" opacity="0"/><path d="M22 6l-10 7L2 6"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg></span>
            <span class="ws-toast-body">
              <strong>Neue Anfrage</strong>
              <small>Gartenpflege · Aachen · gerade eben</small>
            </span>
          </div>
          <div class="ws-tag ws-tag-time"><span class="ws-pulse"></span>Sonntag, 21:47 Uhr</div>
        </div>
      </div>
    </section>

    <!-- ===================================================== DIE RECHNUNG -->
    <section class="ev-section ev-section-alt" aria-labelledby="ws-path-heading">
      <div class="container">
        <div class="ws-split">
          <div>
            <p class="ev-eyebrow reveal">Der eigentliche Mehrwert</p>
            <h2 id="ws-path-heading" class="ev-h2 reveal reveal-delay-1">Jeder Schritt zu viel kostet dich eine Anfrage.</h2>
            <div class="ws-prose reveal reveal-delay-2">
              <p>
                Niemand fragt an, weil das Kontaktformular so hübsch ist. Menschen fragen an, wenn es leichter ist,
                als es zu lassen. Zwischen dem Moment, in dem jemand denkt <em>„die könnten passen“</em>, und der
                tatsächlichen Nachricht liegen auf den meisten Websites zu viele kleine Hürden: die Kontaktseite
                suchen, die Nummer abschreiben, eine Mailbox, ein Formular mit zwölf Pflichtfeldern.
              </p>
              <p>
                Jede dieser Hürden verliert einen Teil der Menschen, die eigentlich wollten. Wir räumen sie weg.
                Das Ergebnis sind mehr Anfragen aus denselben Besuchern, ohne einen Euro mehr für Werbung.
              </p>
            </div>
          </div>

          <div class="ws-paths reveal reveal-delay-2" aria-label="Vergleich: üblicher Anfrageweg und Anfrageweg mit Elevo">
            <div class="ws-path ws-path-old">
              <p class="ws-path-label">Der übliche Weg</p>
              <ol>
                <li>Kontaktseite suchen</li>
                <li>Telefonnummer abschreiben</li>
                <li>Anrufen, Mailbox</li>
                <li>„Melde mich später nochmal“</li>
                <li class="ws-lost">Fragt bei der Konkurrenz an</li>
              </ol>
              <svg class="ws-path-line" viewBox="0 0 40 300" preserveAspectRatio="none" aria-hidden="true">
                <path d="M20 10 C 2 40, 38 60, 20 75 S 2 120, 20 140 S 38 190, 20 205 S 4 250, 20 290" />
              </svg>
            </div>
            <div class="ws-path ws-path-new">
              <p class="ws-path-label">Mit Elevo</p>
              <ol>
                <li>Sieht den Button, ohne zu suchen</li>
                <li>Beantwortet drei kurze Fragen</li>
                <li class="ws-won">Anfrage liegt bei dir im Postfach</li>
              </ol>
              <svg class="ws-path-line" viewBox="0 0 40 300" preserveAspectRatio="none" aria-hidden="true">
                <path d="M20 10 L 20 290" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================== MEHRWERTE -->
    <section class="ev-section" aria-labelledby="ws-values-heading">
      <div class="container">
        <header>
          <p class="ev-eyebrow reveal">Was deine Website für dich tut</p>
          <h2 id="ws-values-heading" class="ev-h2 reveal reveal-delay-1">Dein bester Mitarbeiter hat nie Feierabend.</h2>
          <p class="ev-section-sub reveal reveal-delay-2">
            Eine gute Website ist kein Prospekt, den man einmal druckt. Sie empfängt, erklärt, beantwortet Fragen und
            nimmt Anfragen an. Jeden Tag, auch dann, wenn du gerade beim Kunden bist.
          </p>
        </header>

        <div class="ws-values">
          <article class="ws-value reveal">
            <div class="ws-vis ws-vis-form" aria-hidden="true">
              <div class="ws-mini-card">
                <div class="ws-mini-steps"><i class="on"></i><i class="on"></i><i></i></div>
                <span class="ws-mini-q"></span>
                <div class="ws-mini-opts"><span class="sel">Neubau</span><span>Sanierung</span><span>Pflege</span></div>
              </div>
            </div>
            <h3>Anfragen in unter einer Minute</h3>
            <p>Statt eines leeren Textfelds stellen wir die drei Fragen, die du sowieso am Telefon stellen würdest. Antippen statt Tippen. So fragen auch die an, denen ein Anruf zu viel wäre.</p>
          </article>

          <article class="ws-value reveal reveal-delay-1">
            <div class="ws-vis ws-vis-clock" aria-hidden="true">
              <div class="ws-clock"><i class="h"></i><i class="m"></i></div>
              <div class="ws-notes">
                <span><b>06:12</b> Anfrage · Badsanierung</span>
                <span><b>13:40</b> Anfrage · Beratung</span>
                <span><b>22:05</b> Anfrage · Angebot</span>
              </div>
            </div>
            <h3>Erreichbar, wenn du es nicht bist</h3>
            <p>Viele melden sich abends, am Wochenende, zwischen zwei Terminen. Deine Website nimmt die Anfrage an, und du antwortest, wenn du Zeit hast. Keine verpassten Anrufe mehr, kein „ich versuche es später nochmal“.</p>
          </article>

          <article class="ws-value reveal reveal-delay-2">
            <div class="ws-vis ws-vis-brief" aria-hidden="true">
              <div class="ws-brief">
                <p><span>Leistung</span><b>Gartenpflege</b></p>
                <p><span>Zeitraum</span><b>ab März</b></p>
                <p><span>Ort</span><b>Aachen</b></p>
                <p><span>Rückruf</span><b>vormittags</b></p>
              </div>
            </div>
            <h3>Du weißt, worum es geht, bevor du zurückrufst</h3>
            <p>Jede Anfrage kommt mit den Angaben, die du für ein gutes erstes Gespräch brauchst. Du sortierst schneller, bereitest dich vor und verlierst keine Zeit mit Anfragen, die nicht passen.</p>
          </article>

          <article class="ws-value reveal">
            <div class="ws-vis ws-vis-trust" aria-hidden="true">
              <div class="ws-stars"><i></i><i></i><i></i><i></i><i></i></div>
              <span class="ws-quote-l"></span>
              <span class="ws-quote-l short"></span>
              <div class="ws-avatars"><i></i><i></i><i></i><em>+48</em></div>
            </div>
            <h3>Vertrauen, bevor das Telefon klingelt</h3>
            <p>Echte Projekte, echte Stimmen, ein Gesicht hinter dem Namen. Wer sich vorher überzeugen konnte, fragt nicht nach dem Preis, sondern nach dem Termin.</p>
          </article>

          <article class="ws-value reveal reveal-delay-1">
            <div class="ws-vis ws-vis-phone" aria-hidden="true">
              <div class="ws-phone-mini">
                <span class="ws-pm-l"></span><span class="ws-pm-l s"></span>
                <span class="ws-pm-img"></span>
                <span class="ws-thumb-zone"></span>
                <span class="ws-pm-btn"></span>
              </div>
            </div>
            <h3>Für den Daumen gebaut</h3>
            <p>Die meisten Anfragen beginnen auf dem Smartphone, oft unterwegs. Deshalb gestalten wir zuerst fürs Handy: kurze Wege, große Schaltflächen, Ladezeiten, bei denen niemand ungeduldig wird.</p>
          </article>

          <article class="ws-value reveal reveal-delay-2">
            <div class="ws-vis ws-vis-search" aria-hidden="true">
              <div class="ws-serp">
                <span class="ws-serp-bar"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.6"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>gärtner in aachen</span>
                <div class="ws-serp-hit you"><span class="t"></span><span class="d"></span></div>
                <div class="ws-serp-hit"><span class="t"></span><span class="d"></span></div>
                <div class="ws-serp-hit"><span class="t"></span><span class="d"></span></div>
              </div>
            </div>
            <h3>Gefunden von denen, die suchen</h3>
            <p>Saubere Technik, eine klare Struktur und Texte, die beschreiben, was du wo anbietest. Das ist die Grundlage, damit Google dich den Menschen zeigt, die gerade jemanden wie dich suchen.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===================================================== LIVE-SHOWROOM -->
    <section id="live" class="ev-section ev-section-alt ws-live" aria-labelledby="ws-live-heading">
      <div class="container">
        <header>
          <p class="ev-eyebrow reveal">Referenzen, live</p>
          <h2 id="ws-live-heading" class="ev-h2 reveal reveal-delay-1">Nicht beschrieben. Gebaut.</h2>
          <p class="ev-section-sub reveal reveal-delay-2">
            Keine Screenshots, keine Mockups. Das hier sind die echten Seiten unserer Kunden, direkt eingebettet.
            Scroll durch, klick dich rein, wechsle zwischen Desktop und Handy.
          </p>
        </header>

        <div class="ws-show reveal" data-showroom>
          <div class="ws-tabs" role="tablist" aria-label="Kundenprojekte">
            {projects.map((p, i) => (
              <button
                class="ws-tab"
                role="tab"
                id={`ws-tab-${p.id}`}
                aria-controls={`ws-panel-${p.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-tab={p.id}
              >
                <span class="ws-tab-name">{p.name}</span>
                <span class="ws-tab-sector">{p.sector}</span>
              </button>
            ))}
          </div>

          <div class="ws-view-toggle" role="group" aria-label="Ansicht wählen">
            <button type="button" class="ws-vt is-on" data-view="desktop" aria-pressed="true">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
              Desktop
            </button>
            <button type="button" class="ws-vt" data-view="mobile" aria-pressed="false">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/></svg>
              Handy
            </button>
          </div>

          {projects.map((p, i) => (
            <div
              class="ws-panel"
              role="tabpanel"
              id={`ws-panel-${p.id}`}
              aria-labelledby={`ws-tab-${p.id}`}
              hidden={i !== 0}
              data-panel={p.id}
            >
              <div class="ws-devices">
                <div class="ws-desk">
                  <div class="ws-desk-bar">
                    <span class="ws-dots"><i></i><i></i><i></i></span>
                    <span class="ws-desk-url">
                      <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                      {p.domain}
                    </span>
                    <a class="ws-desk-open" href={p.src} target="_blank" rel="noopener" aria-label={`${p.name} in neuem Tab öffnen`}>
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    </a>
                  </div>
                  <div class="ws-desk-view" data-scale-host>
                    <iframe
                      data-src={p.src}
                      title={`${p.name}: Website, live eingebettet (Desktop-Ansicht)`}
                      loading="lazy"
                      referrerpolicy="no-referrer"
                    ></iframe>
                    <span class="ws-loading" aria-hidden="true"><i></i>Seite wird geladen</span>
                  </div>
                </div>

                <div class="ws-mob">
                  <div class="ws-mob-notch" aria-hidden="true"></div>
                  <div class="ws-mob-view">
                    <iframe
                      data-src={p.src}
                      title={`${p.name}: Website, live eingebettet (Handy-Ansicht)`}
                      loading="lazy"
                      referrerpolicy="no-referrer"
                    ></iframe>
                    <span class="ws-loading" aria-hidden="true"><i></i>Seite wird geladen</span>
                  </div>
                </div>
              </div>

              <div class="ws-case">
                <div class="ws-case-head">
                  <span class={`ws-badge ${p.status === 'Live' ? 'is-live' : ''}`}>{p.status}</span>
                  <h3>{p.name}</h3>
                  <p class="ws-case-sector">{p.sector}</p>
                </div>
                <p class="ws-case-task"><span>Die Aufgabe</span>{p.task}</p>
                <ul class="ws-case-points">
                  {p.points.map((pt) => <li>{pt}</li>)}
                </ul>
                <a class="ws-case-link" href={p.src} target="_blank" rel="noopener">
                  Seite in voller Größe öffnen
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                </a>
              </div>
