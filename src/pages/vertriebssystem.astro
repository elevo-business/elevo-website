---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

// Lead-Formular postet an die bestehende Kontakt-/Lead-API (api.elevo.solutions):
// legt Person + Lead/Deal + Notiz (mit allen Antworten) in Pipedrive an.
const LEAD_API_URL = import.meta.env.PUBLIC_CONTACT_API_URL ?? 'https://api.elevo.solutions/api/contact';

// Terminbuchung via Calendly-Inline-Widget. Calendly ist mit dem Google-
// Kalender verbunden (zeigt nur freie Slots, Kunde bucht selbst) und wird NACH
// dem Formular geladen, mit den bereits erfassten Daten vorausgefuellt
// (Prefill -> kein doppeltes Eintippen).
// Per ENV setzen: PUBLIC_CALENDLY_URL = https://calendly.com/<account>/<event>
const CALENDLY_URL = import.meta.env.PUBLIC_CALENDLY_URL ?? 'https://calendly.com/hey-elevo/30min';

// Google-Profil-Link. Exakten Profil-Link via ENV setzen.
const GOOGLE_PROFILE_URL = import.meta.env.PUBLIC_GOOGLE_PROFILE_URL ?? 'https://www.google.com/search?q=ELEVO+Solutions+Rezensionen';

// Echte Google-Rezensionen (ELEVO Solutions, 4,7 Sterne, 3 Rezensionen).
const reviews = [
  { name: 'Sahil Nayar', initial: 'S', rating: 5, date: 'vor einer Woche', text: 'Wir sind sehr zufrieden mit der Zusammenarbeit. Vom Erstgespräch bis hin zur Umsetzung verlief alles unkompliziert und vor allem super schnell.' },
  { name: 'Miguel Römgens', initial: 'M', rating: 4, date: 'vor einer Woche', text: 'Wir hatten vorher eine Website von vor zehn Jahren, die auf dem Handy kaum lesbar war. Elevo hat in knapp zwei Wochen etwas komplett Neues gebaut.' },
  { name: 'Dorian Azemi', initial: 'D', rating: 5, date: 'vor einer Woche', text: 'Top Arbeit. Schnell, professionell und überraschend unkompliziert.' },
];
const avgNum = reviews.reduce((s, r) => s + r.rating, 0) / reviews.length;
const avgRating = avgNum.toFixed(1).replace('.', ',');
const avgPct = Math.round((avgNum / 5) * 100);
const year = new Date().getFullYear();
---

<BaseLayout
  title="Das 14-Tage-Vertriebssystem für Dienstleister — Elevo"
  description="Automatisiere die manuellen Prozesse, die dich und dein Team jede Woche Stunden kosten. In 14 Tagen, done-for-you. Sichere dir dein kostenloses telefonisches Erstgespräch."
  canonical="https://elevo.solutions/vertriebssystem"
  noindex={true}
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <header class="lp-header">
    <div class="lp-wrap lp-header-inner">
      <Logo size="md" />
      <a href="#termin" class="lp-btn lp-btn-primary lp-header-cta">Erstgespräch sichern</a>
    </div>
  </header>

  <main id="main">

    <!-- ===== HERO ===== -->
    <section class="lp-section lp-hero" aria-labelledby="lp-hero-heading">
      <div class="lp-wrap">
        <div class="lp-hero-grid">
          <div class="lp-hero-copy">
            <p class="lp-eyebrow">Das 14-Tage-Vertriebssystem für Dienstleister</p>
            <h1 id="lp-hero-heading" class="lp-h1">
              Automatisiere die manuellen Prozesse, die dich und dein Team jede Woche
              <span class="lp-accent">Stunden kosten.</span> In 14 Tagen.
            </h1>
            <p class="lp-sub">
              Für Dienstleister, die mehr Zeit mit Kunden statt mit Verwaltung verbringen wollen.
              Wir bauen dir das fertige System, du fasst nichts Technisches an.
            </p>
            <div class="lp-hero-ctas">
              <a href="#termin" class="lp-btn lp-btn-primary lp-btn-lg">
                Kostenloses Erstgespräch sichern
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
            <p class="lp-hero-trust">Kostenlos · ca. 15 Minuten am Telefon · kein Pitch</p>
          </div>

          <aside class="lp-getcard" aria-label="Das baut Elevo dir">
            <p class="lp-getcard-title">Das baut Elevo dir:</p>
            <ul class="lp-getcard-list" role="list">
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Dateneingabe und Lead-Anreicherung laufen automatisch</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Dokumente und Angebote in Minuten statt Stunden</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Nachfassen passiert von selbst, kein Lead versickert</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Routineaufgaben übernimmt das System, ihr berät</li>
            </ul>
            <a href="#termin" class="lp-btn lp-btn-ghost lp-getcard-cta">Termin wählen</a>
            <p class="lp-getcard-note">14 Tage live. Sonst zahlst du erst, wenn es steht.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ===== PROBLEM (Pains) ===== -->
    <section class="lp-section lp-section-alt" aria-labelledby="lp-problem-heading">
      <div class="lp-wrap">
        <p class="lp-eyebrow">Kommt dir bekannt vor?</p>
        <h2 id="lp-problem-heading" class="lp-h2">Die Verwaltung frisst die Zeit, die deinen Kunden gehört.</h2>
        <div class="lp-pains">
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Dieselben Kundendaten in mehrere Systeme tippen</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Abends noch Nachbereitung und Papierkram</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Angebote und Dokumente mühsam von Hand</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Nachfassen geht unter, Anfragen verpuffen</div>
        </div>
        <p class="lp-sub lp-sub-tight">
          Solange das so läuft, ist dein Wachstum gedeckelt. Du kannst nicht mehr Kunden annehmen,
          weil die Verwaltung dich und dein Team schon jetzt auffrisst. Rechne kurz nach, was dich
          die Handarbeit kostet.
        </p>
      </div>
    </section>

    <!-- ===== RECHNER (Zeit) ===== -->
    <section class="lp-section" aria-labelledby="lp-calc-heading">
      <div class="lp-wrap">
        <p class="lp-eyebrow">Rechne nach</p>
        <h2 id="lp-calc-heading" class="lp-h2">Wie viele Stunden kostet euch die Handarbeit jedes Jahr?</h2>
        <p class="lp-sub">Stell deine Zahlen ein. Der Rechner zeigt, wie viel Zeit ihr jedes Jahr zurückholt, wenn die Routineaufgaben automatisch laufen.</p>

        <div class="lp-calc">
          <div class="lp-calc-inputs">
            <div class="lp-calc-field">
              <div class="lp-calc-field-head"><label for="calc-hours">Stunden pro Woche für manuelle Prozesse (du und dein Team)</label><output id="calc-hours-out" class="lp-calc-val">10 h</output></div>
              <input type="range" id="calc-hours" class="lp-range" min="2" max="60" step="1" value="10">
            </div>
            <div class="lp-calc-field">
              <div class="lp-calc-field-head"><label for="calc-share">Anteil Routineaufgaben (automatisierbar)</label><output id="calc-share-out" class="lp-calc-val">70 %</output></div>
              <input type="range" id="calc-share" class="lp-range" min="30" max="90" step="5" value="70">
            </div>
          </div>
          <div class="lp-calc-result">
            <p class="lp-calc-result-label">Stunden, die ihr pro Jahr zurückholt</p>
            <p class="lp-calc-result-num" id="calc-back">364</p>
            <div class="lp-calc-result-rows">
              <div class="lp-calc-stat"><strong id="calc-days">46</strong><span>Arbeitstage / Jahr zurück</span></div>
              <div class="lp-calc-stat"><strong id="calc-month">30</strong><span>Stunden / Monat zurück</span></div>
            </div>
            <a href="#termin" class="lp-btn lp-btn-primary lp-btn-block">Zahlen im Erstgespräch durchrechnen</a>
            <p class="lp-calc-note">Überschlägige Rechnung. Zurückgeholte Zeit gleich Stunden pro Woche mal automatisierbarer Anteil mal 52, ein Arbeitstag gleich 8 Stunden. Eure echten Prozesse schauen wir uns im Erstgespräch an.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== MECHANISMUS ===== -->
    <section class="lp-section lp-section-alt" aria-labelledby="lp-mech-heading">
      <div class="lp-wrap">
        <p class="lp-eyebrow">Der Mechanismus</p>
        <h2 id="lp-mech-heading" class="lp-h2">Was dich Stunden kostet, läuft in Minuten.</h2>
        <div class="lp-flow" role="img" aria-label="Anfrage kommt rein, das System reichert Daten an und erstellt Dokumente, Angebot und Termin laufen automatisch, das Nachfassen passiert von selbst.">
          <div class="lp-flow-node"><span class="lp-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><span class="lp-flow-label">Anfrage und Kundendaten kommen rein</span></div>
          <div class="lp-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
          <div class="lp-flow-node"><span class="lp-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/></svg></span><span class="lp-flow-label">System reichert an und erstellt Dokumente</span></div>
          <div class="lp-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
          <div class="lp-flow-node"><span class="lp-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg></span><span class="lp-flow-label">Angebot und Termin automatisch</span></div>
          <div class="lp-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
          <div class="lp-flow-node"><span class="lp-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg></span><span class="lp-flow-label">Nachfassen läuft, während ihr berät</span></div>
        </div>
        <p class="lp-flow-caption">Ihr fasst nichts Technisches an. Ihr berät, das System macht den Rest. Die Live-Demo zeigen wir dir im Erstgespräch.</p>
      </div>
    </section>

    <!-- ===== ERGEBNIS / STATUS ===== -->
    <section class="lp-section" aria-labelledby="lp-wins-heading">
      <div class="lp-wrap">
        <p class="lp-eyebrow">Das Ergebnis</p>
        <h2 id="lp-wins-heading" class="lp-h2">Weniger Verwaltung. Mehr Kunden. Endlich Feierabend.</h2>
        <div class="lp-wins">
          <div class="lp-win"><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Stunden pro Woche zurück, für dich und dein Team</div>
          <div class="lp-win"><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Wachstum nicht mehr durch Admin gedeckelt</div>
          <div class="lp-win"><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Seriöser, moderner Auftritt</div>
          <div class="lp-win"><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Feierabend, weil das System die Arbeit macht</div>
        </div>
      </div>
    </section>

    <!-- ===== REFERENZEN / CASES ===== -->
    <section class="lp-section lp-section-alt" aria-labelledby="lp-proof-heading">
      <div class="lp-wrap">
        <p class="lp-eyebrow">Referenzen</p>
        <h2 id="lp-proof-heading" class="lp-h2">So sieht dein System in der Praxis aus.</h2>
        <p class="lp-sub">Zwei Unternehmen, zwei Engpässe, einmal komplett automatisiert. Genau diese Bausteine bauen wir auch für dich.</p>

        <!-- Case 1: Greenchild -->
        <article class="lp-ref">
          <div class="lp-ref-head">
            <div class="lp-ref-logo lp-ref-logo-light">
              <img src="/client-logos/greenchild.png" alt="greenchild Logo" width="150" height="34" loading="lazy" decoding="async">
            </div>
            <div class="lp-ref-headmeta">
              <span class="lp-ref-tag">Finanzdienstleister</span>
              <p class="lp-ref-situation">Leads und Dokumente liefen über Handarbeit. Zeit ging verloren, das Nachfassen blieb liegen.</p>
            </div>
            <div class="lp-ref-result">
              <strong>100 %</strong>
              <span>automatisiert, vom Lead bis zur Erinnerung</span>
            </div>
          </div>

          <p class="lp-ref-label">Was wir für Greenchild automatisiert haben</p>
          <div class="lp-ref-steps">
            <div class="lp-ref-step">
              <span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg></span>
              <span>Leadgenerierung läuft automatisch</span>
            </div>
            <div class="lp-ref-step">
              <span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15h6"/></svg></span>
              <span>Dokumente werden automatisch erstellt</span>
            </div>
            <div class="lp-ref-step">
              <span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span>
              <span>Vertrieb wird bei jedem Lead sofort benachrichtigt</span>
            </div>
            <div class="lp-ref-step">
              <span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg></span>
              <span>Alle Daten landen zentral im CRM, Zugriff für jeden</span>
            </div>
            <div class="lp-ref-step">
              <span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg></span>
              <span>Follow-up-E-Mails gehen automatisch raus</span>
            </div>
            <div class="lp-ref-step">
              <span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
              <span>Erinnerungs-E-Mails laufen automatisch</span>
            </div>
          </div>

          <div class="lp-ref-bridge">
            <span class="lp-ref-bridge-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            <p><strong>Für dich heißt das:</strong> dieselbe Kette für deine Leads. Reinkommen, anreichern, Vertrieb benachrichtigen, nachfassen, erinnern. Alles automatisch, du berätst nur noch, statt zu tippen.</p>
          </div>
        </article>

        <!-- Case 2: BML -->
        <article class="lp-ref">
          <div class="lp-ref-head">
            <div class="lp-ref-logo lp-ref-logo-dark">
              <img src="/client-logos/bml-white.png" alt="Brands Marketing Lab Logo" width="120" height="40" loading="lazy" decoding="async">
            </div>
            <div class="lp-ref-headmeta">
              <span class="lp-ref-tag">Social-Media-Agentur</span>
              <p class="lp-ref-situation">Anfragen kamen rein, aber das Sortieren und Weiterleiten ans Vertriebsteam kostete jeden Tag Zeit.</p>
            </div>
            <div class="lp-ref-result">
              <strong>2x</strong>
              <span>Kapazität des Teams, ohne mehr Arbeit</span>
            </div>
          </div>

          <p class="lp-ref-label">Was wir für Brands Marketing Lab gebaut haben</p>
          <div class="lp-ref-steps lp-ref-steps-3">
            <div class="lp-ref-step">
              <span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="14" rx="2"/><path d="M3 9h18"/><path d="M9 21h6"/><path d="M12 17v4"/></svg></span>
              <span>Vollautomatisierte Website gebaut</span>
            </div>
            <div class="lp-ref-step">
              <span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.59 13.51 15.42 17.49"/><path d="M15.41 6.51 8.59 10.49"/></svg></span>
              <span>Anfragen werden automatisch zum Vertrieb geleitet</span>
            </div>
            <div class="lp-ref-step">
              <span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></span>
              <span>Kein manuelles Sortieren mehr, Team frei fürs Wesentliche</span>
            </div>
          </div>

          <div class="lp-ref-bridge">
            <span class="lp-ref-bridge-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            <p><strong>Für dich heißt das:</strong> deine Anfragen kommen vorsortiert beim richtigen Menschen an. Dein Team schafft das Doppelte, ohne länger zu arbeiten.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- ===== SOCIAL PROOF: Google-Bewertungen ===== -->
    <section class="lp-section" aria-labelledby="lp-reviews-heading">
      <div class="lp-wrap">
        <p class="lp-eyebrow">Was Kunden sagen</p>
        <h2 id="lp-reviews-heading" class="lp-h2 lp-h2-tight">Echte Bewertungen. Keine Versprechen.</h2>
        <div class="lp-reviews-head">
          <span class="lp-g" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="34" height="34"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06L5.84 9.9C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
          </span>
          <div>
            <p class="lp-eyebrow lp-eyebrow-tight">Google Bewertungen</p>
            <div class="lp-rating">
              <span class="lp-rating-num">{avgRating}</span>
              <span class="lp-starbar" style={`--pct:${avgPct}%`} aria-hidden="true"></span>
              <span class="lp-rating-count">· {reviews.length} Rezensionen</span>
            </div>
          </div>
        </div>

        <div class="lp-reviews">
          {reviews.map((r) => (
            <article class="lp-review">
              <div class="lp-review-top">
                <span class="lp-avatar">{r.initial}</span>
                <div class="lp-review-who"><strong>{r.name}</strong><span>{r.date}</span></div>
