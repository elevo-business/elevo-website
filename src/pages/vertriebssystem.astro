---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

// Lead-Formular -> Pipedrive (api.elevo.solutions).
const LEAD_API_URL = import.meta.env.PUBLIC_CONTACT_API_URL ?? 'https://api.elevo.solutions/api/contact';

// Calendly (Kalender-Sync, freie Slots, Prefill). Per ENV: PUBLIC_CALENDLY_URL.
const CALENDLY_URL = import.meta.env.PUBLIC_CALENDLY_URL ?? 'https://calendly.com/hey-elevo/30min';

const year = new Date().getFullYear();
---

<BaseLayout
  title="Das 14-Tage-Vertriebssystem für Dienstleister — Elevo"
  description="Automatisiere die manuellen Prozesse, die dich und dein Team jede Woche Stunden kosten. In 14 Tagen, done-for-you. Sichere dir dein kostenloses Erstgespräch."
  canonical="https://elevo.solutions/vertriebssystem"
  noindex={true}
  eagerPageView={true}
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <header class="lp-header">
    <div class="lp-wrap lp-header-inner">
      <Logo size="md" />
      <button type="button" class="lp-btn lp-btn-primary lp-header-cta" data-scroll-booking>Erstgespräch sichern</button>
    </div>
  </header>

  <main id="main">

    <!-- ===== HERO mit sichtbarem Formular ===== -->
    <section class="lp-section lp-hero" aria-labelledby="lp-hero-heading">
      <div class="lp-wrap">
        <div class="lp-hero-head">
          <p class="lp-eyebrow">Das 14-Tage-Vertriebssystem für Dienstleister</p>
          <h1 id="lp-hero-heading" class="lp-h1">
            Automatisiere die manuellen Prozesse, die dich und dein Team jede Woche
            <span class="lp-accent">Stunden kosten.</span> In 14 Tagen.
          </h1>
          <p class="lp-sub">
            Für Dienstleister, die mehr Zeit mit Kunden statt mit Verwaltung verbringen wollen.
            Im kurzen Video erfährst du, wie es funktioniert.
          </p>
        </div>
        <div class="lp-hero-grid">
          <div class="lp-vsl">
            <div class="lp-vsl-box">
              <video id="lp-vsl-video" class="lp-vsl-video" src="/vsl/hero-vsl.mp4" muted autoplay loop playsinline webkit-playsinline preload="metadata"></video>
              <button type="button" class="lp-vsl-play" id="lp-vsl-play" aria-label="Video mit Ton abspielen">
                <span class="lp-vsl-play-ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg></span>
                <span class="lp-vsl-play-label">Mit Ton ansehen</span>
              </button>
            </div>
          </div>

          <!-- Sichtbares Buchungs-Formular -->
          <aside class="lp-bookcard" id="booking" aria-label="Kostenloses Erstgespräch sichern">
            <div id="lf-step-form">
              <p class="lp-bookcard-eyebrow">Kostenloses Erstgespräch</p>
              <h2 class="lp-bookcard-title">Sichere dir deinen Termin.</h2>
              <p class="lp-bookcard-sub">Kurz deine Daten, dann öffnet sich direkt mein Kalender.</p>

              <form class="contact-form lp-form" id="lead-form" novalidate data-api-url={LEAD_API_URL}>
                <input type="text" name="_hp" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true">
                <input type="hidden" name="_ts" id="lead-ts" value="">
                <div class="form-group">
                  <label class="form-label" for="lf-name">Name *</label>
                  <input class="form-input" type="text" id="lf-name" name="name" placeholder="Max Mustermann" required autocomplete="name">
                </div>
                <div class="form-group">
                  <label class="form-label" for="lf-email">E-Mail-Adresse *</label>
                  <input class="form-input" type="email" id="lf-email" name="email" placeholder="max@dein-unternehmen.de" required autocomplete="email">
                </div>
                <div class="form-group">
                  <label class="form-label" for="lf-company">Unternehmen *</label>
                  <input class="form-input" type="text" id="lf-company" name="company" placeholder="Deine Firma" required autocomplete="organization">
                </div>
                <div class="form-group">
                  <label class="form-label" for="lf-website">Website (optional)</label>
                  <input class="form-input" type="text" id="lf-website" name="website" placeholder="dein-unternehmen.de" autocomplete="url" inputmode="url">
                </div>
                <button type="submit" class="form-submit lp-btn lp-btn-primary lp-btn-block lp-btn-lg" id="lf-submit">Weiter zum Kalender</button>
                <p class="form-privacy-note">
                  Mit dem Absenden stimmst du unserer <a href="/datenschutz">Datenschutzerklärung</a> zu.
                </p>
                <div class="form-message" id="lf-message" role="alert" aria-live="polite"></div>
              </form>

              <ul class="lp-bookcard-trust" role="list">
                <li>Kostenlos</li><li>ca. 15 Min.</li><li>kein Pitch</li><li>nur 3 Plätze/Monat</li>
              </ul>
            </div>

            <div class="lp-form-success" id="lf-success" hidden>
              <div class="lp-form-success-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <h3>Geschafft. Wähl jetzt deinen Termin.</h3>
              <p>Such dir einen freien Slot in meinem Kalender aus. Falls das Fenster nicht von selbst aufgeht, klick den Button.</p>
              <div class="lp-scheduler-cta">
                <button type="button" class="lp-btn lp-btn-primary lp-btn-lg lp-btn-block" id="lf-open-cal" data-url={CALENDLY_URL}>Freien Termin auswählen</button>
              </div>
              <p class="lp-cal-fallback">Fenster öffnet nicht? <a href={CALENDLY_URL} target="_blank" rel="noopener">Hier im neuen Tab öffnen</a></p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ===== PROBLEM (Pains) ===== -->
    <section class="lp-section lp-section-alt" aria-labelledby="lp-problem-heading">
      <div class="lp-wrap">
        <p class="lp-eyebrow">Kommt dir bekannt vor?</p>
        <h2 id="lp-problem-heading" class="lp-h2">Die Verwaltung frisst die Zeit, die deinen Kunden gehört.</h2>
        <div class="lp-pains">
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Dieselben Kundendaten in mehrere Systeme tippen</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Abends noch Nachbereitung und Papierkram</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Angebote und Dokumente mühsam von Hand</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Nachfassen geht unter, Anfragen verpuffen</div>
        </div>
        <p class="lp-sub lp-sub-tight">
          Solange das so läuft, ist dein Wachstum gedeckelt. Wir bauen dir das System, das diese
          Handarbeit übernimmt. In ca. 15 Minuten zeigen wir dir, wie das bei dir aussieht.
        </p>
        <div class="lp-center-cta">
          <button type="button" class="lp-btn lp-btn-primary lp-btn-lg" data-scroll-booking>Kostenloses Erstgespräch sichern</button>
        </div>
      </div>
    </section>

    <!-- ===== MECHANISMUS ===== -->
    <section class="lp-section" aria-labelledby="lp-mech-heading">
      <div class="lp-wrap">
        <p class="lp-eyebrow">Der Mechanismus</p>
        <h2 id="lp-mech-heading" class="lp-h2">Was dich Stunden kostet, läuft in Minuten.</h2>
        <div class="lp-flow" role="img" aria-label="Anfrage kommt rein, das System reichert Daten an und erstellt Dokumente, Angebot und Termin laufen automatisch, das Nachfassen passiert von selbst.">
          <div class="lp-flow-node"><span class="lp-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><span class="lp-flow-label">Anfrage und Kundendaten kommen rein</span></div>
          <div class="lp-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
          <div class="lp-flow-node"><span class="lp-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/></svg></span><span class="lp-flow-label">System reichert an und erstellt Dokumente</span></div>
          <div class="lp-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
          <div class="lp-flow-node"><span class="lp-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg></span><span class="lp-flow-label">Angebot und Termin automatisch</span></div>
          <div class="lp-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
          <div class="lp-flow-node"><span class="lp-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg></span><span class="lp-flow-label">Nachfassen läuft, während ihr berät</span></div>
        </div>
      </div>
    </section>

    <!-- ===== REFERENZEN / PROOF ===== -->
    <section class="lp-section lp-section-alt" aria-labelledby="lp-proof-heading">
      <div class="lp-wrap">
        <p class="lp-eyebrow">Referenzen</p>
        <h2 id="lp-proof-heading" class="lp-h2">So sieht dein System in der Praxis aus.</h2>

        <article class="lp-ref">
          <div class="lp-ref-head">
            <div class="lp-ref-logo lp-ref-logo-light">
              <img src="/client-logos/greenchild.png" alt="greenchild Logo" width="150" height="34" loading="lazy" decoding="async">
            </div>
            <div class="lp-ref-headmeta">
              <span class="lp-ref-tag">Finanzdienstleister</span>
              <p class="lp-ref-situation">Leads und Dokumente liefen über Handarbeit. Zeit ging verloren, das Nachfassen blieb liegen.</p>
            </div>
            <div class="lp-ref-result"><strong>100 %</strong><span>automatisiert, vom Lead bis zur Erinnerung</span></div>
          </div>
          <p class="lp-ref-label">Was wir für Greenchild automatisiert haben</p>
          <div class="lp-ref-steps">
            <div class="lp-ref-step"><span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg></span><span>Leadgenerierung läuft automatisch</span></div>
            <div class="lp-ref-step"><span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15h6"/></svg></span><span>Dokumente werden automatisch erstellt</span></div>
            <div class="lp-ref-step"><span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span><span>Vertrieb wird bei jedem Lead sofort benachrichtigt</span></div>
            <div class="lp-ref-step"><span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg></span><span>Alle Daten landen zentral im CRM</span></div>
            <div class="lp-ref-step"><span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg></span><span>Follow-up-E-Mails gehen automatisch raus</span></div>
            <div class="lp-ref-step"><span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span><span>Erinnerungs-E-Mails laufen automatisch</span></div>
          </div>
          <div class="lp-ref-bridge">
            <span class="lp-ref-bridge-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            <p><strong>Für dich heißt das:</strong> dieselbe Kette für deine Leads. Reinkommen, anreichern, Vertrieb benachrichtigen, nachfassen, erinnern. Alles automatisch, du berätst nur noch, statt zu tippen.</p>
          </div>
        </article>

        <article class="lp-ref">
          <div class="lp-ref-head">
            <div class="lp-ref-logo lp-ref-logo-dark">
              <img src="/client-logos/bml-white.png" alt="Brands Marketing Lab Logo" width="120" height="40" loading="lazy" decoding="async">
            </div>
            <div class="lp-ref-headmeta">
              <span class="lp-ref-tag">Social-Media-Agentur</span>
              <p class="lp-ref-situation">Anfragen kamen rein, aber das Sortieren und Weiterleiten ans Vertriebsteam kostete jeden Tag Zeit.</p>
            </div>
            <div class="lp-ref-result"><strong>2x</strong><span>Kapazität des Teams, ohne mehr Arbeit</span></div>
          </div>
          <p class="lp-ref-label">Was wir für Brands Marketing Lab gebaut haben</p>
          <div class="lp-ref-steps lp-ref-steps-3">
            <div class="lp-ref-step"><span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="14" rx="2"/><path d="M3 9h18"/><path d="M9 21h6"/><path d="M12 17v4"/></svg></span><span>Vollautomatisierte Website gebaut</span></div>
            <div class="lp-ref-step"><span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.59 13.51 15.42 17.49"/><path d="M15.41 6.51 8.59 10.49"/></svg></span><span>Anfragen werden automatisch zum Vertrieb geleitet</span></div>
            <div class="lp-ref-step"><span class="lp-ref-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></span><span>Kein manuelles Sortieren mehr</span></div>
          </div>
          <div class="lp-ref-bridge">
            <span class="lp-ref-bridge-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            <p><strong>Für dich heißt das:</strong> deine Anfragen kommen vorsortiert beim richtigen Menschen an. Dein Team schafft das Doppelte, ohne länger zu arbeiten.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- ===== GARANTIE ===== -->
    <section class="lp-section" aria-labelledby="lp-gar-heading">
      <div class="lp-wrap">
        <div class="lp-guarantee">
          <div class="lp-guarantee-ico" aria-hidden="true">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="lp-guarantee-body">
            <p class="lp-eyebrow">Unser Risiko, nicht deins</p>
            <h2 id="lp-gar-heading" class="lp-h2 lp-h2-tight">Steht es nicht in 14 Tagen, zahlst du erst, wenn es läuft.</h2>
            <p class="lp-guarantee-text">Dein System kommt zum Festpreis, der vorher feststeht. Keine Überraschungen. Wir bauen alles done-for-you und holen euch nachweislich Zeit zurück. Damit es exklusiv bleibt, nehmen wir nur <strong>3 neue Kunden pro Monat</strong> an.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== FAQ (gekürzt) ===== -->
    <section class="lp-section lp-section-alt" aria-labelledby="lp-faq-heading">
      <div class="lp-wrap">
        <p class="lp-eyebrow">Klartext vor dem Erstgespräch</p>
        <h2 id="lp-faq-heading" class="lp-h2 lp-h2-tight">Was Dienstleister wirklich fragen.</h2>
        <div class="lp-faq" role="list">
          <details class="lp-faq-item" role="listitem">
            <summary class="lp-faq-q"><span>Muss ich technisch fit sein oder selbst etwas bauen?</span><span class="lp-faq-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></summary>
            <div class="lp-faq-a"><p>Nein. Wir bauen alles done-for-you. Copy, Technik und Automatisierung. Ihr liefert nur die Infos, den Rest übernehmen wir.</p></div>
          </details>
          <details class="lp-faq-item" role="listitem">
            <summary class="lp-faq-q"><span>Wie lange dauert es?</span><span class="lp-faq-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></summary>
            <div class="lp-faq-a"><p>14 Tage bis live, nicht drei Monate. Steht es nicht rechtzeitig, zahlst du erst, wenn es läuft.</p></div>
          </details>
          <details class="lp-faq-item" role="listitem">
            <summary class="lp-faq-q"><span>Was kostet das?</span><span class="lp-faq-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></summary>
            <div class="lp-faq-a"><p>Zum Festpreis, der vorher feststeht. Was für euren Umfang sinnvoll ist, klären wir im kostenlosen Erstgespräch.</p></div>
          </details>
          <details class="lp-faq-item" role="listitem">
            <summary class="lp-faq-q"><span>Was ist mit DSGVO und unseren Kundendaten?</span><span class="lp-faq-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></summary>
            <div class="lp-faq-a"><p>DSGVO-konform ist Standard. EU-Hosting, Auftragsverarbeitungsvertrag und self-hosted Fonts. Eure Daten bleiben in eurer Hand.</p></div>
          </details>
        </div>
      </div>
    </section>

    <!-- ===== ÜBER MERT + FINAL CTA ===== -->
    <section class="lp-section" aria-labelledby="lp-mert-heading">
      <div class="lp-wrap">
        <div class="lp-vision">
          <figure class="lp-vision-portrait">
            <picture>
              <source type="image/webp" srcset="/team/mert-800.webp 1x, /team/mert-1600.webp 2x">
              <img src="/team/mert-1200.jpg" alt="Mert Efe Celik, Gründer von Elevo" width="240" height="300" loading="lazy" decoding="async">
            </picture>
            <figcaption><strong>Mert Efe Celik</strong><span>Gründer · Elevo</span></figcaption>
          </figure>
          <div class="lp-vision-body">
            <p class="lp-eyebrow">Wer dich berät</p>
            <h2 id="lp-mert-heading" class="lp-h2 lp-h2-tight">Andere erklären dir, wie es geht. Wir bauen es dir.</h2>
            <p class="lp-vision-text">Im Erstgespräch schauen wir gemeinsam auf eure Abläufe und zeigen dir, welche manuellen Prozesse sich automatisieren lassen. Ob wir danach zusammenarbeiten, entscheidest du in Ruhe.</p>
            <p class="lp-vision-close">Done-for-you statt Kurs. Zum Festpreis, in 14 Tagen.</p>
            <button type="button" class="lp-btn lp-btn-primary lp-btn-lg" data-scroll-booking>Kostenloses Erstgespräch sichern</button>
            <p class="lp-hero-trust" style="margin-top:14px;">Kostenlos · ca. 15 Minuten · kein Pitch</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <footer class="lp-footer">
    <div class="lp-wrap lp-footer-inner">
      <Logo size="sm" />
      <nav class="lp-footer-nav" aria-label="Rechtliches">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
        <a href="#" id="cookie-settings-link" aria-label="Cookie-Einstellungen anpassen">Cookie-Einstellungen</a>
      </nav>
      <p class="lp-footer-copy">© {year} ELEVO Solutions</p>
    </div>
  </footer>

  <!-- Sticky CTA (mobil dauerhaft sichtbar) -->
  <div class="lp-sticky-cta">
    <button type="button" class="lp-btn lp-btn-primary lp-btn-block" data-scroll-booking>Kostenloses Erstgespräch sichern</button>
  </div>

  <CookieBanner />

  <script>
    // FormStart-Event (gelandet -> Formular gestartet) fuer Meta + Google.
    let formStarted = false;
    function fireFormStart() {
      if (formStarted) return;
      formStarted = true;
      if (typeof (window as any).fbq === 'function') {
        (window as any).fbq('trackCustom', 'FormStart', { content_name: 'vertriebssystem' });
      }
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'form_start', { send_to: 'AW-18023151518' });
      }
    }

    // CTAs scrollen zum sichtbaren Formular und fokussieren es.
    function scrollToBooking() {
      const card = document.getElementById('booking');
      const name = document.getElementById('lf-name') as HTMLInputElement | null;
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => { if (name && !(document.getElementById('lf-step-form') as HTMLElement)?.hidden) name.focus(); }, 420);
      fireFormStart();
    }
    document.querySelectorAll('[data-scroll-booking]').forEach((b) => {
      b.addEventListener('click', (e) => { e.preventDefault(); scrollToBooking(); });
    });
    // FormStart auch, wenn der Nutzer direkt ins Formular tippt.
    document.getElementById('lf-name')?.addEventListener('focus', fireFormStart, { once: true });
    document.getElementById('lf-email')?.addEventListener('focus', fireFormStart, { once: true });

    // VSL. Browser blocken Autoplay MIT Ton, und Mobile startet ohne Geste oft
    // gar nicht. Loesung: stumm autoplay versuchen (Desktop), und beim ersten
    // Tap/Klick zuverlaessig MIT Ton von vorne starten (Geste = erlaubt).
    const vsl = document.getElementById('lp-vsl-video') as HTMLVideoElement | null;
    const vslPlay = document.getElementById('lp-vsl-play') as HTMLElement | null;

    function vslSoundOn() {
      if (!vsl) return;
      vsl.muted = false;
      vsl.volume = 1;
      vsl.loop = false;        // VSL nicht mehr loopen, sobald mit Ton geschaut wird
      vsl.controls = true;     // ab jetzt native Steuerung (pausieren/scrubben)
      vsl.currentTime = 0;
      const p = vsl.play();
      if (p && (p as any).catch) (p as Promise<void>).catch(() => {});
      if (vslPlay) vslPlay.style.display = 'none';
    }

    // Stummer Autoplay-Versuch (v. a. Desktop). Schlaegt mobil oft fehl -> egal,
    // der Play-Button/erste Tap startet es dann.
    if (vsl) { const p = vsl.play(); if (p && (p as any).catch) (p as Promise<void>).catch(() => {}); }

    vslPlay?.addEventListener('click', (e) => { e.stopPropagation(); vslSoundOn(); });

    // Erster Tap/Klick irgendwo startet das Video mit Ton (falls noch stumm/pausiert).
    const vslEvents = ['pointerdown', 'touchstart', 'keydown'];
    function vslFirstInteract() {
      if (vsl && vsl.muted) vslSoundOn();
      vslEvents.forEach((ev) => window.removeEventListener(ev, vslFirstInteract, true));
    }
    if (vsl) vslEvents.forEach((ev) => window.addEventListener(ev, vslFirstInteract, { capture: true, passive: true }));

    vsl?.addEventListener('volumechange', () => {
      if (vsl && !vsl.muted && vslPlay) vslPlay.style.display = 'none';
    });

    // ===== Calendly Popup (Kalender-Sync + Prefill) =====
    let calUrl = '';
    function buildCalendlyUrl(base: string, fullName: string, email: string) {
      try {
        const u = new URL(base);
        u.searchParams.set('name', fullName);
        u.searchParams.set('email', email);
        return u.toString();
      } catch { return base; }
    }
    function withCalendly(cb: () => void) {
      if ((window as any).Calendly) { cb(); return; }
      if (!document.getElementById('calendly-widget-css')) {
        const link = document.createElement('link');
        link.id = 'calendly-widget-css'; link.rel = 'stylesheet';
        link.href = 'https://assets.calendly.com/assets/external/widget.css';
        document.head.appendChild(link);
      }
      let s = document.getElementById('calendly-widget-js') as HTMLScriptElement | null;
      if (!s) {
        s = document.createElement('script');
        s.id = 'calendly-widget-js';
        s.src = 'https://assets.calendly.com/assets/external/widget.js';
        s.async = true;
        document.head.appendChild(s);
      }
      s.addEventListener('load', cb, { once: true });
    }
    function openCalendlyPopup() {
      if (!calUrl) return;
      withCalendly(() => {
        const C = (window as any).Calendly;
        if (C && typeof C.initPopupWidget === 'function') C.initPopupWidget({ url: calUrl });
      });
    }
    document.getElementById('lf-open-cal')?.addEventListener('click', openCalendlyPopup);

    // ===== Lead-Formular -> Pipedrive -> Calendly =====
    const lf = document.getElementById('lead-form') as HTMLFormElement | null;
    if (lf) {
      const tsEl = document.getElementById('lead-ts') as HTMLInputElement;
      if (tsEl) tsEl.value = String(Date.now());
      const btn = document.getElementById('lf-submit') as HTMLButtonElement;
      const msg = document.getElementById('lf-message')!;
      const stepForm = document.getElementById('lf-step-form')!;
      const success = document.getElementById('lf-success')!;
      const apiUrl = lf.dataset.apiUrl!;
      const val = (n: string) => (lf.elements.namedItem(n) as HTMLInputElement)?.value.trim() ?? '';

      lf.addEventListener('submit', async (e) => {
        e.preventDefault();
        if ((lf.elements.namedItem('_hp') as HTMLInputElement)?.value) return; // honeypot
        const ts = (lf.elements.namedItem('_ts') as HTMLInputElement)?.value;
        if (ts && Date.now() - parseInt(ts, 10) < 1200) return;

        const fullName = val('name'), email = val('email'), company = val('company'), website = val('website');
        if (!fullName || !email || !company) {
          msg.className = 'form-message error'; msg.textContent = 'Bitte füll Name, E-Mail und Unternehmen aus.'; return;
        }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          msg.className = 'form-message error'; msg.textContent = 'Bitte gib eine gültige E-Mail-Adresse ein.'; return;
        }
        const parts = fullName.split(/\s+/);
        const firstName = parts.shift() || fullName;
        const lastName = parts.join(' ');

        btn.disabled = true; btn.textContent = 'Einen Moment …';
        const lead = (window as any).elevoMeta?.leadData?.() ?? null;

        // Booking-Prio: Erfolgs-Screen + Calendly sofort, unabhaengig von der API.
        stepForm.hidden = true;
        success.hidden = false;
        calUrl = buildCalendlyUrl((document.getElementById('lf-open-cal') as HTMLElement)?.dataset.url || '', fullName, email);
        openCalendlyPopup();

        if (typeof (window as any).gtag !== 'undefined') {
          (window as any).gtag('event', 'conversion', { send_to: 'AW-18023151518/contact_form_submit' });
        }
        if (lead) (window as any).elevoMeta?.fireLead?.(lead.metaEventId, { content_name: 'vertriebssystem' });

        fetch(apiUrl, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: fullName, firstName, lastName, email, company, website,
            service: 'vertriebssystem', source: 'vertriebssystem',
            message: `Erstgespräch-Anfrage über die Vertriebssystem-Landingpage.\nUnternehmen: ${company}\nWebsite: ${website || 'nicht angegeben'}`,
            ...(lead ?? {}),
          }),
        }).catch(() => { /* CRM-Sync fehlgeschlagen; Buchung laeuft trotzdem */ });
      });
    }
  </script>
</BaseLayout>

