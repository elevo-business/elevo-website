---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/ev-system.css';

// Lead-Formular postet an die bestehende Kontakt-/Lead-API (api.elevo.solutions):
// legt Person + Lead/Deal + Notiz (mit allen Antworten) in Pipedrive an.
const LEAD_API_URL = import.meta.env.PUBLIC_CONTACT_API_URL ?? 'https://api.elevo.solutions/api/contact';

// Terminbuchung mit Pipedrive-Sync (termin.elevo.solutions). Wird NACH dem
// Absenden im Erfolgs-Screen eingeblendet, damit der Prospect direkt einen
// Slot fürs telefonische Erstgespräch wählt. Per ENV austauschbar.
const SCHEDULER_URL = import.meta.env.PUBLIC_VERTRIEBSSYSTEM_SCHEDULER_URL ?? 'https://termin.elevo.solutions';

// Google-Profil-Link (für "Auf Google ansehen"). Exakten Profil-Link via ENV setzen.
const GOOGLE_PROFILE_URL = import.meta.env.PUBLIC_GOOGLE_PROFILE_URL ?? 'https://www.google.com/search?q=ELEVO+Solutions+Rezensionen';

// Echte Google-Rezensionen (ELEVO Solutions, 4,7 ★ · 3 Rezensionen).
const reviews = [
  { name: 'Sahil Nayar', initial: 'S', rating: 5, date: 'vor einer Woche', text: 'Wir sind sehr zufrieden mit der Zusammenarbeit. Vom Erstgespräch bis hin zur Umsetzung verlief alles unkompliziert und vor allem super schnell.' },
  { name: 'Miguel Römgens', initial: 'M', rating: 4, date: 'vor einer Woche', text: 'Wir hatten vorher eine Website von vor zehn Jahren, die auf dem Handy kaum lesbar war. Elevo hat in knapp zwei Wochen etwas komplett Neues gebaut.' },
  { name: 'Dorian Azemi', initial: 'D', rating: 5, date: 'vor einer Woche', text: 'Top Arbeit. Schnell, professionell und überraschend unkompliziert.' },
];
const avgNum = reviews.reduce((s, r) => s + r.rating, 0) / reviews.length;
const avgRating = avgNum.toFixed(1).replace('.', ',');
const avgPct = Math.round((avgNum / 5) * 100);
---

<BaseLayout
  title="Das 14-Tage-Vertriebssystem für Dienstleister — Elevo"
  description="Automatisiere die manuellen Prozesse, die dir jede Woche Stunden kosten — in 14 Tagen. Done-for-you Vertriebssystem für Dienstleister: konvertierende Website plus Automatisierung. Sichere dir dein kostenloses Erstgespräch."
  canonical="https://elevo.solutions/vertriebssystem"
  noindex={true}
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <header class="lp-header">
    <div class="container lp-header-inner">
      <Logo size="md" />
      <a href="#termin" class="ev-btn ev-btn-primary lp-header-cta">Erstgespräch sichern</a>
    </div>
  </header>

  <main id="main">

    <!-- ===== HERO ===== -->
    <section class="ev-hero lp-hero" aria-labelledby="lp-hero-heading">
      <div class="container">
        <div class="ev-hero-grid">
          <div class="ev-hero-copy">
            <p class="ev-eyebrow">Das 14-Tage-Vertriebssystem für Dienstleister</p>
            <h1 id="lp-hero-heading" class="ev-hero-h1">
              Automatisiere die manuellen Prozesse, die dir jede Woche
              <span class="ev-accent">Stunden kosten</span> — in 14 Tagen.
            </h1>
            <p class="ev-hero-sub">
              Für Dienstleister, die mehr Zeit mit Kunden statt mit Verwaltung verbringen wollen.
              Wir bauen dir das fertige System — du fasst nichts Technisches an.
            </p>
            <div class="ev-hero-ctas">
              <a href="#termin" class="ev-btn ev-btn-primary">
                Kostenloses Erstgespräch sichern
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
            <p class="ev-hero-trust">Kostenlos · ~15 Minuten am Telefon · kein Pitch</p>
          </div>

          <aside class="lp-getcard" aria-label="Das baut Elevo dir">
            <p class="lp-getcard-title">Das baut Elevo dir:</p>
            <ul class="lp-getcard-list" role="list">
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Konvertierende Website als Front deines Vertriebs</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Dateneingabe &amp; Lead-Anreicherung — automatisch</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Dokumente &amp; Angebote in Minuten statt Stunden</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Nachfassen läuft von selbst — kein Lead versickert</li>
            </ul>
            <a href="#termin" class="ev-btn ev-btn-ghost lp-getcard-cta">Termin wählen →</a>
            <p class="lp-getcard-note">14 Tage live — sonst zahlst du erst, wenn es steht.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ===== PROBLEM (Pains) ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-problem-heading">
      <div class="container">
        <p class="ev-eyebrow">Kommt dir bekannt vor?</p>
        <h2 id="lp-problem-heading" class="ev-h2">Die Verwaltung frisst die Zeit, die deinen Kunden gehört.</h2>
        <div class="lp-pains">
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Dieselben Kundendaten in mehrere Systeme tippen</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Abends noch Nachbereitung &amp; Papierkram</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Angebote &amp; Dokumente mühsam von Hand</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Nachfassen geht unter — Anfragen verpuffen</div>
        </div>
        <p class="ev-section-sub" style="margin-top:28px;">
          Solange das so läuft, ist dein Wachstum gedeckelt — du kannst nicht mehr Kunden annehmen,
          weil die Verwaltung dich schon jetzt auffrisst. Rechne kurz nach, was dich die Handarbeit kostet:
        </p>
      </div>
    </section>

    <!-- ===== RECHNER (Zeit) ===== -->
    <section class="ev-section" aria-labelledby="lp-calc-heading">
      <div class="container">
        <p class="ev-eyebrow">Rechne nach</p>
        <h2 id="lp-calc-heading" class="ev-h2">Wie viele Stunden kostet dich die Handarbeit — jedes Jahr?</h2>
        <p class="ev-section-sub">Stell deine Zahlen ein. Der Rechner zeigt, wie viel Zeit du jedes Jahr zurückholst, wenn die Routine-Prozesse automatisch laufen.</p>

        <div class="ev-calc">
          <div class="ev-calc-inputs">
            <div class="ev-calc-field">
              <div class="ev-calc-field-head"><label for="calc-hours">Stunden pro Woche für manuelle Prozesse</label><output id="calc-hours-out" class="ev-calc-val">10&nbsp;h</output></div>
              <input type="range" id="calc-hours" class="ev-range" min="2" max="40" step="1" value="10">
            </div>
            <div class="ev-calc-field">
              <div class="ev-calc-field-head"><label for="calc-share">Anteil Routine, der automatisierbar ist</label><output id="calc-share-out" class="ev-calc-val">70&nbsp;%</output></div>
              <input type="range" id="calc-share" class="ev-range" min="30" max="90" step="5" value="70">
            </div>
          </div>
          <div class="ev-calc-result">
            <p class="ev-calc-result-label">Stunden, die du pro Jahr zurückholst</p>
            <p class="ev-calc-result-num" id="calc-back">364</p>
            <div class="ev-calc-result-rows">
              <div class="ev-calc-stat"><strong id="calc-days">46</strong><span>Arbeitstage / Jahr zurück</span></div>
              <div class="ev-calc-stat"><strong id="calc-month">30</strong><span>Stunden / Monat zurück</span></div>
            </div>
            <a href="#termin" class="ev-btn ev-btn-primary ev-btn-block">Deine Zahlen im Erstgespräch durchrechnen</a>
            <p class="ev-calc-note">Überschlägige Rechnung (zurückgeholte Zeit = Stunden/Woche × automatisierbarer Anteil × 52, ein Arbeitstag = 8 h). Deine echten Prozesse schauen wir uns im Erstgespräch an.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== MECHANISMUS ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-mech-heading">
      <div class="container">
        <p class="ev-eyebrow">Der Mechanismus</p>
        <h2 id="lp-mech-heading" class="ev-h2">Was dich Stunden kostet, läuft in Minuten.</h2>
        <div class="ev-flow-wrap" style="border-top:none; padding-top:0; margin-top:24px;">
          <div class="ev-flow" role="img" aria-label="Anfrage kommt rein, das System reichert Daten an und erstellt Dokumente, Angebot und Termin laufen automatisch, das Nachfassen passiert von selbst.">
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><span class="ev-flow-label">Anfrage &amp; Kundendaten kommen rein</span></div>
            <div class="ev-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/></svg></span><span class="ev-flow-label">System reichert an &amp; erstellt Dokumente</span></div>
            <div class="ev-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg></span><span class="ev-flow-label">Angebot &amp; Termin automatisch</span></div>
            <div class="ev-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="ev-flow-node"><span class="ev-flow-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg></span><span class="ev-flow-label">Nachfassen läuft, während du berätst</span></div>
          </div>
          <p class="ev-flow-caption">Du fasst nichts Technisches an — du berätst, das System macht den Rest. Die Live-Demo zeigen wir dir im Erstgespräch.</p>
        </div>
      </div>
    </section>

    <!-- ===== ERGEBNIS / STATUS ===== -->
    <section class="ev-section" aria-labelledby="lp-wins-heading">
      <div class="container">
        <p class="ev-eyebrow">Das Ergebnis</p>
        <h2 id="lp-wins-heading" class="ev-h2">Weniger Verwaltung. Mehr Kunden. Endlich Feierabend.</h2>
        <div class="lp-wins">
          <div class="lp-win"><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Stunden pro Woche zurück</div>
          <div class="lp-win"><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Wachstum nicht mehr durch Admin gedeckelt</div>
          <div class="lp-win"><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Seriöser, moderner Auftritt</div>
          <div class="lp-win"><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Feierabend, weil das System die Arbeit macht</div>
        </div>
      </div>
    </section>

    <!-- ===== SOCIAL PROOF: Cases ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-proof-heading">
      <div class="container">
        <p class="ev-eyebrow">Echte Ergebnisse</p>
        <h2 id="lp-proof-heading" class="ev-h2">14 Tage. Vom Engpass zum laufenden System.</h2>
        <div class="lp-cases">
          <article class="lp-case">
            <span class="lp-case-metric">14 Tage</span>
            <h3>Dienstleister aus der Finanzbranche</h3>
            <p>Der Engpass war Zeit: manuelle Prozesse dauerten zu lange. Wir haben in 14 Tagen Website, Sales-Automatisierung, Lead-Anreicherung und die automatisierte Angebotserstellung aufgesetzt — und die Handarbeit rausgenommen.</p>
          </article>
          <article class="lp-case">
            <span class="lp-case-metric">5 → 10</span>
            <h3>Social-Media-Agentur</h3>
            <p>Neue Website mit klarer Strecke zum Termin — die Anfragen pro Woche haben sich von fünf auf zehn verdoppelt.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== SOCIAL PROOF: Google-Bewertungen ===== -->
    <section class="ev-section" aria-labelledby="lp-reviews-heading">
      <div class="container">
        <p class="ev-eyebrow">Was Kunden sagen</p>
        <h2 id="lp-reviews-heading" class="ev-h2" style="margin-bottom:28px;">Echte Bewertungen. Keine Versprechen.</h2>
        <div class="lp-reviews-head">
          <span class="lp-g" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="34" height="34"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06L5.84 9.9C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
          </span>
          <div>
            <p class="ev-eyebrow" style="margin-bottom:8px;">Google Bewertungen</p>
            <div class="lp-rating">
              <span class="lp-rating-num">{avgRating}</span>
              <span class="lp-starbar" style={`--pct:${avgPct}%`} aria-hidden="true"></span>
              <span class="lp-rating-count">· {reviews.length} Rezensionen</span>
            </div>
          </div>
        </div>

        <div class="lp-reviews">
          {reviews.map((r) => (
            <article class="lp-review">
              <div class="lp-review-top">
                <span class="lp-avatar">{r.initial}</span>
                <div class="lp-review-who"><strong>{r.name}</strong><span>{r.date}</span></div>
                <svg class="lp-review-g" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06L5.84 9.9C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
              </div>
              <div class="lp-review-stars" aria-label={`${r.rating} von 5 Sternen`}>{'★'.repeat(r.rating)}<span class="lp-star-empty">{'★'.repeat(5 - r.rating)}</span></div>
              <p class="lp-review-text">{r.text}</p>
            </article>
          ))}
        </div>
        {GOOGLE_PROFILE_URL && (
          <p style="text-align:center; margin-top:28px;">
            <a class="ev-btn ev-btn-ghost" href={GOOGLE_PROFILE_URL} target="_blank" rel="noopener">Alle Bewertungen auf Google ansehen →</a>
          </p>
        )}
      </div>
    </section>

    <!-- ===== GARANTIE + VERKNAPPUNG ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-gar-heading">
      <div class="container">
        <div class="ev-guarantee">
          <div class="ev-guarantee-ico" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="ev-guarantee-body">
            <p class="ev-eyebrow">Unser Risiko, nicht deins</p>
            <h2 id="lp-gar-heading" class="ev-h2">Steht es nicht in 14 Tagen, zahlst du erst, wenn es läuft.</h2>
            <p>Dein System kommt zum Festpreis, der vorher feststeht — keine Überraschungen. Wir bauen alles done-for-you und holen dir nachweislich Zeit zurück. Damit es exklusiv bleibt, nehmen wir nur <strong>3 neue Kunden pro Monat</strong> an.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== TERMIN / BUCHUNG ===== -->
    <section id="termin" class="ev-section" aria-labelledby="lp-termin-heading">
      <div class="container">
        <div class="lp-termin">
          <p class="ev-eyebrow">Dein nächster Schritt</p>
          <h2 id="lp-termin-heading" class="ev-h2">Sichere dir dein kostenloses Erstgespräch.</h2>
          <p class="ev-section-sub" style="margin-left:auto;margin-right:auto;text-align:center;">
            Trag kurz deine Daten ein — direkt danach wählst du deinen Termin für ein telefonisches
            Erstgespräch. In ~15 Minuten zeigen wir dir, wie dein System aussehen würde.
            Kostenlos, kein Pitch. Diesen Monat nur 3 Plätze.
          </p>

          <form class="contact-form lp-form" id="lead-form" novalidate data-api-url={LEAD_API_URL}>
            <input type="text" name="_hp" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true">
            <input type="hidden" name="_ts" id="lead-ts" value="">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="lf-firstName">Vorname *</label>
                <input class="form-input" type="text" id="lf-firstName" name="firstName" placeholder="Max" required autocomplete="given-name">
              </div>
              <div class="form-group">
                <label class="form-label" for="lf-lastName">Nachname *</label>
                <input class="form-input" type="text" id="lf-lastName" name="lastName" placeholder="Mustermann" required autocomplete="family-name">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="lf-email">E-Mail-Adresse *</label>
                <input class="form-input" type="email" id="lf-email" name="email" placeholder="max@dein-unternehmen.de" required autocomplete="email">
              </div>
              <div class="form-group">
                <label class="form-label" for="lf-phone">Telefonnummer *</label>
                <input class="form-input" type="tel" id="lf-phone" name="phone" placeholder="+49 …" required autocomplete="tel" inputmode="tel">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="lf-engpass">Welche Prozesse fressen bei dir am meisten Zeit? *</label>
              <textarea class="form-textarea" id="lf-engpass" name="engpass" placeholder="z. B. Dateneingabe in mehrere Systeme · Angebote von Hand · Nachfassen geht unter · abends noch Nachbereitung …" required></textarea>
            </div>
            <button type="submit" class="form-submit" id="lf-submit">Erstgespräch sichern →</button>
            <p class="form-privacy-note">
              Mit dem Absenden stimmst du unserer <a href="/datenschutz">Datenschutzerklärung</a> zu.
              Conversion-Tracking läuft nur nach Einwilligung im Cookie-Banner.
            </p>
            <div class="form-message" id="lf-message" role="alert" aria-live="polite"></div>
          </form>

          <div class="lp-form-success" id="lf-success" hidden>
            <div class="lp-form-success-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h3>Geschafft — wähl jetzt deinen Termin.</h3>
            <p>Such dir unten direkt einen freien Slot für das telefonische Erstgespräch aus. Die Bestätigung kommt sofort per E-Mail. Falls gerade nichts passt, melden wir uns bei dir.</p>
            <div class="lp-scheduler">
              <iframe id="lf-scheduler" data-src={SCHEDULER_URL} title="Erstgespräch-Termin buchen" loading="lazy" allow="fullscreen" allowfullscreen></iframe>
            </div>
          </div>

          <ul class="lp-termin-trust" role="list">
            <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Telefonisches Erstgespräch</li>
