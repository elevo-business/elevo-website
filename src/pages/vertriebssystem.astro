  <script>
    // ----- Zeit-Rechner -----
    const hoursEl = document.getElementById('calc-hours') as HTMLInputElement;
    const shareEl = document.getElementById('calc-share') as HTMLInputElement;
    const hoursOut = document.getElementById('calc-hours-out');
    const shareOut = document.getElementById('calc-share-out');
    const backOut = document.getElementById('calc-back');
    const daysOut = document.getElementById('calc-days');
    const monthOut = document.getElementById('calc-month');
    const de = new Intl.NumberFormat('de-DE');

    function paintRange(el: HTMLInputElement) {
      const pct = ((+el.value - +el.min) / (+el.max - +el.min)) * 100;
      el.style.background = `linear-gradient(90deg, var(--accent) 0%, var(--accent) ${pct}%, #E3E8EF ${pct}%, #E3E8EF 100%)`;
    }
    function updateCalc() {
      if (!hoursEl || !shareEl) return;
      const hours = +hoursEl.value, share = +shareEl.value;
      const backPerWeek = hours * share / 100;
      const backPerYear = backPerWeek * 52;
      const backPerMonth = backPerYear / 12;
      const daysBack = backPerYear / 8;
      if (hoursOut) hoursOut.textContent = hours + ' h';
      if (shareOut) shareOut.textContent = share + ' %';
      if (backOut) backOut.textContent = de.format(Math.round(backPerYear));
      if (daysOut) daysOut.textContent = de.format(Math.round(daysBack));
      if (monthOut) monthOut.textContent = de.format(Math.round(backPerMonth));
      [hoursEl, shareEl].forEach(paintRange);
    }
    if (hoursEl && shareEl) {
      [hoursEl, shareEl].forEach((el) => el.addEventListener('input', updateCalc));
      updateCalc();
    }

    // ----- Calendly Inline-Widget (Kalender-Sync + Prefill) -----
    // Laedt erst nach dem Absenden des Formulars (aktive Buchungsabsicht) und
    // fuellt Name/E-Mail/Telefon/Engpass vor -> kein doppeltes Eintippen.
    function openCalendly(data: { firstName: string; lastName: string; email: string; phone: string; engpass: string; }) {
      const el = document.getElementById('lf-calendly');
      if (!el) return;
      const url = el.dataset.url;
      if (!url) return;
      const prefill = {
        name: `${data.firstName} ${data.lastName}`.trim(),
        email: data.email,
        // a1/a2 entsprechen den benutzerdefinierten Fragen im Calendly-Event
        // (Reihenfolge im Event-Setup: 1 = Telefon, 2 = groesster Zeitfresser).
        customAnswers: { a1: data.phone, a2: data.engpass },
      };
      function init() {
        const C = (window as any).Calendly;
        if (C && typeof C.initInlineWidget === 'function') {
          el!.innerHTML = '';
          C.initInlineWidget({ url, parentElement: el, prefill });
        }
      }
      if ((window as any).Calendly) { init(); return; }
      if (!document.getElementById('calendly-widget-css')) {
        const link = document.createElement('link');
        link.id = 'calendly-widget-css';
        link.rel = 'stylesheet';
        link.href = 'https://assets.calendly.com/assets/external/widget.css';
        document.head.appendChild(link);
      }
      let s = document.getElementById('calendly-widget-js') as HTMLScriptElement | null;
      if (!s) {
        s = document.createElement('script');
        s.id = 'calendly-widget-js';
        s.src = 'https://assets.calendly.com/assets/external/widget.js';
        s.async = true;
        document.head.appendChild(s);
      }
      s.addEventListener('load', init, { once: true });
    }

    // ----- Lead-Formular -> Pipedrive (server-seitig) -> Calendly -----
    const lf = document.getElementById('lead-form') as HTMLFormElement | null;
    if (lf) {
      const tsEl = document.getElementById('lead-ts') as HTMLInputElement;
      if (tsEl) tsEl.value = String(Date.now());
      const btn = document.getElementById('lf-submit') as HTMLButtonElement;
      const msg = document.getElementById('lf-message')!;
      const success = document.getElementById('lf-success')!;
      const apiUrl = lf.dataset.apiUrl!;
      const val = (n: string) => (lf.elements.namedItem(n) as HTMLInputElement)?.value.trim() ?? '';

      lf.addEventListener('submit', async (e) => {
        e.preventDefault();
        if ((lf.elements.namedItem('_hp') as HTMLInputElement)?.value) return; // honeypot
        const ts = (lf.elements.namedItem('_ts') as HTMLInputElement)?.value;
        if (ts && Date.now() - parseInt(ts, 10) < 1500) return;

        const firstName = val('firstName'), lastName = val('lastName'), email = val('email'),
              phone = val('phone'), engpass = val('engpass');
        if (!firstName || !lastName || !email || !phone || !engpass) {
          msg.className = 'form-message error'; msg.textContent = 'Bitte füll alle Felder aus.'; return;
        }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          msg.className = 'form-message error'; msg.textContent = 'Bitte gib eine gültige E-Mail-Adresse ein.'; return;
        }

        btn.disabled = true; btn.textContent = 'Wird gesendet …';
        // Meta: event_id + fbp/fbc (nur mit Consent) -> CAPI-Dedup.
        const lead = (window as any).elevoMeta?.leadData?.() ?? null;

        // Booking hat Prioritaet: Erfolgs-Screen + Calendly SOFORT zeigen,
        // unabhaengig davon, ob die Lead-API antwortet. So blockiert ein
        // Fehler beim CRM-Sync niemals die eigentliche Terminbuchung.
        lf.hidden = true;
        success.hidden = false;
        openCalendly({ firstName, lastName, email, phone, engpass });
        success.scrollIntoView({ behavior: 'smooth', block: 'start' });

        // Conversion-Tracking
        if (typeof (window as any).gtag !== 'undefined') {
          (window as any).gtag('event', 'conversion', { send_to: 'AW-18023151518/contact_form_submit' });
        }
        if (lead) (window as any).elevoMeta?.fireLead?.(lead.metaEventId, { content_name: 'vertriebssystem' });

        // Lead an Pipedrive (best effort, blockiert die Buchung nicht).
        fetch(apiUrl, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: `${firstName} ${lastName}`.trim(),
            firstName, lastName, email, phone,
            service: 'vertriebssystem', source: 'vertriebssystem',
            message: `Erstgespräch-Anfrage über die Vertriebssystem-Landingpage.\nTelefon: ${phone}\nZeitfresser/Engpass: ${engpass}`,
            ...(lead ?? {}),
          }),
        }).catch(() => { /* CRM-Sync fehlgeschlagen; Buchung laeuft trotzdem */ });
      });
    }
  </script>
</BaseLayout>

