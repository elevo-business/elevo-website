---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ImpressumContent from '../components/legal/ImpressumContent.astro';
import '../styles/global.css';
import '../styles/rx-theme.css';
---

<BaseLayout
  title="Impressum — Elevo"
  description="Impressum von Elevo (rechtlich: ELEVO Solutions, Einzelunternehmen, M. Celik)."
  canonical="https://elevo.solutions/impressum"
  bodyClass="rx"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <SiteHeader />

  <main id="main" class="legal-page">
    <div class="container">
      <ImpressumContent />
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .legal-page {
    padding: 64px 0 96px;
    min-height: 100vh;
  }
</style>
