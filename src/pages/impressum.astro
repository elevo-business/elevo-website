---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImpressumContent from '../components/legal/ImpressumContent.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Impressum — Elevo"
  description="Impressum von Elevo (rechtlich: ELEVO Solutions, Einzelunternehmen, M. Celik)."
  canonical="https://elevo.solutions/impressum"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <main id="main" class="legal-page">
    <div class="container">
      <ImpressumContent />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .legal-page {
    padding: 140px 0 96px;
    min-height: 100vh;
  }
</style>
