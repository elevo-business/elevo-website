---
// Landingpage Mandantengewinnung für Anwaltskanzleien (alle Rechtsgebiete).
// Texte: src/config/mehrmandanten.json, Doku: MEHRMANDANTEN.md
import { Image } from 'astro:assets';
import MmLayout from '../../mehrmandanten/layouts/MmLayout.astro';
import mm from '../../config/mehrmandanten.json';
import Logo from '../../mehrmandanten/components/Logo.astro';
import CtaButton from '../../mehrmandanten/components/CtaButton.astro';
import Case from '../../mehrmandanten/components/Case.astro';
import Mock from '../../mehrmandanten/components/Mock.astro';
import heroImg from '../../mehrmandanten/images/hero-mert.jpg';
import portrait from '../../startseite/images/mert-efe-celik.jpg';
import { rich } from '../../mehrmandanten/lib/rich';

const { hero, verhalten, cases, leistungen, ablauf, about, faq, final } = mm;
---

<MmLayout title={mm.seo.title} description={mm.seo.description} stickyCta>
  <!-- Hero -->
  <div class="on-dark relative isolate overflow-hidden bg-ink-deep text-white/85">
    <div class="absolute inset-y-0 right-0 -z-10 hidden w-[56%] lg:block" aria-hidden="true">
      <Image src={heroImg} alt="" widths={[900, 1333]} sizes="56vw" loading="eager" class="size-full object-cover object-[50%_18%]" />
      <div class="absolute inset-0 bg-linear-to-r from-ink-deep via-ink-deep/55 to-transparent"></div>
      <div class="absolute inset-0 bg-linear-to-t from-ink-deep via-transparent to-ink-deep/35"></div>
    </div>

    <header class="mx-auto flex h-20 max-w-6xl items-center justify-between px-5">
      <a href={mm.paths.landing} class="text-white" aria-label="Elevo, zum Seitenanfang"><Logo /></a>
      <nav aria-label="Abschnitte" class="hidden gap-9 font-head text-[13px] font-semibold tracking-[0.08em] text-white uppercase md:flex">
        {mm.nav.map(([label, href]) => <a href={href} class="transition-colors duration-300 hover:text-mint">{label}</a>)}
      </nav>
    </header>

    <main id="inhalt" class="contents">
      <section class="mx-auto max-w-6xl px-5 pt-6 pb-14 lg:pt-14 lg:pb-20">
        <div class="max-w-[39rem]">
          <p><span class="box-decoration-clone bg-mint/90 px-2 py-0.5 text-[15px] leading-[1.9] font-medium text-ink-deep">{hero.eyebrow}</span></p>
          <h1 class="mt-4 font-display text-[3.1rem] leading-[0.95] tracking-[0.005em] text-white uppercase sm:text-[4.4rem]">{hero.headline}</h1>

          <div class="relative mt-6 -mx-5 lg:hidden" aria-hidden="true">
            <Image src={heroImg} alt="" widths={[640, 960]} sizes="100vw" loading="eager" class="aspect-[4/3] w-full object-cover object-[50%_22%]" />
            <div class="absolute inset-0 bg-linear-to-t from-ink-deep via-transparent to-ink-deep/60"></div>
          </div>

          <div class="mt-6 max-w-[34rem] space-y-5">
            {hero.paras.map((p) => <p set:html={rich(p)} />)}
          </div>
          <div class="mt-8 max-w-sm"><CtaButton /></div>
        </div>

        <ul class="mt-14 grid gap-7 border-t border-white/15 pt-8 md:grid-cols-3 md:gap-10 [&_strong]:text-mint">
          {hero.benefits.map((b) => <li set:html={rich(b)} />)}
        </ul>
      </section>
    </main>
  </div>

  <!-- Verhalten der Mandanten -->
  <section class="light bg-linear-to-b from-paper to-white" aria-labelledby="verhalten-titel">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 lg:grid-cols-12 lg:py-24">
      <div class="order-2 lg:order-1 lg:col-span-5"><Mock kind="race" /></div>
      <div class="order-1 lg:order-2 lg:col-span-7">
        <h2 id="verhalten-titel" class="h2" set:html={rich(verhalten.headline)} />
        <div class="mt-6 space-y-4">{verhalten.paras.map((p) => <p set:html={rich(p)} />)}</div>
        <p class="mt-6 font-head text-lg font-semibold text-ink">{verhalten.problemLabel}</p>
        <p class="mt-2" set:html={rich(verhalten.problem)} />
        <p class="mt-4">{verhalten.cta}</p>
        <div class="mt-7 max-w-sm"><CtaButton /></div>
      </div>
    </div>
  </section>

  <!-- Fallstudien -->
  <section id="ergebnisse" class="light bg-white" aria-labelledby="cases-titel">
    <div class="mx-auto max-w-6xl px-5 pt-10 pb-16 lg:pb-24">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <h2 id="cases-titel" class="h2 text-[2.5rem] sm:text-6xl [&_em]:block" set:html={rich(cases.headline)} />
        <p class="max-w-[17rem] font-head text-xl leading-snug font-medium text-ink [&_em]:text-teal [&_em]:not-italic" set:html={rich(cases.side)} />
      </div>
      <div class="mt-12 space-y-10 lg:space-y-14">
        {cases.items.map((item) => <Case item={item} labels={cases.labels} />)}
      </div>
      <p class="mt-8 max-w-2xl text-[15px] text-muted">{cases.note}</p>
    </div>
  </section>

  <!-- Leistungen -->
  <section id="leistungen" class="light bg-paper" aria-labelledby="leistungen-titel">
    <div class="mx-auto max-w-5xl px-5 py-16 lg:py-24">
      <h2 id="leistungen-titel" class="h2 text-[2.5rem] sm:text-5xl [&_em]:block" set:html={rich(leistungen.headline)} />
      <p class="mt-6 font-semibold text-ink">{leistungen.lead}</p>
      {leistungen.intro.map((p) => <p>{p}</p>)}

      <div class="mt-12 space-y-8">
        {leistungen.items.map((item, i) => (
          <article class="grid items-center gap-8 rounded-2xl bg-white p-6 shadow-[0_30px_70px_-40px_rgb(13_27_42/0.35)] sm:p-10 md:grid-cols-2 md:gap-12">
            <div class:list={[i % 2 === 1 && 'md:order-2']}>
              <h3 class="font-head text-2xl leading-tight font-semibold tracking-[-0.01em] text-ink sm:text-[1.7rem] [&_em]:text-teal [&_em]:not-italic" set:html={rich(item.title)} />
              <p class="mt-4">{item.text}</p>
              <ul class="checks mt-5 space-y-2.5 text-[16px]">{item.points.map((p) => <li>{p}</li>)}</ul>
              <div class="mt-7 max-w-xs"><CtaButton /></div>
            </div>
            <div class:list={['rounded-xl bg-linear-to-br from-ink to-ink-deep p-6 sm:p-9', i % 2 === 1 && 'md:order-1']}>
              <Mock kind={item.key} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Ablauf -->
  <section id="ablauf" class="light bg-white" aria-labelledby="ablauf-titel">
    <div class="mx-auto max-w-4xl px-5 py-16 lg:py-24">
      <h2 id="ablauf-titel" class="h2 max-w-xl text-[2.5rem] sm:text-5xl" set:html={rich(ablauf.headline)} />
      <ol class="mt-14">
        {ablauf.steps.map((s, i) => (
          <li class="relative pb-12 pl-12 last:pb-0 sm:pl-16">
            <span class="absolute top-2 left-0 size-3.5 rounded-[3px] bg-ink" aria-hidden="true" />
            {i < ablauf.steps.length - 1 && <span class="absolute top-8 bottom-0 left-[6px] w-px bg-ink/40" aria-hidden="true" />}
            <p class="font-head text-4xl leading-none font-medium text-ink" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-2 font-head text-xl font-medium text-ink">{s.t}</h3>
            <p class="mt-4 max-w-xl">{s.d}</p>
            <ul class="checks mt-5 space-y-2.5">{s.points.map((p) => <li>{p}</li>)}</ul>
          </li>
        ))}
      </ol>
      <div class="mt-12 max-w-sm pl-12 sm:pl-16"><CtaButton /></div>
    </div>
  </section>

  <!-- Über mich -->
  <section id="ueber-mich" class="on-dark bg-ink text-white/80" aria-labelledby="about-titel">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 lg:grid-cols-12 lg:gap-16 lg:py-24">
      <div class="lg:col-span-5">
        <Image src={portrait} alt={about.imageAlt} width={800} height={1000} class="aspect-[4/5] w-full max-w-sm rounded-2xl object-cover object-[50%_15%] lg:max-w-none" />
      </div>
      <div class="lg:col-span-7">
        <h2 id="about-titel" class="h2" set:html={rich(about.headline)} />
        <div class="mt-6 space-y-4">{about.text.map((p) => <p set:html={rich(p)} />)}</div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="light bg-paper" aria-labelledby="faq-titel">
    <div class="mx-auto max-w-3xl px-5 py-16 lg:py-24">
      <h2 id="faq-titel" class="h2 text-center">{mm.faqHeadline}</h2>
      <div class="mt-10 space-y-3">
        {faq.map((item) => (
          <details class="group rounded-xl bg-white shadow-[0_10px_30px_-22px_rgb(13_27_42/0.5)]">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-5 py-4 font-head text-[17px] font-semibold text-ink sm:px-7">
              <span>{item.q}</span>
              <svg class="size-5 shrink-0 text-teal transition-transform duration-300 group-open:rotate-45" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            </summary>
            <p class="px-5 pb-5 sm:px-7">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Abschluss -->
  <section class="on-dark bg-ink-deep text-white/80" aria-labelledby="final-titel">
    <div class="mx-auto max-w-3xl px-5 py-20 text-center lg:py-28">
      <h2 id="final-titel" class="font-display text-5xl leading-[0.95] text-white uppercase sm:text-7xl">{final.headline}</h2>
      <p class="mx-auto mt-6 max-w-xl text-lg">{final.text}</p>
      <div class="mx-auto mt-9 max-w-sm"><CtaButton /></div>
    </div>
  </section>

  <!-- Schwebender CTA auf dem Handy -->
  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-ink-deep/95 px-4 py-3 backdrop-blur md:hidden">
    <CtaButton label={mm.cta.short} class="min-h-12" />
  </div>
</MmLayout>
