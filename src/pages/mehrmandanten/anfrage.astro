---
// Qualifizierungsformular zur Landingpage /mehrmandanten. Fragen: form.steps in src/config/mehrmandanten.json
import MmLayout from '../../mehrmandanten/layouts/MmLayout.astro';
import mm from '../../config/mehrmandanten.json';
import Logo from '../../mehrmandanten/components/Logo.astro';
import QuizForm from '../../mehrmandanten/components/QuizForm.astro';
import CheckIcon from '../../mehrmandanten/components/CheckIcon.astro';

const { formPage } = mm;
const em = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---

<MmLayout title={mm.seo.formTitle} description={mm.seo.formDescription}>
  <header class="border-b border-line/70">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
      <a href={mm.paths.landing} class="text-ink" aria-label="Elevo, zurück zur Übersicht"><Logo /></a>
      <a href={mm.paths.landing} class="text-[15px] font-medium text-muted underline-offset-4 hover:text-ink hover:underline">Zurück zur Übersicht</a>
    </div>
  </header>
  <main id="inhalt" class="mx-auto grid max-w-6xl gap-10 px-5 py-10 lg:grid-cols-12 lg:gap-14 lg:py-20">
    <div class="lg:col-span-5">
      <p class="kicker">{formPage.eyebrow}</p>
      <h1 class="display mt-5 text-4xl sm:text-5xl" set:html={em(formPage.headline)} />
      <ul class="mt-7 space-y-3">
        {formPage.points.map((p) => <li class="flex items-start gap-3"><CheckIcon class="mt-1 size-5 shrink-0 text-teal" />{p}</li>)}
      </ul>
      <p class="mt-8 hidden border-l-2 border-teal pl-5 font-serif text-2xl leading-[1.2] text-ink italic lg:block">{formPage.proof}</p>
    </div>
    <div class="lg:col-span-7"><QuizForm /></div>
  </main>
</MmLayout>
