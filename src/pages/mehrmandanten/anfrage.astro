---
// Qualifizierungsformular zur Landingpage /mehrmandanten. Fragen: form.steps in src/config/mehrmandanten.json
import MmLayout from '../../mehrmandanten/layouts/MmLayout.astro';
import mm from '../../config/mehrmandanten.json';
import Logo from '../../mehrmandanten/components/Logo.astro';
import QuizForm from '../../mehrmandanten/components/QuizForm.astro';
import { rich } from '../../mehrmandanten/lib/rich';

const { formPage } = mm;

---

<MmLayout title={mm.seo.formTitle} description={mm.seo.formDescription}>
  <div class="on-dark min-h-dvh bg-linear-to-b from-ink-deep to-ink text-white/80">
    <header class="mx-auto flex h-20 max-w-6xl items-center justify-between px-5">
      <a href={mm.paths.landing} class="text-white" aria-label="Elevo, zurück zur Übersicht"><Logo /></a>
      <a href={mm.paths.landing} class="text-[15px] font-medium text-white/70 underline-offset-4 hover:text-white hover:underline">Zurück zur Übersicht</a>
    </header>
    <main id="inhalt" class="mx-auto grid max-w-6xl gap-10 px-5 pt-6 pb-20 lg:grid-cols-12 lg:gap-14 lg:pt-14">
      <div class="lg:col-span-5">
        <p><span class="bg-mint/90 px-2 py-0.5 text-[15px] font-medium text-ink-deep">{formPage.eyebrow}</span></p>
        <h1 class="h2 mt-5" set:html={rich(formPage.headline)} />
        <ul class="checks mt-7 space-y-3">{formPage.points.map((p) => <li>{p}</li>)}</ul>
        <p class="mt-8 hidden border-l border-mint pl-5 font-head text-lg leading-snug font-medium text-white lg:block">{formPage.proof}</p>
      </div>
      <div class="lg:col-span-7"><QuizForm /></div>
    </main>
  </div>
</MmLayout>
