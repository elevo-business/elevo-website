---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
import '../styles/ev-system.css';

// Monday-CRM-Formular (WorkForm, Board "Website-Anfragen Aachen (Meta-Kampagne)").
// Submissions landen direkt als Items im CRM; UTM-Parameter werden per Script
// an die Embed-URL durchgereicht (versteckte Formularfelder erfassen sie).
const MONDAY_FORM_EMBED_URL =
  import.meta.env.PUBLIC_MONDAY_FORM_EMBED_URL ??
  'https://forms.monday.com/forms/embed/58aefaa6b47bb9da5fe9504cb546959c?r=euc1';

// Google-Profil-Link (für "Auf Google ansehen").
const GOOGLE_PROFILE_URL = import.meta.env.PUBLIC_GOOGLE_PROFILE_URL ?? 'https://www.google.com/search?q=ELEVO+Solutions+Rezensionen';

// Echte Google-Rezensionen (ELEVO Solutions).
const reviews = [
  { name: 'Sahil Nayar', initial: 'S', rating: 5, date: 'vor einer Woche', text: 'Wir sind sehr zufrieden mit der Zusammenarbeit. Vom Erstgespräch bis hin zur Umsetzung verlief alles unkompliziert und vor allem super schnell.' },
  { name: 'Miguel Römgens', initial: 'M', rating: 4, date: 'vor einer Woche', text: 'Wir hatten vorher eine Website von vor zehn Jahren, die auf dem Handy kaum lesbar war. Elevo hat in knapp zwei Wochen etwas komplett Neues gebaut.' },
  { name: 'Dorian Azemi', initial: 'D', rating: 5, date: 'vor einer Woche', text: 'Top Arbeit. Schnell, professionell und überraschend unkompliziert.' },
];
const avgNum = reviews.reduce((s, r) => s + r.rating, 0) / reviews.length;
const avgRating = avgNum.toFixed(1).replace('.', ',');
const avgPct = Math.round((avgNum / 5) * 100);
---

<BaseLayout
  title="Kostenloser Website-Entwurf für Unternehmen in Aachen — Elevo"
  description="Wir bauen dir unverbindlich einen Entwurf deiner neuen Website — kostenlos, innerhalb von 48 Stunden. Gefällt er dir, bauen wir ihn fertig. Wenn nicht, kostet es dich nichts."
  canonical="https://elevo.solutions/webseite-aachen"
  noindex={true}
  eagerPageView={true}
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <header class="lp-header">
    <div class="container lp-header-inner">
      <Logo size="md" />
      <a href="#entwurf" class="ev-btn ev-btn-primary lp-header-cta">Kostenlosen Entwurf sichern</a>
    </div>
  </header>

  <main id="main">

    <!-- ===== HERO ===== -->
    <section class="ev-hero lp-hero" aria-labelledby="lp-hero-heading">
      <div class="container">
        <div class="ev-hero-grid">
          <div class="ev-hero-copy">
            <p class="ev-eyebrow">Für Unternehmen aus Aachen &amp; Umgebung</p>
            <h1 id="lp-hero-heading" class="ev-hero-h1">
              Deine neue Website.<br>
              Den ersten Entwurf gibt&rsquo;s <span class="ev-accent">kostenlos.</span>
            </h1>
            <p class="ev-hero-sub">
              Du siehst zuerst das Ergebnis — und entscheidest dann. Wir bauen dir einen
              unverbindlichen Entwurf deiner neuen Website. Gefällt er dir, bauen wir ihn fertig.
              Wenn nicht, kostet es dich keinen Cent.
            </p>
            <div class="ev-hero-ctas">
              <a href="#entwurf" class="ev-btn ev-btn-primary">
                Kostenlosen Entwurf sichern
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
            <p class="ev-hero-trust">Kostenlos · unverbindlich · Entwurf in 48 Stunden</p>
          </div>

          <aside class="lp-getcard" aria-label="Das bekommst du kostenlos">
            <p class="lp-getcard-title">Das bekommst du — kostenlos:</p>
            <ul class="lp-getcard-list" role="list">
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Einen echten Entwurf deiner neuen Website — kein Template von der Stange</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Fertig innerhalb von 48 Stunden</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Null Verpflichtung: Du entscheidest erst, wenn du das Ergebnis gesehen hast</li>
            </ul>
            <a href="#entwurf" class="ev-btn ev-btn-ghost lp-getcard-cta">Entwurf anfordern →</a>
            <p class="lp-getcard-note">Wir bauen jeden Entwurf von Hand — deshalb nehmen wir pro Monat nur eine begrenzte Zahl an Anfragen an.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ===== PROBLEM ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-problem-heading">
      <div class="container">
        <p class="ev-eyebrow">Kommt dir bekannt vor?</p>
        <h2 id="lp-problem-heading" class="ev-h2">Deine Kunden suchen online. Und finden die Konkurrenz.</h2>
        <div class="lp-pains">
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Die alte Website ist von 2015 — und sieht auf dem Handy auch so aus</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Es gibt eine Website, aber sie bringt keine einzige Anfrage</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Interessenten googeln dich — und landen beim Wettbewerber</div>
        </div>
        <p class="ev-section-sub" style="margin-top:28px;">
          Eine Website ist kein digitales Aushängeschild. Sie ist dein bester Verkäufer —
          wenn sie richtig gebaut ist. Genau das zeigen wir dir am Entwurf: kostenlos und ohne Risiko.
        </p>
      </div>
    </section>

    <!-- ===== ABLAUF (3 Schritte) ===== -->
    <section class="ev-section" aria-labelledby="lp-steps-heading">
      <div class="container">
        <p class="ev-eyebrow">So läuft&rsquo;s</p>
        <h2 id="lp-steps-heading" class="ev-h2">In drei Schritten zu deinem Entwurf.</h2>
        <div class="prozess-steps" role="list" style="margin-top:48px;">
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">01</div>
            <h3 class="step-title">Fragen beantworten</h3>
            <p class="step-desc">Eine Minute: Wer bist du, was machst du, was soll deine Website erreichen? Mehr brauchen wir nicht.</p>
          </div>
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">02</div>
            <h3 class="step-title">Entwurf erhalten</h3>
            <p class="step-desc">Innerhalb von 48 Stunden bauen wir den Entwurf deiner neuen Website — individuell für dein Unternehmen, nicht von der Stange.</p>
          </div>
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">03</div>
            <h3 class="step-title">Du entscheidest</h3>
            <p class="step-desc">Gefällt dir der Entwurf, bauen wir die Website in 14 Tagen fertig — zum Festpreis, der vorher feststeht. Wenn nicht, war&rsquo;s das. Ohne Kosten, ohne Druck.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== WARUM KOSTENLOS ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-why-heading">
      <div class="container">
        <div class="ev-guarantee">
          <div class="ev-guarantee-ico" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <div class="ev-guarantee-body">
            <p class="ev-eyebrow">Der Haken? Gibt keinen.</p>
            <h2 id="lp-why-heading" class="ev-h2">Warum machen wir das kostenlos?</h2>
            <p>
              Weil ein guter Entwurf mehr überzeugt als jedes Verkaufsgespräch. Statt dir Folien
              und Versprechen zu zeigen, zeigen wir dir deine neue Website. Wir gehen in Vorleistung —
              und sind überzeugt, dass das Ergebnis für sich spricht. Und falls nicht: Du bekommst
              trotzdem eine ehrliche Einschätzung zu deinem aktuellen Auftritt mit auf den Weg.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== REFERENZEN (live) ===== -->
    <section class="ev-section" aria-labelledby="lp-refs-heading">
      <div class="container">
        <p class="ev-eyebrow">Echte Projekte</p>
        <h2 id="lp-refs-heading" class="ev-h2">Sieh selbst, was wir bauen — live.</h2>
        <p class="ev-section-sub">Keine gestellten Screenshots: Zwei der drei Seiten kannst du direkt im Fenster öffnen und dich durchklicken.</p>

        <div class="ev-ref-grid" style="margin-top:36px;">
          <article class="ev-ref-card">
            <div class="ev-ref-frame">
              <div class="ev-ref-bar" aria-hidden="true"><i></i><i></i><i></i><em>greenchild.eu</em></div>
              <div class="ev-ref-embed">
                <iframe src="https://greenchild-preview.elevo.solutions/de/" title="GreenChild — von Elevo gebaute Website" loading="lazy" tabindex="-1" referrerpolicy="no-referrer"></iframe>
                <a class="ev-ref-overlay" href="https://greenchild-preview.elevo.solutions/de/" target="_blank" rel="noopener" aria-label="GreenChild Website live öffnen">
                  <span class="ev-ref-open"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>Live öffnen</span>
                </a>
              </div>
            </div>
            <div class="ev-ref-meta">
              <span class="ev-ref-metric">5</span>
              <div class="ev-ref-text">
                <h3>GreenChild</h3>
                <p>warme Anfragen in Woche 1 · vorher null</p>
              </div>
            </div>
          </article>

          <article class="ev-ref-card">
            <div class="ev-ref-frame">
              <div class="ev-ref-bar" aria-hidden="true"><i></i><i></i><i></i><em>elevo-business.github.io/bml</em></div>
              <div class="ev-ref-embed">
                <iframe src="https://elevo-business.github.io/bml/index.html" title="BrandsMarketingLab — von Elevo gebaute Website" loading="lazy" tabindex="-1" referrerpolicy="no-referrer"></iframe>
                <a class="ev-ref-overlay" href="https://elevo-business.github.io/bml/index.html" target="_blank" rel="noopener" aria-label="BrandsMarketingLab Website live öffnen">
                  <span class="ev-ref-open"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>Live öffnen</span>
                </a>
              </div>
            </div>
            <div class="ev-ref-meta">
              <span class="ev-ref-metric">Live</span>
              <div class="ev-ref-text">
                <h3>BrandsMarketingLab</h3>
                <p>Conversion-Website · Marketing-Agentur</p>
              </div>
            </div>
          </article>

          <article class="ev-ref-card">
            <div class="ev-ref-frame">
              <div class="ev-ref-bar" aria-hidden="true"><i></i><i></i><i></i><em>dina-roemgens.com</em></div>
              <div class="ev-ref-embed">
                <img src="/referenzen/dina-roemgens.webp" alt="Dina Römgens — von Elevo gebaute Coaching-Website" width="1280" height="740" loading="lazy" decoding="async">
                <a class="ev-ref-overlay" href="https://www.dina-roemgens.com" target="_blank" rel="noopener" aria-label="Dina Römgens Website live öffnen">
                  <span class="ev-ref-open"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>Live öffnen</span>
                </a>
              </div>
            </div>
            <div class="ev-ref-meta">
              <span class="ev-ref-metric lp-metric-text">Mehr Kunden</span>
              <div class="ev-ref-text">
                <h3>Dina Römgens</h3>
                <p>bei gleicher Anzahl Anfragen · Coaching</p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== GOOGLE-BEWERTUNGEN ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-reviews-heading">
      <div class="container">
        <p class="ev-eyebrow">Was Kunden sagen</p>
        <h2 id="lp-reviews-heading" class="ev-h2" style="margin-bottom:28px;">Echte Bewertungen. Keine Versprechen.</h2>
        <div class="lp-reviews-head">
          <span class="lp-g" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="34" height="34"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06L5.84 9.9C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
          </span>
          <div>
            <p class="ev-eyebrow" style="margin-bottom:8px;">Google Bewertungen</p>
            <div class="lp-rating">
              <span class="lp-rating-num">{avgRating}</span>
              <span class="lp-starbar" style={`--pct:${avgPct}%`} aria-hidden="true"></span>
              <span class="lp-rating-count">· {reviews.length} Rezensionen</span>
            </div>
          </div>
        </div>

        <div class="lp-reviews">
          {reviews.map((r) => (
            <article class="lp-review">
              <div class="lp-review-top">
                <span class="lp-avatar">{r.initial}</span>
                <div class="lp-review-who"><strong>{r.name}</strong><span>{r.date}</span></div>
                <svg class="lp-review-g" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06L5.84 9.9C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
              </div>
              <div class="lp-review-stars" aria-label={`${r.rating} von 5 Sternen`}>{'★'.repeat(r.rating)}<span class="lp-star-empty">{'★'.repeat(5 - r.rating)}</span></div>
              <p class="lp-review-text">{r.text}</p>
            </article>
          ))}
        </div>
        {GOOGLE_PROFILE_URL && (
          <p style="text-align:center; margin-top:28px;">
            <a class="ev-btn ev-btn-ghost" href={GOOGLE_PROFILE_URL} target="_blank" rel="noopener">Alle Bewertungen auf Google ansehen →</a>
          </p>
        )}
      </div>
    </section>

    <!-- ===== FORMULAR ===== -->
    <section id="entwurf" class="ev-section" aria-labelledby="lp-form-heading">
      <div class="container">
        <div class="lp-formwrap">
          <p class="ev-eyebrow">Dein nächster Schritt</p>
          <h2 id="lp-form-heading" class="ev-h2">Sichere dir deinen kostenlosen Entwurf.</h2>
          <p class="ev-section-sub" style="margin-left:auto;margin-right:auto;text-align:center;">
            Beantworte kurz die Fragen unten — dauert etwa eine Minute. Innerhalb von 48 Stunden
            bekommst du deinen persönlichen Entwurf. Kostenlos und unverbindlich.
          </p>

          <div class="lp-mform">
            <iframe
              id="lp-monday-form"
              data-src={MONDAY_FORM_EMBED_URL}
              title="Kostenlosen Website-Entwurf anfordern"
              loading="lazy"
            ></iframe>
          </div>

          <ul class="lp-termin-trust" role="list">
            <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Kostenlos &amp; unverbindlich</li>
            <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Entwurf innerhalb von 48 Stunden</li>
            <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Kein Spam, keine Weitergabe deiner Daten</li>
          </ul>
          <p class="form-privacy-note" style="text-align:center;">
            Mit dem Absenden stimmst du unserer <a href="/datenschutz">Datenschutzerklärung</a> zu.
            Deine Angaben nutzen wir ausschließlich, um deinen Entwurf zu erstellen und dich dazu zu kontaktieren.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== GARANTIE (fertige Website) ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-gar-heading">
      <div class="container">
        <div class="ev-guarantee">
          <div class="ev-guarantee-ico" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="ev-guarantee-body">
            <p class="ev-eyebrow">Und wenn du dich für uns entscheidest</p>
            <h2 id="lp-gar-heading" class="ev-h2">In 14 Tagen live — mit Anfragen-Garantie.</h2>
            <p>
              Entscheidest du dich nach dem Entwurf für die Zusammenarbeit, ist deine Website in
              14 Tagen live — zum Festpreis, der vorher feststeht. Bekommst du in den ersten 30 Tagen
              nach Launch keine qualifizierte Anfrage über die Seite, arbeiten wir kostenlos weiter, bis sie kommt.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== ÜBER MERT ===== -->
    <section class="ev-section" aria-labelledby="lp-mert-heading">
      <div class="container">
        <div class="ev-vision">
          <figure class="ev-vision-portrait">
            <picture>
              <source type="image/webp" srcset="/team/mert-800.webp 1x, /team/mert-1600.webp 2x">
              <img src="/team/mert-1200.jpg" alt="Mert Efe Celik, Gründer von Elevo" width="280" height="350" loading="lazy" decoding="async">
            </picture>
            <figcaption><strong>Mert Efe Celik</strong><span>Gründer · Elevo</span></figcaption>
          </figure>
          <div class="ev-vision-body">
            <p class="ev-eyebrow">Aus der Region, für die Region</p>
            <h2 id="lp-mert-heading" class="ev-h2">Kein anonymes Agentur-Postfach. Ein Ansprechpartner von hier.</h2>
            <div class="ev-vision-text">
              <p>
                Elevo sitzt in Geilenkirchen — eine halbe Stunde von Aachen. Ich bin Mert, Gründer
                von Elevo, und baue Websites, die nicht nur gut aussehen, sondern Anfragen bringen.
                Deinen Entwurf baue ich persönlich. Und wenn wir zusammenarbeiten, hast du jederzeit
                einen direkten Draht zu mir — kein Ticketsystem, keine Warteschleife.
              </p>
              <p class="ev-vision-close">Wir verkaufen keine Websites. Wir verkaufen Anfragen.</p>
            </div>
            <div class="ev-vision-ctas">
              <a href="#entwurf" class="ev-btn ev-btn-primary">Kostenlosen Entwurf sichern →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-faq-heading">
      <div class="container">
        <p class="ev-eyebrow">Häufige Fragen</p>
        <h2 id="lp-faq-heading" class="ev-h2" style="margin-bottom:32px;">Kurz beantwortet.</h2>
        <div class="lp-faq">
          <details class="lp-faq-item">
            <summary>Ist der Entwurf wirklich kostenlos?</summary>
            <p>Ja. Du bekommst einen echten Entwurf deiner neuen Website — ohne Rechnung, ohne Verpflichtung, ohne Kleingedrucktes. Du entscheidest erst danach, ob du mit uns weitergehen willst.</p>
          </details>
          <details class="lp-faq-item">
            <summary>Was kostet die fertige Website, wenn mir der Entwurf gefällt?</summary>
            <p>Das hängt vom Umfang ab — deshalb bekommst du nach dem Entwurf einen Festpreis, der vor dem Start feststeht. Keine versteckten Kosten, keine Überraschungen. Ob das für dich passt, entscheidest du in Ruhe.</p>
          </details>
          <details class="lp-faq-item">
            <summary>Was passiert, wenn mir der Entwurf nicht gefällt?</summary>
            <p>Dann war&rsquo;s das — freundlich, ohne Druck und ohne Kosten. Du bekommst trotzdem unsere ehrliche Einschätzung zu deinem aktuellen Webauftritt mit.</p>
          </details>
          <details class="lp-faq-item">
            <summary>Wie schnell ist die fertige Website online?</summary>
            <p>In 14 Tagen ab Beauftragung — mit festem Liefertermin. Texte, Aufbau, Technik und Mobiloptimierung übernehmen wir komplett für dich.</p>
          </details>
          <details class="lp-faq-item">
            <summary>Ich habe schon eine Website. Lohnt sich der Entwurf trotzdem?</summary>
            <p>Gerade dann. Der direkte Vergleich zeigt dir schwarz auf weiß, was deine aktuelle Seite liegen lässt — und was eine Website, die auf Anfragen gebaut ist, anders macht.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ===== FINAL CTA ===== -->
    <section class="ev-section" aria-labelledby="lp-final-heading">
      <div class="container">
        <div class="ev-final">
          <p class="ev-eyebrow">Kostenlos &amp; unverbindlich</p>
