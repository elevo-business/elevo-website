  <script>
    // Interaktives Schritt-Formular (eine Frage pro Screen) → elevo-api → monday.com.
    // Tracking wie funnel-check: Meta event_id VOR dem Request (nur mit Consent),
    // Server feuert CAPI, Browser-Pixel nach Erfolg mit derselben event_id
    // (Dedup), danach Redirect auf die Danke-Seite.
    const form = document.getElementById('aachen-form') as HTMLFormElement | null;
    if (form) {
      const tsEl = document.getElementById('af-ts') as HTMLInputElement;
      if (tsEl) tsEl.value = String(Date.now());

      const apiUrl = form.dataset.apiUrl!;
      const msg = document.getElementById('af-message')!;
      const steps = Array.from(form.querySelectorAll<HTMLElement>('.af-step'));
      const nextBtn = document.getElementById('af-next') as HTMLButtonElement;
      const backBtn = document.getElementById('af-back') as HTMLButtonElement;
      const privacy = document.getElementById('af-privacy')!;
      const progressLabel = document.getElementById('af-progress-label')!;
      const progressBar = document.getElementById('af-progress-bar') as HTMLElement;
      const timingInput = document.getElementById('af-timing') as HTMLInputElement;
      const TOTAL = steps.length;
      let current = 0;

      const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement)?.value.trim() ?? '';

      const utm: Record<string, string> = {};
      const params = new URLSearchParams(window.location.search);
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((k) => {
        const v = params.get(k);
        if (v) utm[k] = v;
      });

      function clearMsg() { msg.className = 'form-message'; msg.textContent = ''; }

      // FormStart an Meta melden, sobald jemand wirklich anfängt (erste
      // Eingabe oder Antwort-Klick) — einmal pro Seitenaufruf. Läuft wie
      // alle Pixel-Events nur mit Marketing-Consent (fbq existiert sonst nicht).
      let formStarted = false;
      function markFormStart() {
        if (formStarted) return;
        formStarted = true;
        if (typeof (window as any).fbq !== 'undefined') {
          (window as any).fbq('trackCustom', 'FormStart', { content_name: 'webseite-aachen' });
        }
      }
      form.addEventListener('input', markFormStart);

      // Prüft nur den aktuellen Schritt — Fehler bleiben klein und lokal.
      function validateStep(i: number): string | null {
        switch (i) {
          case 0: return val('name') ? null : 'Sag uns kurz, wie du heißt.';
          case 1: return val('company') ? null : 'Wie heißt dein Unternehmen?';
          case 2: return null; // Website ist optional
          case 3: return timingInput.value ? null : 'Wähl kurz eine Option aus.';
          case 4: return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val('email')) ? null : 'Bitte gib eine gültige E-Mail-Adresse ein.';
          case 5: return val('phone').replace(/[^0-9]/g, '').length >= 6 ? null : 'Bitte gib eine gültige Telefonnummer ein.';
          default: return null;
        }
      }

      function show(i: number) {
        current = i;
        steps.forEach((s, idx) => s.classList.toggle('is-active', idx === i));
        progressLabel.textContent = `Frage ${i + 1} von ${TOTAL}`;
        progressBar.style.width = `${Math.round(((i + 1) / TOTAL) * 100)}%`;
        backBtn.hidden = i === 0;
        const last = i === TOTAL - 1;
        nextBtn.textContent = last ? 'Kostenloses Konzept anfordern →' : 'Weiter →';
        privacy.hidden = !last;
        // Auswahl-Schritt: kein Weiter-Button nötig, Klick geht direkt weiter.
        nextBtn.hidden = i === 3 && !timingInput.value;
        clearMsg();
        const input = steps[i].querySelector<HTMLInputElement>('input.form-input');
        if (input) setTimeout(() => input.focus(), 220);
      }

      function advance() {
        const err = validateStep(current);
        if (err) {
          msg.className = 'form-message error'; msg.textContent = err;
          steps[current].querySelector<HTMLInputElement>('input.form-input')?.focus();
          return;
        }
        if (current < TOTAL - 1) show(current + 1);
        else submitLead();
      }

      nextBtn.addEventListener('click', advance);
      backBtn.addEventListener('click', () => { if (current > 0) show(current - 1); });

      // Enter springt zur nächsten Frage statt das Formular abzuschicken.
      form.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && (e.target as HTMLElement).tagName === 'INPUT') {
          e.preventDefault();
          advance();
        }
      });

      // Auswahlfrage: Klick markiert und geht automatisch weiter.
      form.querySelectorAll<HTMLButtonElement>('.af-option').forEach((btn) => {
        btn.addEventListener('click', () => {
          markFormStart();
          form.querySelectorAll('.af-option').forEach((b) => b.classList.remove('is-selected'));
          btn.classList.add('is-selected');
          timingInput.value = btn.dataset.value || '';
          setTimeout(() => { if (current === 3) advance(); }, 250);
        });
      });

      form.addEventListener('submit', (e) => e.preventDefault());

      async function submitLead() {
        if ((form!.elements.namedItem('_hp') as HTMLInputElement)?.value) return; // Honeypot
        const ts = (form!.elements.namedItem('_ts') as HTMLInputElement)?.value;

        nextBtn.disabled = true;
        const orig = nextBtn.textContent;
        nextBtn.textContent = 'Wird gesendet …';
        const lead = (window as any).elevoMeta?.leadData?.() ?? null;
        try {
          const res = await fetch(apiUrl, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: val('name'), company: val('company'), website: val('website'),
              timing: timingInput.value, email: val('email'), phone: val('phone'),
              _ts: ts,
              ...utm,
              ...(lead ?? {}),
            }),
          });
          if (!res.ok) throw new Error('bad');
          // Conversions VOR dem Redirect feuern (gleiche event_id wie CAPI).
          if (typeof (window as any).gtag !== 'undefined') {
            (window as any).gtag('event', 'conversion', { send_to: 'AW-18023151518/contact_form_submit' });
          }
          if (lead) (window as any).elevoMeta?.fireLead?.(lead.metaEventId, { content_name: 'webseite-aachen' });
          window.location.href = '/webseite-aachen/danke';
        } catch {
          msg.className = 'form-message error';
          msg.textContent = 'Etwas ist schiefgelaufen. Schreib uns direkt: hallo@elevo.solutions';
          nextBtn.disabled = false; nextBtn.textContent = orig || 'Kostenloses Konzept anfordern →';
        }
      }

      show(0);
    }
  </script>
</BaseLayout>

