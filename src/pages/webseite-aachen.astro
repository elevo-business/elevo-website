---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
import '../styles/ev-system.css';

// Natives Lead-Formular → elevo-api (/api/aachen-lead) → monday.com-Board
// "Website-Anfragen Aachen (Meta-Kampagne)". UTM-Parameter und Meta-Tracking
// (event_id für CAPI-Dedup) werden mitgesendet, Erfolg leitet auf /danke.
const LEAD_API_URL = import.meta.env.PUBLIC_AACHEN_LEAD_API_URL ?? 'https://api.elevo.solutions/api/aachen-lead';

// Echte Google-Rezensionen (ELEVO Solutions).
const reviews = [
  { name: 'Sahil Nayar', initial: 'S', rating: 5, date: 'vor einer Woche', text: 'Wir sind sehr zufrieden mit der Zusammenarbeit. Vom Erstgespräch bis hin zur Umsetzung verlief alles unkompliziert und vor allem super schnell.' },
  { name: 'Miguel Römgens', initial: 'M', rating: 4, date: 'vor einer Woche', text: 'Wir hatten vorher eine Website von vor zehn Jahren, die auf dem Handy kaum lesbar war. Elevo hat in knapp zwei Wochen etwas komplett Neues gebaut.' },
  { name: 'Dorian Azemi', initial: 'D', rating: 5, date: 'vor einer Woche', text: 'Top Arbeit. Schnell, professionell und überraschend unkompliziert.' },
];
const avgNum = reviews.reduce((s, r) => s + r.rating, 0) / reviews.length;
const avgRating = avgNum.toFixed(1).replace('.', ',');
const avgPct = Math.round((avgNum / 5) * 100);
---

<BaseLayout
  title="Kostenloses Website-Konzept für Unternehmen in Aachen — Elevo"
  description="Zielgruppenrecherche, Werbetexte, Designrichtung und eine Sichtbarkeits-Strategie für deine Region: dein individuelles Website-Konzept, erarbeitet in 2 Werktagen. Kostenlos und ohne Gegenleistung."
  canonical="https://elevo.solutions/webseite-aachen"
  noindex={true}
  eagerPageView={true}
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <header class="lp-header">
    <div class="container lp-header-inner">
      <Logo size="md" />
      <a href="#konzept" class="ev-btn ev-btn-primary lp-header-cta">Konzept anfragen</a>
    </div>
  </header>

  <main id="main">

    <!-- ===== HERO mit Formular ===== -->
    <section class="ev-hero lp-hero" aria-labelledby="lp-hero-heading">
      <div class="container">
        <div class="ev-hero-grid lp-hero-grid">
          <div class="ev-hero-copy">
            <p class="ev-eyebrow">An alle Unternehmer im Raum Aachen</p>
            <h1 id="lp-hero-heading" class="ev-hero-h1">
              Dein individuelles Website-Konzept. Mit Strategie dahinter. <span class="ev-accent">Kostenlos.</span>
            </h1>
            <p class="ev-hero-sub">
              Keine Schablone, kein Baukasten. Wir setzen uns mit deinem Unternehmen auseinander
              und erarbeiten von Hand, wie deine Website zum stärksten Verkäufer deines
              Unternehmens wird. Das fertige Konzept gehört dir. Ohne Bedingungen, ohne Gegenleistung.
            </p>
            <ul class="lp-hero-checks" role="list">
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span><strong>Zielgruppenrecherche:</strong>&nbsp;wer deine Kunden sind und wonach sie wirklich suchen</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span><strong>Werbetext-Entwürfe:</strong>&nbsp;Formulierungen, die aus Besuchern Anfragen machen</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span><strong>Designrichtung:</strong>&nbsp;ein Auftritt, der zu deinem Unternehmen passt statt zur Masse</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span><strong>SEO- und Local-Strategie:</strong>&nbsp;die Hebel, mit denen dich Aachen bei Google findet</li>
            </ul>
            <div class="lp-hero-proof" aria-label="Vertrauensnachweise">
              <span class="lp-proof-item"><span class="lp-proof-stars" aria-hidden="true">★★★★★</span>{avgRating} auf Google</span>
              <span class="lp-proof-dot" aria-hidden="true">·</span>
              <span class="lp-proof-item"><strong>20+</strong>&nbsp;Projekte 2026 realisiert</span>
              <span class="lp-proof-dot" aria-hidden="true">·</span>
              <span class="lp-proof-item">Aus der Region Aachen</span>
            </div>
          </div>

          <aside id="konzept" class="lp-formcard" aria-label="Kostenloses Website-Konzept anfordern">
            <div class="lp-formcard-head">
              <span class="lp-formcard-badge">100&nbsp;% kostenlos</span>
              <p class="lp-formcard-title">Fordere dein Konzept an</p>
              <p class="lp-formcard-sub">6 kurze Angaben. In 2 Werktagen liegt dein Konzept im Postfach.</p>
            </div>
            <form class="lp-form" id="aachen-form" novalidate data-api-url={LEAD_API_URL}>
              <input type="text" name="_hp" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true">
              <input type="hidden" name="_ts" id="af-ts" value="">
              <input type="hidden" name="timing" id="af-timing" value="">

              <div class="af-progress">
                <span class="af-progress-label" id="af-progress-label" aria-live="polite">Frage 1 von 6</span>
                <span class="af-progress-track" aria-hidden="true"><i id="af-progress-bar" style="width:16.7%"></i></span>
              </div>

              <div class="af-steps" id="af-steps">
                <div class="af-step is-active" data-step="0">
                  <label class="af-q" for="af-name">Wie heißt du?</label>
                  <input class="form-input" type="text" id="af-name" name="name" placeholder="Max Mustermann" autocomplete="name" enterkeyhint="next">
                </div>
                <div class="af-step" data-step="1">
                  <label class="af-q" for="af-company">Wie heißt dein Unternehmen?</label>
                  <input class="form-input" type="text" id="af-company" name="company" placeholder="Mustermann GmbH" autocomplete="organization" enterkeyhint="next">
                </div>
                <div class="af-step" data-step="2">
                  <label class="af-q" for="af-website">Hast du schon eine Website?</label>
                  <input class="form-input" type="text" id="af-website" name="website" placeholder="mustermann.de" autocomplete="url" inputmode="url" enterkeyhint="next">
                  <p class="lp-field-hint">Einfach leer lassen, wenn es noch keine gibt.</p>
                </div>
                <div class="af-step" data-step="3">
                  <span class="af-q" id="af-timing-label">Wann wäre der ideale Zeitpunkt für deine neue Website?</span>
                  <div class="af-options" role="radiogroup" aria-labelledby="af-timing-label">
                    <button type="button" class="af-option" data-value="So schnell wie möglich">So schnell wie möglich</button>
                    <button type="button" class="af-option" data-value="In den nächsten 1–3 Monaten">In den nächsten 1–3 Monaten</button>
                    <button type="button" class="af-option" data-value="In 3–6 Monaten">In 3–6 Monaten</button>
                    <button type="button" class="af-option" data-value="Ich schaue mich erst mal nur um">Ich schaue mich erst mal nur um</button>
                  </div>
                </div>
                <div class="af-step" data-step="4">
                  <label class="af-q" for="af-email">Wohin dürfen wir dein Konzept schicken?</label>
                  <input class="form-input" type="email" id="af-email" name="email" placeholder="max@mustermann.de" autocomplete="email" enterkeyhint="next">
                </div>
                <div class="af-step" data-step="5">
                  <label class="af-q" for="af-phone">Deine Telefonnummer für eine kurze Rückfrage</label>
                  <input class="form-input" type="tel" id="af-phone" name="phone" placeholder="+49 151 12345678" autocomplete="tel" enterkeyhint="send">
                  <p class="lp-field-hint">Kein Verkaufsanruf. Versprochen.</p>
                </div>
              </div>

              <div class="form-message" id="af-message" role="alert" aria-live="polite"></div>

              <div class="af-nav">
                <button type="button" class="af-back" id="af-back" hidden>← Zurück</button>
                <button type="button" class="form-submit af-next" id="af-next">Weiter →</button>
              </div>
              <p class="lp-privacy" id="af-privacy" hidden>Mit dem Absenden stimmst du unserer <a href="/datenschutz">Datenschutzerklärung</a> zu.</p>
            </form>
            <ul class="lp-formcard-trust" role="list">
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Ohne Gegenleistung</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>In 2 Werktagen</li>
              <li><span class="lp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Kein Spam</li>
            </ul>
            <p class="lp-formcard-note">Jedes Konzept ist Handarbeit. Pro Monat nehmen wir nur eine begrenzte Zahl an Anfragen an.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ===== PROBLEM ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-problem-heading">
      <div class="container">
        <p class="ev-eyebrow">Kommt dir bekannt vor?</p>
        <h2 id="lp-problem-heading" class="ev-h2">Deine Kunden suchen online. Und finden die Konkurrenz.</h2>
        <div class="lp-pains">
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Die Website ist Jahre alt und auf dem Handy kaum zu bedienen</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Es gibt eine Website, aber sie bringt keine einzige Anfrage</div>
          <div class="lp-pain"><span class="lp-x" aria-hidden="true">✕</span>Interessenten googeln dich und landen beim Wettbewerber</div>
        </div>
        <p class="ev-section-sub" style="margin-top:28px;">
          Das Problem ist selten die Website selbst. Es ist die fehlende Strategie dahinter:
          Wen soll sie überzeugen, mit welchen Worten, und wie wird sie überhaupt gefunden?
          Genau diese Antworten bekommst du von uns. Schwarz auf weiß, kostenlos.
        </p>
      </div>
    </section>

    <!-- ===== REFERENZEN (live) ===== -->
    <section class="ev-section" aria-labelledby="lp-refs-heading">
      <div class="container">
        <p class="ev-eyebrow">Echte Projekte</p>
        <h2 id="lp-refs-heading" class="ev-h2">So arbeiten wir. Sieh selbst, live.</h2>
        <p class="ev-section-sub">Über <strong>20 Projekte in 2026 realisiert.</strong> Drei davon kannst du hier direkt öffnen und dich durchklicken. Keine gestellten Screenshots.</p>

        <div class="ev-ref-grid" style="margin-top:36px;">
          <article class="ev-ref-card">
            <div class="ev-ref-frame">
              <div class="ev-ref-bar" aria-hidden="true"><i></i><i></i><i></i><em>greenchild.eu</em></div>
              <div class="ev-ref-embed">
                <iframe src="https://greenchild-preview.elevo.solutions/de/" title="GreenChild, von Elevo gebaute Website" loading="lazy" tabindex="-1" referrerpolicy="no-referrer"></iframe>
                <a class="ev-ref-overlay" href="https://greenchild-preview.elevo.solutions/de/" target="_blank" rel="noopener" aria-label="GreenChild Website live öffnen">
                  <span class="ev-ref-open"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>Live öffnen</span>
                </a>
              </div>
            </div>
            <div class="ev-ref-meta">
              <span class="ev-ref-metric">5</span>
              <div class="ev-ref-text">
                <h3>GreenChild</h3>
                <p>warme Anfragen in Woche 1 · vorher null</p>
              </div>
            </div>
          </article>

          <article class="ev-ref-card">
            <div class="ev-ref-frame">
              <div class="ev-ref-bar" aria-hidden="true"><i></i><i></i><i></i><em>elevo-business.github.io/bml</em></div>
              <div class="ev-ref-embed">
                <iframe src="https://elevo-business.github.io/bml/index.html" title="BrandsMarketingLab, von Elevo gebaute Website" loading="lazy" tabindex="-1" referrerpolicy="no-referrer"></iframe>
                <a class="ev-ref-overlay" href="https://elevo-business.github.io/bml/index.html" target="_blank" rel="noopener" aria-label="BrandsMarketingLab Website live öffnen">
                  <span class="ev-ref-open"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>Live öffnen</span>
                </a>
              </div>
            </div>
            <div class="ev-ref-meta">
              <span class="ev-ref-metric">Live</span>
              <div class="ev-ref-text">
                <h3>BrandsMarketingLab</h3>
                <p>Conversion-Website · Marketing-Agentur</p>
              </div>
            </div>
          </article>

          <article class="ev-ref-card">
            <div class="ev-ref-frame">
              <div class="ev-ref-bar" aria-hidden="true"><i></i><i></i><i></i><em>dinaroemgens-preview.elevo.solutions</em></div>
              <div class="ev-ref-embed">
                <iframe src="https://dinaroemgens-preview.elevo.solutions/" title="Federleicht, die neue Website von Dina Römgens, gebaut von Elevo" loading="lazy" tabindex="-1" referrerpolicy="no-referrer"></iframe>
                <a class="ev-ref-overlay" href="https://dinaroemgens-preview.elevo.solutions/" target="_blank" rel="noopener" aria-label="Dina Römgens Website live öffnen">
                  <span class="ev-ref-open"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>Live öffnen</span>
                </a>
              </div>
            </div>
            <div class="ev-ref-meta">
              <span class="ev-ref-metric lp-metric-text">Mehr Kunden</span>
              <div class="ev-ref-text">
                <h3>Dina Römgens</h3>
                <p>bei gleicher Anzahl Anfragen · Coaching</p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== WARUM KOSTENLOS ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-why-heading">
      <div class="container">
        <div class="ev-guarantee">
          <div class="ev-guarantee-ico" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <div class="ev-guarantee-body">
            <p class="ev-eyebrow">Der Haken? Gibt keinen.</p>
            <h2 id="lp-why-heading" class="ev-h2">Warum verschenken wir das?</h2>
            <p>
              Weil wir überzeugt sind, dass Qualität für sich spricht. Ein Konzept, das dich
              wirklich weiterbringt, sagt mehr über unsere Arbeit als jede Anzeige und jedes
              Verkaufsgespräch. Deshalb investieren wir die Zeit. Dein Konzept ist unsere
              Visitenkarte. Mehr steckt nicht dahinter.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== ABLAUF (3 Schritte) ===== -->
    <section class="ev-section" aria-labelledby="lp-steps-heading">
      <div class="container">
        <p class="ev-eyebrow">So läuft&rsquo;s</p>
        <h2 id="lp-steps-heading" class="ev-h2">In drei Schritten zu deinem Konzept.</h2>
        <div class="prozess-steps" role="list" style="margin-top:48px;">
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">01</div>
            <h3 class="step-title">Kurz anfragen</h3>
            <p class="step-desc">Sechs Angaben, keine Minute Aufwand. Mehr brauchen wir nicht, um für dich loszulegen.</p>
          </div>
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">02</div>
            <h3 class="step-title">Wir gehen in die Tiefe</h3>
            <p class="step-desc">Wir recherchieren deine Zielgruppe, entwerfen Werbetexte, entwickeln die Designrichtung und definieren die SEO-Ansätze für deine Region.</p>
          </div>
          <div class="prozess-step" role="listitem">
            <div class="step-num" aria-hidden="true">03</div>
            <h3 class="step-title">Dein Konzept gehört dir</h3>
            <p class="step-desc">In 2 Werktagen liegt es in deinem Postfach. Als Geschenk, ohne Bedingungen. Was du damit machst, entscheidest allein du.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SOCIAL PROOF: Zitat + Google-Bewertungen ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-reviews-heading">
      <div class="container">
        <p class="ev-eyebrow">Was Kunden sagen</p>
        <h2 id="lp-reviews-heading" class="ev-h2" style="margin-bottom:32px;">Echte Stimmen. Keine Versprechen.</h2>

        <figure class="lp-quote">
          <div class="lp-quote-stars" aria-label="5 von 5 Sternen">★★★★★</div>
          <blockquote>
            „Es lief alles komplett unkompliziert, ich musste mich um fast nichts kümmern.
            Schon in der ersten Woche kamen die ersten Anfragen über die neue Website.
            Professionell und zuverlässig abgewickelt, genau so stellt man sich das vor."
          </blockquote>
          <figcaption class="lp-quote-author">
            <img class="lp-quote-avatar" src="/testimonials/nazim-azemi.webp" alt="Nazim Azemi, Gründer und Geschäftsführer von Greenchild" width="56" height="56" loading="lazy" decoding="async">
            <span class="lp-quote-meta">
              <strong>Nazim Azemi</strong>
              <span>Gründer &amp; Geschäftsführer, Greenchild</span>
            </span>
          </figcaption>
        </figure>

        <div class="lp-reviews-head">
          <span class="lp-g" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="34" height="34"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06L5.84 9.9C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
          </span>
          <div>
            <p class="ev-eyebrow" style="margin-bottom:8px;">Google Bewertungen</p>
            <div class="lp-rating">
              <span class="lp-rating-num">{avgRating}</span>
              <span class="lp-starbar" style={`--pct:${avgPct}%`} aria-hidden="true"></span>
            </div>
          </div>
        </div>

        <div class="lp-reviews">
          {reviews.map((r) => (
            <article class="lp-review">
              <div class="lp-review-top">
                <span class="lp-avatar">{r.initial}</span>
                <div class="lp-review-who"><strong>{r.name}</strong><span>{r.date}</span></div>
                <svg class="lp-review-g" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06L5.84 9.9C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
              </div>
              <div class="lp-review-stars" aria-label={`${r.rating} von 5 Sternen`}>{'★'.repeat(r.rating)}<span class="lp-star-empty">{'★'.repeat(5 - r.rating)}</span></div>
              <p class="lp-review-text">{r.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== ÜBER MERT ===== -->
    <section class="ev-section" aria-labelledby="lp-mert-heading">
      <div class="container">
        <div class="ev-vision">
          <figure class="ev-vision-portrait">
            <picture>
              <source type="image/webp" srcset="/team/mert-800.webp 1x, /team/mert-1600.webp 2x">
              <img src="/team/mert-1200.jpg" alt="Mert Efe Celik, Gründer von Elevo" width="280" height="350" loading="lazy" decoding="async">
            </picture>
            <figcaption><strong>Mert Efe Celik</strong><span>Gründer · Elevo</span></figcaption>
          </figure>
          <div class="ev-vision-body">
            <p class="ev-eyebrow">Aus der Region, für die Region</p>
            <h2 id="lp-mert-heading" class="ev-h2">Kein anonymes Agentur-Postfach. Ein Ansprechpartner von hier.</h2>
            <div class="ev-vision-text">
              <p>
                Elevo sitzt in Geilenkirchen, eine halbe Stunde von Aachen. Ich bin Mert, Gründer
                von Elevo. Wir bauen Websites, die nicht nur gut aussehen, sondern Anfragen bringen.
                Dein Konzept erarbeite ich persönlich: mit echter Recherche zu deinem Markt, deiner
                Zielgruppe und deiner Region. Kein Ticketsystem, keine Warteschleife, ein direkter Draht.
              </p>
              <p class="ev-vision-close">Wir verkaufen keine Websites. Wir verkaufen Anfragen.</p>
            </div>
            <div class="ev-vision-ctas">
              <a href="#konzept" class="ev-btn ev-btn-primary">Kostenloses Konzept anfragen →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="ev-section ev-section-alt" aria-labelledby="lp-faq-heading">
      <div class="container">
        <p class="ev-eyebrow">Häufige Fragen</p>
        <h2 id="lp-faq-heading" class="ev-h2" style="margin-bottom:32px;">Kurz beantwortet.</h2>
        <div class="lp-faq">
