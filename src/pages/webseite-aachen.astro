  <Footer />
  <CookieBanner />

  <script>
    // Monday-Formular laden und UTM-/Klick-Parameter der Seite an die Embed-URL
    // durchreichen (versteckte Felder im Formular erfassen utm_campaign/utm_content).
    const frame = document.getElementById('lp-monday-form') as HTMLIFrameElement | null;
    if (frame && frame.dataset.src) {
      const url = new URL(frame.dataset.src);
      const params = new URLSearchParams(window.location.search);
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((k) => {
        const v = params.get(k);
        if (v) url.searchParams.set(k, v);
      });
      frame.src = url.toString();
    }
  </script>
</BaseLayout>

