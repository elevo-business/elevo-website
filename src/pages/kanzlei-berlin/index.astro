---
// Landingpage für die lokalen Meta Ads an Kanzleien im Familien- und Erbrecht in Berlin.
// Texte: src/config/kanzlei-berlin.json, Doku: KANZLEI-BERLIN.md
import KbLayout from '../../kanzlei-berlin/layouts/KbLayout.astro';
import kb from '../../config/kanzlei-berlin.json';
import Logo from '../../kanzlei-berlin/components/Logo.astro';
import Hero from '../../kanzlei-berlin/components/Hero.astro';
import QuizForm from '../../kanzlei-berlin/components/QuizForm.astro';
import Trust from '../../kanzlei-berlin/components/Trust.astro';
import Results from '../../kanzlei-berlin/components/Results.astro';
import Faq from '../../kanzlei-berlin/components/Faq.astro';
import StickyCta from '../../kanzlei-berlin/components/StickyCta.astro';
import CtaButton from '../../kanzlei-berlin/components/CtaButton.astro';
---

<KbLayout title={kb.seo.title} description={kb.seo.description} stickyCta>
  <main id="inhalt" class="px-4">
    <div class="mx-auto max-w-[720px]">
      <div class="flex justify-center pt-4"><Logo /></div>
      <Hero />
      <QuizForm />
      <Trust />

      <Results />
      <div class="mx-auto mt-8 max-w-sm"><CtaButton /></div>

      <Faq />
      <div class="mx-auto mt-8 max-w-sm"><CtaButton /></div>
    </div>
  </main>
  <StickyCta />
</KbLayout>
