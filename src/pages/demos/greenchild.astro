<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Greenchild — Nachhaltig Investieren</title>
  <link rel="preload" as="font" href="/fonts/Sora-latin.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="/fonts/Outfit-latin.woff2" type="font/woff2" crossorigin>
  <style>
    @font-face { font-family: 'Sora'; font-style: normal; font-weight: 400 800; font-display: swap; src: url('/fonts/Sora-latin.woff2') format('woff2'); }
    @font-face { font-family: 'Outfit'; font-style: normal; font-weight: 300 600; font-display: swap; src: url('/fonts/Outfit-latin.woff2') format('woff2'); }
  </style>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #071A0E; color: #E2F5EA; font-family: 'Outfit', sans-serif; }
    .nav { display: flex; justify-content: space-between; align-items: center; padding: 20px 48px; border-bottom: 1px solid rgba(16,185,129,0.2); }
    .logo { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.3rem; color: #10B981; }
    .nav-links { display: flex; gap: 32px; list-style: none; }
    .nav-links a { color: #94A3B8; text-decoration: none; font-size: 0.9rem; }
    .nav-links a:hover { color: #E2F5EA; }
    .btn { background: #10B981; color: #fff; padding: 10px 22px; border-radius: 8px; font-family: 'Outfit', sans-serif; font-weight: 500; text-decoration: none; font-size: 0.9rem; }
    .hero { padding: 100px 48px 80px; max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
    .hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: #10B981; margin-bottom: 24px; }
    .hero h1 { font-family: 'Sora', sans-serif; font-size: 3rem; font-weight: 800; line-height: 1.1; letter-spacing: -0.04em; margin-bottom: 20px; }
    .hero h1 span { color: #10B981; }
    .hero p { color: #94A3B8; font-size: 1.1rem; line-height: 1.7; margin-bottom: 32px; }
    .hero-ctas { display: flex; gap: 16px; }
    .btn-outline { border: 1px solid rgba(16,185,129,0.4); color: #10B981; padding: 10px 22px; border-radius: 8px; text-decoration: none; font-size: 0.9rem; }
    .hero-visual { background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.2); border-radius: 16px; padding: 32px; }
    .stat-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    .stat-box { background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.15); border-radius: 12px; padding: 20px; }
    .stat-val { font-family: 'Sora', sans-serif; font-size: 1.8rem; font-weight: 800; color: #10B981; }
    .stat-label { font-size: 0.75rem; color: #64748B; margin-top: 4px; }
    .chart-bar { height: 8px; background: rgba(255,255,255,0.08); border-radius: 4px; margin-top: 8px; overflow: hidden; }
    .chart-fill { height: 100%; background: linear-gradient(90deg, #10B981, #34D399); border-radius: 4px; }
    section { padding: 80px 48px; max-width: 1200px; margin: 0 auto; }
    section h2 { font-family: 'Sora', sans-serif; font-size: 2.2rem; font-weight: 800; margin-bottom: 16px; }
    .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; }
    .feature { background: rgba(16,185,129,0.05); border: 1px solid rgba(16,185,129,0.15); border-radius: 12px; padding: 28px; }
    .feature-icon { width: 48px; height: 48px; background: rgba(16,185,129,0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
    .feature h3 { font-family: 'Sora', sans-serif; font-size: 1.1rem; font-weight: 600; margin-bottom: 8px; }
    .feature p { color: #64748B; font-size: 0.9rem; line-height: 1.6; }
    footer { border-top: 1px solid rgba(16,185,129,0.15); padding: 32px 48px; text-align: center; color: #64748B; font-size: 0.8rem; }
  </style>
</head>
<body>
  <nav class="nav">
    <div class="logo">greenchild</div>
    <ul class="nav-links">
      <li><a href="#">Investieren</a></li>
      <li><a href="#">Projekte</a></li>
      <li><a href="#">Über uns</a></li>
