<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Akropolis Aachen — Griechisches Restaurant</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { overflow-x: hidden; }
    body { background: #0D0905; color: #F5F0E8; font-family: 'Outfit', sans-serif; overflow-x: hidden; min-height: 100vh; }
    .nav { display: flex; justify-content: space-between; align-items: center; padding: 20px 48px; border-bottom: 1px solid rgba(212,175,55,0.2); }
    .logo { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.3rem; color: #D4AF37; letter-spacing: 0.05em; }
    .nav-links { display: flex; gap: 32px; list-style: none; }
    .nav-links a { color: #A0916E; text-decoration: none; font-size: 0.9rem; }
    .nav-links a:hover { color: #F5F0E8; }
    .btn { background: #D4AF37; color: #0D0905; padding: 10px 22px; border-radius: 8px; font-family: 'Outfit', sans-serif; font-weight: 600; text-decoration: none; font-size: 0.9rem; }

    /* ── Hero: verbesserte Version der bestehenden Struktur ── */
    .hero {
      position: relative;
      padding: 120px 48px 100px;
      text-align: center;
      overflow: hidden;
    }
    /* Hintergrund-Schichten */
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, rgba(212,175,55,0.13) 0%, transparent 65%),
        radial-gradient(ellipse 60% 40% at 20% 100%, rgba(120,60,10,0.12) 0%, transparent 60%),
        radial-gradient(ellipse 60% 40% at 80% 100%, rgba(120,60,10,0.10) 0%, transparent 60%);
      pointer-events: none;
    }
    /* Dekoratives Mäander-Muster oben */
    .hero::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent 0%, rgba(212,175,55,0.6) 20%, #D4AF37 50%, rgba(212,175,55,0.6) 80%, transparent 100%);
      pointer-events: none;
    }
    .hero > * { position: relative; z-index: 1; }
    .hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(212,175,55,0.1); border: 1px solid rgba(212,175,55,0.3); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: #D4AF37; margin-bottom: 24px; letter-spacing: 0.08em; text-transform: uppercase; }
    .hero h1 { font-family: 'Sora', sans-serif; font-size: clamp(2.8rem, 5vw, 4rem); font-weight: 800; line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 20px; }
    .hero h1 span { color: #D4AF37; }
    .hero p { color: #A0916E; font-size: 1.1rem; line-height: 1.7; margin-bottom: 40px; max-width: 560px; margin-left: auto; margin-right: auto; }
    .hero-ctas { display: flex; gap: 16px; justify-content: center; }
    .btn-outline { border: 1px solid rgba(212,175,55,0.4); color: #D4AF37; padding: 10px 22px; border-radius: 8px; text-decoration: none; font-size: 0.9rem; }

    /* Dekorativer Mäander-Trenner unter dem Hero */
    .hero-meander {
      display: block;
      width: 100%;
      height: 18px;
      opacity: 0.35;
    }

    .stats-bar { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid rgba(212,175,55,0.15); border-bottom: 1px solid rgba(212,175,55,0.15); }
    .stat { padding: 32px 48px; text-align: center; border-right: 1px solid rgba(212,175,55,0.15); }
    .stat:last-child { border-right: none; }
    .stat-val { font-family: 'Sora', sans-serif; font-size: 2.5rem; font-weight: 800; color: #D4AF37; }
    .stat-label { color: #A0916E; font-size: 0.85rem; margin-top: 6px; }
    .menu-section { padding: 80px 48px; max-width: 1100px; margin: 0 auto; }
    .menu-section h2 { font-family: 'Sora', sans-serif; font-size: 2.2rem; font-weight: 800; text-align: center; margin-bottom: 48px; }
    .menu-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .menu-card { background: rgba(212,175,55,0.04); border: 1px solid rgba(212,175,55,0.15); border-radius: 12px; padding: 28px; }
    .menu-category { font-size: 0.7rem; color: #D4AF37; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px; }
    .menu-item { padding: 12px 0; border-bottom: 1px solid rgba(212,175,55,0.08); display: flex; justify-content: space-between; }
    .menu-item:last-child { border-bottom: none; }
    .item-name { font-size: 0.9rem; font-weight: 500; }
    .item-price { color: #D4AF37; font-weight: 600; font-size: 0.9rem; }
    .cta-section { padding: 80px 48px; text-align: center; background: rgba(212,175,55,0.03); }
    .cta-section h2 { font-family: 'Sora', sans-serif; font-size: 2.5rem; font-weight: 800; margin-bottom: 16px; }
    .cta-section p { color: #A0916E; margin-bottom: 32px; }
    footer { border-top: 1px solid rgba(212,175,55,0.15); padding: 32px 48px; text-align: center; color: #64748B; font-size: 0.8rem; }
    footer a { color: #D4AF37; text-decoration: none; }
  </style>
</head>
<body>
  <nav class="nav">
