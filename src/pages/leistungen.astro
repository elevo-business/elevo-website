---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Leistungen — ELEVO Digital Boutique"
  description="Website & Anwendungsentwicklung, Digitalisierungsberatung, Prozessdigitalisierung — maßgeschneidert für Handwerker und Mittelstand."
  canonical="https://elevo.solutions/leistungen"
>
  <a href="#hero" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <Hero
    badge="Leistungen"
    title='<span class="line">Was wir tun.</span><span class="line accent">Was Sie gewinnen.</span>'
    subtitle="Websites und Web-Apps, die Kunden bringen. Digitale Strategie. Abläufe, die Zeit sparen — persönlich, direkt und mit vollem Fokus auf Ihre Ergebnisse."
    ctaText="Projekt besprechen"
    ctaHref="/kontakt"
    secondaryCtaText="Unsere Referenzen"
    secondaryCtaHref="/referenzen"
    showVisual={true}
  />

  <!-- Leistungen -->
  <section id="leistungen" class="section" aria-labelledby="leistungen-heading">
    <div class="container">
      <header class="section-header">
        <div class="section-label reveal">Was wir machen</div>
        <h2 id="leistungen-heading" class="reveal reveal-delay-1">Individuelle Lösungen.<br>Messbare Ergebnisse.</h2>
        <p class="reveal reveal-delay-2">Kein Copy-Paste. Jedes Projekt wird strategisch geplant und handwerklich präzise umgesetzt.</p>
      </header>

      <div class="services-grid">
        <article class="service-card reveal">
          <div class="service-illustration" aria-hidden="true">
            <svg viewBox="0 0 280 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <!-- Ambient glow -->
              <ellipse cx="120" cy="80" rx="90" ry="48" style="fill: var(--accent-glow)" opacity="0.4"/>
              <!-- Browser frame -->
              <rect x="10" y="12" width="200" height="136" rx="10" fill="rgba(15,22,40,0.9)" style="stroke: var(--border-strong)" stroke-width="1.5"/>
              <!-- Toolbar bg -->
              <rect x="10" y="12" width="200" height="33" rx="10" fill="rgba(59,130,246,0.06)"/>
              <rect x="10" y="33" width="200" height="12" fill="rgba(59,130,246,0.06)"/>
              <!-- Traffic dots -->
              <circle cx="30" cy="28" r="5" fill="rgba(59,130,246,0.35)"/>
              <circle cx="44" cy="28" r="5" fill="rgba(59,130,246,0.22)"/>
              <circle cx="58" cy="28" r="5" fill="rgba(59,130,246,0.13)"/>
              <!-- Address bar -->
              <rect x="74" y="20" width="120" height="16" rx="8" fill="rgba(255,255,255,0.04)" style="stroke: var(--border)" stroke-width="1"/>
              <rect x="82" y="25" width="54" height="6" rx="3" style="fill: var(--accent)" opacity="0.45"/>
              <!-- Divider -->
              <line x1="10" y1="45" x2="210" y2="45" style="stroke: var(--border)" stroke-width="1"/>
              <!-- Code line 1 -->
              <rect x="26" y="55" width="30" height="7" rx="2" style="fill: var(--accent)" opacity="0.75"/>
              <rect x="62" y="55" width="54" height="7" rx="2" fill="rgba(148,163,184,0.35)"/>
              <rect x="122" y="55" width="12" height="7" rx="2" style="fill: var(--accent)" opacity="0.55"/>
              <rect x="140" y="55" width="36" height="7" rx="2" fill="rgba(148,163,184,0.25)"/>
              <!-- Code line 2 -->
              <rect x="36" y="69" width="18" height="6" rx="2" style="fill: var(--accent)" opacity="0.45"/>
              <rect x="60" y="69" width="68" height="6" rx="2" fill="rgba(148,163,184,0.3)"/>
              <rect x="134" y="69" width="8" height="6" rx="2" style="fill: var(--accent)" opacity="0.65"/>
              <rect x="148" y="69" width="42" height="6" rx="2" fill="rgba(148,163,184,0.2)"/>
              <!-- Code line 3 -->
              <rect x="36" y="82" width="14" height="6" rx="2" fill="rgba(245,158,11,0.5)"/>
              <rect x="56" y="82" width="44" height="6" rx="2" fill="rgba(148,163,184,0.3)"/>
              <rect x="106" y="82" width="8" height="6" rx="2" style="fill: var(--accent)" opacity="0.6"/>
              <rect x="120" y="82" width="26" height="6" rx="2" fill="rgba(16,185,129,0.4)"/>
              <!-- Code line 4 -->
              <rect x="36" y="95" width="22" height="6" rx="2" fill="rgba(148,163,184,0.35)"/>
              <rect x="64" y="95" width="8" height="6" rx="2" style="fill: var(--accent)" opacity="0.8"/>
              <rect x="78" y="95" width="24" height="6" rx="2" fill="rgba(16,185,129,0.35)"/>
              <rect x="108" y="95" width="8" height="6" rx="2" fill="rgba(148,163,184,0.25)"/>
              <!-- Code line 5 -->
              <rect x="26" y="108" width="12" height="6" rx="2" style="fill: var(--accent)" opacity="0.9"/>
              <rect x="44" y="108" width="58" height="6" rx="2" fill="rgba(148,163,184,0.2)"/>
              <!-- Cursor -->
              <rect x="108" y="106" width="2" height="10" rx="1" style="fill: var(--accent)"/>
              <!-- Line numbers gutter -->
              <rect x="10" y="45" width="12" height="103" fill="rgba(59,130,246,0.03)"/>
              <line x1="22" y1="45" x2="22" y2="148" style="stroke: var(--border)" stroke-width="0.5"/>
              <!-- Mobile device (right side) -->
              <rect x="224" y="42" width="38" height="64" rx="8" fill="rgba(10,14,26,0.95)" style="stroke: var(--border-strong)" stroke-width="1.5"/>
              <rect x="229" y="50" width="28" height="44" rx="4" fill="rgba(59,130,246,0.04)"/>
              <circle cx="243" cy="100" r="4" fill="rgba(59,130,246,0.2)"/>
              <!-- phone notch -->
              <rect x="237" y="43" width="12" height="4" rx="2" fill="rgba(10,14,26,0.95)"/>
              <!-- phone content -->
              <rect x="232" y="54" width="22" height="4" rx="1" style="fill: var(--accent)" opacity="0.5"/>
              <rect x="232" y="62" width="16" height="3" rx="1" fill="rgba(148,163,184,0.35)"/>
              <rect x="232" y="69" width="20" height="3" rx="1" fill="rgba(148,163,184,0.25)"/>
              <rect x="232" y="76" width="10" height="3" rx="1" style="fill: var(--accent)" opacity="0.35"/>
              <rect x="232" y="83" width="18" height="8" rx="2" style="fill: var(--accent)" opacity="0.15"/>
            </svg>
          </div>
          <h3 class="service-title">Website &amp; Anwendungsentwicklung</h3>
          <p class="service-desc">Keine Templates. Keine Baukästen. Wir entwickeln individuelle Websites und Web-Anwendungen — von der Firmenwebsite bis zum Kundenportal.</p>
          <ul class="service-features" aria-label="Enthaltene Leistungen">
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Individuelles Design (kein Template)</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Websites, Web-Apps &amp; Kundenportale</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Schnell auf Handy und Computer</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Kontaktformulare und Funktionen, die Anfragen bringen</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Hosting &amp; Wartung optional</li>
          </ul>
          <div class="service-price">
            <div><div class="service-price-val">ab 5.000 EUR</div><div class="service-price-note">Einmalig · Individuelles Angebot</div></div>
            <a href="/kontakt" class="service-cta">Anfragen <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </article>

        <article class="service-card featured reveal reveal-delay-1">
          <div class="service-illustration" aria-hidden="true">
            <svg viewBox="0 0 280 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <!-- Ambient glow -->
              <ellipse cx="148" cy="82" rx="78" ry="48" style="fill: var(--accent-glow)" opacity="0.4"/>
              <!-- Outer concentric rings -->
              <circle cx="148" cy="82" r="66" fill="none" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="4,10"/>
              <circle cx="148" cy="82" r="48" fill="none" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,7"/>
              <circle cx="148" cy="82" r="30" fill="none" style="stroke: rgba(59,130,246,0.22)" stroke-width="1"/>
              <!-- Compass axis lines -->
              <line x1="148" y1="16" x2="148" y2="148" style="stroke: var(--border)" stroke-width="0.8"/>
              <line x1="82" y1="82" x2="214" y2="82" style="stroke: var(--border)" stroke-width="0.8"/>
              <line x1="101" y1="35" x2="195" y2="129" style="stroke: var(--border)" stroke-width="0.5" opacity="0.5"/>
              <line x1="195" y1="35" x2="101" y2="129" style="stroke: var(--border)" stroke-width="0.5" opacity="0.5"/>
              <!-- Compass arrowheads -->
              <polygon points="148,16 143,34 148,28 153,34" style="fill: var(--accent)" opacity="0.9"/>
              <polygon points="214,82 196,77 200,82 196,87" style="fill: var(--accent)" opacity="0.65"/>
              <polygon points="148,148 153,130 148,136 143,130" fill="rgba(148,163,184,0.4)"/>
              <polygon points="82,82 100,77 96,82 100,87" fill="rgba(148,163,184,0.3)"/>
              <!-- Center -->
              <circle cx="148" cy="82" r="11" style="fill: var(--bg-card); stroke: var(--accent)" stroke-width="1.5"/>
              <circle cx="148" cy="82" r="4.5" style="fill: var(--accent)"/>
              <!-- Roadmap arc path (NE quadrant) -->
              <path d="M 172 46 Q 192 40 206 56 Q 218 72 212 92" fill="none" style="stroke: var(--accent)" stroke-width="1.5" stroke-dasharray="5,4" opacity="0.72"/>
              <!-- Checkpoint markers on roadmap -->
              <circle cx="172" cy="46" r="4" style="fill: var(--bg-deep); stroke: var(--accent)" stroke-width="1.5"/>
              <circle cx="196" cy="46" r="3" style="fill: var(--accent)" opacity="0.7"/>
              <circle cx="210" cy="60" r="3" style="fill: var(--accent)" opacity="0.6"/>
              <circle cx="212" cy="92" r="4" style="fill: var(--bg-deep); stroke: var(--accent)" stroke-width="1.5"/>
              <!-- Tick marks on roadmap -->
              <line x1="172" y1="40" x2="172" y2="52" style="stroke: var(--accent)" stroke-width="1" opacity="0.5"/>
              <line x1="212" y1="86" x2="212" y2="98" style="stroke: var(--accent)" stroke-width="1" opacity="0.5"/>
              <!-- Growth chart bars (SW quadrant) -->
              <rect x="30" y="110" width="11" height="22" rx="2" style="fill: var(--accent)" opacity="0.15"/>
              <rect x="46" y="100" width="11" height="32" rx="2" style="fill: var(--accent)" opacity="0.25"/>
              <rect x="62" y="88" width="11" height="44" rx="2" style="fill: var(--accent)" opacity="0.42"/>
              <rect x="78" y="92" width="11" height="40" rx="2" style="fill: var(--accent)" opacity="0.32"/>
              <!-- chart baseline -->
              <line x1="28" y1="132" x2="96" y2="132" style="stroke: var(--border)" stroke-width="1"/>
              <!-- trend line over bars -->
              <polyline points="35,118 51,106 67,90 84,94" fill="none" style="stroke: var(--accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
              <!-- Data scatter (NW area) -->
              <circle cx="86" cy="36" r="3" style="fill: var(--border-strong)" opacity="0.7"/>
              <circle cx="102" cy="26" r="2.5" style="fill: var(--border-strong)" opacity="0.5"/>
              <circle cx="116" cy="42" r="2" style="fill: var(--border-strong)" opacity="0.4"/>
              <circle cx="100" cy="52" r="2" style="fill: var(--border-strong)" opacity="0.3"/>
              <!-- connection lines between scatter points -->
              <line x1="86" y1="36" x2="102" y2="26" style="stroke: var(--border)" stroke-width="0.8" opacity="0.5"/>
              <line x1="102" y1="26" x2="116" y2="42" style="stroke: var(--border)" stroke-width="0.8" opacity="0.4"/>
            </svg>
          </div>
          <h3 class="service-title">Digitalisierungsberatung</h3>
          <p class="service-desc">Wo stehen Sie digital? Wir analysieren Ihre Ausgangslage, identifizieren Potenziale und entwickeln eine klare Roadmap für Ihre Digitalisierung — praxisnah und umsetzbar.</p>
          <ul class="service-features" aria-label="Enthaltene Leistungen">
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Digitaler Reifegrad-Check</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Potenzialanalyse &amp; Handlungsempfehlungen</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Technologie- &amp; Tool-Beratung</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Umsetzbare Roadmap mit Prioritäten</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Begleitung bei der Umsetzung optional</li>
          </ul>
          <div class="service-price">
            <div><div class="service-price-val">ab 500 EUR</div><div class="service-price-note">Einstiegsberatung · Individuelles Angebot</div></div>
            <a href="/kontakt" class="service-cta">Anfragen <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </article>

        <article class="service-card reveal reveal-delay-2">
          <div class="service-illustration" aria-hidden="true">
            <svg viewBox="0 0 280 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <!-- Ambient glow -->
              <ellipse cx="140" cy="100" rx="100" ry="38" style="fill: var(--accent-glow)" opacity="0.3"/>
              <!-- Integration nodes (top decorative) -->
              <circle cx="56" cy="30" r="9" fill="none" style="stroke: var(--border-strong)" stroke-width="1"/>
              <circle cx="56" cy="30" r="3" style="fill: var(--border-strong)" opacity="0.6"/>
              <circle cx="104" cy="20" r="9" fill="none" style="stroke: var(--border-strong)" stroke-width="1"/>
              <circle cx="104" cy="20" r="3" style="fill: var(--accent)" opacity="0.5"/>
              <circle cx="152" cy="30" r="9" fill="none" style="stroke: var(--border-strong)" stroke-width="1"/>
              <circle cx="152" cy="30" r="3" style="fill: var(--border-strong)" opacity="0.6"/>
              <circle cx="200" cy="20" r="9" fill="none" style="stroke: var(--border-strong)" stroke-width="1"/>
              <circle cx="200" cy="20" r="3" style="fill: var(--border-strong)" opacity="0.4"/>
              <!-- connector lines between top nodes -->
              <line x1="65" y1="27" x2="95" y2="23" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,4" opacity="0.5"/>
              <line x1="113" y1="23" x2="143" y2="27" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,4" opacity="0.5"/>
              <line x1="161" y1="27" x2="191" y2="23" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,4" opacity="0.4"/>
              <!-- top nodes → workflow lines -->
              <line x1="56" y1="39" x2="56" y2="80" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,3" opacity="0.6"/>
              <line x1="200" y1="29" x2="200" y2="80" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,3" opacity="0.5"/>
              <!-- Main workflow at y=96 -->
              <!-- Node 1: Start (circle) -->
              <circle cx="30" cy="96" r="18" fill="rgba(59,130,246,0.12)" style="stroke: var(--accent)" stroke-width="1.5"/>
              <!-- Play icon -->
              <polygon points="25,89 25,103 38,96" style="fill: var(--accent)" opacity="0.8"/>
              <!-- Arrow 1→2 -->
              <line x1="48" y1="96" x2="70" y2="96" style="stroke: var(--border-strong)" stroke-width="1.5"/>
              <polygon points="68,92 68,100 76,96" style="fill: var(--border-strong)"/>
              <!-- Node 2: Process (rounded rect) -->
              <rect x="76" y="80" width="48" height="32" rx="8" fill="rgba(59,130,246,0.08)" style="stroke: var(--accent)" stroke-width="1.5"/>
              <!-- Gear icon inside node 2 -->
              <circle cx="100" cy="96" r="8" fill="none" style="stroke: var(--accent)" stroke-width="1.5"/>
              <circle cx="100" cy="96" r="3.5" style="fill: var(--accent)"/>
              <rect x="98" y="86" width="4" height="4" rx="1" style="fill: var(--accent)"/>
              <rect x="98" y="102" width="4" height="4" rx="1" style="fill: var(--accent)"/>
              <rect x="108" y="94" width="4" height="4" rx="1" style="fill: var(--accent)"/>
              <rect x="88" y="94" width="4" height="4" rx="1" style="fill: var(--accent)"/>
              <!-- Arrow 2→3 -->
              <line x1="124" y1="96" x2="144" y2="96" style="stroke: var(--border-strong)" stroke-width="1.5"/>
              <polygon points="142,92 142,100 150,96" style="fill: var(--border-strong)"/>
              <!-- Node 3: Decision (diamond) -->
              <polygon points="168,76 192,96 168,116 144,96" fill="rgba(59,130,246,0.06)" style="stroke: var(--accent)" stroke-width="1.5"/>
              <circle cx="168" cy="96" r="4.5" style="fill: var(--accent)"/>
              <!-- Arrow 3→4 (yes - right) -->
              <line x1="192" y1="96" x2="212" y2="96" style="stroke: var(--border-strong)" stroke-width="1.5"/>
              <polygon points="210,92 210,100 218,96" style="fill: var(--border-strong)"/>
              <!-- yes indicator -->
              <circle cx="204" cy="88" r="2.5" style="fill: var(--green)" opacity="0.7"/>
              <!-- Node 4: End (circle) -->
              <circle cx="236" cy="96" r="18" fill="rgba(16,185,129,0.1)" style="stroke: var(--green)" stroke-width="1.5"/>
              <!-- Checkmark inside -->
              <polyline points="228,96 234,103 244,89" style="stroke: var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              <!-- No branch (down from decision) -->
              <line x1="168" y1="116" x2="168" y2="138" style="stroke: var(--border-strong)" stroke-width="1.5" stroke-dasharray="4,3"/>
              <!-- no indicator -->
              <circle cx="175" cy="126" r="2.5" fill="rgba(245,158,11,0.6)" opacity="0.8"/>
              <!-- Retry box -->
              <rect x="144" y="138" width="48" height="16" rx="5" fill="rgba(245,158,11,0.06)" style="stroke: rgba(245,158,11,0.35)" stroke-width="1"/>
              <!-- refresh arc inside retry box -->
              <path d="M 157 143 Q 168 139 177 143" fill="none" style="stroke: rgba(245,158,11,0.55)" stroke-width="1.5" stroke-linecap="round"/>
              <polygon points="174,141 178,145 180,140" fill="rgba(245,158,11,0.55)"/>
            </svg>
          </div>
          <h3 class="service-title">Prozessdigitalisierung</h3>
          <p class="service-desc">Manuelle Prozesse kosten Zeit und Geld. Wir analysieren, digitalisieren und automatisieren Ihre Abläufe — damit Sie sich auf Ihr Kerngeschäft konzentrieren können.</p>
          <ul class="service-features" aria-label="Enthaltene Leistungen">
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Prozessanalyse &amp; Digitalisierungskonzept</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Alle Kundendaten an einem Ort</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Zeitfressende Aufgaben automatisch erledigen</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Schulung &amp; Dokumentation</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Laufende Betreuung optional</li>
          </ul>
          <div class="service-price">
            <div><div class="service-price-val">ab 3.000 EUR</div><div class="service-price-note">Einmalig · Individuelles Angebot</div></div>
            <a href="/kontakt" class="service-cta">Anfragen <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Prozess -->
  <section id="prozess" class="section" aria-labelledby="prozess-heading">
    <div class="container">
      <header class="section-header">
        <div class="section-label reveal">Ablauf</div>
        <h2 id="prozess-heading" class="reveal reveal-delay-1">Von der ersten Idee<br>zum fertigen Ergebnis.</h2>
