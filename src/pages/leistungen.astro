---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const faqEntries = [
  { q: 'Was ist ein „qualifizierter“ Lead bei Elevo?', a: 'Ein Entscheider mit konkretem Fulfillment-Bedarf, der zu Ihren Kriterien passt — Volumen, Region und Warenart — und einem Gespräch zugestimmt hat. Keine anonymen Klicks, keine kalten Adresslisten.' },
  { q: 'Wie unterscheidet sich das von gekauften Adresslisten?', a: 'Adresslisten sind alt, geteilt und ohne echtes Interesse. Unsere Leads entstehen aus aktiver, gezielter Ansprache von Unternehmen, die gerade einen Fulfillment-Partner suchen oder wechseln wollen — und sie werden exklusiv nur an Sie vergeben.' },
  { q: 'Was passiert mit einem Lead, der nicht passt?', a: 'Falsche Kontaktdaten oder kein echtes Interesse: Die Ersatz-Garantie greift — wir ersetzen den Lead ohne Zusatzkosten.' },
  { q: 'Wie viele Leads bekomme ich pro Monat?', a: 'Das hängt von Ihrer Kapazität, Region und Zielgruppe ab — und daran, wie viele Sie abnehmen möchten. Im Erstgespräch schätzen wir gemeinsam ein, was für Ihre Fläche realistisch ist.' },
  { q: 'In welchen Regionen arbeitet Elevo?', a: 'DACH-weit: Deutschland, Österreich und Schweiz. Pro Region arbeiten wir bewusst nur mit einer begrenzten Zahl an Fulfillment-Partnern, damit Exklusivität sauber eingehalten wird.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://elevo.solutions/' },
    { '@type': 'ListItem', position: 2, name: 'Leistungen', item: 'https://elevo.solutions/leistungen' },
  ],
};

const services = [
  {
    num: '01',
    title: 'Zielgruppen-Ansprache',
    text: 'Wir identifizieren Marken, Onlinehändler und Versender mit dem Volumen, das zu Ihrer Fläche passt — und sprechen sie gezielt an. Kein Massenversand, sondern präzise Ansprache der Unternehmen, die aktuell einen Fulfillment-Partner suchen oder mit ihrem bestehenden unzufrieden sind.',
    points: ['Recherche passender Versender nach Volumen, Warenart und Region', 'Direkte Ansprache der Entscheider statt allgemeiner Info-Postfächer', 'Fokus auf Unternehmen mit aktuellem oder absehbarem Wechselbedarf'],
  },
  {
    num: '02',
    title: 'Mehrstufige Qualifizierung',
    text: 'Bevor ein Lead bei Ihnen ankommt, prüfen wir ihn gegen Ihre Kriterien. Was nicht passt, wird aussortiert — Sie sehen nur Anfragen, die zu Ihrer Kapazität, Ihrer Region und Ihrer Warenart passen.',
    points: ['Abgleich mit Ihren Kriterien: Volumen, Region, Warenart, Zeitpunkt', 'Prüfung des echten Interesses — kein „hat nur mal geklickt“', 'Direkter Draht zum Entscheider, nicht zum Praktikanten'],
  },
  {
    num: '03',
    title: 'Übergabe an Ihren Vertrieb',
    text: 'Sie bekommen den Lead sauber aufbereitet: Wer ist es, was wird gesucht, welches Volumen steckt dahinter, wann soll es starten. Ihr Vertrieb kann direkt ins Fachgespräch einsteigen, statt Kontext zu erraten.',
    points: ['Alle relevanten Angaben zum Bedarf auf einen Blick', 'Direkter Kontakt zum Entscheider', 'Exklusiv für Sie — kein Mitbewerber bekommt denselben Lead'],
  },
  {
    num: '04',
    title: 'Steuerung & Ersatz-Garantie',
    text: 'Sie steuern selbst, wie viele Leads Sie abnehmen — hoch- oder runterskalieren je nach Auslastung. Passt ein Lead nicht, greift die Ersatz-Garantie: kostenloser Ersatz ohne Diskussion.',
    points: ['Pay-per-Lead: kein Retainer, kein Setup, keine Mindestlaufzeit', 'Kostenloser Ersatz bei falschen Kontaktdaten oder fehlendem Interesse', 'Volumen flexibel an Ihre freie Kapazität anpassbar'],
  },
];

const criteria = [
  { term: 'Volumen', desc: 'Sendungsmenge und Paletten-Stellplätze passend zu Ihrer freien Kapazität.' },
  { term: 'Region', desc: 'Nur Versender, für die Ihr Standort logistisch und wirtschaftlich Sinn ergibt.' },
  { term: 'Warenart', desc: 'Passend zu Ihrem Setup — von Standard-Sortiment bis zu Spezialanforderungen.' },
  { term: 'Zeitpunkt', desc: 'Aktueller Bedarf: Unternehmen, die jetzt suchen oder konkret wechseln wollen.' },
  { term: 'Entscheider', desc: 'Sie sprechen mit der Person, die den Fulfillment-Partner tatsächlich auswählt.' },
];
---

<BaseLayout
  title="Leistungen: Leadgenerierung für Fulfillment & 3PL — Elevo"
  description="So arbeitet Elevo: gezielte Ansprache von Versendern, mehrstufige Lead-Qualifizierung, saubere Übergabe an Ihren Vertrieb. Exklusiv, Pay-per-Lead, mit Ersatz-Garantie — DACH-weit."
  canonical="https://elevo.solutions/leistungen"
>
  <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  <Header />

  <main id="main">

    <!-- ===== PAGE HERO ===== -->
    <section class="page-hero" aria-labelledby="page-heading">
      <div class="container">
        <p class="hero-eyebrow">Leistungen</p>
        <h1 id="page-heading" class="page-h1">
          Von der Ansprache<br>
          <span class="muted">bis zum fertigen Lead.</span>
        </h1>
        <p class="lead page-lead">
          Elevo übernimmt die komplette Neukundengewinnung für Fulfillment-Center und
          3PL-Dienstleister: Wir finden Versender mit passendem Volumen, qualifizieren sie
          mehrstufig und liefern sie exklusiv an Ihren Vertrieb. Sie zahlen pro Lead —
          mit Ersatz-Garantie bei Fehltreffern.
        </p>
      </div>
    </section>

    <!-- ===== LEISTUNGEN IM DETAIL ===== -->
    <section class="section section--line" aria-label="Leistungen im Detail">
      <div class="container">
        <div class="service-rows">
          {services.map((s) => (
            <article class="service-row reveal">
              <span class="service-num" aria-hidden="true">{s.num}</span>
              <div class="service-body">
                <h2 class="service-title">{s.title}</h2>
                <p class="service-text">{s.text}</p>
                <ul class="service-points" role="list">
                  {s.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== QUALIFIZIERUNGS-KRITERIEN ===== -->
    <section class="section section--alt section--line" aria-labelledby="kriterien-heading">
      <div class="container">
        <p class="kicker"><span class="kicker-num">+</span> Qualifizierung</p>
        <h2 id="kriterien-heading" class="h2 reveal">Was ein Lead erfüllen muss,<br>bevor er zu Ihnen darf.</h2>
        <dl class="criteria">
          {criteria.map((c) => (
            <div class="criterion reveal">
              <dt>{c.term}</dt>
              <dd>{c.desc}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ===== EXKLUSIV VS. GETEILT ===== -->
    <section class="section section--line" aria-labelledby="exklusiv-heading">
      <div class="container">
        <p class="kicker"><span class="kicker-num">1×</span> Exklusivität</p>
        <h2 id="exklusiv-heading" class="h2 reveal">Warum geteilte Leads<br>keine Leads sind.</h2>
        <div class="versus">
          <div class="versus-col versus-col--bad reveal">
            <p class="versus-title">Geteilte Leads (üblich am Markt)</p>
            <ul role="list">
              <li>Dieselbe Anfrage geht an drei, vier Anbieter gleichzeitig</li>
              <li>Der Versender wird von allen Seiten angerufen — genervt statt interessiert</li>
              <li>Es gewinnt, wer am schnellsten ruft oder am billigsten rechnet</li>
              <li>Ihre Abschlussquote hängt am Preiskampf, nicht an Ihrer Leistung</li>
            </ul>
          </div>
          <div class="versus-col versus-col--good reveal-late">
            <p class="versus-title">Exklusive Leads (Elevo)</p>
            <ul role="list">
              <li>Jeder Lead geht an genau einen Anbieter: Sie</li>
              <li>Der Versender erwartet Ihr Gespräch — kein kalter Kontakt</li>
              <li>Sie verkaufen über Passung und Qualität, nicht über den Preis</li>
              <li>Passt ein Lead nicht, ersetzen wir ihn — Ersatz-Garantie</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section id="faq" class="section section--alt section--line" aria-labelledby="faq-heading">
      <div class="container">
        <p class="kicker"><span class="kicker-num">?</span> Häufige Fragen</p>
        <h2 id="faq-heading" class="h2 reveal">Kurz beantwortet.</h2>
        <div class="faq reveal-late" style="margin-top: 40px;">
          {faqEntries.map(({ q, a }) => (
            <details class="faq-item">
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="section section--line final" aria-labelledby="cta-heading">
      <div class="container final-inner">
        <h2 id="cta-heading" class="h-display reveal">
          Bereit für planbare<br><span class="accent">Neukunden?</span>
        </h2>
        <p class="lead reveal-late" style="margin: 26px auto 0; text-align: center;">
          Erzählen Sie uns kurz von Ihrer Fläche und Ihren Wunsch-Versendern —
          wir melden uns mit einer ehrlichen Einschätzung, wie viele passende Leads möglich sind.
        </p>
        <div class="final-ctas reveal-late">
          <a href="/kontakt" class="btn btn-primary btn-xl">
            Erstgespräch vereinbaren
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* ================= PAGE HERO ================= */
  .page-hero {
    padding-top: clamp(72px, 10vw, 128px);
    padding-bottom: clamp(56px, 7vw, 88px);
  }
  .hero-eyebrow {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 26px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .hero-eyebrow::before { content: ''; width: 34px; height: 1px; background: var(--accent); }
  .page-h1 {
    font-size: clamp(2.6rem, 6.4vw, 5.2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }
  .page-lead { margin-top: 30px; }

  /* ================= SERVICE ROWS ================= */
  .service-rows { display: grid; }
  .service-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(36px, 4.5vw, 56px) 8px;
    border-top: 1px solid var(--border-soft);
    transition: background var(--transition);
  }
  .service-row:last-child { border-bottom: 1px solid var(--border-soft); }
  .service-row:hover { background: rgba(20, 37, 58, 0.35); }
  .service-num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    color: transparent;
    -webkit-text-stroke: 1px var(--text-muted);
    font-variant-numeric: tabular-nums;
    transition: -webkit-text-stroke var(--transition);
  }
  .service-row:hover .service-num { -webkit-text-stroke: 1px var(--accent); }
  .service-title {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .service-text { max-width: 68ch; line-height: 1.7; }
  .service-points {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .service-points li {
    position: relative;
    padding-left: 26px;
    font-size: 0.97rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  .service-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 12px;
    height: 2px;
    background: var(--accent);
  }

  /* ================= KRITERIEN ================= */
  .criteria {
    margin: clamp(40px, 5vw, 60px) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    border-top: 1px solid var(--border-soft);
    border-left: 1px solid var(--border-soft);
  }
  .criterion {
    padding: 26px 24px 30px;
    border-right: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    transition: background var(--transition);
  }
  .criterion:hover { background: rgba(20, 37, 58, 0.4); }
  .criterion dt {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .criterion dd { margin: 0; font-size: 0.94rem; line-height: 1.6; color: var(--text-secondary); }

  /* ================= VERSUS ================= */
  .versus {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 48px);
    margin-top: clamp(40px, 5vw, 60px);
  }
  .versus-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 22px;
  }
  .versus-col--bad .versus-title { color: var(--text-muted); }
  .versus-col--good .versus-title { color: var(--accent); }
  .versus-col ul { list-style: none; margin: 0; padding: 0; }
  .versus-col li {
    position: relative;
    padding: 18px 8px 18px 40px;
    border-top: 1px solid var(--border-soft);
    color: var(--text-secondary);
    line-height: 1.55;
  }
  .versus-col li:last-child { border-bottom: 1px solid var(--border-soft); }
  .versus-col li::before {
    position: absolute;
    left: 8px;
    top: 20px;
    font-family: var(--font-heading);
    font-weight: 800;
  }
  .versus-col--bad li::before { content: '✕'; color: var(--danger); font-size: 0.85rem; top: 21px; }
  .versus-col--good li::before { content: '+'; color: var(--accent); }
  .versus-col--good {
    background: linear-gradient(180deg, var(--accent-soft), transparent 55%);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 3vw, 36px);
  }

  /* ================= CTA ================= */
  .final { text-align: center; }
  .final-inner { max-width: 900px; }
  .final-ctas { margin-top: 40px; display: flex; justify-content: center; }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 860px) {
    .service-row { grid-template-columns: 1fr; gap: 16px; }
    .versus { grid-template-columns: 1fr; }
  }
</style>
