---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Leistungen — ELEVO Digital Boutique"
  description="Website & Anwendungsentwicklung, Digitalisierungsberatung, Prozessdigitalisierung — persönlich betreut, messbar erfolgreich."
  canonical="https://elevo.solutions/leistungen"
>
  <a href="#hero" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <Hero
    badge="Leistungen"
    title='<span class="line">Was wir tun.</span><span class="line accent">Was Sie gewinnen.</span>'
    subtitle="Websites und Web-Apps, die Kunden bringen. Digitale Strategie. Abläufe, die Zeit sparen — persönlich, direkt und mit vollem Fokus auf Ihre Ergebnisse."
    ctaText="Projekt besprechen"
    ctaHref="/kontakt"
    secondaryCtaText="Unsere Referenzen"
    secondaryCtaHref="/referenzen"
    showVisual={true}
  />

  <!-- Leistungen -->
  <section id="leistungen" class="section" aria-labelledby="leistungen-heading">
    <div class="container">
      <header class="section-header">
        <div class="section-label reveal">Was wir machen</div>
        <h2 id="leistungen-heading" class="reveal reveal-delay-1">Individuelle Lösungen.<br>Messbare Ergebnisse.</h2>
        <p class="reveal reveal-delay-2">Kein Copy-Paste. Jedes Projekt wird strategisch geplant und handwerklich präzise umgesetzt.</p>
      </header>

      <div class="services-grid">
        <article class="service-card reveal">
          <div class="service-illustration" aria-hidden="true">
            <svg viewBox="0 0 280 100" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <!-- Ambient glow -->
              <ellipse cx="110" cy="50" rx="86" ry="38" style="fill: var(--accent-glow)" opacity="0.4"/>
              <!-- Browser frame -->
              <rect x="10" y="6" width="198" height="88" rx="8" fill="rgba(15,22,40,0.9)" style="stroke: var(--border-strong)" stroke-width="1.5"/>
              <!-- Toolbar bg -->
              <rect x="10" y="6" width="198" height="22" rx="8" fill="rgba(59,130,246,0.06)"/>
              <rect x="10" y="20" width="198" height="8" fill="rgba(59,130,246,0.06)"/>
              <!-- Traffic dots -->
              <circle cx="28" cy="17" r="4" fill="rgba(59,130,246,0.35)"/>
              <circle cx="40" cy="17" r="4" fill="rgba(59,130,246,0.22)"/>
              <circle cx="52" cy="17" r="4" fill="rgba(59,130,246,0.13)"/>
              <!-- Address bar -->
              <rect x="66" y="11" width="108" height="12" rx="6" fill="rgba(255,255,255,0.04)" style="stroke: var(--border)" stroke-width="1"/>
              <rect x="74" y="14" width="50" height="6" rx="3" style="fill: var(--accent)" opacity="0.45"/>
              <!-- Divider -->
              <line x1="10" y1="28" x2="208" y2="28" style="stroke: var(--border)" stroke-width="1"/>
              <!-- Gutter -->
              <rect x="10" y="28" width="11" height="66" fill="rgba(59,130,246,0.03)"/>
              <line x1="21" y1="28" x2="21" y2="94" style="stroke: var(--border)" stroke-width="0.5"/>
              <!-- Code line 1 -->
              <rect x="26" y="34" width="28" height="7" rx="2" style="fill: var(--accent)" opacity="0.75"/>
              <rect x="60" y="34" width="48" height="7" rx="2" fill="rgba(148,163,184,0.35)"/>
              <rect x="114" y="34" width="10" height="7" rx="2" style="fill: var(--accent)" opacity="0.55"/>
              <rect x="130" y="34" width="34" height="7" rx="2" fill="rgba(148,163,184,0.25)"/>
              <!-- Code line 2 -->
              <rect x="34" y="45" width="16" height="6" rx="2" style="fill: var(--accent)" opacity="0.45"/>
              <rect x="56" y="45" width="62" height="6" rx="2" fill="rgba(148,163,184,0.3)"/>
              <rect x="124" y="45" width="8" height="6" rx="2" style="fill: var(--accent)" opacity="0.65"/>
              <rect x="138" y="45" width="36" height="6" rx="2" fill="rgba(148,163,184,0.2)"/>
              <!-- Code line 3 -->
              <rect x="34" y="55" width="12" height="6" rx="2" fill="rgba(245,158,11,0.5)"/>
              <rect x="52" y="55" width="40" height="6" rx="2" fill="rgba(148,163,184,0.3)"/>
              <rect x="98" y="55" width="8" height="6" rx="2" style="fill: var(--accent)" opacity="0.6"/>
              <rect x="112" y="55" width="22" height="6" rx="2" fill="rgba(16,185,129,0.4)"/>
              <!-- Code line 4 -->
              <rect x="34" y="65" width="20" height="6" rx="2" fill="rgba(148,163,184,0.35)"/>
              <rect x="60" y="65" width="8" height="6" rx="2" style="fill: var(--accent)" opacity="0.8"/>
              <rect x="74" y="65" width="22" height="6" rx="2" fill="rgba(16,185,129,0.35)"/>
              <!-- Code line 5 -->
              <rect x="26" y="75" width="10" height="6" rx="2" style="fill: var(--accent)" opacity="0.9"/>
              <rect x="42" y="75" width="50" height="6" rx="2" fill="rgba(148,163,184,0.2)"/>
              <!-- Cursor -->
              <rect x="98" y="73" width="2" height="9" rx="1" style="fill: var(--accent)"/>
              <!-- Mobile device -->
              <rect x="222" y="10" width="36" height="74" rx="7" fill="rgba(10,14,26,0.95)" style="stroke: var(--border-strong)" stroke-width="1.5"/>
              <rect x="227" y="18" width="26" height="56" rx="4" fill="rgba(59,130,246,0.04)"/>
              <circle cx="240" cy="88" r="3.5" fill="rgba(59,130,246,0.2)"/>
              <rect x="234" y="11" width="12" height="4" rx="2" fill="rgba(10,14,26,0.95)"/>
              <rect x="230" y="22" width="20" height="4" rx="1" style="fill: var(--accent)" opacity="0.5"/>
              <rect x="230" y="30" width="14" height="3" rx="1" fill="rgba(148,163,184,0.35)"/>
              <rect x="230" y="37" width="18" height="3" rx="1" fill="rgba(148,163,184,0.25)"/>
              <rect x="230" y="44" width="10" height="3" rx="1" style="fill: var(--accent)" opacity="0.35"/>
              <rect x="230" y="52" width="20" height="8" rx="2" style="fill: var(--accent)" opacity="0.15"/>
            </svg>
          </div>
          <h3 class="service-title">Website &amp; Anwendungsentwicklung</h3>
          <p class="service-desc">Keine Templates. Keine Baukästen. Wir entwickeln individuelle Websites und Web-Anwendungen — von der Firmenwebsite bis zum Kundenportal.</p>
          <ul class="service-features" aria-label="Enthaltene Leistungen">
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Individuelles Design (kein Template)</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Websites, Web-Apps &amp; Kundenportale</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Schnell auf Handy und Computer</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Kontaktformulare und Funktionen, die Anfragen bringen</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Hosting &amp; Wartung optional</li>
          </ul>
          <div class="service-price">
            <div><div class="service-price-val">ab 5.000 EUR</div><div class="service-price-note">Einmalig · Individuelles Angebot</div></div>
            <a href="/kontakt" class="service-cta">Anfragen <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </article>

        <article class="service-card featured reveal reveal-delay-1">
          <div class="service-illustration" aria-hidden="true">
            <svg viewBox="0 0 280 100" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <!-- Ambient glow -->
              <ellipse cx="148" cy="50" rx="70" ry="42" style="fill: var(--accent-glow)" opacity="0.38"/>
              <!-- Concentric rings -->
              <circle cx="148" cy="50" r="42" fill="none" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="4,10"/>
              <circle cx="148" cy="50" r="30" fill="none" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,7"/>
              <circle cx="148" cy="50" r="18" fill="none" style="stroke: rgba(59,130,246,0.22)" stroke-width="1"/>
              <!-- Compass axes -->
              <line x1="148" y1="8" x2="148" y2="92" style="stroke: var(--border)" stroke-width="0.8"/>
              <line x1="106" y1="50" x2="190" y2="50" style="stroke: var(--border)" stroke-width="0.8"/>
              <line x1="118" y1="20" x2="178" y2="80" style="stroke: var(--border)" stroke-width="0.5" opacity="0.5"/>
              <line x1="178" y1="20" x2="118" y2="80" style="stroke: var(--border)" stroke-width="0.5" opacity="0.5"/>
              <!-- Compass arrows -->
              <polygon points="148,8 144,22 148,18 152,22" style="fill: var(--accent)" opacity="0.9"/>
              <polygon points="190,50 174,46 178,50 174,54" style="fill: var(--accent)" opacity="0.65"/>
              <polygon points="148,92 152,78 148,82 144,78" fill="rgba(148,163,184,0.4)"/>
              <polygon points="106,50 122,46 118,50 122,54" fill="rgba(148,163,184,0.3)"/>
              <!-- Center -->
              <circle cx="148" cy="50" r="8" style="fill: var(--bg-card); stroke: var(--accent)" stroke-width="1.5"/>
              <circle cx="148" cy="50" r="3.5" style="fill: var(--accent)"/>
              <!-- Roadmap arc (NE quadrant) -->
              <path d="M 170 26 Q 184 22 192 34 Q 200 46 196 60" fill="none" style="stroke: var(--accent)" stroke-width="1.5" stroke-dasharray="5,4" opacity="0.72"/>
              <!-- Checkpoints -->
              <circle cx="170" cy="26" r="3.5" style="fill: var(--bg-deep); stroke: var(--accent)" stroke-width="1.5"/>
              <circle cx="190" cy="30" r="2.5" style="fill: var(--accent)" opacity="0.7"/>
              <circle cx="196" cy="47" r="2.5" style="fill: var(--accent)" opacity="0.6"/>
              <circle cx="196" cy="60" r="3.5" style="fill: var(--bg-deep); stroke: var(--accent)" stroke-width="1.5"/>
              <!-- Growth chart bars (SW) -->
              <rect x="22" y="64" width="9" height="18" rx="2" style="fill: var(--accent)" opacity="0.15"/>
              <rect x="35" y="56" width="9" height="26" rx="2" style="fill: var(--accent)" opacity="0.25"/>
              <rect x="48" y="46" width="9" height="36" rx="2" style="fill: var(--accent)" opacity="0.42"/>
              <rect x="61" y="50" width="9" height="32" rx="2" style="fill: var(--accent)" opacity="0.32"/>
              <line x1="20" y1="82" x2="76" y2="82" style="stroke: var(--border)" stroke-width="1"/>
              <polyline points="26,72 39,62 52,48 65,52" fill="none" style="stroke: var(--accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
              <!-- Data scatter (NW) -->
              <circle cx="86" cy="22" r="2.5" style="fill: var(--border-strong)" opacity="0.7"/>
              <circle cx="100" cy="14" r="2" style="fill: var(--border-strong)" opacity="0.5"/>
              <circle cx="114" cy="26" r="2" style="fill: var(--border-strong)" opacity="0.4"/>
              <line x1="86" y1="22" x2="100" y2="14" style="stroke: var(--border)" stroke-width="0.8" opacity="0.5"/>
              <line x1="100" y1="14" x2="114" y2="26" style="stroke: var(--border)" stroke-width="0.8" opacity="0.4"/>
            </svg>
          </div>
          <h3 class="service-title">Digitalisierungsberatung</h3>
          <p class="service-desc">Wo stehen Sie digital? Wir analysieren Ihre Ausgangslage, identifizieren Potenziale und entwickeln eine klare Roadmap für Ihre Digitalisierung — praxisnah und umsetzbar.</p>
          <ul class="service-features" aria-label="Enthaltene Leistungen">
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Digitaler Reifegrad-Check</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Potenzialanalyse &amp; Handlungsempfehlungen</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Technologie- &amp; Tool-Beratung</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Umsetzbare Roadmap mit Prioritäten</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Begleitung bei der Umsetzung optional</li>
          </ul>
          <div class="service-price">
            <div><div class="service-price-val">ab 500 EUR</div><div class="service-price-note">Einstiegsberatung · Individuelles Angebot</div></div>
            <a href="/kontakt" class="service-cta">Anfragen <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </article>

        <article class="service-card reveal reveal-delay-2">
          <div class="service-illustration" aria-hidden="true">
            <svg viewBox="0 0 280 100" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <!-- Ambient glow -->
              <ellipse cx="140" cy="62" rx="96" ry="30" style="fill: var(--accent-glow)" opacity="0.28"/>
              <!-- Integration nodes (top decorative) -->
              <circle cx="54" cy="16" r="7" fill="none" style="stroke: var(--border-strong)" stroke-width="1"/>
              <circle cx="54" cy="16" r="2.5" style="fill: var(--border-strong)" opacity="0.6"/>
              <circle cx="104" cy="10" r="7" fill="none" style="stroke: var(--border-strong)" stroke-width="1"/>
              <circle cx="104" cy="10" r="2.5" style="fill: var(--accent)" opacity="0.5"/>
              <circle cx="154" cy="16" r="7" fill="none" style="stroke: var(--border-strong)" stroke-width="1"/>
              <circle cx="154" cy="16" r="2.5" style="fill: var(--border-strong)" opacity="0.6"/>
              <circle cx="204" cy="10" r="7" fill="none" style="stroke: var(--border-strong)" stroke-width="1"/>
              <circle cx="204" cy="10" r="2.5" style="fill: var(--border-strong)" opacity="0.4"/>
              <!-- connectors between top nodes -->
              <line x1="61" y1="14" x2="97" y2="12" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,4" opacity="0.5"/>
              <line x1="111" y1="12" x2="147" y2="14" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,4" opacity="0.5"/>
              <line x1="161" y1="14" x2="197" y2="12" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,4" opacity="0.4"/>
              <!-- top nodes → workflow -->
              <line x1="54" y1="23" x2="54" y2="44" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,3" opacity="0.6"/>
              <line x1="204" y1="17" x2="204" y2="44" style="stroke: var(--border)" stroke-width="1" stroke-dasharray="3,3" opacity="0.5"/>
              <!-- Main workflow at y=58 -->
              <!-- Start circle -->
              <circle cx="26" cy="58" r="16" fill="rgba(59,130,246,0.12)" style="stroke: var(--accent)" stroke-width="1.5"/>
              <polygon points="21,51 21,65 34,58" style="fill: var(--accent)" opacity="0.8"/>
              <!-- Arrow 1→2 -->
              <line x1="42" y1="58" x2="62" y2="58" style="stroke: var(--border-strong)" stroke-width="1.5"/>
              <polygon points="60,54 60,62 68,58" style="fill: var(--border-strong)"/>
              <!-- Process rect -->
              <rect x="68" y="44" width="46" height="28" rx="7" fill="rgba(59,130,246,0.08)" style="stroke: var(--accent)" stroke-width="1.5"/>
              <!-- Gear inside -->
              <circle cx="91" cy="58" r="7.5" fill="none" style="stroke: var(--accent)" stroke-width="1.5"/>
              <circle cx="91" cy="58" r="3" style="fill: var(--accent)"/>
              <rect x="89" y="49" width="4" height="3.5" rx="1" style="fill: var(--accent)"/>
              <rect x="89" y="63.5" width="4" height="3.5" rx="1" style="fill: var(--accent)"/>
              <rect x="99" y="56" width="3.5" height="4" rx="1" style="fill: var(--accent)"/>
              <rect x="80" y="56" width="3.5" height="4" rx="1" style="fill: var(--accent)"/>
              <!-- Arrow 2→3 -->
              <line x1="114" y1="58" x2="134" y2="58" style="stroke: var(--border-strong)" stroke-width="1.5"/>
              <polygon points="132,54 132,62 140,58" style="fill: var(--border-strong)"/>
              <!-- Decision diamond -->
              <polygon points="158,43 178,58 158,73 138,58" fill="rgba(59,130,246,0.06)" style="stroke: var(--accent)" stroke-width="1.5"/>
              <circle cx="158" cy="58" r="4" style="fill: var(--accent)"/>
              <!-- Arrow 3→4 (yes) -->
              <line x1="178" y1="58" x2="198" y2="58" style="stroke: var(--border-strong)" stroke-width="1.5"/>
              <polygon points="196,54 196,62 204,58" style="fill: var(--border-strong)"/>
              <circle cx="190" cy="52" r="2.5" style="fill: var(--green)" opacity="0.7"/>
              <!-- End circle -->
              <circle cx="220" cy="58" r="16" fill="rgba(16,185,129,0.1)" style="stroke: var(--green)" stroke-width="1.5"/>
              <polyline points="212,58 218,65 228,51" style="stroke: var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              <!-- No branch (down from diamond) -->
              <line x1="158" y1="73" x2="158" y2="86" style="stroke: var(--border-strong)" stroke-width="1.5" stroke-dasharray="4,3"/>
              <circle cx="164" cy="78" r="2.5" fill="rgba(245,158,11,0.6)" opacity="0.8"/>
              <!-- Retry box -->
              <rect x="134" y="86" width="48" height="12" rx="4" fill="rgba(245,158,11,0.06)" style="stroke: rgba(245,158,11,0.35)" stroke-width="1"/>
              <path d="M 146 91 Q 158 87 168 91" fill="none" style="stroke: rgba(245,158,11,0.55)" stroke-width="1.5" stroke-linecap="round"/>
              <polygon points="165,89 170,93 172,88" fill="rgba(245,158,11,0.55)"/>
            </svg>
          </div>
          <h3 class="service-title">Prozessdigitalisierung</h3>
          <p class="service-desc">Manuelle Prozesse kosten Zeit und Geld. Wir analysieren, digitalisieren und automatisieren Ihre Abläufe — damit Sie sich auf Ihr Kerngeschäft konzentrieren können.</p>
          <ul class="service-features" aria-label="Enthaltene Leistungen">
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Prozessanalyse &amp; Digitalisierungskonzept</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Alle Kundendaten an einem Ort</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Zeitfressende Aufgaben automatisch erledigen</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Schulung &amp; Dokumentation</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Laufende Betreuung optional</li>
          </ul>
          <div class="service-price">
            <div><div class="service-price-val">ab 3.000 EUR</div><div class="service-price-note">Einmalig · Individuelles Angebot</div></div>
            <a href="/kontakt" class="service-cta">Anfragen <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Prozess -->
  <section id="prozess" class="section" aria-labelledby="prozess-heading">
    <div class="container">
      <header class="section-header">
        <div class="section-label reveal">Ablauf</div>
        <h2 id="prozess-heading" class="reveal reveal-delay-1">Von der ersten Idee<br>zum fertigen Ergebnis.</h2>
        <p class="reveal reveal-delay-2">Kein Chaos, kein Rätselraten — unser Prozess ist klar, schnell und transparent.</p>
      </header>

      <div class="prozess-steps" role="list">
        <div class="prozess-step reveal" role="listitem">
          <div class="step-num" aria-hidden="true">01</div>
          <h3 class="step-title">Erstgespräch</h3>
          <p class="step-desc">30 Minuten. Wir hören zu, stellen die richtigen Fragen und analysieren Ihre Ausgangssituation — kostenlos.</p>
        </div>
        <div class="prozess-step reveal reveal-delay-1" role="listitem">
          <div class="step-num" aria-hidden="true">02</div>
          <h3 class="step-title">Strategie &amp; Konzept</h3>
