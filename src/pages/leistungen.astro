              <!-- Checkpoints -->
              <circle cx="170" cy="26" r="3.5" style="fill: var(--bg-deep); stroke: var(--accent)" stroke-width="1.5"/>
              <circle cx="190" cy="30" r="2.5" style="fill: var(--accent)" opacity="0.7"/>
              <circle cx="196" cy="47" r="2.5" style="fill: var(--accent)" opacity="0.6"/>
              <circle cx="196" cy="60" r="3.5" style="fill: var(--bg-deep); stroke: var(--accent)" stroke-width="1.5"/>
              <!-- Growth chart bars (SW) -->
              <rect x="22" y="64" width="9" height="18" rx="2" style="fill: var(--accent)" opacity="0.15"/>
              <rect x="35" y="56" width="9" height="26" rx="2" style="fill: var(--accent)" opacity="0.25"/>
              <rect x="48" y="46" width="9" height="36" rx="2" style="fill: var(--accent)" opacity="0.42"/>
              <rect x="61" y="50" width="9" height="32" rx="2" style="fill: var(--accent)" opacity="0.32"/>
              <line x1="20" y1="82" x2="76" y2="82" style="stroke: var(--border)" stroke-width="1"/>
              <polyline points="26,72 39,62 52,48 65,52" fill="none" style="stroke: var(--accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
              <!-- Data scatter (NW) -->
              <circle cx="86" cy="22" r="2.5" style="fill: var(--border-strong)" opacity="0.7"/>
              <circle cx="100" cy="14" r="2" style="fill: var(--border-strong)" opacity="0.5"/>
              <circle cx="114" cy="26" r="2" style="fill: var(--border-strong)" opacity="0.4"/>
              <line x1="86" y1="22" x2="100" y2="14" style="stroke: var(--border)" stroke-width="0.8" opacity="0.5"/>
              <line x1="100" y1="14" x2="114" y2="26" style="stroke: var(--border)" stroke-width="0.8" opacity="0.4"/>
            </svg>
          </div>
          <h3 class="service-title">Terminbuchung &amp; Follow-up</h3>
          <p class="service-desc">Interessenten buchen direkt aus der Anfrage einen Termin in deinem Kalender. Und wer nicht sofort bucht, bekommt automatisches Follow-up per E-Mail und WhatsApp — kein Lead versickert mehr, während du coachst.</p>
          <ul class="service-features" aria-label="Enthaltene Leistungen">
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Online-Buchung direkt aus der Seite</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Synchron mit deinem Kalender</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Automatische Bestätigung &amp; Erinnerung</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Automatische Nachfass-Sequenzen</li>
            <li class="service-feature"><span class="check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Jede Anfrage sauber an einem Ort</li>
          </ul>
          <div class="service-price">
            <div><div class="service-price-note">Festpreis · in 14 Tagen live</div></div>
            <a href="/kontakt" class="service-cta">Funnel-Check <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </article>

        <article class="service-card reveal reveal-delay-2">
          <div class="service-illustration" aria-hidden="true">
