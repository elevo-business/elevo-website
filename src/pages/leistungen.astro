              <circle cx="104" cy="10" r="7" fill="none" style="stroke: var(--border-strong)" stroke-width="1"/>
              <circle cx="104" cy="10" r="2.5" style="fill: var(--accent)" opacity="0.5"/>
              <circle cx="154" cy="16" r="7" fill="none" style="stroke: var(--border-strong)" stroke-width="1"/>
              <circle cx="154" cy="16" r="2.5" style="fill: var(--border-strong)" opacity="0.6"/>
              <circle cx="204" cy="10" r="7" fill="none" style="stroke: var(--border-strong)" stroke-width="1"/>
