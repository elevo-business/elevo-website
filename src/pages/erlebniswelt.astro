    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 20px;
    color: var(--accent);
    white-space: nowrap;
  }

  .dataviz-badge-green {
    background: rgba(45, 212, 160, 0.12);
    border-color: rgba(45, 212, 160, 0.3);
    color: #2DD4A0;
  }

  .dataviz-badge-orange {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.3);
    color: #F59E0B;
  }

  /* Bar chart */
  .dataviz-bars {
    display: flex;
    align-items: flex-end;
    gap: 16px;
    height: 140px;
    padding-bottom: 24px;
    position: relative;
  }

  .dataviz-bar-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
  }

  .dataviz-bar-wrap {
    width: 100%;
    height: 116px;
    display: flex;
    align-items: flex-end;
  }

  .dataviz-bar {
    width: 100%;
    height: 0;
    border-radius: 4px 4px 0 0;
    position: relative;
    transition: height 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .dataviz-bar.animated {
    height: var(--target-h);
  }

  .dataviz-bar-before { background: rgba(100, 116, 139, 0.4); border: 1px solid rgba(100, 116, 139, 0.3); }
  .dataviz-bar-after  { background: rgba(59, 130, 246, 0.5);  border: 1px solid rgba(59, 130, 246, 0.4); }
  .dataviz-bar-target { background: rgba(45, 212, 160, 0.3);  border: 1px solid rgba(45, 212, 160, 0.4); border-style: dashed; }

  .dataviz-bar-val {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: -20px;
    white-space: nowrap;
  }

  .dataviz-bar-label {
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 6px;
    font-weight: 500;
  }

  /* Line chart */
  .dataviz-line-wrap {
    flex: 1;
  }

  .dataviz-line-svg {
    width: 100%;
    overflow: visible;
  }

  .dataviz-axis-label {
    font-family: var(--font-body);
    font-size: 9px;
    fill: rgba(255, 255, 255, 0.25);
  }

  .dataviz-line-path {
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .dataviz-line-path.animated { stroke-dashoffset: 0; }

  .dataviz-line-fill {
    opacity: 0;
    transition: opacity 1.8s ease;
  }

  .dataviz-line-fill.animated { opacity: 1; }

  .dataviz-line-dot {
    opacity: 0;
    transition: opacity 0.3s ease 1.6s;
  }

  .dataviz-line-dot.animated { opacity: 1; }

  .dataviz-line-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 6px;
  }

  /* Donut */
  .dataviz-donut-wrap {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dataviz-donut-svg {
    width: 120px;
    height: 120px;
  }

  .dataviz-donut-ring {
    transition: stroke-dashoffset 1.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .dataviz-donut-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  .dataviz-donut-num {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: #2DD4A0;
    line-height: 1;
  }

  .dataviz-donut-unit {
    font-family: var(--font-body);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .dataviz-donut-meta {
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--text-muted);
    text-align: center;
    margin-top: -8px;
  }

  @media (max-width: 900px) {
    .dataviz-grid { grid-template-columns: 1fr; }
  }

  /* ===========================
     3D Cards
  =========================== */
  .threed-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .threed-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    transform-style: preserve-3d;
    transform: perspective(800px) rotateX(0deg) rotateY(0deg);
    transition: transform 0.1s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    cursor: default;
    overflow: hidden;
  }

  .threed-card:hover {
    border-color: var(--border-strong);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), var(--shadow-blue);
  }

  .threed-card-accent {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(59, 130, 246, 0.03));
    border-color: rgba(59, 130, 246, 0.25);
  }

  .threed-card-accent:hover {
    border-color: rgba(59, 130, 246, 0.5);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(59, 130, 246, 0.15);
  }

  .threed-card-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    z-index: 2;
  }

  .threed-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    transition: background var(--transition), border-color var(--transition);
  }

  .threed-card:hover .threed-icon {
    background: rgba(59, 130, 246, 0.18);
    border-color: rgba(59, 130, 246, 0.4);
  }

  .threed-card-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .threed-card-desc {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .threed-card-stat {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }

  .threed-card-stat-label {
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin-top: -6px;
  }

  .threed-card-cta {
    margin-top: 4px;
  }

  .threed-cta-link {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: color var(--transition);
  }

  .threed-cta-link:hover { color: #60A5FA; }

  /* Shine overlay */
  .threed-card-shine {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    pointer-events: none;
    background: radial-gradient(circle at var(--shine-x, 50%) var(--shine-y, 50%), rgba(255,255,255,0.06) 0%, transparent 60%);
    z-index: 1;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .threed-card:hover .threed-card-shine { opacity: 1; }

  @media (max-width: 900px) {
    .threed-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .threed-grid { grid-template-columns: 1fr; }
    .particle-canvas { height: 260px; }
  }
</style>

<script>
  // =====================
  // Kreislauf Diagram
  // =====================
  (function () {
    const ecoData = [
      { title: 'Sonne',              color: '#EF9F27', next: 'Wasser',  desc: '2.200+ Sonnenstunden pro Jahr. Das Sonnenlicht treibt die Photosynthese — der Turbo für Paulownia-Wachstum.' },
      { title: 'Wasser',             color: '#378ADD', next: 'Erde',    desc: 'Regen und gezielte Bewässerung. Die Höhenlage sorgt für ideale Niederschlagsmengen und natürliche Drainage.' },
      { title: 'Erde',               color: '#A0845A', next: 'Bienen',  desc: 'Nährstoffreicher Boden mit pH 6,5. Wird durch natürlichen Dünger der Schafe ständig mit Nährstoffen versorgt.' },
      { title: 'Bienen',             color: '#EF9F27', next: 'Schafe',  desc: '200 Bienenvölker auf der Plantage. Sie bestäuben die Paulownia-Blüten und stärken das gesamte Ökosystem.' },
      { title: 'Schafe',             color: '#9C9A8E', next: 'Dünger',  desc: 'Schafe grasen zwischen den Baumreihen. Sie halten das Gras kurz und reduzieren den Maschineneinsatz.' },
      { title: 'Natürlicher Dünger', color: '#7CB342', next: 'Baum',   desc: 'Die Schafe produzieren organischen Dünger. Keine Chemie — die Nährstoffe fließen zurück in den Boden.' },
      { title: 'Paulownia-Baum',     color: '#00A86B', next: 'CO₂',    desc: 'Bis zu 5 Meter Wachstum pro Jahr. Nach 8–12 Jahren liefert jeder Baum ca. 1,1–1,4 m³ Edelholz.' },
      { title: 'CO₂-Bindung',       color: '#1D9E75', next: 'Sonne',   desc: 'Jeder Baum bindet ca. 300 kg CO₂ pro Jahr. Ca. 360 Hektar = Millionen Kilogramm CO₂-Reduktion.' },
    ];

    const nodes = document.querySelectorAll<HTMLButtonElement>('.eco-node');
    const infoInner = document.getElementById('ecoInfoInner') as HTMLElement;
    const playBtn = document.getElementById('ecoPlayBtn') as HTMLButtonElement;
    const playIcon = document.getElementById('ecoPlayIcon') as SVGElement;
    const playLabel = document.getElementById('ecoPlayLabel') as HTMLElement;

    let interval: ReturnType<typeof setInterval> | null = null;
    let currentIdx = -1;

    function showNode(i: number) {
      currentIdx = i;
      const d = ecoData[i];
      nodes.forEach((n, j) => n.classList.toggle('active', j === i));
      infoInner.classList.add('active');
      infoInner.innerHTML = `
        <div class="eco-info-head">
          <div class="eco-info-dot" style="background:${d.color}"></div>
          <div class="eco-info-title">${d.title}</div>
          <div class="eco-info-arrow">→ ${d.next}</div>
        </div>
        <p class="eco-info-desc">${d.desc}</p>
      `;
    }

    nodes.forEach((node, i) => {
      node.addEventListener('click', () => {
        if (interval) stopPlay();
        showNode(i);
      });
    });

    function startPlay() {
      let i = currentIdx < 0 ? 0 : (currentIdx + 1) % ecoData.length;
      showNode(i);
      interval = setInterval(() => {
        i = (i + 1) % ecoData.length;
        showNode(i);
      }, 4500);
      playBtn.classList.add('playing');
      playBtn.setAttribute('aria-pressed', 'true');
      playLabel.textContent = 'Stoppen';
      playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
    }

    function stopPlay() {
      if (interval) clearInterval(interval);
      interval = null;
      playBtn.classList.remove('playing');
      playBtn.setAttribute('aria-pressed', 'false');
      playLabel.textContent = 'Kreislauf starten';
      playIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"/>';
    }

    playBtn.addEventListener('click', () => {
      if (interval) stopPlay(); else startPlay();
    });
  })();

  // =====================
  // Konfigurator
  // =====================
  (function () {
    const PRICE = 249, HA = 625, VOL = 1.37, CO2 = 301, MLO = 1695, MHI = 2119;
    const BAR_COUNT = 56;

    const slider = document.getElementById('configSlider') as HTMLInputElement;
    const forestEl = document.getElementById('forestVisual') as HTMLElement;

    // Build forest bars
    for (let i = 0; i < BAR_COUNT; i++) {
      const bar = document.createElement('div');
      bar.className = 'forest-bar';
      forestEl.appendChild(bar);
    }

    function el(id: string) { return document.getElementById(id)!; }

    function fmt(n: number) { return n.toLocaleString('de-DE'); }

    function update() {
      const t = parseInt(slider.value);
      const area = t / HA;
      const vol = t * VOL;
      const co2 = t * CO2;
      const price = t * PRICE;

      slider.setAttribute('aria-valuenow', String(t));
      el('configCount').textContent = fmt(t);
      el('configPrice').textContent = fmt(price) + ' €';
      el('configArea').textContent = area.toFixed(2).replace('.', ',');
      el('configCo2').textContent = fmt(Math.round(co2));
      el('configVolume').textContent = fmt(Math.round(vol));
      el('configMarketLow').textContent = fmt(Math.round(vol * MLO));
      el('configMarketHigh').textContent = fmt(Math.round(vol * MHI));

      const bars = forestEl.querySelectorAll('.forest-bar');
      bars.forEach((b, i) => {
        const active = i < Math.ceil((t / 800) * bars.length);
        const bar = b as HTMLElement;
        bar.classList.toggle('active', active);
        if (active) {
          bar.style.height = (20 + Math.random() * 52) + 'px';
        } else {
          bar.style.height = '8px';
        }
      });
    }

    slider.addEventListener('input', update);
    update();
  })();

  // =====================
  // Partikel-Netzwerk
  // =====================
  (function () {
    const canvas = document.getElementById('particleCanvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;
    const countEl = document.getElementById('particleCount');
    const connEl = document.getElementById('connectionCount');

    let W = 0, H = 0;
    let mouse = { x: -9999, y: -9999 };

    interface Particle {
      x: number; y: number;
      vx: number; vy: number;
      r: number; opacity: number;
    }

    let particles: Particle[] = [];

    function resize() {
      const rect = canvas.getBoundingClientRect();
      W = canvas.width = rect.width * window.devicePixelRatio;
      H = canvas.height = rect.height * window.devicePixelRatio;
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }

    function spawnParticles(n = 70) {
      const w = W / window.devicePixelRatio;
      const h = H / window.devicePixelRatio;
      for (let i = 0; i < n; i++) {
        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.7,
          vy: (Math.random() - 0.5) * 0.7,
          r: Math.random() * 2 + 1,
          opacity: 0.4 + Math.random() * 0.4,
        });
      }
      if (countEl) countEl.textContent = String(particles.length);
    }

    function draw() {
      const w = W / window.devicePixelRatio;
      const h = H / window.devicePixelRatio;
      ctx.clearRect(0, 0, w, h);

      let connections = 0;
      const MAX_DIST = 130;
      const MOUSE_DIST = 100;
      const MAX_SPEED = 2.5;

      // Update + draw particles
      for (const p of particles) {
        // Mouse repulsion
        const dx = p.x - mouse.x;
        const dy = p.y - mouse.y;
        const d = Math.hypot(dx, dy);
        if (d < MOUSE_DIST && d > 0) {
          const force = (MOUSE_DIST - d) / MOUSE_DIST * 0.6;
          p.vx += (dx / d) * force;
          p.vy += (dy / d) * force;
        }

        // Speed limit
        const speed = Math.hypot(p.vx, p.vy);
        if (speed > MAX_SPEED) { p.vx *= MAX_SPEED / speed; p.vy *= MAX_SPEED / speed; }

        // Damping
        p.vx *= 0.99;
        p.vy *= 0.99;

        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0) { p.x = 0; p.vx *= -1; }
        if (p.x > w) { p.x = w; p.vx *= -1; }
        if (p.y < 0) { p.y = 0; p.vy *= -1; }
        if (p.y > h) { p.y = h; p.vy *= -1; }

        // Draw dot
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(59, 130, 246, ${p.opacity})`;
        ctx.fill();
      }

      // Draw connections
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const a = particles[i], b = particles[j];
          const dist = Math.hypot(a.x - b.x, a.y - b.y);
          if (dist < MAX_DIST) {
            const alpha = (1 - dist / MAX_DIST) * 0.3;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = `rgba(59, 130, 246, ${alpha})`;
            ctx.lineWidth = 1;
            ctx.stroke();
            connections++;
          }
        }
      }

      if (connEl) connEl.textContent = String(connections);
      requestAnimationFrame(draw);
    }

    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    canvas.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    });

    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const cx = e.clientX - rect.left;
      const cy = e.clientY - rect.top;
      // Burst: add 8 particles near click, remove oldest if over 100
      for (let i = 0; i < 8; i++) {
        particles.push({
          x: cx + (Math.random() - 0.5) * 40,
          y: cy + (Math.random() - 0.5) * 40,
          vx: (Math.random() - 0.5) * 3,
          vy: (Math.random() - 0.5) * 3,
          r: Math.random() * 2 + 1,
          opacity: 0.5 + Math.random() * 0.4,
        });
      }
      while (particles.length > 120) particles.shift();
      if (countEl) countEl.textContent = String(particles.length);
    });

    window.addEventListener('resize', () => {
      resize();
    });

    resize();
    spawnParticles(70);
    draw();
  })();

  // =====================
  // Data Visualisierung — scroll-triggered
  // =====================
  (function () {
    const SCORE = 94;
    const circumference = 2 * Math.PI * 48; // r=48

    function animateViz() {
      // Bars
      document.querySelectorAll<HTMLElement>('.dataviz-bar').forEach(bar => {
        bar.classList.add('animated');
      });

      // Line + fill + dot
      document.querySelectorAll('.dataviz-line-path, .dataviz-line-fill, .dataviz-line-dot').forEach(el => {
        el.classList.add('animated');
      });

      // Donut ring
      const ring = document.querySelector<SVGCircleElement>('.dataviz-donut-ring');
      if (ring) {
        const offset = circumference - (SCORE / 100) * circumference;
        ring.style.strokeDashoffset = String(offset);
      }

      // Donut number count-up
      const numEl = document.getElementById('donutNum');
      if (numEl) {
        let n = 0;
        const target = SCORE;
        const step = () => {
          n = Math.min(n + 2, target);
          numEl.textContent = String(n);
          if (n < target) requestAnimationFrame(step);
        };
        setTimeout(() => requestAnimationFrame(step), 400);
      }
    }

    const vizSection = document.querySelector('#dataviz-heading')?.closest('section');
    if (!vizSection) return;

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            animateViz();
            obs.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );
    obs.observe(vizSection);
  })();

  // =====================
  // 3D Card Tilt + Shine
  // =====================
  (function () {
    const cards = document.querySelectorAll<HTMLElement>('[data-threed]');

    cards.forEach(card => {
      const shine = card.querySelector<HTMLElement>('.threed-card-shine');

      card.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = (e.clientX - cx) / (rect.width / 2);
        const dy = (e.clientY - cy) / (rect.height / 2);

        card.style.transform = `perspective(900px) rotateY(${dx * 10}deg) rotateX(${-dy * 10}deg) scale(1.02)`;

        // Shine position
        if (shine) {
          const sx = ((e.clientX - rect.left) / rect.width) * 100;
          const sy = ((e.clientY - rect.top) / rect.height) * 100;
          shine.style.setProperty('--shine-x', `${sx}%`);
          shine.style.setProperty('--shine-y', `${sy}%`);
        }
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg) scale(1)';
      });
    });
  })();
</script>
