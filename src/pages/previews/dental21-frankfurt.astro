---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { dental21FrankfurtProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Dental21 Frankfurt Sachsenhausen',
  tagline: 'Digital, flexibel – Frankfurt',
  location: 'Frankfurt Sachsenhausen',
  email: 'frankfurt-sachsenhausen@dental21.de',
  phone: '069 61992356',
  heroTitle: 'Moderne Zahnmedizin. Flexibel buchbar.',
  heroSubtitle: 'Dental21 in Frankfurt Sachsenhausen verbindet digitale Termintechnologie mit hochmoderner Zahnmedizin: Online-Buchung 24/7, Ästhetik, Implantologie und Prophylaxe – alles in einer Praxis.',
  services: [
    { icon: 'grid', title: 'Online-Terminbuchung 24/7', description: 'Rund um die Uhr den Wunschtermin sichern – schnell, einfach, ohne Warteschleife.' },
    { icon: 'smile', title: 'Ästhetische Zahnmedizin', description: 'Bleaching, Veneers und Smile-Design für Ihr Traumlächeln – digital geplant und präzise umgesetzt.' },
    { icon: 'tooth', title: 'Implantologie', description: 'Moderne Implantate für dauerhaften Zahnersatz – schonend und mit ausführlicher Beratung.' },
    { icon: 'shield', title: 'Prophylaxe', description: 'Professionelle Zahnreinigung und individuelle Vorsorge-Programme für nachhaltige Zahngesundheit.' },
    { icon: 'check', title: 'Lange Öffnungszeiten', description: 'Mo–Fr bis 20:00 Uhr – auch nach der Arbeit erreichbar, ohne den Alltag umzustellen.' },
    { icon: 'star', title: 'Digitaler Workflow', description: 'Papierlose Anamnese, digitale Röntgen, Online-Terminbestätigung – Zahnmedizin von morgen.' },
  ],
  stats: [
    { value: 'Online', label: 'Termin 24/7 buchbar' },
    { value: 'Mo–Fr', label: '8:00–20:00 geöffnet' },
    { value: '4.5★', label: 'Patientenbewertung' },
  ],
  testimonials: [
    { text: 'Endlich eine Zahnarztpraxis, die meine Arbeitszeiten respektiert. Abendtermine bis 20 Uhr – perfekt!', author: 'David K.', role: 'Patient, Frankfurt-Sachsenhausen' },
    { text: 'Die Online-Buchung funktioniert reibungslos und das Team ist super kompetent. Sehr empfehlenswert!', author: 'Katrin L.', role: 'Patientin, Frankfurt am Main' },
    { text: 'Modernes Equipment, schnelle Diagnose, angenehme Atmosphäre. Ich komme definitiv wieder.', author: 'Thomas N.', role: 'Patient, Frankfurt-Süd' },
  ],
};
---

<PreviewLayout profile={dental21FrankfurtProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    logo="https://www.dental21-sachsenhausen.de/img/logo-dental21.svg"
    ctaText="Termin buchen"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Zahnarzt-Netzwerk Frankfurt – Online-Buchung 24/7"
    ctaPrimary={{ text: 'Jetzt Termin buchen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Digital-Features entdecken', href: '#leistungen' }}
    imageSrc="https://www.dental21-sachsenhausen.de/img/hero-praxis.jpg"
    imageAlt="Dental21 Frankfurt Sachsenhausen – Moderne Zahnmedizin"
    stats={prospect.stats}
  />

  <div class="zh-trust-bar" role="list" aria-label="Qualitätsmerkmale">
    <div class="zh-trust-bar__inner">
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Online 24/7 buchbar</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
        </svg>
        <span>Mo–Fr bis 20 Uhr</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span>4.5★ Bewertung</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Digitaler Workflow</span>
      </div>
    </div>
  </div>

  <ZahnarztServices
    title="Unser Behandlungsspektrum"
    subtitle="Digital buchbar, modern ausgestattet – Zahnmedizin auf dem neuesten Stand in Frankfurt Sachsenhausen."
    services={prospect.services}
  />

  <ZahnarztTimeline
    title="Digital buchen – pünktlich behandelt werden"
    subtitle="Moderner, effizienter Praxisbesuch ohne Wartezeit."
    steps={[
      { num: 1, title: '24/7 Online buchen', desc: 'Rund um die Uhr den Wunschtermin sichern – auch nachts, ohne Warteschleife.', icon: 'search' },
      { num: 2, title: 'Digitaler Check-in', desc: 'Papierloser Praxisbesuch: Anamnese digital ausgefüllt – kein Stress im Wartezimmer.', icon: 'calendar' },
      { num: 3, title: 'Effiziente Behandlung', desc: 'Modernes Equipment, geschultes Team – Ihre Behandlung pünktlich und effizient.', icon: 'tooth' },
      { num: 4, title: 'Smart Recall', desc: 'Automatische Erinnerungen halten Sie bei Ihrer Zahngesundheit auf dem Laufenden.', icon: 'check' },
    ]}
  />

  <PreviewTestimonials
    title="Was Patienten über uns sagen"
    testimonials={prospect.testimonials}
  />

  <ZahnarztCostCalc />

  <PreviewCTA
    title="Digital, flexibel, pünktlich – Ihren Termin jetzt sichern"
    subtitle="24/7 online buchbar, Mo–Fr bis 20 Uhr – Zahnmedizin nach Ihrem Takt in Frankfurt Sachsenhausen."
    ctaText="Termin buchen"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    logo="https://www.dental21-sachsenhausen.de/img/logo-dental21.svg"
    email={prospect.email}
    phone={prospect.phone}
    location="Dreieichstraße 59, 60594 Frankfurt am Main"
    year={2026}
  />
</PreviewLayout>

<style>
  .zh-trust-bar { background: linear-gradient(to bottom, var(--bg-deep, #0d1f1c), color-mix(in srgb, var(--accent, #0E8A7B) 4%, var(--bg-deep, #0d1f1c))); border-bottom: 1px solid rgba(14, 138, 123, 0.15); }
  .zh-trust-bar__inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: center; gap: 24px; padding: 20px 48px; flex-wrap: wrap; }
  .zh-trust-bar__item { display: flex; align-items: center; gap: 10px; font-family: var(--font-body, sans-serif); font-size: 0.875rem; font-weight: 500; color: var(--muted, #8aafa5); white-space: nowrap; }
  .zh-trust-bar__item svg { color: var(--accent, #0E8A7B); flex-shrink: 0; }
  .zh-trust-bar__divider { width: 1px; height: 24px; background: rgba(14, 138, 123, 0.2); flex-shrink: 0; }
  @media (max-width: 768px) { .zh-trust-bar__inner { gap: 16px; padding: 16px 24px; } .zh-trust-bar__divider { display: none; } .zh-trust-bar__item { font-size: 0.8rem; } }
  @media (max-width: 480px) { .zh-trust-bar__inner { justify-content: flex-start; gap: 12px; } .zh-trust-bar__item { flex: 1 1 calc(50% - 6px); min-width: 0; white-space: normal; } }
</style>
