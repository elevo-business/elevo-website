---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { kuechenProfile } from '../../templates/config/kuechen';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewHero from '../../templates/sections/PreviewHero.astro';
import PreviewServices from '../../templates/sections/PreviewServices.astro';
import PreviewStats from '../../templates/sections/PreviewStats.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewGallery from '../../templates/sections/PreviewGallery.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Weis Küchenstudio',
  tagline: 'Küchenplanung & Einbauküchen Müllheim',
  location: 'Müllheim, Baden',
  heroTitle: 'Küchen, die begeistern. Weis Küchenstudio.',
  heroSubtitle: 'Seit über 30 Jahren planen und realisieren wir in Müllheim Traumküchen, die in Funktion, Qualität und Design überzeugen. Persönliche Beratung, hochwertige Marken, perfekte Umsetzung.',
  services: [
    { icon: 'grid', title: 'Küchenplanung', description: 'Individuelle 3D-Planung Ihrer Wunschküche — abgestimmt auf Ihren Raum, Ihren Stil und Ihre Bedürfnisse.' },
    { icon: 'activity', title: 'Einbau & Montage', description: 'Professioneller Einbau durch erfahrene Fachbetriebe — sauber, pünktlich und mit Qualitätsgarantie.' },
    { icon: 'sun', title: 'Markenküchen', description: 'Exklusive Küchen führender Hersteller — zeitlos schön, funktional durchdacht und auf Wunsch nach Maß.' },
    { icon: 'layers', title: 'Umbau & Renovierung', description: 'Bestehende Küchen modernisieren und aufwerten — Fronten, Arbeitsplatten oder komplette Neugestaltung.' },
  ],
  stats: [
    { value: '30+', label: 'Jahre Erfahrung' },
    { value: '1000+', label: 'Küchen' },
    { value: 'Schwarzwald', label: 'Region' },
  ],
};
---

<PreviewLayout profile={kuechenProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} logo="/client-logos/weis-kuechen.png" ctaText="Beratung vereinbaren" ctaHref="#kontakt" />
  <PreviewHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Müllheim · Küchenstudio · Beratung & Planung"
    ctaButtons={[
      { text: 'Beratungstermin anfragen', href: '#kontakt', variant: 'primary' },
      { text: 'Unsere Leistungen', href: '#leistungen', variant: 'outline' },
    ]}
    heroImage="/preview-images/weis-kuechen/hero.jpg"
    heroImageAlt="Moderne Designküche mit hochwertiger Ausstattung"
    stats={prospect.stats}
  />
  <PreviewServices title="Unsere Leistungen" subtitle="Von der ersten Idee bis zur eingebauten Traumküche — wir begleiten Sie durch den gesamten Prozess mit Fachkenntnis und persönlichem Engagement." services={prospect.services} />
  <PreviewGallery
    title="Küchen-Ausstellung"
    subtitle="Ausgewählte Küchenprojekte — modern, zeitlos und perfekt auf jeden Raum abgestimmt."
    images={[
      { src: '/preview-images/weis-kuechen/gallery-1.jpg', alt: 'Moderne L-Küche mit Kücheninsel' },
      { src: '/preview-images/weis-kuechen/gallery-2.jpg', alt: 'Klassische Einbauküche in Weiß' },
      { src: '/preview-images/weis-kuechen/gallery-3.jpg', alt: 'Offene Wohnküche mit Kücheninsel' },
    ]}
  />
  <PreviewCTA title="Ihre Traumküche wartet." subtitle="Besuchen Sie unser Küchenstudio in Müllheim und lassen Sie sich von unserer Ausstellung inspirieren. Persönliche Beratung — unverbindlich und kostenfrei." badge="Jetzt Termin vereinbaren" buttonText="Beratungstermin anfragen" buttonLink="#kontakt" />
  <PreviewFooter
    prospectName={prospect.name}
    year={2025}
  />
</PreviewLayout>
