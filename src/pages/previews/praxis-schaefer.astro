---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { praxisSchaeferProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztAnxiety from '../../templates/sections/zahnarzt/ZahnarztAnxiety.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztTeam from '../../templates/sections/zahnarzt/ZahnarztTeam.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Dr. Schäfer',
  tagline: 'Ihr Zahngesundheitspartner in Düsseldorf',
  location: 'Düsseldorf',
  email: 'info@praxis-schaefer.de',
  phone: '+49 211 456789',
  heroTitle: 'Gesunde Zähne für Ihre ganze Familie.',
  heroSubtitle: 'Dr. Schäfer betreut Patienten von jung bis alt — mit besonderer Expertise in Kinderzahnheilkunde und Prophylaxe. Eine Praxis für die ganze Familie, die Vertrauen als höchstes Gut versteht.',
  services: [
    { icon: 'check', title: 'Prophylaxe', description: 'Professionelle Zahnreinigung und individuelle Vorsorgeberatung für die ganze Familie. Wir legen den Grundstein für lebenslange Zahngesundheit.' },
    { icon: 'heart', title: 'Kinderzahnheilkunde', description: 'Spielerische und stressfreie Zahnbehandlung für Kinder — der erste Zahnarztbesuch als positives Erlebnis.' },
    { icon: 'tooth', title: 'Zahnersatz', description: 'Hochwertige Kronen, Brücken und herausnehmbarer Zahnersatz in Vollkeramik — naturidentisch und langlebig.' },
    { icon: 'star', title: 'Bleaching', description: 'Sanftes, schmelzschonendes Aufhellen für ein strahlendes Lächeln — auch für empfindliche Zähne geeignet.' },
    { icon: 'implant', title: 'Implantologie', description: 'Schonende Implantologie für dauerhaften Zahnersatz — individuell geplant und präzise umgesetzt.' },
    { icon: 'shield', title: 'Parodontologie', description: 'Früherkennung und effektive Behandlung von Zahnfleischerkrankungen — wir behandeln die Ursachen, nicht nur die Symptome.' },
  ],
  stats: [
    { value: '15+', label: 'Jahre Erfahrung' },
    { value: '3.200+', label: 'Patienten betreut' },
    { value: '100%', label: 'Familienpraxis' },
  ],
};
---

<PreviewLayout profile={praxisSchaeferProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    logo="/preview-images/praxis-schaefer/logo-vanessa.svg"
    ctaText="Termin vereinbaren"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Familienzahnarzt Düsseldorf"
    ctaPrimary={{ text: 'Termin vereinbaren', href: '#kontakt' }}
    ctaSecondary={{ text: 'Leistungen entdecken', href: '#leistungen' }}
    imageSrc="/preview-images/praxis-schaefer/hero.jpg"
    imageAlt="Zahnarztpraxis Dr. Schäfer Düsseldorf — Familienzahnarzt"
    stats={prospect.stats}
  />

  <div class="zh-trust-bar" role="list" aria-label="Qualitätsmerkmale">
    <div class="zh-trust-bar__inner">
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span>Familien herzlich willkommen</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span>Kindgerechte Behandlung</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Alle Kassen & Privat</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
        </svg>
        <span>Termin in 48h</span>
      </div>
    </div>
  </div>

  <ZahnarztServices
    title="Für Ihre ganze Familie"
    subtitle="Ob Kleinkind oder Senior — für jedes Alter haben wir die richtige Behandlung."
    services={prospect.services}
  />

  <ZahnarztTimeline
    title="Ihr Besuch bei Dr. Schäfer"
    subtitle="Herzlich, verständlich und auf Ihre Familie abgestimmt."
    steps={[
      { num: 1, title: 'Herzliches Kennenlernen', desc: 'Wir nehmen uns Zeit für Sie und Ihre Familie — ohne Stress, ohne Hetze. Auch Kinder werden willkommen geheißen.', icon: 'chat' },
      { num: 2, title: 'Gründliche Untersuchung', desc: 'Digitale Röntgendiagnostik und vollständige Befunderhebung — transparent und verständlich erklärt.', icon: 'search' },
      { num: 3, title: 'Behandlung', desc: 'Schonende Behandlung mit altersgerechten Methoden — für jeden Patienten individuell angepasst.', icon: 'tooth' },
      { num: 4, title: 'Regelmäßige Vorsorge', desc: 'Wir erinnern Sie an Vorsorge- und Prophylaxetermine — damit Zähne dauerhaft gesund bleiben.', icon: 'calendar' },
    ]}
  />

  <ZahnarztBeforeAfter
    title="Behandlungsergebnisse"
    subtitle="Gesunde und schöne Zähne in jedem Alter — unser Versprechen an Sie."
    cases={[
      { beforeSrc: '/preview-images/praxis-schaefer/gallery-1.jpg', afterSrc: '/preview-images/praxis-schaefer/gallery-2.jpg', label: 'Keramikfüllungen' },
      { beforeSrc: '/preview-images/praxis-schaefer/gallery-3.jpg', afterSrc: '/preview-images/praxis-schaefer/gallery-4.jpg', label: 'Zahnersatz & Kronen' },
    ]}
  />

  <ZahnarztAnxiety
    title="Wir nehmen uns Zeit — auch für kleine Sorgen"
    quote="Ein Kind, das den Zahnarzt nicht fürchtet, wird ein Erwachsener, der seine Zahngesundheit pflegt. Das ist mir wichtiger als jede Behandlung."
    quoteAuthor="Dr. Andrea Schäfer"
    trustPoints={[
      { icon: 'heart', title: 'Spielerischer Erstkontakt', desc: 'Beim ersten Besuch schauen wir nur — kein Behandlungsstuhl, kein Instrument. Vertrauen braucht Zeit.' },
      { icon: 'smile', title: 'Eltern dürfen dabei sein', desc: 'Immer. Denn ein Kind entspannt sich, wenn Mama oder Papa in der Nähe ist.' },
      { icon: 'shield', title: 'Sanfte Betäubung für alle', desc: 'Oberflächenbetäubung vor jeder Injektion — für Kinder wie für Erwachsene.' },
      { icon: 'check', title: 'Keine Hetze', desc: 'Wir planen ausreichend Zeit für jeden Patienten ein. Kein Zeitdruck, kein Stress.' },
    ]}
    cta={{ text: 'Familientermin vereinbaren', href: '#kontakt' }}
  />

  <ZahnarztTeam
    name="Dr. Andrea Schäfer"
    title="Zahnärztin & Kinderspezialistin, Düsseldorf"
    bio="Eine Praxis, in der sich die ganze Familie wohlfühlt — das war immer mein Ziel. Ich lege besonderen Wert darauf, dass Kinder den Zahnarzt nicht als Bedrohung kennenlernen, sondern als vertrauenswürdige Begleitung auf dem Weg zu lebenslanger Zahngesundheit."
    qualifications={[
      'Approbierte Zahnärztin (Universität Köln)',
      'Fortbildungszertifikat Kinderzahnheilkunde (DGKiZa)',
      'Prophylaxe-Zertifikat für Kinder und Erwachsene',
      'Parodontologie-Fortbildung (DGP)',
      'Mitglied der Deutschen Gesellschaft für Zahnerhaltung',
    ]}
    cta={{ text: 'Team kennenlernen — Familientermin buchen', href: '#kontakt' }}
  />

  <PreviewTestimonials
    title="Familien über uns"
    testimonials={[
      { text: 'Dr. Schäfer ist ein Glücksfall für unsere Familie. Meine Kinder gehen sogar gerne zum Zahnarzt — das sagt alles.', author: 'Familie Krause', role: 'Stammkunden' },
      { text: 'Kompetent, einfühlsam und immer transparent. Ich vertraue Dr. Schäfer blind — seit Jahren die beste Entscheidung.', author: 'Gabriele H.', role: 'Patientin seit 10 Jahren' },
      { text: 'Tolle Praxis, tolles Team. Man fühlt sich hier wirklich gut aufgehoben — als Patient, nicht als Nummer.', author: 'Michael T.', role: 'Patient' },
    ]}
  />

  <ZahnarztCostCalc />

  <PreviewCTA
    title="Ihre Familienzahnarztpraxis in Düsseldorf"
    subtitle="Vereinbaren Sie jetzt einen Termin — wir freuen uns auf Ihre Familie."
    ctaText="Jetzt Termin vereinbaren"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    logo="/preview-images/praxis-schaefer/logo-vanessa.svg"
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>

<style>
  .zh-trust-bar {
    background: linear-gradient(
      to bottom,
      var(--bg-deep, #0d1f1c),
      color-mix(in srgb, var(--accent, #0E8A7B) 4%, var(--bg-deep, #0d1f1c))
    );
    border-bottom: 1px solid rgba(14, 138, 123, 0.15);
  }

  .zh-trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 20px 48px;
    flex-wrap: wrap;
  }

  .zh-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted, #8aafa5);
    white-space: nowrap;
  }

  .zh-trust-bar__item svg {
    color: var(--accent, #0E8A7B);
    flex-shrink: 0;
  }

  .zh-trust-bar__divider {
    width: 1px;
    height: 24px;
    background: rgba(14, 138, 123, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .zh-trust-bar__inner {
      gap: 16px;
      padding: 16px 24px;
    }

    .zh-trust-bar__divider {
      display: none;
    }

    .zh-trust-bar__item {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .zh-trust-bar__inner {
      justify-content: flex-start;
      gap: 12px;
    }

    .zh-trust-bar__item {
      flex: 1 1 calc(50% - 6px);
      min-width: 0;
      white-space: normal;
    }
  }
</style>
