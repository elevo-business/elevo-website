---
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Grüner Leben Gartenbau — Garten- und Landschaftsbau Frankfurt</title>
  <link rel="preload" as="font" href="/fonts/Sora-latin.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="/fonts/Outfit-latin.woff2" type="font/woff2" crossorigin>
  <style>
    @font-face { font-family: 'Sora'; font-style: normal; font-weight: 400 800; font-display: swap; src: url('/fonts/Sora-latin.woff2') format('woff2'); }
    @font-face { font-family: 'Outfit'; font-style: normal; font-weight: 300 600; font-display: swap; src: url('/fonts/Outfit-latin.woff2') format('woff2'); }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root { --accent: #22C55E; --accent-hover: #16A34A; --bg: #050E07; --bg-el: #071409; --surface: #0B1C0E; --border: #152A18; --text: #E2F5EA; --muted: #6DA87C; --dim: #3E6648; }
    body { background: var(--bg); color: var(--text); font-family: 'Outfit', sans-serif; }
    a { text-decoration: none; }
    .nav { display: flex; justify-content: space-between; align-items: center; padding: 20px 48px; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: rgba(5,14,7,.92); backdrop-filter: blur(12px); z-index: 100; }
    .logo { font-family: 'Sora', sans-serif; font-weight: 800; font-size: 1.25rem; color: var(--text); display: flex; align-items: center; gap: 10px; }
    .logo-icon { width: 36px; height: 36px; background: var(--accent); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
    .nav-links { display: flex; gap: 32px; list-style: none; }
    .nav-links a { color: var(--muted); font-size: 0.9rem; transition: color .2s; }
    .nav-links a:hover { color: var(--text); }
    .btn { background: var(--accent); color: #fff; padding: 11px 24px; border-radius: 8px; font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 0.9rem; transition: background .2s; }
    .btn:hover { background: var(--accent-hover); }
    .hero { padding: 100px 48px 80px; max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
    .badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.25); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: var(--accent); margin-bottom: 24px; letter-spacing: .05em; text-transform: uppercase; font-weight: 600; }
    .badge-dot { width: 7px; height: 7px; background: var(--accent); border-radius: 50%; }
    h1 { font-family: 'Sora', sans-serif; font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; margin-bottom: 20px; }
    h1 span { color: var(--accent); }
    .hero p { color: var(--muted); font-size: 1.05rem; line-height: 1.75; margin-bottom: 32px; max-width: 480px; }
    .hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; }
    .btn-outline { border: 1px solid rgba(34,197,94,.35); color: var(--accent); padding: 11px 24px; border-radius: 8px; font-size: 0.9rem; font-weight: 500; transition: border-color .2s; }
    .btn-outline:hover { border-color: var(--accent); }
    .hero-visual { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; }
    .visual-header { background: var(--bg-el); padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; }
    .dot { width: 10px; height: 10px; border-radius: 50%; }
    .visual-placeholder { padding: 48px 32px; text-align: center; }
    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); }
    .stat { background: var(--bg-el); padding: 20px; text-align: center; }
    .stat-val { font-family: 'Sora', sans-serif; font-size: 1.5rem; font-weight: 800; color: var(--accent); }
    .stat-label { font-size: 0.75rem; color: var(--muted); margin-top: 4px; }
    section { padding: 80px 48px; max-width: 1200px; margin: 0 auto; }
    h2 { font-family: 'Sora', sans-serif; font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; margin-bottom: 16px; letter-spacing: -.02em; }
    .section-sub { color: var(--muted); font-size: 1rem; line-height: 1.7; max-width: 520px; margin-bottom: 48px; }
    .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 28px; transition: border-color .2s; }
    .card:hover { border-color: rgba(34,197,94,.3); }
    .card-icon { width: 48px; height: 48px; background: rgba(34,197,94,.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
    .card h3 { font-family: 'Sora', sans-serif; font-size: 1.05rem; font-weight: 700; margin-bottom: 10px; }
    .card p { color: var(--muted); font-size: 0.88rem; line-height: 1.65; }
    .cta-section { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 64px; text-align: center; margin: 0 48px 80px; }
    .cta-section h2 { font-size: 2rem; margin-bottom: 12px; }
    .cta-section p { color: var(--muted); max-width: 480px; margin: 0 auto 32px; }
    footer { border-top: 1px solid var(--border); padding: 48px; display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 48px; max-width: 1200px; margin: 0 auto; }
    .footer-logo { font-family: 'Sora', sans-serif; font-weight: 800; font-size: 1.1rem; margin-bottom: 12px; }
    .footer-desc { color: var(--muted); font-size: 0.85rem; line-height: 1.7; }
    .footer-col h4 { font-family: 'Sora', sans-serif; font-size: 0.8rem; font-weight: 700; color: var(--dim); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 16px; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .footer-col a { color: var(--muted); font-size: 0.85rem; transition: color .2s; }
    .footer-col a:hover { color: var(--text); }
    .footer-bottom { border-top: 1px solid var(--border); padding: 20px 48px; display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: var(--dim); max-width: 1200px; margin: 0 auto; }
    @media (max-width: 900px) {
      .nav { padding: 16px 24px; } .nav-links { display: none; }
      .hero { grid-template-columns: 1fr; padding: 60px 24px 48px; gap: 40px; }
      .cards { grid-template-columns: 1fr; }
      section { padding: 60px 24px; }
      .cta-section { margin: 0 24px 60px; padding: 40px 24px; }
      footer { grid-template-columns: 1fr; padding: 40px 24px; gap: 32px; }
      .footer-bottom { padding: 16px 24px; flex-direction: column; gap: 8px; }
    }
  </style>
</head>
<body>
  <nav class="nav">
    <div class="logo">
      <div class="logo-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M17 8C8 10 5.9 16.17 3.82 19.5"/><path d="M5 3C3.5 5.5 4 8 4 8"/><path d="M20 20L4 20"/></svg>
      </div>
      Grüner Leben
    </div>
    <ul class="nav-links">
      <li><a href="#leistungen">Leistungen</a></li>
      <li><a href="#projekte">Projekte</a></li>
      <li><a href="#nachhaltigkeit">Nachhaltigkeit</a></li>
      <li><a href="#kontakt">Kontakt</a></li>
    </ul>
    <a href="#kontakt" class="btn">Beratung anfragen</a>
  </nav>

  <div class="hero">
    <div>
      <div class="badge"><span class="badge-dot"></span> Frankfurt · Gartenbau · Nachhaltig</div>
      <h1>Lebendige Gärten<br>für Frankfurt.<br><span>Natur spürbar machen.</span></h1>
      <p>Grüner Leben Gartenbau gestaltet Außenräume mit Respekt vor der Natur. Ökologisch durchdacht, handwerklich präzise und mit Leidenschaft für jedes Detail.</p>
      <div class="hero-ctas">
        <a href="#kontakt" class="btn">Kostenloses Angebot</a>
        <a href="#leistungen" class="btn-outline">Unsere Leistungen</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="visual-header">
        <div class="dot" style="background:#EF4444"></div>
        <div class="dot" style="background:#F59E0B"></div>
        <div class="dot" style="background:#22C55E"></div>
      </div>
      <div class="visual-placeholder">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="1.5" style="opacity:.3;display:block;margin:0 auto 12px"><path d="M12 22C12 22 4 16 4 9a8 8 0 0 1 16 0c0 7-8 13-8 13z"/><circle cx="12" cy="9" r="2.5"/></svg>
        <div class="stats">
          <div class="stat"><div class="stat-val">100%</div><div class="stat-label">Nachhaltig</div></div>
          <div class="stat"><div class="stat-val">300+</div><div class="stat-label">Gärten</div></div>
          <div class="stat"><div class="stat-val">Top</div><div class="stat-label">Bewertungen</div></div>
        </div>
      </div>
    </div>
  </div>

  <section id="leistungen">
    <h2>Unsere Leistungen</h2>
    <p class="section-sub">Gärten sind Lebensräume — für Menschen, Tiere und Pflanzen. Wir gestalten sie so, dass sie blühen, gedeihen und langfristig Freude machen.</p>
    <div class="cards">
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg></div>
        <h3>Gartenentwurf</h3>
        <p>Wir entwickeln individuelle Gartenkonzepte — ökologisch durchdacht, ästhetisch stimmig und auf Ihre Lebenssituation abgestimmt.</p>
      </div>
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2"><path d="M12 22V12M12 12L6 6M12 12l6-6"/><rect x="2" y="20" width="20" height="2" rx="1"/></svg></div>
        <h3>Terrassenbau</h3>
        <p>Holzterrassen, Naturstein- und Betonterrassen — fachgerecht geplant, dauerhaft gebaut und schön anzusehen.</p>
      </div>
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2"><path d="M17 8C8 10 5.9 16.17 3.82 19.5c-.17.28.03.5.25.5H20l-3-5.5 2.5-4"/></svg></div>
        <h3>Bepflanzung</h3>
        <p>Heimische Stauden, Sträucher und Bäume — saisonal abgestimmt, pflegeleicht und naturverträglich gepflanzt.</p>
      </div>
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg></div>
        <h3>Saisonpflege</h3>
        <p>Frühjahr, Sommer, Herbst — wir pflegen Ihren Garten das ganze Jahr über verlässlich und mit Sachverstand.</p>
      </div>
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg></div>
        <h3>Rasenanlage</h3>
        <p>Saatgut oder Rollrasen — wir bereiten den Boden professionell vor und legen Ihren Rasen dauerhaft und dicht an.</p>
      </div>
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
        <h3>Gartenbeleuchtung</h3>
        <p>Stimmungsvolle LED-Beleuchtung für Wege, Beete und Terrassen — energieeffizient und professionell verlegt.</p>
      </div>
    </div>
  </section>

  <div class="cta-section" id="kontakt">
    <div class="badge" style="margin:0 auto 20px"><span class="badge-dot"></span> Jetzt anfragen</div>
    <h2>Ihren Garten neu denken?</h2>
    <p>Wir kommen vorbei, hören zu und entwickeln gemeinsam ein Konzept — kostenlos, unverbindlich und nachhaltig.</p>
    <a href="tel:+49" class="btn" style="font-size:1rem;padding:14px 32px">Jetzt anrufen</a>
  </div>

  <footer>
    <div>
      <div class="footer-logo">Grüner Leben Gartenbau</div>
      <p class="footer-desc">Nachhaltiger Garten- und Landschaftsbau in Frankfurt. Wir gestalten Gärten, die der Natur guttun und Menschen Freude machen.</p>
    </div>
    <div class="footer-col">
      <h4>Leistungen</h4>
      <ul>
        <li><a href="#">Gartenentwurf</a></li>
        <li><a href="#">Terrassenbau</a></li>
        <li><a href="#">Bepflanzung</a></li>
        <li><a href="#">Saisonpflege</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Kontakt</h4>
      <ul>
        <li><a href="#">Frankfurt am Main</a></li>
        <li><a href="mailto:info@gruener-leben.de">info@gruener-leben.de</a></li>
        <li><a href="#">Impressum</a></li>
        <li><a href="#">Datenschutz</a></li>
      </ul>
    </div>
  </footer>
  <div class="footer-bottom">
    <span>© 2025 Grüner Leben Gartenbau</span>
    <span>Website von <a href="https://elevo.solutions" style="color:var(--accent)">ELEVO</a></span>
  </div>
<!-- ELEVO Floating Dot -->
<style>
  .elevo-dot { position: fixed; bottom: 24px; right: 24px; z-index: 9999; width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, #1E3A5F 0%, #0A0E1A 100%); border: 2px solid rgba(59,130,246,.4); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 20px rgba(0,0,0,.5), 0 0 20px rgba(59,130,246,.15); cursor: pointer; transition: transform .2s, box-shadow .2s; }
  .elevo-dot:hover { transform: scale(1.1); box-shadow: 0 6px 28px rgba(0,0,0,.6), 0 0 30px rgba(59,130,246,.25); }
  .elevo-dot img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
</style>
<a href="https://elevo.solutions" target="_blank" rel="noopener" class="elevo-dot" title="Erstellt von ELEVO">
  <img src="/elevo-floating-icon.jpg" alt="ELEVO" width="32" height="32" />
</a>
</body>
</html>
