---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { galabauProfile } from '../../templates/config/galabau';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewHero from '../../templates/sections/PreviewHero.astro';
import PreviewServices from '../../templates/sections/PreviewServices.astro';
import PreviewStats from '../../templates/sections/PreviewStats.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewGallery from '../../templates/sections/PreviewGallery.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Grüner Leben Gartenbau',
  tagline: 'Nachhaltiger Gartenbau Frankfurt',
  location: 'Frankfurt am Main',
  email: 'info@gruener-leben.de',
  heroTitle: 'Lebendige Gärten für Frankfurt.',
  heroSubtitle: 'Grüner Leben Gartenbau gestaltet Außenräume mit Respekt vor der Natur. Ökologisch durchdacht, handwerklich präzise und mit Leidenschaft für jedes Detail.',
  services: [
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>', title: 'Gartenentwurf', description: 'Wir entwickeln individuelle Gartenkonzepte — ökologisch durchdacht, ästhetisch stimmig und auf Ihre Lebenssituation abgestimmt.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22V12M12 12L6 6M12 12l6-6"/><rect x="2" y="20" width="20" height="2" rx="1"/></svg>', title: 'Terrassenbau', description: 'Holzterrassen, Naturstein- und Betonterrassen — fachgerecht geplant, dauerhaft gebaut und schön anzusehen.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 8C8 10 5.9 16.17 3.82 19.5c-.17.28.03.5.25.5H20l-3-5.5 2.5-4"/></svg>', title: 'Bepflanzung', description: 'Heimische Stauden, Sträucher und Bäume — saisonal abgestimmt, pflegeleicht und naturverträglich gepflanzt.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>', title: 'Saisonpflege', description: 'Frühjahr, Sommer, Herbst — wir pflegen Ihren Garten das ganze Jahr über verlässlich und mit Sachverstand.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>', title: 'Rasenanlage', description: 'Saatgut oder Rollrasen — wir bereiten den Boden professionell vor und legen Ihren Rasen dauerhaft und dicht an.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>', title: 'Gartenbeleuchtung', description: 'Stimmungsvolle LED-Beleuchtung für Wege, Beete und Terrassen — energieeffizient und professionell verlegt.' },
  ],
  stats: [
    { value: '100%', label: 'Nachhaltig' },
    { value: '300+', label: 'Gärten' },
    { value: 'Top', label: 'Bewertungen' },
  ],
};
---

<PreviewLayout profile={galabauProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} logo="/client-logos/gruener-leben.svg" ctaText="Beratung anfragen" ctaHref="#kontakt" />
  <PreviewHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Frankfurt · Gartenbau · Nachhaltig"
    ctaButtons={[
      { text: 'Kostenloses Angebot', href: '#kontakt', variant: 'primary' },
      { text: 'Unsere Leistungen', href: '#leistungen', variant: 'outline' },
    ]}
    heroImage="/preview-images/gruener-leben/hero.jpg"
    heroImageAlt="Üppig bepflanzter naturnaher Garten im Morgenlicht"
    stats={prospect.stats}
  />
  <PreviewServices title="Unsere Leistungen" subtitle="Gärten sind Lebensräume — für Menschen, Tiere und Pflanzen. Wir gestalten sie so, dass sie blühen, gedeihen und langfristig Freude machen." services={prospect.services} />
  <PreviewGallery
    title="Realisierte Gärten"
    subtitle="Nachhaltige Gartengestaltung für Frankfurt und Umgebung — jedes Projekt ein Unikat."
    images={[
      { src: '/preview-images/gruener-leben/gallery-1.jpg', alt: 'Naturnaher Garten mit einheimischen Stauden' },
      { src: '/preview-images/gruener-leben/gallery-2.jpg', alt: 'Ökologische Bepflanzung mit Wildblumen' },
      { src: '/preview-images/gruener-leben/gallery-3.jpg', alt: 'Terrassengarten mit natürlicher Bepflanzung' },
    ]}
  />
  <PreviewCTA title="Ihren Garten neu denken?" subtitle="Wir kommen vorbei, hören zu und entwickeln gemeinsam ein Konzept — kostenlos, unverbindlich und nachhaltig." badge="Jetzt anfragen" buttonText="Jetzt anrufen" buttonLink="tel:+49" />
  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    year={2025}
  />
</PreviewLayout>
