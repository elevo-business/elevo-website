---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztHartmannProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztTechShowcase from '../../templates/sections/zahnarzt/ZahnarztTechShowcase.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztTeam from '../../templates/sections/zahnarzt/ZahnarztTeam.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Hartmann',
  tagline: 'Parodontologie & moderne Zahnheilkunde Berlin',
  location: 'Berlin-Mitte',
  email: 'info@zahnarzt-hartmann-berlin.de',
  phone: '+49 30 9876543',
  heroTitle: 'Zahnfleischprobleme lösen. Nicht nur behandeln.',
  heroSubtitle: 'Zahnfleischbluten, lockere Zähne, Mundgeruch — Parodontitis hat viele Gesichter. Praxis Hartmann in Berlin-Mitte findet die Ursache und behandelt sie. Evidenzbasiert, gründlich, langfristig.',
  services: [
    { icon: 'tooth', title: 'Parodontologie', description: 'Spezialisierte Behandlung von Zahnfleischerkrankungen — schonend und langfristig wirksam.' },
    { icon: 'shield', title: 'Implantatversorgung', description: 'Hochwertige Zahnimplantate für dauerhaften Zahnersatz — natürlich und funktional.' },
    { icon: 'smile', title: 'Ästhetische Korrekturen', description: 'Veneers, Bleaching und Kompositrestaurationen für ein ebenmäßiges Lächeln.' },
    { icon: 'check', title: 'Prophylaxe & PZR', description: 'Professionelle Zahnreinigung und individuelle Präventionsprogramme für dauerhaft gesunde Zähne.' },
    { icon: 'grid', title: 'Digitale Abdrücke', description: 'Modernste 3D-Scantechnologie statt unangenehmer Abformmassen — präzise und schnell.' },
    { icon: 'star', title: 'Langzeitbetreuung', description: 'Strukturierte Recall-Programme und kontinuierliche Kontrolle für nachhaltigen Behandlungserfolg.' },
  ],
  stats: [
    { value: '20+', label: 'Jahre Erfahrung' },
    { value: '500+', label: 'Implantate jährlich' },
    { value: '4.9★', label: 'Google-Bewertung' },
  ],
};
---

<PreviewLayout profile={zahnarztHartmannProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    logo="/preview-images/zahnarzt-hartmann/logo.jpg"
    ctaText="Termin buchen"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Parodontologie-Spezialist Berlin"
    ctaPrimary={{ text: 'Schmerzfreie Beratung buchen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Habe ich Parodontitis? Symptome prüfen →', href: '#leistungen' }}
    imageSrc="/preview-images/zahnarzt-hartmann/hero.jpg"
    imageAlt="Zahnarztpraxis Hartmann Berlin-Mitte — moderne Zahnheilkunde"
    stats={prospect.stats}
  />

  <div class="zh-trust-bar" role="list" aria-label="Qualitätsmerkmale">
    <div class="zh-trust-bar__inner">
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Kassenzulassung & Privatpatienten</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v6l4 2"/>
        </svg>
        <span>Termin in 48h</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/>
        </svg>
        <span>Modernste 3D-Diagnostik</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span>4,9★ Google-Bewertung</span>
      </div>
    </div>
  </div>

  <ZahnarztTechShowcase
    title="Modernste Technologie für präzise Diagnose"
    subtitle="Parodontitis erkennen, bevor sie Schäden anrichtet — mit Geräten, die kein Detail übersehen."
    technologies={[
      { icon: 'xray', title: '3D-Volumentomographie (DVT)', description: 'Dreidimensionale Röntgendiagnostik mit minimaler Strahlenbelastung — sichtbar, was auf 2D-Bildern verborgen bleibt.' },
      { icon: 'scan', title: 'Digitaler Intraoralscanner', description: 'Präzise 3D-Abdrücke ohne Abformmasse — schnell, genau und für Patienten deutlich angenehmer.' },
      { icon: 'microscope', title: 'Paro-Status-System', description: 'Digitale Taschentiefenmessung mit automatischer Dokumentation — jeder Messwert transparent und nachvollziehbar.' },
      { icon: 'digital', title: 'Digitale Behandlungsplanung', description: 'Alle Befunde in einem System — von der Diagnose über die Therapie bis zum Recall strukturiert geplant.' },
    ]}
  />

  <ZahnarztServices
    title="Unser Behandlungsspektrum"
    subtitle="Von der Prophylaxe bis zur Implantatversorgung — alles aus einer Hand."
    services={prospect.services}
    cardCtaText="Mehr erfahren"
  />

  <ZahnarztTimeline
    title="So stoppen wir Parodontitis"
    subtitle="Parodontitis ist behandelbar. Je früher, desto besser. So gehen wir vor."
    steps={[
      { num: 1, title: 'Befund & Messung', desc: 'Taschentiefen, Röntgen, Bakterientest. Wir messen, was andere übersehen.', icon: 'search' },
      { num: 2, title: 'Ursachen-Therapie', desc: 'Professionelle Reinigung der Zahnfleischtaschen. Antibiotika nur wenn nötig, gezielt statt pauschal.', icon: 'calendar' },
      { num: 3, title: 'Kontrolle & Stabilisierung', desc: 'Regelmäßige Nachmessung. Die Taschen werden flacher, das Zahnfleisch erholt sich.', icon: 'tooth' },
      { num: 4, title: 'Langzeit-Recall', desc: 'Alle 3–6 Monate Kontrolle. Damit Parodontitis nicht zurückkommt. Dauerhaft.', icon: 'check' },
    ]}
  />

  <ZahnarztBeforeAfter
    title="Zahnfleisch gerettet. Zähne erhalten."
    subtitle="Parodontitis-Behandlung zeigt Ergebnisse. Dokumentiert in Zahlen."
    cases={[
      { beforeSrc: '/preview-images/zahnarzt-hartmann/gallery-1.jpg', afterSrc: '/preview-images/zahnarzt-hartmann/gallery-2.jpg', label: 'Schwere Parodontitis — Taschentiefen von 8mm auf 3mm reduziert. Alle Zähne erhalten. Behandlung: 6 Monate.' },
      { beforeSrc: '/preview-images/zahnarzt-hartmann/gallery-3.jpg', afterSrc: '/preview-images/zahnarzt-hartmann/gallery-4.jpg', label: 'Implantat trotz Parodontitis — Erst Parodontitis behandelt, dann Implantat gesetzt. Sitzt seit 3 Jahren.' },
    ]}
    cta={{ text: 'Kostenvoranschlag in 24h', href: '#kontakt' }}
  />

  <ZahnarztTeam
    name="Dr. Thomas Hartmann"
    title="Zahnarzt & Parodontologie-Spezialist, Berlin-Mitte"
    bio="Seit über 20 Jahren behandle ich Patienten mit Zahnfleischerkrankungen. Meine Überzeugung: Wer die Ursache kennt, kann dauerhaft helfen — nicht nur die Symptome lindern. Ich nehme mir die Zeit, die jeder Patient braucht."
    qualifications={[
      'Approbierter Zahnarzt (Charité Berlin, 2003)',
      'Tätigkeitsschwerpunkt Parodontologie (DGP)',
      'Zertifizierter Implantologe (DGOI)',
      'Fortbildung: Digitale Zahnheilkunde & 3D-Diagnostik',
      'Mitglied der Deutschen Gesellschaft für Parodontologie',
    ]}
    cta={{ text: 'Team kennenlernen — Termin buchen', href: '#kontakt' }}
  />

  <PreviewTestimonials
    title="Unsere Patienten über uns"
    testimonials={[
      { text: 'Dr. Hartmann hat mein langjähriges Zahnfleischproblem endlich gelöst. Fachkompetenz auf höchstem Niveau.', author: 'Markus Braun', role: 'Patient seit 5 Jahren' },
      { text: 'Die Implantatversorgung war unkompliziert und professionell. Ich würde die Praxis jederzeit weiterempfehlen.', author: 'Claudia Winkler', role: 'Implantat-Patientin' },
      { text: 'Modernste Technik und ein kompetentes Team — ich fühle mich hier bestens betreut.', author: 'Stefan Hoffmann', role: 'Patient' },
    ]}
  />

  <ZahnarztCostCalc />

  <PreviewCTA
    title="Ursache finden. Zahnfleisch retten."
    subtitle="Je früher Parodontitis behandelt wird, desto mehr Zähne können erhalten werden. Vereinbaren Sie jetzt Ihren Parodontitis-Check."
    ctaText="Digitale Erstanalyse buchen"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    logo="/preview-images/zahnarzt-hartmann/logo.jpg"
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>

<style>
  .zh-trust-bar {
    background: linear-gradient(
      to bottom,
      var(--bg-deep, #0d1f1c),
      color-mix(in srgb, var(--accent, #0E8A7B) 4%, var(--bg-deep, #0d1f1c))
    );
    border-bottom: 1px solid rgba(14, 138, 123, 0.15);
  }

  .zh-trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 20px 48px;
    flex-wrap: wrap;
  }

  .zh-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted, #8aafa5);
    white-space: nowrap;
  }

  .zh-trust-bar__item svg {
    color: var(--accent, #0E8A7B);
    flex-shrink: 0;
  }

  .zh-trust-bar__divider {
    width: 1px;
    height: 24px;
    background: rgba(14, 138, 123, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .zh-trust-bar__inner {
      gap: 16px;
      padding: 16px 24px;
    }

    .zh-trust-bar__divider {
      display: none;
    }

    .zh-trust-bar__item {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .zh-trust-bar__inner {
      justify-content: flex-start;
      gap: 12px;
    }

    .zh-trust-bar__item {
      flex: 1 1 calc(50% - 6px);
      min-width: 0;
      white-space: normal;
    }
  }
</style>
