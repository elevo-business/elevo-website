---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztModernProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Hartmann',
  tagline: 'Parodontologie & moderne Zahnheilkunde Berlin',
  location: 'Berlin-Mitte',
  email: 'info@zahnarzt-hartmann-berlin.de',
  phone: '+49 30 9876543',
  heroTitle: 'Ihre Zahngesundheit in Berlin-Mitte — modern, präzise, nachhaltig.',
  heroSubtitle: 'Praxis Hartmann steht für evidenzbasierte Zahnheilkunde mit Schwerpunkt Parodontologie. Wir behandeln nicht nur Symptome — wir lösen die Ursachen.',
  services: [
    { icon: 'tooth', title: 'Parodontologie', description: 'Spezialisierte Behandlung von Zahnfleischerkrankungen — schonend und langfristig wirksam.' },
    { icon: 'shield', title: 'Implantatversorgung', description: 'Hochwertige Zahnimplantate für dauerhaften Zahnersatz — natürlich und funktional.' },
    { icon: 'smile', title: 'Ästhetische Korrekturen', description: 'Veneers, Bleaching und Kompositrestaurationen für ein ebenmäßiges Lächeln.' },
    { icon: 'check', title: 'Prophylaxe & PZR', description: 'Professionelle Zahnreinigung und individuelle Präventionsprogramme für dauerhaft gesunde Zähne.' },
    { icon: 'grid', title: 'Digitale Abdrücke', description: 'Modernste 3D-Scantechnologie statt unangenehmer Abformmassen — präzise und schnell.' },
    { icon: 'star', title: 'Langzeitbetreuung', description: 'Strukturierte Recall-Programme und kontinuierliche Kontrolle für nachhaltigen Behandlungserfolg.' },
  ],
  stats: [
    { value: '20+', label: 'Jahre Erfahrung' },
    { value: '500+', label: 'Implantate jährlich' },
    { value: '4.9★', label: 'Google-Bewertung' },
  ],
};
---

<PreviewLayout profile={zahnarztModernProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    ctaText="Termin buchen"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Parodontologie-Spezialist"
    ctaPrimary={{ text: 'Termin buchen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Unsere Leistungen', href: '#leistungen' }}
    imageSrc="/preview-images/zahnarzt-hartmann/hero.jpg"
    imageAlt="Zahnarztpraxis Hartmann Berlin-Mitte — moderne Zahnheilkunde"
    stats={prospect.stats}
  />

  <ZahnarztServices
    title="Unsere Leistungen"
    subtitle="Von der Prophylaxe bis zur Implantatversorgung — alles aus einer Hand."
    services={prospect.services}
  />

  <ZahnarztTimeline
    title="Ihr Behandlungsablauf"
    subtitle="Strukturiert, transparent und auf Ihre Bedürfnisse abgestimmt."
    steps={[
      { num: 1, title: 'Befund & Analyse', desc: 'Umfassende digitale Diagnostik mit Röntgen und 3D-Scan für ein vollständiges Bild Ihrer Zahngesundheit.', icon: 'search' },
      { num: 2, title: 'Behandlungsplan', desc: 'Wir erklären alle Befunde und erstellen gemeinsam mit Ihnen einen strukturierten Behandlungsplan.', icon: 'calendar' },
      { num: 3, title: 'Behandlung', desc: 'Präzise Durchführung mit modernsten Methoden — schonend, effizient und nachhaltig.', icon: 'tooth' },
      { num: 4, title: 'Recall & Kontrolle', desc: 'Regelmäßige Kontrolltermine sichern den langfristigen Erfolg Ihrer Behandlung.', icon: 'check' },
    ]}
  />

  <ZahnarztBeforeAfter
    title="Behandlungsergebnisse"
    subtitle="Präzise Ergebnisse, die für sich sprechen."
    cases={[
      { beforeSrc: '/preview-images/zahnarzt-hartmann/gallery-1.jpg', afterSrc: '/preview-images/zahnarzt-hartmann/gallery-2.jpg', label: 'Parodontale Sanierung' },
      { beforeSrc: '/preview-images/zahnarzt-hartmann/gallery-3.jpg', afterSrc: '/preview-images/zahnarzt-hartmann/gallery-4.jpg', label: 'Implantat-Versorgung' },
    ]}
  />

  <ZahnarztCostCalc />

  <PreviewTestimonials
    title="Unsere Patienten über uns"
    testimonials={[
      { text: 'Dr. Hartmann hat mein langjähriges Zahnfleischproblem endlich gelöst. Fachkompetenz auf höchstem Niveau.', author: 'Markus B.', role: 'Patient seit 5 Jahren' },
      { text: 'Die Implantatversorgung war unkompliziert und professionell. Ich würde die Praxis jederzeit weiterempfehlen.', author: 'Claudia W.', role: 'Implantat-Patientin' },
      { text: 'Modernste Technik und ein kompetentes Team — ich fühle mich hier bestens betreut.', author: 'Stefan H.', role: 'Patient' },
    ]}
  />

  <PreviewCTA
    title="Termin in Berlin-Mitte vereinbaren"
    subtitle="Starten Sie jetzt in eine nachhaltig gesunde Zukunft für Ihre Zähne."
    ctaText="Jetzt Termin buchen"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>
