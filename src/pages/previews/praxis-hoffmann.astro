---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztAesthetikProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztAnxiety from '../../templates/sections/zahnarzt/ZahnarztAnxiety.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztTeam from '../../templates/sections/zahnarzt/ZahnarztTeam.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Hoffmann & Kollegen',
  tagline: 'Ästhetische Zahnmedizin & Bleaching Stuttgart',
  location: 'Stuttgart',
  email: 'info@praxis-hoffmann.de',
  phone: '+49 711 345678',
  heroTitle: 'Ästhetische Zahnmedizin für Ihr perfektes Lächeln.',
  heroSubtitle: 'Hoffmann & Kollegen sind Stuttgarts Spezialist für ästhetische Zahnmedizin — Bleaching, Veneers, Implantate. Mit modernster Technik und künstlerischem Gespür für Ihren individuellen Look.',
  services: [
    { icon: 'star', title: 'Bleaching', description: 'Professionelles In-Office-Bleaching und individuelle Home-Bleaching-Systeme für ein strahlendes, natürlich wirkendes Lächeln. Schmelzschonend und effektiv.' },
    { icon: 'smile', title: 'Veneers & Kronen', description: 'Hauchdünne Keramik-Veneers und hochwertige Vollkeramik-Kronen — individuell gefertigt für ein natürlich schönes Lächeln.' },
    { icon: 'implant', title: 'Implantologie', description: 'Ästhetische Implantologie für dauerhaften, naturidentischen Zahnersatz — mit besonderem Augenmerk auf perfekte Optik.' },
    { icon: 'grid', title: 'Kieferorthopädie', description: 'Unsichtbare Clear-Aligner-Systeme für Erwachsene — diskret, komfortabel und ästhetisch. Gerades Gebiss ohne sichtbare Spange.' },
    { icon: 'check', title: 'Prophylaxe', description: 'Professionelle Zahnreinigung als Basis für jede ästhetische Behandlung. Gesunde, gepflegte Zähne sind die schönsten Zähne.' },
    { icon: 'heart', title: 'Kinderzahnheilkunde', description: 'Früh angesetzte ästhetische Prävention für die Kleinsten — damit gesunde Gewohnheiten zum natürlichen Teil des Alltags werden.' },
  ],
  stats: [
    { value: '12+', label: 'Jahre Erfahrung' },
    { value: 'Ästhetik', label: 'Spezialist Stuttgart' },
    { value: '4.9★', label: 'Bewertung Stuttgart' },
  ],
};
---

<PreviewLayout profile={zahnarztAesthetikProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    ctaText="Smile-Beratung buchen"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Ästhetische Zahnmedizin Stuttgart"
    ctaPrimary={{ text: 'Smile-Beratung buchen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Leistungen entdecken', href: '#leistungen' }}
    imageSrc="/preview-images/praxis-hoffmann/hero.jpg"
    imageAlt="Zahnarztpraxis Hoffmann Stuttgart — Ästhetische Zahnmedizin"
    stats={prospect.stats}
  />

  <div class="zh-trust-bar" role="list" aria-label="Qualitätsmerkmale">
    <div class="zh-trust-bar__inner">
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span>Digital Smile Design</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
        </svg>
        <span>Termin in 48h</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Premium Keramikmaterialien</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <span>4,9★ Google Stuttgart</span>
      </div>
    </div>
  </div>

  <ZahnarztServices
    title="Unsere Ästhetik-Leistungen"
    subtitle="Von Bleaching bis Invisalign — wir erschaffen Lächeln, die begeistern."
    services={prospect.services}
  />

  <ZahnarztAnxiety
    title="Ihr Wunschlächeln verdient kein schlechtes Gefühl"
    quote="Ästhetische Zahnmedizin beginnt mit einem offenen Gespräch — nicht mit dem Bohrer. Wir zeigen Ihnen erst digital, was möglich ist. Dann entscheiden Sie in Ruhe."
    quoteAuthor="Dr. Maria Hoffmann"
    trustPoints={[
      { icon: 'smile', title: 'Smile-Simulation vorab', desc: 'Sie sehen Ihr neues Lächeln am Bildschirm — bevor irgendetwas behandelt wird. Keine bösen Überraschungen.' },
      { icon: 'heart', title: 'Keine Überzeugungsarbeit', desc: 'Wir beraten, erklären und empfehlen. Den letzten Schritt machen Sie. Immer.' },
      { icon: 'shield', title: 'Schonende Methoden', desc: 'Minimalinvasive Techniken, moderne Betäubung — ästhetische Behandlungen müssen nicht wehtun.' },
      { icon: 'star', title: 'Transparente Kosten', desc: 'Schriftlicher Kostenplan vor Behandlungsbeginn. Kein Cent mehr als besprochen.' },
    ]}
    cta={{ text: 'Kostenlose Smile-Beratung buchen', href: '#kontakt' }}
  />

  <ZahnarztTimeline
    title="Ihr Weg zum Traumlächeln"
    subtitle="Strukturiert, transparent und mit Blick auf Ihre Wünsche."
    steps={[
      { num: 1, title: 'Smile-Analyse', desc: 'Umfassende Analyse Ihrer Zahnästhetik — mit digitaler Simulation Ihres künftigen Lächelns.', icon: 'search' },
      { num: 2, title: 'Behandlungsplan', desc: 'Individueller Plan mit allen Behandlungsschritten und klarer Kostenübersicht — keine versteckten Kosten.', icon: 'calendar' },
      { num: 3, title: 'Ästhetische Behandlung', desc: 'Präzise Umsetzung mit hochwertigen Materialien — für ein Ergebnis, das natürlich und strahlend wirkt.', icon: 'star' },
      { num: 4, title: 'Langzeit-Schönheit', desc: 'Regelmäßige Prophylaxe und Kontrolle erhalten Ihr strahlendes Lächeln dauerhaft.', icon: 'check' },
    ]}
  />

  <ZahnarztBeforeAfter
    title="Vorher — Nachher"
    subtitle="Ästhetische Ergebnisse, die für sich sprechen."
    cases={[
      { beforeSrc: '/preview-images/praxis-hoffmann/gallery-1.jpg', afterSrc: '/preview-images/praxis-hoffmann/gallery-2.jpg', label: 'Bleaching & Veneers' },
      { beforeSrc: '/preview-images/praxis-hoffmann/gallery-3.jpg', afterSrc: '/preview-images/praxis-hoffmann/gallery-4.jpg', label: 'Komplettes Smile Design' },
    ]}
  />

  <ZahnarztTeam
    name="Dr. Maria Hoffmann"
    title="Spezialistin für Ästhetische Zahnmedizin, Stuttgart"
    bio="Schöne Zähne sind keine Nebensächlichkeit — sie beeinflussen, wie wir uns fühlen und wie wir auf andere wirken. Ich sehe meine Arbeit als eine Verbindung aus Handwerk, Ästhetik und echtem Einfühlungsvermögen. Jedes Lächeln ist ein Unikat."
    qualifications={[
      'Approbierte Zahnärztin (LMU München)',
      'Digital Smile Design Practitioner (DSD)',
      'Zertifizierte Invisalign-Behandlerin',
      'Fortbildungszertifikat Veneers & Ästhetische Zahnheilkunde',
      'Mitglied der Deutschen Gesellschaft für Zahnerhaltung',
    ]}
    cta={{ text: 'Team kennenlernen — Smile-Beratung buchen', href: '#kontakt' }}
  />

  <PreviewTestimonials
    title="Was Patienten über uns sagen"
    testimonials={[
      { text: 'Das Bleaching-Ergebnis hat mich wirklich überrascht — so natürlich weiß hätte ich nicht erwartet. Tolle Praxis!', author: 'Julia M.', role: 'Bleaching-Patientin' },
      { text: 'Endlich eine Praxis in Stuttgart, die Ästhetik wirklich versteht. Die Veneers sehen aus wie meine eigenen Zähne.', author: 'Patrick O.', role: 'Veneer-Patient' },
      { text: 'Sehr kompetentes Team mit echter Leidenschaft für schöne Zähne. Mein Lächeln hat sich komplett verändert.', author: 'Annika R.', role: 'Patientin' },
    ]}
  />

  <ZahnarztCostCalc />

  <PreviewCTA
    title="Ihr Traumlächeln wartet"
    subtitle="Vereinbaren Sie Ihre kostenlose Smile-Beratung — wir zeigen Ihnen digital, was möglich ist."
    ctaText="Kostenlose Smile-Beratung"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>

<style>
  .zh-trust-bar {
    background: linear-gradient(
      to bottom,
      var(--bg-deep, #0d1f1c),
      color-mix(in srgb, var(--accent, #0E8A7B) 4%, var(--bg-deep, #0d1f1c))
    );
    border-bottom: 1px solid rgba(14, 138, 123, 0.15);
  }

  .zh-trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 20px 48px;
    flex-wrap: wrap;
  }

  .zh-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted, #8aafa5);
    white-space: nowrap;
  }

  .zh-trust-bar__item svg {
    color: var(--accent, #0E8A7B);
    flex-shrink: 0;
  }

  .zh-trust-bar__divider {
    width: 1px;
    height: 24px;
    background: rgba(14, 138, 123, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .zh-trust-bar__inner {
      gap: 16px;
      padding: 16px 24px;
    }

    .zh-trust-bar__divider {
      display: none;
    }

    .zh-trust-bar__item {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .zh-trust-bar__inner {
      justify-content: flex-start;
      gap: 12px;
    }

    .zh-trust-bar__item {
      flex: 1 1 calc(50% - 6px);
      min-width: 0;
      white-space: normal;
    }
  }
</style>
