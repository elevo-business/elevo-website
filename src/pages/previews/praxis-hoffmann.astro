---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztProfile } from '../../templates/config/zahnarzt';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const ICON = {
  bleaching: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2c-1.5 0-2.5 1-3 2.5L4.5 11C4 14 5.5 16 7 16c.6 0 1.1-.2 1.5-.5L12 14l3.5 1.5c.4.3.9.5 1.5.5 1.5 0 3-2 2.5-5L18 4.5C17.5 3 16.5 2 15 2c-1 0-2 .6-3 .6S10 2 9 2z"/><path d="M19 2l.5 2 1.5-.5-1 1.5 1.5.5-1.5.5 1 1.5-1.5-.5-.5 2-.5-2-1.5.5 1-1.5-1.5-.5 1.5-.5-1-1.5 1.5.5L19 2z"/></svg>`,
  zahnersatz: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l3.5 11h11L21 9"/><path d="M3 9l4 4 5-7 5 7 4-4"/></svg>`,
  implantologie: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2c-1.5 0-2.5 1-3 2.5L4.5 11C4 14 5.5 16 7 16c.6 0 1.1-.2 1.5-.5L12 14l3.5 1.5c.4.3.9.5 1.5.5 1.5 0 3-2 2.5-5L18 4.5C17.5 3 16.5 2 15 2c-1 0-2 .6-3 .6S10 2 9 2z"/><line x1="12" y1="14" x2="12" y2="21"/><path d="M10 18h4"/></svg>`,
  kieferorthopaedie: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8" width="20" height="8" rx="2"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="7" y1="8" x2="7" y2="16"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="17" y1="8" x2="17" y2="16"/></svg>`,
  prophylaxe: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2c-1.5 0-2.5 1-3 2.5L4.5 11C4 14 5.5 16 7 16c.6 0 1.1-.2 1.5-.5L12 14l3.5 1.5c.4.3.9.5 1.5.5 1.5 0 3-2 2.5-5L18 4.5C17.5 3 16.5 2 15 2c-1 0-2 .6-3 .6S10 2 9 2z"/><path d="M19.5 2.5l1 1M21.5 5.5h1M19.5 8.5l1-1"/></svg>`,
  kinderzahnheilkunde: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2c-1.5 0-2.5 1-3 2.5L4.5 11C4 14 5.5 16 7 16c.6 0 1.1-.2 1.5-.5L12 14l3.5 1.5c.4.3.9.5 1.5.5 1.5 0 3-2 2.5-5L18 4.5C17.5 3 16.5 2 15 2c-1 0-2 .6-3 .6S10 2 9 2z"/><path d="M12 5.5c-.5 0-1.5-.8-1.5.5s1.5 2.5 1.5 2.5 1.5-1.2 1.5-2.5S12.5 5.5 12 5.5z"/></svg>`,
};

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Hoffmann & Kollegen',
  tagline: 'Ästhetische Zahnmedizin & Bleaching Stuttgart',
  location: 'Stuttgart',
  email: 'info@praxis-hoffmann.de',
  phone: '+49 711 345678',
  heroTitle: 'Ästhetische Zahnmedizin. <em>Für Ihr perfektes Lächeln.</em>',
  heroSubtitle: 'Hoffmann & Kollegen sind Stuttgarts Spezialist für ästhetische Zahnmedizin — Bleaching, Veneers, Implantate. Mit modernster Technik und künstlerischem Gespür für Ihren individuellen Look.',
  services: [
    { icon: ICON.bleaching, title: 'Bleaching', description: 'Professionelles In-Office-Bleaching und individuelle Home-Bleaching-Systeme für ein strahlendes, natürlich wirkendes Lächeln. Schmelzschonend, effektiv und mit dauerhaftem Ergebnis.' },
    { icon: ICON.zahnersatz, title: 'Veneers & Kronen', description: 'Hauchdünne Keramik-Veneers und hochwertige Vollkeramik-Kronen — individuell gefertigt für ein natürlich schönes Lächeln. Wir planen gemeinsam mit Ihnen Ihr Traum-Lächeln.' },
    { icon: ICON.implantologie, title: 'Implantologie', description: 'Ästhetische Implantologie für dauerhaften, naturidentischen Zahnersatz — mit besonderem Augenmerk auf perfekte Optik und natürliches Erscheinungsbild des Zahnfleisches.' },
    { icon: ICON.kieferorthopaedie, title: 'Kieferorthopädie', description: 'Unsichtbare Clear-Aligner-Systeme für Erwachsene — diskret, komfortabel und ästhetisch. Gerades Gebiss als Basis für ein gesundes, schönes Lächeln ohne sichtbare Spange.' },
    { icon: ICON.prophylaxe, title: 'Prophylaxe', description: 'Professionelle Zahnreinigung als Basis für jede ästhetische Behandlung. Gesunde, gepflegte Zähne sind die schönsten Zähne — wir sorgen langfristig für beides.' },
    { icon: ICON.kinderzahnheilkunde, title: 'Kinderzahnheilkunde', description: 'Früh angesetzte ästhetische Prävention für die Kleinsten — damit gesunde Gewohnheiten zum natürlichen Teil des Alltags werden. Spielerisch, herzlich und nachhaltig.' },
  ],
  stats: [
    { value: '18+', label: 'Jahre Erfahrung' },
    { value: '5.100+', label: 'Patienten betreut' },
    { value: '4', label: 'Ästhetik-Spezialisten' },
    { value: '1.200+', label: 'Bleaching-Behandlungen' },
  ],
};

const processSteps = [
  { num: '01', title: 'Lächeln-Analyse', desc: 'Digitale Smile-Analyse und persönliche Beratung. Wir zeigen Ihnen, wie Ihr Wunsch-Lächeln aussehen kann — bevor die erste Behandlung beginnt.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>` },
  { num: '02', title: 'Behandlungsplan', desc: 'Transparenter Ästhetik-Plan mit digitaler Vorschau des Endergebnisses. Sie entscheiden — wir setzen um. Klare Kosten, keine versteckten Zusatzleistungen.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>` },
  { num: '03', title: 'Ästhetische Behandlung', desc: 'Präzise, schonende Behandlung mit Augenmerk auf natürliche Proportionen und Ästhetik. Jedes Detail ist auf Ihr individuelles Gesicht abgestimmt.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>` },
  { num: '04', title: 'Ergebnis genießen', desc: 'Nachsorge und Pflege sichern Ihr neues Lächeln. Wir zeigen Ihnen, wie Sie das Ergebnis optimal erhalten — für dauerhaft strahlende Zähne.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>` },
];

const vorsorge = [
  { icon: '✨', thema: 'Lächeln-Ästhetik', title: 'Was macht schöne Zähne aus?', desc: 'Farbe, Form, Position und Proportionen spielen zusammen. Wir zeigen Ihnen, welche kleinen Veränderungen die größte Wirkung haben.' },
  { icon: '🦷', thema: 'Bleaching-Tipps', title: 'Nach dem Bleaching', desc: 'Die ersten 48 Stunden sind entscheidend: keine Farbstoffe, kein Kaffee. Wir geben Ihnen eine persönliche Pflegeanleitung für dauerhaft helle Zähne.' },
  { icon: '💎', thema: 'Veneer-Pflege', title: 'Veneers richtig pflegen', desc: 'Veneers halten bei richtiger Pflege 10-15 Jahre. Elektrische Zahnbürste, Zahnseide und regelmäßige Prophylaxe schützen Ihre Investition.' },
  { icon: '📅', thema: 'Ästhetik-Check', title: 'Jährlicher Ästhetik-Check', desc: 'Einmal jährlich prüfen wir den Zustand Ihrer Restaurationen, Farbe und Gesundheit — damit Ihr Lächeln immer auf dem neuesten Stand bleibt.' },
];
---

<PreviewLayout profile={zahnarztProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} ctaText="Termin vereinbaren" ctaHref="#kontakt" />

  <header class="hero-full" id="hero">
    <div class="hero-full__bg">
      <img src="/preview-images/praxis-hoffmann/hero.jpg" alt="Zahnarztpraxis Hoffmann & Kollegen Stuttgart — ästhetische Zahnmedizin und Bleaching" width="1920" height="1080" loading="eager" fetchpriority="high" />
      <div class="hero-full__overlay"></div>
    </div>
    <div class="hero-full__content anim-fade-up">
      <div class="hero-full__badge">
        <span class="hero-full__badge-dot"></span>
        Stuttgart · Ästhetische Zahnmedizin · Bleaching & Veneers
      </div>
      <h1 class="hero-full__title">Ästhetische Zahnmedizin.<br/><span>Für Ihr perfektes Lächeln.</span></h1>
      <p class="hero-full__sub">{prospect.heroSubtitle}</p>
      <div class="hero-full__ctas">
        <a href="#kontakt" class="hero-full__btn-primary">Lächeln-Beratung anfragen</a>
        <a href="#leistungen" class="hero-full__btn-outline">Unsere Leistungen</a>
      </div>
    </div>
    <div class="hero-full__stats">
      {prospect.stats?.map(s => (
        <div class="hero-full__stat">
          <div class="hero-full__stat-val" data-count={s.value}>{s.value}</div>
          <div class="hero-full__stat-lbl">{s.label}</div>
        </div>
      ))}
    </div>
  </header>

  <section class="trust-bar">
    <div class="trust-bar__inner">
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>Ästhetik-Praxis Stuttgart</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>1.200+ Bleaching-Behandlungen</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Kassenzulassung vorhanden</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>4 Ästhetik-Spezialisten</span>
      </div>
    </div>
  </section>

  <section class="services-tabs" id="leistungen">
    <div class="services-tabs__inner">
      <div class="services-tabs__header">
        <div class="services-tabs__badge">Unsere Leistungen</div>
        <h2 class="services-tabs__title">Was können wir <em>für Ihr Lächeln tun?</em></h2>
        <p class="services-tabs__sub">Von Bleaching bis Vollkeramik — ästhetische Zahnmedizin auf höchstem Niveau, individuell auf Sie abgestimmt.</p>
      </div>
      <div class="services-tabs__nav" role="tablist">
        {prospect.services.map((s, i) => (
          <button class={`services-tabs__tab ${i === 0 ? 'is-active' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i} type="button">
            <span class="services-tabs__tab-icon" set:html={s.icon} />
            <span>{s.title}</span>
          </button>
        ))}
      </div>
      <div class="services-tabs__panels">
        {prospect.services.map((s, i) => (
          <div class={`services-tabs__panel ${i === 0 ? 'is-active' : ''}`} role="tabpanel" data-panel={i}>
            <div class="services-tabs__panel-icon" set:html={s.icon} />
            <h3 class="services-tabs__panel-title">{s.title}</h3>
            <p class="services-tabs__panel-desc">{s.description}</p>
            <a href="#kontakt" class="services-tabs__panel-cta">Jetzt Termin anfragen &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="process" id="ablauf">
    <div class="process__inner">
      <div class="process__header">
        <div class="process__badge">Unser Ästhetik-Prozess</div>
        <h2 class="process__title">Ihr Weg zum <em>perfekten Lächeln</em></h2>
        <p class="process__sub">Von der Lächeln-Analyse bis zum strahlenden Ergebnis — transparent, individuell und auf Ihre Wünsche abgestimmt.</p>
      </div>
      <div class="process__steps">
        {processSteps.map((step, i) => (
          <div class="process__step">
            <div class="process__step-icon" set:html={step.icon} />
            <div class="process__step-num">{step.num}</div>
            <h3 class="process__step-title">{step.title}</h3>
            <p class="process__step-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="showcase" id="galerie">
    <div class="showcase__inner">
      <div class="showcase__header">
        <div class="showcase__badge">Vorher — Nachher</div>
        <h2 class="showcase__title">Echte Ergebnisse <em>von echten Patienten</em></h2>
        <p class="showcase__sub">Jedes Lächeln ist einzigartig — unsere Vorher-Nachher-Ergebnisse zeigen, was ästhetische Zahnmedizin möglich macht.</p>
      </div>
      <div class="showcase__grid anim-on-scroll">
        <div class="showcase__item showcase__item--large">
          <img src="/preview-images/praxis-hoffmann/gallery-1.jpg" alt="Bleaching Ergebnis Zahnarztpraxis Hoffmann Stuttgart" loading="lazy" width="800" height="600" />
          <div class="showcase__caption">
            <span class="showcase__tag">Bleaching</span>
            <h3>Professionelles In-Office-Bleaching</h3>
            <p>Deutlich hellere Zähne nach einer einzigen Sitzung — schonend und dauerhaft.</p>
          </div>
        </div>
        <div class="showcase__item showcase__item--small">
          <img src="/preview-images/praxis-hoffmann/gallery-2.jpg" alt="Keramik Veneers Stuttgart" loading="lazy" width="500" height="280" />
          <div class="showcase__caption">
            <span class="showcase__tag">Veneers</span>
            <h3>Vollkeramik-Veneers</h3>
          </div>
        </div>
        <div class="showcase__item showcase__item--small">
          <img src="/preview-images/praxis-hoffmann/gallery-3.jpg" alt="Ästhetischer Zahnersatz Vollkeramik Stuttgart" loading="lazy" width="500" height="280" />
          <div class="showcase__caption">
            <span class="showcase__tag">Ästhetik</span>
            <h3>Natürlich wirkendes Lächeln</h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PreviewTestimonials
    title="Das sagen unsere Patienten"
    subtitle="Über 5.100 Patienten vertrauen Hoffmann & Kollegen für ihr Lächeln — hier berichten einige von ihnen."
    testimonials={[
      { text: 'Das Bleaching hat mein Lächeln komplett verändert. In nur einer Sitzung waren meine Zähne so hell wie nie zuvor — und die Beratung war so kompetent und einfühlsam, dass ich sofort Vertrauen gefasst habe.', author: 'Anna-Lena K.', role: 'Patientin, Stuttgart Mitte', rating: 5 },
      { text: 'Meine Veneers sehen absolut natürlich aus — meine Kollegen denken, ich hätte einfach tolle Zähne von Natur aus. Das ist das beste Kompliment! Die Beratung war umfassend und sehr ehrlich.', author: 'Markus B.', role: 'Veneer-Patient, Stuttgart-West', rating: 5 },
      { text: 'Nach 30 Jahren mit Zahnkomplex habe ich endlich durch Hoffmann & Kollegen mein Lächeln gefunden. Clear Aligner + Bleaching — das Ergebnis übertrifft alle meine Erwartungen. Danke!', author: 'Petra W.', role: 'Aligner & Bleaching-Patientin, Stuttgart', rating: 5 },
    ]}
  />

  <section class="vorsorge" id="vorsorge">
    <div class="vorsorge__inner">
      <div class="vorsorge__header">
        <h2 class="vorsorge__title">Ästhetik-Tipps für zuhause</h2>
        <p class="vorsorge__sub">So erhalten Sie Ihr schönes Lächeln zwischen den Terminen — einfach, effektiv und dauerhaft.</p>
      </div>
      <div class="vorsorge__grid">
        {vorsorge.map(tip => (
          <div class="vorsorge__card">
            <div class="vorsorge__icon">{tip.icon}</div>
            <div class="vorsorge__thema">{tip.thema}</div>
            <h3 class="vorsorge__card-title">{tip.title}</h3>
            <p class="vorsorge__card-desc">{tip.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="estimator" id="kalkulator">
    <div class="estimator__inner">
      <div class="estimator__header">
        <div class="estimator__badge">Kostenrechner</div>
        <h2 class="estimator__title">Was kostet <em>Ihr Traum-Lächeln?</em></h2>
        <p class="estimator__sub">Erhalten Sie eine unverbindliche Ersteinschätzung — in unter 30 Sekunden.</p>
      </div>
      <div class="estimator__form">
        <div class="estimator__field">
          <label class="estimator__label">Art der Behandlung</label>
          <div class="estimator__options">
            <button class="estimator__option is-active" data-value="implantate" type="button">Implantate</button>
            <button class="estimator__option" data-value="bleaching" type="button">Bleaching</button>
            <button class="estimator__option" data-value="veneers" type="button">Veneers</button>
          </div>
        </div>
        <div class="estimator__field">
          <label class="estimator__label" id="qty-label">Anzahl Implantate</label>
          <div class="estimator__slider-wrap">
            <input type="range" min="1" max="8" value="1" class="estimator__slider" id="qty-slider" />
            <span class="estimator__slider-val" id="qty-val">1 Stück</span>
          </div>
        </div>
        <div class="estimator__result">
          <div class="estimator__result-label">Geschätzte Kosten</div>
          <div class="estimator__result-val" id="estimate-val">ca. 1.500 — 3.000 €</div>
          <div class="estimator__result-note">Unverbindliche Schätzung. Genaue Kosten nach kostenloser Lächeln-Beratung.</div>
          <a href="#kontakt" class="estimator__result-cta">Jetzt kostenlose Lächeln-Beratung anfragen</a>
        </div>
      </div>
    </div>
  </section>

  <PreviewCTA
    title="Ihr Lächeln ist unsere Leidenschaft."
    subtitle="Vereinbaren Sie jetzt Ihre kostenlose Lächeln-Beratung bei Hoffmann & Kollegen in Stuttgart. Bleaching, Veneers, Implantate — wir finden gemeinsam die perfekte Lösung für Ihr individuelles Traum-Lächeln."
    badge="Kostenlose Beratung"
    buttonText="Jetzt Lächeln-Beratung anfragen"
    buttonLink="#kontakt"
    phone="+49 711 345678"
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    address="Königstraße 28, 70173 Stuttgart"
    year={2025}
  />
</PreviewLayout>

<style>
  html { scroll-behavior: smooth; }
  .anim-fade-up { animation: fadeUp 0.8s ease-out both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  .anim-on-scroll { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .anim-on-scroll.is-visible { opacity: 1; transform: translateY(0); }
  .hero-full { position: relative; min-height: 80vh; max-height: 700px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
  .hero-full__bg { position: absolute; inset: 0; z-index: 0; }
  .hero-full__bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .hero-full__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(8,22,20,0.96) 0%, rgba(8,22,20,0.72) 35%, rgba(8,22,20,0.35) 65%, rgba(8,22,20,0.15) 100%); }
  .hero-full__content { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 48px 48px; width: 100%; }
  .hero-full__badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.18); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: rgba(255,255,255,0.9); margin-bottom: 20px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }
  .hero-full__badge-dot { width: 7px; height: 7px; background: #2DD4BF; border-radius: 50%; animation: pulse-hero 2s ease-in-out infinite; }
  @keyframes pulse-hero { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.75); } }
  .hero-full__title { font-family: var(--font-heading); font-size: clamp(2.8rem, 5.5vw, 4.2rem); font-weight: 800; line-height: 1.05; letter-spacing: -0.03em; color: #fff; margin-bottom: 20px; }
  .hero-full__title span { color: #2DD4BF; }
  .hero-full__sub { color: rgba(255,255,255,0.75); font-size: 1.1rem; line-height: 1.7; max-width: 560px; margin-bottom: 32px; }
