---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztFamilieProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Weber',
  tagline: 'Familienzahnarzt in Stuttgart-Mitte',
  location: 'Stuttgart-Mitte',
  email: 'info@zahnarzt-weber-stuttgart.de',
  phone: '+49 711 4567890',
  heroTitle: 'Zahngesund aufwachsen. Zahngesund bleiben.',
  heroSubtitle: 'Vom ersten Milchzahn bis zur Seniorenversorgung: Praxis Weber in Stuttgart begleitet über 3.000 Familien. Weil gute Zahngesundheit kein Zufall ist — sondern ein Familienprojekt.',
  services: [
    { icon: 'heart', title: 'Kinderzahnheilkunde', description: 'Spielerische und behutsame Behandlung für die Kleinen — damit der Zahnarztbesuch Spaß macht.' },
    { icon: 'smile', title: 'Jugendzahnheilkunde', description: 'Kieferorthopädische Beratung, Brackets und Aligner für Teenager — gemeinsam zum perfekten Lächeln.' },
    { icon: 'tooth', title: 'Erwachsenenversorgung', description: 'Füllungen, Kronen, Brücken und Implantate — hochwertige Versorgung für dauerhaft gesunde Zähne.' },
    { icon: 'shield', title: 'Seniorenbehandlung', description: 'Einfühlsame Behandlung mit besonderem Fokus auf Prothesen, Implantate und Zahnfleischgesundheit.' },
    { icon: 'check', title: 'Prophylaxe für die Familie', description: 'Professionelle Zahnreinigung und Vorsorge für alle Altersgruppen — auch als Familienprogramm.' },
    { icon: 'star', title: 'Notfallversorgung', description: 'Schnelle Hilfe bei Zahnschmerzen und Notfällen — auch außerhalb regulärer Sprechzeiten.' },
  ],
  stats: [
    { value: '25+', label: 'Jahre Familienzahnarzt' },
    { value: '3.000+', label: 'Familien betreut' },
    { value: '4.8★', label: 'Google-Bewertung' },
  ],
};
---

<PreviewLayout profile={zahnarztFamilieProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    ctaText="Termin buchen"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Familienzahnarzt seit 2001"
    ctaPrimary={{ text: 'Familientermin anfragen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Was macht einen guten Familienzahnarzt aus? →', href: '#leistungen' }}
    imageSrc="/preview-images/zahnarzt-weber/hero.jpg"
    imageAlt="Zahnarztpraxis Weber Stuttgart — Familienzahnarzt"
    stats={prospect.stats}
  />

  <ZahnarztServices
    title="Für Ihre ganze Familie"
    subtitle="Ob Klein oder Groß — wir haben für jedes Alter die passende Behandlung."
    services={prospect.services}
  />

  <ZahnarztTimeline
    title="So läuft der erste Besuch"
    subtitle="Kein Stress, kein Zeitdruck. Wir nehmen uns Zeit zum Kennenlernen."
    steps={[
      { num: 1, title: 'Ankommen', desc: 'Spielecke für die Kleinen, Getränke für die Großen. Ankommen und wohlfühlen.', icon: 'phone' },
      { num: 2, title: 'Kennenlernen', desc: 'Wir besprechen Ihre Wünsche und Sorgen. Bei Kindern: erst mal nur gucken, kein Druck.', icon: 'search' },
      { num: 3, title: 'Befund', desc: 'Schonende Untersuchung für alle Familienmitglieder. Alles verständlich erklärt, keine Fachbegriffe.', icon: 'tooth' },
      { num: 4, title: 'Gemeinsamer Plan', desc: 'Ein Vorsorgeplan für die ganze Familie. Ein Recall-System, damit kein Termin vergessen wird.', icon: 'calendar' },
    ]}
  />

  <ZahnarztBeforeAfter
    title="Behandlungsergebnisse für die ganze Familie"
    subtitle="Gesunde, schöne Zähne in jedem Alter — das ist unser Versprechen."
    cases={[
      { beforeSrc: '/preview-images/zahnarzt-weber/gallery-1.jpg', afterSrc: '/preview-images/zahnarzt-weber/gallery-2.jpg', label: 'Invisalign-Korrektur Erwachsene — Diskrete Zahnkorrektur über 12 Monate.' },
      { beforeSrc: '/preview-images/zahnarzt-weber/gallery-3.jpg', afterSrc: '/preview-images/zahnarzt-weber/gallery-4.jpg', label: 'Kinderprophylaxe — Gesunde Milchzähne als Grundlage für bleibende Zähne.' },
    ]}
  />

  <ZahnarztCostCalc />

  <PreviewTestimonials
    title="Familien über Praxis Weber"
    testimonials={[
      { text: 'Unsere ganze Familie geht zu Praxis Weber — von der Ältesten (76) bis zum Jüngsten (4). Alle fühlen sich hier wohl.', author: 'Familie Becker', role: 'Stammkunden' },
      { text: 'Meine Kinder freuen sich tatsächlich auf den Zahnarzt! Das Team hat eine tolle Art mit den Kleinen umzugehen.', author: 'Laura M.', role: 'Mutter von 3 Kindern' },
      { text: 'Seit Jahren unsere Praxis des Vertrauens. Immer zuvorkommend, kompetent und menschlich.', author: 'Heinrich G.', role: 'Patient seit 12 Jahren' },
    ]}
  />

  <PreviewCTA
    title="Anrufen und Familientermin buchen"
    subtitle="Wir nehmen neue Familien auf — vereinbaren Sie jetzt einen gemeinsamen Termin für alle."
    ctaText="Familientermin anfragen"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>
