---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztFamilieProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztFamilyAges from '../../templates/sections/zahnarzt/ZahnarztFamilyAges.astro';
import ZahnarztTeam from '../../templates/sections/zahnarzt/ZahnarztTeam.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Weber',
  tagline: 'Familienzahnarzt in Stuttgart-Mitte',
  location: 'Stuttgart-Mitte',
  email: 'info@zahnarzt-weber-stuttgart.de',
  phone: '+49 711 4567890',
  heroTitle: 'Zahngesund aufwachsen. Zahngesund bleiben.',
  heroSubtitle: 'Vom ersten Milchzahn bis zur Seniorenversorgung: Praxis Weber in Stuttgart begleitet über 3.000 Familien. Weil gute Zahngesundheit kein Zufall ist — sondern ein Familienprojekt.',
  services: [
    { icon: 'heart', title: 'Kinderzahnheilkunde', description: 'Spielerische und behutsame Behandlung für die Kleinen — damit der Zahnarztbesuch Spaß macht.' },
    { icon: 'smile', title: 'Jugendzahnheilkunde', description: 'Kieferorthopädische Beratung, Brackets und Aligner für Teenager — gemeinsam zum perfekten Lächeln.' },
    { icon: 'tooth', title: 'Erwachsenenversorgung', description: 'Füllungen, Kronen, Brücken und Implantate — hochwertige Versorgung für dauerhaft gesunde Zähne.' },
    { icon: 'shield', title: 'Seniorenbehandlung', description: 'Einfühlsame Behandlung mit besonderem Fokus auf Prothesen, Implantate und Zahnfleischgesundheit.' },
    { icon: 'check', title: 'Prophylaxe für die Familie', description: 'Professionelle Zahnreinigung und Vorsorge für alle Altersgruppen — auch als Familienprogramm.' },
    { icon: 'star', title: 'Notfallversorgung', description: 'Schnelle Hilfe bei Zahnschmerzen und Notfällen — auch außerhalb regulärer Sprechzeiten.' },
  ],
  stats: [
    { value: '25+', label: 'Jahre Familienzahnarzt' },
    { value: '3.000+', label: 'Familien betreut' },
    { value: '4.8★', label: 'Google-Bewertung' },
  ],
};
---

<PreviewLayout profile={zahnarztFamilieProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    ctaText="Termin buchen"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Familienzahnarzt seit 2001"
    ctaPrimary={{ text: 'Familientermin anfragen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Was macht einen guten Familienzahnarzt aus? →', href: '#leistungen' }}
    imageSrc="/preview-images/zahnarzt-weber/hero.jpg"
    imageAlt="Zahnarztpraxis Weber Stuttgart — Familienzahnarzt"
    stats={prospect.stats}
  />

  <div class="zh-trust-bar" role="list" aria-label="Qualitätsmerkmale">
    <div class="zh-trust-bar__inner">
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span>Familien seit 2001 willkommen</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span>Kindgerechte Atmosphäre</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Alle Kassen & Privat</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span>4,8★ Google Stuttgart</span>
      </div>
    </div>
  </div>

  <ZahnarztServices
    title="Für Ihre ganze Familie"
    subtitle="Ob Klein oder Groß — wir haben für jedes Alter die passende Behandlung."
    services={prospect.services}
  />

  <ZahnarztFamilyAges
    title="Für jedes Alter die richtige Behandlung"
    subtitle="Von den ersten Milchzähnen bis zur Seniorenversorgung — Praxis Weber kennt die Bedürfnisse jeder Generation."
    ageGroups={[
      {
        ageRange: '3–12 Jahre',
        title: 'Kinderzahnheilkunde',
        description: 'Spielerische Behandlung, die Kindern zeigt: Zahnarzt kann Spaß machen. Prophylaxe, Versiegelungen und Fluoridierung für starke Milchzähne.',
        icon: 'child',
      },
      {
        ageRange: '13–25 Jahre',
        title: 'Jugendzahnheilkunde',
        description: 'Kieferorthopädische Beratung, Invisalign und ästhetische Korrekturen für Teenager und junge Erwachsene — damit das Lächeln stimmt.',
        icon: 'teen',
      },
      {
        ageRange: '26+ Jahre',
        title: 'Erwachsene & Senioren',
        description: 'Kronen, Implantate, Prothesenversorgung und Parodontitisbehandlung — langfristig gesunde Zähne in jedem Lebensabschnitt.',
        icon: 'adult',
      },
    ]}
  />

  <ZahnarztTeam
    name="Dr. Petra Weber"
    title="Zahnärztin & Familienspezialistin, Stuttgart-Mitte"
    bio="Seit über 25 Jahren begleite ich Familien durch alle Phasen des Lebens — vom ersten Milchzahn bis zum gepflegten Seniorengebiss. Was mich antreibt: Vertrauen. Denn wer unserem Team vertraut, kommt gerne wieder."
    qualifications={[
      'Approbierte Zahnärztin (Universität Tübingen)',
      'Fortbildungszertifikat Kinderzahnheilkunde (DGKiZa)',
      'Geriatrie-Fortbildung (Seniorenbehandlung)',
      'Prophylaxe-Zertifikat für alle Altersgruppen',
      'Notfallmedizin & Erste Hilfe aktualisiert',
    ]}
    cta={{ text: 'Team kennenlernen — Familientermin buchen', href: '#kontakt' }}
  />

  <PreviewTestimonials
    title="Familien über Praxis Weber"
    testimonials={[
      { text: 'Unsere ganze Familie geht zu Praxis Weber — von der Ältesten (76) bis zum Jüngsten (4). Alle fühlen sich hier wohl.', author: 'Familie Becker', role: 'Stammkunden' },
      { text: 'Meine Kinder freuen sich tatsächlich auf den Zahnarzt! Das Team hat eine tolle Art mit den Kleinen umzugehen.', author: 'Laura Müller', role: 'Mutter von 3 Kindern' },
      { text: 'Seit Jahren unsere Praxis des Vertrauens. Immer zuvorkommend, kompetent und menschlich.', author: 'Heinrich Gottschalk', role: 'Patient seit 12 Jahren' },
    ]}
  />

  <PreviewCTA
    title="Anrufen und Familientermin buchen"
    subtitle="Wir nehmen neue Familien auf — vereinbaren Sie jetzt einen gemeinsamen Termin für alle."
    ctaText="Familien-Checkup vereinbaren"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>

<style>
  .zh-trust-bar {
    background: linear-gradient(
      to bottom,
      var(--bg-deep, #0d1f1c),
      color-mix(in srgb, var(--accent, #0E8A7B) 4%, var(--bg-deep, #0d1f1c))
    );
    border-bottom: 1px solid rgba(14, 138, 123, 0.15);
  }

  .zh-trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 20px 48px;
    flex-wrap: wrap;
  }

  .zh-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted, #8aafa5);
    white-space: nowrap;
  }

  .zh-trust-bar__item svg {
    color: var(--accent, #0E8A7B);
    flex-shrink: 0;
  }

  .zh-trust-bar__divider {
    width: 1px;
    height: 24px;
    background: rgba(14, 138, 123, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .zh-trust-bar__inner {
      gap: 16px;
      padding: 16px 24px;
    }

    .zh-trust-bar__divider {
      display: none;
    }

    .zh-trust-bar__item {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .zh-trust-bar__inner {
      justify-content: flex-start;
      gap: 12px;
    }

    .zh-trust-bar__item {
      flex: 1 1 calc(50% - 6px);
      min-width: 0;
      white-space: normal;
    }
  }
</style>
