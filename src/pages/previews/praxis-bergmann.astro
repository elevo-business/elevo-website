---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztFamilieProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Bergmann',
  tagline: 'Familienzahnarzt Hamburg-Altona',
  location: 'Hamburg-Altona',
  email: 'info@praxis-bergmann-hh.de',
  phone: '+49 40 3892740',
  heroTitle: 'Familienzahnarzt in <em>Hamburg-Altona.</em>',
  heroSubtitle: 'Zahnarztpraxis Bergmann ist Ihr Familienzahnarzt für alle Generationen — von den ersten Milchzähnen bis zum gepflegten Seniorengebiss. Einfühlsam, geduldig und herzlich in Hamburg-Altona.',
  services: [
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>', title: 'Prophylaxe & Vorsorge', description: 'Regelmäßige professionelle Zahnreinigung und individuelle Vorsorgeberatung für die ganze Familie — damit Ihre Zähne ein Leben lang gesund bleiben.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>', title: 'Kinderzahnheilkunde', description: 'Spielerische und angstfreie Behandlung für unsere kleinen Patienten — wir legen das Fundament für lebenslange Zahngesundheit von Anfang an.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>', title: 'Füllungstherapie', description: 'Hochwertige Komposit- und Keramikfüllungen in Zahnfarbe — schonend, langlebig und ästhetisch für ein natürliches Ergebnis.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>', title: 'Zahnersatz', description: 'Individuelle Zahnersatzlösungen von Kronen und Brücken bis hin zu herausnehmbarem Zahnersatz — für jeden Bedarf und jedes Budget.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>', title: 'Bleaching', description: 'Professionelles Zahnaufhellen für ein strahlendes Lächeln — sicher, wirksam und mit maßgeschneiderten Schienen für zu Hause oder in der Praxis.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>', title: 'Angstpatienten-Behandlung', description: 'Einfühlsame Betreuung für Menschen mit Zahnarztangst — wir nehmen uns Zeit, schaffen Vertrauen und sorgen für eine entspannte Behandlung.' },
  ],
  stats: [
    { value: '20+', label: 'Jahre Erfahrung' },
    { value: '6.000+', label: 'Patienten betreut' },
    { value: '3', label: 'Zahnärzte im Team' },
    { value: 'Familienzahnarzt', label: 'Seit 2004' },
  ],
};

const processSteps = [
  { num: '01', title: 'Erstbesuch', desc: 'Herzliches Willkommen in der Praxis Bergmann — wir lernen Sie und Ihre Familie kennen und nehmen uns Zeit für eine umfassende Erstuntersuchung.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' },
  { num: '02', title: 'Diagnose', desc: 'Sorgfältige Befunderhebung mit digitaler Röntgendiagnostik — wir erkennen Probleme frühzeitig und transparent, damit Sie gut informiert sind.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>' },
  { num: '03', title: 'Behandlungsplan', desc: 'Klarer, verständlicher Behandlungsplan mit Kostentransparenz — gemeinsam entscheiden wir, was für Sie und Ihre Familie am besten passt.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>' },
  { num: '04', title: 'Behandlung', desc: 'Schonende, einfühlsame Behandlung in einer familiären Atmosphäre — wir arbeiten präzise und nehmen uns die Zeit, die Sie brauchen.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>' },
];

const ratgeberCards = [
  { thema: 'Milchzähne', icon: '🧒', title: 'Milchzähne richtig pflegen', desc: 'Milchzähne sind wichtig für die Entwicklung des Kiefers und der bleibenden Zähne. Ab dem ersten Zahn täglich putzen und ab dem 1. Geburtstag zum Zahnarzt.' },
  { thema: 'Prophylaxe', icon: '✨', title: 'Vorsorge für die ganze Familie', desc: 'Zweimal jährlich zur professionellen Zahnreinigung senkt das Kariesrisiko drastisch. Für Kinder ab 6 Jahren empfehlen wir die individuelle Prophylaxe mit Fissurenversiegelung.' },
  { thema: 'Angstpatienten', icon: '💙', title: 'Zahnarztangst überwinden', desc: 'Zahnarztangst ist weit verbreitet und gut behandelbar. In unserer Praxis setzen wir auf Vertrauen, Ruhe und klare Kommunikation — damit jeder Besuch entspannt wird.' },
  { thema: 'Füllungen', icon: '🦷', title: 'Füllungen: Amalgam oder Kunststoff?', desc: 'Moderne zahnfarbene Komposit-Füllungen sind heute die erste Wahl — ästhetisch, langlebig und metallfrei. Wir beraten Sie gerne zu Ihren Möglichkeiten.' },
];
---

<PreviewLayout profile={zahnarztFamilieProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} logo="" ctaText="Termin vereinbaren" ctaHref="#kontakt" />

  <header class="hero-full" id="hero">
    <div class="hero-full__bg">
      <img src="https://images.unsplash.com/photo-1588776814546-daab30f310ce?w=1920&q=80&fit=crop" alt="Zahnarztpraxis Bergmann in Hamburg-Altona" width="1920" height="1080" loading="eager" fetchpriority="high" />
      <div class="hero-full__overlay"></div>
    </div>
    <div class="hero-full__content anim-fade-up">
      <div class="hero-full__badge">
        <span class="hero-full__badge-dot"></span>
        Hamburg-Altona · Familienzahnarzt · Seit 2004
      </div>
      <h1 class="hero-full__title">Familienzahnarzt in<br/><span>Hamburg-Altona.</span></h1>
      <p class="hero-full__sub">{prospect.heroSubtitle}</p>
      <div class="hero-full__ctas">
        <a href="#kontakt" class="hero-full__btn-primary">Termin vereinbaren</a>
        <a href="#leistungen" class="hero-full__btn-outline">Unsere Leistungen</a>
      </div>
    </div>
    <div class="hero-full__stats">
      {prospect.stats?.map(s => (
        <div class="hero-full__stat">
          <div class="hero-full__stat-val" data-count={s.value}>{s.value}</div>
          <div class="hero-full__stat-lbl">{s.label}</div>
        </div>
      ))}
    </div>
  </header>

  <section class="trust-bar">
    <div class="trust-bar__inner">
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Modernste Technik</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span>Angstpatienten willkommen</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>Schmerzarme Behandlung</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>5-Sterne-Bewertungen</span>
      </div>
    </div>
  </section>

  <section class="services-tabs" id="leistungen">
    <div class="services-tabs__inner">
      <div class="services-tabs__header">
        <div class="services-tabs__badge">Unsere Leistungen</div>
        <h2 class="services-tabs__title">Was können wir <em>für Sie tun?</em></h2>
        <p class="services-tabs__sub">Von der Kinderzahnheilkunde bis zur Seniorenversorgung — wählen Sie einen Bereich, der Sie interessiert.</p>
      </div>
      <div class="services-tabs__nav" role="tablist">
        {prospect.services.map((s, i) => (
          <button class={`services-tabs__tab ${i === 0 ? 'is-active' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i} type="button">
            <span class="services-tabs__tab-icon" set:html={s.icon} />
            <span>{s.title}</span>
          </button>
        ))}
      </div>
      <div class="services-tabs__panels">
        {prospect.services.map((s, i) => (
          <div class={`services-tabs__panel ${i === 0 ? 'is-active' : ''}`} role="tabpanel" data-panel={i}>
            <div class="services-tabs__panel-icon" set:html={s.icon} />
            <h3 class="services-tabs__panel-title">{s.title}</h3>
            <p class="services-tabs__panel-desc">{s.description}</p>
            <a href="#kontakt" class="services-tabs__panel-cta">Jetzt Termin vereinbaren &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="process" id="ablauf">
    <div class="process__inner">
      <div class="process__header">
        <div class="process__badge">So arbeiten wir</div>
        <h2 class="process__title">Ihr Weg zu einem <em>gesunden Lächeln</em></h2>
        <p class="process__sub">Transparent, einfühlsam und auf Augenhöhe — von Ihrem ersten Besuch bis zur erfolgreichen Behandlung.</p>
      </div>
      <div class="process__steps">
        {processSteps.map((step, i) => (
          <div class="process__step anim-on-scroll">
            <div class="process__step-icon" set:html={step.icon} />
            <div class="process__step-num">{step.num}</div>
            <h3 class="process__step-title">{step.title}</h3>
            <p class="process__step-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="showcase" id="praxis">
    <div class="showcase__inner">
      <div class="showcase__header">
        <div class="showcase__badge">Einblicke</div>
        <h2 class="showcase__title">Familienfreundliche Praxis in <em>Wohlfühlatmosphäre</em></h2>
        <p class="showcase__sub">Helle Räume, moderne Ausstattung und ein herzliches Team — Zahnmedizin für die ganze Familie, die Sie entspannt erwartet.</p>
      </div>
      <div class="showcase__grid showcase__grid--two anim-on-scroll">
        <div class="showcase__item">
          <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=800&q=80&fit=crop" alt="Moderner Behandlungsraum Praxis Bergmann Hamburg" loading="lazy" width="800" height="600" />
          <div class="showcase__caption">
            <span class="showcase__tag">Behandlungsraum</span>
            <h3>Modern & Kindgerecht</h3>
            <p>Unsere Behandlungsräume sind freundlich gestaltet — damit sich Groß und Klein von Anfang an wohlfühlen.</p>
          </div>
        </div>
        <div class="showcase__item">
          <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=800&q=80&fit=crop" alt="Freundliches Zahnarzt-Team Bergmann Hamburg-Altona" loading="lazy" width="800" height="600" />
          <div class="showcase__caption">
            <span class="showcase__tag">Unser Team</span>
            <h3>Herzlich & Erfahren</h3>
            <p>Drei erfahrene Zahnärzte und ein eingespieltes Team — immer offen für Fragen und auf Ihre Bedürfnisse eingestellt.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PreviewTestimonials
    title="Was unsere Patienten sagen"
    subtitle="Über 6.000 betreute Patienten aus Hamburg-Altona und Umgebung — lesen Sie, was Familien über ihre Erfahrungen bei uns berichten."
    testimonials={[
      { text: 'Praxis Bergmann ist seit Jahren unsere Familienzahnarztpraxis. Alle drei Kinder gehen gerne zur Kontrolle — das Team ist unglaublich geduldig und kindgerecht. Kein Drama, nur Lächeln!', author: 'Sandra L.', role: 'Patientin seit 2011, Hamburg-Altona', rating: 5 },
      { text: 'Als Angstpatient hatte ich jahrelang Probleme, einen Zahnarzt zu finden, der Geduld mit mir hat. Dr. Bergmann nimmt sich wirklich Zeit, erklärt alles und ich verlasse die Praxis entspannt.', author: 'Klaus W.', role: 'Patient seit 2016, Hamburg', rating: 5 },
      { text: 'Drei Generationen unserer Familie werden hier behandelt — von meiner Mutter bis zu meinen Enkeln. Eine echte Familienzahnarztpraxis, die man weiterempfehlen kann!', author: 'Ursula M.', role: 'Langzeit-Patientin, Hamburg-Altona', rating: 5 },
    ]}
  />

  <section class="ratgeber" id="ratgeber">
    <div class="ratgeber__inner">
      <div class="ratgeber__header">
        <h2 class="ratgeber__title">Zahngesundheits-Ratgeber</h2>
        <p class="ratgeber__sub">Wissenswertes rund um Ihre Zahngesundheit — von unserem Team für Sie und Ihre Familie zusammengestellt.</p>
      </div>
      <div class="ratgeber__grid">
        {ratgeberCards.map(card => (
          <div class="ratgeber__card anim-on-scroll">
            <div class="ratgeber__icon">{card.icon}</div>
            <div class="ratgeber__thema">{card.thema}</div>
            <h3 class="ratgeber__card-title">{card.title}</h3>
            <p class="ratgeber__card-desc">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="estimator" id="kalkulator">
    <div class="estimator__inner">
      <div class="estimator__header">
        <div class="estimator__badge">Kostenrechner</div>
        <h2 class="estimator__title">Was kostet <em>Ihre Behandlung?</em></h2>
        <p class="estimator__sub">Erhalten Sie eine erste unverbindliche Kostenschätzung für Ihre Wunschbehandlung.</p>
      </div>
      <div class="estimator__form">
        <div class="estimator__field">
          <label class="estimator__label">Art der Behandlung</label>
          <div class="estimator__options" data-field="type">
            <button class="estimator__option is-active" data-value="implantate" type="button">Implantate</button>
            <button class="estimator__option" data-value="bleaching" type="button">Bleaching</button>
            <button class="estimator__option" data-value="veneers" type="button">Veneers</button>
          </div>
        </div>
        <div class="estimator__field">
          <label class="estimator__label" id="unit-label">Anzahl Zähne / Kiefer</label>
          <div class="estimator__slider-wrap">
            <input type="range" min="1" max="8" value="2" class="estimator__slider" id="unit-slider" />
            <span class="estimator__slider-val" id="unit-val">2 Zähne</span>
          </div>
        </div>
        <div class="estimator__result">
          <div class="estimator__result-label">Geschätzte Kosten</div>
          <div class="estimator__result-val" id="estimate-val">ca. 3.000 — 6.000 €</div>
          <div class="estimator__result-note">Unverbindliche Schätzung. Genaue Kosten nach Untersuchung und individuellem Behandlungsplan.</div>
          <a href="#kontakt" class="estimator__result-cta">Kostenloses Beratungsgespräch vereinbaren</a>
        </div>
      </div>
    </div>
  </section>

  <PreviewCTA
    title="Bereit für einen Termin in Hamburg-Altona?"
    subtitle="Vereinbaren Sie jetzt Ihren Termin bei Zahnarztpraxis Bergmann. Für alle Generationen — einfühlsam, herzlich und kompetent in Hamburg-Altona."
    badge="Termin vereinbaren"
    buttonText="Jetzt Termin buchen"
    buttonLink="#kontakt"
    phone="+49 40 3892740"
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    address="Ottenser Hauptstraße 18, 22765 Hamburg-Altona"
    year={2025}
  />
</PreviewLayout>

<style>
  html { scroll-behavior: smooth; }
  .anim-fade-up { animation: fadeUp 0.8s ease-out both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  .anim-on-scroll { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .anim-on-scroll.is-visible { opacity: 1; transform: translateY(0); }

  .hero-full { position: relative; min-height: 80vh; max-height: 700px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
  .hero-full__bg { position: absolute; inset: 0; z-index: 0; }
  .hero-full__bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .hero-full__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,25,22,0.92) 0%, rgba(10,25,22,0.6) 40%, rgba(10,25,22,0.3) 100%); }
  .hero-full__content { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 48px 48px; width: 100%; }
  .hero-full__badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.18); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: rgba(255,255,255,0.9); margin-bottom: 20px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }
  .hero-full__badge-dot { width: 7px; height: 7px; background: #0E8A7B; border-radius: 50%; animation: pulse-hero 2s ease-in-out infinite; }
  @keyframes pulse-hero { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.75); } }
  .hero-full__title { font-family: var(--font-heading); font-size: clamp(2.8rem, 5.5vw, 4.2rem); font-weight: 800; line-height: 1.05; letter-spacing: -0.03em; color: #fff; margin-bottom: 20px; }
  .hero-full__title span { color: #4ECDC4; }
  .hero-full__sub { color: rgba(255,255,255,0.8); font-size: 1.1rem; line-height: 1.7; max-width: 580px; margin-bottom: 32px; }
  .hero-full__ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-full__btn-primary { background: var(--accent); color: #fff; padding: 14px 28px; border-radius: 10px; font-size: 0.95rem; font-weight: 600; font-family: var(--font-body); transition: background 0.2s, transform 0.2s; text-decoration: none; }
  .hero-full__btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); }
  .hero-full__btn-outline { border: 1px solid rgba(255,255,255,0.3); color: #fff; padding: 14px 28px; border-radius: 10px; font-size: 0.95rem; font-weight: 500; font-family: var(--font-body); transition: border-color 0.2s, background 0.2s; text-decoration: none; }
  .hero-full__btn-outline:hover { border-color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.08); }
  .hero-full__stats { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255,255,255,0.1); border-top: 1px solid rgba(255,255,255,0.1); }
  .hero-full__stat { background: rgba(10,25,22,0.85); backdrop-filter: blur(8px); padding: 24px 16px; text-align: center; }
  .hero-full__stat-val { font-family: var(--font-heading); font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 800; color: #4ECDC4; letter-spacing: -0.03em; line-height: 1; }
  .hero-full__stat-lbl { font-size: 0.75rem; color: rgba(255,255,255,0.6); margin-top: 6px; }
  @media (max-width: 768px) { .hero-full { min-height: 75vh; } .hero-full__content { padding: 0 24px 32px; } .hero-full__stats { grid-template-columns: repeat(2, 1fr); } .hero-full__ctas { flex-direction: column; } }

  .trust-bar { border-bottom: 1px solid var(--border); background: var(--bg-el); }
  .trust-bar__inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: center; gap: 32px; padding: 18px 48px; flex-wrap: wrap; }
  .trust-bar__item { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; font-weight: 500; color: var(--muted); white-space: nowrap; }
