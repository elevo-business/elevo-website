<script>
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href');
      if (!href) return;
      const target = document.querySelector(href);
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    });
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('.anim-on-scroll').forEach(el => observer.observe(el));

  const countObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const raw = el.dataset.count || el.textContent || '';
        const match = raw.match(/(\d[\d.]*)/);
        if (match) {
          const numStr = match[1].replace('.', '');
          const target = parseInt(numStr);
          const suffix = raw.replace(/[\d.]+/, '');
          let current = 0;
          const step = Math.max(1, Math.floor(target / 40));
          const timer = setInterval(() => {
            current += step;
            if (current >= target) { current = target; clearInterval(timer); }
            el.textContent = (target > 999 ? (current).toLocaleString('de-DE') : current) + suffix;
          }, 30);
        }
        countObserver.unobserve(el);
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.hero-full__stat-val').forEach(el => countObserver.observe(el));

  const tabs = document.querySelectorAll('.services-tabs__tab');
  const panels = document.querySelectorAll('.services-tabs__panel');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const idx = (tab as HTMLElement).dataset.tab;
      tabs.forEach(t => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
      panels.forEach(p => p.classList.remove('is-active'));
      tab.classList.add('is-active'); tab.setAttribute('aria-selected', 'true');
      const panel = document.querySelector(`[data-panel="${idx}"]`);
      if (panel) panel.classList.add('is-active');
    });
  });

  const typeButtons = document.querySelectorAll('.estimator__option');
  const slider = document.getElementById('unit-slider') as HTMLInputElement;
  const unitVal = document.getElementById('unit-val');
  const unitLabel = document.getElementById('unit-label');
  const estimateVal = document.getElementById('estimate-val');
  const rates: Record<string, [number, number]> = { implantate: [1500, 3000], bleaching: [300, 600], veneers: [400, 900] };
  const isFlatRate: Record<string, boolean> = { bleaching: true };
  let selectedType = 'implantate';
  function updateEstimate() {
    if (!slider || !unitVal || !estimateVal) return;
    const units = parseInt(slider.value);
    const isFlat = isFlatRate[selectedType];
    if (isFlat) {
      unitVal.textContent = units <= 1 ? '1 Kiefer' : '2 Kiefer';
      if (unitLabel) unitLabel.textContent = 'Anzahl Kiefer';
    } else {
      unitVal.textContent = units + (units === 1 ? ' Zahn' : ' Zähne');
      if (unitLabel) unitLabel.textContent = 'Anzahl Zähne';
    }
    const [lo, hi] = rates[selectedType] || [1500, 3000];
    const count = isFlat ? Math.min(units, 2) : units;
    const min = lo * count;
    const max = hi * count;
    estimateVal.textContent = `ca. ${min.toLocaleString('de-DE')} — ${max.toLocaleString('de-DE')} €`;
  }
  typeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      typeButtons.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      selectedType = (btn as HTMLElement).dataset.value || 'implantate';
      if (slider) {
        slider.max = isFlatRate[selectedType] ? '2' : '8';
        slider.value = isFlatRate[selectedType] ? '1' : '2';
      }
      updateEstimate();
    });
  });
  if (slider) { slider.addEventListener('input', updateEstimate); updateEstimate(); }
</script>
