---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztFamilieProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Bergmann',
  tagline: 'Familienzahnarzt Hamburg-Altona',
  location: 'Hamburg-Altona',
  email: 'info@praxis-bergmann-hh.de',
  phone: '+49 40 3892740',
  heroTitle: 'Familienzahnarzt in Hamburg-Altona — für alle Generationen.',
  heroSubtitle: 'Zahnarztpraxis Bergmann ist Ihr Familienzahnarzt für alle Generationen — von den ersten Milchzähnen bis zum gepflegten Seniorengebiss. Einfühlsam, geduldig und herzlich.',
  services: [
    { icon: 'check', title: 'Prophylaxe & Vorsorge', description: 'Regelmäßige professionelle Zahnreinigung und individuelle Vorsorgeberatung für die ganze Familie — damit Ihre Zähne ein Leben lang gesund bleiben.' },
    { icon: 'heart', title: 'Kinderzahnheilkunde', description: 'Spielerische und angstfreie Behandlung für unsere kleinen Patienten — wir legen das Fundament für lebenslange Zahngesundheit.' },
    { icon: 'tooth', title: 'Füllungstherapie', description: 'Hochwertige Komposit- und Keramikfüllungen in Zahnfarbe — schonend, langlebig und ästhetisch für ein natürliches Ergebnis.' },
    { icon: 'grid', title: 'Zahnersatz', description: 'Individuelle Zahnersatzlösungen von Kronen und Brücken bis hin zu herausnehmbarem Zahnersatz — für jeden Bedarf und jedes Budget.' },
    { icon: 'star', title: 'Bleaching', description: 'Professionelles Zahnaufhellen für ein strahlendes Lächeln — sicher, wirksam und mit maßgeschneiderten Schienen für zu Hause oder in der Praxis.' },
    { icon: 'shield', title: 'Angstpatienten-Behandlung', description: 'Einfühlsame Betreuung für Menschen mit Zahnarztangst — wir nehmen uns Zeit, schaffen Vertrauen und sorgen für eine entspannte Behandlung.' },
  ],
  stats: [
    { value: '20+', label: 'Jahre Erfahrung' },
    { value: '6.000+', label: 'Patienten betreut' },
    { value: '3', label: 'Zahnärzte im Team' },
  ],
};
---

<PreviewLayout profile={zahnarztFamilieProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    ctaText="Termin buchen"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Familienzahnarzt Hamburg-Altona"
    ctaPrimary={{ text: 'Termin buchen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Leistungen entdecken', href: '#leistungen' }}
    imageSrc="/preview-images/praxis-bergmann/hero.jpg"
    imageAlt="Zahnarztpraxis Bergmann Hamburg-Altona — Familienzahnarzt"
    stats={prospect.stats}
  />

  <ZahnarztServices
    title="Unsere Leistungen für Ihre Familie"
    subtitle="Von der Prophylaxe bis zum Zahnersatz — alles unter einem Dach in Hamburg-Altona."
    services={prospect.services}
  />

  <ZahnarztTimeline
    title="Ihr Familienbesuch bei uns"
    subtitle="So einfach und angenehm kann ein Zahnarztbesuch sein."
    steps={[
      { num: 1, title: 'Erstbesuch', desc: 'Herzliches Willkommen — wir lernen Sie und Ihre Familie kennen und nehmen uns Zeit für eine umfassende Erstuntersuchung.', icon: 'chat' },
      { num: 2, title: 'Diagnose', desc: 'Sorgfältige Befunderhebung mit digitaler Röntgendiagnostik — wir erkennen Probleme frühzeitig und transparent.', icon: 'search' },
      { num: 3, title: 'Behandlungsplan', desc: 'Klarer, verständlicher Behandlungsplan mit Kostentransparenz — gemeinsam entscheiden wir, was am besten passt.', icon: 'calendar' },
      { num: 4, title: 'Behandlung', desc: 'Schonende, einfühlsame Behandlung in einer familiären Atmosphäre — präzise und in Ihrem Tempo.', icon: 'tooth' },
    ]}
  />

  <ZahnarztBeforeAfter
    title="Behandlungsergebnisse"
    subtitle="Schöne, gesunde Zähne in jedem Alter."
    cases={[
      { beforeSrc: '/preview-images/praxis-bergmann/gallery-1.jpg', afterSrc: '/preview-images/praxis-bergmann/gallery-2.jpg', label: 'Füllungstherapie' },
      { beforeSrc: '/preview-images/praxis-bergmann/gallery-3.jpg', afterSrc: '/preview-images/praxis-bergmann/gallery-4.jpg', label: 'Kronen & Zahnersatz' },
    ]}
  />

  <ZahnarztCostCalc />

  <PreviewTestimonials
    title="Familien über uns"
    testimonials={[
      { text: 'Unsere ganze Familie ist seit Jahren in Praxis Bergmann. Professionell, herzlich und immer mit Geduld — auch bei den Kindern.', author: 'Familie Müller', role: 'Stammkunden' },
      { text: 'Meine Kinder gehen gerne zum Zahnarzt — das hätte ich nie gedacht! Das Team nimmt sich wirklich Zeit für die Kleinen.', author: 'Carolin B.', role: 'Mutter von 2 Kindern' },
      { text: 'Seit 15 Jahren meine Praxis des Vertrauens. Immer kompetent, freundlich und transparent.', author: 'Gerhard W.', role: 'Patient seit 15 Jahren' },
    ]}
  />

  <PreviewCTA
    title="Ihre Familienzahnarztpraxis in Hamburg-Altona"
    subtitle="Vereinbaren Sie jetzt einen Termin — für Sie und Ihre ganze Familie."
    ctaText="Familientermin vereinbaren"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>
