---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { handwerkProfile } from '../../templates/config/handwerk';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewHero from '../../templates/sections/PreviewHero.astro';
import PreviewServices from '../../templates/sections/PreviewServices.astro';
import PreviewStats from '../../templates/sections/PreviewStats.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Willi Wenzel Malerbetrieb',
  tagline: 'Maler und Lackierer Frankfurt',
  location: 'Frankfurt am Main',
  email: 'info@wenzel-maler.de',
  heroTitle: 'Farbe gibt Räumen Leben. Wir machen es perfekt.',
  heroSubtitle: 'Willi Wenzel Malerbetrieb steht für präzise Handwerkskunst und hochwertige Oberflächen. Innen wie außen — mit dem Qualitätsanspruch eines Meisterbetriebs.',
  services: [
    { icon: 'grid', title: 'Innenanstrich', description: 'Wände, Decken und Treppenhäuser in makellosem Zustand. Wir beraten zur Farbwahl und verarbeiten nur hochwertige Materialien.' },
    { icon: 'layers', title: 'Fassadenarbeiten', description: 'Schutzanstriche, Fassadensanierung und Wärmedämmverbundsysteme — für eine Außenhülle, die Bestand hat und gut aussieht.' },
    { icon: 'sun', title: 'Tapezieren', description: 'Vliestapeten, Strukturtapeten, dekorative Oberflächen — sauber gestellt und blasenfrei verarbeitet.' },
    { icon: 'tree', title: 'Lackierarbeiten', description: 'Türen, Fensterrahmen, Heizkörper und Geländer in erstklassigem Lackfinish — dauerhaft, kratzfest und sauber ausgeführt.' },
    { icon: 'shield', title: 'Schimmelbeseitigung', description: 'Professionelle Sanierung bei Schimmelbefall — fachgerecht, gründlich und mit dauerhafter Versiegelung.' },
    { icon: 'activity', title: 'Gewerbeobjekte', description: 'Büros, Praxen, Verkaufsflächen — wir arbeiten termintreu und mit minimalem Aufwand für Ihre laufenden Abläufe.' },
  ],
  stats: [
    { value: '15+', label: 'Jahre Erfahrung' },
    { value: '600+', label: 'Objekte' },
    { value: 'Top', label: 'Bewertungen' },
  ],
};
---

<PreviewLayout profile={handwerkProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} ctaText="Angebot anfragen" ctaHref="#kontakt" />
  <PreviewHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Frankfurt · Malerbetrieb · Meisterbetrieb"
    ctaButtons={[
      { text: 'Kostenloses Angebot', href: '#kontakt', variant: 'primary' },
      { text: 'Unsere Leistungen', href: '#leistungen', variant: 'outline' },
    ]}
    stats={prospect.stats}
  />
  <PreviewServices title="Unsere Leistungen" subtitle="Von der Altbausanierung bis zum Neubau — Willi Wenzel liefert saubere Ergebnisse, die überzeugen. Pünktlich, ordentlich und zum fairen Preis." services={prospect.services} />
  <PreviewCTA title="Ihr Projekt in erfahrenen Händen?" subtitle="Kontaktieren Sie uns für eine kostenlose Besichtigung und ein unverbindliches Festpreisangebot. Wir melden uns innerhalb von 24 Stunden." badge="Jetzt anfragen" buttonText="Jetzt anrufen" buttonLink="tel:+49" />
  <PreviewFooter
    prospectName={prospect.name}
    tagline="Ihr Meisterbetrieb für Maler- und Lackierarbeiten in Frankfurt am Main. Sauber, pünktlich und mit höchstem Qualitätsanspruch."
    email={prospect.email}
    year={2025}
    links={[
      { heading: 'Leistungen', links: [{ label: 'Innenanstrich', href: '#leistungen' }, { label: 'Fassadenarbeiten', href: '#leistungen' }, { label: 'Tapezieren', href: '#leistungen' }, { label: 'Lackierarbeiten', href: '#leistungen' }] },
      { heading: 'Kontakt', links: [{ label: 'Frankfurt am Main', href: '#' }, { label: 'info@wenzel-maler.de', href: 'mailto:info@wenzel-maler.de' }, { label: 'Impressum', href: '#' }, { label: 'Datenschutz', href: '#' }] },
    ]}
  />
</PreviewLayout>
