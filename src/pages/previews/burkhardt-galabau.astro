---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { galabauProfile } from '../../templates/config/galabau';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewHero from '../../templates/sections/PreviewHero.astro';
import PreviewServices from '../../templates/sections/PreviewServices.astro';
import PreviewStats from '../../templates/sections/PreviewStats.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewGallery from '../../templates/sections/PreviewGallery.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Burkhardt GaLaBau GmbH',
  tagline: 'Garten- und Landschaftsbau Eschborn',
  location: 'Eschborn, Rhein-Main',
  email: 'info@galabau-burkhardt.de',
  heroTitle: 'Eschborns Gartenprofis. Burkhardt GaLaBau.',
  heroSubtitle: 'Die Burkhardt GaLaBau GmbH steht seit über 20 Jahren für professionellen Garten- und Landschaftsbau im Rhein-Main-Gebiet — für Gewerbe und Privat.',
  services: [
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>', title: 'Gewerbegelände', description: 'Professionelle Gestaltung und Pflege von Firmenaußenflächen, Parkplätzen und gewerblichen Grünanlagen.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>', title: 'Privatgärten', description: 'Gartenplanung und Neugestaltung für Privatkunden — individuell, naturnah und dauerhaft schön.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>', title: 'Pflasterbau', description: 'Einfahrten, Terrassen, Wege und Plätze in Naturstein und Betonpflaster — sauber ausgeführt und langlebig.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>', title: 'Grünanlagenpflege', description: 'Laufende Pflege von Grünanlagen für Gewerbe und Wohnanlagen — zuverlässig im Jahresvertrag.' },
  ],
  stats: [
    { value: '20+', label: 'Jahre Erfahrung' },
    { value: 'Rhein', label: 'Main Region' },
    { value: 'B2B', label: 'Gewerbekunden' },
  ],
};
---

<PreviewLayout profile={galabauProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} logo="/client-logos/burkhardt.svg" ctaText="Beratung anfragen" ctaHref="#kontakt" />
  <PreviewHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Eschborn · GaLaBau · Gewerbe & Privat"
    ctaButtons={[
      { text: 'Kostenloses Angebot', href: '#kontakt', variant: 'primary' },
      { text: 'Unsere Leistungen', href: '#leistungen', variant: 'outline' },
    ]}
    heroImage="https://images.unsplash.com/photo-1585320806297-9c5f04be5bca?auto=format&fit=crop&w=1400&q=80"
    heroImageAlt="Professionell gepflegte Grünanlage eines Gewerbebetriebs"
    stats={prospect.stats}
  />
  <PreviewServices title="Unsere Leistungen" subtitle="Von der gewerblichen Außenanlage bis zum Privatgarten — Burkhardt GaLaBau liefert professionelle Ergebnisse für jeden Bedarf." services={prospect.services} />
  <PreviewGallery
    title="Referenzprojekte"
    subtitle="Gewerbegelände, Privatgärten und Pflasterbau — realisiert im Rhein-Main-Gebiet."
    images={[
      { src: 'https://images.unsplash.com/photo-1566800180008-d0f6b07d9f04?auto=format&fit=crop&w=800&q=80', alt: 'Gepflegtes Firmengelände in Eschborn' },
      { src: 'https://images.unsplash.com/photo-1598128558393-70ff21433be0?auto=format&fit=crop&w=800&q=80', alt: 'Pflasterarbeiten Einfahrt Privathaus' },
      { src: 'https://images.unsplash.com/photo-1585637071003-89cd44d3efb5?auto=format&fit=crop&w=800&q=80', alt: 'Privatgarten Neugestaltung Rhein-Main' },
      { src: 'https://images.unsplash.com/photo-1563514227147-6d2ff665a6a0?auto=format&fit=crop&w=800&q=80', alt: 'Grünanlage mit regelmäßiger Pflege' },
    ]}
  />
  <PreviewCTA title="Ihr Partner im Rhein-Main-Gebiet" subtitle="Ob Gewerbe oder Privat — sprechen Sie uns an. Wir erstellen Ihnen ein unverbindliches Angebot für Ihre Außenflächen." badge="Jetzt anfragen" buttonText="Jetzt anfragen" buttonLink={`mailto:${prospect.email}`} />
  <PreviewFooter
    prospectName={prospect.name}
    tagline="Professioneller Garten- und Landschaftsbau in Eschborn und dem Rhein-Main-Gebiet. Seit über 20 Jahren für Gewerbe und Privatkunden."
    email={prospect.email}
    year={2025}
    links={[
      { heading: 'Leistungen', links: [{ label: 'Gewerbegelände', href: '#leistungen' }, { label: 'Privatgärten', href: '#leistungen' }, { label: 'Pflasterbau', href: '#leistungen' }, { label: 'Grünanlagenpflege', href: '#leistungen' }] },
      { heading: 'Kontakt', links: [{ label: 'Eschborn, Rhein-Main', href: '#' }, { label: 'info@galabau-burkhardt.de', href: 'mailto:info@galabau-burkhardt.de' }, { label: 'Impressum', href: '#' }, { label: 'Datenschutz', href: '#' }] },
    ]}
  />
</PreviewLayout>
