---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { galabauProfile } from '../../templates/config/galabau';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewHero from '../../templates/sections/PreviewHero.astro';
import PreviewServices from '../../templates/sections/PreviewServices.astro';
import PreviewStats from '../../templates/sections/PreviewStats.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewGallery from '../../templates/sections/PreviewGallery.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Roßkopf GaLaBau',
  tagline: 'Garten- und Landschaftsbau Frankfurt',
  location: 'Frankfurt am Main',
  email: 'info@rosskopf.net',
  heroTitle: 'Ihr Garten. Unsere Leidenschaft.',
  heroSubtitle: 'Roßkopf GaLaBau verwandelt Außenflächen in lebendige Räume. Von der Planung bis zur Pflege — professioneller Garten- und Landschaftsbau im Rhein-Main-Gebiet.',
  services: [
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>', title: 'Gartenplanung & Neuanlage', description: 'Individuelle Gartenplanung nach Ihren Wünschen — von der ersten Skizze bis zur schlüsselfertigen Umsetzung.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>', title: 'Pflasterbau & Wege', description: 'Professionelle Gestaltung von Einfahrten, Terrassen und Wegen mit hochwertigen Natursteinen und Pflastermaterialien.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>', title: 'Gartenpflege & Wartung', description: 'Regelmäßige Pflege und Wartung Ihrer Grünanlagen — zuverlässig, saisonal und nach Vereinbarung.' },
  ],
  stats: [
    { value: '25+', label: 'Jahre Erfahrung' },
    { value: '500+', label: 'Projekte' },
    { value: '100%', label: 'Zufriedenheit' },
  ],
};
---

<PreviewLayout profile={galabauProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} logo="/client-logos/rosskopf.svg" ctaText="Beratung anfragen" ctaHref="#kontakt" />
  <PreviewHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Frankfurt · GaLaBau · Seit 1998"
    ctaButtons={[
      { text: 'Kostenloses Angebot', href: '#kontakt', variant: 'primary' },
      { text: 'Unsere Projekte', href: '#projekte', variant: 'outline' },
    ]}
    heroImage="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1400&q=80"
    heroImageAlt="Professionell gestalteter Garten mit Naturstein-Terrasse"
    stats={prospect.stats}
  />
  <PreviewServices title="Unsere Leistungen" subtitle="Von der Neuanlage bis zur laufenden Pflege — wir betreuen Ihren Außenbereich ganzjährig mit Expertise und Zuverlässigkeit." services={prospect.services} />
  <PreviewGallery
    title="Unsere Projekte"
    subtitle="Einblicke in realisierte Garten- und Landschaftsbauprojekte im Rhein-Main-Gebiet."
    images={[
      { src: 'https://images.unsplash.com/photo-1519315901367-f34ff9154487?auto=format&fit=crop&w=800&q=80', alt: 'Gepflegter Privatgarten mit Rasenfläche' },
      { src: 'https://images.unsplash.com/photo-1598300042247-d088f8ab3a91?auto=format&fit=crop&w=800&q=80', alt: 'Rasenanlage mit professionellem Schnitt' },
      { src: 'https://images.unsplash.com/photo-1503455637927-0f0f19c63a30?auto=format&fit=crop&w=800&q=80', alt: 'Natursteinterrasse mit Bepflanzung' },
      { src: 'https://images.unsplash.com/photo-1586348943529-beaae6c28db9?auto=format&fit=crop&w=800&q=80', alt: 'Gartengestaltung mit Natursteinwegen' },
    ]}
  />
  <PreviewCTA title="Bereit für Ihren Traumgarten?" subtitle="Kontaktieren Sie uns für ein unverbindliches Beratungsgespräch. Wir kommen zu Ihnen und besichtigen Ihre Fläche kostenlos." badge="Jetzt anfragen" buttonText="Jetzt anrufen" buttonLink="tel:+49" />
  <PreviewFooter
    prospectName={prospect.name}
    tagline="Professioneller Garten- und Landschaftsbau im Rhein-Main-Gebiet. Seit 1998 für Privat- und Gewerbekunden."
    email={prospect.email}
    year={2025}
    links={[
      { heading: 'Leistungen', links: [{ label: 'Gartenplanung', href: '#leistungen' }, { label: 'Pflasterbau', href: '#leistungen' }, { label: 'Begrünung', href: '#leistungen' }, { label: 'Gartenpflege', href: '#leistungen' }] },
      { heading: 'Kontakt', links: [{ label: 'Frankfurt am Main', href: '#' }, { label: 'info@rosskopf.net', href: 'mailto:info@rosskopf.net' }, { label: 'Impressum', href: '#' }, { label: 'Datenschutz', href: '#' }] },
    ]}
  />
</PreviewLayout>
