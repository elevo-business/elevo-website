---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztProfile } from '../../templates/config/zahnarzt';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewTreatmentSpectrum from '../../templates/sections/PreviewTreatmentSpectrum.astro';
import PreviewBeforeAfter from '../../templates/sections/PreviewBeforeAfter.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewSmileCheck from '../../templates/sections/PreviewSmileCheck.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Dr. med. dent. Klein',
  tagline: 'Premium Implantologie & Ästhetische Zahnmedizin München',
  location: 'München-Schwabing',
  email: 'praxis@dr-klein-zahnarzt.de',
  phone: '+49 89 4521090',
  heroTitle: 'Ihr Lächeln. <em>Unser Meisterwerk.</em>',
  heroSubtitle: 'Dr. Klein und sein Spezialistenteam in München-Schwabing verbinden modernste Implantologie mit ästhetischer Perfektion. Premium-Materialien, digitale Präzision, 10 Jahre Garantie — für ein Lächeln, das ein Leben lang hält.',
  services: [],
  stats: [
    { value: '15+', label: 'Jahre Implantologie' },
    { value: '3.000+', label: 'Implantate gesetzt' },
    { value: '24h', label: 'Kostenvoranschlag' },
    { value: '5★', label: 'Google Bewertung' },
  ],
};

const treatments = [
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 2c-1.5 0-2.5 1-3 2.5L4.5 11C4 14 5.5 16 7 16c.6 0 1.1-.2 1.5-.5L12 14l3.5 1.5c.4.3.9.5 1.5.5 1.5 0 3-2 2.5-5L18 4.5C17.5 3 16.5 2 15 2c-1 0-2 .6-3 .6S10 2 9 2z"/><line x1="12" y1="14" x2="12" y2="21"/><path d="M10 18h4"/></svg>`,
    title: 'Premium Implantologie',
    description: 'Schweizer Titan-Implantate mit 3D-Volumentomographie und computergestützter OP-Schablone. Minimale Invasivität, maximale Sicherheit — 10 Jahre Garantie.',
    ctaText: 'Kostenlose Erstberatung',
    ctaHref: '#kontakt',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>`,
    title: 'Porzellan-Veneers',
    description: 'Hauchdünne Keramik-Veneers für ein strahlendes Hollywood-Lächeln. Computergeplantes Digital-Smile-Design — Sie sehen das Ergebnis, bevor die erste Feile angesetzt wird.',
    ctaText: 'Smile-Design ansehen',
    ctaHref: '#smile-check',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 9l3.5 11h11L21 9"/><path d="M3 9l4 4 5-7 5 7 4-4"/></svg>`,
    title: 'Vollkeramik-Restaurationen',
    description: 'CAD/CAM-gefertigte Keramikkronen und Brücken am selben Tag eingesetzt. Metallfreiheit, Biokompatibilität, natürliches Ergebnis.',
    ctaText: 'Kostenvoranschlag in 24h',
    ctaHref: '#kontakt',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
    title: 'Parodontologie Premium',
    description: 'Laserunterstützte Parodontitis-Behandlung für ein stabiles Fundament. Gesundes Zahnfleisch ist die Voraussetzung für dauerhaft schöne Implantate.',
    ctaText: 'Termin anfragen',
    ctaHref: '#kontakt',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="8" width="20" height="8" rx="2"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="7" y1="8" x2="7" y2="16"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="17" y1="8" x2="17" y2="16"/></svg>`,
    title: 'Invisalign-Aligner',
    description: 'Unsichtbare Zahnkorrektur für Erwachsene — vollständig digital geplant, ohne Metalldraht. Diskret und herausnehmbar — ideal für anspruchsvolle Berufstätige.',
    ctaText: 'Beratung buchen',
    ctaHref: '#kontakt',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
    title: 'Bleaching & Prophylaxe',
    description: 'Power-Bleaching für bis zu 8 Weißgrad-Stufen plus Premium-Prophylaxe mit Air-Flow. Der Rundum-Service für ein strahlend weißes, gesundes Lächeln.',
    ctaText: 'PZR buchen',
    ctaHref: '#kontakt',
  },
];

const beforeAfterItems = [
  {
    beforeSrc: 'https://images.unsplash.com/photo-1606811842121-9a5c5c7c2ea8?w=600&q=80&fit=crop',
    afterSrc: 'https://images.unsplash.com/photo-1544717297-fa95b6ee9643?w=600&q=80&fit=crop',
    beforeAlt: 'Vor der Veneer-Behandlung — verfärbte Zähne',
    afterAlt: 'Nach der Veneer-Behandlung — strahlendes weißes Lächeln',
    treatment: 'Porzellan-Veneers (6 Stück)',
    description: 'Hauchdünne Keramik-Veneers — in nur 2 Sitzungen zu einem strahlenden Lächeln.',
  },
  {
    beforeSrc: 'https://images.unsplash.com/photo-1563642421748-5047b6585a4a?w=600&q=80&fit=crop',
    afterSrc: 'https://images.unsplash.com/photo-1606811971618-4486d14f3f99?w=600&q=80&fit=crop',
    beforeAlt: 'Vor der Implantologie-Behandlung — fehlender Zahn',
    afterAlt: 'Nach dem Implantat — natürlich aussehender Zahnersatz',
    treatment: 'Premium Einzelimplantat',
    description: 'Von der 3D-Planung bis zum fertigen Ergebnis — dauerhaft funktionierend, täuschend echt.',
  },
];

const ratgeberCards = [
  { thema: 'Implantologie', icon: '🦷', title: 'Wie lange halten Implantate?', desc: 'Premium-Titan-Implantate halten bei guter Pflege ein Leben lang. Die Kronenversorgung wird nach 10–15 Jahren erneuert — die Investition rechnet sich langfristig immer.' },
  { thema: 'Veneers', icon: '✨', title: 'Veneers oder Bleaching?', desc: 'Veneers verändern Form und Farbe dauerhaft — ideal bei Formkorrekturen oder starken Verfärbungen. Bleaching hellt auf — perfekt für gesunde Zähne ohne Korrekturbedarf.' },
  { thema: 'Kosten', icon: '💰', title: 'Was übernimmt die Krankenkasse?', desc: 'Gesetzliche Kassen übernehmen Grundleistungen. Premium-Implantate und Veneers sind Privatleistungen. Wir erstellen Ihnen transparent einen Kostenvoranschlag — in 24 Stunden.' },
  { thema: 'Digital Smile', icon: '🔬', title: 'Ihr Lächeln — digital simuliert', desc: 'Vor jeder ästhetischen Behandlung simulieren wir das Ergebnis am Computer — Sie sehen, wie Ihr neues Lächeln aussieht, bevor der erste Eingriff stattfindet.' },
];
---

<PreviewLayout profile={zahnarztProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} ctaText="Kostenlose Erstberatung" ctaHref="#kontakt" />

  <header class="hero-split" id="hero">
    <div class="hero-split__content anim-fade-up">
      <div class="hero-split__badge">
        <span class="hero-split__badge-dot"></span>
        München-Schwabing · Premium Implantologie · Ästhetik
      </div>
      <h1 class="hero-split__title">Ihr Lächeln.<br /><em>Unser Meisterwerk.</em></h1>
      <p class="hero-split__sub">{prospect.heroSubtitle}</p>
      <div class="hero-split__ctas">
        <a href="#kontakt" class="hero-split__btn-primary">Kostenlose Erstberatung</a>
        <a href="#kontakt" class="hero-split__btn-secondary">Kostenvoranschlag in 24h</a>
      </div>
      <ul class="hero-split__trust" aria-label="Unsere Versprechen">
        <li class="hero-split__trust-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Schweizer Premium-Implantate · 10 Jahre Garantie
        </li>
        <li class="hero-split__trust-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Digital Smile Design vor dem ersten Eingriff
        </li>
        <li class="hero-split__trust-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Kostenvoranschlag in 24 Stunden — verbindlich
        </li>
      </ul>
    </div>
    <div class="hero-split__visual">
      <div class="hero-split__img-frame">
        <img
          src="https://images.unsplash.com/photo-1609840113966-f90f8c9d2e77?w=900&q=85&fit=crop&crop=faces"
          alt="Dr. Klein Zahnarztpraxis München — Premium Implantologie und ästhetische Zahnmedizin"
          width="900"
          height="700"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-split__award">
          <div class="hero-split__award-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <div>
            <div class="hero-split__award-val">5.0 / 5</div>
            <div class="hero-split__award-lbl">203 Google-Bewertungen</div>
          </div>
        </div>
      </div>
      <div class="hero-split__stats" role="list">
        {prospect.stats?.map(s => (
          <div class="hero-split__stat" role="listitem">
            <div class="hero-split__stat-val">{s.value}</div>
            <div class="hero-split__stat-lbl">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </header>

  <PreviewTreatmentSpectrum
    title="Unser Behandlungsspektrum"
    subtitle="Von Premium-Implantaten über Porzellan-Veneers bis zur unsichtbaren Kieferorthopädie — das vollständige Spektrum moderner Ästhetik auf höchstem Niveau."
    treatments={treatments}
  />

  <PreviewBeforeAfter
    title="Vorher — Nachher"
    subtitle="Erleben Sie die Transformation. Schieben Sie den Regler und sehen Sie, was mit moderner Ästhetik möglich ist."
    items={beforeAfterItems}
  />

  <PreviewTestimonials
    title="Was unsere Patienten sagen"
    subtitle="Patienten aus ganz München vertrauen Dr. Klein ihr Lächeln an."
    testimonials={[
      { text: 'Ich hatte jahrelang Hemmungen wegen meiner Zähne. Dr. Klein hat mir in zwei Terminen ein vollständig neues Lächeln gegeben. Die Ergebnisse sind atemberaubend — ich erkenne mein eigenes Spiegelbild kaum wieder.', author: 'Sophie W.', role: 'Unternehmerin, München-Schwabing', rating: 5 },
      { text: 'Das Digital-Smile-Design hat mich überzeugt — ich sah, wie meine Veneers aussehen würden, bevor die erste Feile angesetzt wurde. Das Ergebnis entspricht exakt der Simulation. Einfach traumhaft.', author: 'Michael R.', role: 'Architekt, München', rating: 5 },
      { text: 'Das Implantat sitzt seit 4 Jahren wie ein natürlicher Zahn. Behandlung war schmerzfrei, Kommunikation transparent. Beste Investition in meine Gesundheit, die ich je getätigt habe.', author: 'Claudia M.', role: 'Patientin seit 2021', rating: 5 },
    ]}
  />

  <PreviewSmileCheck
    title="Wie gut ist Ihr Lächeln?"
    subtitle="Unser Smile-Check gibt Ihnen in 3 Minuten eine erste Einschätzung — kostenlos und unverbindlich."
    steps={[
      {
        question: 'Was stört Sie an Ihrem Lächeln am meisten?',
        options: [
          { label: 'Farbe — zu gelblich oder verfärbt', value: 'bleaching' },
          { label: 'Ein oder mehrere Zähne fehlen', value: 'implantate' },
          { label: 'Form und Ästhetik stimmen nicht', value: 'veneers' },
          { label: 'Schiefe oder unregelmäßige Zähne', value: 'aligner' },
        ],
      },
      {
        question: 'Wie wichtig ist Ihnen ein perfektes Lächeln?',
        options: [
          { label: 'Sehr wichtig — ich möchte strahlen', value: 'high' },
          { label: 'Wichtig — natürlich besser aussehen', value: 'medium' },
          { label: 'Gesundheit hat Vorrang vor Ästhetik', value: 'functional' },
        ],
      },
      {
        question: 'Haben Sie einen Kostenrahmen im Kopf?',
        options: [
          { label: 'Bis 500 € (Bleaching / PZR)', value: 'small' },
          { label: '500 — 3.000 € (Einzelrestaurationen)', value: 'medium' },
          { label: 'Über 3.000 € (umfassende Ästhetik)', value: 'large' },
          { label: 'Noch keine Vorstellung — bitte beraten', value: 'open' },
        ],
      },
    ]}
    resultCtaText="Kostenlose Erstberatung buchen"
    resultCtaHref="#kontakt"
  />

  <section class="ratgeber" id="ratgeber">
    <div class="ratgeber__inner">
      <div class="ratgeber__header">
        <div class="ratgeber__badge">Wissenswertes</div>
        <h2 class="ratgeber__title">Ihr Weg zum <em>perfekten Lächeln</em></h2>
        <p class="ratgeber__sub">Alles Wissenswerte rund um Implantologie, Ästhetik und Kosten — von unserem Expertenteam für Sie aufbereitet.</p>
      </div>
      <div class="ratgeber__grid">
        {ratgeberCards.map(card => (
          <div class="ratgeber__card anim-on-scroll">
            <div class="ratgeber__icon" aria-hidden="true">{card.icon}</div>
            <div class="ratgeber__thema">{card.thema}</div>
            <h3 class="ratgeber__card-title">{card.title}</h3>
            <p class="ratgeber__card-desc">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <PreviewCTA
    title="Ihr Lächeln verdient das Beste."
    subtitle="Vereinbaren Sie jetzt Ihre kostenlose Erstberatung bei Dr. Klein in München-Schwabing. Kostenvoranschlag in 24 Stunden — transparent und verbindlich."
    badge="Kostenlose Erstberatung"
    buttonText="Smile-Check starten"
    buttonLink="#smile-check"
    phone="+49 89 4521090"
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    address="Leopoldstraße 44, 80802 München-Schwabing"
    year={2025}
  />
</PreviewLayout>

<style is:global>
  :root {
    --accent: #2563EB;
    --accent-hover: #1D4ED8;
  }
</style>

<style>
  html { scroll-behavior: smooth; }
  .anim-fade-up { animation: fadeUp 0.8s ease-out both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  .anim-on-scroll { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .anim-on-scroll.is-visible { opacity: 1; transform: translateY(0); }

  .hero-split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; max-width: 1280px; margin: 0 auto; padding: 80px 48px 72px; align-items: center; min-height: 88vh; }
  .hero-split__badge { display: inline-flex; align-items: center; gap: 8px; background: color-mix(in srgb, var(--accent) 10%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: var(--accent); margin-bottom: 24px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }
  .hero-split__badge-dot { width: 7px; height: 7px; background: var(--accent); border-radius: 50%; animation: pulseDot 2s ease-in-out infinite; flex-shrink: 0; }
  @keyframes pulseDot { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.7); } }
  .hero-split__title { font-family: var(--font-heading); font-size: clamp(2.6rem, 4.5vw, 3.8rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; color: var(--text); margin-bottom: 20px; }
  .hero-split__title em { color: var(--accent); font-style: normal; }
  .hero-split__sub { color: var(--muted); font-size: 1.05rem; line-height: 1.75; max-width: 520px; margin-bottom: 32px; }
  .hero-split__ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 28px; }
  .hero-split__btn-primary { background: var(--accent); color: #fff; padding: 14px 28px; border-radius: 12px; font-size: 0.95rem; font-weight: 600; font-family: var(--font-body); transition: background 0.2s, transform 0.2s, box-shadow 0.2s; text-decoration: none; display: inline-block; }
  .hero-split__btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 30%, transparent); }
  .hero-split__btn-secondary { border: 1.5px solid color-mix(in srgb, var(--accent) 40%, transparent); color: var(--accent); padding: 14px 28px; border-radius: 12px; font-size: 0.95rem; font-weight: 600; font-family: var(--font-body); transition: border-color 0.2s, background 0.2s; text-decoration: none; background: color-mix(in srgb, var(--accent) 5%, transparent); display: inline-block; }
  .hero-split__btn-secondary:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .hero-split__trust { display: flex; flex-direction: column; gap: 7px; list-style: none; padding: 0; margin: 0; }
  .hero-split__trust-item { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--muted); }
  .hero-split__trust-item svg { color: var(--accent); flex-shrink: 0; }
  .hero-split__visual { display: flex; flex-direction: column; gap: 16px; }
  .hero-split__img-frame { position: relative; border-radius: 20px; overflow: hidden; border: 1px solid var(--border); box-shadow: 0 20px 60px color-mix(in srgb, var(--accent) 12%, rgba(0,0,0,0.08)); }
  .hero-split__img-frame img { width: 100%; height: 460px; object-fit: cover; object-position: center 20%; display: block; }
  .hero-split__award { position: absolute; bottom: 20px; left: 20px; display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.96); border-radius: 12px; padding: 10px 14px; box-shadow: 0 4px 16px rgba(0,0,0,0.1); }
  .hero-split__award-icon { width: 34px; height: 34px; background: #FEF3C7; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #D97706; flex-shrink: 0; }
  .hero-split__award-val { font-family: var(--font-heading); font-size: 0.95rem; font-weight: 800; color: #1A2E2A; line-height: 1; }
  .hero-split__award-lbl { font-size: 0.7rem; color: #5A7A72; margin-top: 2px; }
  .hero-split__stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .hero-split__stat { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 10px; text-align: center; }
  .hero-split__stat-val { font-family: var(--font-heading); font-size: 1.2rem; font-weight: 800; color: var(--accent); letter-spacing: -0.02em; line-height: 1; }
  .hero-split__stat-lbl { font-size: 0.66rem; color: var(--muted); margin-top: 5px; line-height: 1.3; }

  .ratgeber { padding: 80px 48px; background: var(--bg-el); }
  .ratgeber__inner { max-width: 1200px; margin: 0 auto; }
  .ratgeber__header { margin-bottom: 48px; }
  .ratgeber__badge { display: inline-flex; align-items: center; background: color-mix(in srgb, var(--accent) 10%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: var(--accent); margin-bottom: 16px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }
  .ratgeber__title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 14px; color: var(--text); }
  .ratgeber__title em { color: var(--accent); font-style: normal; }
  .ratgeber__sub { color: var(--muted); font-size: 1rem; line-height: 1.7; max-width: 520px; }
  .ratgeber__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .ratgeber__card { background: var(--bg); border: 1px solid var(--border); border-radius: 16px; padding: 28px 24px; transition: border-color 0.25s ease, transform 0.25s ease; }
  .ratgeber__card:hover { border-color: color-mix(in srgb, var(--accent) 35%, transparent); transform: translateY(-3px); }
  .ratgeber__icon { font-size: 2rem; margin-bottom: 12px; line-height: 1; }
  .ratgeber__thema { font-family: var(--font-heading); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }
  .ratgeber__card-title { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 700; color: var(--text); margin-bottom: 8px; }
  .ratgeber__card-desc { font-size: 0.85rem; color: var(--muted); line-height: 1.65; }

  @media (max-width: 1024px) { .hero-split { grid-template-columns: 1fr; gap: 40px; padding: 60px 32px; min-height: auto; } .hero-split__img-frame img { height: 360px; } .ratgeber__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .hero-split { padding: 48px 24px 56px; } .hero-split__ctas { flex-direction: column; } .hero-split__stats { grid-template-columns: repeat(2, 1fr); } .hero-split__img-frame img { height: 280px; } .ratgeber { padding: 60px 24px; } .ratgeber__grid { grid-template-columns: 1fr; } }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.anim-on-scroll').forEach(el => observer.observe(el));
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      const href = (anchor as HTMLAnchorElement).getAttribute('href');
      if (!href) return;
      const target = document.querySelector(href);
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    });
  });
</script>
