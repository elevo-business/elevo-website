---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztAesthetikProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztTeam from '../../templates/sections/zahnarzt/ZahnarztTeam.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Dr. med. dent. Klein',
  tagline: 'Premium Implantologie & Ästhetische Zahnmedizin München',
  location: 'München-Schwabing',
  email: 'praxis@dr-klein-zahnarzt.de',
  phone: '+49 89 4521090',
  heroTitle: 'Ihr Lächeln. Unser Meisterwerk.',
  heroSubtitle: 'Dr. Klein und sein Spezialistenteam in München-Schwabing verbinden modernste Implantologie mit ästhetischer Perfektion. Schweizer Titan, digitale Planung, 10 Jahre Garantie — für ein Lächeln, das ein Leben lang hält.',
  services: [
    { icon: 'implant', title: 'Premium Implantologie', description: 'Schweizer Titan-Implantate mit 3D-Volumentomographie und computergestützter OP-Schablone. Minimale Invasivität, maximale Sicherheit — 10 Jahre Garantie.' },
    { icon: 'star', title: 'Porzellan-Veneers', description: 'Hauchdünne Keramik-Veneers für ein strahlendes Hollywood-Lächeln. Computergeplantes Digital-Smile-Design — Sie sehen das Ergebnis vor der Behandlung.' },
    { icon: 'smile', title: 'Bleaching', description: 'Professionelles Power-Bleaching und individuelle Home-Bleaching-Systeme — für ein strahlendes, natürlich wirkendes Lächeln.' },
    { icon: 'grid', title: 'Invisalign', description: 'Unsichtbare Zahnkorrektur mit herausnehmbaren Alignern — diskret, komfortabel und ohne sichtbare Spange.' },
    { icon: 'tooth', title: 'Vollkeramik-Kronen', description: 'Naturidentische Keramikkronen in höchster zahntechnischer Qualität — langlebig, ästhetisch und biokompatibel.' },
    { icon: 'shield', title: 'Knochenaufbau', description: 'Professioneller Knochenaufbau als Implantat-Vorbereitung — auch in anspruchsvollen Fällen sicher und vorhersagbar.' },
  ],
  stats: [
    { value: '15+', label: 'Jahre Implantologie' },
    { value: '3.000+', label: 'Implantate gesetzt' },
    { value: '24h', label: 'Kostenvoranschlag' },
    { value: '5★', label: 'Google Bewertung' },
  ],
};
---

<PreviewLayout profile={zahnarztAesthetikProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    ctaText="Erstberatung vereinbaren"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Premium Implantologie München"
    ctaPrimary={{ text: 'Kostenlose Smile-Design-Analyse buchen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Unsere Behandlungsphilosophie →', href: '#leistungen' }}
    imageSrc="/preview-images/dr-klein-zahnarzt/hero.jpg"
    imageAlt="Dr. Klein München-Schwabing — Premium Implantologie und Ästhetik"
    stats={prospect.stats}
  />

  <ZahnarztServices
    title="Unsere Premium-Leistungen"
    subtitle="Ästhetische Perfektion und Implantologie auf höchstem Niveau — für Ihr Traumlächeln."
    services={prospect.services}
  />

  <ZahnarztTeam
    name="Dr. med. dent. Klein"
    title="Spezialist für Implantologie & Ästhetische Zahnmedizin"
    bio="Spezialist für Implantologie und ästhetische Zahnheilkunde. Seit 15 Jahren in München-Schwabing. »Jedes Lächeln ist ein Unikat. Mein Anspruch ist, dass Sie Ihr Ergebnis nicht nur sehen — sondern spüren.«"
    imageSrc="/preview-images/dr-klein-zahnarzt/gallery-1.jpg"
    qualifications={[
      'Studium an der LMU München',
      'Spezialisierung Implantologie (DGI)',
      'Zertifizierter Invisalign-Behandler',
      'Digital Smile Design Practitioner',
    ]}
  />

  <ZahnarztTimeline
    title="Ihr Weg zum perfekten Lächeln"
    subtitle="Jedes Lächeln ist individuell. Deshalb planen wir Ihres digital — bevor die Behandlung beginnt."
    steps={[
      { num: 1, title: 'Smile-Design-Analyse', desc: 'Digitaler Scan, Fotoanalyse, Gesichtsproportionen. Sie sehen Ihr neues Lächeln am Bildschirm.', icon: 'search' },
      { num: 2, title: 'Individuelle Planung', desc: 'Material-Auswahl, Farbabstimmung, Zeitplan. Alles auf Sie abgestimmt, schriftlich dokumentiert.', icon: 'calendar' },
      { num: 3, title: 'Präzise Umsetzung', desc: 'Schweizer Titan-Implantate, CAD/CAM-Kronen, Digital Smile Design. Technik im Dienst der Ästhetik.', icon: 'star' },
      { num: 4, title: '10-Jahre-Garantie', desc: 'Wir stehen hinter unserer Arbeit. Regelmäßige Kontrollen inklusive. Ihr Lächeln, langfristig geschützt.', icon: 'check' },
    ]}
  />

  <ZahnarztBeforeAfter
    title="Digital geplant. Perfekt umgesetzt."
    subtitle="Sehen Sie den Unterschied — geplant mit Digital Smile Design, umgesetzt mit Premium-Materialien."
    cases={[
      { beforeSrc: '/preview-images/dr-klein-zahnarzt/gallery-2.jpg', afterSrc: '/preview-images/dr-klein-zahnarzt/gallery-3.jpg', label: 'Komplettes Smile Makeover — 10 Veneers, Farbton individuell abgestimmt. Behandlung: 2 Sitzungen.' },
      { beforeSrc: '/preview-images/dr-klein-zahnarzt/gallery-4.jpg', afterSrc: '/preview-images/dr-klein-zahnarzt/gallery-1.jpg', label: 'Bleaching + Composite-Korrektur — Ohne Schleifen, ohne Betäubung. Ergebnis in einer Sitzung.' },
    ]}
  />

  <ZahnarztCostCalc
    title="Investition in Ihr Lächeln"
    subtitle="Premium-Qualität hat ihren Wert. Unser Rechner zeigt Ihnen transparent, welche Investition für Ihr Wunschergebnis nötig ist."
    ctaText="Persönliche Beratung mit Dr. Klein — Smile-Design-Analyse buchen"
    ctaHref="#kontakt"
  />

  <PreviewTestimonials
    title="Was unsere Patienten sagen"
    testimonials={[
      { text: 'Dr. Klein hat mein Lächeln komplett verändert. Die Veneers sehen absolut natürlich aus — ich bekomme ständig Komplimente.', author: 'Isabella V.', role: 'Veneer-Patientin' },
      { text: 'Die Implantat-Beratung war absolut professionell. Dr. Klein hat sich Zeit genommen, alle Fragen zu beantworten. Das Ergebnis ist perfekt.', author: 'Florian K.', role: 'Implantat-Patient' },
      { text: 'Endlich eine Praxis, die Ästhetik ernst nimmt. Das Smile Design vorab zu sehen war beeindruckend — genau so ist es geworden.', author: 'Nadine S.', role: 'Patientin' },
    ]}
  />

  <PreviewCTA
    title="Exklusive Erstberatung vereinbaren"
    subtitle="Inklusive kostenloser Smile-Design-Analyse — sehen Sie Ihr neues Lächeln, bevor die Behandlung beginnt."
    ctaText="Exklusive Erstberatung vereinbaren"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>
