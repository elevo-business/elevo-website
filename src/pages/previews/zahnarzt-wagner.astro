---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztModernProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztAnxiety from '../../templates/sections/zahnarzt/ZahnarztAnxiety.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztTeam from '../../templates/sections/zahnarzt/ZahnarztTeam.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Wagner',
  tagline: 'Implantologie & Ästhetik Hamburg-Eppendorf',
  location: 'Hamburg-Eppendorf',
  email: 'info@zahnarzt-wagner-hamburg.de',
  phone: '+49 40 7654321',
  heroTitle: 'Wieder fest zubeißen. Ohne Kompromisse.',
  heroSubtitle: 'Über 1.200 Implantate. Jedes einzelne sitzt. Praxis Wagner in Hamburg-Eppendorf verbindet Präzision mit modernster 3D-Planung — damit Ihr Implantat ein Leben lang hält.',
  services: [
    { icon: 'implant', title: 'Implantologie', description: 'Zahnimplantate für dauerhaften, natürlich aussehenden Zahnersatz — von der Planung bis zur Krone.' },
    { icon: 'smile', title: 'Veneers & Bleaching', description: 'Hauchdünne Keramikschalen und professionelles Aufhellen für ein makelloses Lächeln.' },
    { icon: 'tooth', title: 'Keramikrestaurationen', description: 'Zahnfarbene Inlays, Onlays und Kronen aus hochwertiger Keramik — unsichtbar und langlebig.' },
    { icon: 'shield', title: 'Knochenaufbau', description: 'Professioneller Knochenaufbau als Vorbereitung für Implantate — auch in komplexen Fällen.' },
    { icon: 'check', title: 'Prophylaxe & PZR', description: 'Professionelle Zahnreinigung und Prävention für dauerhaft gesunde Zähne.' },
    { icon: 'star', title: 'Ganzkiefer-Rehabilitation', description: 'Umfassende Versorgung bei komplexem Behandlungsbedarf — interdisziplinär und koordiniert.' },
  ],
  stats: [
    { value: '18+', label: 'Jahre Erfahrung' },
    { value: '1.200+', label: 'Implantate gesetzt' },
    { value: '5★', label: 'Bewertung Hamburg' },
  ],
};
---

<PreviewLayout profile={zahnarztModernProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    ctaText="Beratungsgespräch"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Implantologie-Spezialist seit 2006"
    ctaPrimary={{ text: 'Kostenvoranschlag in 24h', href: '#kontakt' }}
    ctaSecondary={{ text: 'So läuft eine Implantation ab →', href: '#ablauf' }}
    imageSrc="/preview-images/zahnarzt-wagner/hero.jpg"
    imageAlt="Zahnarztpraxis Wagner Hamburg-Eppendorf — Implantologie"
    stats={prospect.stats}
  />

  <div class="zh-trust-bar" role="list" aria-label="Qualitätsmerkmale">
    <div class="zh-trust-bar__inner">
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Kassenzulassung & Privatpatienten</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/>
        </svg>
        <span>3D-Implantplanung</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
        </svg>
        <span>Kostenvoranschlag in 24h</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span>5★ Bewertung Hamburg</span>
      </div>
    </div>
  </div>

  <ZahnarztServices
    title="Unsere Schwerpunkte"
    subtitle="Implantologie, Ästhetik und umfassende Zahnheilkunde — alles aus einer erfahrenen Hand."
    services={prospect.services}
  />

  <ZahnarztAnxiety
    title="1.200 Implantate. Keiner bereut es."
    quote="Die Angst vor einem Implantat ist meistens größer als der Eingriff selbst. Wir zeigen Ihnen Schritt für Schritt, was passiert — damit aus Ungewissheit Vertrauen wird."
    quoteAuthor="Dr. Stefan Wagner"
    trustPoints={[
      { icon: 'shield', title: '3D-Planung zeigt alles vorab', desc: 'Sie sehen am Bildschirm genau, wo das Implantat sitzt — noch bevor der erste Schnitt gemacht wird.' },
      { icon: 'check', title: 'Lokal betäubt reicht', desc: 'Über 1.200 Implantate unter lokaler Betäubung. Fast alle Patienten arbeiten am nächsten Tag.' },
      { icon: 'heart', title: 'Sedierung auf Wunsch', desc: 'Wer lieber entspannt schläft: Dämmerschlaf oder Lachgas sind möglich. Sagen Sie einfach Bescheid.' },
      { icon: 'star', title: 'Transparenter Zeitplan', desc: 'Von der Implantation bis zur fertigen Krone — wir geben Ihnen einen klaren Zeitplan. Keine Überraschungen.' },
    ]}
    cta={{ text: 'Kostenvoranschlag anfordern', href: '#kontakt' }}
  />

  <ZahnarztTimeline
    id="ablauf"
    title="Von der Diagnose zum fertigen Implantat"
    subtitle="Vier Schritte. Alles geplant, nichts dem Zufall überlassen."
    steps={[
      { num: 1, title: '3D-Analyse', desc: 'Wir röntgen Ihren Kiefer dreidimensional. Sie sehen auf dem Bildschirm genau, wo das Implantat sitzt — bevor wir anfangen.', icon: 'search' },
      { num: 2, title: 'Behandlungsplan', desc: 'Sie bekommen einen schriftlichen Plan mit Kosten, Dauer und Alternativen. Keine Überraschungen.', icon: 'calendar' },
      { num: 3, title: 'Implantation', desc: 'Der Eingriff dauert 30–60 Minuten pro Implantat. Unter lokaler Betäubung. Die meisten Patienten arbeiten am nächsten Tag.', icon: 'tooth' },
      { num: 4, title: 'Krone & Nachsorge', desc: 'Nach der Einheilzeit setzen wir die Krone. Danach: regelmäßige Kontrolle, damit das Implantat Jahrzehnte hält.', icon: 'check' },
    ]}
  />

  <ZahnarztBeforeAfter
    title="Echte Ergebnisse. Echte Patienten."
    subtitle="Jedes Implantat erzählt eine Geschichte. Hier sind einige davon."
    cases={[
      { beforeSrc: '/preview-images/zahnarzt-wagner/gallery-1.jpg', afterSrc: '/preview-images/zahnarzt-wagner/gallery-2.jpg', label: 'Einzelzahn-Implantat Oberkiefer — Wieder fest zubeißen nach Sportunfall. Behandlungsdauer: 4 Monate.' },
      { beforeSrc: '/preview-images/zahnarzt-wagner/gallery-3.jpg', afterSrc: '/preview-images/zahnarzt-wagner/gallery-4.jpg', label: 'Sofortimplantat Frontzahn — Zahnverlust am Freitag, provisorisches Implantat am Montag.' },
    ]}
  />

  <ZahnarztTeam
    name="Dr. Stefan Wagner"
    title="Zahnarzt & Implantologe, Hamburg-Eppendorf"
    bio="Über 1.200 Implantate. Jedes davon ist eine Entscheidung, die ich mit meinen Patienten gemeinsam getroffen habe. Transparenz, sorgfältige Planung und Verlässlichkeit — das ist die Basis für Implantate, die Jahrzehnte halten."
    qualifications={[
      'Approbierter Zahnarzt (Universität Hamburg)',
      'Spezialisierung Implantologie (DGI)',
      'Zertifizierter 3D-Chirurg (digitale Implantplanung)',
      'Fortbildungszertifikat Knochenaufbau & Augmentation',
      'Mitglied der Deutschen Gesellschaft für Implantologie',
    ]}
    cta={{ text: 'Team kennenlernen — Implantat-Beratung buchen', href: '#kontakt' }}
  />

  <PreviewTestimonials
    title="Was Patienten über uns sagen"
    testimonials={[
      { text: 'Die Implantat-Behandlung bei Praxis Wagner war absolut professionell. Ich bin überglücklich mit dem Ergebnis.', author: 'Brigitte S.', role: 'Implantat-Patientin' },
      { text: 'Endlich wieder richtig kauen und lachen — das Implantat sieht genauso aus wie mein eigener Zahn.', author: 'Frank M.', role: 'Patient' },
      { text: 'Kompetente Beratung, modernste Technik und ein Team, das sich wirklich Zeit nimmt. Absolute Empfehlung.', author: 'Anja L.', role: 'Patientin seit 4 Jahren' },
    ]}
  />

  <ZahnarztCostCalc
    title="Was kostet mein Implantat?"
    subtitle="Klicken Sie auf den Zahn, wählen Sie die Behandlung — und sehen Sie sofort eine Kostenschätzung. Unverbindlich und transparent."
    ctaText="Genauer Kostenvoranschlag? Schicken wir Ihnen in 24 Stunden."
    ctaHref="#kontakt"
  />

  <PreviewCTA
    title="Jetzt unverbindlich beraten lassen"
    subtitle="Erfahren Sie kostenlos, welche Implantatlösung für Sie passt — persönliches Gespräch, keine Verpflichtung."
    ctaText="Jetzt unverbindlich beraten lassen"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>

<style>
  .zh-trust-bar {
    background: linear-gradient(
      to bottom,
      var(--bg-deep, #0d1f1c),
      color-mix(in srgb, var(--accent, #0E8A7B) 4%, var(--bg-deep, #0d1f1c))
    );
    border-bottom: 1px solid rgba(14, 138, 123, 0.15);
  }

  .zh-trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 20px 48px;
    flex-wrap: wrap;
  }

  .zh-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted, #8aafa5);
    white-space: nowrap;
  }

  .zh-trust-bar__item svg {
    color: var(--accent, #0E8A7B);
    flex-shrink: 0;
  }

  .zh-trust-bar__divider {
    width: 1px;
    height: 24px;
    background: rgba(14, 138, 123, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .zh-trust-bar__inner {
      gap: 16px;
      padding: 16px 24px;
    }

    .zh-trust-bar__divider {
      display: none;
    }

    .zh-trust-bar__item {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .zh-trust-bar__inner {
      justify-content: flex-start;
      gap: 12px;
    }

    .zh-trust-bar__item {
      flex: 1 1 calc(50% - 6px);
      min-width: 0;
      white-space: normal;
    }
  }
</style>
