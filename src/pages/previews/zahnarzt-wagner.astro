<script>
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href');
      if (!href) return;
      const target = document.querySelector(href);
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    });
  });
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } });
  }, { threshold: 0.15 });
  document.querySelectorAll('.anim-on-scroll, .process__step, .vorsorge__card').forEach(el => { el.classList.add('anim-on-scroll'); observer.observe(el); });
  const countObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const raw = el.dataset.count || el.textContent || '';
        const match = raw.match(/(\d[\d.]*)/);
        if (match) { const numStr = match[1].replace('.', ''); const target = parseInt(numStr); const suffix = raw.replace(/[\d.]+/, ''); let current = 0; const step = Math.max(1, Math.floor(target / 40)); const timer = setInterval(() => { current += step; if (current >= target) { current = target; clearInterval(timer); } el.textContent = current.toLocaleString('de-DE') + suffix; }, 30); }
        countObserver.unobserve(el);
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.hero-full__stat-val').forEach(el => countObserver.observe(el));
  const tabs = document.querySelectorAll('.services-tabs__tab');
  const panels = document.querySelectorAll('.services-tabs__panel');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const idx = (tab as HTMLElement).dataset.tab;
      tabs.forEach(t => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
      panels.forEach(p => p.classList.remove('is-active'));
      tab.classList.add('is-active'); tab.setAttribute('aria-selected', 'true');
      const panel = document.querySelector(`[data-panel="${idx}"]`);
      if (panel) panel.classList.add('is-active');
    });
  });
  const typeButtons = document.querySelectorAll('.estimator__option');
  const slider = document.getElementById('qty-slider') as HTMLInputElement;
  const qtyLabel = document.getElementById('qty-label');
  const qtyVal = document.getElementById('qty-val');
  const estimateVal = document.getElementById('estimate-val');
  type Treatment = { lo: number; hi: number; min: number; max: number; labelSingle: string; labelPlural: string; sliderLabel: string };
  const treatments: Record<string, Treatment> = {
    implantate: { lo: 1500, hi: 3000, min: 1, max: 8, labelSingle: 'Implantat', labelPlural: 'Implantate', sliderLabel: 'Anzahl Implantate' },
    bleaching: { lo: 300, hi: 600, min: 1, max: 2, labelSingle: 'Kiefer', labelPlural: 'Kiefer', sliderLabel: 'Anzahl Kiefer (1 = Ober- oder Unterkiefer)' },
    veneers: { lo: 400, hi: 900, min: 1, max: 12, labelSingle: 'Zahn', labelPlural: 'Zähne', sliderLabel: 'Anzahl Zähne' },
  };
  let selectedTreatment = 'implantate';
  function updateEstimate() {
    if (!slider || !qtyVal || !estimateVal || !qtyLabel) return;
    const t = treatments[selectedTreatment];
    const count = parseInt(slider.value);
    qtyLabel.textContent = t.sliderLabel;
    qtyVal.textContent = count + ' ' + (count === 1 ? t.labelSingle : t.labelPlural);
    estimateVal.textContent = `ca. ${(count * t.lo).toLocaleString('de-DE')} — ${(count * t.hi).toLocaleString('de-DE')} €`;
  }
  typeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      typeButtons.forEach(b => b.classList.remove('is-active')); btn.classList.add('is-active');
      selectedTreatment = (btn as HTMLElement).dataset.value || 'implantate';
      const t = treatments[selectedTreatment]; slider.min = t.min.toString(); slider.max = t.max.toString(); slider.value = t.min.toString();
      updateEstimate();
    });
  });
  if (slider) { slider.addEventListener('input', updateEstimate); updateEstimate(); }
</script>
