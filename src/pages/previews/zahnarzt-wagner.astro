---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztProfile } from '../../templates/config/zahnarzt';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const ICON = {
  implantologie: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2c-1.5 0-2.5 1-3 2.5L4.5 11C4 14 5.5 16 7 16c.6 0 1.1-.2 1.5-.5L12 14l3.5 1.5c.4.3.9.5 1.5.5 1.5 0 3-2 2.5-5L18 4.5C17.5 3 16.5 2 15 2c-1 0-2 .6-3 .6S10 2 9 2z"/><line x1="12" y1="14" x2="12" y2="21"/><path d="M10 18h4"/></svg>`,
  wurzelbehandlung: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2c-1.5 0-2.5 1-3 2.5L4.5 11C4 14 5.5 16 7 16c.6 0 1.1-.2 1.5-.5L12 14l3.5 1.5c.4.3.9.5 1.5.5 1.5 0 3-2 2.5-5L18 4.5C17.5 3 16.5 2 15 2c-1 0-2 .6-3 .6S10 2 9 2z"/><path d="M10 14l-2 8M14 14l2 8M12 14v8"/></svg>`,
  zahnersatz: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l3.5 11h11L21 9"/><path d="M3 9l4 4 5-7 5 7 4-4"/></svg>`,
  kieferorthopaedie: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8" width="20" height="8" rx="2"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="7" y1="8" x2="7" y2="16"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="17" y1="8" x2="17" y2="16"/></svg>`,
  prophylaxe: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2c-1.5 0-2.5 1-3 2.5L4.5 11C4 14 5.5 16 7 16c.6 0 1.1-.2 1.5-.5L12 14l3.5 1.5c.4.3.9.5 1.5.5 1.5 0 3-2 2.5-5L18 4.5C17.5 3 16.5 2 15 2c-1 0-2 .6-3 .6S10 2 9 2z"/><path d="M19.5 2.5l1 1M21.5 5.5h1M19.5 8.5l1-1"/></svg>`,
  parodontologie: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20c0-5 2-9 8-9s8 4 8 9"/><path d="M12 11V5"/><path d="M9 2c-.5 0-2 .5-2.5 2L5.5 7h13l-1-3C17 2.5 15.5 2 15 2c-.5 0-1.5.5-3 .5S9.5 2 9 2z"/></svg>`,
};

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Wagner',
  tagline: 'Digitale Implantologie & Modernste Zahnmedizin Hamburg',
  location: 'Hamburg',
  email: 'info@zahnarzt-wagner.de',
  phone: '+49 40 567890',
  heroTitle: 'Moderne Implantologie. <em>Dauerhaft schön.</em>',
  heroSubtitle: 'Zahnarztpraxis Wagner steht für digitale Präzisionsmedizin — mit 3D-Planung, schonenden Methoden und garantiert schmerzarmen Eingriffen. Hamburg vertraut uns für langlebige Implantate.',
  services: [
    { icon: ICON.implantologie, title: 'Implantologie', description: 'Hochpräzise Implantologie mit digitaler 3D-Volumentomographie und computergestützter OP-Planung. Schonende Eingriffe, maximale Sicherheit und natürlich wirkende Ergebnisse — dauerhaft.' },
    { icon: ICON.wurzelbehandlung, title: 'Wurzelbehandlung', description: 'Modernste Endodontie mit rotierenden Nickel-Titan-Instrumenten und digitaler Längenmessung. Wir erhalten Ihren natürlichen Zahn — schmerz- und stressarm, mit höchster Erfolgsrate.' },
    { icon: ICON.zahnersatz, title: 'Zahnersatz', description: 'Digitale Abformung und CAD/CAM-gefertigte Restaurationen — hochwertige Vollkeramik-Kronen und Brücken in kürzester Zeit. Keine Abdrücke, maximaler Komfort, natürliches Aussehen.' },
    { icon: ICON.kieferorthopaedie, title: 'Kieferorthopädie', description: 'Unsichtbare Aligner-Systeme für Erwachsene — ohne sichtbare Spange, vollständig digital geplant und kontrolliert. Diskretes Lächeln-Upgrade für berufstätige Patienten.' },
    { icon: ICON.prophylaxe, title: 'Prophylaxe', description: 'Professionelle Zahnreinigung mit Ultraschall und Air-Flow-Methode — gründlich, schonend und nachhaltig. Regelmäßige Prophylaxe schützt Ihre Investition in gesunde Zähne.' },
    { icon: ICON.parodontologie, title: 'Parodontologie', description: 'Systematische Parodontitis-Behandlung nach neuesten Leitlinien — mit digitaler Taschenmessung und individuell angepasstem Therapieplan. Wir stoppen den Zahnverlust nachhaltig.' },
  ],
  stats: [
    { value: '12+', label: 'Jahre Erfahrung' },
    { value: '2.500+', label: 'Implantate gesetzt' },
    { value: '100%', label: 'Digital geplant' },
    { value: '4', label: 'Behandler im Team' },
  ],
};

const processSteps = [
  { num: '01', title: 'Digitale Analyse', desc: '3D-Volumentomographie und vollständige digitale Analyse. Präzise Diagnose als Basis für jeden Behandlungsplan — ohne Überraschungen.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>` },
  { num: '02', title: 'Behandlungsplan', desc: 'Individueller Behandlungsplan mit digitaler Simulation des Endergebnisses. Sie sehen vor der Behandlung, wie das Ergebnis aussehen wird — transparent und verbindlich.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>` },
  { num: '03', title: 'Präzisionseingriff', desc: 'Computergestützte, schonende Behandlung mit modernsten Instrumenten. Minimale Invasivität, maximale Präzision — für schnellste Heilung und bestes Ergebnis.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>` },
  { num: '04', title: 'Erfolgskontrolle', desc: 'Digitale Verlaufsdokumentation und regelmäßige Kontrolle sichern Ihr Ergebnis langfristig. Ihre Investition in gesunde Zähne ist bei uns bestens geschützt.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>` },
];

const vorsorge = [
  { icon: '🔬', thema: 'Digitale Diagnostik', title: '3D statt Raten', desc: 'Digitale Volumentomographie zeigt, was klassisches Röntgen verbirgt — präzisere Diagnose, sicherere Behandlung, bessere Ergebnisse.' },
  { icon: '🦷', thema: 'Implantat-Pflege', title: 'Implantate richtig pflegen', desc: 'Mit der richtigen Pflege halten Implantate ein Leben lang. Wir zeigen Ihnen, wie elektrische Zahnbürste und Interdentalbürstchen optimal zusammenspielen.' },
  { icon: '📱', thema: 'Digital-First', title: 'Alles digital gesteuert', desc: 'Von der Terminbuchung bis zur Behandlung — unser digitaler Workflow spart Zeit und erhöht die Qualität. Kein Papierkram, keine Wartezeiten.' },
  { icon: '🛡️', thema: 'Langzeitschutz', title: 'Invest in Zahngesundheit', desc: 'Regelmäßige Prophylaxe ist die günstigste Versicherung für Ihre Zähne. Wir rechnen Ihnen vor, wie viel Sie langfristig sparen.' },
];
---

<PreviewLayout profile={zahnarztProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} ctaText="Termin vereinbaren" ctaHref="#kontakt" />

  <header class="hero-full" id="hero">
    <div class="hero-full__bg">
      <img src="/preview-images/zahnarzt-wagner/hero.jpg" alt="Zahnarztpraxis Wagner Hamburg — digitale Implantologie und moderne Zahnmedizin" width="1920" height="1080" loading="eager" fetchpriority="high" />
      <div class="hero-full__overlay"></div>
    </div>
    <div class="hero-full__content anim-fade-up">
      <div class="hero-full__badge">
        <span class="hero-full__badge-dot"></span>
        Hamburg · Digitale Implantologie · 3D-Diagnostik
      </div>
      <h1 class="hero-full__title">Moderne Implantologie.<br/><span>Dauerhaft schön.</span></h1>
      <p class="hero-full__sub">{prospect.heroSubtitle}</p>
      <div class="hero-full__ctas">
        <a href="#kontakt" class="hero-full__btn-primary">Termin vereinbaren</a>
        <a href="#leistungen" class="hero-full__btn-outline">Unsere Leistungen</a>
      </div>
    </div>
    <div class="hero-full__stats">
      {prospect.stats?.map(s => (
        <div class="hero-full__stat">
          <div class="hero-full__stat-val" data-count={s.value}>{s.value}</div>
          <div class="hero-full__stat-lbl">{s.label}</div>
        </div>
      ))}
    </div>
  </header>

  <section class="trust-bar">
    <div class="trust-bar__inner">
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>
        <span>3D-Volumentomographie</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>2.500+ Implantate gesetzt</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Kassenzulassung vorhanden</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>12+ Jahre Implantologie-Expertise</span>
      </div>
    </div>
  </section>

  <section class="services-tabs" id="leistungen">
    <div class="services-tabs__inner">
      <div class="services-tabs__header">
        <div class="services-tabs__badge">Unsere Leistungen</div>
        <h2 class="services-tabs__title">Was können wir <em>für Sie tun?</em></h2>
        <p class="services-tabs__sub">Von der digitalen Implantatplanung bis zur Prophylaxe — hochwertige Zahnmedizin mit Hamburger Präzision.</p>
      </div>
      <div class="services-tabs__nav" role="tablist">
        {prospect.services.map((s, i) => (
          <button class={`services-tabs__tab ${i === 0 ? 'is-active' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i} type="button">
            <span class="services-tabs__tab-icon" set:html={s.icon} />
            <span>{s.title}</span>
          </button>
        ))}
      </div>
      <div class="services-tabs__panels">
        {prospect.services.map((s, i) => (
          <div class={`services-tabs__panel ${i === 0 ? 'is-active' : ''}`} role="tabpanel" data-panel={i}>
            <div class="services-tabs__panel-icon" set:html={s.icon} />
            <h3 class="services-tabs__panel-title">{s.title}</h3>
            <p class="services-tabs__panel-desc">{s.description}</p>
            <a href="#kontakt" class="services-tabs__panel-cta">Jetzt Termin anfragen &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="process" id="ablauf">
    <div class="process__inner">
      <div class="process__header">
        <div class="process__badge">Unser digitaler Prozess</div>
        <h2 class="process__title">Präzision <em>von Anfang an</em></h2>
        <p class="process__sub">Vom ersten Scan bis zum fertigen Implantat — jeder Schritt digital geplant, transparent und für Sie nachvollziehbar.</p>
      </div>
      <div class="process__steps">
        {processSteps.map((step, i) => (
          <div class="process__step">
            <div class="process__step-icon" set:html={step.icon} />
            <div class="process__step-num">{step.num}</div>
            <h3 class="process__step-title">{step.title}</h3>
            <p class="process__step-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="showcase" id="galerie">
    <div class="showcase__inner">
      <div class="showcase__header">
        <div class="showcase__badge">Einblick in die Praxis</div>
        <h2 class="showcase__title">Modernste Technik <em>in freundlicher Atmosphäre</em></h2>
        <p class="showcase__sub">Unsere Hamburger Praxis vereint hochmoderne digitale Diagnostik mit einer Atmosphäre, in der Sie sich sofort wohl fühlen.</p>
      </div>
      <div class="showcase__grid anim-on-scroll">
        <div class="showcase__item showcase__item--large">
          <img src="/preview-images/zahnarzt-wagner/gallery-1.jpg" alt="Digitale 3D-Implantatplanung in der Zahnarztpraxis Wagner Hamburg" loading="lazy" width="800" height="600" />
          <div class="showcase__caption">
            <span class="showcase__tag">3D-Planung</span>
            <h3>Digitale Volumentomographie</h3>
            <p>Präzise 3D-Diagnostik als Grundlage für jeden Implantat-Eingriff — mehr Sicherheit, bessere Ergebnisse.</p>
          </div>
        </div>
        <div class="showcase__item showcase__item--small">
          <img src="/preview-images/zahnarzt-wagner/gallery-2.jpg" alt="Moderner Behandlungsraum mit digitaler Ausrüstung" loading="lazy" width="500" height="280" />
          <div class="showcase__caption">
            <span class="showcase__tag">High-Tech</span>
            <h3>Digitale Behandlungsräume</h3>
          </div>
        </div>
        <div class="showcase__item showcase__item--small">
          <img src="/preview-images/zahnarzt-wagner/gallery-3.jpg" alt="Vollkeramik Zahnersatz Hamburg" loading="lazy" width="500" height="280" />
          <div class="showcase__caption">
            <span class="showcase__tag">Ästhetik</span>
            <h3>CAD/CAM-Vollkeramik</h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PreviewTestimonials
    title="Das sagen unsere Patienten"
    subtitle="Über 2.500 Implantate und tausende zufriedene Patienten — hier berichten einige über ihre Erfahrungen."
    testimonials={[
      { text: 'Der digitale Ansatz hat mich von Anfang an überzeugt. Ich konnte im 3D-Modell sehen, wie mein Implantat geplant wird. Der Eingriff war fast schmerzfrei und das Ergebnis perfekt.', author: 'Jörg M.', role: 'Implantat-Patient, Hamburg Eimsbüttel', rating: 5 },
      { text: 'Nach einer gescheiterten Wurzelbehandlung woanders hat mir Praxis Wagner meinen Zahn gerettet. Hochpräzise, schnell und ohne jede Komplikation. Endlich ein Zahnarzt, dem ich vertraue.', author: 'Katrin S.', role: 'Patientin, Hamburg Altona', rating: 5 },
      { text: 'Die Aligner-Behandlung hat mein Leben verändert — niemand hat in den 14 Monaten gemerkt, dass ich eine Schiene trage. Jetzt habe ich ein Lächeln, für das ich früher nie Geld ausgegeben hätte.', author: 'Felix R.', role: 'Aligner-Patient, Hamburg', rating: 5 },
    ]}
  />

  <section class="vorsorge" id="vorsorge">
    <div class="vorsorge__inner">
      <div class="vorsorge__header">
        <h2 class="vorsorge__title">Digital & Präventiv</h2>
        <p class="vorsorge__sub">Modernes Denken für moderne Zahngesundheit — Tipps aus unserer digitalen Praxis für Ihren Alltag.</p>
      </div>
      <div class="vorsorge__grid">
        {vorsorge.map(tip => (
          <div class="vorsorge__card">
            <div class="vorsorge__icon">{tip.icon}</div>
            <div class="vorsorge__thema">{tip.thema}</div>
            <h3 class="vorsorge__card-title">{tip.title}</h3>
            <p class="vorsorge__card-desc">{tip.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="estimator" id="kalkulator">
    <div class="estimator__inner">
      <div class="estimator__header">
        <div class="estimator__badge">Kostenrechner</div>
        <h2 class="estimator__title">Was kostet <em>Ihre Behandlung?</em></h2>
        <p class="estimator__sub">Erhalten Sie eine unverbindliche Ersteinschätzung — in unter 30 Sekunden.</p>
      </div>
      <div class="estimator__form">
        <div class="estimator__field">
          <label class="estimator__label">Art der Behandlung</label>
          <div class="estimator__options">
            <button class="estimator__option is-active" data-value="implantate" type="button">Implantate</button>
            <button class="estimator__option" data-value="bleaching" type="button">Bleaching</button>
            <button class="estimator__option" data-value="veneers" type="button">Veneers</button>
          </div>
        </div>
        <div class="estimator__field">
          <label class="estimator__label" id="qty-label">Anzahl Implantate</label>
          <div class="estimator__slider-wrap">
            <input type="range" min="1" max="8" value="1" class="estimator__slider" id="qty-slider" />
            <span class="estimator__slider-val" id="qty-val">1 Stück</span>
          </div>
        </div>
        <div class="estimator__result">
          <div class="estimator__result-label">Geschätzte Kosten</div>
          <div class="estimator__result-val" id="estimate-val">ca. 1.500 — 3.000 €</div>
          <div class="estimator__result-note">Unverbindliche Schätzung. Genaue Kosten nach Erstberatung und Befund.</div>
          <a href="#kontakt" class="estimator__result-cta">Jetzt kostenlosen Beratungstermin anfragen</a>
        </div>
      </div>
    </div>
  </section>

  <PreviewCTA
    title="Hamburg setzt auf Präzision — Ihre Zähne auch."
    subtitle="Vereinbaren Sie jetzt Ihre digitale Erstanalyse bei Zahnarztpraxis Wagner in Hamburg. 3D-Diagnostik, computergestützte Planung und schonende Eingriffe — modernste Zahnmedizin für dauerhaft schöne Ergebnisse."
    badge="Jetzt Termin anfragen"
    buttonText="Digitalen Termin vereinbaren"
    buttonLink="#kontakt"
    phone="+49 40 567890"
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    address="Mönckebergstraße 15, 20095 Hamburg"
    year={2025}
  />
</PreviewLayout>

<style>
  html { scroll-behavior: smooth; }
  .anim-fade-up { animation: fadeUp 0.8s ease-out both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  .anim-on-scroll { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .anim-on-scroll.is-visible { opacity: 1; transform: translateY(0); }
  .hero-full { position: relative; min-height: 80vh; max-height: 700px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
  .hero-full__bg { position: absolute; inset: 0; z-index: 0; }
  .hero-full__bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .hero-full__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(8,22,20,0.96) 0%, rgba(8,22,20,0.72) 35%, rgba(8,22,20,0.35) 65%, rgba(8,22,20,0.15) 100%); }
  .hero-full__content { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 48px 48px; width: 100%; }
  .hero-full__badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.18); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: rgba(255,255,255,0.9); margin-bottom: 20px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }
  .hero-full__badge-dot { width: 7px; height: 7px; background: #2DD4BF; border-radius: 50%; animation: pulse-hero 2s ease-in-out infinite; }
  @keyframes pulse-hero { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.75); } }
  .hero-full__title { font-family: var(--font-heading); font-size: clamp(2.8rem, 5.5vw, 4.2rem); font-weight: 800; line-height: 1.05; letter-spacing: -0.03em; color: #fff; margin-bottom: 20px; }
  .hero-full__title span { color: #2DD4BF; }
  .hero-full__sub { color: rgba(255,255,255,0.75); font-size: 1.1rem; line-height: 1.7; max-width: 560px; margin-bottom: 32px; }
  .hero-full__ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-full__btn-primary { background: var(--accent); color: #fff; padding: 14px 28px; border-radius: 10px; font-size: 0.95rem; font-weight: 600; font-family: var(--font-body); transition: background 0.2s, transform 0.2s; text-decoration: none; }
  .hero-full__btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); }
  .hero-full__btn-outline { border: 1px solid rgba(255,255,255,0.3); color: #fff; padding: 14px 28px; border-radius: 10px; font-size: 0.95rem; font-weight: 500; font-family: var(--font-body); transition: border-color 0.2s, background 0.2s; text-decoration: none; }
  .hero-full__btn-outline:hover { border-color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.08); }
