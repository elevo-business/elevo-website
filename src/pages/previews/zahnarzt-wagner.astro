---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztProfile } from '../../templates/config/zahnarzt';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewTreatmentSpectrum from '../../templates/sections/PreviewTreatmentSpectrum.astro';
import PreviewBeforeAfter from '../../templates/sections/PreviewBeforeAfter.astro';
import PreviewSmileCheck from '../../templates/sections/PreviewSmileCheck.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Wagner',
  tagline: 'Digitale Implantologie & Modernste Zahnmedizin Hamburg',
  location: 'Hamburg-Eppendorf',
  email: 'info@zahnarzt-wagner-hamburg.de',
  phone: '+49 40 5678900',
  heroTitle: 'Moderne Implantologie. <em>Dauerhaft schön.</em>',
  heroSubtitle: 'Zahnarztpraxis Wagner steht für digitale Präzisionsmedizin — mit 3D-Planung, schonenden Methoden und garantiert schmerzarmen Eingriffen. Hamburg vertraut uns für langlebige Implantate und ästhetische Zahnmedizin auf höchstem Niveau.',
  services: [],
  stats: [
    { value: '12+', label: 'Jahre Erfahrung' },
    { value: '2.500+', label: 'Implantate gesetzt' },
    { value: '100%', label: 'Digital geplant' },
    { value: '4', label: 'Behandler im Team' },
  ],
};

const treatments = [
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 2c-1.5 0-2.5 1-3 2.5L4.5 11C4 14 5.5 16 7 16c.6 0 1.1-.2 1.5-.5L12 14l3.5 1.5c.4.3.9.5 1.5.5 1.5 0 3-2 2.5-5L18 4.5C17.5 3 16.5 2 15 2c-1 0-2 .6-3 .6S10 2 9 2z"/><line x1="12" y1="14" x2="12" y2="21"/><path d="M10 18h4"/></svg>`,
    title: 'Digitale Implantologie',
    description: 'Hochpräzise Implantate mit 3D-Volumentomographie und computergestützter OP-Führungsschablone. Minimale Invasivität, maximale Sicherheit — natürlich wirkende Ergebnisse für ein Leben lang.',
    ctaText: 'Digitale Beratung starten',
    ctaHref: '#kontakt',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>`,
    title: '3D-Scan & Diagnostik',
    description: 'Digitale Volumentomographie zeigt, was klassisches Röntgen verbirgt — präzisere Diagnose, sicherere Behandlung, bessere Langzeitergebnisse. Keine Abdrücke, voller Komfort.',
    ctaText: '3D-Scan vereinbaren',
    ctaHref: '#kontakt',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 9l3.5 11h11L21 9"/><path d="M3 9l4 4 5-7 5 7 4-4"/></svg>`,
    title: 'CAD/CAM-Restaurationen',
    description: 'Digitale Abformung und CAD/CAM-gefertigte Vollkeramikkronen am selben Tag. Kein Abdruck, maximaler Komfort, natürliches Aussehen — die Restauration von morgen, heute verfügbar.',
    ctaText: 'Kostenvoranschlag',
    ctaHref: '#kontakt',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="8" width="20" height="8" rx="2"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="7" y1="8" x2="7" y2="16"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="17" y1="8" x2="17" y2="16"/></svg>`,
    title: 'Invisalign & Aligner',
    description: 'Unsichtbare Aligner-Systeme für Erwachsene — vollständig digital geplant und kontrolliert. Diskretes Lächeln-Upgrade für berufstätige Patienten, die Stil und Funktion verbinden.',
    ctaText: 'Beratung buchen',
    ctaHref: '#kontakt',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 20c0-5 2-9 8-9s8 4 8 9"/><path d="M12 11V5"/><path d="M9 2c-.5 0-2 .5-2.5 2L5.5 7h13l-1-3C17 2.5 15.5 2 15 2c-.5 0-1.5.5-3 .5S9.5 2 9 2z"/></svg>`,
    title: 'Parodontologie Digital',
    description: 'Systematische Parodontitis-Behandlung mit digitaler Taschenmessung und individuellem Therapieplan. Wir stoppen den Zahnverlust nachhaltig — präzise und wissenschaftlich fundiert.',
    ctaText: 'Termin anfragen',
    ctaHref: '#kontakt',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
    title: 'Digital-Prophylaxe',
    description: 'Professionelle Zahnreinigung mit Ultraschall und Air-Flow-Methode — gründlich, schonend, nachhaltig. Regelmäßige Prophylaxe schützt Ihre Investition in gesunde Zähne.',
    ctaText: 'PZR buchen',
    ctaHref: '#kontakt',
  },
];

const beforeAfterItems = [
  {
    beforeSrc: 'https://images.unsplash.com/photo-1606811842121-9a5c5c7c2ea8?w=600&q=80&fit=crop',
    afterSrc: 'https://images.unsplash.com/photo-1544717297-fa95b6ee9643?w=600&q=80&fit=crop',
    beforeAlt: 'Vor dem Implantat — fehlender Zahn',
    afterAlt: 'Nach dem Implantat — perfekter Zahnersatz',
    treatment: 'Digitales Einzelimplantat',
    description: 'Von der 3D-Diagnose bis zum fertigen Implantat — präzise geplant, dauerhaft schön.',
  },
  {
    beforeSrc: 'https://images.unsplash.com/photo-1563642421748-5047b6585a4a?w=600&q=80&fit=crop',
    afterSrc: 'https://images.unsplash.com/photo-1606811971618-4486d14f3f99?w=600&q=80&fit=crop',
    beforeAlt: 'Vor der Invisalign-Behandlung — schiefe Zähne',
    afterAlt: 'Nach der Invisalign-Behandlung — gerades Lächeln',
    treatment: 'Invisalign Full-Treatment',
    description: 'Unsichtbare Zahnkorrektur — 14 Monate, kein Metalldraht, volles digitales Tracking.',
  },
];
---

<PreviewLayout profile={zahnarztProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} ctaText="Digitale Beratung starten" ctaHref="#kontakt" />

  <!-- VIDEO-STYLE HERO: Dark, tech-inspired with gradient overlay -->
  <header class="hero-video" id="hero">
    <div class="hero-video__bg">
      <img
        src="https://images.unsplash.com/photo-1588776814546-1eee4da2d4d1?w=1920&q=80&fit=crop&crop=center"
        alt="Zahnarztpraxis Wagner Hamburg — modernste digitale Zahnmedizin"
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-video__gradient"></div>
    </div>
    <div class="hero-video__inner anim-fade-up">
      <div class="hero-video__play" aria-label="Praxis-Video ansehen">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      </div>
      <div class="hero-video__badge">
        <span class="hero-video__badge-dot"></span>
        Hamburg-Eppendorf · Digitale Implantologie · 3D-Diagnostik
      </div>
      <h1 class="hero-video__title">Moderne Implantologie.<br /><em>Dauerhaft schön.</em></h1>
      <p class="hero-video__sub">{prospect.heroSubtitle}</p>
      <div class="hero-video__ctas">
        <a href="#kontakt" class="hero-video__btn-primary">Digitale Beratung starten</a>
        <a href="#kontakt" class="hero-video__btn-secondary">3D-Scan vereinbaren</a>
      </div>
    </div>
    <div class="hero-video__stats">
      {prospect.stats?.map(s => (
        <div class="hero-video__stat">
          <div class="hero-video__stat-val">{s.value}</div>
          <div class="hero-video__stat-lbl">{s.label}</div>
        </div>
      ))}
    </div>
  </header>

  <section class="tech-bar">
    <div class="tech-bar__inner">
      <div class="tech-bar__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>
        <span>3D-Volumentomographie</span>
      </div>
      <div class="tech-bar__divider"></div>
      <div class="tech-bar__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        <span>Digital geplant & gesteuert</span>
      </div>
      <div class="tech-bar__divider"></div>
      <div class="tech-bar__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Zertifizierte Qualität</span>
      </div>
      <div class="tech-bar__divider"></div>
      <div class="tech-bar__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>5-Sterne-Bewertungen</span>
      </div>
    </div>
  </section>

  <PreviewTreatmentSpectrum
    title="Digitale Zahnmedizin auf höchstem Niveau"
    subtitle="Vom 3D-Scan über das digitale Implantat bis zur unsichtbaren Zahnkorrektur — die Praxis der Zukunft. Heute in Hamburg."
    treatments={treatments}
  />

  <PreviewBeforeAfter
    title="Digitale Präzision — sichtbare Ergebnisse"
    subtitle="Sehen Sie selbst, was moderne Technologie leistet. Schieben Sie den Regler und erleben Sie die Transformation."
    items={beforeAfterItems}
  />

  <PreviewSmileCheck
    title="Smile-Check: Ihr digitales Lächeln"
    subtitle="3 Fragen, 3 Minuten, 1 persönliche Empfehlung — kostenlos und unverbindlich."
    steps={[
      {
        question: 'Welche Behandlung interessiert Sie?',
        options: [
          { label: 'Implantat — dauerhafter Zahnersatz', value: 'implantat' },
          { label: 'Invisalign — unsichtbare Zahnkorrektur', value: 'aligner' },
          { label: 'Keramik-Restauration am selben Tag', value: 'cadcam' },
          { label: 'Digitale Diagnostik & Check-Up', value: 'diagnostik' },
        ],
      },
      {
        question: 'Wie wichtig ist Ihnen digitale Präzision?',
        options: [
          { label: 'Sehr — ich will das beste Ergebnis', value: 'high' },
          { label: 'Wichtig — aber Preis-Leistung muss stimmen', value: 'medium' },
          { label: 'Hauptsache das Ergebnis stimmt', value: 'result' },
        ],
      },
      {
        question: 'Wann möchten Sie starten?',
        options: [
          { label: 'So schnell wie möglich', value: 'urgent' },
          { label: 'In den nächsten 1-3 Monaten', value: 'soon' },
          { label: 'Erst mal informieren', value: 'info' },
        ],
      },
    ]}
    resultCtaText="Digitale Beratung vereinbaren"
    resultCtaHref="#kontakt"
  />

  <PreviewTestimonials
    title="Hamburg vertraut Wagner"
    subtitle="Patienten aus ganz Hamburg schätzen die Kombination aus digitaler Präzision und persönlicher Betreuung."
    testimonials={[
      { text: 'Die 3D-Planung hat mich sofort überzeugt. Ich sah vor der Behandlung exakt, wie mein Implantat aussehen würde. Das Ergebnis ist präzise und absolut natürlich — ich würde sofort wieder kommen.', author: 'Torsten K.', role: 'Unternehmer, Hamburg', rating: 5 },
      { text: 'Meine Invisalign-Behandlung wurde komplett digital verwaltet. App, 3D-Tracking, digitale Abformung — kein Abdruck, kein Aufwand. Das Ergebnis nach 14 Monaten ist perfekt. Beste Entscheidung.', author: 'Nina B.', role: 'Marketing-Managerin, Hamburg', rating: 5 },
      { text: 'Kurze Wartezeiten, modernste Technik, freundliches Team. Das CAD/CAM-Implantat war am selben Tag fertig. Ich hatte Angst vor der Behandlung — es war schmerzfrei und in 90 Minuten erledigt.', author: 'Ralf M.', role: 'Patient seit 2022, Hamburg-Eppendorf', rating: 5 },
    ]}
  />

  <section class="estimator" id="kalkulator">
    <div class="estimator__inner">
      <div class="estimator__header">
        <div class="estimator__badge">Behandlungskosten</div>
        <h2 class="estimator__title">Was kostet <em>Ihre Behandlung?</em></h2>
        <p class="estimator__sub">Erste unverbindliche Kostenschätzung für Ihre Wunschbehandlung — in Sekunden.</p>
      </div>
      <div class="estimator__form">
        <div class="estimator__field">
          <label class="estimator__label">Art der Behandlung</label>
          <div class="estimator__options" data-field="type">
            <button class="estimator__option is-active" data-value="implantate" type="button">Implantate</button>
            <button class="estimator__option" data-value="bleaching" type="button">Bleaching</button>
            <button class="estimator__option" data-value="veneers" type="button">Veneers</button>
          </div>
        </div>
        <div class="estimator__field">
          <label class="estimator__label" id="unit-label">Anzahl Zähne / Kiefer</label>
          <div class="estimator__slider-wrap">
            <input type="range" min="1" max="8" value="2" class="estimator__slider" id="unit-slider" aria-labelledby="unit-label" />
            <span class="estimator__slider-val" id="unit-val" aria-live="polite">2 Zähne</span>
          </div>
        </div>
        <div class="estimator__result">
          <div class="estimator__result-label">Geschätzte Kosten</div>
          <div class="estimator__result-val" id="estimate-val" aria-live="polite">ca. 3.000 — 6.000 €</div>
          <div class="estimator__result-note">Unverbindliche Schätzung. Genaue Kosten nach 3D-Diagnostik und individuellem Behandlungsplan.</div>
          <a href="#kontakt" class="estimator__result-cta">Digitale Beratung vereinbaren</a>
        </div>
      </div>
    </div>
  </section>

  <PreviewCTA
    title="Bereit für die Zahnmedizin der Zukunft?"
    subtitle="Starten Sie Ihre digitale Beratung bei Zahnarztpraxis Wagner in Hamburg-Eppendorf. 3D-Scan und Diagnose — präzise, modern, auf dem neuesten Stand der Technik."
    badge="Digitale Beratung"
    buttonText="3D-Scan vereinbaren"
    buttonLink="#kontakt"
    phone="+49 40 5678900"
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    address="Eppendorfer Baum 18, 20249 Hamburg-Eppendorf"
    year={2025}
  />
</PreviewLayout>

<style is:global>
  :root {
    --accent: #7C3AED;
    --accent-hover: #6D28D9;
  }
</style>

<style>
  html { scroll-behavior: smooth; }
  .anim-fade-up { animation: fadeUp 0.8s ease-out both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  .anim-on-scroll { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .anim-on-scroll.is-visible { opacity: 1; transform: translateY(0); }

  /* VIDEO HERO */
  .hero-video { position: relative; min-height: 85vh; max-height: 720px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
  .hero-video__bg { position: absolute; inset: 0; z-index: 0; }
  .hero-video__bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; filter: saturate(0.7); }
  .hero-video__gradient { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(60,10,120,0.88) 0%, rgba(30,5,60,0.75) 40%, rgba(10,5,20,0.6) 100%); }
  .hero-video__play { position: absolute; top: 50%; right: 10%; transform: translateY(-50%); width: 72px; height: 72px; border-radius: 50%; background: rgba(124,58,237,0.25); border: 2px solid rgba(167,139,250,0.5); display: flex; align-items: center; justify-content: center; color: #fff; cursor: pointer; transition: background 0.3s, transform 0.3s; backdrop-filter: blur(4px); z-index: 2; }
  .hero-video__play:hover { background: rgba(124,58,237,0.5); transform: translateY(-50%) scale(1.08); }
  .hero-video__inner { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 48px 48px; width: 100%; }
  .hero-video__badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(167,139,250,0.15); backdrop-filter: blur(8px); border: 1px solid rgba(167,139,250,0.3); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: rgba(255,255,255,0.92); margin-bottom: 20px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }
  .hero-video__badge-dot { width: 7px; height: 7px; background: #A78BFA; border-radius: 50%; animation: pulseV 2s ease-in-out infinite; }
  @keyframes pulseV { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.75); } }
  .hero-video__title { font-family: var(--font-heading); font-size: clamp(2.6rem, 5vw, 4rem); font-weight: 800; line-height: 1.07; letter-spacing: -0.03em; color: #fff; margin-bottom: 20px; }
  .hero-video__title em { color: #A78BFA; font-style: normal; }
  .hero-video__sub { color: rgba(255,255,255,0.78); font-size: 1.05rem; line-height: 1.7; max-width: 560px; margin-bottom: 32px; }
  .hero-video__ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-video__btn-primary { background: #7C3AED; color: #fff; padding: 14px 28px; border-radius: 10px; font-size: 0.95rem; font-weight: 600; font-family: var(--font-body); transition: background 0.2s, transform 0.2s; text-decoration: none; }
  .hero-video__btn-primary:hover { background: #6D28D9; transform: translateY(-2px); }
  .hero-video__btn-secondary { border: 1px solid rgba(167,139,250,0.4); color: rgba(255,255,255,0.9); padding: 14px 28px; border-radius: 10px; font-size: 0.95rem; font-weight: 500; font-family: var(--font-body); transition: border-color 0.2s, background 0.2s; text-decoration: none; backdrop-filter: blur(4px); }
  .hero-video__btn-secondary:hover { border-color: rgba(167,139,250,0.7); background: rgba(124,58,237,0.15); }
  .hero-video__stats { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255,255,255,0.08); border-top: 1px solid rgba(255,255,255,0.1); }
  .hero-video__stat { background: rgba(30,5,60,0.75); backdrop-filter: blur(8px); padding: 22px 16px; text-align: center; }
  .hero-video__stat-val { font-family: var(--font-heading); font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 800; color: #A78BFA; letter-spacing: -0.02em; line-height: 1; }
  .hero-video__stat-lbl { font-size: 0.72rem; color: rgba(255,255,255,0.55); margin-top: 6px; }

  /* TECH BAR */
  .tech-bar { border-bottom: 1px solid var(--border); background: var(--bg-el); }
  .tech-bar__inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: center; gap: 32px; padding: 16px 48px; flex-wrap: wrap; }
  .tech-bar__item { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; font-weight: 500; color: var(--muted); white-space: nowrap; }
  .tech-bar__item svg { color: var(--accent); flex-shrink: 0; }
  .tech-bar__divider { width: 1px; height: 18px; background: var(--border); }

  /* ESTIMATOR */
  .estimator { padding: 80px 48px; max-width: 1200px; margin: 0 auto; }
  .estimator__header { margin-bottom: 40px; }
  .estimator__badge { display: inline-flex; background: color-mix(in srgb, var(--accent) 10%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: var(--accent); margin-bottom: 16px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }
  .estimator__title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 14px; color: var(--text); }
  .estimator__title em { color: var(--accent); font-style: normal; }
  .estimator__sub { color: var(--muted); font-size: 1rem; line-height: 1.7; }
  .estimator__form { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 40px; }
  .estimator__field { margin-bottom: 28px; }
  .estimator__label { display: block; font-family: var(--font-heading); font-size: 0.85rem; font-weight: 700; color: var(--text); margin-bottom: 12px; }
  .estimator__options { display: flex; gap: 10px; flex-wrap: wrap; }
  .estimator__option { padding: 10px 20px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); color: var(--muted); font-size: 0.85rem; font-weight: 500; font-family: var(--font-body); cursor: pointer; transition: all 0.2s ease; }
  .estimator__option:hover { border-color: var(--accent); color: var(--text); }
  .estimator__option.is-active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .estimator__slider-wrap { display: flex; align-items: center; gap: 16px; }
  .estimator__slider { flex: 1; -webkit-appearance: none; height: 6px; border-radius: 3px; background: var(--border); outline: none; }
  .estimator__slider::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); cursor: pointer; border: 3px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
  .estimator__slider-val { font-family: var(--font-heading); font-size: 1rem; font-weight: 700; color: var(--text); min-width: 80px; text-align: right; }
  .estimator__result { margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--border); text-align: center; }
  .estimator__result-label { font-size: 0.82rem; color: var(--muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }
  .estimator__result-val { font-family: var(--font-heading); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; color: var(--accent); margin-bottom: 8px; transition: all 0.3s ease; }
  .estimator__result-note { font-size: 0.78rem; color: var(--dim); margin-bottom: 20px; }
  .estimator__result-cta { display: inline-block; background: var(--accent); color: #fff; padding: 14px 28px; border-radius: 10px; font-size: 0.95rem; font-weight: 600; font-family: var(--font-body); transition: background 0.2s, transform 0.2s; text-decoration: none; }
  .estimator__result-cta:hover { background: var(--accent-hover); transform: translateY(-2px); }

  @media (max-width: 768px) {
    .hero-video { min-height: 80vh; }
    .hero-video__inner { padding: 0 24px 32px; }
    .hero-video__stats { grid-template-columns: repeat(2, 1fr); }
    .hero-video__ctas { flex-direction: column; }
    .hero-video__play { display: none; }
    .tech-bar__inner { gap: 16px; padding: 14px 24px; }
    .tech-bar__divider { display: none; }
    .estimator { padding: 60px 24px; }
    .estimator__form { padding: 24px; }
    .estimator__options { flex-direction: column; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.anim-on-scroll').forEach(el => observer.observe(el));

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      const href = (anchor as HTMLAnchorElement).getAttribute('href');
      if (!href) return;
      const target = document.querySelector(href);
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    });
  });

  const typeButtons = document.querySelectorAll('.estimator__option');
  const slider = document.getElementById('unit-slider') as HTMLInputElement;
  const unitVal = document.getElementById('unit-val');
  const unitLabel = document.getElementById('unit-label');
  const estimateVal = document.getElementById('estimate-val');
  const rates: Record<string, [number, number]> = { implantate: [1500, 3000], bleaching: [300, 600], veneers: [400, 900] };
  const isFlatRate: Record<string, boolean> = { bleaching: true };
  let selectedType = 'implantate';
  function updateEstimate() {
    if (!slider || !unitVal || !estimateVal) return;
    const units = parseInt(slider.value);
    const isFlat = isFlatRate[selectedType];
    if (isFlat) { unitVal.textContent = units <= 1 ? '1 Kiefer' : '2 Kiefer'; if (unitLabel) unitLabel.textContent = 'Anzahl Kiefer'; }
    else { unitVal.textContent = units + (units === 1 ? ' Zahn' : ' Zähne'); if (unitLabel) unitLabel.textContent = 'Anzahl Zähne'; }
    const [lo, hi] = rates[selectedType] || [1500, 3000];
    const count = isFlat ? Math.min(units, 2) : units;
    estimateVal.textContent = `ca. ${(lo * count).toLocaleString('de-DE')} — ${(hi * count).toLocaleString('de-DE')} €`;
  }
  typeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      typeButtons.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      selectedType = (btn as HTMLElement).dataset.value || 'implantate';
      if (slider) { slider.max = isFlatRate[selectedType] ? '2' : '8'; slider.value = isFlatRate[selectedType] ? '1' : '2'; }
      updateEstimate();
    });
  });
  if (slider) { slider.addEventListener('input', updateEstimate); updateEstimate(); }
</script>
