---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztModernProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztDoctorQuote from '../../templates/sections/zahnarzt/ZahnarztDoctorQuote.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztTeam from '../../templates/sections/zahnarzt/ZahnarztTeam.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Dr. Klein Zahnmedizin',
  tagline: 'Moderne Zahnmedizin München',
  location: 'München',
  email: 'info@dr-klein-zahnarzt.de',
  phone: '+49 89 1234567',
  heroTitle: 'Ihr Lächeln. <em>Unsere Expertise.</em>',
  heroSubtitle: 'Seit über 15 Jahren steht Dr. Klein für moderne Zahnmedizin in München — von der Prophylaxe bis zur ästhetischen Zahnheilkunde. Angstfrei, schonend und auf dem neuesten Stand der Technik.',
  services: [
    { icon: 'star', title: 'Ästhetische Zahnheilkunde', description: 'Veneers, Bleaching und unsichtbare Korrekturen für Ihr perfektes Lächeln — schonend und individuell geplant.' },
    { icon: 'implant', title: 'Implantologie', description: 'Festsitzender Zahnersatz auf Implantaten — minimalinvasiv, präzise geplant und langlebig.' },
    { icon: 'heart', title: 'Prophylaxe & PZR', description: 'Professionelle Zahnreinigung und individuelle Vorsorge für langfristig gesunde Zähne.' },
    { icon: 'check', title: 'Parodontologie', description: 'Moderne Behandlung von Zahnfleischerkrankungen — schonend und nachhaltig wirksam.' },
    { icon: 'shield', title: 'Angstpatienten', description: 'Einfühlsame Behandlung mit Sedierung und schmerzfreien Verfahren für ein entspanntes Erlebnis.' },
    { icon: 'smile', title: 'Kinderzahnheilkunde', description: 'Spielerische Zahnmedizin für die Kleinsten — damit der Zahnarztbesuch Spass macht.' },
  ],
  stats: [
    { value: '15+', label: 'Jahre Erfahrung' },
    { value: '3.500+', label: 'Patienten betreut' },
    { value: '100%', label: 'Angstpatienten-Konzept' },
    { value: '6', label: 'Fachkräfte im Team' },
  ],
};
---

<PreviewLayout profile={zahnarztModernProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} ctaText="Termin vereinbaren" ctaHref="#kontakt" />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Moderne Zahnmedizin München"
    ctaPrimary={{ text: 'Kostenlose Erstberatung', href: '#kontakt' }}
    ctaSecondary={{ text: 'Smile-Check starten', href: '#leistungen' }}
    imageSrc="/preview-images/dr-klein/hero.jpg"
    imageAlt="Moderne Zahnarztpraxis Dr. Klein München"
    stats={prospect.stats}
  />

  <div class="zh-trust-bar" role="list" aria-label="Qualitätsmerkmale">
    <div class="zh-trust-bar__inner">
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Zertifizierte Implantologie</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <span>Seit 2008 in München</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span>Digitale Diagnostik</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        <span>4.9★ Google-Bewertung</span>
      </div>
    </div>
  </div>

  <ZahnarztDoctorQuote
    quote="Jeder Patient verdient eine Behandlung ohne Angst und ohne Zeitdruck. Wir nehmen uns die Zeit, die es braucht — für ein Ergebnis, das Sie ein Leben lang begleitet."
    author="Dr. Klein"
    title="Zahnarzt & Praxisinhaber, München"
    imageSrc="/preview-images/dr-klein/gallery-1.jpg"
    imageAlt="Dr. Klein — Zahnarzt München"
  />

  <ZahnarztServices
    title="Was können wir für Sie tun?"
    subtitle="Moderne Zahnmedizin für Ihre Gesundheit und Ihr Wohlbefinden."
    services={prospect.services}
  />

  <ZahnarztBeforeAfter
    title="Einblicke in unsere Arbeit"
    subtitle="Ausgewählte Beispiele unserer Behandlungen — jeder Fall ist individuell."
    cases={[
      { label: 'Veneers-Behandlung', beforeSrc: '/preview-images/dr-klein/gallery-2.jpg', afterSrc: '/preview-images/dr-klein/gallery-3.jpg' },
      { label: 'Bleaching-Ergebnis', beforeSrc: '/preview-images/dr-klein/gallery-3.jpg', afterSrc: '/preview-images/dr-klein/gallery-4.jpg' },
    ]}
    cta={{ text: 'Beratungstermin anfragen', href: '#kontakt' }}
  />

  <ZahnarztTimeline
    title="In vier Schritten zu gesunden Zähnen"
    subtitle="Transparent, planbar und immer im Dialog mit Ihnen."
    steps={[
      { num: 1, title: 'Beratung', desc: 'Persönliches Gespräch und digitale Diagnostik. Wir nehmen uns Zeit für Ihre Wünsche und Sorgen.', icon: 'chat' },
      { num: 2, title: 'Diagnose', desc: '3D-Scan und detaillierte Behandlungsplanung. Sie verstehen jeden Schritt, bevor wir beginnen.', icon: 'search' },
      { num: 3, title: 'Behandlung', desc: 'Schonende Durchführung mit modernster Technik — schmerzarm und präzise.', icon: 'tooth' },
      { num: 4, title: 'Nachsorge', desc: 'Regelmässige Kontrollen und professionelle Prophylaxe für langfristigen Erfolg.', icon: 'smile' },
    ]}
  />

  <ZahnarztTeam
    name="Dr. Klein"
    title="Zahnarzt & Praxisinhaber, München"
    bio="Seit über 15 Jahren ist es mein Anspruch, Zahnmedizin auf höchstem Niveau mit menschlicher Wärme zu verbinden. Ob Angstpatient oder ästhetischer Eingriff — bei uns stehen Sie als Mensch im Mittelpunkt, nicht als Behandlungsfall."
    imageSrc="/preview-images/dr-klein/gallery-4.jpg"
    qualifications={[
      'Approbierter Zahnarzt (LMU München)',
      'Zertifizierte Implantologie',
      'Fortbildung Ästhetische Zahnheilkunde',
      'Angstpatienten-Konzept seit 2008',
      'Digitale Diagnostik & 3D-Planung',
    ]}
    cta={{ text: 'Termin bei Dr. Klein vereinbaren', href: '#kontakt' }}
  />

  <PreviewTestimonials
    title="Das sagen unsere Patienten"
    subtitle="Echte Erfahrungen unserer Patienten — Vertrauen, das gewachsen ist."
    testimonials={[
      { text: 'Ich hatte jahrelang Angst vorm Zahnarzt. Bei Dr. Klein habe ich mich zum ersten Mal wirklich sicher gefühlt. Absolut empfehlenswert!', author: 'Sandra Meier', role: 'Patientin seit 2019', rating: 5 },
      { text: 'Meine Veneers sehen fantastisch aus — natürlich und perfekt. Das Team hat sich wirklich Zeit genommen.', author: 'Michael Krause', role: 'Ästhetische Behandlung', rating: 5 },
      { text: 'Die beste Zahnreinigung, die ich je hatte. Professionell, gründlich und dabei total angenehm.', author: 'Julia Hoffmann', role: 'Stammkundin seit 2015', rating: 5 },
    ]}
  />

  <ZahnarztCostCalc />

  <PreviewCTA
    title="Bereit für Ihr strahlendes Lächeln?"
    subtitle="Vereinbaren Sie einen Termin — wir beraten Sie persönlich, ehrlich und unverbindlich. Ihre Zahngesundheit liegt uns am Herzen."
    badge="Jetzt anfragen"
    buttonText="Termin vereinbaren"
    buttonLink="#kontakt"
    phone="+49 89 1234567"
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    address="München"
    year={2025}
  />
</PreviewLayout>

<style>
  .zh-trust-bar {
    background: linear-gradient(
      to bottom,
      var(--bg-deep, #0d1f1c),
      color-mix(in srgb, var(--accent, #3B82F6) 4%, var(--bg-deep, #0d1f1c))
    );
    border-bottom: 1px solid rgba(59, 130, 246, 0.15);
  }

  .zh-trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 20px 48px;
    flex-wrap: wrap;
  }

  .zh-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted, #8aafa5);
    white-space: nowrap;
  }

  .zh-trust-bar__item svg {
    color: var(--accent, #3B82F6);
    flex-shrink: 0;
  }

  .zh-trust-bar__divider {
    width: 1px;
    height: 24px;
    background: rgba(59, 130, 246, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .zh-trust-bar__inner {
      gap: 16px;
      padding: 16px 24px;
    }

    .zh-trust-bar__divider {
      display: none;
    }

    .zh-trust-bar__item {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .zh-trust-bar__inner {
      justify-content: flex-start;
      gap: 12px;
    }

    .zh-trust-bar__item {
      flex: 1 1 calc(50% - 6px);
      min-width: 0;
      white-space: normal;
    }
  }
</style>
