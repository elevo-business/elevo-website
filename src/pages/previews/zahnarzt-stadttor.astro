---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztStadttorProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxen im Stadttor',
  tagline: 'Digitale Praxis im Medienhafen',
  location: 'Düsseldorf Medienhafen',
  email: 'telefonie@za-stadttor.de',
  phone: '0211 38596940',
  heroTitle: 'Digitale Patientenbetreuung. Moderne Zahnmedizin.',
  heroSubtitle: 'Wir denken Zahnarztpraxis neu: Online-Buchung, digitale Formulare und ein Patient Portal für Ihre Unterlagen – transparent, schnell und persönlich. Mo–Fr bis 22:00 Uhr.',
  services: [
    { icon: 'grid', title: 'Online-Buchung & Formulare', description: 'Termin buchen, Anamnesebogen ausfüllen, Dokumente hochladen – alles digital, bevor Sie in die Praxis kommen.' },
    { icon: 'shield', title: 'Patient Portal', description: 'Ihr persönlicher Bereich: Befunde, Röntgenbilder, Behandlungspläne und Rechnungen – sicher online abrufbar.' },
    { icon: 'check', title: 'Prophylaxe & Vorsorge', description: 'Individuelle Prophylaxe-Programme mit digitaler Erinnerungsfunktion – nie wieder einen Vorsorge-Termin vergessen.' },
    { icon: 'smile', title: 'Ästhetische Zahnmedizin', description: 'Bleaching, Veneers und moderne Kieferorthopädie – digitale Planung für vorhersagbare Ergebnisse.' },
    { icon: 'tooth', title: 'Implantologie', description: 'Schonende Implantate mit digitaler Planung – präzise gesetzt, langfristig stabil.' },
    { icon: 'star', title: 'Lange Öffnungszeiten', description: 'Mo–Fr bis 22 Uhr, Sa bis 19 Uhr – Düsseldorfs flexibelste Zahnarztpraxis.' },
  ],
  stats: [
    { value: '4.9★', label: 'Patientenbewertung' },
    { value: '3.200+', label: 'Aktive Patienten' },
    { value: '7:30–22:00', label: 'Öffnungszeiten Mo–Fr' },
  ],
  testimonials: [
    { text: 'Das Online-Portal ist fantastisch. Ich kann jederzeit meine Befunde einsehen und Termine buchen – einfach modern.', author: 'Jana K.', role: 'Patientin, Düsseldorf-Stadtmitte' },
    { text: 'Endlich eine Praxis, die meine Zeit respektiert. Online anmelden, Formulare ausfüllen – kein Stress im Wartezimmer.', author: 'Martin G.', role: 'Patient, Düsseldorf' },
    { text: 'Die digitalen Erinnerungen für Vorsorge-Termine sind super! Ich habe seit Jahren keinen Termin mehr vergessen.', author: 'Petra H.', role: 'Patientin, Düsseldorf' },
  ],
};
---

<PreviewLayout profile={zahnarztStadttorProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    logo="https://za-stadttor.de/wp-content/uploads/2019/06/Zahnaerzte-Stadttor-horiz.png"
    ctaText="Termin buchen"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Digitale Zahnarztpraxis im Düsseldorfer Medienhafen"
    ctaPrimary={{ text: 'Jetzt Termin buchen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Digital-Features entdecken', href: '#leistungen' }}
    imageSrc="https://za-stadttor.de/wp-content/uploads/2019/06/iStock-1394844054.jpg"
    imageAlt="Zahnarztpraxen im Stadttor – Digitale Praxis Düsseldorf Medienhafen"
    stats={prospect.stats}
  />

  <div class="zh-trust-bar" role="list" aria-label="Qualitätsmerkmale">
    <div class="zh-trust-bar__inner">
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Patient Portal – Befunde online</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Papierlose Anamnese</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
        </svg>
        <span>Mo–Fr bis 22:00 Uhr</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span>4.9★ auf Google</span>
      </div>
    </div>
  </div>

  <ZahnarztServices
    title="Unser Behandlungsspektrum"
    subtitle="Digital, modern und persönlich – Zahnmedizin im Düsseldorfer Medienhafen."
    services={prospect.services}
  />

  <ZahnarztTimeline
    title="Ihr digitaler Praxisbesuch – in 4 Schritten"
    subtitle="Moderner geht nicht: Von der Online-Buchung bis zum digitalen Follow-up."
    steps={[
      { num: 1, title: 'Online buchen – in 60 Sekunden', desc: 'Termin reservieren, Anamnese digital ausfüllen – alles vor dem Besuch erledigt.', icon: 'search' },
      { num: 2, title: 'Papierloser Ankunfts-Check-in', desc: 'Ihre Daten sind bereits digital hinterlegt. Einfach ankommen – kein Ausfüllen im Wartezimmer.', icon: 'calendar' },
      { num: 3, title: 'Behandlung & digitale Doku', desc: 'Modernste Methoden, sofortige Dokumentation – Befunde in Ihrem Patient Portal.', icon: 'tooth' },
      { num: 4, title: 'Follow-up & Recall-Erinnerung', desc: 'Automatische Erinnerungen und Online-Buchung für den nächsten Termin.', icon: 'check' },
    ]}
  />

  <PreviewTestimonials
    title="Was Patienten über uns sagen"
    testimonials={prospect.testimonials}
  />

  <ZahnarztCostCalc />

  <PreviewCTA
    title="Termin buchen – auch noch um 21 Uhr"
    subtitle="Moderne Zahnmedizin im Medienhafen: Online buchen, digital ankommen, pünktlich behandelt werden."
    ctaText="Termin buchen"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    logo="https://za-stadttor.de/wp-content/uploads/2019/06/Zahnaerzte-Stadttor-horiz.png"
    email={prospect.email}
    phone={prospect.phone}
    location="Stadttor 1, 40219 Düsseldorf"
    year={2026}
  />
</PreviewLayout>

<style>
  .zh-trust-bar {
    background: linear-gradient(
      to bottom,
      var(--bg-deep, #0d1f1c),
      color-mix(in srgb, var(--accent, #0E8A7B) 4%, var(--bg-deep, #0d1f1c))
    );
    border-bottom: 1px solid rgba(14, 138, 123, 0.15);
  }

  .zh-trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 20px 48px;
    flex-wrap: wrap;
  }

  .zh-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted, #8aafa5);
    white-space: nowrap;
  }

  .zh-trust-bar__item svg {
    color: var(--accent, #0E8A7B);
    flex-shrink: 0;
  }

  .zh-trust-bar__divider {
    width: 1px;
    height: 24px;
    background: rgba(14, 138, 123, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .zh-trust-bar__inner {
      gap: 16px;
      padding: 16px 24px;
    }

    .zh-trust-bar__divider {
      display: none;
    }

    .zh-trust-bar__item {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .zh-trust-bar__inner {
      justify-content: flex-start;
      gap: 12px;
    }

    .zh-trust-bar__item {
      flex: 1 1 calc(50% - 6px);
      min-width: 0;
      white-space: normal;
    }
  }
</style>
