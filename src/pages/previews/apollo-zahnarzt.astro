---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { apolloniaProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Apollonia Praxisklinik',
  tagline: '23 Zahnärzte – Düsseldorf',
  location: 'Düsseldorf',
  email: 'info@apollonia-praxisklinik.de',
  phone: '0211 2109 5000',
  heroTitle: 'Zahnmedizin mit 23 Spezialisten unter einem Dach.',
  heroSubtitle: '23 erfahrene Zahnärzte, über 160 Mitarbeiter und eine 4.9★-Bewertung auf Google: Apollonia steht für Qualität, die man spürt. Alle Fachrichtungen – keine Überweisung nötig.',
  services: [
    { icon: 'tooth', title: 'Online-Terminbuchung', description: 'Ihren Wunschtermin bequem online buchen – rund um die Uhr, ohne Wartezeit am Telefon.' },
    { icon: 'star', title: 'Professionelle Zahnreinigung', description: 'Sanfte und gründliche Prophylaxe für ein strahlendes Lächeln – präventiv und nachhaltig.' },
    { icon: 'smile', title: 'Ästhetische Zahnmedizin', description: 'Bleaching, Veneers und Zahnkorrekturen für Ihr perfektes Lächeln – individuell und schonend.' },
    { icon: 'shield', title: 'Implantologie & Prothetik', description: 'Hochwertige Implantate und Zahnersatz für dauerhaften Komfort und natürliche Ästhetik.' },
    { icon: 'check', title: 'Alle Fachrichtungen', description: 'Von Kieferorthopädie bis Oralchirurgie – alle Spezialisten unter einem Dach, ohne Überweisung.' },
    { icon: 'grid', title: 'Digitale Diagnostik', description: '3D-Röntgen, digitale Abdrücke und CAD/CAM-Technik für präzise und schonende Behandlungen.' },
  ],
  stats: [
    { value: '4.9★', label: 'Google Bewertung' },
    { value: '23', label: 'Zahnärzte im Team' },
    { value: 'Online', label: 'Terminbuchung 24/7' },
  ],
  testimonials: [
    { text: 'Endlich eine Praxis, bei der ich mich wohl fühle! Das Team ist super freundlich und die Online-Buchung ist super einfach.', author: 'Maria S.', role: 'Patientin seit 3 Jahren' },
    { text: 'Die Behandlung war schmerzlos und das Ergebnis perfekt. Mit 23 Ärzten findet man immer schnell einen Termin.', author: 'Klaus B.', role: 'Patient, Düsseldorf' },
    { text: 'Professionell, modern und trotzdem persönlich. Die Online-Terminbuchung ist eine echte Erleichterung.', author: 'Sabine R.', role: 'Patientin, Düsseldorf' },
  ],
};
---

<PreviewLayout profile={apolloniaProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    logo="https://www.apollonia-praxisklinik.de/wp-content/uploads/2025/08/logo_apollonia.svg"
    ctaText="Termin buchen"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Zahnarztpraxis Düsseldorf – 23 Ärzte, über 4.9★"
    ctaPrimary={{ text: 'Jetzt Termin buchen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Alle Leistungen entdecken', href: '#leistungen' }}
    imageSrc="https://www.apollonia-praxisklinik.de/wp-content/uploads/2025/09/Apollonia_Praxisklinik_Zahnarzt_Duesseldorf.jpg"
    imageAlt="Apollonia Praxisklinik – Zahnarztpraxis Düsseldorf"
    stats={prospect.stats}
  />

  <div class="zh-trust-bar" role="list" aria-label="Qualitätsmerkmale">
    <div class="zh-trust-bar__inner">
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span>23 Zahnärzte unter einem Dach</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span>4.9★ auf Google</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
        </svg>
        <span>Online-Buchung 24/7</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Alle Fachrichtungen</span>
      </div>
    </div>
  </div>

  <ZahnarztServices
    title="Unser Behandlungsspektrum"
    subtitle="23 Spezialisten, alle Fachrichtungen – Apollonia Praxisklinik Düsseldorf."
    services={prospect.services}
  />

  <ZahnarztTimeline
    title="Ihr Weg zu uns – unkompliziert & digital"
    subtitle="In 4 einfachen Schritten zu Ihrem Termin bei Apollonia."
    steps={[
      { num: 1, title: 'Online-Termin buchen', desc: 'In 2 Minuten Ihren Wunschtermin buchen – 23 Zahnärzte, alle Fachrichtungen verfügbar.', icon: 'search' },
      { num: 2, title: 'Untersuchung & Diagnostik', desc: 'Gründliche Erstuntersuchung mit digitaler Röntgentechnik – präzise Diagnosen ohne Wartezeit.', icon: 'calendar' },
      { num: 3, title: 'Schonende Behandlung', desc: 'Erfahrene Spezialisten, modernste Technik – sicher, schonend und effizient.', icon: 'tooth' },
      { num: 4, title: 'Regelmäßige Prophylaxe', desc: 'Individuelle Recall-Programme und digitale Erinnerungen halten Ihre Zähne dauerhaft gesund.', icon: 'check' },
    ]}
  />

  <PreviewTestimonials
    title="Was Patienten über uns sagen"
    testimonials={prospect.testimonials}
  />

  <ZahnarztCostCalc />

  <PreviewCTA
    title="Ihr Termin bei 23 Spezialisten"
    subtitle="Online buchen, kein Telefonwarten, alle Fachrichtungen – Apollonia Praxisklinik Düsseldorf."
    ctaText="Termin buchen"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    logo="https://www.apollonia-praxisklinik.de/wp-content/uploads/2025/08/logo_apollonia.svg"
    email={prospect.email}
    phone={prospect.phone}
    location="Rostocker Straße 18, 40595 Düsseldorf"
    year={2026}
  />
</PreviewLayout>

<style>
  .zh-trust-bar {
    background: linear-gradient(
      to bottom,
      var(--bg-deep, #0d1f1c),
      color-mix(in srgb, var(--accent, #0E8A7B) 4%, var(--bg-deep, #0d1f1c))
    );
    border-bottom: 1px solid rgba(14, 138, 123, 0.15);
  }

  .zh-trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 20px 48px;
    flex-wrap: wrap;
  }

  .zh-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted, #8aafa5);
    white-space: nowrap;
  }

  .zh-trust-bar__item svg {
    color: var(--accent, #0E8A7B);
    flex-shrink: 0;
  }

  .zh-trust-bar__divider {
    width: 1px;
    height: 24px;
    background: rgba(14, 138, 123, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .zh-trust-bar__inner {
      gap: 16px;
      padding: 16px 24px;
    }

    .zh-trust-bar__divider {
      display: none;
    }

    .zh-trust-bar__item {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .zh-trust-bar__inner {
      justify-content: flex-start;
      gap: 12px;
    }

    .zh-trust-bar__item {
      flex: 1 1 calc(50% - 6px);
      min-width: 0;
      white-space: normal;
    }
  }
</style>
