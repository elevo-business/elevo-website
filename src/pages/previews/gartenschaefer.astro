---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { galabauProfile } from '../../templates/config/galabau';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewHero from '../../templates/sections/PreviewHero.astro';
import PreviewServices from '../../templates/sections/PreviewServices.astro';
import PreviewStats from '../../templates/sections/PreviewStats.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewGallery from '../../templates/sections/PreviewGallery.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Gartenschäfer',
  tagline: 'Axel Schäfer · Garten- und Landschaftsbau Bad Soden',
  location: 'Bad Soden am Taunus',
  email: 'info@gartenschaefer.de',
  heroTitle: 'Ihr Garten in Bad Soden. Gepflegt. Gestaltet. Geliebt.',
  heroSubtitle: 'Axel Schäfer und sein Team gestalten und pflegen Gärten im Taunus mit Leidenschaft und handwerklichem Können. Persönlich, zuverlässig und immer mit Blick fürs Detail.',
  services: [
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>', title: 'Gartengestaltung', description: 'Individuelle Gartenplanung und Neuanlage nach Ihren Wünschen — von der ersten Idee bis zur fertigen Grünoase.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>', title: 'Pflege & Schnitt', description: 'Regelmäßige Gartenpflege, Heckenschnitt und Baumpflege — damit Ihr Garten das ganze Jahr über schön bleibt.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>', title: 'Natursteinarbeiten', description: 'Hochwertige Terrassen, Wege und Mauern aus Naturstein — handwerklich präzise und dauerhaft schön.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>', title: 'Saisonbepflanzung', description: 'Frühling, Sommer, Herbst und Winter — saisonale Bepflanzung von Beeten, Kübeln und Eingangs­bereichen.' },
  ],
  stats: [
    { value: '15+', label: 'Jahre Erfahrung' },
    { value: '300+', label: 'Gärten' },
    { value: 'Taunus', label: 'Region' },
  ],
};
---

<PreviewLayout profile={galabauProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} ctaText="Beratung anfragen" ctaHref="#kontakt" />
  <PreviewHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Bad Soden · GaLaBau · Persönlicher Service"
    ctaButtons={[
      { text: 'Kostenloses Angebot', href: '#kontakt', variant: 'primary' },
      { text: 'Unsere Leistungen', href: '#leistungen', variant: 'outline' },
    ]}
    heroImage="/preview-images/gartenschaefer/hero.jpg"
    heroImageAlt="Naturnaher Garten mit Holzweg im Taunus"
    stats={prospect.stats}
  />
  <PreviewServices title="Unsere Leistungen" subtitle="Von der kreativen Gartengestaltung bis zur regelmäßigen Pflege — wir kümmern uns ganzjährig um Ihren grünen Rückzugsort." services={prospect.services} />
  <PreviewGallery
    title="Unsere Gärten"
    subtitle="Gartengestaltungen und Natursteinarbeiten im Taunus und Rhein-Main-Gebiet."
    images={[
      { src: '/preview-images/gartenschaefer/gallery-1.jpg', alt: 'Gepflegter Garten mit Natursteinmauer Bad Soden' },
      { src: '/preview-images/gartenschaefer/gallery-2.jpg', alt: 'Saisonale Bepflanzung Eingangsbereich' },
      { src: '/preview-images/gartenschaefer/gallery-3.jpg', alt: 'Terrasse mit Naturstein und Bepflanzung' },
      { src: '/preview-images/gartenschaefer/gallery-4.jpg', alt: 'Heckenschnitt und Gehölzpflege im Taunus' },
    ]}
  />
  <PreviewCTA title="Bereit für Ihren Traumgarten?" subtitle="Kontaktieren Sie Axel Schäfer für ein unverbindliches Beratungsgespräch. Wir kommen zu Ihnen nach Bad Soden und besichtigen Ihre Fläche kostenlos." badge="Jetzt anfragen" buttonText="Jetzt anfragen" buttonLink={`mailto:${prospect.email}`} />
  <PreviewFooter
    prospectName={prospect.name}
    tagline="Axel Schäfer — Garten- und Landschaftsbau in Bad Soden am Taunus und Umgebung. Persönlich, kompetent und mit Leidenschaft."
    email={prospect.email}
    year={2025}
    links={[
      { heading: 'Leistungen', links: [{ label: 'Gartengestaltung', href: '#leistungen' }, { label: 'Pflege & Schnitt', href: '#leistungen' }, { label: 'Natursteinarbeiten', href: '#leistungen' }, { label: 'Saisonbepflanzung', href: '#leistungen' }] },
      { heading: 'Kontakt', links: [{ label: 'Bad Soden am Taunus', href: '#' }, { label: 'info@gartenschaefer.de', href: 'mailto:info@gartenschaefer.de' }, { label: 'Impressum', href: '#' }, { label: 'Datenschutz', href: '#' }] },
    ]}
  />
</PreviewLayout>
