---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { galabauProfile } from '../../templates/config/galabau';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewHero from '../../templates/sections/PreviewHero.astro';
import PreviewServices from '../../templates/sections/PreviewServices.astro';
import PreviewStats from '../../templates/sections/PreviewStats.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewGallery from '../../templates/sections/PreviewGallery.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Michael Gehrke GaLaBau',
  tagline: 'Garten- und Landschaftsbau Seelze',
  location: 'Seelze bei Hannover',
  email: 'info@gehrke-galabau.de',
  heroTitle: 'Gärten in der Region Hannover. Michael Gehrke GaLaBau.',
  heroSubtitle: 'Als Familienbetrieb aus Seelze gestalten und pflegen wir Gärten in der Region Hannover mit handwerklicher Präzision und persönlichem Einsatz — nah, zuverlässig, leidenschaftlich.',
  services: [
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/></svg>', title: 'Gartenplanung', description: 'Gemeinsam entwickeln wir eine Gartenplanung, die zu Ihnen und Ihrem Grundstück passt — kreativ und umsetzbar.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>', title: 'Pflasterbau', description: 'Einfahrten, Terrassen und Wege in Natur- und Betonpflaster — handwerklich sauber und langlebig ausgeführt.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>', title: 'Bepflanzung', description: 'Fachgerechte Bepflanzung von Beeten und Flächen mit standortgerechten Pflanzen für langfristige Freude.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>', title: 'Gartenpflege', description: 'Regelmäßige Pflege, Schnitt und Instandhaltung Ihres Gartens — zuverlässig und nach Bedarf das ganze Jahr über.' },
  ],
  stats: [
    { value: '10+', label: 'Jahre Erfahrung' },
    { value: 'Seelze', label: '& Umgebung' },
    { value: 'Familien', label: 'betrieb' },
  ],
};
---

<PreviewLayout profile={galabauProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} logo="/client-logos/gehrke-galabau.svg" ctaText="Beratung anfragen" ctaHref="#kontakt" />
  <PreviewHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Seelze · GaLaBau · Region Hannover"
    ctaButtons={[
      { text: 'Kostenloses Angebot', href: '#kontakt', variant: 'primary' },
      { text: 'Unsere Leistungen', href: '#leistungen', variant: 'outline' },
    ]}
    heroImage="/preview-images/gehrke-galabau/hero.jpg"
    heroImageAlt="Familiärer Gartenbetrieb beim Anlegen einer Grünfläche"
    stats={prospect.stats}
  />
  <PreviewServices title="Unsere Leistungen" subtitle="Von der Gartenplanung bis zur laufenden Pflege — wir bieten alles aus einer Hand für Ihren Außenbereich in der Region Hannover." services={prospect.services} />
  <PreviewGallery
    title="Unsere Projekte"
    subtitle="Familiäre Gartenarbeit in Seelze und der Region Hannover — nah, persönlich und handwerklich präzise."
    images={[
      { src: '/preview-images/gehrke-galabau/gallery-1.jpg', alt: 'Gartenplanung und Neuanlage Seelze' },
      { src: '/preview-images/gehrke-galabau/gallery-2.jpg', alt: 'Bepflanzung mit standortgerechten Pflanzen' },
      { src: '/preview-images/gehrke-galabau/gallery-3.jpg', alt: 'Pflasterbau Terrasse Region Hannover' },
      { src: '/preview-images/gehrke-galabau/gallery-4.jpg', alt: 'Laufende Gartenpflege Familiengarten' },
    ]}
  />
  <PreviewCTA title="Ihr Garten in guten Händen." subtitle="Kontaktieren Sie Michael Gehrke für ein unverbindliches Beratungsgespräch in Seelze und Umgebung. Wir schauen uns Ihren Garten gerne kostenlos an." badge="Jetzt anfragen" buttonText="Jetzt anfragen" buttonLink={`mailto:${prospect.email}`} />
  <PreviewFooter
    prospectName={prospect.name}
    tagline="Familiärer Garten- und Landschaftsbau aus Seelze — persönlich, handwerklich und zuverlässig in der Region Hannover tätig."
    email={prospect.email}
    year={2025}
    links={[
      { heading: 'Leistungen', links: [{ label: 'Gartenplanung', href: '#leistungen' }, { label: 'Pflasterbau', href: '#leistungen' }, { label: 'Bepflanzung', href: '#leistungen' }, { label: 'Gartenpflege', href: '#leistungen' }] },
      { heading: 'Kontakt', links: [{ label: 'Seelze bei Hannover', href: '#' }, { label: 'info@gehrke-galabau.de', href: 'mailto:info@gehrke-galabau.de' }, { label: 'Impressum', href: '#' }, { label: 'Datenschutz', href: '#' }] },
    ]}
  />
</PreviewLayout>
