---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { galabauProfile } from '../../templates/config/galabau';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewHero from '../../templates/sections/PreviewHero.astro';
import PreviewServices from '../../templates/sections/PreviewServices.astro';
import PreviewStats from '../../templates/sections/PreviewStats.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Roland Müller GaLaBau',
  tagline: 'Garten- und Landschaftsbau Frankfurt',
  location: 'Frankfurt am Main',
  email: 'info@mueller-galabau.de',
  heroTitle: 'Grüne Oasen für Frankfurt seit zwei Jahrzehnten.',
  heroSubtitle: 'Roland Müller GaLaBau gestaltet seit über 20 Jahren Gärten, Parks und Außenanlagen im Rhein-Main-Gebiet. Bodenständig, kompetent und mit echtem Gespür für Natur.',
  services: [
    { icon: 'grid', title: 'Gartenplanung', description: 'Individuelle Gartenentwürfe — vom Naturgartenkonzept bis zum modernen Designgarten. Wir denken jeden Quadratmeter mit.' },
    { icon: 'layers', title: 'Pflasterbau', description: 'Einfahrten, Terrassen und Gartenwege in Naturstein, Beton oder Klinker — dauerhaft, sauber verlegt und optisch überzeugend.' },
    { icon: 'sun', title: 'Rasenpflege', description: 'Rasenanlage, Aerifizieren, Düngen und regelmäßige Pflege — damit Ihr Grün das ganze Jahr über brilliert.' },
    { icon: 'tree', title: 'Baumschnitt', description: 'Formschnitt, Kronenpflege und Fällarbeiten — fachgerecht, termintreu und mit Blick auf die langfristige Gesundheit Ihrer Gehölze.' },
    { icon: 'shield', title: 'Neuanlage & Umgestaltung', description: 'Ihr Garten soll ein neues Gesicht bekommen? Wir planen und realisieren Umgestaltungen jeder Größenordnung.' },
    { icon: 'activity', title: 'Laufende Gartenpflege', description: 'Monatliche oder saisonale Pflegeverträge für Privat- und Gewerbekunden — zuverlässig und diskret.' },
  ],
  stats: [
    { value: '20+', label: 'Jahre Erfahrung' },
    { value: '800+', label: 'Gärten' },
    { value: '100%', label: 'Regional' },
  ],
};
---

<PreviewLayout profile={galabauProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} logo="/client-logos/galabau-mueller.png" ctaText="Beratung anfragen" ctaHref="#kontakt" />
  <PreviewHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Frankfurt · GaLaBau · 20+ Jahre Erfahrung"
    ctaButtons={[
      { text: 'Kostenloses Angebot', href: '#kontakt', variant: 'primary' },
      { text: 'Unsere Projekte', href: '#galerie', variant: 'outline' },
    ]}
    heroImage="/preview-images/galabau-mueller/hero.jpg"
    heroImageAlt="Professionelle Gartengestaltung mit Natursteinwegen"
    stats={prospect.stats}
  />
  <PreviewServices title="Unsere Leistungen" subtitle="Von der ersten Skizze bis zur üppigen Bepflanzung — Roland Müller GaLaBau begleitet Ihr Projekt mit Erfahrung, Sorgfalt und Leidenschaft für das Grüne." services={prospect.services} />
  <PreviewCTA title="Ihr Garten in besten Händen?" subtitle="Wir kommen zu Ihnen, schauen uns Ihre Fläche an und erstellen Ihnen ein unverbindliches Angebot — kostenlos und ohne Druck." badge="Jetzt anfragen" buttonText="Jetzt anrufen" buttonLink="tel:+49" />
  <PreviewFooter
    prospectName={prospect.name}
    tagline="Garten- und Landschaftsbau im Rhein-Main-Gebiet seit über 20 Jahren."
    email={prospect.email}
    year={2025}
    links={[
      { heading: 'Leistungen', links: [{ label: 'Gartenplanung', href: '#leistungen' }, { label: 'Pflasterbau', href: '#leistungen' }, { label: 'Rasenpflege', href: '#leistungen' }, { label: 'Baumschnitt', href: '#leistungen' }] },
      { heading: 'Kontakt', links: [{ label: 'Frankfurt am Main', href: '#' }, { label: 'info@mueller-galabau.de', href: 'mailto:info@mueller-galabau.de' }, { label: 'Impressum', href: '#' }, { label: 'Datenschutz', href: '#' }] },
    ]}
  />
</PreviewLayout>
