---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { galabauProfile } from '../../templates/config/galabau';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Roland Müller GaLaBau',
  tagline: 'Garten- und Landschaftsbau Frankfurt',
  location: 'Frankfurt am Main',
  email: 'info@mueller-galabau.de',
  phone: '+49 69 987654',
  heroTitle: 'Grüne Oasen. <em>Seit über 20 Jahren.</em>',
  heroSubtitle: 'Roland Müller GaLaBau gestaltet seit über 20 Jahren Gärten, Parks und Außenanlagen im Rhein-Main-Gebiet. Bodenständig, kompetent und mit echtem Gespür für Natur.',
  services: [
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>', title: 'Gartenplanung', description: 'Individuelle Gartenentwürfe — vom Naturgartenkonzept bis zum modernen Designgarten. Wir denken jeden Quadratmeter mit.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>', title: 'Pflasterbau', description: 'Einfahrten, Terrassen und Gartenwege in Naturstein, Beton oder Klinker — dauerhaft, sauber verlegt und optisch überzeugend.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>', title: 'Rasenpflege', description: 'Rasenanlage, Aerifizieren, Düngen und regelmäßige Pflege — damit Ihr Grün das ganze Jahr über brilliert.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 18a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2"/><rect x="3" y="4" width="18" height="18" rx="2"/><circle cx="12" cy="10" r="3"/></svg>', title: 'Baumschnitt', description: 'Formschnitt, Kronenpflege und Fällarbeiten — fachgerecht, termintreu und mit Blick auf die langfristige Gesundheit Ihrer Gehölze.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>', title: 'Neuanlage & Umgestaltung', description: 'Ihr Garten soll ein neues Gesicht bekommen? Wir planen und realisieren Umgestaltungen jeder Größenordnung.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>', title: 'Laufende Gartenpflege', description: 'Monatliche oder saisonale Pflegeverträge für Privat- und Gewerbekunden — zuverlässig und diskret.' },
  ],
  stats: [
    { value: '20+', label: 'Jahre Erfahrung' },
    { value: '800+', label: 'Gärten realisiert' },
    { value: '100%', label: 'Regional verwurzelt' },
    { value: '15', label: 'Fachkräfte im Team' },
  ],
};

const processSteps = [
  { num: '01', title: 'Beratung', desc: 'Persönliches Gespräch vor Ort. Wir hören zu, schauen uns Ihre Fläche an und verstehen Ihre Wünsche.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' },
  { num: '02', title: 'Planung', desc: 'Detaillierter Entwurf mit Visualisierung. Sie sehen Ihren Garten, bevor wir anfangen.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>' },
  { num: '03', title: 'Umsetzung', desc: 'Professionelle Ausführung durch unser eigenes Team — termingerecht, sauber und ohne Subunternehmer.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>' },
  { num: '04', title: 'Pflege', desc: 'Langfristige Betreuung, damit Ihr Garten über Jahre hinweg wächst und gedeiht.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' },
];

const seasonalTips = [
  { season: 'Frühling', icon: '🌱', title: 'Neuanlage & Rasen', desc: 'Die beste Zeit für Rasenaussaat, Pflanzungen und Neuanlagen. Jetzt den Grundstein legen.' },
  { season: 'Sommer', icon: '☀️', title: 'Pflege & Bewässerung', desc: 'Regelmäßiger Schnitt, intelligente Bewässerung und Pflege halten Ihren Garten vital.' },
  { season: 'Herbst', icon: '🍂', title: 'Rückschnitt & Pflanzung', desc: 'Ideal für Gehölzpflanzung, Heckenschnitt und Vorbereitung auf den Winter.' },
  { season: 'Winter', icon: '❄️', title: 'Planung & Vorbereitung', desc: 'Die ruhige Jahreszeit nutzen wir für Beratung, Planung und Vorbereitung der Frühjahrsprojekte.' },
];
---

<PreviewLayout profile={galabauProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} logo="/client-logos/galabau-mueller.png" ctaText="Beratung anfragen" ctaHref="#kontakt" />

  <header class="hero-full" id="hero">
    <div class="hero-full__bg">
      <img src="/preview-images/galabau-mueller/hero.jpg" alt="Professionelle Gartengestaltung mit Natursteinwegen" width="1920" height="1080" loading="eager" fetchpriority="high" />
      <div class="hero-full__overlay"></div>
    </div>
    <div class="hero-full__content anim-fade-up">
      <div class="hero-full__badge">
        <span class="hero-full__badge-dot"></span>
        Frankfurt · GaLaBau · 20+ Jahre Erfahrung
      </div>
      <h1 class="hero-full__title">Grüne Oasen.<br/><span>Seit über 20 Jahren.</span></h1>
      <p class="hero-full__sub">{prospect.heroSubtitle}</p>
      <div class="hero-full__ctas">
        <a href="#kontakt" class="hero-full__btn-primary">Kostenloses Angebot</a>
        <a href="#galerie" class="hero-full__btn-outline">Unsere Projekte</a>
      </div>
    </div>
    <div class="hero-full__stats">
      {prospect.stats?.map(s => (
        <div class="hero-full__stat">
          <div class="hero-full__stat-val" data-count={s.value}>{s.value}</div>
          <div class="hero-full__stat-lbl">{s.label}</div>
        </div>
      ))}
    </div>
  </header>

  <section class="trust-bar">
    <div class="trust-bar__inner">
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Meisterbetrieb</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>20+ Jahre in Frankfurt</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>Eigenes Fachteam</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>800+ zufriedene Kunden</span>
      </div>
    </div>
  </section>

  <section class="services-tabs" id="leistungen">
    <div class="services-tabs__inner">
      <div class="services-tabs__header">
        <div class="services-tabs__badge">Unsere Leistungen</div>
        <h2 class="services-tabs__title">Was können wir <em>für Sie tun?</em></h2>
        <p class="services-tabs__sub">Von der Neuanlage bis zur laufenden Pflege — wählen Sie einen Bereich, der Sie interessiert.</p>
      </div>
      <div class="services-tabs__nav" role="tablist">
        {prospect.services.map((s, i) => (
          <button class={`services-tabs__tab ${i === 0 ? 'is-active' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i} type="button">
            <span class="services-tabs__tab-icon" set:html={s.icon} />
            <span>{s.title}</span>
          </button>
        ))}
      </div>
      <div class="services-tabs__panels">
        {prospect.services.map((s, i) => (
          <div class={`services-tabs__panel ${i === 0 ? 'is-active' : ''}`} role="tabpanel" data-panel={i}>
            <div class="services-tabs__panel-icon" set:html={s.icon} />
            <h3 class="services-tabs__panel-title">{s.title}</h3>
            <p class="services-tabs__panel-desc">{s.description}</p>
            <a href="#kontakt" class="services-tabs__panel-cta">Jetzt anfragen &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="process" id="ablauf">
    <div class="process__inner">
      <div class="process__header">
        <div class="process__badge">So arbeiten wir</div>
        <h2 class="process__title">In vier Schritten zu <em>Ihrem Traumgarten</em></h2>
        <p class="process__sub">Unser bewährter Ablauf — transparent, planbar und immer im Dialog mit Ihnen.</p>
      </div>
      <div class="process__steps">
        {processSteps.map((step, i) => (
          <div class="process__step">
            <div class="process__step-icon" set:html={step.icon} />
            <div class="process__step-num">{step.num}</div>
            <h3 class="process__step-title">{step.title}</h3>
            <p class="process__step-desc">{step.desc}</p>
            {i < processSteps.length - 1 && <div class="process__connector" aria-hidden="true"></div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="showcase" id="galerie">
    <div class="showcase__inner">
      <div class="showcase__header">
        <div class="showcase__badge">Referenzprojekte</div>
        <h2 class="showcase__title">Einblicke in <em>unsere Arbeit</em></h2>
        <p class="showcase__sub">Jedes Projekt ist einzigartig — hier sehen Sie eine Auswahl realisierter Gärten und Außenanlagen im Rhein-Main-Gebiet.</p>
      </div>
      <div class="showcase__grid anim-on-scroll">
        <div class="showcase__item showcase__item--large">
          <img src="/preview-images/galabau-mueller/gallery-1.jpg" alt="Gartenanlage mit Natursteinwegen in Frankfurt" loading="lazy" width="800" height="600" />
          <div class="showcase__caption">
            <span class="showcase__tag">Privatgarten</span>
            <h3>Gartenanlage Westend</h3>
            <p>Komplette Neugestaltung mit Naturstein-Wegen und üppiger Bepflanzung.</p>
          </div>
        </div>
        <div class="showcase__item showcase__item--small">
          <img src="/preview-images/galabau-mueller/gallery-2.jpg" alt="Gepflegter Rasen mit sauberem Schnitt" loading="lazy" width="500" height="280" />
          <div class="showcase__caption">
            <span class="showcase__tag">Rasenpflege</span>
            <h3>Gewerbegelände Niederrad</h3>
          </div>
        </div>
        <div class="showcase__item showcase__item--small">
          <img src="/preview-images/galabau-mueller/gallery-3.jpg" alt="Pflasterarbeiten Einfahrt" loading="lazy" width="500" height="280" />
          <div class="showcase__caption">
            <span class="showcase__tag">Pflasterbau</span>
            <h3>Einfahrt Sachsenhausen</h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PreviewTestimonials
    title="Das sagen unsere Kunden"
    subtitle="Über 800 Projekte im Rhein-Main-Gebiet — hier sprechen unsere Kunden."
    testimonials={[
      { text: 'Roland Müller und sein Team haben unseren Garten komplett neugestaltet. Von der Planung bis zur Umsetzung war alles perfekt — pünktlich, sauber und genau nach unseren Vorstellungen.', author: 'Familie Becker', role: 'Privatgarten in Sachsenhausen', rating: 5 },
      { text: 'Seit fünf Jahren pflegt Müller GaLaBau unsere Firmenaußenflächen. Absolute Zuverlässigkeit und immer ein gepflegtes Ergebnis.', author: 'Karin Schneider', role: 'Hausverwaltung Frankfurt', rating: 5 },
      { text: 'Kompetente Beratung, faire Preise und handwerklich erstklassige Arbeit. Unsere Terrasse ist ein Traum geworden.', author: 'Thomas und Sandra Fischer', role: 'Privatgarten in Bockenheim', rating: 5 },
    ]}
  />

  <section class="seasonal" id="saison">
    <div class="seasonal__inner">
      <div class="seasonal__header">
        <h2 class="seasonal__title">Gartenkalender</h2>
        <p class="seasonal__sub">Die richtige Maßnahme zur richtigen Zeit — wir beraten Sie, was Ihr Garten jetzt braucht.</p>
      </div>
      <div class="seasonal__grid">
        {seasonalTips.map(tip => (
          <div class="seasonal__card">
            <div class="seasonal__icon">{tip.icon}</div>
            <div class="seasonal__season">{tip.season}</div>
            <h3 class="seasonal__card-title">{tip.title}</h3>
            <p class="seasonal__card-desc">{tip.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="estimator" id="kalkulator">
    <div class="estimator__inner">
      <div class="estimator__header">
        <div class="estimator__badge">Kostenrechner</div>
        <h2 class="estimator__title">Was kostet <em>Ihr Projekt?</em></h2>
        <p class="estimator__sub">Erhalten Sie eine unverbindliche Ersteinschätzung — in unter 30 Sekunden.</p>
      </div>
      <div class="estimator__form">
        <div class="estimator__field">
          <label class="estimator__label">Art der Arbeit</label>
          <div class="estimator__options" data-field="type">
            <button class="estimator__option is-active" data-value="neuanlage" type="button">Neuanlage</button>
            <button class="estimator__option" data-value="umgestaltung" type="button">Umgestaltung</button>
            <button class="estimator__option" data-value="pflege" type="button">Pflege</button>
          </div>
        </div>
        <div class="estimator__field">
          <label class="estimator__label">Fläche in m²</label>
          <div class="estimator__slider-wrap">
            <input type="range" min="20" max="500" value="100" class="estimator__slider" id="area-slider" />
            <span class="estimator__slider-val" id="area-val">100 m²</span>
          </div>
        </div>
        <div class="estimator__result">
          <div class="estimator__result-label">Geschätzte Kosten</div>
          <div class="estimator__result-val" id="estimate-val">ca. 5.000 — 8.000 €</div>
          <div class="estimator__result-note">Unverbindliche Schätzung. Genaue Kosten nach Besichtigung.</div>
          <a href="#kontakt" class="estimator__result-cta">Jetzt kostenloses Angebot anfragen</a>
        </div>
      </div>
    </div>
  </section>

  <PreviewCTA
    title="Bereit für Ihren Traumgarten?"
    subtitle="Kontaktieren Sie uns für ein unverbindliches Beratungsgespräch. Wir kommen zu Ihnen, besichtigen Ihre Fläche und erstellen Ihnen ein kostenloses Angebot — ohne Druck, ohne Kleingedrucktes."
    badge="Jetzt anfragen"
    buttonText="Kostenloses Angebot anfragen"
    buttonLink="#kontakt"
    phone="+49 69 987654"
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    address="Frankfurt am Main"
    year={2025}
  />
</PreviewLayout>

<style>
  html { scroll-behavior: smooth; }

  .anim-fade-up {
    animation: fadeUp 0.8s ease-out both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .anim-on-scroll {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .anim-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-full {
    position: relative;
    min-height: 80vh;
    max-height: 700px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }

  .hero-full__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-full__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-full__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,20,10,0.95) 0%, rgba(10,20,10,0.7) 35%, rgba(10,20,10,0.35) 65%, rgba(10,20,10,0.15) 100%);
  }

  .hero-full__content {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px 48px;
    width: 100%;
  }

  .hero-full__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 100px;
    padding: 6px 16px;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.9);
    margin-bottom: 20px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .hero-full__badge-dot {
    width: 7px;
    height: 7px;
    background: #4ADE80;
    border-radius: 50%;
    animation: pulse-hero 2s ease-in-out infinite;
  }

  @keyframes pulse-hero {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.75); }
  }

  .hero-full__title {
    font-family: var(--font-heading);
    font-size: clamp(2.8rem, 5.5vw, 4.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
    margin-bottom: 20px;
  }

  .hero-full__title span { color: #4ADE80; }

  .hero-full__sub {
    color: rgba(255,255,255,0.75);
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 32px;
  }

  .hero-full__ctas { display: flex; gap: 14px; flex-wrap: wrap; }

  .hero-full__btn-primary {
    background: var(--accent);
    color: #fff;
    padding: 14px 28px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: var(--font-body);
    transition: background 0.2s, transform 0.2s;
    text-decoration: none;
  }

  .hero-full__btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); }

  .hero-full__btn-outline {
    border: 1px solid rgba(255,255,255,0.3);
    color: #fff;
    padding: 14px 28px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 500;
    font-family: var(--font-body);
    transition: border-color 0.2s, background 0.2s;
    text-decoration: none;
  }

  .hero-full__btn-outline:hover { border-color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.08); }

  .hero-full__stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(255,255,255,0.1);
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .hero-full__stat {
    background: rgba(10,20,10,0.8);
    backdrop-filter: blur(8px);
    padding: 24px 16px;
    text-align: center;
  }

  .hero-full__stat-val {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 800;
    color: #4ADE80;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .hero-full__stat-lbl {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.6);
    margin-top: 6px;
  }

  @media (max-width: 768px) {
    .hero-full { min-height: 75vh; max-height: none; }
    .hero-full__content { padding: 0 24px 32px; }
