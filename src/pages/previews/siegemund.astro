---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { handwerkProfile } from '../../templates/config/handwerk';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewHero from '../../templates/sections/PreviewHero.astro';
import PreviewServices from '../../templates/sections/PreviewServices.astro';
import PreviewStats from '../../templates/sections/PreviewStats.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewGallery from '../../templates/sections/PreviewGallery.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Siegemund & Söhne GmbH',
  tagline: 'Heizung · Sanitär · Klimatechnik Frankfurt',
  location: 'Frankfurt am Main',
  email: 'info@siegemund-shk.de',
  heroTitle: 'Heizung. Sanitär. Klimatechnik. Verlässlich.',
  heroSubtitle: 'Siegemund & Söhne GmbH steht seit Jahrzehnten für erstklassige SHK-Technik in Frankfurt und dem Rhein-Main-Gebiet. Von der Heizungsanlage bis zur modernen Klimatisierung — alles aus einer Hand.',
  services: [
    { icon: 'activity', title: 'Heizungsinstallation', description: 'Planung und Installation von Gas-, Öl- und Wärmepumpenanlagen — energieeffizient und auf Ihre Bedürfnisse zugeschnitten.' },
    { icon: 'grid', title: 'Sanitäranlagen', description: 'Bäder, Duschen und Sanitärinstallationen nach Maß — von der Entwässerung bis zur Fertigstellung in höchster Qualität.' },
    { icon: 'layers', title: 'Klimatechnik', description: 'Moderne Klimaanlagen und Lüftungssysteme für Wohn- und Gewerberäume — effizient, leise und fachgerecht installiert.' },
    { icon: 'shield', title: 'Wartung & Notdienst', description: 'Regelmäßige Wartungsverträge und schneller Notdienst rund um die Uhr — damit Sie nie im Kalten sitzen.' },
    { icon: 'sun', title: 'Energieberatung', description: 'Wir analysieren Ihren aktuellen Verbrauch und zeigen Einsparpotenziale auf — für eine zukunftssichere Haustechnik.' },
    { icon: 'tree', title: 'Badkomplettsanierung', description: 'Ihr altes Bad, neu gedacht — von der Planung bis zur Übergabe übernehmen wir alle Gewerke aus einer Hand.' },
  ],
  stats: [
    { value: '30+', label: 'Jahre Erfahrung' },
    { value: '1.200+', label: 'Anlagen' },
    { value: '24/7', label: 'Notdienst' },
  ],
};
---

<PreviewLayout profile={handwerkProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} ctaText="Angebot anfragen" ctaHref="#kontakt" />
  <PreviewHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Frankfurt · SHK-Fachbetrieb · Meisterbetrieb"
    ctaButtons={[
      { text: 'Kostenloses Angebot', href: '#kontakt', variant: 'primary' },
      { text: 'Unsere Leistungen', href: '#leistungen', variant: 'outline' },
    ]}
    heroImage="https://images.unsplash.com/photo-1585771724684-38269d6639fd?auto=format&fit=crop&w=1400&q=80"
    heroImageAlt="Modernes Badezimmer mit hochwertigen SHK-Installationen"
    stats={prospect.stats}
  />
  <PreviewServices title="Unsere Leistungen" subtitle="Ob Neubau, Sanierung oder Notfall — Siegemund & Söhne steht Ihnen mit langjähriger Fachkompetenz und modernster Technik zur Seite." services={prospect.services} />
  <PreviewGallery
    title="Referenzprojekte"
    subtitle="Ausgewählte SHK-Projekte — von der Heizungsanlage bis zur Badsanierung."
    images={[
      { src: 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?auto=format&fit=crop&w=800&q=80', alt: 'Modernes Bad mit Regendusche' },
      { src: 'https://images.unsplash.com/photo-1596436757672-b5aa0a34ade6?auto=format&fit=crop&w=800&q=80', alt: 'Elegantes Badezimmer mit freistehender Badewanne' },
      { src: 'https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?auto=format&fit=crop&w=800&q=80', alt: 'Heizungsanlage und SHK-Installation' },
      { src: 'https://images.unsplash.com/photo-1604709177225-055f99402ea3?auto=format&fit=crop&w=800&q=80', alt: 'Professionelle Sanitärinstallation' },
    ]}
  />
  <PreviewCTA title="Bereit für den nächsten Schritt?" subtitle="Ob Heizungstausch, Badumbau oder Notfall — wir sind für Sie da. Kontaktieren Sie uns für ein unverbindliches Angebot." badge="Jetzt anfragen" buttonText="Jetzt anrufen" buttonLink="tel:+49" />
  <PreviewFooter
    prospectName={prospect.name}
    tagline="Ihr SHK-Fachbetrieb in Frankfurt am Main. Heizung, Sanitär und Klimatechnik aus einer Hand — seit über 30 Jahren."
    email={prospect.email}
    year={2025}
    links={[
      { heading: 'Leistungen', links: [{ label: 'Heizungsinstallation', href: '#leistungen' }, { label: 'Sanitäranlagen', href: '#leistungen' }, { label: 'Klimatechnik', href: '#leistungen' }, { label: 'Wartung & Notdienst', href: '#leistungen' }] },
      { heading: 'Kontakt', links: [{ label: 'Frankfurt am Main', href: '#' }, { label: 'info@siegemund-shk.de', href: 'mailto:info@siegemund-shk.de' }, { label: 'Impressum', href: '#' }, { label: 'Datenschutz', href: '#' }] },
    ]}
  />
</PreviewLayout>
