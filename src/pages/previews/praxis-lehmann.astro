---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztModernProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztAnxiety from '../../templates/sections/zahnarzt/ZahnarztAnxiety.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztTeam from '../../templates/sections/zahnarzt/ZahnarztTeam.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Praxis Lehmann – Implantologie & Prothetik',
  tagline: 'Implantologie & Hochwertiger Zahnersatz Düsseldorf',
  location: 'Düsseldorf-Stadtmitte',
  email: 'info@praxis-lehmann-dus.de',
  phone: '+49 211 8765432',
  heroTitle: 'Exzellenter Zahnersatz. Meisterliche Qualität.',
  heroSubtitle: 'Mit 25 Jahren Erfahrung in Düsseldorf steht Praxis Lehmann für Implantologie und Prothetik auf höchstem Niveau. Über 10.000 zufriedene Patienten vertrauen unserer Expertise und unserem Team.',
  services: [
    { icon: 'implant', title: 'Implantologie', description: 'Modernste Implantate als dauerhafter, natürlich wirkender Zahnersatz — digital geplant, präzise gesetzt, aus über 5.000 platzierten Implantaten erprobt.' },
    { icon: 'tooth', title: 'Zahnersatz', description: 'Hochwertiger festsitzender und herausnehmbarer Zahnersatz aus premium Materialien — für ein vollständiges, funktionelles und ästhetisches Gebiss.' },
    { icon: 'grid', title: 'Kronen & Brücken', description: 'Präzisionsgefertigte Keramikkronen und Brücken — zahntechnische Meisterarbeit, die sich harmonisch ins natürliche Gebiss einfügt.' },
    { icon: 'shield', title: 'Parodontologie', description: 'Schonende Behandlung von Zahnfleischerkrankungen — gesundes Zahnfleisch ist die unverzichtbare Grundlage für dauerhaft erfolgreiche Implantate.' },
    { icon: 'check', title: 'Prophylaxe', description: 'Professionelle Zahnreinigung und individuelle Prophylaxe — der wichtigste Beitrag zum Schutz Ihrer Implantate und Ihres natürlichen Gebisses.' },
    { icon: 'star', title: 'Bleaching', description: 'Professionelles Zahnaufhellen — abgestimmt auf Ihren Zahnersatz für ein harmonisches Gesamtbild.' },
  ],
  stats: [
    { value: '25+', label: 'Jahre Erfahrung' },
    { value: '10.000+', label: 'Patienten betreut' },
    { value: '5', label: 'Zahnärzte im Team' },
  ],
};
---

<PreviewLayout profile={zahnarztModernProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    ctaText="Beratungstermin"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Implantologie-Zentrum Düsseldorf"
    ctaPrimary={{ text: 'Beratungstermin vereinbaren', href: '#kontakt' }}
    ctaSecondary={{ text: 'Leistungen entdecken', href: '#leistungen' }}
    imageSrc="/preview-images/praxis-lehmann/hero.jpg"
    imageAlt="Praxis Lehmann Düsseldorf — Implantologie und hochwertiger Zahnersatz"
    stats={prospect.stats}
  />

  <div class="zh-trust-bar" role="list" aria-label="Qualitätsmerkmale">
    <div class="zh-trust-bar__inner">
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Kassenzulassung & Privatpatienten</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/>
        </svg>
        <span>Modernste 3D-Implantologie</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span>5 Zahnärzte im Team</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span>25+ Jahre Erfahrung</span>
      </div>
    </div>
  </div>

  <ZahnarztServices
    title="Unsere Spezialgebiete"
    subtitle="Implantologie, Prothetik und Parodontologie auf höchstem Niveau in Düsseldorf."
    services={prospect.services}
  />

  <ZahnarztTeam
    name="Dr. Klaus Lehmann"
    title="Zahnarzt & Implantologe, Düsseldorf-Stadtmitte"
    bio="In 25 Jahren habe ich gelernt: Guter Zahnersatz verändert das Leben von Menschen. Wer wieder richtig kauen kann, wer wieder lachen mag — das ist mein Antrieb jeden Tag. Qualität ist keine Option, sie ist Grundvoraussetzung."
    qualifications={[
      'Approbierter Zahnarzt (Universität Düsseldorf)',
      'Spezialisierung Implantologie (DGOI)',
      'Fortbildungszertifikat Prothetik & CAD/CAM',
      'Parodontologie-Zertifikat (DGP)',
      'Mitglied der Deutschen Gesellschaft für Implantologie',
    ]}
    cta={{ text: 'Team kennenlernen — Beratungstermin buchen', href: '#kontakt' }}
  />

  <ZahnarztAnxiety
    title="Implantate klingen groß — sind sie aber nicht"
    quote="Die meisten Patienten sagen nach der Behandlung: 'Ich dachte, es wäre schlimmer.' Moderne Implantologie ist schonend, planbar und nahezu schmerzfrei. Das Warten ist das Schlimmste."
    quoteAuthor="Dr. Klaus Lehmann"
    trustPoints={[
      { icon: 'shield', title: 'Umfassende Diagnostik vorab', desc: '3D-Röntgen und CAD/CAM-Planung — Sie wissen vor dem ersten Eingriff genau, was passiert.' },
      { icon: 'heart', title: 'Lokale Betäubung reicht', desc: 'Über 5.000 Implantate gesetzt — fast immer unter lokaler Betäubung. Kein Vollnarkose-Aufwand nötig.' },
      { icon: 'check', title: 'Transparente Kostenpläne', desc: 'Schriftlicher Kostenplan vor Behandlungsbeginn — kein Cent kommt unerwartet.' },
      { icon: 'star', title: 'Erfahrung macht sicher', desc: '25 Jahre Praxiserfahrung. Wir haben auch komplexe Fälle erfolgreich behandelt.' },
    ]}
    cta={{ text: 'Unverbindlichen Beratungstermin vereinbaren', href: '#kontakt' }}
  />

  <ZahnarztBeforeAfter
    title="Unsere Ergebnisse"
    subtitle="Prothetik-Qualität, die überzeugt — funktionell und ästhetisch."
    cases={[
      { beforeSrc: '/preview-images/praxis-lehmann/gallery-1.jpg', afterSrc: '/preview-images/praxis-lehmann/gallery-2.jpg', label: 'Vollversorgung mit Implantaten' },
      { beforeSrc: '/preview-images/praxis-lehmann/gallery-3.jpg', afterSrc: '/preview-images/praxis-lehmann/gallery-4.jpg', label: 'Kronen & Brücken' },
    ]}
  />

  <ZahnarztTimeline
    title="Ihr Weg zum perfekten Zahnersatz"
    subtitle="Strukturiert, transparent und auf Ihre individuelle Situation abgestimmt."
    steps={[
      { num: 1, title: 'Diagnostik & Planung', desc: 'Umfassende digitale Diagnostik mit 3D-Röntgen und CAD/CAM-Planung — präzise von Anfang an.', icon: 'search' },
      { num: 2, title: 'Behandlungsplan', desc: 'Transparenter Plan mit detailliertem Kostenvoranschlag und Zeitplan — keine Überraschungen.', icon: 'calendar' },
      { num: 3, title: 'Präzise Versorgung', desc: 'Implantation und prothetische Versorgung mit modernsten Methoden — auf höchstem handwerklichem Niveau.', icon: 'tooth' },
      { num: 4, title: 'Nachsorge & Recall', desc: 'Strukturiertes Nachsorgeprogramm für dauerhaft erfolgreiche Implantate und Zahnersatz.', icon: 'check' },
    ]}
  />

  <PreviewTestimonials
    title="Was Patienten über uns sagen"
    testimonials={[
      { text: 'Nach Jahren mit Zahnproblemen hat Praxis Lehmann mir endlich geholfen. Die Implantat-Versorgung ist perfekt — ich bin überglücklich.', author: 'Walter H.', role: 'Implantat-Patient' },
      { text: 'Professionelle Beratung, transparente Kosten und ein exzellentes Ergebnis. So stelle ich mir einen Zahnarzt vor.', author: 'Renate S.', role: 'Patientin' },
      { text: 'Das Team ist fantastisch — kompetent, freundlich und immer erreichbar. Mein Zahnersatz sitzt perfekt.', author: 'Klaus M.', role: 'Patient seit 8 Jahren' },
    ]}
  />

  <ZahnarztCostCalc />

  <PreviewCTA
    title="Ihr Weg zu besserem Zahnersatz"
    subtitle="Vereinbaren Sie einen unverbindlichen Beratungstermin — wir finden die beste Lösung für Sie."
    ctaText="Beratungstermin vereinbaren"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>

<style>
  .zh-trust-bar {
    background: linear-gradient(
      to bottom,
      var(--bg-deep, #0d1f1c),
      color-mix(in srgb, var(--accent, #0E8A7B) 4%, var(--bg-deep, #0d1f1c))
    );
    border-bottom: 1px solid rgba(14, 138, 123, 0.15);
  }

  .zh-trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 20px 48px;
    flex-wrap: wrap;
  }

  .zh-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted, #8aafa5);
    white-space: nowrap;
  }

  .zh-trust-bar__item svg {
    color: var(--accent, #0E8A7B);
    flex-shrink: 0;
  }

  .zh-trust-bar__divider {
    width: 1px;
    height: 24px;
    background: rgba(14, 138, 123, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .zh-trust-bar__inner {
      gap: 16px;
      padding: 16px 24px;
    }

    .zh-trust-bar__divider {
      display: none;
    }

    .zh-trust-bar__item {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .zh-trust-bar__inner {
      justify-content: flex-start;
      gap: 12px;
    }

    .zh-trust-bar__item {
      flex: 1 1 calc(50% - 6px);
      min-width: 0;
      white-space: normal;
    }
  }
</style>
