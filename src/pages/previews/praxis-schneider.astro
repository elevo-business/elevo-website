---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztAesthetikProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Praxis Schneider – Ästhetische Zahnmedizin',
  tagline: 'Smile Design & Ästhetische Zahnmedizin Köln',
  location: 'Köln-Innenstadt',
  email: 'hello@praxis-schneider-koeln.de',
  phone: '+49 221 9876540',
  heroTitle: 'Ihr perfektes Lächeln wartet.',
  heroSubtitle: 'Praxis Schneider in Köln ist spezialisiert auf ästhetische Zahnmedizin und individuelles Smile Design. Veneers, Bleaching, Invisalign — wir erschaffen Lächeln, die begeistern und Selbstvertrauen schenken.',
  services: [
    { icon: 'star', title: 'Veneers & Smile Design', description: 'Individuelle Keramik-Veneers und ganzheitliches Smile Design — wir gestalten Ihr Lächeln nach Ihren Wünschen, minimalinvasiv und mit atemberaubendem Ergebnis.' },
    { icon: 'smile', title: 'Bleaching', description: 'Professionelles Zahnaufhellen für ein strahlendes, jugendliches Lächeln — in der Praxis oder mit individuellen Heimschienen.' },
    { icon: 'grid', title: 'Invisalign', description: 'Unsichtbare Zahnkorrektur mit herausnehmbaren Alignern — für perfekt ausgerichtete Zähne ohne sichtbare Zahnspange.' },
    { icon: 'implant', title: 'Implantate', description: 'Hochwertige Zahnimplantate als ästhetisch und funktionell perfekter Zahnersatz — digital geplant, präzise gesetzt.' },
    { icon: 'check', title: 'Prophylaxe', description: 'Professionelle Zahnreinigung und Prophylaxeprogramme als Grundlage für ein dauerhaft schönes und gesundes Lächeln.' },
    { icon: 'tooth', title: 'Keramikrestaurationen', description: 'Hochwertige Keramikkronen, Inlays und Onlays — zahntechnische Präzision, die sich nahtlos ins Lächeln einfügt.' },
  ],
  stats: [
    { value: '12+', label: 'Jahre Erfahrung' },
    { value: 'Smile Design', label: 'Spezialist Köln' },
    { value: '4.9★', label: 'Bewertung Köln' },
  ],
};
---

<PreviewLayout profile={zahnarztAesthetikProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    ctaText="Smile-Beratung buchen"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Smile Design Köln"
    ctaPrimary={{ text: 'Kostenlose Smile-Beratung', href: '#kontakt' }}
    ctaSecondary={{ text: 'Leistungen entdecken', href: '#leistungen' }}
    imageSrc="/preview-images/praxis-schneider/hero.jpg"
    imageAlt="Praxis Schneider Köln — Ästhetische Zahnmedizin und Smile Design"
    stats={prospect.stats}
  />

  <ZahnarztServices
    title="Ästhetische Zahnmedizin Köln"
    subtitle="Veneers, Bleaching, Invisalign — wir erschaffen Lächeln, die begeistern."
    services={prospect.services}
  />

  <ZahnarztTimeline
    title="So entsteht Ihr Traumlächeln"
    subtitle="Von der ersten Smile-Analyse bis zum fertigen Ergebnis — transparent und ohne Überraschungen."
    steps={[
      { num: 1, title: 'Smile-Analyse', desc: 'Digitale Analyse und 3D-Simulation Ihres Wunschlächelns — Sie sehen das Ergebnis, bevor die Behandlung beginnt.', icon: 'search' },
      { num: 2, title: 'Individuelle Planung', desc: 'Maßgeschneiderter Plan mit Ihrer Beteiligung — jedes Detail wird auf Ihre Wünsche abgestimmt.', icon: 'calendar' },
      { num: 3, title: 'Präzise Umsetzung', desc: 'Minimalinvasive Behandlung mit hochwertigen Materialien — für ein Ergebnis, das natürlich wirkt.', icon: 'star' },
      { num: 4, title: 'Langzeit-Freude', desc: 'Langfristige Begleitung und Prophylaxe erhalten Ihr strahlendes Lächeln dauerhaft.', icon: 'check' },
    ]}
  />

  <ZahnarztBeforeAfter
    title="Unsere Smile-Ergebnisse"
    subtitle="Ästhetische Perfektion in Köln."
    cases={[
      { beforeSrc: '/preview-images/praxis-schneider/gallery-1.jpg', afterSrc: '/preview-images/praxis-schneider/gallery-2.jpg', label: 'Komplettes Smile Design' },
      { beforeSrc: '/preview-images/praxis-schneider/gallery-3.jpg', afterSrc: '/preview-images/praxis-schneider/gallery-4.jpg', label: 'Veneers & Bleaching' },
    ]}
  />

  <ZahnarztCostCalc />

  <PreviewTestimonials
    title="Was Patienten über uns sagen"
    testimonials={[
      { text: 'Praxis Schneider hat mein Leben verändert. Endlich lache ich wieder ohne mich zu schämen — die Veneers sind perfekt.', author: 'Katharina B.', role: 'Veneer-Patientin' },
      { text: 'Die Smile-Analyse vorab hat mich überzeugt — ich konnte mir das Ergebnis vorstellen, bevor es umgesetzt wurde. Fantastisch!', author: 'Dirk R.', role: 'Invisalign-Patient' },
      { text: 'Sehr kompetentes und herzliches Team. Das Bleaching-Ergebnis übertraf alle meine Erwartungen.', author: 'Sophie M.', role: 'Patientin' },
    ]}
  />

  <PreviewCTA
    title="Ihr Traumlächeln in Köln"
    subtitle="Vereinbaren Sie jetzt Ihre kostenlose Smile-Beratung — wir zeigen Ihnen digital, was möglich ist."
    ctaText="Kostenlose Smile-Beratung"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>
