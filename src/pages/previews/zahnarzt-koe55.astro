---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztKoe55Profile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnärzte Kö55',
  tagline: 'Zwei Standorte Königsallee – Düsseldorf',
  location: 'Königsallee, Düsseldorf',
  email: 'info@zahnaerztekoe.de',
  phone: '0211 54213',
  heroTitle: 'Exzellente Zahnmedizin an zwei Standorten.',
  heroSubtitle: 'Zahnärzte Kö55 verbindet zwei erstklassige Praxen auf der Königsallee: modernste Medizin, zentrale Lage und eine einzige Buchungsplattform für beide Standorte.',
  services: [
    { icon: 'check', title: 'Zwei-Standort-Buchung', description: 'Buchen Sie online bei Kö55a oder Kö60d – ein System, alle Verfügbarkeiten beider Praxen.' },
    { icon: 'shield', title: 'Prophylaxe & Parodontologie', description: 'Professionelle Zahnreinigung und individuelle Prophylaxe-Programme für langfristige Zahngesundheit.' },
    { icon: 'smile', title: 'Ästhetische Zahnmedizin', description: 'Bleaching, Veneers und kosmetische Zahnkorrekturen für Ihr strahlendes Lächeln.' },
    { icon: 'tooth', title: 'Implantologie & Prothetik', description: 'Hochwertige Implantate und Zahnersatz – von der Erstberatung bis zur Eingliederung.' },
    { icon: 'star', title: 'Lange Öffnungszeiten', description: 'Mo–Do bis 20:00 Uhr – auch nach der Arbeit erreichbar. Kein Urlaubstag für Zahnarzttermine.' },
    { icon: 'grid', title: 'Digitale Röntgentechnik', description: 'Modernste digitale Diagnostik für präzise Befunde mit minimaler Strahlenbelastung.' },
  ],
  stats: [
    { value: '2', label: 'Standorte Kö55a & Kö60d' },
    { value: '4.8★', label: 'Google Bewertung' },
    { value: 'Mo–Do', label: 'bis 20 Uhr geöffnet' },
  ],
  testimonials: [
    { text: 'Super, dass ich zwischen Kö55a und Kö60d wählen kann – je nachdem, wo ich gerade bin. Und bis 20 Uhr geöffnet ist ein echter Pluspunkt!', author: 'Thomas K.', role: 'Patient, Düsseldorf-Innenstadt' },
    { text: 'Die Ärztin kennt meine Vorgeschichte, auch nach dem Standortwechsel. Das ist wirklich klasse.', author: 'Lisa M.', role: 'Patientin seit 4 Jahren' },
    { text: 'Professionell, modern und sehr gut erreichbar. Beides Praxen sind top ausgestattet.', author: 'Andreas W.', role: 'Patient, Düsseldorf' },
  ],
};
---

<PreviewLayout profile={zahnarztKoe55Profile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    logo="https://www.zahnaerztekoe55.de/wp-content/uploads/Koe55_Logo.png"
    ctaText="Termin buchen"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Zwei Standorte Königsallee – moderne Zahnmedizin"
    ctaPrimary={{ text: 'Standort wählen & Termin buchen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Leistungen entdecken', href: '#leistungen' }}
    imageSrc="https://www.zahnaerztekoe55.de/wp-content/uploads/Zahnaerzte-Koe_Header-Mobil.jpg"
    imageAlt="Zahnärzte Kö55 – Zwei Standorte Königsallee Düsseldorf"
    stats={prospect.stats}
  />

  <div class="zh-trust-bar" role="list" aria-label="Qualitätsmerkmale">
    <div class="zh-trust-bar__inner">
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        <span>Kö55a & Kö60d – ein Buchungssystem</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span>4.8★ auf Google</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
        </svg>
        <span>Mo–Do bis 20 Uhr</span>
      </div>
      <div class="zh-trust-bar__divider" aria-hidden="true"></div>
      <div class="zh-trust-bar__item" role="listitem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Alle Kassen & Privat</span>
      </div>
    </div>
  </div>

  <ZahnarztServices
    title="Unser Behandlungsspektrum"
    subtitle="Zwei Standorte, ein Buchungssystem – modernste Zahnmedizin an der Königsallee."
    services={prospect.services}
  />

  <ZahnarztTimeline
    title="So funktioniert Ihr Besuch bei uns"
    subtitle="Von der Online-Buchung bis zur Nachsorge – einfach und persönlich."
    steps={[
      { num: 1, title: 'Standort & Termin wählen', desc: 'Kö55a oder Kö60d – beide Standorte, ein zentrales Buchungssystem.', icon: 'search' },
      { num: 2, title: 'Persönlicher Befund', desc: 'Gründliche Untersuchung und transparente Behandlungsplanung – Ihre Gesundheit zuerst.', icon: 'calendar' },
      { num: 3, title: 'Schonende Behandlung', desc: 'Modernste Technik, pünktliche Termine – angenehme Behandlung an Ihrer Wunsch-Kö.', icon: 'tooth' },
      { num: 4, title: 'Nachsorge & Prophylaxe', desc: 'Regelmäßige Erinnerungen und Recall-Termine für dauerhafte Zahngesundheit.', icon: 'check' },
    ]}
  />

  <PreviewTestimonials
    title="Was Patienten über uns sagen"
    testimonials={prospect.testimonials}
  />

  <ZahnarztCostCalc />

  <PreviewCTA
    title="Ihr Termin an der Kö – zu Ihren Zeiten"
    subtitle="Kö55a oder Kö60d – online buchen, Mo–Do bis 20 Uhr. Moderner Zahnarzt im Herzen Düsseldorfs."
    ctaText="Termin buchen"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    logo="https://www.zahnaerztekoe55.de/wp-content/uploads/Koe55_Logo.png"
    email={prospect.email}
    phone={prospect.phone}
    location="Königsallee 55a & 60d, 40212 Düsseldorf"
    year={2026}
  />
</PreviewLayout>

<style>
  .zh-trust-bar {
    background: linear-gradient(
      to bottom,
      var(--bg-deep, #0d1f1c),
      color-mix(in srgb, var(--accent, #0E8A7B) 4%, var(--bg-deep, #0d1f1c))
    );
    border-bottom: 1px solid rgba(14, 138, 123, 0.15);
  }

  .zh-trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 20px 48px;
    flex-wrap: wrap;
  }

  .zh-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted, #8aafa5);
    white-space: nowrap;
  }

  .zh-trust-bar__item svg {
    color: var(--accent, #0E8A7B);
    flex-shrink: 0;
  }

  .zh-trust-bar__divider {
    width: 1px;
    height: 24px;
    background: rgba(14, 138, 123, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .zh-trust-bar__inner {
      gap: 16px;
      padding: 16px 24px;
    }

    .zh-trust-bar__divider {
      display: none;
    }

    .zh-trust-bar__item {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .zh-trust-bar__inner {
      justify-content: flex-start;
      gap: 12px;
    }

    .zh-trust-bar__item {
      flex: 1 1 calc(50% - 6px);
      min-width: 0;
      white-space: normal;
    }
  }
</style>
