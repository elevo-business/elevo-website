<script>
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href');
      if (!href) return;
      const target = document.querySelector(href);
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    });
  });
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } });
  }, { threshold: 0.15 });
  document.querySelectorAll('.anim-on-scroll, .process__step, .seasonal__card, .ptst__card').forEach(el => { el.classList.add('anim-on-scroll'); observer.observe(el); });
  const countObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const raw = el.dataset.count || el.textContent || '';
        const match = raw.match(/(\d+)/);
        if (match) { const target = parseInt(match[1]); const suffix = raw.replace(/\d+/, ''); let current = 0; const step = Math.max(1, Math.floor(target / 40)); const timer = setInterval(() => { current += step; if (current >= target) { current = target; clearInterval(timer); } el.textContent = current + suffix; }, 30); }
        countObserver.unobserve(el);
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.hero-full__stat-val').forEach(el => countObserver.observe(el));
  const tabs = document.querySelectorAll('.services-tabs__tab');
  const panels = document.querySelectorAll('.services-tabs__panel');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const idx = (tab as HTMLElement).dataset.tab;
      tabs.forEach(t => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
      panels.forEach(p => p.classList.remove('is-active'));
      tab.classList.add('is-active'); tab.setAttribute('aria-selected', 'true');
      const panel = document.querySelector(`[data-panel="${idx}"]`);
      if (panel) panel.classList.add('is-active');
    });
  });
  const typeButtons = document.querySelectorAll('.estimator__option');
  const slider = document.getElementById('area-slider') as HTMLInputElement;
  const areaVal = document.getElementById('area-val');
  const estimateVal = document.getElementById('estimate-val');
  const rates: Record<string, [number, number]> = { neuanlage: [50, 80], umgestaltung: [40, 65], pflege: [3, 6] };
  let selectedType = 'neuanlage';
  function updateEstimate() {
    if (!slider || !areaVal || !estimateVal) return;
    const area = parseInt(slider.value);
    areaVal.textContent = area + ' m²';
    const [lo, hi] = rates[selectedType] || [50, 80];
    const min = Math.round(area * lo / 100) * 100;
    const max = Math.round(area * hi / 100) * 100;
    if (selectedType === 'pflege') { estimateVal.textContent = `ca. ${min.toLocaleString('de-DE')} — ${max.toLocaleString('de-DE')} € / Monat`; }
    else { estimateVal.textContent = `ca. ${min.toLocaleString('de-DE')} — ${max.toLocaleString('de-DE')} €`; }
  }
  typeButtons.forEach(btn => {
    btn.addEventListener('click', () => { typeButtons.forEach(b => b.classList.remove('is-active')); btn.classList.add('is-active'); selectedType = (btn as HTMLElement).dataset.value || 'neuanlage'; updateEstimate(); });
  });
  if (slider) { slider.addEventListener('input', updateEstimate); updateEstimate(); }
</script>
