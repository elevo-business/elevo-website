---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { galabauProfile } from '../../templates/config/galabau';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Werner GaLaBau GmbH',
  tagline: 'Zertifizierter Garten- und Landschaftsbau Frankfurt',
  location: 'Frankfurt am Main',
  email: 'info@werner-galabau.de',
  phone: '+49 69 345678',
  heroTitle: 'Ihr Außenbereich. <em>In besten Händen.</em>',
  heroSubtitle: 'Werner GaLaBau GmbH realisiert Garten- und Landschaftsbauprojekte jeder Größe — von der privaten Terrasse bis zur großflächigen Gewerbeanlage. Verlässlich, termingerecht, zertifiziert.',
  services: [
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>', title: 'Neuanlage', description: 'Wir planen und realisieren Gärten, Außenanlagen und Grünflächen von Grund auf — präzise nach Ihren Vorgaben und termingerecht.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>', title: 'Pflasterarbeiten', description: 'Einfahrten, Hofflächen, Parkplätze — fachgerecht gepflastert in Naturstein, Betonpflaster oder Klinker für Privat und Gewerbe.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>', title: 'Rasenpflege', description: 'Mähservice, Vertikutieren, Düngen, Bewässerungsanlagen — wir halten Ihren Rasen das ganze Jahr in Topform.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 3l6 18M6 3c0 0 6 4 12 0"/><path d="M6 3C6 3 0 7 0 15c0 3.87 2.69 5.97 6 6"/></svg>', title: 'Gehölzschnitt', description: 'Fachgerechter Formschnitt, Kronenpflege und Fällarbeiten — wir sorgen für gesunde Bäume und ordentliche Hecken.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>', title: 'Gewerbebetreuung', description: 'Regelmäßige Pflege von Firmengeländen, Wohnanlagen und öffentlichen Grünflächen — zuverlässig und diskret.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>', title: 'Winterdienst', description: 'Schneeräumung und Streudienst für Firmengelände und Wohnanlagen — pünktlich, zuverlässig und auf Wunsch mit Bereitschaftsvertrag.' },
  ],
  stats: [
    { value: '10+', label: 'Jahre Erfahrung' },
    { value: '450+', label: 'Projekte realisiert' },
    { value: '100%', label: 'ISO-zertifiziert' },
    { value: '20', label: 'Fachkräfte im Team' },
  ],
};

const processSteps = [
  { num: '01', title: 'Besichtigung', desc: 'Kostenlose Vor-Ort-Besichtigung und Bestandsaufnahme Ihres Objekts.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' },
  { num: '02', title: 'Angebot', desc: 'Transparentes Festpreisangebot mit detailliertem Leistungsverzeichnis.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>' },
  { num: '03', title: 'Ausführung', desc: 'Termingerechte Umsetzung durch unser eigenes ISO-zertifiziertes Team.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>' },
  { num: '04', title: 'Betreuung', desc: 'Laufende Pflege und Winterdienst auf Wunsch — alles aus einer Hand.', icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' },
];

const seasonalTips = [
  { season: 'Frühling', icon: '🌱', title: 'Neuanlage & Rasen', desc: 'Die beste Zeit für Rasenaussaat, Pflanzungen und Neuanlagen. Jetzt den Grundstein legen.' },
  { season: 'Sommer', icon: '☀️', title: 'Pflege & Bewässerung', desc: 'Regelmäßiger Schnitt, intelligente Bewässerung und Pflege halten Ihren Garten vital.' },
  { season: 'Herbst', icon: '🍂', title: 'Rückschnitt & Pflanzung', desc: 'Ideal für Gehölzpflanzung, Heckenschnitt und Vorbereitung auf den Winter.' },
  { season: 'Winter', icon: '❄️', title: 'Winterdienst & Planung', desc: 'Zuverlässiger Winterdienst und Planung der Frühjahrsprojekte — wir sind das ganze Jahr für Sie da.' },
];
---

<PreviewLayout profile={galabauProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} logo="/client-logos/werner-galabau.png" ctaText="Angebot anfragen" ctaHref="#kontakt" />

  <header class="hero-full" id="hero">
    <div class="hero-full__bg">
      <img src="/preview-images/werner-galabau/hero.jpg" alt="Großflächige gewerbliche Außenanlage mit gepflegtem Grün" width="1920" height="1080" loading="eager" fetchpriority="high" />
      <div class="hero-full__overlay"></div>
    </div>
    <div class="hero-full__content anim-fade-up">
      <div class="hero-full__badge">
        <span class="hero-full__badge-dot"></span>
        Frankfurt · GaLaBau · Zertifizierter Fachbetrieb
      </div>
      <h1 class="hero-full__title">Ihr Außenbereich.<br/><span>In besten Händen.</span></h1>
      <p class="hero-full__sub">{prospect.heroSubtitle}</p>
      <div class="hero-full__ctas">
        <a href="#kontakt" class="hero-full__btn-primary">Kostenloses Angebot</a>
        <a href="#galerie" class="hero-full__btn-outline">Unsere Projekte</a>
      </div>
    </div>
    <div class="hero-full__stats">
      {prospect.stats?.map(s => (
        <div class="hero-full__stat">
          <div class="hero-full__stat-val" data-count={s.value}>{s.value}</div>
          <div class="hero-full__stat-lbl">{s.label}</div>
        </div>
      ))}
    </div>
  </header>

  <section class="trust-bar">
    <div class="trust-bar__inner">
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>ISO-zertifiziert</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>Seit 10+ Jahren in Frankfurt</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>20 Fachkräfte</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>450+ Projekte realisiert</span>
      </div>
    </div>
  </section>

  <section class="services-tabs" id="leistungen">
    <div class="services-tabs__inner">
      <div class="services-tabs__header">
        <div class="services-tabs__badge">Unsere Leistungen</div>
        <h2 class="services-tabs__title">Was können wir <em>für Sie tun?</em></h2>
        <p class="services-tabs__sub">Von der Neuanlage bis zum Winterdienst — professionelle Lösungen für Gewerbe und Privat.</p>
      </div>
      <div class="services-tabs__nav" role="tablist">
        {prospect.services.map((s, i) => (
          <button class={`services-tabs__tab ${i === 0 ? 'is-active' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i} type="button">
            <span class="services-tabs__tab-icon" set:html={s.icon} />
            <span>{s.title}</span>
          </button>
        ))}
      </div>
      <div class="services-tabs__panels">
        {prospect.services.map((s, i) => (
          <div class={`services-tabs__panel ${i === 0 ? 'is-active' : ''}`} role="tabpanel" data-panel={i}>
            <div class="services-tabs__panel-icon" set:html={s.icon} />
            <h3 class="services-tabs__panel-title">{s.title}</h3>
            <p class="services-tabs__panel-desc">{s.description}</p>
            <a href="#kontakt" class="services-tabs__panel-cta">Jetzt anfragen &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="process" id="ablauf">
    <div class="process__inner">
      <div class="process__header">
        <div class="process__badge">So arbeiten wir</div>
        <h2 class="process__title">Unser Projektablauf <em>für Sie</em></h2>
        <p class="process__sub">Transparent, termingerecht und mit zertifizierter Qualität — von der Besichtigung bis zur laufenden Betreuung.</p>
      </div>
      <div class="process__steps">
        {processSteps.map((step, i) => (
          <div class="process__step">
            <div class="process__step-icon" set:html={step.icon} />
            <div class="process__step-num">{step.num}</div>
            <h3 class="process__step-title">{step.title}</h3>
            <p class="process__step-desc">{step.desc}</p>
            {i < processSteps.length - 1 && <div class="process__connector" aria-hidden="true"></div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="showcase" id="galerie">
    <div class="showcase__inner">
      <div class="showcase__header">
        <div class="showcase__badge">Projektgalerie</div>
        <h2 class="showcase__title">Einblicke in <em>unsere Projekte</em></h2>
        <p class="showcase__sub">Auswahl realisierter Außenanlagen für Gewerbe- und Privatkunden im Rhein-Main-Gebiet.</p>
      </div>
      <div class="showcase__grid anim-on-scroll">
        <div class="showcase__item showcase__item--large">
          <img src="/preview-images/werner-galabau/gallery-1.jpg" alt="Großflächige Pflasteranlage für Gewerbekunden" loading="lazy" width="800" height="600" />
          <div class="showcase__caption">
            <span class="showcase__tag">Gewerbe</span>
            <h3>Außenanlage Bürokomplex</h3>
            <p>Großflächige Pflasterung und Grünanlage für einen Frankfurter Bürokomplex.</p>
          </div>
        </div>
        <div class="showcase__item showcase__item--small">
          <img src="/preview-images/werner-galabau/gallery-2.jpg" alt="Naturstein-Einfahrt mit Begrünung" loading="lazy" width="500" height="280" />
          <div class="showcase__caption">
            <span class="showcase__tag">Pflasterbau</span>
            <h3>Einfahrt Sachsenhausen</h3>
          </div>
        </div>
        <div class="showcase__item showcase__item--small">
          <img src="/preview-images/werner-galabau/gallery-3.jpg" alt="Gepflegte Grünanlage eines Bürokomplexes" loading="lazy" width="500" height="280" />
          <div class="showcase__caption">
            <span class="showcase__tag">Grünpflege</span>
            <h3>Wohnanlage Westend</h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PreviewTestimonials
    title="Das sagen unsere Kunden"
    subtitle="Über 450 Projekte im Rhein-Main-Gebiet — hier sprechen unsere Kunden."
    testimonials={[
      { text: 'Werner GaLaBau betreut seit vier Jahren unsere Firmengelände. Absolute Professionalität, termingerechte Lieferung und immer ein sauberes Ergebnis — auch im Winter.', author: 'Michael Braun', role: 'Facility Manager, Frankfurt', rating: 5 },
      { text: 'Die Pflasterarbeiten an unserer Einfahrt wurden perfekt ausgeführt. Transparentes Angebot, pünktlicher Start und das Ergebnis übertrifft unsere Erwartungen.', author: 'Familie Richter', role: 'Privatgarten in Sachsenhausen', rating: 5 },
      { text: 'Zertifizierte Qualität, die man sieht. Unsere Wohnanlage sieht seit der Neugestaltung durch Werner GaLaBau deutlich gepflegter aus.', author: 'Hausverwaltung Westend', role: 'Wohnanlage Frankfurt', rating: 5 },
    ]}
  />

  <section class="seasonal" id="saison">
    <div class="seasonal__inner">
      <div class="seasonal__header">
        <h2 class="seasonal__title">Gartenkalender</h2>
        <p class="seasonal__sub">Die richtige Maßnahme zur richtigen Zeit — wir beraten Sie, was Ihre Außenfläche jetzt braucht.</p>
      </div>
      <div class="seasonal__grid">
        {seasonalTips.map(tip => (
          <div class="seasonal__card">
            <div class="seasonal__icon">{tip.icon}</div>
            <div class="seasonal__season">{tip.season}</div>
            <h3 class="seasonal__card-title">{tip.title}</h3>
            <p class="seasonal__card-desc">{tip.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="estimator" id="kalkulator">
    <div class="estimator__inner">
      <div class="estimator__header">
        <div class="estimator__badge">Kostenrechner</div>
        <h2 class="estimator__title">Was kostet <em>Ihr Projekt?</em></h2>
        <p class="estimator__sub">Erhalten Sie eine unverbindliche Ersteinschätzung — in unter 30 Sekunden.</p>
      </div>
      <div class="estimator__form">
        <div class="estimator__field">
          <label class="estimator__label">Art der Arbeit</label>
          <div class="estimator__options" data-field="type">
            <button class="estimator__option is-active" data-value="neuanlage" type="button">Neuanlage</button>
            <button class="estimator__option" data-value="umgestaltung" type="button">Umgestaltung</button>
            <button class="estimator__option" data-value="pflege" type="button">Pflege</button>
          </div>
        </div>
        <div class="estimator__field">
          <label class="estimator__label">Fläche in m²</label>
          <div class="estimator__slider-wrap">
            <input type="range" min="20" max="500" value="100" class="estimator__slider" id="area-slider" />
            <span class="estimator__slider-val" id="area-val">100 m²</span>
          </div>
        </div>
        <div class="estimator__result">
          <div class="estimator__result-label">Geschätzte Kosten</div>
          <div class="estimator__result-val" id="estimate-val">ca. 5.000 — 8.000 €</div>
          <div class="estimator__result-note">Unverbindliche Schätzung. Genaue Kosten nach Besichtigung.</div>
          <a href="#kontakt" class="estimator__result-cta">Jetzt kostenloses Angebot anfragen</a>
        </div>
      </div>
    </div>
  </section>

  <PreviewCTA
    title="Ihr Projekt, unsere Expertise."
    subtitle="Wir besichtigen Ihr Objekt kostenlos und erstellen Ihnen ein transparentes Angebot. Profitieren Sie von unserer zertifizierten Fachkompetenz — für Gewerbe und Privat."
    badge="Jetzt anfragen"
    buttonText="Kostenloses Angebot anfragen"
    buttonLink="#kontakt"
    phone="+49 69 345678"
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    address="Frankfurt am Main"
    year={2025}
  />
</PreviewLayout>

<style>
  html { scroll-behavior: smooth; }
  .anim-fade-up { animation: fadeUp 0.8s ease-out both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  .anim-on-scroll { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .anim-on-scroll.is-visible { opacity: 1; transform: translateY(0); }
  .hero-full { position: relative; min-height: 80vh; max-height: 700px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
  .hero-full__bg { position: absolute; inset: 0; z-index: 0; }
  .hero-full__bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .hero-full__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,20,10,0.95) 0%, rgba(10,20,10,0.7) 35%, rgba(10,20,10,0.35) 65%, rgba(10,20,10,0.15) 100%); }
  .hero-full__content { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 48px 48px; width: 100%; }
  .hero-full__badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.18); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: rgba(255,255,255,0.9); margin-bottom: 20px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }
  .hero-full__badge-dot { width: 7px; height: 7px; background: #4ADE80; border-radius: 50%; animation: pulse-hero 2s ease-in-out infinite; }
  @keyframes pulse-hero { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.75); } }
  .hero-full__title { font-family: var(--font-heading); font-size: clamp(2.8rem, 5.5vw, 4.2rem); font-weight: 800; line-height: 1.05; letter-spacing: -0.03em; color: #fff; margin-bottom: 20px; }
  .hero-full__title span { color: #4ADE80; }
  .hero-full__sub { color: rgba(255,255,255,0.75); font-size: 1.1rem; line-height: 1.7; max-width: 560px; margin-bottom: 32px; }
  .hero-full__ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-full__btn-primary { background: var(--accent); color: #fff; padding: 14px 28px; border-radius: 10px; font-size: 0.95rem; font-weight: 600; font-family: var(--font-body); transition: background 0.2s, transform 0.2s; text-decoration: none; }
  .hero-full__btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); }
  .hero-full__btn-outline { border: 1px solid rgba(255,255,255,0.3); color: #fff; padding: 14px 28px; border-radius: 10px; font-size: 0.95rem; font-weight: 500; font-family: var(--font-body); transition: border-color 0.2s, background 0.2s; text-decoration: none; }
  .hero-full__btn-outline:hover { border-color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.08); }
  .hero-full__stats { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255,255,255,0.1); border-top: 1px solid rgba(255,255,255,0.1); }
  .hero-full__stat { background: rgba(10,20,10,0.8); backdrop-filter: blur(8px); padding: 24px 16px; text-align: center; }
  .hero-full__stat-val { font-family: var(--font-heading); font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 800; color: #4ADE80; letter-spacing: -0.03em; line-height: 1; }
  .hero-full__stat-lbl { font-size: 0.75rem; color: rgba(255,255,255,0.6); margin-top: 6px; }
  @media (max-width: 768px) {
    .hero-full { min-height: 75vh; } .hero-full__content { padding: 0 24px 32px; } .hero-full__stats { grid-template-columns: repeat(2, 1fr); } .hero-full__ctas { flex-direction: column; } .hero-full__btn-primary, .hero-full__btn-outline { text-align: center; }
  }
  .trust-bar { border-bottom: 1px solid var(--border); background: var(--bg-el); }
  .trust-bar__inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: center; gap: 32px; padding: 18px 48px; flex-wrap: wrap; }
  .trust-bar__item { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; font-weight: 500; color: var(--muted); white-space: nowrap; }
  .trust-bar__item svg { color: var(--accent); flex-shrink: 0; }
  .trust-bar__divider { width: 1px; height: 20px; background: var(--border); }
  .process { padding: 80px 48px; max-width: 1200px; margin: 0 auto; }
  .process__header { margin-bottom: 56px; }
  .process__badge { display: inline-flex; align-items: center; gap: 8px; background: color-mix(in srgb, var(--accent) 10%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: var(--accent); margin-bottom: 16px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }
  .process__title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 14px; color: var(--text); }
