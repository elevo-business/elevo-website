---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { galabauProfile } from '../../templates/config/galabau';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import PreviewHero from '../../templates/sections/PreviewHero.astro';
import PreviewServices from '../../templates/sections/PreviewServices.astro';
import PreviewStats from '../../templates/sections/PreviewStats.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Werner GaLaBau GmbH',
  tagline: 'Zertifizierter Garten- und Landschaftsbau Frankfurt',
  location: 'Frankfurt am Main',
  email: 'info@werner-galabau.de',
  heroTitle: 'Ihr Außenbereich in besten Händen.',
  heroSubtitle: 'Werner GaLaBau GmbH realisiert Garten- und Landschaftsbauprojekte jeder Größe — von der privaten Terrasse bis zur großflächigen Gewerbeanlage. Verlässlich, termingerecht, zertifiziert.',
  services: [
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>', title: 'Neuanlage', description: 'Wir planen und realisieren Gärten, Außenanlagen und Grünflächen von Grund auf — präzise nach Ihren Vorgaben und termingerecht.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>', title: 'Pflasterarbeiten', description: 'Einfahrten, Hofflächen, Parkplätze — fachgerecht gepflastert in Naturstein, Betonpflaster oder Klinker für Privat und Gewerbe.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>', title: 'Rasenpflege', description: 'Mähservice, Vertikutieren, Düngen, Bewässerungsanlagen — wir halten Ihren Rasen das ganze Jahr in Topform.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l6 18M6 3c0 0 6 4 12 0"/><path d="M6 3C6 3 0 7 0 15c0 3.87 2.69 5.97 6 6"/></svg>', title: 'Gehölzschnitt', description: 'Fachgerechter Formschnitt, Kronenpflege und Fällarbeiten — wir sorgen für gesunde Bäume und ordentlich gestaltete Hecken.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>', title: 'Gewerbebetreuung', description: 'Regelmäßige Pflege von Firmengeländen, Wohnanlagen und öffentlichen Grünflächen — zuverlässig und diskret nach Vereinbarung.' },
    { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>', title: 'Winterdienst', description: 'Schneeräumung und Streudienst für Firmengelände und Wohnanlagen — pünktlich, zuverlässig und auf Wunsch mit Bereitschaftsvertrag.' },
  ],
  stats: [
    { value: 'ISO', label: 'Zertifiziert' },
    { value: '450+', label: 'Projekte' },
    { value: '10+', label: 'Jahre' },
  ],
};
---

<PreviewLayout profile={galabauProfile} prospect={prospect}>
  <PreviewNav prospectName={prospect.name} ctaText="Angebot anfragen" ctaHref="#kontakt" />
  <PreviewHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Frankfurt · GaLaBau · Zertifizierter Fachbetrieb"
    ctaButtons={[
      { text: 'Kostenloses Angebot', href: '#kontakt', variant: 'primary' },
      { text: 'Unsere Leistungen', href: '#leistungen', variant: 'outline' },
    ]}
    stats={prospect.stats}
  />
  <PreviewServices title="Unsere Leistungen" subtitle="Werner GaLaBau steht für handwerkliche Exzellenz und professionelle Projektabwicklung — pünktlich, sauber und mit zertifizierter Qualität." services={prospect.services} />
  <PreviewCTA title="Ihr Projekt, unsere Expertise." subtitle="Wir besichtigen Ihr Objekt kostenlos und erstellen Ihnen ein transparentes Angebot. Profitieren Sie von unserer zertifizierten Fachkompetenz." badge="Jetzt anfragen" buttonText="Jetzt anrufen" buttonLink="tel:+49" />
  <PreviewFooter
    prospectName={prospect.name}
    tagline="Zertifizierter Garten- und Landschaftsbaubetrieb im Rhein-Main-Gebiet. Für anspruchsvolle Projekte bei Privat- und Gewerbekunden."
    email={prospect.email}
    year={2025}
    links={[
      { heading: 'Leistungen', links: [{ label: 'Neuanlage', href: '#leistungen' }, { label: 'Pflasterarbeiten', href: '#leistungen' }, { label: 'Rasenpflege', href: '#leistungen' }, { label: 'Gehölzschnitt', href: '#leistungen' }] },
      { heading: 'Kontakt', links: [{ label: 'Frankfurt am Main', href: '#' }, { label: 'info@werner-galabau.de', href: 'mailto:info@werner-galabau.de' }, { label: 'Impressum', href: '#' }, { label: 'Datenschutz', href: '#' }] },
    ]}
  />
</PreviewLayout>
