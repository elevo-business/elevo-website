---
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Werner GaLaBau GmbH — Garten- und Landschaftsbau Frankfurt</title>
  <link rel="preload" as="font" href="/fonts/Sora-latin.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="/fonts/Outfit-latin.woff2" type="font/woff2" crossorigin>
  <style>
    @font-face { font-family: 'Sora'; font-style: normal; font-weight: 400 800; font-display: swap; src: url('/fonts/Sora-latin.woff2') format('woff2'); }
    @font-face { font-family: 'Outfit'; font-style: normal; font-weight: 300 600; font-display: swap; src: url('/fonts/Outfit-latin.woff2') format('woff2'); }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root { --accent: #10B981; --accent-hover: #059669; --bg: #050E09; --bg-el: #06120A; --surface: #0A1C10; --border: #112B19; --text: #E0F5EC; --muted: #5EA882; --dim: #336650; }
    body { background: var(--bg); color: var(--text); font-family: 'Outfit', sans-serif; }
    a { text-decoration: none; }
    .nav { display: flex; justify-content: space-between; align-items: center; padding: 20px 48px; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: rgba(5,14,9,.92); backdrop-filter: blur(12px); z-index: 100; }
    .logo { font-family: 'Sora', sans-serif; font-weight: 800; font-size: 1.25rem; color: var(--text); display: flex; align-items: center; gap: 10px; }
    .logo-icon { width: 36px; height: 36px; background: var(--accent); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
    .nav-links { display: flex; gap: 32px; list-style: none; }
    .nav-links a { color: var(--muted); font-size: 0.9rem; transition: color .2s; }
    .nav-links a:hover { color: var(--text); }
    .btn { background: var(--accent); color: #fff; padding: 11px 24px; border-radius: 8px; font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 0.9rem; transition: background .2s; }
    .btn:hover { background: var(--accent-hover); }
    .hero { padding: 100px 48px 80px; max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
    .badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(16,185,129,.1); border: 1px solid rgba(16,185,129,.25); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; color: var(--accent); margin-bottom: 24px; letter-spacing: .05em; text-transform: uppercase; font-weight: 600; }
    .badge-dot { width: 7px; height: 7px; background: var(--accent); border-radius: 50%; }
    h1 { font-family: 'Sora', sans-serif; font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; margin-bottom: 20px; }
    h1 span { color: var(--accent); }
    .hero p { color: var(--muted); font-size: 1.05rem; line-height: 1.75; margin-bottom: 32px; max-width: 480px; }
    .hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; }
    .btn-outline { border: 1px solid rgba(16,185,129,.35); color: var(--accent); padding: 11px 24px; border-radius: 8px; font-size: 0.9rem; font-weight: 500; transition: border-color .2s; }
    .btn-outline:hover { border-color: var(--accent); }
    .hero-visual { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; }
    .visual-header { background: var(--bg-el); padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; }
    .dot { width: 10px; height: 10px; border-radius: 50%; }
    .visual-placeholder { padding: 48px 32px; text-align: center; }
    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); }
    .stat { background: var(--bg-el); padding: 20px; text-align: center; }
    .stat-val { font-family: 'Sora', sans-serif; font-size: 1.5rem; font-weight: 800; color: var(--accent); }
    .stat-label { font-size: 0.75rem; color: var(--muted); margin-top: 4px; }
    section { padding: 80px 48px; max-width: 1200px; margin: 0 auto; }
    h2 { font-family: 'Sora', sans-serif; font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; margin-bottom: 16px; letter-spacing: -.02em; }
    .section-sub { color: var(--muted); font-size: 1rem; line-height: 1.7; max-width: 520px; margin-bottom: 48px; }
    .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 28px; transition: border-color .2s; }
    .card:hover { border-color: rgba(16,185,129,.3); }
    .card-icon { width: 48px; height: 48px; background: rgba(16,185,129,.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
    .card h3 { font-family: 'Sora', sans-serif; font-size: 1.05rem; font-weight: 700; margin-bottom: 10px; }
    .card p { color: var(--muted); font-size: 0.88rem; line-height: 1.65; }
    .cta-section { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 64px; text-align: center; margin: 0 48px 80px; }
    .cta-section h2 { font-size: 2rem; margin-bottom: 12px; }
    .cta-section p { color: var(--muted); max-width: 480px; margin: 0 auto 32px; }
    footer { border-top: 1px solid var(--border); padding: 48px; display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 48px; max-width: 1200px; margin: 0 auto; }
    .footer-logo { font-family: 'Sora', sans-serif; font-weight: 800; font-size: 1.1rem; margin-bottom: 12px; }
    .footer-desc { color: var(--muted); font-size: 0.85rem; line-height: 1.7; }
    .footer-col h4 { font-family: 'Sora', sans-serif; font-size: 0.8rem; font-weight: 700; color: var(--dim); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 16px; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .footer-col a { color: var(--muted); font-size: 0.85rem; transition: color .2s; }
    .footer-col a:hover { color: var(--text); }
    .footer-bottom { border-top: 1px solid var(--border); padding: 20px 48px; display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: var(--dim); max-width: 1200px; margin: 0 auto; }
    @media (max-width: 900px) {
      .nav { padding: 16px 24px; } .nav-links { display: none; }
      .hero { grid-template-columns: 1fr; padding: 60px 24px 48px; gap: 40px; }
      .cards { grid-template-columns: 1fr; }
      section { padding: 60px 24px; }
      .cta-section { margin: 0 24px 60px; padding: 40px 24px; }
      footer { grid-template-columns: 1fr; padding: 40px 24px; gap: 32px; }
      .footer-bottom { padding: 16px 24px; flex-direction: column; gap: 8px; }
    }
  </style>
</head>
<body>
  <nav class="nav">
    <div class="logo">
      <div class="logo-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M12 22C12 22 4 16 4 9a8 8 0 0 1 16 0c0 7-8 13-8 13z"/><circle cx="12" cy="9" r="2.5" fill="white" stroke="none"/></svg>
      </div>
      Werner GaLaBau
    </div>
    <ul class="nav-links">
      <li><a href="#leistungen">Leistungen</a></li>
      <li><a href="#projekte">Projekte</a></li>
      <li><a href="#ueber-uns">Über uns</a></li>
      <li><a href="#kontakt">Kontakt</a></li>
    </ul>
    <a href="#kontakt" class="btn">Angebot anfragen</a>
  </nav>

  <div class="hero">
    <div>
      <div class="badge"><span class="badge-dot"></span> Frankfurt · GaLaBau · Zertifizierter Fachbetrieb</div>
      <h1>Ihr Außenbereich<br>in besten Händen.<br><span>Werner GaLaBau.</span></h1>
      <p>Werner GaLaBau GmbH realisiert Garten- und Landschaftsbauprojekte jeder Größe — von der privaten Terrasse bis zur großflächigen Gewerbeanlage. Verlässlich, termingerecht, zertifiziert.</p>
      <div class="hero-ctas">
        <a href="#kontakt" class="btn">Kostenloses Angebot</a>
        <a href="#leistungen" class="btn-outline">Unsere Leistungen</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="visual-header">
        <div class="dot" style="background:#EF4444"></div>
        <div class="dot" style="background:#F59E0B"></div>
        <div class="dot" style="background:#22C55E"></div>
      </div>
      <div class="visual-placeholder">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="1.5" style="opacity:.3;display:block;margin:0 auto 12px"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <div class="stats">
          <div class="stat"><div class="stat-val">ISO</div><div class="stat-label">Zertifiziert</div></div>
          <div class="stat"><div class="stat-val">450+</div><div class="stat-label">Projekte</div></div>
          <div class="stat"><div class="stat-val">10+</div><div class="stat-label">Jahre</div></div>
        </div>
      </div>
    </div>
  </div>

  <section id="leistungen">
    <h2>Unsere Leistungen</h2>
    <p class="section-sub">Werner GaLaBau steht für handwerkliche Exzellenz und professionelle Projektabwicklung — pünktlich, sauber und mit zertifizierter Qualität.</p>
    <div class="cards">
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg></div>
        <h3>Neuanlage</h3>
        <p>Wir planen und realisieren Gärten, Außenanlagen und Grünflächen von Grund auf — präzise nach Ihren Vorgaben und termingerecht.</p>
      </div>
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><path d="M12 22V12M12 12L6 6M12 12l6-6"/><rect x="2" y="20" width="20" height="2" rx="1"/></svg></div>
        <h3>Pflasterarbeiten</h3>
        <p>Einfahrten, Hofflächen, Parkplätze — fachgerecht gepflastert in Naturstein, Betonpflaster oder Klinker für Privat und Gewerbe.</p>
      </div>
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></div>
        <h3>Rasenpflege</h3>
        <p>Mähservice, Vertikutieren, Düngen, Bewässerungsanlagen — wir halten Ihren Rasen das ganze Jahr in Topform.</p>
      </div>
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><path d="M6 3l6 18M6 3c0 0 6 4 12 0"/><path d="M6 3C6 3 0 7 0 15c0 3.87 2.69 5.97 6 6"/></svg></div>
        <h3>Gehölzschnitt</h3>
        <p>Fachgerechter Formschnitt, Kronenpflege und Fällarbeiten — wir sorgen für gesunde Bäume und ordentlich gestaltete Hecken.</p>
      </div>
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg></div>
        <h3>Gewerbebetreuung</h3>
        <p>Regelmäßige Pflege von Firmengeländen, Wohnanlagen und öffentlichen Grünflächen — zuverlässig und diskret nach Vereinbarung.</p>
      </div>
      <div class="card">
        <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
        <h3>Winterdienst</h3>
        <p>Schneeräumung und Streudienst für Firmengelände und Wohnanlagen — pünktlich, zuverlässig und auf Wunsch mit Bereitschaftsvertrag.</p>
      </div>
    </div>
  </section>

  <div class="cta-section" id="kontakt">
    <div class="badge" style="margin:0 auto 20px"><span class="badge-dot"></span> Jetzt anfragen</div>
    <h2>Ihr Projekt, unsere Expertise.</h2>
    <p>Wir besichtigen Ihr Objekt kostenlos und erstellen Ihnen ein transparentes Angebot. Profitieren Sie von unserer zertifizierten Fachkompetenz.</p>
    <a href="tel:+49" class="btn" style="font-size:1rem;padding:14px 32px">Jetzt anrufen</a>
  </div>

  <footer>
    <div>
      <div class="footer-logo">Werner GaLaBau GmbH</div>
      <p class="footer-desc">Zertifizierter Garten- und Landschaftsbaubetrieb im Rhein-Main-Gebiet. Für anspruchsvolle Projekte bei Privat- und Gewerbekunden.</p>
    </div>
    <div class="footer-col">
      <h4>Leistungen</h4>
      <ul>
        <li><a href="#">Neuanlage</a></li>
        <li><a href="#">Pflasterarbeiten</a></li>
        <li><a href="#">Rasenpflege</a></li>
        <li><a href="#">Gehölzschnitt</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Kontakt</h4>
      <ul>
        <li><a href="#">Frankfurt am Main</a></li>
        <li><a href="mailto:info@werner-galabau.de">info@werner-galabau.de</a></li>
        <li><a href="#">Impressum</a></li>
        <li><a href="#">Datenschutz</a></li>
      </ul>
    </div>
  </footer>
  <div class="footer-bottom">
    <span>© 2025 Werner GaLaBau GmbH</span>
    <span>Website von <a href="https://elevo.solutions" style="color:var(--accent)">ELEVO</a></span>
  </div>
<!-- ELEVO Branding Banner -->
<style>
  .elevo-banner { position: fixed; bottom: 0; left: 0; right: 0; z-index: 9999; background: linear-gradient(135deg, #0A0E1A 0%, #111827 100%); border-top: 2px solid #3B82F6; padding: 12px 24px; display: flex; align-items: center; justify-content: center; gap: 12px; font-family: "Sora", sans-serif; box-shadow: 0 -4px 20px rgba(0,0,0,.5); }
  .elevo-banner-badge { background: #3B82F6; color: #fff; font-size: 0.7rem; font-weight: 700; padding: 4px 10px; border-radius: 4px; text-transform: uppercase; letter-spacing: .08em; }
  .elevo-banner-text { color: #E2E8F0; font-size: 0.85rem; font-weight: 400; }
  .elevo-banner-link { color: #3B82F6; font-weight: 700; text-decoration: none; transition: color .2s; }
  .elevo-banner-link:hover { color: #60A5FA; }
  .elevo-banner-arrow { display: inline-block; margin-left: 4px; transition: transform .2s; }
  .elevo-banner-link:hover .elevo-banner-arrow { transform: translateX(3px); }
</style>
<div class="elevo-banner">
  <span class="elevo-banner-badge">Preview</span>
  <span class="elevo-banner-text">Diese Website-Vorschau wurde erstellt von</span>
  <a href="https://elevo.solutions" target="_blank" rel="noopener" class="elevo-banner-link">ELEVO<span class="elevo-banner-arrow">&rarr;</span></a>
</div>
</body>
</html>
