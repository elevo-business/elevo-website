---
import PreviewLayout from '../../templates/layouts/PreviewLayout.astro';
import { zahnarztAngstProfile } from '../../templates/config/zahnarzt-themes';
import PreviewNav from '../../templates/sections/PreviewNav.astro';
import ZahnarztHero from '../../templates/sections/zahnarzt/ZahnarztHero.astro';
import ZahnarztServices from '../../templates/sections/zahnarzt/ZahnarztServices.astro';
import ZahnarztAnxiety from '../../templates/sections/zahnarzt/ZahnarztAnxiety.astro';
import ZahnarztTimeline from '../../templates/sections/zahnarzt/ZahnarztTimeline.astro';
import ZahnarztBeforeAfter from '../../templates/sections/zahnarzt/ZahnarztBeforeAfter.astro';
import ZahnarztCostCalc from '../../templates/sections/zahnarzt/ZahnarztCostCalc.astro';
import PreviewTestimonials from '../../templates/sections/PreviewTestimonials.astro';
import PreviewCTA from '../../templates/sections/PreviewCTA.astro';
import PreviewFooter from '../../templates/sections/PreviewFooter.astro';
import type { ProspectData } from '../../templates/config/types';

const prospect: ProspectData = {
  name: 'Zahnarztpraxis Fischer',
  tagline: 'Zahnarzt ohne Angst in Frankfurt',
  location: 'Frankfurt am Main',
  email: 'info@zahnarzt-fischer-frankfurt.de',
  phone: '+49 69 1234567',
  heroTitle: 'Der Zahnarztbesuch, vor dem Sie keine Angst haben müssen.',
  heroSubtitle: '2.000 Angstpatienten haben bei uns den ersten Schritt gewagt. Schmerzfreie Methoden, Ihr Tempo, ein Team das zuhört. Praxis Fischer in Frankfurt — damit Zahnarztangst Vergangenheit wird.',
  services: [
    { icon: 'heart', title: 'Angstpatienten-Betreuung', description: 'Einfühlsame Begleitung für Patienten mit Zahnarztangst — wir nehmen uns die Zeit, die Sie brauchen.' },
    { icon: 'shield', title: 'Schmerzfreie Behandlung', description: 'Modernste Anästhesiemethoden für eine nahezu schmerzfreie Behandlungserfahrung.' },
    { icon: 'tooth', title: 'Vollnarkose & Dämmerschlaf', description: 'Behandlung unter Vollnarkose oder mit Lachgas — für eine entspannte Atmosphäre ohne Stress.' },
    { icon: 'smile', title: 'Ästhetische Zahnheilkunde', description: 'Bleaching, Veneers und Zahnkorrekturen für ein strahlendes Lächeln.' },
    { icon: 'check', title: 'Prophylaxe & Vorsorge', description: 'Professionelle Zahnreinigung und individuelle Vorsorge für langfristige Zahngesundheit.' },
    { icon: 'clock', title: 'Flexible Terminvergabe', description: 'Kurze Wartezeiten, flexible Abendtermine — Behandlung, die in Ihren Alltag passt.' },
  ],
  stats: [
    { value: '15+', label: 'Jahre Erfahrung' },
    { value: '2.000+', label: 'Angstpatienten behandelt' },
    { value: '98%', label: 'Empfehlungsrate' },
  ],
};
---

<PreviewLayout profile={zahnarztAngstProfile} prospect={prospect}>
  <PreviewNav
    prospectName={prospect.name}
    ctaText="Termin vereinbaren"
    ctaHref="#kontakt"
  />

  <ZahnarztHero
    title={prospect.heroTitle}
    subtitle={prospect.heroSubtitle}
    badge="Angstpatienten willkommen"
    ctaPrimary={{ text: 'Kostenloses Kennenlerngespräch buchen', href: '#kontakt' }}
    ctaSecondary={{ text: 'Wie wir Angstpatienten behandeln →', href: '#angst' }}
    imageSrc="/preview-images/zahnarzt-fischer/hero.jpg"
    imageAlt="Zahnarztpraxis Fischer Frankfurt — einfühlsame Behandlung"
    stats={prospect.stats}
  />

  <ZahnarztAnxiety
    id="angst"
    title="Sie haben Angst vorm Zahnarzt? Damit sind Sie nicht allein."
    quote="Ich hatte 8 Jahre keinen Zahnarzt besucht. Bei Praxis Fischer habe ich mich zum ersten Mal verstanden gefühlt. Heute gehe ich alle 6 Monate — freiwillig."
    quoteAuthor="M. K., Frankfurt"
    trustPoints={[
      { icon: 'heart', title: 'Einfühlsames Team', desc: 'Geschulte Mitarbeiter, die Zahnarztangst ernst nehmen. Kein »Stellen Sie sich nicht so an«.' },
      { icon: 'shield', title: 'Schmerzfreie Methoden', desc: 'Oberflächenbetäubung vor der Spritze. Computergesteuerte Anästhesie. Sie spüren nichts.' },
      { icon: 'hand', title: 'Stopp-Signal', desc: 'Heben Sie die Hand, wir stoppen sofort. Keine Ausnahmen.' },
      { icon: 'smile', title: 'Entspannte Atmosphäre', desc: 'Kopfhörer mit Musik, Decken, gedämpftes Licht. Kein klinisches Weiß.' },
    ]}
  />

  <ZahnarztServices
    title="Unsere Leistungen für Sie"
    subtitle="Von der Angstbehandlung bis zur ästhetischen Zahnheilkunde — alles unter einem Dach."
    services={prospect.services}
  />

  <ZahnarztTimeline
    title="Ihr Tempo. Ihre Regeln."
    subtitle="Wir behandeln Sie erst, wenn Sie bereit sind. Nicht eine Sekunde früher."
    steps={[
      { num: 1, title: 'Gespräch ohne Stuhl', desc: 'Kein Behandlungszimmer beim ersten Mal. Nur ein ruhiges Gespräch. Sie erzählen, wir hören zu.', icon: 'chat' },
      { num: 2, title: 'Gemeinsame Planung', desc: 'Sie bestimmen das Tempo. Wir erklären jeden Schritt vorher. Nichts passiert ohne Ihr OK.', icon: 'calendar' },
      { num: 3, title: 'Sanfte Behandlung', desc: 'Modernste Betäubung, Dämmerschlaf wenn gewünscht. Ihr Stopp-Signal gilt sofort. Immer.', icon: 'tooth' },
      { num: 4, title: 'Nachsorge & Begleitung', desc: 'Wir bleiben dran. Regelmäßige Termine in kleinen Schritten — bis der Zahnarztbesuch normal wird.', icon: 'check' },
    ]}
  />

  <ZahnarztBeforeAfter
    title="Behandlungsergebnisse"
    subtitle="Sehen Sie selbst, was mit moderner Zahnheilkunde möglich ist."
    cases={[
      { beforeSrc: '/preview-images/zahnarzt-fischer/gallery-1.jpg', afterSrc: '/preview-images/zahnarzt-fischer/gallery-2.jpg', label: 'Komplett-Sanierung' },
      { beforeSrc: '/preview-images/zahnarzt-fischer/gallery-3.jpg', afterSrc: '/preview-images/zahnarzt-fischer/gallery-4.jpg', label: 'Ästhetische Korrektur' },
    ]}
  />

  <ZahnarztCostCalc />

  <PreviewTestimonials
    title="Was unsere Patienten sagen"
    testimonials={[
      { text: 'Endlich wieder ohne Angst zum Zahnarzt! Das Team hat mich so behutsam behandelt, ich konnte kaum glauben, wie entspannt alles war.', author: 'Sandra M.', role: 'Patientin seit 3 Jahren' },
      { text: 'Herr Fischer hat mir meine langjährige Zahnarztphobie genommen. Kompetent, geduldig und immer einfühlsam.', author: 'Thomas R.', role: 'Angstpatient' },
      { text: 'Die Lachgasbehandlung war ein Gamechanger für mich. Endlich schmerzfrei und entspannt beim Zahnarzt.', author: 'Petra K.', role: 'Patientin' },
    ]}
  />

  <PreviewCTA
    title="Bereit für den ersten Schritt? Wir sind es auch."
    subtitle="Kein Stuhl, kein Instrument — nur ein ruhiges Gespräch. Kostenloses Kennenlernen, ganz ohne Druck."
    ctaText="Kostenloses Kennenlerngespräch buchen"
    ctaHref={`mailto:${prospect.email}`}
    phone={prospect.phone}
  />

  <PreviewFooter
    prospectName={prospect.name}
    email={prospect.email}
    phone={prospect.phone}
    location={prospect.location}
    year={2025}
  />
</PreviewLayout>
