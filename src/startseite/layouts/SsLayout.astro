---
// Eigenes Layout der Startseite: ohne seitenweites Tracking (kein Pixel, kein Google-Tag), Inter lokal.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.css';
import ss from '../../config/startseite.json';
import ConsentBanner from '../components/ConsentBanner.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Banner auf /danke erneut zeigen, solange keine Zustimmung vorliegt und ein Lead offen ist */
  consentOnPendingLead?: boolean;
  /** Seite hat einen schwebenden CTA (nur Startseite) */
  stickyCta?: boolean;
}

const { title, description, noindex = false, consentOnPendingLead = false, stickyCta = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogPath = existsSync(join(process.cwd(), 'public', ss.seo.ogImage)) ? ss.seo.ogImage : ss.seo.ogImageFallback;
const ogImage = new URL(ogPath, Astro.site).href;
const { navy, offwhite, gold } = ss.brand;
const isColor = (c: string) => /^#[0-9a-fA-F]{3,8}$/.test(c);
const brandVars = [isColor(navy) && `--color-navy:${navy}`, isColor(offwhite) && `--color-offwhite:${offwhite}`, isColor(gold) && `--color-gold:${gold}`]
  .filter(Boolean)
  .join(';');
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: ss.brand.legalName,
  url: new URL('/', Astro.site).href,
  logo: new URL(ss.brand.logo, Astro.site).href,
  email: ss.legal.email,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={offwhite} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={ss.brand.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    {brandVars && <style is:inline set:html={`:root{${brandVars}}`} />}
  </head>
  <body class="min-h-dvh">
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-navy">
      Zum Inhalt springen
    </a>
    <slot />
    <Footer stickySpace={stickyCta} />
    <ConsentBanner showOnPendingLead={consentOnPendingLead} />
  </body>
</html>
