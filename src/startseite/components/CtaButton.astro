---
import ss from '../../config/startseite.json';
interface Props {
  label?: string;
  class?: string;
  hero?: boolean;
}
const { label = ss.hero.ctaText, class: className, hero = false } = Astro.props;
---

<a href="#formular" class:list={['btn-cta', className]} data-to-quiz data-hero-cta={hero ? '' : undefined}>
  {label}
  <svg class="arrow size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
</a>
