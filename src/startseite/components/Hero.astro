---
// Baustein 1: Problem. Links die These, rechts (Desktop) die Gliederung der Thesis wie in einem Dokument.
import ss from '../../config/startseite.json';
import Rich from './Rich.astro';
import CtaButton from './CtaButton.astro';
import VideoFacade from './VideoFacade.astro';

const { eyebrow, h1, subheadline, subheadlineMobile, ctaText, microcopy, outlineTitle } = ss.problem;
const outline = [ss.problem.label, ss.hypothesis.label, ss.antithesis.label, ss.diagnosis.label, ss.mechanism.label, ss.proof.label, ss.pilot.label];
---

<section class="mx-auto max-w-[1080px] px-4 pt-10 sm:pt-16" aria-labelledby="hero-titel">
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-16">
    <div>
      <p class="flex items-center gap-3 text-[13px] font-semibold tracking-[0.01em] text-muted sm:text-[15px]">
        <span class="h-px w-6 shrink-0 bg-gold sm:w-8" aria-hidden="true"></span>{eyebrow}
      </p>
      <h1 id="hero-titel" class="mt-5 font-serif text-[clamp(1.75rem,8.1vw,2.125rem)] leading-[1.06] font-medium tracking-[-0.02em] [text-wrap:pretty] text-navy sm:text-[3.25rem] lg:text-[3.75rem]">
        <Rich text={h1} />
      </h1>
      {subheadlineMobile && <p class="mt-5 max-w-[34rem] text-pretty text-muted sm:hidden">{subheadlineMobile}</p>}
      <p class:list={['mt-6 max-w-[36rem] text-pretty text-muted sm:text-[19px]', subheadlineMobile && 'hidden sm:block']}>{subheadline}</p>
      <div class="mt-7 flex flex-col gap-3 sm:mt-9 sm:flex-row sm:items-center sm:gap-6">
        <CtaButton label={ctaText} hero class="sm:w-auto sm:px-8" />
        {microcopy && <p class="text-sm text-muted">{microcopy}</p>}
      </div>
    </div>

    <aside class="mt-14 hidden self-end border-t border-navy pt-4 lg:block" aria-label={outlineTitle}>
      <p class="rubric">{outlineTitle}</p>
      <ol class="mt-4 space-y-0 text-[15px]">
        {outline.map((label, i) => (
          <li class="flex gap-4 border-b border-rule py-2.5 text-navy">
            <span class="w-6 font-serif text-gold-text tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <span>{label}</span>
          </li>
        ))}
      </ol>
    </aside>
  </div>
</section>

<VideoFacade />
