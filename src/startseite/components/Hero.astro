---
// Hero: ganz oben der Offer-Satz (was, für wen, Methode, Ergebnis), darunter Button, Porträt und Vertrauen. Kein Bild.
import { Image } from 'astro:assets';
import ss from '../../config/startseite.json';
import Rich from './Rich.astro';
import CtaButton from './CtaButton.astro';
import CheckIcon from './CheckIcon.astro';
import portrait from '../images/mert-efe-celik.jpg';

const { eyebrow, h1, subheadline, subheadlineMobile, ctaText, microcopy, trust, trustFootnote, personLine } = ss.hero;
---

<section class="relative overflow-hidden" aria-labelledby="hero-titel">
  <!-- ruhiger Hintergrund: feines Raster, nach unten ausgeblendet -->
  <div class="hero-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto max-w-[920px] px-4 pt-12 pb-4 text-center sm:pt-20">
    <p class="inline-flex items-center gap-2 rounded-xl border border-line bg-white px-3.5 py-1.5 text-[12.5px] font-medium text-ink shadow-sm sm:rounded-full sm:text-[14px]">
      <span class="size-1.5 shrink-0 rounded-full bg-brand-blue" aria-hidden="true"></span>{eyebrow}
    </p>
    <h1 id="hero-titel" class="mt-6 text-[clamp(1.5rem,6.9vw,2rem)] leading-[1.12] font-semibold tracking-[-0.035em] text-balance text-ink sm:text-[3rem] lg:text-[3.5rem]">
      <Rich text={h1} />
    </h1>
    {subheadlineMobile && <p class="mx-auto mt-5 max-w-[40rem] text-pretty text-muted sm:hidden">{subheadlineMobile}</p>}
    <p class:list={['mx-auto mt-6 max-w-[40rem] text-pretty text-muted sm:text-[19px]', subheadlineMobile && 'hidden sm:block']}>{subheadline}</p>

    <div class="mx-auto mt-8 flex max-w-md flex-col items-center gap-4 sm:mt-10">
      <CtaButton label={ctaText} hero class="sm:w-auto sm:px-10" />
      <div class="flex items-center gap-3 text-left">
        <Image src={portrait} alt="" width={96} height={96} class="size-10 shrink-0 rounded-full object-cover object-[50%_15%] ring-2 ring-white" loading="eager" />
        <p class="text-sm leading-snug text-muted"><span class="font-semibold text-ink">{personLine}</span> {microcopy}</p>
      </div>
    </div>

    <ul class="mx-auto mt-10 grid max-w-[860px] gap-3 text-left text-[15px] text-ink sm:grid-cols-3 sm:gap-4">
      {trust.map((item) => (
        <li class="flex gap-2.5 rounded-xl border border-line bg-white/80 px-4 py-3 shadow-sm backdrop-blur"><CheckIcon class="mt-1 size-4 text-accent" /><span>{item}</span></li>
      ))}
    </ul>
    {trustFootnote && <p class="mt-3 text-[12px] leading-snug text-muted">{trustFootnote}</p>}
  </div>
</section>
