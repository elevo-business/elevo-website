---
// Hero: ganz oben der Offer-Satz (was, für wen, Methode, Ergebnis), darunter Button, Vertrauen, Porträt, Bild.
import { Image } from 'astro:assets';
import ss from '../../config/startseite.json';
import Rich from './Rich.astro';
import CtaButton from './CtaButton.astro';
import Figure from './Figure.astro';
import CheckIcon from './CheckIcon.astro';
import heroWide from '../images/kanzlei-erstgespraech-anwaeltin-hero.jpg';
import heroTall from '../images/kanzlei-erstgespraech-anwaeltin-hochformat.jpg';
import portrait from '../images/mert-efe-celik.jpg';

const { eyebrow, h1, subheadline, subheadlineMobile, ctaText, microcopy, trust, trustFootnote, personLine, image } = ss.hero;
---

<section class="mx-auto max-w-[1160px] px-4 pt-8 sm:pt-14" aria-labelledby="hero-titel">
  <div class="lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-12">
    <div class="lg:col-span-7">
      <p class="flex items-center gap-3 text-[13px] font-semibold tracking-[0.01em] text-gold-text sm:text-[15px]">
        <span class="h-px w-6 shrink-0 bg-gold sm:w-8" aria-hidden="true"></span>{eyebrow}
      </p>
      <h1 id="hero-titel" class="mt-4 font-serif text-[clamp(1.625rem,7.2vw,2rem)] leading-[1.12] font-medium tracking-[-0.015em] [text-wrap:pretty] text-navy sm:text-[2.75rem] lg:text-[3.125rem]">
        <Rich text={h1} />
      </h1>
      {subheadlineMobile && <p class="mt-4 text-pretty text-muted sm:hidden">{subheadlineMobile}</p>}
      <p class:list={['mt-6 max-w-[36rem] text-pretty text-muted sm:text-[19px]', subheadlineMobile && 'hidden sm:block']}>{subheadline}</p>

      <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:items-center sm:gap-5">
        <CtaButton label={ctaText} hero class="sm:w-auto sm:px-8" />
        <div class="flex items-center gap-3">
          <Image src={portrait} alt="" width={96} height={96} class="size-11 shrink-0 rounded-full object-cover object-[50%_15%]" loading="eager" />
          <p class="text-sm leading-snug text-muted"><span class="block font-semibold text-navy">{personLine}</span>{microcopy}</p>
        </div>
      </div>

      <ul class="mt-7 grid gap-2 border-t border-rule pt-5 text-[15px] text-navy sm:grid-cols-3 sm:gap-4">
        {trust.map((item) => (
          <li class="flex gap-2.5"><CheckIcon class="mt-1 size-4 text-gold-text" /><span>{item}</span></li>
        ))}
      </ul>
      {trustFootnote && <p class="mt-3 text-[12px] leading-snug text-muted">{trustFootnote}</p>}
    </div>

    <div class="mt-10 lg:col-span-5 lg:mt-0">
      <Figure src={heroWide} alt={image.alt} caption={image.caption} imgClass="aspect-[3/2] object-[55%_30%]" class="lg:hidden" widths={[480, 800, 1200]} sizes="100vw" />
      <Figure src={heroTall} alt={image.alt} caption={image.caption} imgClass="aspect-[4/5] object-[50%_25%]" class="hidden lg:block" widths={[480, 900]} sizes="460px" eager frame />
    </div>
  </div>
</section>
