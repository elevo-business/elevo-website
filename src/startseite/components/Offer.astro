---
// Baustein 7, Teil 1: Angebot. Freie Plätze ändern sich nur über pilot.free in der Config.
import ss from '../../config/startseite.json';
import { fill, isFilled } from '../../neukundensystem/lib/text';
import Section from './Section.astro';
import CtaButton from './CtaButton.astro';

const { total, free, headline, bullets, budgetNote, freeText, soldOut, guaranteeNote, ctaText, label, person } = ss.pilot;
const places = Math.max(0, Math.min(free, total));
const values = { total: String(total), free: String(places) };
---

<Section id="angebot-titel" num="07" label={label}>
  <div class="border-y-4 border-double border-navy bg-paper px-5 py-8 sm:px-10 sm:py-10">
    <h2 id="angebot-titel" class="section-title">{fill(headline, values)}</h2>

    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
      <div class="flex gap-1.5" aria-hidden="true">
        {Array.from({ length: total }, (_, i) => <span class:list={['h-2 w-7', i < total - places ? 'bg-navy' : 'border border-navy']} />)}
      </div>
      <p class="font-semibold text-navy">{places === 0 ? soldOut : fill(freeText, values)}</p>
    </div>

    <ol class="mt-8 border-t border-rule">
      {
        bullets.map((b, i) => (
          <li class="flex gap-4 border-b border-rule py-4">
            <span class="font-serif text-xl text-gold-text">{i + 1}.</span>
            <span><strong class="font-semibold text-navy">{b.bold}</strong> {b.text}</span>
          </li>
        ))
      }
    </ol>

    {budgetNote && <p class="mt-4 text-sm text-muted">{budgetNote}</p>}
    {isFilled(guaranteeNote) && <p class="mt-2 text-sm text-muted">{guaranteeNote}</p>}

    <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      {
        person && isFilled(person.image) && (
          <figure class="flex items-center gap-4">
            <img src={person.image} alt={person.imageAlt} width="64" height="64" loading="lazy" decoding="async" class="size-16 rounded-full object-cover object-[50%_18%] grayscale-[15%]" />
            <figcaption class="leading-snug">
              <span class="block font-serif text-lg text-navy italic">{person.line}</span>
              <span class="block text-sm text-muted">{person.name} · {person.role}</span>
            </figcaption>
          </figure>
        )
      }
      <CtaButton label={ctaText} class="sm:w-auto sm:px-8" />
    </div>
  </div>
</Section>
