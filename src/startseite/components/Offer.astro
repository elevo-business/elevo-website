---
// 05 Das Angebot: zentrierte Karte, Pilotplätze (nur von Hand in der Config), Konditionen, Passt/passt nicht in zwei gleichen Spalten
import ss from '../../config/startseite.json';
import { fill } from '../../neukundensystem/lib/text';
import Section from './Section.astro';
import CtaButton from './CtaButton.astro';
import Figure from './Figure.astro';
import CheckIcon from './CheckIcon.astro';
import img from '../images/unterschrift-mandatsvereinbarung.jpg';

const { label, total, free, headline, intro, bullets, budgetNote, freeText, soldOut, ctaText, image } = ss.pilot;
const { headline: fitHeadline, yesTitle, yes, noTitle, no } = ss.fit;
const places = Math.max(0, Math.min(free, total));
const values = { total: String(total), free: String(places) };
---

<Section id="angebot-titel" num="05" label={label} title={fill(headline, values)} intro={intro}>
  <div class="mx-auto max-w-[860px] overflow-hidden rounded-2xl border border-line bg-white shadow-[0_1px_2px_rgba(11,19,36,.04),0_20px_50px_-30px_rgba(11,19,36,.35)]">
    <Figure src={img} alt={image.alt} imgClass="aspect-[21/8] object-[62%_55%] !rounded-none" class="hidden lg:block [&_.rounded-xl]:rounded-none" sizes="860px" widths={[860]} />
    <div class="px-5 py-8 text-center sm:px-12 sm:py-10">
      <div class="flex flex-col items-center gap-2">
        <div class="flex gap-1.5" aria-hidden="true">
          {Array.from({ length: total }, (_, i) => <span class:list={['h-2 w-8 rounded-full', i < total - places ? 'bg-accent' : 'border border-accent/50']} />)}
        </div>
        <p class="font-semibold text-ink">{places === 0 ? soldOut : fill(freeText, values)}</p>
      </div>
      <ul class="mx-auto mt-8 grid max-w-[720px] gap-4 text-left sm:grid-cols-2">
        {bullets.map((b) => (
          <li class="flex gap-3 rounded-xl bg-surface p-4">
            <CheckIcon class="mt-1 size-4 text-accent" />
            <span><strong class="font-semibold text-ink">{b.bold}</strong>{b.text && ` ${b.text}`}</span>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-sm text-muted">{budgetNote}</p>
      <div class="mt-7 flex justify-center"><CtaButton label={ctaText} class="sm:w-auto sm:px-10" /></div>
    </div>
  </div>

  <h3 class="mt-16 text-center text-[1.625rem] font-semibold tracking-[-0.025em] text-ink sm:text-[2rem]">{fitHeadline}</h3>
  <div class="mx-auto mt-8 grid max-w-[900px] gap-6 sm:grid-cols-2">
    <div class="rounded-2xl border border-line bg-white p-6">
      <h4 class="text-center font-semibold text-ink">{yesTitle}</h4>
      <ul class="mt-4 space-y-3">{yes.map((item) => <li class="flex gap-3"><CheckIcon class="mt-1 size-4 text-accent" /><span>{item}</span></li>)}</ul>
    </div>
    <div class="rounded-2xl border border-line bg-surface p-6">
      <h4 class="text-center font-semibold text-muted">{noTitle}</h4>
      <ul class="mt-4 space-y-3">{no.map((item) => (
        <li class="flex gap-3 text-muted">
          <svg class="mt-1 size-4 shrink-0 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 12h12" /></svg>
          <span>{item}</span>
        </li>
      ))}</ul>
    </div>
  </div>
</Section>
