---
import ss from '../../config/startseite.json';
import Section from './Section.astro';
const items = ss.faq.filter((item) => item.q.trim() !== '');
---

<Section id="faq-titel" num="06" label={ss.faqLabel} title={ss.faqHeadline}>
  <div class="mx-auto max-w-[760px] divide-y divide-line rounded-2xl border border-line bg-white shadow-sm">
    {
      items.map((item) => (
        <details class="group px-6">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-5 text-left text-[1.0625rem] leading-snug font-semibold text-ink">
            <span>{item.q}</span>
            <svg class="size-4 shrink-0 text-accent transition-transform duration-300 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          </summary>
          <div class="pb-6 text-muted">{item.a}</div>
        </details>
      ))
    }
  </div>
</Section>
