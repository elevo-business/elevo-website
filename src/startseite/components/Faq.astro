---
import ss from '../../config/startseite.json';
import Section from './Section.astro';
const items = ss.faq.filter((item) => item.q.trim() !== '');
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---

<Section id="faq-titel" label={ss.faqLabel}>
  <h2 id="faq-titel" class="section-title">{ss.faqHeadline}</h2>
  <div class="mt-8 border-t border-navy">
    {
      items.map((item) => (
        <details class="group border-b border-rule">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-5 text-left font-serif text-[1.25rem] leading-snug text-navy">
            <span>{item.q}</span>
            <svg class="size-4 shrink-0 text-gold-text transition-transform duration-300 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <div class="pb-6 text-muted">{item.a}</div>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Section>
