---
// Baustein 3: Antithese – wo Mandate wirklich verloren gehen
import ss from '../../config/startseite.json';
import Section from './Section.astro';
const { headline, items, label } = ss.antithesis;
---

<Section id="antithese-titel" num="03" label={label}>
  <h2 id="antithese-titel" class="section-title">{headline}</h2>
  <ul class="mt-8 border-t border-rule">
    {
      items.map((item) => (
        <li class="flex items-start gap-4 border-b border-rule py-5">
          <svg class="mt-1.5 size-4 shrink-0 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
          <span class="font-serif text-[1.375rem] leading-[1.3] text-navy sm:text-[1.5rem]">{item}</span>
        </li>
      ))
    }
  </ul>
</Section>
