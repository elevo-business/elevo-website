---
// Baustein 5: Mechanismus – erst der Prozess, dann die Anzeigen.
// Die Prozess-Grafik ist das einzige animierte Element (Nummern nacheinander, Linie füllt sich).
import ss from '../../config/startseite.json';
import Rich from './Rich.astro';
const { headline, intro, steps, then, label } = ss.mechanism;
---

<section class="mx-auto mt-20 max-w-[1080px] px-4 sm:mt-28" aria-labelledby="mechanismus-titel">
  <div class="border-t border-rule pt-6 lg:grid lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-12">
    <p class="rubric mb-6 self-start lg:mb-0">05 — {label}</p>
    <div class="max-w-[720px]">
      <h2 id="mechanismus-titel" class="section-title"><Rich text={headline} /></h2>
      <p class="mt-5 text-pretty">{intro}</p>
    </div>
  </div>

  <div class="process relative mt-12 lg:mt-16" data-process>
    <!-- Verbindungslinie: Handy senkrecht, Desktop waagerecht -->
    <div class="absolute top-6 bottom-6 left-6 w-px bg-rule lg:top-6 lg:right-[10%] lg:bottom-auto lg:left-[10%] lg:h-px lg:w-auto" aria-hidden="true">
      <div class="process-line-fill h-full w-full bg-gold"></div>
    </div>
    <ol class="relative grid gap-8 lg:grid-cols-5 lg:gap-6">
      {
        steps.map((step, i) => (
          <li class="process-step flex gap-5 lg:flex-col lg:items-center lg:text-center" style={`--i:${i}`}>
            <span class="relative z-10 grid size-12 shrink-0 place-items-center rounded-full bg-navy font-serif text-[1.375rem] text-gold ring-8 ring-offwhite" aria-hidden="true">{i + 1}</span>
            <div class="pt-2 lg:pt-0">
              <h3 class="font-serif text-[1.375rem] leading-tight font-medium text-navy">{step.title}</h3>
              <p class="mt-1.5 text-[16px] leading-[1.55] text-muted">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="mt-14 lg:grid lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-12">
    <div></div>
    <div class="max-w-[720px] border-l-2 border-gold pl-6">
      <h3 class="font-serif text-[1.75rem] leading-tight font-medium text-navy">{then.title}</h3>
      <p class="mt-2 text-pretty">{then.text}</p>
    </div>
  </div>
</section>

<script>
  // Startet die Animation, sobald die Grafik ins Bild kommt (einmalig)
  const process = document.querySelector<HTMLElement>('[data-process]');
  if (process) {
    if (!('IntersectionObserver' in window)) process.classList.add('is-visible');
    else {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            process.classList.add('is-visible');
            observer.disconnect();
          }
        },
        { threshold: 0.1 },
      );
      observer.observe(process);
    }
  }
</script>
