---
// 01 Ihr Alltag: Szenen zum Wiedererkennen, symmetrisch im Raster
import ss from '../../config/startseite.json';
import Section from './Section.astro';
import Figure from './Figure.astro';
import img from '../images/anwaeltin-telefon-schreibtisch-ordner.jpg';
const { label, headline, scenes, closing, image } = ss.alltag;
---

<Section id="alltag-titel" num="01" label={label} title={headline}>
  <Figure src={img} alt={image.alt} caption={image.caption} imgClass="aspect-[21/9] object-[42%_40%]" class="mx-auto mb-10 hidden max-w-[900px] text-center lg:block" sizes="900px" widths={[900]} />
  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {scenes.map((scene) => (
      <li class="rounded-2xl border border-line bg-white p-5 text-center shadow-sm sm:p-6">
        <h3 class="text-[1.125rem] font-semibold tracking-[-0.01em] text-ink">{scene.title}</h3>
        <p class="mt-2 text-[15px] leading-[1.6] text-muted">{scene.text}</p>
      </li>
    ))}
  </ol>
  <p class="mx-auto mt-10 max-w-[680px] text-center text-[1.25rem] leading-snug font-semibold text-pretty text-ink sm:text-[1.375rem]">{closing}</p>
</Section>
