---
// 01 Ihr Alltag: Szenen, in denen sich Kanzleiinhaber wiedererkennen
import ss from '../../config/startseite.json';
import Section from './Section.astro';
import Figure from './Figure.astro';
import img from '../images/anwaeltin-telefon-schreibtisch-ordner.jpg';
const { label, headline, scenes, closing, image } = ss.alltag;
---

<Section id="alltag-titel" num="01" label={label} wide>
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-12">
    <div>
      <h2 id="alltag-titel" class="section-title">{headline}</h2>
      <ol class="mt-8 grid gap-x-8 sm:grid-cols-2">
        {scenes.map((scene) => (
          <li class="border-t border-rule py-4 sm:py-5">
            <h3 class="font-serif text-[1.25rem] leading-snug font-medium text-navy">{scene.title}</h3>
            <p class="mt-1 text-[15px] leading-[1.55] text-muted sm:text-[16px]">{scene.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-4 border-l-2 border-gold pl-5 font-serif text-[1.375rem] leading-snug text-pretty text-navy">{closing}</p>
    </div>
    <Figure src={img} alt={image.alt} caption={image.caption} imgClass="aspect-[3/2] object-[42%_40%] lg:aspect-[4/5]" class="hidden lg:sticky lg:top-8 lg:mt-2 lg:block lg:self-start" sizes="340px" />
  </div>
</Section>
