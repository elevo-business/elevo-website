---
// Thesis-Video als Facade: Vor dem Klick lädt nur das lokale Posterbild, der Player (Bunny Stream EU oder
// Vimeo mit dnt=1) erst nach dem Klick. Ohne Video-ID wird der Block nicht angezeigt (offener Platzhalter).
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ss from '../../config/startseite.json';
import { fill, isFilled } from '../../neukundensystem/lib/text';

const video = ss.video;
let embedUrl = '';
if (video.provider === 'bunny' && isFilled(video.bunnyLibraryId) && isFilled(video.videoId)) {
  embedUrl = `https://iframe.mediadelivery.net/embed/${encodeURIComponent(video.bunnyLibraryId)}/${encodeURIComponent(video.videoId)}?autoplay=true&preload=true&responsive=true`;
} else if (video.provider === 'vimeo' && isFilled(video.videoId)) {
  embedUrl = `https://player.vimeo.com/video/${encodeURIComponent(video.videoId)}?dnt=1&autoplay=1`;
}
const poster = video.poster && existsSync(join(process.cwd(), 'public', video.poster)) ? video.poster : undefined;
const providerName = video.provider === 'vimeo' ? 'Vimeo' : video.providerName;
const hint = fill(video.providerHint, { anbieter: providerName });
---

{
  embedUrl && (
    <figure class="mx-auto mt-10 max-w-[720px] px-4">
      <div class="relative aspect-video overflow-hidden rounded-2xl bg-navy shadow-lg" data-video-embed={embedUrl} data-title={video.title}>
        {poster && <img src={poster} alt="" width="1280" height="720" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />}
        <button type="button" class="absolute inset-0 flex cursor-pointer flex-col items-center justify-center gap-3 bg-navy/40 p-4 text-center" data-video-start>
          <span class="grid size-16 place-items-center rounded-full bg-gold shadow-lg" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="#0E1A30"><path d="M8 5v14l11-7z" /></svg>
          </span>
          <span class="text-base font-semibold text-white">{video.playButton}</span>
          <span class="max-w-[16rem] text-xs text-white/90">{hint}</span>
        </button>
      </div>
      {video.caption && <figcaption class="mt-3 text-center text-[15px] text-muted">{video.caption}</figcaption>}
    </figure>
  )
}

<script>
  for (const wrap of document.querySelectorAll<HTMLElement>('[data-video-embed]')) {
    wrap.querySelector<HTMLButtonElement>('[data-video-start]')?.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = wrap.dataset.videoEmbed ?? '';
        iframe.title = wrap.dataset.title ?? 'Video';
        iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
        iframe.allowFullscreen = true;
        iframe.className = 'absolute inset-0 h-full w-full border-0';
        wrap.replaceChildren(iframe);
        iframe.focus();
      },
      { once: true },
    );
  }
</script>
