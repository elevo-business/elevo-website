---
// 04 Die Ergebnisse: nur belegte Zahlen, ehrlicher Hinweis, dazu Über mich mit echtem Porträt
import { Image } from 'astro:assets';
import ss from '../../config/startseite.json';
import Section from './Section.astro';
import Rich from './Rich.astro';
import CheckIcon from './CheckIcon.astro';
import portrait from '../images/mert-efe-celik.jpg';
const { label, headline, items, note, about } = ss.ergebnisse;
---

<Section id="ergebnisse-titel" num="04" label={label} wide>
  <h2 id="ergebnisse-titel" class="section-title max-w-[760px]"><Rich text={headline} /></h2>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {items.map((item) => (
      <article class="border-t-2 border-navy bg-paper p-6 lg:p-8">
        <p class="font-serif text-[2.75rem] leading-none font-normal tracking-[-0.025em] text-navy lg:text-[3.5rem]">{item.value}</p>
        <p class="mt-3 font-medium text-gold-text">{item.label}</p>
        {item.points.length > 0 && (
          <ul class="mt-4 space-y-1.5 text-[15px] text-navy">
            {item.points.map((point) => <li class="flex gap-2"><CheckIcon class="mt-1 size-4 text-gold-text" /><span>{point}</span></li>)}
          </ul>
        )}
        <h3 class="mt-6 text-[12px] font-semibold tracking-[0.16em] text-navy uppercase">{item.name}</h3>
        <p class="text-[14px] text-muted">{item.branche}</p>
      </article>
    ))}
  </div>
  <p class="mt-6 max-w-[720px] border-l-2 border-gold pl-5 text-pretty text-navy">{note}</p>

  <div class="mt-10 grid gap-6 border-t border-rule pt-8 sm:mt-14 sm:grid-cols-[160px_minmax(0,1fr)] sm:gap-8">
    <Image src={portrait} alt={about.imageAlt} width={320} height={400} class="aspect-[4/5] w-32 object-cover object-[50%_18%] sm:w-40" />
    <div>
      <h3 class="font-serif text-[1.5rem] leading-tight font-medium text-navy">{about.name}</h3>
      <p class="text-sm text-muted">{about.role}</p>
      <p class="mt-3 max-w-[640px] text-pretty">{about.text}</p>
      <dl class="mt-5 flex flex-wrap gap-x-10 gap-y-3">
        {about.facts.map((f) => (
          <div><dt class="sr-only">{f.label}</dt><dd><span class="block font-serif text-[1.75rem] leading-none text-navy">{f.value}</span><span class="mt-1 block text-sm text-muted">{f.label}</span></dd></div>
        ))}
      </dl>
    </div>
  </div>
</Section>
