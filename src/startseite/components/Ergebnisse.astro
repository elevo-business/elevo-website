---
// 04 Die Ergebnisse: zwei gleich große Karten mit Logo, ehrlicher Hinweis, Über mich zentriert
import { Image } from 'astro:assets';
import ss from '../../config/startseite.json';
import Section from './Section.astro';
import CheckIcon from './CheckIcon.astro';
import portrait from '../images/mert-efe-celik.jpg';
import { logos } from '../lib/logos';
const { label, headline, items, note, about } = ss.ergebnisse;
---

<Section id="ergebnisse-titel" num="04" label={label} title={headline}>
  <div class="mx-auto grid max-w-[900px] gap-6 md:grid-cols-2">
    {items.map((item) => (
      <article class="flex flex-col items-center rounded-2xl border border-line bg-white p-8 text-center shadow-sm">
        <div class="flex h-12 items-center gap-3">
          <Image src={logos[item.logo]} alt={`Logo von ${item.name}`} height={80} class="h-10 w-auto" />
          {item.logo === 'logo-bml' && <span class="text-[17px] font-semibold text-ink">BrandsMarketingLab</span>}
        </div>
        <p class="mt-6 text-[2.75rem] leading-none font-semibold tracking-[-0.04em] text-ink lg:text-[3.25rem]">{item.value}</p>
        <p class="mt-3 font-medium text-accent">{item.label}</p>
        {item.points.length > 0 && (
          <ul class="mt-4 space-y-1.5 text-[15px] text-ink">
            {item.points.map((point) => <li class="flex justify-center gap-2"><CheckIcon class="mt-1 size-4 text-accent" /><span>{point}</span></li>)}
          </ul>
        )}
        <p class="mt-auto pt-6 text-[13px] text-muted">{item.name} · {item.branche}</p>
      </article>
    ))}
  </div>
  <p class="mx-auto mt-8 max-w-[680px] text-center text-pretty text-ink">{note}</p>

  <div class="mx-auto mt-14 max-w-[680px] rounded-2xl border border-line bg-surface p-8 text-center">
    <Image src={portrait} alt={about.imageAlt} width={240} height={240} class="mx-auto size-24 rounded-full object-cover object-[50%_15%] ring-4 ring-white" />
    <h3 class="mt-4 text-[1.375rem] font-semibold tracking-[-0.02em] text-ink">{about.name}</h3>
    <p class="text-sm text-muted">{about.role}</p>
    <p class="mt-4 text-pretty">{about.text}</p>
    <dl class="mt-6 grid grid-cols-2 gap-4">
      {about.facts.map((f) => (
        <div class="rounded-xl bg-white p-4"><dt class="sr-only">{f.label}</dt><dd><span class="block text-[1.5rem] leading-none font-semibold text-ink">{f.value}</span><span class="mt-1 block text-sm text-muted">{f.label}</span></dd></div>
      ))}
    </dl>
  </div>
</Section>
