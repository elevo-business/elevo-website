---
import ss from '../../config/startseite.json';
import { telHref } from '../../neukundensystem/lib/text';
import Rich from './Rich.astro';
import CtaButton from './CtaButton.astro';
const { headline, text, button, phoneLine } = ss.finalCta;
const phoneHref = telHref(ss.contact.phoneInternational);
---

<section class="on-ink mx-auto mt-16 max-w-[1080px] px-4 sm:mt-28" aria-labelledby="abschluss-titel">
  <div class="rounded-2xl bg-ink px-6 py-14 text-center text-on-ink sm:px-12 sm:py-16">
    <h2 id="abschluss-titel" class="text-[1.875rem] leading-[1.12] font-semibold tracking-[-0.03em] text-white sm:text-[2.5rem]"><Rich text={headline} /></h2>
    <p class="mx-auto mt-4 max-w-[560px] text-pretty">{text}</p>
    <div class="mt-8 flex justify-center"><CtaButton label={button} class="sm:w-auto sm:px-10" /></div>
    {phoneHref && <p class="mt-4 text-sm">{phoneLine} <a href={phoneHref} class="font-semibold text-white underline underline-offset-2">{ss.contact.phone}</a></p>}
  </div>
</section>
