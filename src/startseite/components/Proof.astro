---
// Baustein 6: Beweise. Eine Karte erscheint nur, wenn value, label und name gefüllt sind (dritte Karte = Kanzlei-Referenz).
import ss from '../../config/startseite.json';
import { isFilled } from '../../neukundensystem/lib/text';
import Section from './Section.astro';
const { headline, items, note, label } = ss.proof;
const cards = items.filter((item) => isFilled(item.value) && isFilled(item.label) && isFilled(item.name));
---

<Section id="beweise-titel" num="06" label={label}>
  <h2 id="beweise-titel" class="section-title">{headline}</h2>
  <div class:list={['mt-10 grid gap-10', cards.length > 1 && 'sm:grid-cols-2']}>
    {
      cards.map((card) => (
        <article class="border-t-2 border-navy pt-5">
          <p class="font-serif text-[3rem] leading-none font-normal tracking-[-0.025em] text-navy">{card.value}</p>
          <p class="mt-3 font-medium text-gold-text">{card.label}</p>
          <h3 class="mt-6 text-[12px] font-semibold tracking-[0.16em] text-navy uppercase">{card.name}</h3>
          {isFilled(card.text) && <p class="mt-2 text-[16px] leading-[1.55] text-muted">{card.text}</p>}
        </article>
      ))
    }
  </div>
  {note && <p class="mt-10 border-l-2 border-rule pl-5 text-pretty text-muted">{note}</p>}
</Section>
