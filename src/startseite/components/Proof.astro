---
// Baustein 6: Beweise. Eine Karte erscheint nur, wenn value, label und name gefüllt sind (dritte Karte = Kanzlei-Referenz).
import ss from '../../config/startseite.json';
import { isFilled } from '../../neukundensystem/lib/text';
const { headline, items, note } = ss.proof;
const cards = items.filter((item) => isFilled(item.value) && isFilled(item.label) && isFilled(item.name));
---

<section class="mx-auto mt-20 max-w-[720px] px-4 sm:mt-28" aria-labelledby="beweise-titel">
  <h2 id="beweise-titel" class="section-title">{headline}</h2>
  <div class:list={['mt-8 grid gap-4', cards.length > 1 && 'sm:grid-cols-2']}>
    {
      cards.map((card) => (
        <article class="rounded-2xl border border-line bg-paper p-6">
          <p class="text-[2rem] leading-none font-bold tracking-[-0.02em] text-navy">{card.value}</p>
          <p class="mt-2 font-medium text-gold-text">{card.label}</p>
          <h3 class="mt-5 text-[15px] font-semibold tracking-wide text-navy uppercase">{card.name}</h3>
          {isFilled(card.text) && <p class="mt-1.5 text-[16px] leading-[1.55] text-muted">{card.text}</p>}
        </article>
      ))
    }
  </div>
  {note && <p class="mt-6 text-pretty">{note}</p>}
</section>
