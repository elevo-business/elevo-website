---
// 02 Die Ursache: Mandate gehen nach der Anfrage verloren. Einzige dunkle Sektion, mit Studien und Quellen.
import ss from '../../config/startseite.json';
import Section from './Section.astro';
import Rich from './Rich.astro';
const { label, headline, intro, losses, statsHeadline, stats, conclusion, footnotes } = ss.ursache;
---

<Section id="ursache-titel" num="02" label={label} dark>
  <h2 id="ursache-titel" class="text-[2rem] leading-[1.1] font-semibold tracking-[-0.025em] text-white sm:text-[2.875rem]"><Rich text={headline} /></h2>
  <p class="mt-5 text-pretty">{intro}</p>
  <ul class="mt-6 border-t border-white/15">
    {losses.map((item) => (
      <li class="flex items-start gap-4 border-b border-white/15 py-4">
        <svg class="mt-1.5 size-4 shrink-0 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        <span class="font-semibold text-[1.25rem] leading-snug text-white">{item}</span>
      </li>
    ))}
  </ul>

  <h3 class="font-semibold mt-14 text-[1.625rem] leading-tight text-white sm:text-[2rem]">{statsHeadline}</h3>
  <dl class="mt-8 grid gap-10 sm:grid-cols-2">
    {stats.map((stat) => (
      <div class="border-l border-accent-light/40 pl-5">
        <dt class="text-[3.5rem] leading-[0.9] font-semibold tracking-[-0.03em] text-accent-light sm:text-[4.5rem]">
          {stat.value}
          <sup class="ml-1 align-super font-sans text-sm font-semibold">
            <a href={`#fussnote-${stat.footnote}`} class="rounded-sm px-0.5 text-accent-light underline-offset-2 hover:underline" aria-label={`Fußnote ${stat.footnote}`}>{stat.footnote}</a>
          </sup>
        </dt>
        <dd class="mt-4 text-pretty">{stat.text}</dd>
      </div>
    ))}
  </dl>

  <p class="font-semibold mt-12 border-t border-white/20 pt-8 text-[1.5rem] leading-[1.25] text-pretty text-accent-light sm:text-[1.875rem]">{conclusion}</p>

  <ol class="mt-10 space-y-2 text-[13px] leading-relaxed text-on-ink-muted">
    {footnotes.map((note) => (
      <li id={`fussnote-${note.id}`} class="flex gap-2">
        <span class="shrink-0 font-semibold text-accent-light">{note.id}</span>
        <span>{note.text} <a href={note.url} target="_blank" rel="noopener noreferrer" class="text-on-ink underline underline-offset-2 hover:text-white">Quelle öffnen</a></span>
      </li>
    ))}
  </ol>
</Section>
