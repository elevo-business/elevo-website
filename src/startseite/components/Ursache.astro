---
// 02 Die Ursache: Mandate gehen nach der Anfrage verloren. Dunkel, symmetrisch, mit Studien und Quellen.
import ss from '../../config/startseite.json';
import Section from './Section.astro';
const { label, headline, intro, losses, statsHeadline, stats, conclusion, footnotes } = ss.ursache;
---

<Section id="ursache-titel" num="02" label={label} title={headline} intro={intro} dark>
  <ul class="grid gap-4 sm:grid-cols-3">
    {losses.map((item) => (
      <li class="flex flex-col items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-center">
        <span class="grid size-9 place-items-center rounded-full bg-white/10">
          <svg class="size-4 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </span>
        <span class="text-[1.0625rem] leading-snug font-medium text-white">{item}</span>
      </li>
    ))}
  </ul>

  <h3 class="mt-16 text-center text-[1.5rem] font-semibold tracking-[-0.02em] text-white sm:text-[2rem]">{statsHeadline}</h3>
  <dl class="mx-auto mt-8 grid max-w-[860px] gap-8 sm:grid-cols-2">
    {stats.map((stat) => (
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-8 text-center">
        <dt class="text-[3.5rem] leading-none font-semibold tracking-[-0.04em] text-accent-light sm:text-[4.25rem]">
          {stat.value}<sup class="ml-1 align-super text-sm font-semibold"><a href={`#fussnote-${stat.footnote}`} class="rounded-sm px-0.5 text-accent-light underline-offset-2 hover:underline" aria-label={`Fußnote ${stat.footnote}`}>{stat.footnote}</a></sup>
        </dt>
        <dd class="mt-4 text-pretty">{stat.text}</dd>
      </div>
    ))}
  </dl>

  <p class="mx-auto mt-14 max-w-[760px] text-center text-[1.375rem] leading-[1.3] font-semibold text-pretty text-white sm:text-[1.75rem]">{conclusion}</p>

  <ol class="mx-auto mt-10 max-w-[760px] space-y-2 text-center text-[13px] leading-relaxed text-on-ink-muted">
    {footnotes.map((note) => (
      <li id={`fussnote-${note.id}`}>
        <span class="font-semibold text-accent-light">{note.id}</span> {note.text} <a href={note.url} target="_blank" rel="noopener noreferrer" class="text-on-ink underline underline-offset-2 hover:text-white">Quelle öffnen</a>
      </li>
    ))}
  </ol>
</Section>
