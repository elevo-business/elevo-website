---
import ss from '../../config/startseite.json';
import Section from './Section.astro';
import CheckIcon from './CheckIcon.astro';
const { headline, yesTitle, yes, noTitle, no, label } = ss.fit;
---

<Section id="passt-titel" label={label}>
  <h2 id="passt-titel" class="section-title">{headline}</h2>
  <div class="mt-8 grid gap-8 sm:grid-cols-2">
    <div>
      <h3 class="border-b-2 border-navy pb-2 font-semibold text-navy">{yesTitle}</h3>
      <ul class="mt-1">
        {yes.map((item) => (
          <li class="flex gap-3 border-b border-rule py-3.5"><CheckIcon class="mt-1 size-4 text-gold-text" /><span>{item}</span></li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="border-b-2 border-rule pb-2 font-semibold text-muted">{noTitle}</h3>
      <ul class="mt-1">
        {no.map((item) => (
          <li class="flex gap-3 border-b border-rule py-3.5 text-muted">
            <svg class="mt-1 size-4 shrink-0 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 12h12" /></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
