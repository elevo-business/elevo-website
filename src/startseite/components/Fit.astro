---
import ss from '../../config/startseite.json';
import CheckIcon from './CheckIcon.astro';
const { headline, yesTitle, yes, noTitle, no } = ss.fit;
---

<section class="mx-auto mt-20 max-w-[720px] px-4 sm:mt-28" aria-labelledby="passt-titel">
  <h2 id="passt-titel" class="section-title">{headline}</h2>
  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <div class="rounded-2xl border border-line bg-paper p-6">
      <h3 class="font-semibold text-navy">{yesTitle}</h3>
      <ul class="mt-3 space-y-3">
        {yes.map((item) => (
          <li class="flex gap-2.5"><CheckIcon class="mt-1 size-5 text-gold-text" /><span>{item}</span></li>
        ))}
      </ul>
    </div>
    <div class="rounded-2xl bg-grey-card p-6">
      <h3 class="font-semibold text-navy">{noTitle}</h3>
      <ul class="mt-3 space-y-3">
        {no.map((item) => (
          <li class="flex gap-2.5">
            <svg class="mt-1 size-5 shrink-0 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 12h12" /></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
