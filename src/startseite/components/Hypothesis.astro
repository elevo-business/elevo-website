---
// Baustein 2: Hypothese (der naheliegende Irrglaube) – bewusst zurückhaltend in Grau
import ss from '../../config/startseite.json';
import Section from './Section.astro';
const { headline, text, items, label } = ss.hypothesis;
---

<Section id="hypothese-titel" num="02" label={label}>
  <h2 id="hypothese-titel" class="section-title">{headline}</h2>
  <p class="mt-5 text-muted">{text}</p>
  <ul class="mt-6 grid gap-px overflow-hidden rounded-[4px] border border-rule bg-rule sm:grid-cols-2">
    {items.map((item, i) => (
      <li class="flex gap-3 bg-grey-card px-4 py-4 text-muted">
        <span class="font-serif text-muted italic" aria-hidden="true">{String.fromCharCode(97 + i)})</span>{item}
      </li>
    ))}
  </ul>
</Section>
