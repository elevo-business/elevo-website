---
// Baustein 2: Hypothese (der naheliegende Irrglaube) – bewusst zurückhaltend in Grau
import ss from '../../config/startseite.json';
const { headline, text, items } = ss.hypothesis;
---

<section class="mx-auto mt-20 max-w-[720px] px-4 sm:mt-28" aria-labelledby="hypothese-titel">
  <h2 id="hypothese-titel" class="section-title">{headline}</h2>
  <p class="mt-4 text-muted">{text}</p>
  <ul class="mt-6 grid gap-3 sm:grid-cols-2">
    {items.map((item) => <li class="rounded-xl bg-grey-card px-4 py-3.5 text-muted">{item}</li>)}
  </ul>
</section>
