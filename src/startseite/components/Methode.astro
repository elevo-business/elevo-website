---
// 03 Die Methode: fünf gleich breite Schritte (Desktop nebeneinander, Handy untereinander), dann die Anzeigen
import ss from '../../config/startseite.json';
import Section from './Section.astro';
const { label, headline, intro, steps, then } = ss.methode;
---

<Section id="methode-titel" num="03" label={label} title={headline} intro={intro}>
  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {steps.map((step, i) => (
      <li class:list={['flex flex-col items-center rounded-2xl border border-line bg-white p-6 text-center shadow-sm', i === steps.length - 1 && 'sm:col-span-2 lg:col-span-1']}>
        <span class="grid size-11 place-items-center rounded-full bg-accent text-[1.0625rem] font-semibold text-white" aria-hidden="true">{i + 1}</span>
        <h3 class="mt-4 text-[1.0625rem] font-semibold tracking-[-0.01em] text-ink">{step.title}</h3>
        <p class="mt-2 text-[15px] leading-[1.55] text-muted">{step.text}</p>
      </li>
    ))}
  </ol>
  <div class="mx-auto mt-10 max-w-[760px] rounded-2xl bg-accent-soft p-8 text-center">
    <h3 class="text-[1.375rem] font-semibold tracking-[-0.02em] text-ink">{then.title}</h3>
    <p class="mt-2 text-pretty">{then.text}</p>
  </div>
</Section>
