---
// Baustein 4: Diagnose – einzige dunkle Sektion, hier kommt Gold ins Spiel
import ss from '../../config/startseite.json';
import Section from './Section.astro';
import Rich from './Rich.astro';
const { headline, stats, conclusion, footnotes, label } = ss.diagnosis;
---

<Section id="diagnose-titel" num="04" label={label} dark>
  <h2 id="diagnose-titel" class="font-serif text-[2.25rem] leading-[1.05] font-medium tracking-[-0.015em] text-white sm:text-[3.25rem]"><Rich text={headline} /></h2>

  <dl class="mt-12 grid gap-10 sm:grid-cols-2">
    {
      stats.map((stat) => (
        <div class="border-l border-gold/50 pl-5">
          <dt class="font-serif text-[4rem] leading-[0.9] font-normal tracking-[-0.03em] text-gold sm:text-[5rem]">
            {stat.value}
            <sup class="ml-1 align-super font-sans text-sm font-semibold">
              <a href={`#fussnote-${stat.footnote}`} class="rounded-sm px-0.5 text-gold underline-offset-2 hover:underline" aria-label={`Fußnote ${stat.footnote}`}>{stat.footnote}</a>
            </sup>
          </dt>
          <dd class="mt-4 text-pretty">{stat.text}</dd>
        </div>
      ))
    }
  </dl>

  <p class="mt-14 border-t border-white/20 pt-8 font-serif text-[1.75rem] leading-[1.2] text-pretty text-gold italic sm:text-[2.25rem]">{conclusion}</p>

  <ol class="mt-12 space-y-2 text-[13px] leading-relaxed text-on-navy-muted">
    {
      footnotes.map((note) => (
        <li id={`fussnote-${note.id}`} class="flex gap-2">
          <span class="shrink-0 font-semibold text-gold">{note.id}</span>
          <span>
            {note.text}{' '}
            <a href={note.url} target="_blank" rel="noopener noreferrer" class="text-on-navy underline underline-offset-2 hover:text-white">Quelle öffnen</a>
          </span>
        </li>
      ))
    }
  </ol>
</Section>
