---
// Baustein 4: Diagnose – einzige dunkle Sektion, hier kommt Gold ins Spiel
import ss from '../../config/startseite.json';
const { headline, stats, conclusion, footnotes } = ss.diagnosis;
---

<section class="on-navy mt-20 bg-navy py-16 text-on-navy sm:mt-28 sm:py-24" aria-labelledby="diagnose-titel">
  <div class="mx-auto max-w-[720px] px-4">
    <h2 id="diagnose-titel" class="text-[1.75rem] leading-[1.15] font-bold tracking-[-0.02em] text-white sm:text-[2.5rem]">{headline}</h2>

    <dl class="mt-10 grid gap-8 sm:grid-cols-2 sm:gap-10">
      {
        stats.map((stat) => (
          <div class="border-t border-white/15 pt-5">
            <dt class="text-[3rem] leading-none font-bold tracking-[-0.03em] text-gold sm:text-[3.5rem]">
              {stat.value}
              <sup class="ml-0.5 align-super text-base font-semibold">
                <a href={`#fussnote-${stat.footnote}`} id={`fussnote-ref-${stat.footnote}`} class="rounded px-0.5 text-gold underline-offset-2 hover:underline" aria-label={`Fußnote ${stat.footnote}`}>{stat.footnote}</a>
              </sup>
            </dt>
            <dd class="mt-3 text-pretty">{stat.text}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-12 text-[1.375rem] leading-snug font-semibold text-pretty text-gold sm:text-[1.75rem]">{conclusion}</p>

    <ol class="mt-12 space-y-2 border-t border-white/15 pt-5 text-[13px] leading-relaxed text-on-navy-muted">
      {
        footnotes.map((note) => (
          <li id={`fussnote-${note.id}`} class="flex gap-2">
            <span class="shrink-0">{note.id}</span>
            <span>
              {note.text}{' '}
              <a href={note.url} target="_blank" rel="noopener noreferrer" class="break-all text-on-navy underline underline-offset-2 hover:text-white">Quelle öffnen</a>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
