---
// Bild mit Bildunterschrift im Fußnotenstil („Abb. 1 · …“). Astro erzeugt WebP in mehreren Breiten.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Tailwind-Klassen für Seitenverhältnis/Zuschnitt des Bildes, z. B. "aspect-[4/5] object-[50%_25%]" */
  imgClass?: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  /** warm: ruhiger, warmer Farbton für Personenbilder; mono: Schwarz-Weiß mit Navy-Ton für Detailbilder */
  tone?: 'warm' | 'mono';
  frame?: boolean;
}

const { src, alt, caption, imgClass = '', class: className, widths = [480, 800, 1200], sizes = '(min-width: 1024px) 480px, 100vw', eager = false, tone = 'warm', frame = false } = Astro.props;
---

<figure class:list={[className]}>
  <div class:list={['relative', frame && 'lg:pr-4 lg:pb-4']}>
    {frame && <div class="absolute inset-0 top-4 left-4 hidden border border-accent lg:block" aria-hidden="true"></div>}
    <div class:list={['relative overflow-hidden rounded-xl bg-surface', tone === 'mono' && 'photo-mono']}>
      <Picture
        src={src}
        alt={alt}
        widths={widths.filter((w) => w <= src.width)}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
        class:list={['block h-full w-full object-cover', tone === 'warm' ? 'photo-warm' : 'grayscale', imgClass]}
      />
    </div>
  </div>
  {caption && <figcaption class="mt-3 text-[13px] leading-snug text-muted">{caption}</figcaption>}
</figure>
