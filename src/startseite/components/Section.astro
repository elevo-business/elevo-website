---
// Symmetrischer Rahmen jeder Sektion: Rubrik, Überschrift und Einleitung zentriert, darunter der Inhalt.
import Rich from './Rich.astro';
interface Props {
  id: string;
  num?: string;
  label: string;
  title?: string;
  intro?: string;
  dark?: boolean;
}
const { id, num, label, title, intro, dark = false } = Astro.props;
const rubric = num ? `${num} — ${label}` : label;
---

<section class:list={[dark ? 'on-ink mt-16 bg-ink py-16 text-on-ink sm:mt-28 sm:py-24' : 'mt-16 sm:mt-28']} aria-labelledby={id}>
  <div class="mx-auto max-w-[1080px] px-4">
    <header class="mx-auto max-w-[760px] text-center">
      <p class="rubric">{rubric}</p>
      {title && (
        <h2 id={id} class:list={['mt-4', dark ? 'text-[1.875rem] leading-[1.12] font-semibold tracking-[-0.03em] text-white sm:text-[2.5rem]' : 'section-title']}>
          <Rich text={title} />
        </h2>
      )}
      {intro && <p class:list={['mx-auto mt-5 max-w-[640px] text-pretty', dark ? '' : 'text-muted']}>{intro}</p>}
    </header>
    <div class="mt-10 sm:mt-12"><slot /></div>
  </div>
</section>
