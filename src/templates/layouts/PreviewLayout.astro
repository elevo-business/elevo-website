---
import type { BranchProfile, ProspectData } from '../config/types';

export interface Props {
  profile: BranchProfile;
  prospect: ProspectData;
}

const { profile, prospect } = Astro.props;
const { colorScheme, typography } = profile;

const title = prospect.tagline
  ? `${prospect.name} — ${prospect.tagline}`
  : `${prospect.name} — ${prospect.location}`;

const cssVars = `
  --accent: ${colorScheme.accent};
  --accent-hover: ${colorScheme.accentHover};
  --bg: ${colorScheme.bg};
  --bg-el: ${colorScheme.bgEl};
  --surface: ${colorScheme.surface};
  --border: ${colorScheme.border};
  --text: ${colorScheme.text};
  --muted: ${colorScheme.muted};
  --dim: ${colorScheme.dim};
  --font-heading: '${typography.heading}', sans-serif;
  --font-body: '${typography.body}', sans-serif;
`.trim();
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={prospect.heroSubtitle} />
  <meta name="robots" content="noindex, nofollow" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={prospect.heroSubtitle} />
  {prospect.logo && <meta property="og:image" content={prospect.logo} />}

  <title>{title}</title>

  <link rel="preload" as="font" href="/fonts/Sora-latin.woff2" type="font/woff2" crossorigin />
  <link rel="preload" as="font" href="/fonts/Outfit-latin.woff2" type="font/woff2" crossorigin />

  <style set:html={`
    @font-face {
      font-family: 'Sora';
      font-style: normal;
      font-weight: 400 800;
      font-display: swap;
      src: url('/fonts/Sora-latin.woff2') format('woff2');
    }
    @font-face {
      font-family: 'Outfit';
      font-style: normal;
      font-weight: 300 600;
      font-display: swap;
      src: url('/fonts/Outfit-latin.woff2') format('woff2');
    }
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root { ${cssVars} }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      line-height: 1.6;
    }
    a { text-decoration: none; color: inherit; }
    @media (max-width: 768px) {
      .preview-nav-links { display: none; }
      .preview-hero { grid-template-columns: 1fr !important; padding: 60px 24px 48px !important; gap: 40px !important; }
      .preview-cards { grid-template-columns: 1fr !important; }
      .preview-section { padding: 60px 24px !important; }
      .preview-cta { margin: 0 24px 60px !important; padding: 40px 24px !important; }
      .preview-footer { grid-template-columns: 1fr !important; padding: 40px 24px !important; gap: 32px !important; }
      .preview-footer-bottom { padding: 16px 24px !important; flex-direction: column !important; gap: 8px !important; }
      .preview-nav { padding: 16px 24px !important; }
    }
    @media (max-width: 1024px) and (min-width: 769px) {
      .preview-hero { gap: 48px !important; }
      .preview-cards { grid-template-columns: repeat(2, 1fr) !important; }
    }
  `} />

  <link rel="stylesheet" href={`/templates/themes/${profile.id}.css`} />
</head>
<body>
  <slot />

  <style>
    .elevo-dot { position: fixed; bottom: 24px; right: 24px; z-index: 9999; width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, #1E3A5F 0%, #0A0E1A 100%); border: 2px solid rgba(59,130,246,.4); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 20px rgba(0,0,0,.5), 0 0 20px rgba(59,130,246,.15); cursor: pointer; transition: transform .2s, box-shadow .2s; }
    .elevo-dot:hover { transform: scale(1.1); box-shadow: 0 6px 28px rgba(0,0,0,.6), 0 0 30px rgba(59,130,246,.25); }
    .elevo-dot img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
  </style>
  <a href="https://elevo.solutions" target="_blank" rel="noopener" class="elevo-dot" title="Erstellt von ELEVO">
    <img src="/elevo-chevron.jpg" alt="ELEVO" width="32" height="32" />
  </a>
</body>
</html>
