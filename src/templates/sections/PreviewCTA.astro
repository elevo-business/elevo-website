---
export interface Props {
  title: string;
  subtitle: string;
  buttonText?: string;
  buttonLink?: string;
  phone?: string;
  badge?: string;
}

const {
  title,
  subtitle,
  buttonText = 'Jetzt anfragen',
  buttonLink = '#kontakt',
  phone,
  badge,
} = Astro.props;
---

<div class="pcta" id="kontakt">
  <div class="pcta__inner">
    {badge && (
      <div class="pcta__badge" role="note">
        <span class="pcta__badge-dot" aria-hidden="true"></span>
        {badge}
      </div>
    )}

    <h2 class="pcta__title">{title}</h2>
    <p class="pcta__sub">{subtitle}</p>

    <div class="pcta__actions">
      <a href={buttonLink} class="pcta__btn">
        {buttonText}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

      {phone && (
        <a href={`tel:${phone.replace(/\s/g, '')}`} class="pcta__phone" aria-label={`Anrufen: ${phone}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12.9a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"/>
          </svg>
          {phone}
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .pcta {
    margin: 0 48px 80px;
  }

  .pcta__inner {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 64px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .pcta__inner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 50% 0%, color-mix(in srgb, var(--accent) 8%, transparent), transparent);
    pointer-events: none;
  }

  .pcta__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: 100px;
    padding: 6px 16px;
    font-size: 0.75rem;
    color: var(--accent);
    margin-bottom: 20px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    position: relative;
  }

  .pcta__badge-dot {
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse-cta 2s ease-in-out infinite;
  }

  @keyframes pulse-cta {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.75); }
  }

  .pcta__title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
    color: var(--text);
    position: relative;
  }

  .pcta__sub {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 480px;
    margin: 0 auto 36px;
    position: relative;
  }

  .pcta__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    position: relative;
  }

  .pcta__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent);
    color: #fff;
    padding: 14px 32px;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    font-family: var(--font-body);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
  }

  .pcta__btn:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .pcta__phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-size: 1rem;
    font-weight: 500;
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .pcta__phone:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .pcta { margin: 0 24px 60px; }
    .pcta__inner { padding: 48px 32px; }
  }

  @media (max-width: 640px) {
    .pcta__inner { padding: 40px 20px; }
    .pcta__actions { flex-direction: column; }
    .pcta__btn { width: 100%; justify-content: center; }
  }
</style>
