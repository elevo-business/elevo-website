---
export interface CtaButton {
  text: string;
  href: string;
  variant: 'primary' | 'outline';
}

export interface HeroStat {
  value: string;
  label: string;
}

export interface Props {
  title: string;
  subtitle: string;
  badge?: string;
  ctaButtons?: CtaButton[];
  heroImage?: string;
  heroImageAlt?: string;
  stats?: HeroStat[];
}

const {
  title,
  subtitle,
  badge,
  ctaButtons = [],
  heroImage,
  heroImageAlt = '',
  stats = [],
} = Astro.props;
---

<header class="phero" id="hero">
  <div class="phero__inner" class:list={[{ 'phero__inner--visual': !!heroImage }]}>
    <div class="phero__content">
      {badge && (
        <div class="phero__badge" role="note">
          <span class="phero__badge-dot" aria-hidden="true"></span>
          {badge}
        </div>
      )}

      <h1 class="phero__title" set:html={title} />

      <p class="phero__sub">{subtitle}</p>

      {ctaButtons.length > 0 && (
        <div class="phero__ctas">
          {ctaButtons.map(btn => (
            <a
              href={btn.href}
              class={btn.variant === 'primary' ? 'phero__btn-primary' : 'phero__btn-outline'}
            >
              {btn.text}
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="phero__visual" aria-hidden={!heroImage}>
      {heroImage
        ? (
          <img
            src={heroImage}
            alt={heroImageAlt}
            width="600"
            height="450"
            loading="eager"
            class="phero__img"
          />
        )
        : (
          <div class="phero__placeholder">
            <div class="phero__browser-bar">
              <span class="phero__dot" style="background:#EF4444"></span>
              <span class="phero__dot" style="background:#F59E0B"></span>
              <span class="phero__dot" style="background:#22C55E"></span>
            </div>
            <div class="phero__browser-body">
              {stats.length > 0 && (
                <div class="phero__stats-inner">
                  {stats.map(s => (
                    <div class="phero__stat-item">
                      <div class="phero__stat-val">{s.value}</div>
                      <div class="phero__stat-lbl">{s.label}</div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        )
      }
    </div>
  </div>

  {stats.length > 0 && (
    <div class="phero__stats" role="list" aria-label="Kennzahlen">
      {stats.map(s => (
        <div class="phero__stat" role="listitem">
          <div class="phero__stat-num">{s.value}</div>
          <div class="phero__stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  )}
</header>

<style>
  .phero {
    padding: 120px 48px 0;
    max-width: 1200px;
    margin: 0 auto;
  }

  .phero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
    padding-bottom: 64px;
  }

  .phero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: 100px;
    padding: 6px 16px;
    font-size: 0.75rem;
    color: var(--accent);
    margin-bottom: 24px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .phero__badge-dot {
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse-badge 2s ease-in-out infinite;
  }

  @keyframes pulse-badge {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.75); }
  }

  .phero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
    color: var(--text);
  }

  .phero__title :global(span),
  .phero__title :global(em) {
    color: var(--accent);
    font-style: normal;
  }

  .phero__sub {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 32px;
    max-width: 480px;
  }

  .phero__ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .phero__btn-primary {
    background: var(--accent);
    color: #fff;
    padding: 12px 26px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-body);
    transition: background 0.2s ease, transform 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }

  .phero__btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  .phero__btn-outline {
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
    padding: 12px 26px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    font-family: var(--font-body);
    transition: border-color 0.2s ease, background 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }

  .phero__btn-outline:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .phero__visual {
    border-radius: 16px;
    overflow: hidden;
  }

  .phero__img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--border);
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .phero__placeholder {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }

  .phero__browser-bar {
    background: var(--bg-el);
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .phero__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
  }

  .phero__browser-body {
    padding: 32px 24px;
  }

  .phero__stats-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
  }

  .phero__stat-item {
    background: var(--bg-el);
    padding: 20px;
    text-align: center;
  }

  .phero__stat-val {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }

  .phero__stat-lbl {
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 5px;
  }

  .phero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1px;
    background: var(--border);
    border-top: 1px solid var(--border);
    border-radius: 0 0 16px 16px;
    overflow: hidden;
    margin: 0 0 0 0;
  }

  .phero__stat {
    background: var(--surface);
    padding: 24px 16px;
    text-align: center;
  }

  .phero__stat-num {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .phero__stat-label {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 6px;
  }

  @media (max-width: 900px) {
    .phero {
      padding: 100px 24px 0;
    }

    .phero__inner {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-bottom: 48px;
    }

    .phero__sub { max-width: none; }
  }

  @media (max-width: 480px) {
    .phero__ctas { flex-direction: column; }
    .phero__btn-primary,
    .phero__btn-outline { text-align: center; }
  }
</style>
