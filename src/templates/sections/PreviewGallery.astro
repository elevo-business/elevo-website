---
export interface GalleryImage {
  src: string;
  alt: string;
  beforeSrc?: string;
}

export type GalleryVariant = 'grid' | 'masonry' | 'beforeAfter';

export interface Props {
  title: string;
  subtitle?: string;
  images: GalleryImage[];
  variant?: GalleryVariant;
}

const {
  title,
  subtitle,
  images,
  variant = 'grid',
} = Astro.props;
---

<section class="pgal" id="galerie" aria-labelledby="pgal-heading">
  <div class="pgal__inner">
    <div class="pgal__header">
      <h2 id="pgal-heading" class="pgal__title">{title}</h2>
      {subtitle && <p class="pgal__sub">{subtitle}</p>}
    </div>

    {variant === 'beforeAfter' && images.length > 0 && (
      <div class="pgal__before-after">
        {images.map((img, i) => (
          <div class="pgal__ba-item">
            <div class="pgal__ba-pair">
              {img.beforeSrc && (
                <div class="pgal__ba-side">
                  <span class="pgal__ba-label pgal__ba-label--before" aria-label="Vorher">Vorher</span>
                  <img
                    src={img.beforeSrc}
                    alt={`Vorher: ${img.alt}`}
                    loading={i < 2 ? 'eager' : 'lazy'}
                    width="560"
                    height="420"
                  />
                </div>
              )}
              <div class="pgal__ba-side">
                <span class="pgal__ba-label pgal__ba-label--after" aria-label="Nachher">Nachher</span>
                <img
                  src={img.src}
                  alt={`Nachher: ${img.alt}`}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  width="560"
                  height="420"
                />
              </div>
            </div>
            {img.alt && <p class="pgal__ba-caption">{img.alt}</p>}
          </div>
        ))}
      </div>
    )}

    {variant === 'masonry' && (
      <div class="pgal__masonry" role="list">
        {images.map((img, i) => (
          <div class="pgal__masonry-item" role="listitem">
            <img
              src={img.src}
              alt={img.alt}
              loading={i < 3 ? 'eager' : 'lazy'}
              width="400"
              height="300"
            />
            {img.alt && <span class="pgal__caption">{img.alt}</span>}
          </div>
        ))}
      </div>
    )}

    {(variant === 'grid' || (!['beforeAfter', 'masonry'].includes(variant))) && (
      <div class="pgal__grid" role="list">
        {images.map((img, i) => (
          <div class="pgal__grid-item" role="listitem">
            <img
              src={img.src}
              alt={img.alt}
              loading={i < 4 ? 'eager' : 'lazy'}
              width="400"
              height="300"
            />
            {img.alt && <span class="pgal__caption">{img.alt}</span>}
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .pgal {
    padding: 80px 48px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .pgal__header {
    margin-bottom: 48px;
  }

  .pgal__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
    color: var(--text);
  }

  .pgal__sub {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 520px;
  }

  /* Grid variant */
  .pgal__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .pgal__grid-item {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
  }

  .pgal__grid-item img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .pgal__grid-item:hover img { transform: scale(1.04); }

  /* Masonry variant */
  .pgal__masonry {
    columns: 3;
    column-gap: 16px;
  }

  .pgal__masonry-item {
    break-inside: avoid;
    margin-bottom: 16px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    position: relative;
  }

  .pgal__masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .pgal__masonry-item:hover img { transform: scale(1.02); }

  /* Before/After variant */
  .pgal__before-after {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .pgal__ba-item {}

  .pgal__ba-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .pgal__ba-side {
    position: relative;
    overflow: hidden;
  }

  .pgal__ba-side img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    display: block;
    filter: saturate(0.9);
    transition: filter 0.3s ease;
  }

  .pgal__ba-side:hover img { filter: saturate(1.1); }

  .pgal__ba-label {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
  }

  .pgal__ba-label--before {
    background: rgba(0, 0, 0, 0.6);
    color: rgba(255, 255, 255, 0.8);
  }

  .pgal__ba-label--after {
    background: var(--accent);
    color: #fff;
  }

  .pgal__ba-caption {
    margin-top: 10px;
    font-size: 0.82rem;
    color: var(--muted);
    text-align: center;
  }

  /* Shared caption */
  .pgal__caption {
    display: block;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 8px 12px;
    background: linear-gradient(transparent, rgba(0,0,0,0.6));
    font-size: 0.78rem;
    color: rgba(255,255,255,0.85);
  }

  @media (max-width: 900px) {
    .pgal { padding: 60px 24px; }
    .pgal__grid { grid-template-columns: repeat(2, 1fr); }
    .pgal__masonry { columns: 2; }
    .pgal__ba-side img { height: 220px; }
  }

  @media (max-width: 640px) {
    .pgal__grid { grid-template-columns: 1fr; }
    .pgal__masonry { columns: 1; }
    .pgal__ba-pair { grid-template-columns: 1fr; }
    .pgal__ba-side img { height: 200px; }
  }
</style>
