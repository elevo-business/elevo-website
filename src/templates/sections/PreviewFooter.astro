---
export interface FooterLink {
  label: string;
  href: string;
}

export interface FooterColumn {
  heading: string;
  links: FooterLink[];
}

export interface Props {
  prospectName: string;
  tagline?: string;
  address?: string;
  phone?: string;
  email?: string;
  links?: FooterColumn[];
  year?: number;
}

const {
  prospectName,
  tagline,
  address,
  phone,
  email,
  links = [],
  year = new Date().getFullYear(),
} = Astro.props;

const flatLinks = links.flatMap(col => col.links);
---

<footer class="pfooter" id="footer" aria-label="Seitenfuß">
  <div class="pfooter__main">
    <div class="pfooter__brand">
      <span class="pfooter__name">{prospectName}</span>
      {tagline && <span class="pfooter__tagline">{tagline}</span>}
    </div>
    <div class="pfooter__contact">
      {email && <a href={`mailto:${email}`}>{email}</a>}
      {phone && <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a>}
      {address && <span>{address}</span>}
    </div>
  </div>
  <div class="pfooter__bottom">
    <span>© {year} {prospectName}</span>
    <nav class="pfooter__links" aria-label="Footer-Links">
      {flatLinks.slice(0, 4).map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href="#impressum">Impressum</a>
      <a href="#datenschutz">Datenschutz</a>
    </nav>
    <span class="pfooter__credit">
      Website von{' '}
      <a href="https://elevo.solutions" rel="noopener noreferrer" aria-label="ELEVO Webagentur">
        ELEVO
      </a>
    </span>
  </div>
</footer>

<style>
  .pfooter {
    border-top: 1px solid var(--border);
    max-width: 1200px;
    margin: 0 auto;
  }

  .pfooter__main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 48px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .pfooter__brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pfooter__name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1rem;
    color: var(--text);
  }

  .pfooter__tagline {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
    max-width: 400px;
  }

  .pfooter__contact {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    font-style: normal;
  }

  .pfooter__contact span,
  .pfooter__contact a {
    font-size: 0.82rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pfooter__contact a:hover { color: var(--text); }

  .pfooter__bottom {
    border-top: 1px solid var(--border);
    padding: 16px 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: var(--dim);
    gap: 16px;
    flex-wrap: wrap;
  }

  .pfooter__links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .pfooter__links a {
    color: var(--muted);
    font-size: 0.78rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pfooter__links a:hover { color: var(--text); }

  .pfooter__credit a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pfooter__credit a:hover { color: var(--accent-hover); }

  @media (max-width: 768px) {
    .pfooter__main {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px 24px;
    }

    .pfooter__contact {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .pfooter__bottom {
      padding: 14px 24px;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .pfooter__links {
      gap: 10px;
    }
  }
</style>
