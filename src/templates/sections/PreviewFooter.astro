---
export interface Props {
  prospectName: string;
  address?: string;
  phone?: string;
  email?: string;
  year?: number;
}

const {
  prospectName,
  address,
  phone,
  email,
  year = new Date().getFullYear(),
} = Astro.props;
---

<footer class="pfooter" id="footer" aria-label="Seitenfu&szlig;">
  <div class="pfooter__inner">
    <address class="pfooter__info" aria-label="Kontaktdaten">
      <span class="pfooter__name">{prospectName}</span>
      {address && (
        <>
          <span class="pfooter__sep" aria-hidden="true">&middot;</span>
          <span>{address}</span>
        </>
      )}
      {phone && (
        <>
          <span class="pfooter__sep" aria-hidden="true">&middot;</span>
          <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a>
        </>
      )}
      {email && (
        <>
          <span class="pfooter__sep" aria-hidden="true">&middot;</span>
          <a href={`mailto:${email}`}>{email}</a>
        </>
      )}
    </address>

    <nav class="pfooter__legal" aria-label="Rechtliche Links">
      <a href="#impressum">Impressum</a>
      <span class="pfooter__sep" aria-hidden="true">|</span>
      <a href="#datenschutz">Datenschutz</a>
    </nav>
  </div>
  <div class="pfooter__bottom">
    <span>&copy; {year} {prospectName}</span>
    <span>
      Website von{' '}
      <a href="https://elevo.solutions" rel="noopener noreferrer" aria-label="ELEVO Webagentur">
        ELEVO
      </a>
    </span>
  </div>
</footer>

<style>
  .pfooter {
    border-top: 1px solid var(--border);
    max-width: 1200px;
    margin: 0 auto;
  }

  .pfooter__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 48px 0;
    flex-wrap: wrap;
  }

  .pfooter__info {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    font-style: normal;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .pfooter__name {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text);
  }

  .pfooter__info a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pfooter__info a:hover { color: var(--text); }

  .pfooter__sep {
    padding: 0 8px;
    color: var(--dim);
  }

  .pfooter__legal {
    display: flex;
    align-items: center;
    gap: 0;
    flex-shrink: 0;
  }

  .pfooter__legal a {
    font-size: 0.82rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .pfooter__legal a:hover { color: var(--text); }

  .pfooter__bottom {
    padding: 12px 48px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: var(--dim);
    gap: 16px;
    flex-wrap: wrap;
  }

  .pfooter__credit a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pfooter__credit a:hover { color: var(--accent-hover); }

  @media (max-width: 768px) {
    .pfooter__inner {
      padding: 16px 24px 0;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
    }

    .pfooter__info {
      justify-content: center;
    }

    .pfooter__bottom {
      padding: 10px 24px 16px;
      flex-direction: column;
      text-align: center;
      gap: 4px;
    }
  }

  @media (max-width: 480px) {
    .pfooter__info {
      flex-direction: column;
      gap: 4px;
    }

    .pfooter__info .pfooter__sep { display: none; }
  }
</style>
