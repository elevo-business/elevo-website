---
interface Stat {
  value: string;
  label: string;
}

interface CtaButton {
  text: string;
  href: string;
}

interface Props {
  title: string;
  subtitle: string;
  badge?: string;
  ctaPrimary?: CtaButton;
  ctaSecondary?: CtaButton;
  imageSrc?: string;
  imageAlt?: string;
  stats?: Stat[];
}

const {
  title,
  subtitle,
  badge,
  ctaPrimary,
  ctaSecondary,
  imageSrc,
  imageAlt = '',
  stats = [],
} = Astro.props;
---

<section class="zh-hero-split" aria-label="Hero">
  <div class="zh-hero-split__inner">

    <div class="zh-hero-split__image-col">
      <div class="zh-hero-split__image-wrap">
        {imageSrc ? (
          <img
            src={imageSrc}
            alt={imageAlt}
            class="zh-hero-split__image"
            width="680"
            height="800"
            loading="eager"
          />
        ) : (
          <div class="zh-hero-split__image-placeholder" aria-hidden="true">
            <svg viewBox="0 0 400 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Arzt Portrait Platzhalter">
              <rect width="400" height="500" fill="var(--zh-surface, rgba(14,138,123,0.08))"/>
              <circle cx="200" cy="160" r="80" fill="var(--zh-accent, #0E8A7B)" opacity="0.12"/>
              <circle cx="200" cy="155" r="55" fill="var(--zh-accent, #0E8A7B)" opacity="0.2"/>
              <rect x="140" y="250" width="120" height="160" rx="60" fill="var(--zh-accent, #0E8A7B)" opacity="0.15"/>
            </svg>
          </div>
        )}
        <div class="zh-hero-split__image-accent" aria-hidden="true"></div>
      </div>
    </div>

    <div class="zh-hero-split__content-col">
      <div class="zh-hero-split__content">
        {badge && (
          <span class="zh-hero-split__badge" aria-label="Kategorie">{badge}</span>
        )}
        <h1 class="zh-hero-split__title" set:html={title} />
        <p class="zh-hero-split__subtitle" set:html={subtitle} />
        {(ctaPrimary || ctaSecondary) && (
          <div class="zh-hero-split__ctas">
            {ctaPrimary && (
              <a href={ctaPrimary.href} class="zh-hero-split__cta zh-hero-split__cta--primary">
                {ctaPrimary.text}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            )}
            {ctaSecondary && (
              <a href={ctaSecondary.href} class="zh-hero-split__cta zh-hero-split__cta--secondary">
                {ctaSecondary.text}
              </a>
            )}
          </div>
        )}
        {stats.length > 0 && (
          <div class="zh-hero-split__stats" aria-label="Kennzahlen">
            {stats.map((stat) => (
              <div class="zh-hero-split__stat">
                <span class="zh-hero-split__stat-value">{stat.value}</span>
                <span class="zh-hero-split__stat-label">{stat.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

  </div>
</section>

<style>
  .zh-hero-split {
    background: var(--zh-bg, var(--bg-deep));
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: 80px 24px 60px;
  }

  .zh-hero-split::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 50% 70% at 80% 50%, rgba(14, 138, 123, 0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  .zh-hero-split__inner {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* Image column */
  .zh-hero-split__image-col {
    order: -1;
  }

  .zh-hero-split__image-wrap {
    position: relative;
    border-radius: var(--radius-lg, 20px);
    overflow: hidden;
    aspect-ratio: 4/5;
    max-height: 520px;
    background: var(--zh-surface, rgba(14, 138, 123, 0.06));
  }

  .zh-hero-split__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .zh-hero-split__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .zh-hero-split__image-placeholder svg {
    width: 100%;
    height: 100%;
  }

  .zh-hero-split__image-accent {
    position: absolute;
    bottom: -1px;
    left: -1px;
    right: -1px;
    height: 120px;
    background: linear-gradient(to top, var(--zh-bg, var(--bg-deep)) 0%, transparent 100%);
    pointer-events: none;
  }

  /* Content column */
  .zh-hero-split__badge {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 100px;
    background: var(--zh-accent-subtle, rgba(14, 138, 123, 0.12));
    color: var(--zh-accent, #0E8A7B);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .zh-hero-split__title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4vw, 3.75rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--zh-text, var(--text-primary));
    margin: 0 0 24px;
    letter-spacing: -0.02em;
  }

  .zh-hero-split__subtitle {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.75;
    color: var(--zh-muted, var(--text-secondary));
    margin: 0 0 40px;
  }

  .zh-hero-split__ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .zh-hero-split__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--btn-radius, 100px);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 200ms ease, box-shadow 200ms ease, background 200ms ease, border-color 200ms ease;
  }

  .zh-hero-split__cta--primary {
    background: var(--zh-accent, #0E8A7B);
    color: #fff;
  }

  .zh-hero-split__cta--primary:hover {
    background: var(--zh-accent-hover, #0a7066);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(14, 138, 123, 0.3);
  }

  .zh-hero-split__cta--secondary {
    background: transparent;
    color: var(--zh-text, var(--text-primary));
    border: 1.5px solid var(--zh-border, rgba(14, 138, 123, 0.3));
  }

  .zh-hero-split__cta--secondary:hover {
    background: var(--zh-accent-subtle, rgba(14, 138, 123, 0.08));
    border-color: var(--zh-accent, #0E8A7B);
  }

  /* Stats */
  .zh-hero-split__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--zh-border, rgba(14, 138, 123, 0.15));
    border: 1px solid var(--zh-border, rgba(14, 138, 123, 0.15));
    border-radius: var(--radius, 12px);
    overflow: hidden;
  }

  .zh-hero-split__stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 24px;
    background: var(--zh-bg, var(--bg-deep));
  }

  .zh-hero-split__stat-value {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 700;
    color: var(--zh-accent, #0E8A7B);
    line-height: 1;
  }

  .zh-hero-split__stat-label {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--zh-muted, var(--text-secondary));
    line-height: 1.4;
  }

  /* Desktop: image left, content right */
  @media (min-width: 1024px) {
    .zh-hero-split {
      padding: 100px 48px 80px;
    }

    .zh-hero-split__inner {
      grid-template-columns: 1fr 1.1fr;
      gap: 80px;
    }

    .zh-hero-split__image-col {
      order: 0;
    }

    .zh-hero-split__image-wrap {
      max-height: 680px;
      aspect-ratio: auto;
      height: 680px;
    }

    .zh-hero-split__stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 768px) {
    .zh-hero-split__stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .zh-hero-split {
      padding: 72px 20px 48px;
    }

    .zh-hero-split__ctas {
      flex-direction: column;
    }

    .zh-hero-split__cta {
      justify-content: center;
    }
  }
</style>
