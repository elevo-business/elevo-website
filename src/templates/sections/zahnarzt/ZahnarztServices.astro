---
interface Service {
  icon: string;
  title: string;
  description: string;
  imageSrc?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  services: Service[];
}

const { title, subtitle, services } = Astro.props;

const iconPaths: Record<string, string> = {
  tooth: 'M12 2C9.5 2 8 4 8 6c0 1.5.5 2.5 1 3.5L7.5 18c-.3 1.5.5 2 1.5 2s1.5-.5 1.5-1.5c0 1 .5 1.5 1.5 1.5s1.5-.5 1.5-1.5c0 1 .5 1.5 1.5 1.5s1.8-.5 1.5-2L14 9.5c.5-1 1-2 1-3.5C15 4 13.5 2 12 2z',
  smile: 'M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zM8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  star: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z',
  heart: 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z',
  clock: 'M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 5v5l4 2',
  check: 'M20 6L9 17l-5-5',
  grid: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',
  sparkle: 'M12 3l1.5 4.5H18l-3.75 2.75L15.75 15 12 12.25 8.25 15l1.5-4.75L6 7.5h4.5L12 3z',
  implant: 'M12 2v6m0 0c-2 0-4 1-4 3v3h8v-3c0-2-2-3-4-3zm-4 6v6a4 4 0 0 0 8 0v-6',
};

function getIconPath(icon: string): string {
  return iconPaths[icon] || iconPaths.grid;
}
---

<section class="zahnarzt-services" aria-labelledby="zahnarzt-services-heading">
  <div class="zahnarzt-services__container">
    <div class="zahnarzt-services__header">
      <h2 class="zahnarzt-services__title" id="zahnarzt-services-heading">{title}</h2>
      {subtitle && <p class="zahnarzt-services__subtitle">{subtitle}</p>}
    </div>

    <ul class="zahnarzt-services__grid" role="list">
      {services.map((service) => (
        <li class="zahnarzt-services__card">
          <div class="zahnarzt-services__card-image" aria-hidden="true">
            {service.imageSrc ? (
              <img
                src={service.imageSrc}
                alt={service.title}
                class="zahnarzt-services__card-img"
                width="400"
                height="250"
                loading="lazy"
              />
            ) : (
              <div class="zahnarzt-services__card-img-placeholder">
                <svg viewBox="0 0 400 250" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <rect width="400" height="250" fill="var(--zh-surface, #f0faf9)"/>
                  <circle cx="200" cy="100" r="50" fill="var(--zh-accent, #0E8A7B)" opacity="0.12"/>
                  <path d={getIconPath(service.icon)} stroke="var(--zh-accent, #0E8A7B)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" transform="translate(188, 88) scale(1)" />
                </svg>
              </div>
            )}
          </div>
          <div class="zahnarzt-services__card-body">
            <div class="zahnarzt-services__card-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={getIconPath(service.icon)} />
              </svg>
            </div>
            <h3 class="zahnarzt-services__card-title">{service.title}</h3>
            <p class="zahnarzt-services__card-desc">{service.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .zahnarzt-services {
    background: var(--zh-bg, var(--bg-dark));
    padding: 96px 24px;
  }

  .zahnarzt-services__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .zahnarzt-services__header {
    text-align: center;
    margin-bottom: 56px;
  }

  .zahnarzt-services__title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--zh-text, var(--text-primary));
    margin: 0 0 16px;
  }

  .zahnarzt-services__subtitle {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--zh-muted, var(--text-secondary));
    margin: 0 auto;
    max-width: 580px;
    line-height: 1.7;
  }

  .zahnarzt-services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .zahnarzt-services__card {
    background: var(--zh-surface, rgba(14, 138, 123, 0.05));
    border: 1px solid var(--zh-border, rgba(14, 138, 123, 0.12));
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }

  .zahnarzt-services__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(14, 138, 123, 0.12);
    border-color: var(--zh-accent, #0E8A7B);
  }

  .zahnarzt-services__card-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--zh-surface-alt, rgba(14, 138, 123, 0.08));
  }

  .zahnarzt-services__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition);
  }

  .zahnarzt-services__card:hover .zahnarzt-services__card-img {
    transform: scale(1.04);
  }

  .zahnarzt-services__card-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .zahnarzt-services__card-img-placeholder svg {
    width: 100%;
    height: 100%;
  }

  .zahnarzt-services__card-body {
    padding: 24px;
  }

  .zahnarzt-services__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--zh-accent-subtle, rgba(14, 138, 123, 0.12));
    color: var(--zh-accent, #0E8A7B);
    margin-bottom: 14px;
  }

  .zahnarzt-services__card-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--zh-text, var(--text-primary));
    margin: 0 0 10px;
  }

  .zahnarzt-services__card-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--zh-muted, var(--text-secondary));
    margin: 0;
  }

  @media (min-width: 768px) {
    .zahnarzt-services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .zahnarzt-services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
