---
export interface Treatment {
  icon: string;
  title: string;
  description: string;
  ctaText?: string;
  ctaHref?: string;
}

export interface Props {
  title: string;
  subtitle?: string;
  treatments: Treatment[];
}

const { title, subtitle, treatments } = Astro.props;
---

<section class="pts" id="behandlungen" aria-labelledby="pts-heading">
  <div class="pts__inner">
    <div class="pts__header">
      <h2 id="pts-heading" class="pts__title">{title}</h2>
      {subtitle && <p class="pts__sub">{subtitle}</p>}
    </div>

    <ul class="pts__grid" role="list">
      {treatments.map(t => (
        <li class="pts__card">
          <div class="pts__icon-wrap" aria-hidden="true">
            <Fragment set:html={t.icon} />
          </div>
          <h3 class="pts__card-title">{t.title}</h3>
          <p class="pts__card-desc">{t.description}</p>
          {t.ctaText && t.ctaHref && (
            <a href={t.ctaHref} class="pts__card-cta" aria-label={`Mehr zu: ${t.title}`}>
              {t.ctaText}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pts {
    padding: 80px 48px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .pts__header {
    margin-bottom: 52px;
    text-align: center;
  }

  .pts__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
    color: var(--text);
  }

  .pts__sub {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 540px;
    margin: 0 auto;
  }

  .pts__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pts__card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    overflow: hidden;
    transition: transform var(--transition, 0.3s cubic-bezier(0.4, 0, 0.2, 1)),
                border-color var(--transition, 0.3s cubic-bezier(0.4, 0, 0.2, 1));
  }

  .pts__card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    border: 2px solid var(--accent);
    opacity: 0;
    transition: opacity var(--transition, 0.3s cubic-bezier(0.4, 0, 0.2, 1));
    pointer-events: none;
  }

  .pts__card:hover {
    transform: translateY(-6px) scale(1.01);
    border-color: transparent;
  }

  .pts__card:hover::after {
    opacity: 1;
  }

  .pts__icon-wrap {
    width: 56px;
    height: 56px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    color: var(--accent);
    flex-shrink: 0;
    transition: background var(--transition, 0.3s cubic-bezier(0.4, 0, 0.2, 1));
  }

  .pts__card:hover .pts__icon-wrap {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .pts__icon-wrap :global(svg) {
    width: 26px;
    height: 26px;
    stroke: var(--accent);
    fill: none;
    flex-shrink: 0;
  }

  .pts__card-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .pts__card-desc {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.65;
    flex: 1;
    margin-bottom: 0;
  }

  .pts__card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    margin-top: 18px;
    transition: gap var(--transition, 0.3s cubic-bezier(0.4, 0, 0.2, 1));
  }

  .pts__card-cta:hover {
    gap: 10px;
  }

  @media (max-width: 1024px) {
    .pts__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 900px) {
    .pts { padding: 60px 24px; }
  }

  @media (max-width: 640px) {
    .pts__grid { grid-template-columns: 1fr; }
    .pts__header { text-align: left; }
    .pts__sub { margin: 0; }
  }
</style>
