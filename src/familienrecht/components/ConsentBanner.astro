---
// Schlanker Consent-Banner (Briefing, Abschnitt 8). Auf dem Handy eine schmale Leiste unten (max. 30 % der Höhe),
// damit der Hero-Button sichtbar bleibt. Einwilligung wird mit dem Rest von elevo.solutions geteilt.
import fr from '../../config/familienrecht.json';

interface Props {
  /** Auf /danke: Banner auch nach „Nur notwendige“ erneut zeigen, solange ein Lead im 30-Minuten-Fenster offen ist */
  showOnPendingLead?: boolean;
}
const { showOnPendingLead = false } = Astro.props;
const { consent, legal } = fr;
---

<section
  class="fixed inset-x-0 bottom-0 z-40 max-h-[30dvh] overflow-y-auto border-t border-line bg-white px-4 py-3 shadow-[0_-8px_30px_rgba(13,27,42,.12)] sm:inset-x-auto sm:right-4 sm:bottom-4 sm:max-h-none sm:max-w-md sm:rounded-2xl sm:border sm:p-4"
  role="dialog"
  aria-modal="false"
  aria-labelledby="consent-titel"
  aria-describedby="consent-text"
  data-consent-banner
  data-pending-lead={showOnPendingLead ? 'true' : undefined}
  hidden
>
  <h2 id="consent-titel" class="sr-only sm:not-sr-only sm:font-bold sm:text-ink">{consent.headline}</h2>
  <p id="consent-text" class="text-xs leading-snug sm:mt-1.5 sm:text-sm sm:leading-relaxed">
    {consent.text}
    <a href={legal.datenschutzUrl} target="_blank" rel="noopener" class="font-semibold text-ink underline underline-offset-2">{consent.privacyLinkText}</a>
  </p>
  <div class="mt-2.5 grid grid-cols-2 gap-3 sm:mt-4">
    <button type="button" class="btn-secondary min-h-11 px-3 text-sm" data-consent-choice="false">{consent.necessaryOnly}</button>
    <button type="button" class="btn-secondary min-h-11 px-3 text-sm" data-consent-choice="true">{consent.acceptAll}</button>
  </div>
</section>

<script>
  import { CONSENT_OPEN_EVENT, getMarketingConsent, setMarketingConsent } from '../../neukundensystem/lib/consent';
  import { getPendingLead } from '../../neukundensystem/lib/lead';

  const banner = document.querySelector<HTMLElement>('[data-consent-banner]');
  if (banner) {
    const setOpen = (open: boolean) => {
      banner.hidden = !open;
      window.dispatchEvent(new Event('consent:visibility'));
    };

    const current = getMarketingConsent();
    const reaskForLead = banner.dataset.pendingLead === 'true' && current !== true && getPendingLead() !== null;
    if (current === null || reaskForLead) setOpen(true);

    banner.querySelectorAll<HTMLButtonElement>('[data-consent-choice]').forEach((button) => {
      button.addEventListener('click', () => {
        setMarketingConsent(button.dataset.consentChoice === 'true');
        setOpen(false);
      });
    });

    const open = () => {
      setOpen(true);
      banner.querySelector<HTMLButtonElement>('[data-consent-choice]')?.focus();
    };
    window.addEventListener(CONSENT_OPEN_EVENT, open);
    document.querySelectorAll('[data-consent-open]').forEach((el) => el.addEventListener('click', open));
  }
</script>
