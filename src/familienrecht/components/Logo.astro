---
import fr from '../../config/familienrecht.json';
---

<div class="flex items-center gap-2 text-ink" role="img" aria-label={fr.brand.name}>
  <svg width="24" height="24" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <path d="M13 32 L32 14 L51 32" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M21 39 L32 28 L43 39" fill="none" stroke="var(--color-brand)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
    <line x1="24" y1="47" x2="40" y2="47" stroke="var(--color-brand)" stroke-width="7" stroke-linecap="round" />
  </svg>
  <span class="text-lg font-extrabold tracking-tight" aria-hidden="true">{fr.brand.name}</span>
</div>
