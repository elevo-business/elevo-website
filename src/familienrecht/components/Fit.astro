---
import fr from '../../config/familienrecht.json';
import CheckIcon from './CheckIcon.astro';
const { headline, yesTitle, yes, noTitle, no } = fr.fit;
---

<section class="mt-16" aria-labelledby="passt-titel">
  <h2 id="passt-titel" class="text-center text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{headline}</h2>
  <div class="mt-8 grid gap-5 sm:grid-cols-2">
    <div class="rounded-2xl border border-line bg-white p-5">
      <h3 class="font-bold text-ink">{yesTitle}</h3>
      <ul class="mt-3 space-y-3">
        {
          yes.map((item) => (
            <li class="flex gap-2.5">
              <CheckIcon class="mt-1 size-5 text-ink" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rounded-2xl border border-line bg-surface p-5">
      <h3 class="font-bold text-ink">{noTitle}</h3>
      <ul class="mt-3 space-y-3">
        {
          no.map((item) => (
            <li class="flex gap-2.5">
              <svg class="mt-1 size-5 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 12h12" /></svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
