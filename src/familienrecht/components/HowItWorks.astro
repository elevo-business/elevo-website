---
import fr from '../../config/familienrecht.json';
const { headline, steps, footnote } = fr.howItWorks;
---

<section class="mt-16" aria-labelledby="ablauf-titel">
  <h2 id="ablauf-titel" class="text-center text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{headline}</h2>
  <ol class="mt-8 space-y-4">
    {
      steps.map((step, i) => (
        <li class="flex gap-4 rounded-2xl border border-line bg-white p-5">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-ink font-bold text-white" aria-hidden="true">{i + 1}</span>
          <div>
            <h3 class="font-bold text-ink">{step.title}</h3>
            <p class="mt-1">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
  {footnote && <p class="mt-5 text-center font-semibold text-ink">{footnote}</p>}
</section>
