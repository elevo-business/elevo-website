---
// Freie Plätze kommen nur aus der Config (pilot.freePlaces) – kein Zähler, keine Automatik.
import fr from '../../config/familienrecht.json';
import { fill } from '../../neukundensystem/lib/text';
import Bold from './Bold.astro';
import CheckIcon from './CheckIcon.astro';

const { totalPlaces, freePlaces, placesLine, soldOutLine, bullets } = fr.pilot;
const free = Math.max(0, Math.min(freePlaces, totalPlaces));
const values = { free: String(free), total: String(totalPlaces) };
const headline = fill(free === 0 ? soldOutLine : placesLine, values);
const lines = bullets.map((b) => fill(b, values));
---

<div class="overflow-hidden rounded-2xl border-2 border-accent bg-accent-soft shadow-[0_6px_24px_rgba(242,163,58,.25)]">
  <div class="flex items-center justify-between gap-3 bg-accent px-3 py-2.5 text-ink-deep sm:px-5">
    <p class="text-base leading-tight font-semibold sm:text-lg"><Bold text={headline} /></p>
    <!-- Platz-Anzeige: belegte Plätze dunkel, freie Plätze hell -->
    <div class="flex shrink-0 gap-1" aria-hidden="true">
      {Array.from({ length: totalPlaces }, (_, i) => (
        <span class:list={['size-3 rounded-full border-2 border-ink-deep', i < totalPlaces - free ? 'bg-ink-deep' : 'bg-white']} />
      ))}
    </div>
  </div>
  <ul class="space-y-1.5 px-3.5 py-3 sm:px-5 sm:py-4">
    {
      lines.map((line) => (
        <li class="flex gap-2.5 text-[15px] leading-snug sm:text-[17px]">
          <CheckIcon class="mt-0.5 size-5 text-ink" />
          <span><Bold text={line} /></span>
        </li>
      ))
    }
  </ul>
</div>
