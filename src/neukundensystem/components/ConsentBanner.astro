---
// Schlanker Consent-Banner (Briefing, Abschnitt 6). Speichert consent_marketing in localStorage.
import site from '../../config/site.json';

interface Props {
  /** Auf /danke: Banner auch nach „Nur notwendige“ erneut zeigen, solange ein Lead im 30-Minuten-Fenster offen ist */
  showOnPendingLead?: boolean;
}
const { showOnPendingLead = false } = Astro.props;
const { consent, legal } = site;
---

<!-- Pflicht-Auswahl: Fenster in der Mitte, die Seite ist bis zur Entscheidung abgedunkelt.
     Beide Buttons sind gleich gestaltet (keine Bevorzugung von „Alle akzeptieren“). -->
<div
  class="fixed inset-0 z-50 flex items-end justify-center bg-ink-deep/60 p-4 sm:items-center"
  data-consent-banner
  data-pending-lead={showOnPendingLead ? 'true' : undefined}
  hidden
>
<section
  class="w-full max-w-md rounded-2xl bg-white p-5 shadow-2xl sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="consent-titel"
  aria-describedby="consent-text"
>
  <h2 id="consent-titel" class="text-lg font-bold text-ink">{consent.headline}</h2>
  <p id="consent-text" class="mt-2 text-sm leading-relaxed">
    {consent.text}
    <a href={legal.datenschutzUrl} target="_blank" rel="noopener" class="font-semibold text-ink underline underline-offset-2">{consent.privacyLinkText}</a>
  </p>
  <div class="mt-5 grid grid-cols-2 gap-3">
    <button type="button" class="btn-secondary min-h-12 px-3 text-sm" data-consent-choice="false">{consent.necessaryOnly}</button>
    <button type="button" class="btn-secondary min-h-12 px-3 text-sm" data-consent-choice="true">{consent.acceptAll}</button>
  </div>
</section>
</div>

<script>
  import { CONSENT_OPEN_EVENT, getMarketingConsent, setMarketingConsent } from '../lib/consent';
  import { getPendingLead } from '../lib/lead';

  const banner = document.querySelector<HTMLElement>('[data-consent-banner]');
  if (banner) {
    const setOpen = (open: boolean) => {
      banner.hidden = !open;
      // Seite hinter dem Fenster nicht scrollbar, Fokus direkt im Fenster
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) banner.querySelector<HTMLButtonElement>('[data-consent-choice]')?.focus({ preventScroll: true });
      window.dispatchEvent(new Event('consent:visibility'));
    };

    const current = getMarketingConsent();
    const reaskForLead = banner.dataset.pendingLead === 'true' && current !== true && getPendingLead() !== null;
    if (current === null || reaskForLead) setOpen(true);

    banner.querySelectorAll<HTMLButtonElement>('[data-consent-choice]').forEach((button) => {
      button.addEventListener('click', () => {
        setMarketingConsent(button.dataset.consentChoice === 'true');
        setOpen(false);
      });
    });

    const open = () => {
      setOpen(true);
      banner.querySelector<HTMLButtonElement>('[data-consent-choice]')?.focus();
    };
    window.addEventListener(CONSENT_OPEN_EVENT, open);
    document.querySelectorAll('[data-consent-open]').forEach((el) => el.addEventListener('click', open));
  }
</script>
