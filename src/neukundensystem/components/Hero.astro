---
import site from '../../config/site.json';

const { eyebrow, headline, subheadline } = site.hero;
// Steht im Headline-Text ein Gedankenstrich (Variante A), kommt der zweite Teil auf eine eigene Zeile.
// Der Wortlaut bleibt dabei unverändert.
const dashIndex = headline.indexOf(' – ');
const lead = dashIndex > -1 ? headline.slice(0, dashIndex) : headline;
const tail = dashIndex > -1 ? headline.slice(dashIndex + 1) : '';
---

<header class="pt-6 text-center sm:pt-10">
  {eyebrow && <p class="text-sm font-semibold text-muted sm:text-base">{eyebrow}</p>}
  <h1 class="mt-3 text-[1.625rem] leading-[1.2] font-extrabold tracking-tight text-balance text-ink sm:text-4xl">
    {lead}
    {tail && <> <span class="mt-1 block font-bold text-body">{tail}</span></>}
  </h1>
  {subheadline && <p class="mt-4 text-base leading-relaxed text-pretty sm:text-lg">{subheadline}</p>}
</header>
