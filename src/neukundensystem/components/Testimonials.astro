---
// Nur echte Referenzen: Eine Karte erscheint erst, wenn ihre Pflichtangaben ohne [Platzhalter] ausgefüllt sind.
// Ist keine Karte vollständig, wird die ganze Sektion ausgeblendet (Briefing, Abschnitt 3).
import site from '../../config/site.json';
import { isFilled } from '../lib/text';
import VslFacade, { type VideoConfig } from './VslFacade.astro';
import CtaLink from './CtaLink.astro';

interface Testimonial {
  featured?: boolean;
  name: string;
  company: string;
  logo?: string;
  tag?: string;
  label?: string;
  situation?: string;
  solution?: string;
  result?: string;
  stats?: { value: string; label: string }[];
  processHeadline?: string;
  process?: string[];
  points?: string[];
  quote?: string;
  quoteAuthor?: string;
  quoteRole?: string;
  quoteImage?: string;
  image?: string;
  video?: VideoConfig | null;
}

const items = site.testimonials as Testimonial[];
const filledList = (list?: string[]) => (list ?? []).filter((x) => isFilled(x));
const featured = items.filter((t) => t.featured && isFilled(t.name) && isFilled(t.solution) && isFilled(t.result));
const cards = items.filter(
  (t) => !t.featured && isFilled(t.name) && isFilled(t.company) && (isFilled(t.quote) || filledList(t.points).length > 0),
);
const visible = featured.length + cards.length > 0;
---

{
  visible && (
    <section class="mt-16" aria-labelledby="referenzen-titel">
      <h2 id="referenzen-titel" class="text-center text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
        {site.sections.testimonialsHeadline}
      </h2>

      {featured.map((t) => {
        const stats = (t.stats ?? []).filter((s) => isFilled(s.value) && isFilled(s.label));
        const process = filledList(t.process);
        return (
          <article class="mt-8 overflow-hidden rounded-2xl border border-line bg-white shadow-sm">
            <div class="p-5 sm:p-8">
              <div class="flex flex-wrap items-center justify-between gap-3">
                {isFilled(t.logo) ? (
                  <img src={t.logo} alt={`${t.company} Logo`} width="160" height="40" loading="lazy" decoding="async" class="h-9 w-auto" />
                ) : (
                  <h3 class="text-xl font-bold text-ink">{t.company}</h3>
                )}
                {isFilled(t.tag) && <span class="rounded-full bg-surface px-3 py-1 text-xs font-semibold text-muted">{t.tag}</span>}
              </div>
              {isFilled(t.logo) && <h3 class="sr-only">{t.company}</h3>}

              {stats.length > 0 && (
                <dl class="mt-6 grid gap-3 sm:grid-cols-3">
                  {stats.map((s) => (
                    <div class="rounded-xl bg-surface p-4 text-center">
                      <dt class="sr-only">{s.label}</dt>
                      <dd>
                        <span class="block text-2xl font-extrabold text-ink">{s.value}</span>
                        <span class="mt-1 block text-sm leading-snug text-muted">{s.label}</span>
                      </dd>
                    </div>
                  ))}
                </dl>
              )}

              <dl class="mt-6 space-y-4">
                {isFilled(t.situation) && (
                  <div>
                    <dt class="text-sm font-semibold tracking-wide text-muted uppercase">Ausgangslage</dt>
                    <dd class="mt-1">{t.situation}</dd>
                  </div>
                )}
                {process.length === 0 && (
                  <div>
                    <dt class="text-sm font-semibold tracking-wide text-muted uppercase">Lösung</dt>
                    <dd class="mt-1">{t.solution}</dd>
                  </div>
                )}
                {stats.length === 0 && (
                  <div>
                    <dt class="text-sm font-semibold tracking-wide text-muted uppercase">Ergebnis</dt>
                    <dd class="mt-1 font-semibold text-ink">{t.result}</dd>
                  </div>
                )}
              </dl>

              {process.length > 0 && (
                <div class="mt-6">
                  <h4 class="text-sm font-semibold tracking-wide text-muted uppercase">{t.processHeadline ?? 'Lösung'}</h4>
                  <ol class="mt-3 space-y-3">
                    {process.map((step, i) => (
                      <li class="flex gap-3">
                        <span class="grid size-7 shrink-0 place-items-center rounded-full bg-ink text-sm font-bold text-white" aria-hidden="true">{i + 1}</span>
                        <span class="pt-0.5 leading-relaxed">{step}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              )}

              {t.video && <div class="mt-6"><VslFacade video={t.video} /></div>}
            </div>

            {isFilled(t.quote) && (
              <figure class="border-t border-line bg-surface p-5 sm:p-8">
                <blockquote class="text-lg leading-relaxed text-ink">„{t.quote}“</blockquote>
                {isFilled(t.quoteAuthor) && (
                  <figcaption class="mt-4 flex items-center gap-3">
                    {isFilled(t.quoteImage) && (
                      <img src={t.quoteImage} alt={`${t.quoteAuthor}, ${t.quoteRole ?? t.company}`} width="56" height="56" loading="lazy" decoding="async" class="size-14 rounded-full object-cover" />
                    )}
                    <span>
                      <strong class="block text-ink">{t.quoteAuthor}</strong>
                      {isFilled(t.quoteRole) && <span class="text-sm text-muted">{t.quoteRole}</span>}
                    </span>
                  </figcaption>
                )}
              </figure>
            )}
          </article>
        );
      })}

      {cards.length > 0 && (
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {cards.map((t) => (
            <article class="flex flex-col rounded-2xl border border-line bg-white p-5 shadow-sm">
              <div class="flex items-center gap-3">
                {isFilled(t.image) && <img src={t.image} alt={`${t.name}, ${t.company}`} width="48" height="48" loading="lazy" class="size-12 rounded-full object-cover" />}
                <div>
                  {isFilled(t.label) && <span class="text-xs font-semibold tracking-wide text-muted uppercase">{t.label}</span>}
                  <h3 class="font-bold text-ink">{t.name}</h3>
                  <p class="text-sm text-muted">{t.company}</p>
                </div>
              </div>
              {isFilled(t.result) && <p class="mt-3 font-semibold text-ink">{t.result}</p>}
              {filledList(t.points).length > 0 && (
                <ul class="mt-3 space-y-2 text-sm leading-relaxed">
                  {filledList(t.points).map((point) => (
                    <li class="flex gap-2">
                      <svg class="mt-0.5 size-4 shrink-0 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              )}
              {isFilled(t.quote) && <blockquote class="mt-3">„{t.quote}“</blockquote>}
              {t.video && <div class="mt-4"><VslFacade video={t.video} /></div>}
            </article>
          ))}
        </div>
      )}

      <CtaLink />
    </section>
  )
}
