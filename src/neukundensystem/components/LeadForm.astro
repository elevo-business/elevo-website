---
import site from '../../config/site.json';
import { telHref } from '../lib/text';

const { form, legal, thankYou } = site;
const [consentBefore, consentAfter] = form.consentText.split('{{datenschutz}}');
const phoneHref = telHref(thankYou.phone);
type InputType = 'text' | 'email' | 'tel';

// Formular zum Durchklicken: Reihenfolge und Gruppierung kommen aus form.steps.
const fieldsByName = Object.fromEntries(form.fields.map((f) => [f.name, f]));
const qualifiersByName = Object.fromEntries(form.qualifiers.map((q) => [q.name, q]));
const steps = form.steps.map((step, index) => ({
  index,
  title: step.title,
  qualifier: step.items.length === 1 ? qualifiersByName[step.items[0]] : undefined,
  fields: step.items.filter((name) => fieldsByName[name]).map((name) => fieldsByName[name]),
  consent: step.items.includes('consent'),
  last: index === form.steps.length - 1,
}));
const total = steps.length;
const progress = (n: number) => form.progressText.replace('{{n}}', String(n)).replace('{{total}}', String(total));
---

<section id="formular" class="mt-12 rounded-2xl border border-line bg-surface p-5 sm:p-8" aria-labelledby="formular-titel">
  <h2 id="formular-titel" class="text-center text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{form.headline}</h2>

  <form class="mt-6" novalidate data-lead-form data-total={total}>
    <!-- Honeypot gegen Spam: für Menschen unsichtbar -->
    <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
      <label for="lf-website">Website</label>
      <input id="lf-website" type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="mb-6">
      <p class="mb-2 text-center text-sm font-semibold text-muted" aria-live="polite" data-progress-text>{progress(1)}</p>
      <div class="h-2 overflow-hidden rounded-full bg-line" aria-hidden="true">
        <div class="h-full rounded-full bg-ink transition-[width] duration-300" style={`width:${100 / total}%`} data-progress-bar></div>
      </div>
    </div>

    {
      steps.map((step) => (
        <div data-step={step.index} hidden={step.index > 0}>
          {step.qualifier ? (
            <fieldset aria-describedby={`lf-${step.qualifier.name}-error`} data-qualifier-step>
              <legend class="contents">
                <span id={`lf-step-${step.index}-title`} tabindex="-1" class="block text-center text-xl font-bold text-ink outline-none sm:text-2xl" data-step-title>
                  {step.qualifier.label}
                </span>
              </legend>
              {step.qualifier.hint && <p class="mt-2 text-center text-sm text-muted">{step.qualifier.hint}</p>}
              <div class="mt-5 grid gap-3">
                {step.qualifier.options.map((option, i) => (
                  <label class="group flex min-h-14 cursor-pointer items-center gap-3 rounded-xl border-2 border-field bg-white px-4 py-3 text-lg font-semibold text-ink transition-colors duration-300 hover:border-ink has-checked:border-ink has-checked:bg-ink has-checked:text-white has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-ink">
                    <input type="radio" name={step.qualifier!.name} value={option} required={i === 0} class="sr-only" />
                    <span class="grid size-6 shrink-0 place-items-center rounded-full border-2 border-current" aria-hidden="true">
                      <span class="size-2.5 rounded-full bg-current opacity-0 group-has-checked:opacity-100" />
                    </span>
                    <span>{option}</span>
                  </label>
                ))}
              </div>
              <p id={`lf-${step.qualifier.name}-error`} class="mt-2 hidden text-sm font-medium text-danger" data-error-for={step.qualifier.name} />
            </fieldset>
          ) : (
            <div role="group" aria-labelledby={`lf-step-${step.index}-title`}>
              <span id={`lf-step-${step.index}-title`} tabindex="-1" class="block text-center text-xl font-bold text-ink outline-none sm:text-2xl" data-step-title>
                {step.title}
              </span>
              <div class="mt-5 grid gap-5 sm:grid-cols-2">
                {step.fields.map((field) => (
                  <div data-field={field.name}>
                    <label for={`lf-${field.name}`} class="mb-1.5 block text-sm font-semibold text-ink">
                      {field.label} <span aria-hidden="true">*</span>
                    </label>
                    <input
                      id={`lf-${field.name}`}
                      name={field.name}
                      type={field.type as InputType}
                      autocomplete={field.autocomplete}
                      inputmode={field.type === 'tel' ? 'tel' : field.type === 'email' ? 'email' : undefined}
                      required
                      aria-required="true"
                      aria-describedby={`lf-${field.name}-error`}
                      maxlength={field.type === 'email' ? 254 : 120}
                      class="field-input"
                    />
                    <p id={`lf-${field.name}-error`} class="mt-1.5 hidden text-sm font-medium text-danger" data-error-for={field.name} />
                  </div>
                ))}
              </div>
              {step.consent && (
                <div data-field="consent" class="mt-5">
                  <label class="flex cursor-pointer items-start gap-3 text-sm leading-relaxed text-body">
                    <input type="checkbox" name="consent" required aria-describedby="lf-consent-error" class="mt-0.5 size-5 shrink-0 accent-ink" />
                    <span>
                      {consentBefore}<a href={legal.datenschutzUrl} target="_blank" rel="noopener" class="font-semibold text-ink underline underline-offset-2">{form.consentLinkText}</a>{consentAfter}
                    </span>
                  </label>
                  <p id="lf-consent-error" class="mt-1.5 hidden text-sm font-medium text-danger" data-error-for="consent" />
                </div>
              )}
            </div>
          )}

          {step.last && (
            <div class="mt-5 hidden rounded-lg border border-danger bg-white p-3.5 text-sm font-medium text-danger" role="alert" data-submit-error>
              {form.errorText}
              {phoneHref ? <a href={phoneHref} class="underline">{thankYou.phone}</a> : thankYou.phone}
            </div>
          )}

          <div class="mt-6 flex gap-3">
            {step.index > 0 && (
              <button type="button" class="btn-secondary min-h-14 shrink-0 px-5" data-back>
                {form.backText}
              </button>
            )}
            {step.last ? (
              <button type="submit" class="btn-cta" data-submit>
                <span data-submit-label>{form.ctaText}</span>
                <span class="hidden items-center gap-2" data-submit-loading>
                  <svg class="size-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity=".25" stroke-width="3" />
                    <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                  </svg>
                  {form.submittingText}
                </span>
              </button>
            ) : (
              <button type="button" class="btn-cta" data-next>
                {form.nextText}
              </button>
            )}
          </div>
        </div>
      ))
    }

    <div class="mt-5 space-y-1 text-center text-sm">
      <p class="text-body">{form.trustLine}</p>
      <p class="font-semibold text-ink">{form.guaranteeLine}</p>
    </div>
  </form>
</section>

<script>
  import { form as formConfig, paths } from '../../config/site.json';
  import { submitToHubspot, type HubspotField } from '../lib/hubspot';
  import { captureAttribution, getAttribution } from '../lib/utm';
  import { markLeadSubmitted } from '../lib/lead';
  import { uuid } from '../lib/storage';

  captureAttribution();

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const PHONE_CHARS = /^\+?[\d\s()/.-]+$/;

  const formEl = document.querySelector<HTMLFormElement>('[data-lead-form]');

  function phoneValid(value: string): boolean {
    const digits = value.replace(/\D/g, '');
    return PHONE_CHARS.test(value) && digits.length >= 6 && digits.length <= 15;
  }

  if (formEl) {
    const submitBtn = formEl.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitError = formEl.querySelector<HTMLElement>('[data-submit-error]')!;
    const touched = new Set<string>();

    const showError = (name: string, message: string) => {
      const target = formEl.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const inputs = formEl.querySelectorAll<HTMLInputElement>(`[name="${name}"]`);
      if (target) {
        target.textContent = message;
        target.classList.toggle('hidden', message === '');
      }
      inputs.forEach((input) => input.setAttribute('aria-invalid', message ? 'true' : 'false'));
    };

    const validateField = (name: string): boolean => {
      const config = formConfig.fields.find((f) => f.name === name);
      if (config) {
        const input = formEl.elements.namedItem(name) as HTMLInputElement;
        const value = input.value.trim();
        let message = '';
        if (value === '') message = config.error;
        else if (config.type === 'email' && !EMAIL.test(value)) message = config.errorFormat ?? config.error;
        else if (config.type === 'tel' && !phoneValid(value)) message = config.errorFormat ?? config.error;
        showError(name, message);
        return message === '';
      }
      if (formConfig.qualifiers.some((q) => q.name === name)) {
        const checked = formEl.querySelector(`[name="${name}"]:checked`);
        showError(name, checked ? '' : formConfig.qualifierError);
        return !!checked;
      }
      if (name === 'consent') {
        const checked = (formEl.elements.namedItem('consent') as HTMLInputElement).checked;
        showError('consent', checked ? '' : formConfig.consentError);
        return checked;
      }
      return true;
    };

    const allNames = [...formConfig.fields.map((f) => f.name), ...formConfig.qualifiers.map((q) => q.name), 'consent'];

    // --- Schritte
    const stepEls = Array.from(formEl.querySelectorAll<HTMLElement>('[data-step]'));
    const total = stepEls.length;
    const progressText = formEl.querySelector<HTMLElement>('[data-progress-text]')!;
    const progressBar = formEl.querySelector<HTMLElement>('[data-progress-bar]')!;
    const section = document.getElementById('formular');
    let current = 0;

    const stepOf = (name: string) => formConfig.steps.findIndex((s) => s.items.includes(name));

    const validateStep = (index: number): string | null => {
      const invalid = formConfig.steps[index].items.filter((name) => !validateField(name));
      formConfig.steps[index].items.forEach((name) => touched.add(name));
      return invalid[0] ?? null;
    };

    const showStep = (index: number, focus = true) => {
      current = Math.max(0, Math.min(index, total - 1));
      stepEls.forEach((el, i) => (el.hidden = i !== current));
      progressText.textContent = formConfig.progressText.replace('{{n}}', String(current + 1)).replace('{{total}}', String(total));
      progressBar.style.width = `${((current + 1) / total) * 100}%`;
      if (!focus) return;
      if (section && section.getBoundingClientRect().top < 0) section.scrollIntoView({ block: 'start' });
      stepEls[current].querySelector<HTMLElement>('[data-step-title]')?.focus({ preventScroll: true });
    };

    // Antworten, die nicht passen (z. B. Kundenwert unter 2.000 €): direkt zur Absage-Seite.
    // Es wird nichts an HubSpot gesendet und kein Lead getrackt.
    const isDisqualified = () =>
      formConfig.disqualify.some((rule) => {
        const checked = formEl.querySelector<HTMLInputElement>(`[name="${rule.question}"]:checked`);
        return !!checked && rule.options.includes(checked.value);
      });

    const next = () => {
      const invalid = validateStep(current);
      if (invalid) {
        formEl.querySelector<HTMLInputElement>(`[name="${invalid}"]`)?.focus();
        return;
      }
      if (isDisqualified()) {
        window.location.href = paths.disqualified;
        return;
      }
      showStep(current + 1);
    };

    formEl.querySelectorAll('[data-next]').forEach((btn) => btn.addEventListener('click', next));
    formEl.querySelectorAll('[data-back]').forEach((btn) => btn.addEventListener('click', () => showStep(current - 1)));

    // Klick/Tipp auf eine Antwort springt direkt weiter. Mit der Tastatur (Pfeiltasten) bleibt man im Schritt
    // und geht mit „Weiter“ – sonst würde jeder Pfeiltasten-Druck einen Schritt überspringen.
    let pointerChoice = false;
    formEl.addEventListener('pointerdown', (event) => {
      pointerChoice = !!(event.target as HTMLElement).closest('[data-qualifier-step] label');
    });
    formEl.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement;
      if (input.type !== 'radio' || !pointerChoice) return;
      pointerChoice = false;
      const step = current;
      window.setTimeout(() => {
        if (current === step) next();
      }, 250);
    });

    // Enter in einem Textfeld: zum nächsten Schritt statt absenden
    formEl.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      if (event.key === 'Enter' && target.tagName === 'INPUT' && (target as HTMLInputElement).type !== 'checkbox' && current < total - 1) {
        event.preventDefault();
        next();
      }
    });

    formEl.addEventListener('focusout', (event) => {
      const input = event.target as HTMLInputElement;
      if (input.type === 'radio' || input.type === 'checkbox' || !allNames.includes(input.name)) return;
      touched.add(input.name);
      validateField(input.name);
    });
    formEl.addEventListener('input', (event) => {
      const input = event.target as HTMLInputElement;
      if (input.type === 'radio' || input.type === 'checkbox') validateField(input.name);
      else if (touched.has(input.name)) validateField(input.name);
    });

    const setLoading = (loading: boolean) => {
      submitBtn.disabled = loading;
      submitBtn.setAttribute('aria-busy', String(loading));
      formEl.querySelector('[data-submit-label]')!.classList.toggle('hidden', loading);
      const spinner = formEl.querySelector<HTMLElement>('[data-submit-loading]')!;
      spinner.classList.toggle('hidden', !loading);
      spinner.classList.toggle('inline-flex', loading);
    };

    let sending = false;

    // Zurück-Button nach der Weiterleitung (bfcache): Formular wieder bedienbar machen.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        sending = false;
        setLoading(false);
      }
    });

    formEl.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      submitError.classList.add('hidden');

      if (current < total - 1) {
        next();
        return;
      }
      const results = allNames.map((name) => ({ name, ok: validateField(name) }));
      allNames.forEach((n) => touched.add(n));
      const firstInvalid = results.find((r) => !r.ok);
      if (firstInvalid) {
        const step = stepOf(firstInvalid.name);
        if (step > -1 && step !== current) showStep(step, false);
        formEl.querySelector<HTMLInputElement>(`[name="${firstInvalid.name}"]`)?.focus();
        return;
      }

      if (isDisqualified()) {
        window.location.href = paths.disqualified;
        return;
      }

      const data = new FormData(formEl);
      // Honeypot ausgefüllt → Bot: nichts senden, nichts tracken.
      if (String(data.get('website') ?? '') !== '') {
        window.location.href = paths.thankYou;
        return;
      }

      sending = true;
      setLoading(true);

      const mapping = formConfig.fieldMapping as Record<string, string>;
      const eventId = uuid();
      const fields: HubspotField[] = [];
      const push = (key: string, value: string | undefined) => {
        const name = mapping[key];
        if (name && value) fields.push({ name, value });
      };
      formConfig.fields.forEach((f) => push(f.name, String(data.get(f.name) ?? '').trim()));
      formConfig.qualifiers.forEach((q) => {
        const value = String(data.get(q.name) ?? '');
        if (q.hubspotProperty && value) fields.push({ name: q.hubspotProperty, value });
      });
      Object.entries(getAttribution()).forEach(([key, value]) => push(key, value));
      push('event_id', eventId);

      const consentText = formConfig.consentText.replace('{{datenschutz}}', formConfig.consentLinkText);
      const ok = await submitToHubspot(formConfig.hubspot, fields, consentText);

      if (ok) {
        markLeadSubmitted(String(data.get('vorname') ?? '').trim(), eventId);
        window.location.href = paths.thankYou;
        return;
      }

      sending = false;
      setLoading(false);
      submitError.classList.remove('hidden');
    });
  }
</script>
