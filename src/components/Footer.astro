---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo size="md" />
        <p class="footer-tag">
          Planbare Neukundengewinnung für Fulfillment-Center und 3PL-Dienstleister im DACH-Raum.
        </p>
        <a class="u-link footer-mail" href="mailto:hey@elevo.solutions">hey@elevo.solutions</a>
      </div>

      <nav class="footer-col" aria-label="Seiten">
        <p class="footer-col-title">Seiten</p>
        <ul role="list">
          <li><a href="/" class="u-link">Start</a></li>
          <li><a href="/leistungen" class="u-link">Leistungen</a></li>
          <li><a href="/kontakt" class="u-link">Kontakt</a></li>
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Rechtliches">
        <p class="footer-col-title">Rechtliches</p>
        <ul role="list">
          <li><a href="/impressum" class="u-link">Impressum</a></li>
          <li><a href="/datenschutz" class="u-link">Datenschutz</a></li>
          <li><button type="button" id="cookie-settings-link" class="u-link footer-cookie-btn">Cookie-Einstellungen</button></li>
        </ul>
      </nav>

      <div class="footer-col">
        <p class="footer-col-title">Standort</p>
        <address class="footer-address">
          ELEVO Solutions<br>
          Ahrstraße 6<br>
          52511 Geilenkirchen
        </address>
      </div>
    </div>

    <p class="footer-wordmark" aria-hidden="true">Elevo</p>

    <div class="footer-bar">
      <p>© {year} Elevo · ELEVO Solutions</p>
      <p class="footer-bar-note">Pay-per-Lead · Exklusiv · Ersatz-Garantie</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-dark);
    border-top: 1px solid var(--border-soft);
    padding-top: clamp(64px, 8vw, 96px);
    position: relative;
    z-index: 1;
    overflow: hidden;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: clamp(48px, 6vw, 72px);
  }
  .footer-tag {
    margin: 22px 0 18px;
    font-size: 0.98rem;
    color: var(--text-secondary);
    max-width: 34ch;
    line-height: 1.6;
  }
  .footer-mail { font-weight: 600; font-size: 1.02rem; }
  .footer-col-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 6px 0 20px;
  }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 13px; }
  .footer-col a, .footer-cookie-btn {
    font-size: 0.98rem;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .footer-cookie-btn {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
  }
  .footer-address { font-style: normal; font-size: 0.98rem; color: var(--text-secondary); line-height: 1.7; }

  .footer-wordmark {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(5rem, 17vw, 15rem);
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: #0D1E2E;
    text-align: center;
    margin: 0 0 -0.12em;
    user-select: none;
    pointer-events: none;
  }

  .footer-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--border-soft);
    padding-block: 26px;
    font-size: 0.86rem;
    color: var(--text-muted);
    position: relative;
  }
  .footer-bar p { margin: 0; }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 40px; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; gap: 36px;  }
  }
</style>
