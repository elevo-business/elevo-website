---
import Logo from './Logo.astro';
---

<footer id="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo size="md" />
        <p class="footer-tagline">
          Digitale Werkstatt für den deutschen Mittelstand.
        </p>
        <a href="mailto:hallo@elevo.solutions" style="font-size:0.85rem; color: var(--accent);">hallo@elevo.solutions</a>
      </div>

      <div>
        <p class="footer-col-title">Leistung</p>
        <ul class="footer-links">
          <li><a href="/#offers">Premium-Website</a></li>
          <li><a href="/#offers">Performance &amp; SEO</a></li>
          <li><a href="/#offers">Conversion-Site</a></li>
        </ul>
      </div>

      <div>
        <p class="footer-col-title">Unternehmen</p>
        <ul class="footer-links">
          <li><a href="/#warum">Über uns</a></li>
          <li><a href="/referenzen">Referenzen</a></li>
          <li><a href="/#prozess">Ablauf</a></li>
          <li><a href="/kontakt">Kontakt</a></li>
        </ul>
      </div>

      <div>
        <p class="footer-col-title">Rechtliches</p>
        <ul class="footer-links">
          <li><a href="/impressum">Impressum</a></li>
          <li><a href="/datenschutz">Datenschutz</a></li>
        </ul>
        <p class="footer-col-title" style="margin-top:1.5rem;">Folgen Sie uns</p>
        <ul class="footer-links footer-social">
          <li>
            <a href="https://linkedin.com/company/elevo-solutions" target="_blank" rel="noopener noreferrer" aria-label="Elevo auf LinkedIn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a href="https://instagram.com/elevo.solutions" target="_blank" rel="noopener noreferrer" aria-label="Elevo auf Instagram">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-legal">
        © <span id="year"></span> Elevo · Ahrstraße 6, 52511 Geilenkirchen ·
        <a href="/impressum">Impressum</a> ·
        <a href="/datenschutz">Datenschutz</a>
      </p>
    </div>
  </div>
</footer>

<!-- Floating CTA -->
<div id="float-cta" aria-hidden="true">
  <a href="#kontakt" class="float-btn">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.6a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 5.61 5.61l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    Gespräch buchen
  </a>
</div>

<script>
  document.getElementById('year')!.textContent = String(new Date().getFullYear());
</script>
