---
export interface Props {
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  ariaLabel?: string;
}
const { size = 'md', href = '/', ariaLabel = 'Elevo Startseite' } = Astro.props;
const dim = size === 'sm' ? 24 : size === 'lg' ? 36 : 28;
---

<a href={href} class={`logo-lockup logo-${size}`} aria-label={ariaLabel}>
  <svg
    class="logo-mark"
    width={dim}
    height={dim}
    viewBox="0 0 64 64"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M13 32 L32 14 L51 32" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M21 39 L32 28 L43 39" fill="none" stroke="var(--accent-soft-strong, #7FE9DA)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
    <line x1="24" y1="47" x2="40" y2="47" stroke="var(--accent-soft-strong, #7FE9DA)" stroke-width="7" stroke-linecap="round"/>
  </svg>
  <span class="logo-word">Elevo</span>
</a>

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--accent);
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 800;
    line-height: 1;
    transition: opacity var(--transition);
  }
  .logo-lockup:hover { opacity: 0.85; }
  .logo-mark { flex: 0 0 auto; }
  .logo-word {
    color: var(--text-primary);
    font-size: 1.45rem;
    letter-spacing: -0.03em;
  }
  .logo-sm .logo-word { font-size: 1.2rem; }
  .logo-lg .logo-word { font-size: 1.7rem; }
</style>
