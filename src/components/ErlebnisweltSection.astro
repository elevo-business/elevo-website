---

<section id="erlebniswelt" class="section erlebniswelt-section" aria-labelledby="erlebniswelt-heading">
  <div class="container">
    <header class="section-header">
      <div class="section-label reveal">Live erleben</div>
      <h2 id="erlebniswelt-heading" class="reveal reveal-delay-1">Unsere Arbeit.<br>Direkt ausprobieren.</h2>
      <p class="reveal reveal-delay-2">Kein Screenshot — echte interaktive Features aus unseren Projekten. Testen Sie selbst.</p>
    </header>

    <div class="erlebniswelt-cards reveal reveal-delay-1">
      <article class="erlebniswelt-card">
        <div class="erlebniswelt-card-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v8M8 12h8"/>
            <path d="M7.1 7.1 C5.7 8.7 5 10.7 5 12s.7 3.3 2.1 4.9"/>
            <path d="M16.9 7.1C18.3 8.7 19 10.7 19 12s-.7 3.3-2.1 4.9"/>
          </svg>
        </div>
        <div class="erlebniswelt-card-badge">Greenchild · Visualisierung</div>
        <h3 class="erlebniswelt-card-title">Nährstoffkreislauf</h3>
        <p class="erlebniswelt-card-desc">Interaktives Ökosystem-Diagramm — klicken Sie auf die Elemente und sehen Sie, wie Sonne, Wasser, Bienen und Bäume zusammenwirken.</p>
        <div class="erlebniswelt-card-preview" aria-hidden="true">
          <svg viewBox="0 0 200 200" fill="none" class="erlebniswelt-preview-svg">
            <circle cx="100" cy="100" r="72" stroke="rgba(45,212,160,0.3)" stroke-width="2"/>
            <circle cx="100" cy="100" r="72" stroke="rgba(45,212,160,0.15)" stroke-width="18"/>
            <circle cx="100" cy="28" r="14" fill="rgba(239,159,39,0.15)" stroke="rgba(239,159,39,0.5)" stroke-width="1.5"/>
            <circle cx="172" cy="100" r="14" fill="rgba(55,138,221,0.15)" stroke="rgba(55,138,221,0.5)" stroke-width="1.5"/>
            <circle cx="100" cy="172" r="14" fill="rgba(156,154,142,0.15)" stroke="rgba(156,154,142,0.5)" stroke-width="1.5"/>
            <circle cx="28" cy="100" r="14" fill="rgba(0,168,107,0.15)" stroke="rgba(0,168,107,0.5)" stroke-width="1.5"/>
            <circle cx="153" cy="47" r="12" fill="rgba(239,159,39,0.12)" stroke="rgba(239,159,39,0.4)" stroke-width="1.5"/>
            <circle cx="153" cy="153" r="12" fill="rgba(124,179,66,0.12)" stroke="rgba(124,179,66,0.4)" stroke-width="1.5"/>
            <circle cx="47" cy="153" r="12" fill="rgba(124,179,66,0.12)" stroke="rgba(124,179,66,0.4)" stroke-width="1.5"/>
            <circle cx="47" cy="47" r="12" fill="rgba(29,158,117,0.12)" stroke="rgba(29,158,117,0.4)" stroke-width="1.5"/>
            <circle cx="100" cy="100" r="22" fill="rgba(0,168,107,0.1)" stroke="rgba(45,212,160,0.4)" stroke-width="1.5"/>
            <circle cx="100" cy="100" r="5" fill="rgba(45,212,160,0.8)"/>
          </svg>
        </div>
      </article>

      <article class="erlebniswelt-card">
        <div class="erlebniswelt-card-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"/>
            <path d="M8 21h8M12 17v4"/>
            <path d="M7 10h2l1 3 2-6 1 3h2"/>
          </svg>
        </div>
        <div class="erlebniswelt-card-badge">Greenchild · Rechner</div>
        <h3 class="erlebniswelt-card-title">Baumbesitzer-Konfigurator</h3>
        <p class="erlebniswelt-card-desc">Berechnen Sie Ihren individuellen Bedarf — Bäume, Fläche, CO₂-Bindung und Holzvolumen live im Browser kalkulieren.</p>
        <div class="erlebniswelt-card-preview" aria-hidden="true">
          <svg viewBox="0 0 200 120" fill="none" class="erlebniswelt-preview-svg-wide">
            <rect x="16" y="16" width="168" height="88" rx="8" fill="rgba(59,130,246,0.04)" stroke="rgba(59,130,246,0.15)" stroke-width="1"/>
            <rect x="28" y="60" width="144" height="8" rx="4" fill="rgba(59,130,246,0.12)" stroke="rgba(59,130,246,0.2)" stroke-width="1"/>
            <rect x="28" y="60" width="72" height="8" rx="4" fill="rgba(0,168,107,0.6)"/>
            <circle cx="100" cy="64" r="10" fill="rgba(0,168,107,0.9)" stroke="white" stroke-width="2"/>
            <rect x="28" y="28" width="32" height="22" rx="4" fill="rgba(59,130,246,0.08)" stroke="rgba(59,130,246,0.2)" stroke-width="1"/>
            <rect x="68" y="28" width="32" height="22" rx="4" fill="rgba(59,130,246,0.08)" stroke="rgba(59,130,246,0.2)" stroke-width="1"/>
            <rect x="108" y="28" width="32" height="22" rx="4" fill="rgba(59,130,246,0.08)" stroke="rgba(59,130,246,0.2)" stroke-width="1"/>
            <rect x="148" y="28" width="32" height="22" rx="4" fill="rgba(0,168,107,0.1)" stroke="rgba(0,168,107,0.3)" stroke-width="1"/>
            <rect x="32" y="82" width="136" height="6" rx="3" fill="rgba(0,168,107,0.15)"/>
            <rect x="32" y="94" width="80" height="4" rx="2" fill="rgba(59,130,246,0.1)"/>
          </svg>
        </div>
      </article>
    </div>

    <div class="erlebniswelt-cta-row reveal reveal-delay-2">
      <a href="/erlebniswelt" class="btn-primary erlebniswelt-cta-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <polygon points="10 8 16 12 10 16 10 8"/>
        </svg>
        Interaktiv erleben
      </a>
      <p class="erlebniswelt-cta-note">Kein Download. Läuft direkt im Browser.</p>
    </div>
  </div>
</section>

<style>
  .erlebniswelt-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 40px;
  }

  .erlebniswelt-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    transition: border-color var(--transition), box-shadow var(--transition);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .erlebniswelt-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-blue);
  }

  .erlebniswelt-card-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
  }

  .erlebniswelt-card-badge {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    padding: 3px 10px;
    background: rgba(59, 130, 246, 0.12);
    border-radius: 20px;
    color: var(--accent);
    width: fit-content;
  }

  .erlebniswelt-card-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .erlebniswelt-card-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .erlebniswelt-card-preview {
    margin-top: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .erlebniswelt-preview-svg {
    width: 120px;
    height: 120px;
    opacity: 0.8;
  }

  .erlebniswelt-preview-svg-wide {
    width: 180px;
    height: 108px;
    opacity: 0.8;
  }

  .erlebniswelt-cta-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .erlebniswelt-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
  }

  .erlebniswelt-cta-note {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 768px) {
    .erlebniswelt-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
