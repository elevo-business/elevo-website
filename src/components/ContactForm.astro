---
const apiUrl = import.meta.env.PUBLIC_CONTACT_API_URL ?? 'https://api.elevo.solutions/api/contact';
---

<form class="contact-form" id="contact-form" novalidate data-api-url={apiUrl}>
  <div class="form-row">
    <div class="form-group">
      <label class="form-label" for="name">Ihr Name *</label>
      <input class="form-input" type="text" id="name" name="name" placeholder="Max Mustermann" required autocomplete="name">
    </div>
    <div class="form-group">
      <label class="form-label" for="company">Unternehmen</label>
      <input class="form-input" type="text" id="company" name="company" placeholder="Muster GmbH" autocomplete="organization">
    </div>
  </div>
  <div class="form-group">
    <label class="form-label" for="email">E-Mail-Adresse *</label>
    <input class="form-input" type="email" id="email" name="email" placeholder="max@mustergmbh.de" required autocomplete="email">
  </div>
  <div class="form-group">
    <label class="form-label" for="service">Interessiert an</label>
    <select class="form-select" id="service" name="service">
      <option value="">Leistung auswählen...</option>
      <option value="website">Website &amp; Webentwicklung</option>
      <option value="seo">SEO &amp; Google Ads</option>
      <option value="prozess">Prozessdigitalisierung</option>
      <option value="alles">Komplettpaket</option>
      <option value="beratung">Erstberatung</option>
    </select>
  </div>
  <div class="form-group">
    <label class="form-label" for="message">Ihr Projekt *</label>
    <textarea class="form-textarea" id="message" name="message" placeholder="Beschreiben Sie kurz Ihr Projekt und Ihre Ziele..." required autocomplete="off"></textarea>
  </div>
  <button type="submit" class="form-submit" id="submit-btn">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    Jetzt Anfrage senden
  </button>
  <div class="form-message" id="form-message" role="alert" aria-live="polite"></div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formMsg = document.getElementById('form-message')!;
  const apiUrl = form.dataset.apiUrl!;;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();
    const company = (form.elements.namedItem('company') as HTMLInputElement).value.trim();
    const service = (form.elements.namedItem('service') as HTMLSelectElement).value;

    if (!name || !email || !message) {
      formMsg.className = 'form-message error';
      formMsg.textContent = 'Bitte füllen Sie alle Pflichtfelder aus.';
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      formMsg.className = 'form-message error';
      formMsg.textContent = 'Bitte geben Sie eine gültige E-Mail-Adresse ein.';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Wird gesendet...';

    try {
      const res = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, company, service, message, source: 'elevo.solutions' })
      });

      if (res.ok) {
        formMsg.className = 'form-message success';
        formMsg.textContent = '✓ Danke! Wir melden uns innerhalb von 24 Stunden.';
        form.reset();

        if (typeof (window as any).gtag !== 'undefined') {
          (window as any).gtag('event', 'conversion', { send_to: 'AW-18023151518/contact_form_submit' });
        }
      } else {
        throw new Error('Server error');
      }
    } catch {
      formMsg.className = 'form-message error';
      formMsg.textContent = 'Etwas ist schiefgelaufen. Schreib uns direkt: hey@elevo.solutions';
    }

    submitBtn.disabled = false;
    submitBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Jetzt Anfrage senden';
  });
</script>
