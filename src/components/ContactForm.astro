---
const apiUrl = import.meta.env.PUBLIC_CONTACT_API_URL ?? 'https://api.elevo.solutions/api/contact';
---

<form class="contact-form" id="contact-form" novalidate data-api-url={apiUrl}>
  <input type="text" name="_hp" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true">
  <input type="hidden" name="_ts" id="form-ts" value="">
  <div class="form-row">
    <div class="form-group">
      <label class="form-label" for="name">Dein Name *</label>
      <input class="form-input" type="text" id="name" name="name" placeholder="Max Mustermann" required autocomplete="name">
    </div>
    <div class="form-group">
      <label class="form-label" for="company">Unternehmen / Marke</label>
      <input class="form-input" type="text" id="company" name="company" placeholder="z. B. dein Unternehmen" autocomplete="organization">
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label class="form-label" for="email">E-Mail-Adresse *</label>
      <input class="form-input" type="email" id="email" name="email" placeholder="max@dein-unternehmen.de" required autocomplete="email">
    </div>
    <div class="form-group">
      <label class="form-label" for="phone">Telefon / WhatsApp <span class="form-label-optional">(optional)</span></label>
      <input class="form-input" type="tel" id="phone" name="phone" placeholder="Für einen schnellen Rückruf" autocomplete="tel" inputmode="tel">
    </div>
  </div>
  <div class="form-group">
    <label class="form-label" for="service">Worum geht's?</label>
    <select class="form-select" id="service" name="service">
      <option value="">Bitte wählen...</option>
      <option value="funnel-check">Kostenloses Wachstumsgespräch</option>
      <option value="website">Hochwertige Website (Fundament)</option>
      <option value="print">Premium-Printmedien (Autorität)</option>
      <option value="ad-funnel">Ad-Funnel (Skalierung)</option>
      <option value="sonstiges">Etwas anderes</option>
    </select>
  </div>
  <div class="form-group">
    <label class="form-label" for="message">Erzähl uns kurz von deinem Unternehmen *</label>
    <textarea class="form-textarea" id="message" name="message" placeholder="Was bietest du an, wo steht dein Unternehmen gerade, und was ist dein Ziel?" required autocomplete="off"></textarea>
  </div>
  <button type="submit" class="form-submit" id="submit-btn">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    Wachstumsgespräch anfragen
  </button>
  <p class="form-assurance">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
    Kostenlos &amp; unverbindlich · Antwort innerhalb von 24 Stunden
  </p>
  <p class="form-privacy-note">
    Mit dem Absenden stimmst du unserer <a href="/datenschutz">Datenschutzerklärung</a> zu. Conversion-Tracking läuft nur, wenn du im Cookie-Banner eingewilligt hast.
  </p>
  <div class="form-message" id="form-message" role="alert" aria-live="polite"></div>
</form>

<style>
  .form-label-optional {
    color: var(--text-muted);
    font-weight: 400;
  }

  .form-assurance {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .form-assurance svg {
    flex-shrink: 0;
    color: var(--accent);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formMsg = document.getElementById('form-message')!;
  const apiUrl = form.dataset.apiUrl!;
  const tsInput = document.getElementById('form-ts') as HTMLInputElement;
  if (tsInput) tsInput.value = String(Date.now());

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const hp = (form.elements.namedItem('_hp') as HTMLInputElement)?.value;
    if (hp) return;
    const ts = (form.elements.namedItem('_ts') as HTMLInputElement)?.value;
    if (ts && Date.now() - parseInt(ts, 10) < 1500) return;

    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();
    const company = (form.elements.namedItem('company') as HTMLInputElement).value.trim();
    const phone = (form.elements.namedItem('phone') as HTMLInputElement).value.trim();
    const service = (form.elements.namedItem('service') as HTMLSelectElement).value;

    if (!name || !email || !message) {
      formMsg.className = 'form-message error';
      formMsg.textContent = 'Bitte füll alle Pflichtfelder aus.';
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      formMsg.className = 'form-message error';
      formMsg.textContent = 'Bitte gib eine gültige E-Mail-Adresse ein.';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Wird gesendet...';

    // Meta: event_id + fbp/fbc VOR dem Request sammeln (nur mit Consent).
    // Wird mitgeschickt, damit das server-seitige CAPI-Event dedupliziert wird.
    const lead = (window as any).elevoMeta?.leadData?.() ?? null;

    try {
      const res = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, phone, company, service, message, source: 'elevo.solutions', ...(lead ?? {}) })
      });

      if (res.ok) {
        formMsg.className = 'form-message success';
        formMsg.textContent = '✓ Danke! Wir melden uns innerhalb von 24 Stunden.';
        form.reset();

        if (typeof (window as any).gtag !== 'undefined') {
          (window as any).gtag('event', 'conversion', { send_to: 'AW-18023151518/contact_form_submit' });
        }
        // Meta Browser-Pixel mit derselben event_id wie das CAPI-Event feuern.
        if (lead) (window as any).elevoMeta?.fireLead?.(lead.metaEventId, { content_name: service || 'contact' });
      } else {
        throw new Error('Server error');
      }
    } catch {
      formMsg.className = 'form-message error';
      formMsg.textContent = 'Etwas ist schiefgelaufen. Schreib uns direkt: hallo@elevo.solutions';
    }

    submitBtn.disabled = false;
    submitBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Wachstumsgespräch anfragen';
  });
</script>
