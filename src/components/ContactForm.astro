---
// Kontaktformular — sendet an die Elevo Contact-API (Payload-Shape stabil halten,
// Backend + CAPI-Deduplizierung haengen an diesen Feldern).
const apiUrl = import.meta.env.PUBLIC_CONTACT_API_URL ?? 'https://api.elevo.solutions/api/contact';
---

<form class="form-grid" id="contact-form" novalidate data-api-url={apiUrl}>
  <input type="text" name="_hp" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true">
  <input type="hidden" name="_ts" id="form-ts" value="">

  <div class="form-row">
    <div class="form-group">
      <label class="form-label" for="name">Ihr Name *</label>
      <input class="form-input" type="text" id="name" name="name" placeholder="Max Mustermann" required autocomplete="name">
    </div>
    <div class="form-group">
      <label class="form-label" for="company">Unternehmen</label>
      <input class="form-input" type="text" id="company" name="company" placeholder="z. B. Ihr Fulfillment-Center" autocomplete="organization">
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label class="form-label" for="email">E-Mail-Adresse *</label>
      <input class="form-input" type="email" id="email" name="email" placeholder="max@unternehmen.de" required autocomplete="email">
    </div>
    <div class="form-group">
      <label class="form-label" for="phone">Telefon <span class="form-label-optional">(optional)</span></label>
      <input class="form-input" type="tel" id="phone" name="phone" placeholder="Für einen schnellen Rückruf" autocomplete="tel" inputmode="tel">
    </div>
  </div>

  <div class="form-group">
    <label class="form-label" for="service">Was beschreibt Sie am besten?</label>
    <select class="form-select" id="service" name="service">
      <option value="">Bitte wählen …</option>
      <option value="fulfillment-center">Fulfillment-Center mit freien Kapazitäten</option>
      <option value="3pl">3PL- / Kontraktlogistik-Dienstleister</option>
      <option value="andere-branche">Andere B2B-Branche (auf Anfrage)</option>
      <option value="sonstiges">Etwas anderes</option>
    </select>
  </div>

  <div class="form-group">
    <label class="form-label" for="message">Ihre Situation *</label>
    <textarea class="form-textarea" id="message" name="message" placeholder="Wie viel Fläche / Kapazität ist frei, in welcher Region, und welche Versender passen zu Ihnen?" required autocomplete="off"></textarea>
  </div>

  <button type="submit" class="btn btn-primary form-submit" id="submit-btn">
    Erstgespräch anfragen
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
  </button>

  <p class="form-assurance">Kostenlos &amp; unverbindlich · Antwort innerhalb von 24 Stunden</p>
  <p class="form-privacy">
    Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="u-link">Datenschutzerklärung</a> zu.
    Conversion-Tracking läuft nur mit Ihrer Einwilligung im Cookie-Banner.
  </p>
  <div class="form-message" id="form-message" role="alert" aria-live="polite"></div>
</form>

<style>
  .form-submit { justify-self: start; }
  .form-assurance {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0;
  }
  .form-privacy {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.55;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formMsg = document.getElementById('form-message')!;
  const apiUrl = form.dataset.apiUrl!;
  const tsInput = document.getElementById('form-ts') as HTMLInputElement;
  if (tsInput) tsInput.value = String(Date.now());

  const submitLabel = submitBtn.innerHTML;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const hp = (form.elements.namedItem('_hp') as HTMLInputElement)?.value;
    if (hp) return;
    const ts = (form.elements.namedItem('_ts') as HTMLInputElement)?.value;
    if (ts && Date.now() - parseInt(ts, 10) < 1500) return;

    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();
    const company = (form.elements.namedItem('company') as HTMLInputElement).value.trim();
    const phone = (form.elements.namedItem('phone') as HTMLInputElement).value.trim();
    const service = (form.elements.namedItem('service') as HTMLSelectElement).value;

    if (!name || !email || !message) {
      formMsg.className = 'form-message error';
      formMsg.textContent = 'Bitte füllen Sie alle Pflichtfelder aus.';
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      formMsg.className = 'form-message error';
      formMsg.textContent = 'Bitte geben Sie eine gültige E-Mail-Adresse ein.';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Wird gesendet …';

    // Meta: event_id + fbp/fbc VOR dem Request sammeln (nur mit Consent).
    const lead = (window as any).elevoMeta?.leadData?.() ?? null;

    try {
      const res = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, phone, company, service, message, source: 'elevo.solutions', ...(lead ?? {}) })
      });

      if (res.ok) {
        formMsg.className = 'form-message success';
        formMsg.textContent = '✓ Danke! Wir melden uns innerhalb von 24 Stunden.';
        form.reset();

        if (typeof (window as any).gtag !== 'undefined') {
          (window as any).gtag('event', 'conversion', { send_to: 'AW-18023151518/contact_form_submit' });
        }
        if (lead) (window as any).elevoMeta?.fireLead?.(lead.metaEventId, { content_name: service || 'contact' });
      } else {
        throw new Error('Server error');
      }
    } catch {
      formMsg.className = 'form-message error';
      formMsg.textContent = 'Etwas ist schiefgelaufen. Schreiben Sie uns direkt: hey@elevo.solutions';
    }

    submitBtn.disabled = false;
    submitBtn.innerHTML = submitLabel;
  });
</script>
