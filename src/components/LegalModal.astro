---
interface Props {
  id: string;
  labelledBy: string;
  fallbackHref: string;
  closeLabel?: string;
}

const { id, labelledBy, fallbackHref, closeLabel = 'Schließen' } = Astro.props;
---

<div
  class="legal-modal"
  id={id}
  role="dialog"
  aria-modal="true"
  aria-labelledby={labelledBy}
  aria-hidden="true"
  data-fallback-href={fallbackHref}
>
  <div class="legal-modal-backdrop" data-legal-close></div>
  <div class="legal-modal-dialog" role="document">
    <button
      type="button"
      class="legal-modal-close"
      aria-label={closeLabel}
      data-legal-close
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="legal-modal-scroll">
      <slot />
    </div>
  </div>
</div>

<style>
  .legal-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
  }

  .legal-modal.is-open {
    display: flex;
  }

  .legal-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(26, 31, 43, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: legal-modal-fade 0.18s ease-out;
  }

  .legal-modal-dialog {
    position: relative;
    width: min(820px, 100%);
    max-height: calc(100vh - 48px);
    background: var(--bg-card, #14253A);
    border: 1px solid var(--border, #243A55);
    border-radius: var(--radius, 14px);
    box-shadow: 0 30px 80px rgba(26, 31, 43, 0.12);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: legal-modal-rise 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .legal-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(26, 31, 43, 0.04);
    border: 1px solid var(--border, #243A55);
    border-radius: 999px;
    color: var(--text-secondary, #C9D7E4);
    cursor: pointer;
    z-index: 2;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .legal-modal-close:hover,
  .legal-modal-close:focus-visible {
    color: var(--text-primary, #FFFFFF);
    background: rgba(59, 130, 246, 0.18);
    border-color: var(--accent, #3B82F6);
    outline: none;
  }

  .legal-modal-scroll {
    overflow-y: auto;
    padding: 56px 32px 40px;
    -webkit-overflow-scrolling: touch;
  }

  @media (max-width: 640px) {
    .legal-modal {
      padding: 0;
    }

    .legal-modal-dialog {
      width: 100%;
      max-height: 100vh;
      border-radius: 0;
    }

    .legal-modal-scroll {
      padding: 64px 20px 32px;
    }
  }

  @keyframes legal-modal-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes legal-modal-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(html.legal-modal-open) {
    overflow: hidden;
  }
</style>
