---
// Primärer Button: führt zum Qualifizierungsformular (/mehrmandanten/anfrage/)
import kb from '../../config/mehrmandanten.json';
interface Props {
  label?: string;
  class?: string;
  /** Variante für dunkle Flächen */
  onDark?: boolean;
}
const { label = kb.cta.text, class: className, onDark = false } = Astro.props;
---

<a href={kb.paths.form} class:list={['btn-cta group', onDark && 'btn-cta-dark', className]}>
  <span>{label}</span>
  <svg class="size-5 shrink-0 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path d="M4 10h12m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
