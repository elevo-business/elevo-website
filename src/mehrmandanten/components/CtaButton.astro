---
// Primärer Button: führt zum Qualifizierungsformular (/mehrmandanten/anfrage/)
import kb from '../../config/mehrmandanten.json';
interface Props {
  label?: string;
  class?: string;
}
const { label = kb.cta.text, class: className } = Astro.props;
---

<a href={kb.paths.form} class:list={['btn-cta group', className]}>
  <svg class="size-5 shrink-0 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
    <path d="M11 3.5 18 10l-7 6.5V12H2V8h9V3.5Z" />
  </svg>
  <span>{label}</span>
</a>
