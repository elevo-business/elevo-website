---
// Illustrationen in HTML: Wettlauf um die Anfrage, Beispielanzeige, Vorprüfung, Benachrichtigung
import mm from '../../config/mehrmandanten.json';
interface Props { kind: string }
const { kind } = Astro.props;
const m = mm.leistungen.mock;
const race = mm.verhalten.race;
---

{kind === 'race' && (
  <div class="mx-auto max-w-sm rounded-2xl bg-white p-5 shadow-[0_30px_70px_-35px_rgb(13_27_42/0.45)] ring-1 ring-line" role="img" aria-label="Illustration: Drei Kanzleien werden angeschrieben, nur eine ruft schnell zurück">
    <p class="font-head text-[15px] font-semibold text-ink">{race.title}</p>
    <p class="text-sm text-muted">{race.sub}</p>
    <ul class="mt-4 space-y-2.5">
      {race.rows.map(([name, status, win]) => (
        <li class:list={['flex items-center gap-3 rounded-xl px-4 py-3', win ? 'bg-ink text-white ring-2 ring-mint' : 'bg-paper text-muted']}>
          <span class:list={['grid size-8 shrink-0 place-items-center rounded-full text-sm font-bold', win ? 'bg-mint text-ink-deep' : 'bg-line text-muted']}>{win ? '✓' : '–'}</span>
          <span class="leading-tight"><span class:list={['block font-head text-[15px] font-semibold', win ? 'text-white' : 'text-ink/70']}>{name}</span><span class="text-sm">{status}</span></span>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-center font-head text-sm font-semibold text-teal">{race.foot}</p>
  </div>
)}

{kind === 'ad' && (
  <div class="mx-auto max-w-[17rem]" role="img" aria-label="Illustration einer sachlichen Beispielanzeige">
    <p class="mb-2 text-center text-xs tracking-[0.14em] text-white/50 uppercase">{m.adLabel}</p>
    <div class="overflow-hidden rounded-xl bg-white text-ink">
      <div class="flex items-center gap-2.5 px-3.5 py-3">
        <span class="size-8 rounded-full bg-ink"></span>
        <span class="leading-tight"><span class="block text-sm font-semibold">{m.adFirm}</span><span class="text-xs text-muted">{m.adSponsored}</span></span>
      </div>
      <div class="bg-linear-to-br from-ink to-ink-soft px-5 py-9"><p class="font-head text-2xl leading-tight font-semibold text-white">{m.adHead}</p></div>
      <p class="px-3.5 pt-3 text-sm leading-snug text-body">{m.adText}</p>
      <div class="p-3.5"><span class="block rounded-lg bg-paper py-2 text-center text-sm font-semibold">{m.adBtn}</span></div>
    </div>
  </div>
)}

{kind === 'quiz' && (
  <div class="mx-auto max-w-[17rem] rounded-xl bg-white p-4 text-ink" role="img" aria-label="Illustration der Vorprüfung mit einer Auswahlfrage">
    <p class="text-center text-xs font-semibold text-muted">{m.quizStep}</p>
    <div class="mt-1.5 h-1.5 rounded-full bg-line"><div class="h-full w-1/4 rounded-full bg-teal"></div></div>
    <p class="mt-4 text-center font-head text-lg font-semibold">{m.quizQ}</p>
    <ul class="mt-3 space-y-2">
      {m.quizOpts.map((o, i) => (
        <li class:list={['flex items-center gap-2.5 rounded-lg border-2 px-3 py-2.5 text-sm font-semibold', i === 0 ? 'border-ink bg-ink text-white' : 'border-line']}>
          <span class:list={['size-3.5 rounded-full border-2', i === 0 ? 'border-mint bg-mint' : 'border-field']}></span>{o}
        </li>
      ))}
    </ul>
  </div>
)}

{kind === 'push' && (
  <div class="mx-auto max-w-[19rem] space-y-2.5" role="img" aria-label="Illustration: Benachrichtigung über eine neue Anfrage">
    <div class="rounded-2xl bg-white p-4 text-ink shadow-[0_20px_50px_-20px_rgb(61_214_192/0.6)] ring-2 ring-mint">
      <p class="flex items-center justify-between text-xs text-muted"><span class="flex items-center gap-1.5 font-semibold text-teal"><span class="size-2 rounded-full bg-mint"></span>{m.pushApp}</span>{m.pushTime}</p>
      <p class="mt-1.5 font-head text-[15px] font-semibold">{m.pushTitle}</p>
      <p class="text-sm leading-snug text-body">{m.pushText}</p>
    </div>
    {m.pushOld.map((t) => <div class="rounded-2xl bg-white/10 px-4 py-3 text-sm text-white/60">{t}</div>)}
  </div>
)}
