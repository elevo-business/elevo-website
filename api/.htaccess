# Routing: /api/contact (ohne Endung) → contact.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^contact/?$ contact.php [L]
</IfModule>

# Schützt serverseitige Secret-Dateien, falls sie versehentlich im Webroot liegen.
# (Der sichere Ablageort ist OBERHALB des Webroots bzw. eine Coolify-Env-Var.)
<FilesMatch "(pipedrive-token|meta-capi-token|meta-pixel-id|meta-test-code)\.txt$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
